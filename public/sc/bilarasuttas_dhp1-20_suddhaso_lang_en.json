span>", "dhp12:2": "<span class='verse-line'>{}</span>", "dhp12:3": "<span class='verse-line'>{}</span>", "dhp12:4": "<span class='verse-line'>{}</span></p></blockquote></article>", "dhp13:0": "<article id='dhp13'><h2 class='sutta-title'>{}</h2>", "dhp13:1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "dhp13:2": "<span class='verse-line'>{}</span>", "dhp13:3": "<span class='verse-line'>{}</span>", "dhp13:4": "<span class='verse-line'>{}</span></p></blockquote></article>", "dhp14:1": "<article id='dhp14'><blockquote class='gatha'><p><span class='verse-line'>{}</span>", "dhp14:2": "<span class='verse-line'>{}</span>", "dhp14:3": "<span class='verse-line'>{}</span>", "dhp14:4": "<span class='verse-line'>{}</span></p></blockquote></article>", "dhp15:0": "<article id='dhp15'><h2 class='sutta-title'>{}</h2>", "dhp15:1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "dhp15:2": "<span class='verse-line'>{}</span>", "dhp15:3": "<span class='verse-line'>{}</span>", "dhp15:4": "<span class='verse-line'>{}</span></p></blockquote></article>", "dhp16:0": "<article id='dhp16'><h2 class='sutta-title'>{}</h2>", "dhp16:1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "dhp16:2": "<span class='verse-line'>{}</span>", "dhp16:3": "<span class='verse-line'>{}</span>", "dhp16:4": "<span class='verse-line'>{}</span></p></blockquote></article>", "dhp17:0": "<article id='dhp17'><h2 class='sutta-title'>{}</h2>", "dhp17:1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "dhp17:2": "<span class='verse-line'>{}</span>", "dhp17:3": "<span class='verse-line'>{}</span>", "dhp17:4": "<span class='verse-line'>{}</span></p></blockquote></article>", "dhp18:0": "<article id='dhp18'><h2 class='sutta-title'>{}</h2>", "dhp18:1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "dhp18:2": "<span class='verse-line'>{}</span>", "dhp18:3": "<span class='verse-line'>{}</span>", "dhp18:4": "<span class='verse-line'>{}</span></p></blockquote></article>", "dhp19:0": "<article id='dhp19'><h2 class='sutta-title'>{}</h2>", "dhp19:1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "dhp19:2": "<span class='verse-line'>{}</span>", "dhp19:3": "<span class='verse-line'>{}</span>", "dhp19:4": "<span class='verse-line'>{}</span></p></blockquote></article>", "dhp20:1": "<article id='dhp20'><blockquote class='gatha'><p><span class='verse-line'>{}</span>", "dhp20:2": "<span class='verse-line'>{}</span>", "dhp20:3": "<span class='verse-line'>{}</span>", "dhp20:4": "<span class='verse-line'>{}</span>", "dhp20:5": "<span class='verse-line'>{}</span>", "dhp20:6": "<span class='verse-line'>{}</span></p></blockquote>", "dhp20:7": "<p class='endvagga'>{}</p></article></section>"}, "root_text": {"dhp1:0.1": "Khuddakanikāya ", "dhp1:0.2": "Dhammapada ", "dhp1:0.3": "Yamakavagga ", "dhp1:0.4": "Cakkhupālattheravatthu ", "dhp1:1": "Manopubbaṅgamā dhammā, ", "dhp1:2": "manoseṭṭhā manomayā; ", "dhp1:3": "Manasā ce paduṭṭhena, ", "dhp1:4": "bhāsati vā karoti vā; ", "dhp1:5": "Tato naṁ dukkhamanveti, ", "dhp1:6": "cakkaṁva vahato padaṁ. ", "dhp2:0": "Maṭṭhakuṇḍalīvatthu ", "dhp2:1": "Manopubbaṅgamā dhammā, ", "dhp2:2": "manoseṭṭhā manomayā; ", "dhp2:3": "Manasā ce pasannena, ", "dhp2:4": "bhāsati vā karoti vā; ", "dhp2:5": "Tato naṁ sukhamanveti, ", "dhp2:6": "chāyāva anapāyinī. ", "dhp3:0": "Tissattheravatthu ", "dhp3:1": "Akkocchi maṁ avadhi maṁ, ", "dhp3:2": "ajini maṁ ahāsi me; ", "dhp3:3": "Ye ca taṁ upanayhanti, ", "dhp3:4": "veraṁ tesaṁ na sammati. ", "dhp4:1": "Akkocchi maṁ avadhi maṁ, ", "dhp4:2": "ajini maṁ ahāsi me; ", "dhp4:3": "Ye ca taṁ nupanayhanti, ", "dhp4:4": "veraṁ tesūpasammati. ", "dhp5:0": "Kāḷayakkhinīvatthu ", "dhp5:1": "Na hi verena verāni, ", "dhp5:2": "sammantīdha kudācanaṁ; ", "dhp5:3": "Averena ca sammanti, ", "dhp5:4": "esa dhammo sanantano. ", "dhp6:0": "Kosambakavatthu ", "dhp6:1": "Pare ca na vijānanti, ", "dhp6:2": "mayamettha yamāmase; ", "dhp6:3": "Ye ca tattha vijānanti, ", "dhp6:4": "tato sammanti medhagā. ", "dhp7:0": "Mahākāḷattheravatthu ", "dhp7:1": "Subhānupassiṁ viharantaṁ, ", "dhp7:2": "indriyesu asaṁvutaṁ; ", "dhp7:3": "Bhojanamhi cāmattaññuṁ, ", "dhp7:4": "kusītaṁ hīnavīriyaṁ; ", "dhp7:5": "Taṁ ve pasahati māro, ", "dhp7:6": "vāto rukkhaṁva dubbalaṁ. ", "dhp8:1": "Asubhānupassiṁ viharantaṁ, ", "dhp8:2": "Indriyesu susaṁvutaṁ; ", "dhp8:3": "Bhojanamhi ca mattaññuṁ, ", "dhp8:4": "Saddhaṁ āraddhavīriyaṁ; ", "dhp8:5": "Taṁ ve nappasahati māro, ", "dhp8:6": "Vāto selaṁva pabbataṁ. ", "dhp9:0": "Devadattavatthu ", "dhp9:1": "Anikkasāvo kāsāvaṁ, ", "dhp9:2": "yo vatthaṁ paridahissati; ", "dhp9:3": "Apeto damasaccena, ", "dhp9:4": "na so kāsāvamarahati. ", "dhp10:1": "Yo ca vantakasāvassa, ", "dhp10:2": "sīlesu susamāhito; ", "dhp10:3": "Upeto damasaccena, ", "dhp10:4": "sa ve kāsāvamarahati. ", "dhp11:0": "Sāriputtattheravatthu ", "dhp11:1": "Asāre sāramatino, ", "dhp11:2": "sāre cāsāradassino; ", "dhp11:3": "Te sāraṁ nādhigacchanti, ", "dhp11:4": "micchāsaṅkappagocarā. ", "dhp12:1": "Sārañca sārato ñatvā, ", "dhp12:2": "asārañca asārato; ", "dhp12:3": "Te sāraṁ adhigacchanti, ", "dhp12:4": "sammāsaṅkappagocarā. ", "dhp13:0": "Nandattheravatthu ", "dhp13:1": "Yathā agāraṁ ducchannaṁ, ", "dhp13:2": "vuṭṭhī samativijjhati; ", "dhp13:3": "Evaṁ abhāvitaṁ cittaṁ, ", "dhp13:4": "rāgo samativijjhati. ", "dhp14:1": "Yathā agāraṁ suchannaṁ, ", "dhp14:2": "vuṭṭhī na samativijjhati; ", "dhp14:3": "Evaṁ subhāvitaṁ cittaṁ, ", "dhp14:4": "rāgo na samativijjhati. ", "dhp15:0": "Cundasūkarikavatthu ", "dhp15:1": "Idha socati pecca socati, ", "dhp15:2": "Pāpakārī ubhayattha socati; ", "dhp15:3": "So socati so vihaññati, ", "dhp15:4": "Disvā kammakiliṭṭhamattano. ", "dhp16:0": "Dhammikaupāsakavatthu ", "dhp16:1": "Idha modati pecca modati, ", "dhp16:2": "Katapuñño ubhayattha modati; ", "dhp16:3": "So modati so pamodati, ", "dhp16:4": "Disvā kammavisuddhimattano. ", "dhp17:0": "Devadattavatthu ", "dhp17:1": "Idha tappati pecca tappati, ", "dhp17:2": "Pāpakārī ubhayattha tappati; ", "dhp17:3": "“Pāpaṁ me katan”ti tappati, ", "dhp17:4": "Bhiyyo tappati duggatiṁ gato. ", "dhp18:0": "Sumanadevīvatthu ", "dhp18:1": "Idha nandati pecca nandati, ", "dhp18:2": "Katapuñño ubhayattha nandati; ", "dhp18:3": "“Puññaṁ me katan”ti nandati, ", "dhp18:4": "Bhiyyo nandati suggatiṁ gato. ", "dhp19:0": "Dvesahāyakabhikkhuvatthu ", "dhp19:1": "Bahumpi ce saṁhita bhāsamāno, ", "dhp19:2": "Na takkaro hoti naro pamatto; ", "dhp19:3": "Gopova gāvo gaṇayaṁ paresaṁ, ", "dhp19:4": "Na bhāgavā sāmaññassa hoti. ", "dhp20:1": "Appampi ce saṁhita bhāsamāno, ", "dhp20:2": "Dhammassa hoti anudhammacārī; ", "dhp20:3": "Rāgañca dosañca pahāya mohaṁ, ", "dhp20:4": "Sammappajāno suvimuttacitto; ", "dhp20:5": "Anupādiyāno idha vā huraṁ vā, ", "dhp20:6": "Sa bhāgavā sāmaññassa hoti. ", "dhp20:7": "Yamakavaggo paṭhamo. "}, "translation_text": {"dhp1:0.1": "Collection of Minor Texts ", "dhp1:0.2": "Verses of Dhamma ", "dhp1:0.3": "Chapter of Pairs ", "dhp1:0.4": "", "dhp1:1": "All things are preceded by the mind, ", "dhp1:2": "surpassed by the mind, created by the mind. ", "dhp1:3": "If one speaks or acts ", "dhp1:4": "with a corrupted mind, ", "dhp1:5": "Then suffering follows, ", "dhp1:6": "As a track follows a wheel. ", "dhp2:0": "", "dhp2:1": "All things are preceded by the mind, ", "dhp2:2": "surpassed by the mind, created by the mind. ", "dhp2:3": "If one speaks or acts ", "dhp2:4": "with a pure mind, ", "dhp2:5": "Then happiness follows, ", "dhp2:6": "As a shadow that never leaves. ", "dhp3:0": "", "dhp3:1": "“They abused me, they hurt me, ", "dhp3:2": "they defeated me, they robbed me!” ", "dhp3:3": "For those who hold on to this ", "dhp3:4": "hostility is never replaced by peace. ", "dhp4:1": "“They abused me, they hurt me, ", "dhp4:2": "they defeated me, they robbed me!” ", "dhp4:3": "For those who do not hold on to this ", "dhp4:4": "hostility is replaced by peace. ", "dhp5:0": "", "dhp5:1": "Hostility is never pacified ", "dhp5:2": "by means of hostility. ", "dhp5:3": "Only by means of non-hostility is it pacified. ", "dhp5:4": "This is an eternal truth. ", "dhp6:0": "", "dhp6:1": "Others do not know ", "dhp6:2": "that we must be restrained. ", "dhp6:3": "The wise ones who know this ", "dhp6:4": "attain peace. ", "dhp7:0": "", "dhp7:1": "If one focuses on beauty, ", "dhp7:2": "lacks sense-restraint, ", "dhp7:3": "does not know the right amount when eating, ", "dhp7:4": "is lazy, and lacks energy, ", "dhp7:5": "Māra subdues such a person ", "dhp7:6": "just as the wind subdues a weak tree. ", "dhp8:1": "If one does not focus on beauty, ", "dhp8:2": "has good sense-restraint, ", "dhp8:3": "knows the right amount when eating, ", "dhp8:4": "has faith, and has persistent energy, ", "dhp8:5": "Māra does not subdue such a person ", "dhp8:6": "just as the wind does not subdue a stone mountain. ", "dhp9:0": "", "dhp9:1": "An impure person ", "dhp9:2": "who dons a monastic robe ", "dhp9:3": "without true self-control ", "dhp9:4": "is not worthy of the monastic robe. ", "dhp10:1": "One who has expelled all impurity, ", "dhp10:2": "is focused on moral conduct, ", "dhp10:3": "and is committed to true self-control ", "dhp10:4": "is worthy of the monastic robe. ", "dhp11:0": "", "dhp11:1": "One who thinks the non-essential is essential ", "dhp11:2": "and who sees the essential as non-essential ", "dhp11:3": "does not arrive at the essence; ", "dhp11:4": "their conduct is based on incorrect attitudes. ", "dhp12:1": "One who knows the essential as essential ", "dhp12:2": "and the non-essential as non-essential ", "dhp12:3": "arrives at the essence; ", "dhp12:4": "their conduct is based on correct attitudes. ", "dhp13:0": "", "dhp13:1": "Just as rain penetrates ", "dhp13:2": "a poorly sealed house, ", "dhp13:3": "in the same way, passion penetrates ", "dhp13:4": "an undeveloped mind. ", "dhp14:1": "Just as rain does not penetrate ", "dhp14:2": "a well-sealed house, ", "dhp14:3": "in the same way, passion does not penetrate ", "dhp14:4": "a well-developed mind. ", "dhp15:0": "", "dhp15:1": "One sorrows here, one sorrows afterwards, ", "dhp15:2": "an evildoer sorrows both times. ", "dhp15:3": "One sorrows and agonizes ", "dhp15:4": "after seeing one's own defiled actions. ", "dhp16:0": "", "dhp16:1": "One rejoices here, one rejoices afterwards, ", "dhp16:2": "one who has made merit rejoices both times. ", "dhp16:3": "One rejoices and exults ", "dhp16:4": "after seeing one's own pure actions. ", "dhp17:0": "", "dhp17:1": "Tormented here, tormented afterwards, ", "dhp17:2": "an evildoer is tormented both times. ", "dhp17:3": "One is tormented by the thought “I have done evil,” ", "dhp17:4": "And one is tormented even more when one has arrived at a bad destiny. ", "dhp18:0": "", "dhp18:1": "One delights here, one delights afterwards, ", "dhp18:2": "one who has made merit delights both times. ", "dhp18:3": "One is delighted by the thought “I have made merit,” ", "dhp18:4": "And one delights even more when one has arrived at a good destiny. ", "dhp19:0": "", "dhp19:1": "A negligent person who says much that is beneficial ", "dhp19:2": "but does not act accordingly ", "dhp19:3": "is like a cowherd who counts other people's cows, ", "dhp19:4": "and is not part of the contemplative life. ", "dhp20:1": "Even if they say little that is beneficial, ", "dhp20:2": "one who lives according to the Dhamma, ", "dhp20:3": "having abandoned passion, hatred, and delusion, ", "dhp20:4": "with accurate understanding and a well-liberated mind, ", "dhp20:5": "not grasping either here or beyond, ", "dhp20:6": "is part of the contemplative life. ", "dhp20:7": ""}, "variant_text": {"dhp1:0.1": "", "dhp1:0.2": "", "dhp1:0.3": "", "dhp1:0.4": "", "dhp1:1": "", "dhp1:2": "", "dhp1:3": "", "dhp1:4": "", "dhp1:5": "", "dhp1:6": "", "dhp2:0": "", "dhp2:1": "", "dhp2:2": "", "dhp2:3": "", "dhp2:4": "", "dhp2:5": "", "dhp2:6": "anapāyinī → anupāyinī (sya-all, mr) ", "dhp3:0": "", "dhp3:1