[{"acronym": "Ja 216", "alt_acronym": null, "volpages": "PTS 2.178", "alt_volpages": null, "uid": "ja216", "blurb": "“’Tis not the fire”—This story the Master told during a stay in Jetavana, about one who hankered after a former wife. The Master asked this Brother, “Is it true, Brother, what I hear, that you are lovesick?” “Yes, Sir.” “For whom?” “For my late wife.” Then the Master said to him: “This wife, Brother, has been the mischief to you. Long ago by her means you came near being spitted and roasted for food, but wise men saved your life.” Then he told a tale of the past.", "difficulty": null, "original_title": "Macchajātaka", "root_lang": "pli", "root_lang_name": "Pāli", "type": "leaf", "translated_title": "Maccha Jātaka", "translations": [{"lang": "pli", "lang_name": "Pāli", "is_root": true, "author": "Mahāsaṅgīti Tipiṭaka Buddhavasse 2500", "author_short": "ms", "author_uid": "ms", "publication_date": null, "id": "ja216_root-pli-ms", "segmented": true, "title": null, "volpage": null, "has_comment": false}, {"lang": "de", "lang_name": "Deutsch", "is_root": false, "author": "Dr. Julius Dutoit", "author_short": "Dutoit", "author_uid": "dutoit", "publication_date": "2007", "id": "de_ja216_dutoit", "segmented": false, "volpage": null, "has_comment": false}, {"author": "W.H.D. Rouse", "author_short": "Rouse", "author_uid": "rouse", "has_comment": false, "id": "en_ja216_rouse", "is_root": false, "lang": "en", "lang_name": "English", "publication_date": "1895", "segmented": false, "volpage": null, "title": "Maccha Jātaka"}, {"lang": "jpn", "lang_name": "日本語", "is_root": false, "author": "関西パーリ語実習会", "author_short": "関西パーリ語実習会", "author_uid": "kansai", "publication_date": "2023", "id": "jpn_ja216_kansai", "segmented": false, "volpage": null, "has_comment": false}, {"lang": "si", "lang_name": "සිංහල", "is_root": false, "author": "A.P. de Zoysa", "author_short": "Zoysa", "author_uid": "zoysa", "publication_date": null, "id": "si_ja216_zoysa", "segmented": false, "volp