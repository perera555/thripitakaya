", "ja358:2.4": "Pāde me deva chedehi. ", "ja358:3.1": "Ahameva dūsiyā bhūnahatā, ", "ja358:3.2": "Rañño mahāpatāpassa; ", "ja358:3.3": "Etaṁ muñcatu dhammapālaṁ, ", "ja358:3.4": "Sīsaṁ me deva chedehi. ", "ja358:4.1": "Na hi nūnimassa rañño, ", "ja358:4.2": "Mittāmaccā ca vijjare suhadā; ", "ja358:4.3": "Ye na vadanti rājānaṁ, ", "ja358:4.4": "Mā ghātayi orasaṁ puttaṁ. ", "ja358:5.1": "Na hi nūnimassa rañño, ", "ja358:5.2": "Ñātī mittā ca vijjare suhadā; ", "ja358:5.3": "Ye na vadanti rājānaṁ, ", "ja358:5.4": "Mā ghātayi atrajaṁ puttaṁ. ", "ja358:6.1": "Candanasārānulittā, ", "ja358:6.2": "Bāhā chijjanti dhammapālassa; ", "ja358:6.3": "Dāyādassa pathabyā, ", "ja358:6.4": "Pāṇā me deva rujjhantī”ti. ", "ja358:7.1": "Cūḷadhammapālajātakaṁ aṭṭhamaṁ. "}, "variant_text": {"ja358:0.1": "", "ja358:0.2": "", "ja358:0.3": "", "ja358:0.4": "", "ja358:1.1": "", "ja358:1.2": "", "ja358:1.3": "", "ja358:1.4": "", "ja358:2.1": "", "ja358:2.2": "", "ja358:2.3": "", "ja358:2.4": "", "ja358:3.1": "", "ja358:3.2": "", "ja358:3.3": "", "ja358:3.4": "", "ja358:4.1": "Na hi → naha (bj, sya1ed, sya2ed, pts-vp-pli1) ", "ja358:4.2": "", "ja358:4.3": "", "ja358:4.4": "", "ja358:5.1": "Na hi → naha (bj, sya1ed, sya2ed, pts-vp-pli1) ", "ja358:5.2": "", "ja358:5.3": "", "ja358:5.4": "", "ja358:6.1": "", "ja358:6.2": "", "ja358:6.3": "", "ja358:6.4": "", "ja358:7.1": "Cūḷadhammapālajātakaṁ → culladhammapālajātakaṁ (bj, sya1ed, sya2ed) "}, "reference_text": {"ja358:0.1": "", "ja358:0.2": "", "ja358:0.3": "", "ja358:0.4": "", "ja358:1.1": "ms22J_1196, msdiv44, pts-vp-pli3.179, vri68.106", "ja358:1.2": "", "ja358:1.3": "", "ja358:1.4": "", "ja358:2.1": "ms22J_1197, msdiv45, pts-vp-pli3.180", "ja358:2.2": "", "ja358:2.3": "", "ja358:2.4": "", "ja358:3.1": "ms22J_1198, msdiv46, sya27.172", "ja358:3.2": "", "ja358:3.3": "", "ja358:3.4": "", "ja358:4.1": "ms22J_1199, msdiv47, ndp22.117, pts-vp-pli3.181", "ja358:4.2": "", "ja358:4.3": "", "ja358:4.4": "", "ja358:5.1": "ms22J_1200, msdiv48", "ja358:5.2