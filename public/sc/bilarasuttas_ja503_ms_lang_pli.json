a503:27.1": "<p><span class='verse-line'>{}</span>", "ja503:27.2": "<span class='verse-line'>{}</span>", "ja503:27.3": "<span class='verse-line'>{}</span>", "ja503:27.4": "<span class='verse-line'>{}</span>", "ja503:27.5": "<span class='verse-line'>{}</span>", "ja503:27.6": "<span class='verse-line'>{}</span></p></blockquote>", "ja503:28.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja503:0.1": "Jātaka ", "ja503:0.2": "Vīsatinipāta ", "ja503:0.3": "Mātaṅgavagga ", "ja503:0.4": "7. Sattigumbajātaka ", "ja503:1.1": "Migaluddo mahārājā, ", "ja503:1.2": "pañcālānaṁ rathesabho; ", "ja503:1.3": "Nikkhanto saha senāya, ", "ja503:1.4": "ogaṇo vanamāgamā. ", "ja503:2.1": "Tatthaddasā araññasmiṁ, ", "ja503:2.2": "takkarānaṁ kuṭiṁ kataṁ; ", "ja503:2.3": "Tassā kuṭiyā nikkhamma, ", "ja503:2.4": "suvo luddāni bhāsati. ", "ja503:3.1": "“Sampannavāhano poso, ", "ja503:3.2": "yuvā sammaṭṭhakuṇḍalo; ", "ja503:3.3": "Sobhati lohituṇhīso, ", "ja503:3.4": "divā sūriyova bhāsati. ", "ja503:4.1": "Majjhanhike sampatike, ", "ja503:4.2": "sutto rājā sasārathi; ", "ja503:4.3": "Handassābharaṇaṁ sabbaṁ, ", "ja503:4.4": "gaṇhāma sāhasā mayaṁ. ", "ja503:5.1": "Nisīthepi raho dāni, ", "ja503:5.2": "Sutto rājā sasārathi; ", "ja503:5.3": "Ādāya vatthaṁ maṇikuṇḍalañca, ", "ja503:5.4": "Hantvāna sākhāhi avattharāma”. ", "ja503:6.1": "“Kiṁ nu ummattarūpova, ", "ja503:6.2": "sattigumba pabhāsasi; ", "ja503:6.3": "Durāsadā hi rājāno, ", "ja503:6.4": "aggi pajjalito yathā”. ", "ja503:7.1": "“Atha tvaṁ patikolamba, ", "ja503:7.2": "matto thullāni gajjasi; ", "ja503:7.3": "Mātari mayhaṁ naggāya, ", "ja503:7.4": "kiṁ nu tvaṁ vijigucchase”. ", "ja503:8.1": "“Uṭṭhehi samma taramāno, ", "ja503:8.2": "rathaṁ yojehi sārathi; ", "ja503:8.3": "Sakuṇo me na ruccati, ", "ja503:8.4": "aññaṁ gacchāma assamaṁ”. ", "ja503:9.1": "“Yutto ratho mahārāja, ", "ja503:9.2": "yutto ca balavāhano; ", "ja503:9.3": "Adhitiṭṭha mahārāja, ", "ja503:9.4": "aññaṁ gacchāma assamaṁ”. ", "ja503:10.1": "“Ko numeva gatā sabbe, ", "ja503:10.2": "ye asmiṁ paricārakā; ", "ja503:10.3": "Esa gacchati pañcālo, ", "ja503:10.4": "mutto tesaṁ adassanā. ", "ja503:11.1": "Kodaṇḍakāni gaṇhatha, ", "ja503:11.2": "sattiyo tomarāni ca; ", "ja503:11.3": "Esa gacchati pañcālo, ", "ja503:11.4": "mā vo muñcittha jīvataṁ”. ", "ja503:12.1": "Athāparo paṭinandittha, ", "ja503:12.2": "suvo lohitatuṇḍako; ", "ja503:12.3": "“Svāgataṁ te mahārāja, ", "ja503:12.4": "atho te adurāgataṁ; ", "ja503:12.5": "Issarosi anuppatto, ", "ja503:12.6": "yaṁ idhatthi pavedaya. ", "ja503:13.1": "Tindukāni piyālāni, ", "ja503:13.2": "madhuke kāsumāriyo; ", "ja503:13.3": "Phalāni khuddakappāni, ", "ja503:13.4": "bhuñja rāja varaṁ varaṁ. ", "ja503:14.1": "Idampi pānīyaṁ sītaṁ, ", "ja503:14.2": "ābhataṁ girigabbharā; ", "ja503:14.3": "Tato piva mahārāja, ", "ja503:14.4": "sace tvaṁ abhikaṅkhasi. ", "ja503:15.1": "Araññaṁ uñchāya gatā, ", "ja503:15.2": "ye asmiṁ paricārakā; ", "ja503:15.3": "Sayaṁ uṭṭhāya gaṇhavho, ", "ja503:15.4": "hatthā me natthi dātave”. ", "ja503:16.1": "“Bhaddako vatayaṁ pakkhī, ", "ja503:16.2": "dijo paramadhammiko; ", "ja503:16.3": "Atheso itaro pakkhī, ", "ja503:16.4": "suvo luddāni bhāsati. ", "ja503:17.1": "‘Etaṁ hanatha bandhatha, ", "ja503:17.2": "Mā vo muñcittha jīvataṁ’; ", "ja503:17.3": "Iccevaṁ vilapantassa, ", "ja503:17.4": "Sotthiṁ pattosmi assamaṁ”. ", "ja503:18.1": "“Bhātarosma mahārāja, ", "ja503:18.2": "sodariyā ekamātukā; ", "ja503:18.3": "Ekarukkhasmiṁ saṁvaḍḍhā, ", "ja503:18.4": "nānākhettagatā ubho. ", "ja503:19.1": "Sattigumbo ca corānaṁ, ", "ja503:19.2": "ahañca isīnaṁ idha; ", "ja503:19.3": "Asataṁ so, sataṁ ahaṁ, ", "ja503:19.4": "tena dhammena no vinā”. ", "ja503:20.1": "“Tattha vadho ca bandho ca, ", "ja503:20.2": "nikatī vañcanāni ca; ", "ja503:20.3": "Ālopā sāhasākārā, ", "ja503:20.4": "tāni so tattha sikkhati. ", "ja503:21.1": "Idha saccañca dhammo ca, ", "ja503:21.2": "Ahiṁsā saṁyamo damo; ", "ja503:21.3": "Āsanūdakadāyīnaṁ, ", "ja503:21.4": "Aṅke vaddhosmi bhāradha”. ", "ja503:22.1": "“Yaṁ yañhi rāja bhajati, ", "ja503:22.2": "santaṁ vā yadi vā asaṁ; ", "ja503:22.3": "Sīlavantaṁ visīlaṁ vā, ", "ja503:22.4": "vasaṁ tasseva gacchati. ", "ja503:23.1": "Yādisaṁ kurute mittaṁ, ", "ja503:23.2": "yādisaṁ cūpasevati; ", "ja503:23.3": "Sopi tādisako hoti, ", "ja503:23.4": "sahavāso hi tādiso. ", "ja503:24.1": "Sevamāno sevamānaṁ, ", "ja503:24.2": "samphuṭṭho samphusaṁ paraṁ; ", "ja503:24.3": "Saro diddho kalāpaṁva, ", "ja503:24.4": "alittamupalimpati; ", "ja503:24.5": "Upalepabhayā dhīro, ", "ja503:24.6": "neva pāpasakhā siyā. ", "ja503:25.1": "Pūtimacchaṁ kusaggena, ", "ja503:25.2": "yo naro upanayhati; ", "ja503:25.3": "Kusāpi pūti vāyanti, ", "ja503:25.4": "evaṁ bālūpasevanā. ", "ja503:26.1": "Tagarañca palāsena, ", "ja503:26.2": "yo naro upanayhati; ", "ja503:26.3": "Pattāpi surabhi vāyanti, ", "ja503:26.4": "evaṁ dhīrūpasevanā. ", "ja503:27.1": "Tasmā pattapuṭasseva, ", "ja503:27.2": "ñatvā sampākamattano; ", "ja503:27.3": "Asante nopaseveyya, ", "ja503:27.4": "sante seveyya paṇḍito; ", "ja503:27.5": "Asanto nirayaṁ nenti, ", "ja503:27.6": "santo pāpenti suggatin”ti. ", "ja503:28.1": "Sattigumbajātakaṁ sattamaṁ. "}, "variant_text": {"ja503:0.1": "", "ja503:0.2": "", "ja503:0.3": "", "ja503:0.4": "", "ja503:1.1": "", "ja503:1.2": "", "ja503:1.3": "", "ja503:1.4": "", "ja503:2.1": "", "ja503:2.2": "", "ja503:2.3": "Tassā → tasmā (sya1ed, sya2ed, mr) ", "ja503:2.4": "", "ja503:3.1": "", "ja503:3.2": "sammaṭṭhakuṇḍalo → … kuṇḍalī (sya1ed, sya2ed, mr) ", "ja503:3.3": "", "ja503:3.4": "", "ja503:4.1": "Majjhanhike → majjhantike (sabbattha) ", "ja503:4.2": "", "ja503:4.3": "", "ja503:4.4": "sāhasā → sahasā (bj, sya1ed, sya2ed, pts-vp-pli1) ", "ja503:5.1": "", "ja503:5.2": "", "ja503:5.3": "", "ja503:5.4": "", "ja503:6.1": "", "ja503:6.2": "", "ja503:6.3": "", "ja503:6.4": "", "ja503:7.1": "", "ja503:7.2": "", "ja503:7.3": "", "ja503:7.4": "", "ja503:8.1": "", "ja503:8.2": "", "ja503:8.3": "", "ja503:8.4": "", "ja503:9.1": "", "ja503:9.2": "", "ja50