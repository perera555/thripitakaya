4": "<span class='verse-line'>{}</span></p>", "ja529:63.1": "<p><span class='verse-line'>{}</span>", "ja529:63.2": "<span class='verse-line'>{}</span>", "ja529:63.3": "<span class='verse-line'>{}</span>", "ja529:63.4": "<span class='verse-line'>{}</span></p>", "ja529:64.1": "<p><span class='verse-line'>{}</span>", "ja529:64.2": "<span class='verse-line'>{}</span>", "ja529:64.3": "<span class='verse-line'>{}</span>", "ja529:64.4": "<span class='verse-line'>{}</span>", "ja529:64.5": "<span class='verse-line'>{}</span>", "ja529:64.6": "<span class='verse-line'>{}</span></p>", "ja529:65.1": "<p><span class='verse-line'>{}</span>", "ja529:65.2": "<span class='verse-line'>{}</span>", "ja529:65.3": "<span class='verse-line'>{}</span>", "ja529:65.4": "<span class='verse-line'>{}</span></p>", "ja529:66.1": "<p><span class='verse-line'>{}</span>", "ja529:66.2": "<span class='verse-line'>{}</span>", "ja529:66.3": "<span class='verse-line'>{}</span>", "ja529:66.4": "<span class='verse-line'>{}</span></p>", "ja529:67.1": "<p><span class='verse-line'>{}</span>", "ja529:67.2": "<span class='verse-line'>{}</span>", "ja529:67.3": "<span class='verse-line'>{}</span>", "ja529:67.4": "<span class='verse-line'>{}</span></p>", "ja529:68.1": "<p><span class='verse-line'>{}</span>", "ja529:68.2": "<span class='verse-line'>{}</span>", "ja529:68.3": "<span class='verse-line'>{}</span>", "ja529:68.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja529:69.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja529:0.1": "Jātaka ", "ja529:0.2": "Saṭṭhinipāta ", "ja529:0.3": "Soṇakavagga ", "ja529:0.4": "1 Soṇakajātaka ", "ja529:1.1": "“Tassa sutvā sataṁ dammi, ", "ja529:1.2": "sahassaṁ diṭṭha soṇakaṁ; ", "ja529:1.3": "Ko me soṇakamakkhāti, ", "ja529:1.4": "sahāyaṁ paṁsukīḷitaṁ”. ", "ja529:2.1": "“Athabravī māṇavako, ", "ja529:2.2": "daharo pañcacūḷako; ", "ja529:2.3": "Mayhaṁ sutvā sataṁ dehi, ", "ja529:2.4": "sahassaṁ diṭṭha soṇakaṁ; ", "ja529:2.5": "Ahaṁ te soṇakakkhissaṁ, ", "ja529:2.6": "sahāyaṁ paṁsukīḷitaṁ”. ", "ja529:3.1": "“Katamasmiṁ so janapade, ", "ja529:3.2": "raṭṭhesu nigamesu ca; ", "ja529:3.3": "Kattha soṇakamaddakkhi, ", "ja529:3.4": "taṁ me akkhāhi pucchito”. ", "ja529:4.1": "“Taveva deva vijite, ", "ja529:4.2": "tavevuyyānabhūmiyā; ", "ja529:4.3": "Ujuvaṁsā mahāsālā, ", "ja529:4.4": "nīlobhāsā manoramā. ", "ja529:5.1": "Tiṭṭhanti meghasamānā, ", "ja529:5.2": "rammā aññoññanissitā; ", "ja529:5.3": "Tesaṁ mūlamhi soṇako, ", "ja529:5.4": "jhāyatī anupādano; ", "ja529:5.5": "Upādānesu lokesu, ", "ja529:5.6": "ḍayhamānesu nibbuto”. ", "ja529:6.1": "Tato ca rājā pāyāsi, ", "ja529:6.2": "senāya caturaṅgiyā; ", "ja529:6.3": "Kārāpetvā samaṁ maggaṁ, ", "ja529:6.4": "agamā yena soṇako. ", "ja529:7.1": "Uyyānabhūmiṁ gantvāna, ", "ja529:7.2": "vicaranto brahāvane; ", "ja529:7.3": "Āsīnaṁ soṇakaṁ dakkhi, ", "ja529:7.4": "ḍayhamānesu nibbutaṁ. ", "ja529:8.1": "“Kapaṇo vatayaṁ bhikkhu, ", "ja529:8.2": "muṇḍo saṅghāṭipāruto; ", "ja529:8.3": "Amātiko apitiko, ", "ja529:8.4": "rukkhamūlasmi jhāyati”. ", "ja529:9.1": "Imaṁ vākyaṁ nisāmetvā, ", "ja529:9.2": "Soṇako etadabravi; ", "ja529:9.3": "“Na rāja kapaṇo hoti, ", "ja529:9.4": "Dhammaṁ kāyena phassayaṁ. ", "ja529:10.1": "Yo ca dhammaṁ niraṅkatvā, ", "ja529:10.2": "Adhammamanuvattati; ", "ja529:10.3": "Sa rāja kapaṇo hoti, ", "ja529:10.4": "Pāpo pāpaparāyaṇo”. ", "ja529:11.1": "“Arindamoti me nāmaṁ, ", "ja529:11.2": "kāsirājāti maṁ vidū; ", "ja529:11.3": "Kacci bhoto sukhasseyyā, ", "ja529:11.4": "idha pattassa soṇaka”. ", "ja529:12.1": "“Sadāpi bhadramadhanassa, ", "ja529:12.2": "Anāgārassa bhikkhuno; ", "ja529:12.3": "Na tesaṁ koṭṭhe openti, ", "ja529:12.4": "Na kumbhiṁ na khaḷopiyaṁ; ", "ja529:12.5": "Paraniṭṭhitamesānā, ", "ja529:12.6": "Tena yāpenti subbatā. ", "ja529:13.1": "Dutiyampi bhadramadhanassa, ", "ja529:13.2": "Anāgārassa bhikkhuno; ", "ja529:13.3": "Anavajjapiṇḍo bhottabbo, ", "ja529:13.4": "Na ca kocūparodhati. ", "ja529:14.1": "Tatiyampi bhadramadhanassa, ", "ja529:14.2": "Anāgārassa bhikkhuno; ", "ja529:14.3": "Nibbuto piṇḍo bhottabbo, ", "ja529:14.4": "Na ca kocūparodhati. ", "ja529:15.1": "Catutthampi bhadramadhanassa, ", "ja529:15.2": "Anāgārassa bhikkhuno; ", "ja529:15.3": "Muttassa raṭṭhe carato, ", "ja529:15.4": "Saṅgo yassa na vijjati. ", "ja529:16.1": "Pañcamampi bhadramadhanassa, ", "ja529:16.2": "Anāgārassa bhikkhuno; ", "ja529:16.3": "Nagaramhi ḍayhamānamhi, ", "ja529:16.4": "Nāssa kiñci aḍayhatha. ", "ja529:17.1": "Chaṭṭhampi bhadramadhanassa, ", "ja529:17.2": "Anāgārassa bhikkhuno; ", "ja529:17.3": "Raṭṭhe vilumpamānamhi, ", "ja529:17.4": "Nāssa kiñci ahīratha. ", "ja529:18.1": "Sattamampi bhadramadhanassa, ", "ja529:18.2": "Anāgārassa bhikkhuno; ", "ja529:18.3": "Corehi rakkhitaṁ maggaṁ, ", "ja529:18.4": "Ye caññe paripanthikā; ", "ja529:18.5": "Pattacīvaramādāya, ", "ja529:18.6": "Sotthiṁ gacchati subbato. ", "ja529:19.1": "Aṭṭhamampi bhadramadhanassa, ", "ja529:19.2": "Anāgārassa bhikkhuno; ", "ja529:19.3": "Yaṁ yaṁ disaṁ pakkamati, ", "ja529:19.4": "Anapekkhova gacchati”. ", "ja529:20.1": "“Bahūni samaṇabhadrāni, ", "ja529:20.2": "ye tvaṁ bhikkhu pasaṁsasi; ", "ja529:20.3": "Ahañca giddho kāmesu, ", "ja529:20.4": "kathaṁ kāhāmi soṇaka. ", "ja529:21.1": "Piyā me mānusā kāmā, ", "ja529:21.2": "atho dibyāpi me piyā; ", "ja529:21.3": "Atha kena nu vaṇṇena, ", "ja529:21.4": "ubho loke labhāmase”. ", "ja529:22.1": "“Kāme giddhā kāmaratā, ", "ja529:22.2": "kāmesu adhimucchitā; ", "ja529:22.3": "Narā pāpāni katvāna, ", "ja529:22.4": "upapajjanti duggatiṁ. ", "ja529:23.1": "Ye ca kāme pahantvāna, ", "ja529:23.2": "nikkhantā akutobhayā; ", "ja529:23.3": "Ekodibhāvādhigatā, ", "ja529:23.4": "na te gacchanti duggatiṁ. ", "ja529:24.1": "Upamaṁ te karissāmi, ", "ja529:24.2": "taṁ suṇohi arindama; ", "ja529:24.3": "Upamāya midhekacce, ", "ja529:24.4": "atthaṁ jānanti paṇḍitā. ", "ja529:25.1": "Gaṅgāya kuṇapaṁ disvā, ", "ja529:25.2": "vuyhamānaṁ mahaṇṇave; ", "ja529:25.3": "Vāyaso samacintesi, ", "ja529:25.4": "appapañño acetaso. ", "ja529:26.1": "‘Yānañca vatidaṁ laddhaṁ, ", "ja529:26.2": "bhakkho cāyaṁ anappako’; ", "ja529:26.3": "Tattha rattiṁ tattha divā, ", "ja529:26.4": "tattheva nirato mano. ", "ja529:27.1": "Khādaṁ nāgassa maṁsāni, ", "ja529:27.2": "pivaṁ bhāgīrathodakaṁ; ", "ja529:27.3": "Sampassaṁ vanacetyāni, ", "ja529:27.4": "na palettha vihaṅgamo. ", "ja529:28.1": "Tañca otaraṇī gaṅgā, ", "ja529:28.2": "pamattaṁ kuṇape rataṁ; ", "ja529:28.3": "Samuddaṁ ajjhagāhāsi, ", "ja529:28.4": "agatī yattha pakkhinaṁ. ", "ja529:29.1": "So ca bhakkhaparikkhīṇo, ", "ja529:29.2": "udapatvā vihaṅgamo; ", "ja529:29.3": "Na pacchato na purato, ", "ja529:29.4": "nuttaraṁ nopi dakkhiṇaṁ. ", "ja529:30.1": "Dīpaṁ so najjhagāgañchi, ", "ja529:30.2": "agatī yattha pakkhinaṁ; ", "ja529:30.3": "So ca tattheva pāpattha, ", "ja529:30.4": "yathā dubbalako tathā. ", "ja529:31.1": "Tañca sāmuddikā macchā, ", "ja529:31.2": "kumbhīlā makarā susū; ", "ja529:31.3": "Pasayhakārā khādiṁsu, ", "ja529:31.4": "phandamānaṁ vipakkhakaṁ. ", "ja529:32.1": "Evameva tuvaṁ rāja, ", "ja529:32.2": "ye caññe kāmabhogino; ", "ja529:32.3": "Giddhā ce na vamissanti, ", "ja529:32.4": "kākapaññāva te vidū. ", "ja529:33.1": "Esā te upamā rāja, ", "ja529:33.2": "atthasandassanī katā; ", "ja529:33.3": "Tvañca paññāyase tena, ", "ja529:33.4": "yadi kāhasi vā na vā. ", "ja529:34.1": "Ekavācampi dvivācaṁ, ", "ja529:34.2": "bhaṇeyya anukampako; ", "ja529:34.3": "Tatuttariṁ na bhāseyya, ", "ja529:34.4": "dāsovayyassa santike”. ", "ja529:35.1": "Idaṁ vatvāna pakkāmi, ", "ja529:35.2": "soṇako amitabuddhimā; ", "ja529:35.3": "Vehāse antalikkhasmiṁ, ", "ja529:35.4": "anusāsitvāna khattiyaṁ. ", "ja529:36.1": "“Ko nume rājakattāro, ", "ja529:36.2": "suddā veyyattamāgatā; ", "ja529:36.3": "Rajjaṁ niyyādayissāmi, ", "ja529:36.4": "nāhaṁ rajjena matthiko. ", "ja529:37.1": "Ajjeva pabbajissāmi, ", "ja529:37.2": "Ko jaññā maraṇaṁ suve; ", "ja529:37.3": "Māhaṁ kākova dummedho, ", "ja529:37.4": "Kāmānaṁ vasamanvagaṁ”. ", "ja529:38.1": "“Atthi te daharo putto, ", "ja529:38.2": "dīghāvu raṭṭhavaḍḍhano; ", "ja529:38.3": "Taṁ rajje abhisiñcassu, ", "ja529:38.4": "so no rājā bhavissati”. ", "ja529:39.1": "“Khippaṁ kumāramānetha, ", "ja529:39.2": "dīghāvuṁ raṭṭhavaḍḍhanaṁ; ", "ja529:39.3": "Taṁ rajje abhisiñcissaṁ, ", "ja529:39.4": "so vo rājā bhavissati”. ", "ja529:40.1": "Tato kumāramānesuṁ, ", "ja529:40.2": "dīghāvuṁ raṭṭhavaḍḍhanaṁ; ", "ja529:40.3": "Taṁ disvā ālapī rājā, ", "ja529:40.4": "ekaputtaṁ manoramaṁ. ", "ja529:41.1": "“Saṭṭhi gāmasahassāni, ", "ja529:41.2": "paripuṇṇāni sabbaso; ", "ja529:41.3": "Te putta paṭipajjassu, ", "ja529:41.4": "rajjaṁ niyyādayāmi te. ", "ja529:42.1": "Ajjeva pabbajissāmi, ", "ja529:42.2": "ko jaññā maraṇaṁ suve; ", "ja529:42.3": "Māhaṁ kākova dummedho, ", "ja529:42.4": "kāmānaṁ vasamanvagaṁ. ", "ja529:43.1": "Saṭṭhi nāgasahassāni, ", "ja529:43.2": "sabbālaṅkārabhūsitā; ", "ja529:43.3": "Suvaṇṇakacchā mātaṅgā, ", "ja529:43.4": "hemakappanavāsasā. ", "ja529:44.1": "Ārūḷhā gāmaṇīyehi, ", "ja529:44.2": "tomaraṅkusapāṇibhi; ", "ja529:44.3": "Te putta paṭipajjassu, ", "ja529:44.4": "rajjaṁ niyyādayāmi te. ", "ja529:45.1": "Ajjeva pabbajissāmi, ", "ja529:45.2": "ko jaññā maraṇaṁ suve; ", "ja529:45.3": "Māhaṁ kākova dummedho, ", "ja529:45.4": "kāmānaṁ vasamanvagaṁ. ", "ja529:46.1": "Saṭṭhi assasahassāni, ", "ja529:46.2": "sabbālaṅkārabhūsitā; ", "ja529:46.3": "Ājānīyāva jātiyā, ", "ja529:46.4": "sindhavā sīghavāhino. ", "ja529:47.1": "Ārūḷhā gāmaṇīyehi, ", "ja529:47.2": "illiyācāpadhāribhi; ", "ja529:47.3": "Te putta paṭipajjassu, ", "ja529:47.4": "rajjaṁ niyyādayāmi te. ", "ja529:48.1": "Ajjeva pabbajissāmi, ", "ja529:48.2": "ko jaññā maraṇaṁ suve; ", "ja529:48.3": "Māhaṁ kākova dummedho, ", "ja529:48.4": "kāmānaṁ vasamanvagaṁ. ", "ja529:49.1": "Saṭṭhi rathasahassāni, ", "ja529:49.2": "sannaddhā ussitaddhajā; ", "ja529:49.3": "Dīpā athopi veyyagghā, ", "ja529:49.4": "sabbālaṅkārabhūsitā. ", "ja529:50.1": "Ārūḷhā gāmaṇīyehi, ", "ja529:50.2": "cāpahatthehi vammibhi; ", "ja529:50.3": "Te putta paṭipajjassu, ", "ja529:50.4": "rajjaṁ niyyādayāmi te. ", "ja529:51.1": "Ajjeva pabbajissāmi, ", "ja529:51.2": "ko jaññā maraṇaṁ suve; ", "ja529:51.3": "Māhaṁ kākova dummedho, ", "ja529:51.4": "kāmānaṁ vasamanvagaṁ. ", "ja529:52.1": "Saṭṭhi dhenusahassāni, ", "ja529:52.2": "rohaññā puṅgavūsabhā; ", "ja529:52.3": "Tā putta paṭipajjassu, ", "ja529:52.4": "rajjaṁ niyyādayāmi te. ", "ja529:53.1": "Ajjeva pabbajissāmi, ", "ja529:53.2": "ko jaññā maraṇaṁ suve; ", "ja529:53.3": "Māhaṁ kākova dummedho, ", "ja529:53.4": "kāmānaṁ vasamanvagaṁ. ", "ja529:54.1": "Soḷasitthisahassāni, ", "ja529:54.2": "sabbālaṅkārabhūsitā; ", "ja529:54.3": "Vicitravatthābharaṇā, ", "ja529:54.4": "āmuttamaṇikuṇḍalā; ", "ja529:54.5": "Tā putta paṭipajjassu, ", "ja529:54.6": "rajjaṁ niyyādayāmi te. ", "ja529:55.1": "Ajjeva pabbajissāmi, ", "ja529:55.2": "ko jaññā maraṇaṁ suve; ", "ja529:55.3": "Māhaṁ kākova dummedho, ", "ja529:55.4": "kāmānaṁ vasamanvagaṁ”. ", "ja529:56.1": "“Daharasseva me tāta, ", "ja529:56.2": "mātā matāti me sutaṁ; ", "ja529:56.3": "Tayā vinā ahaṁ tāta, ", "ja529:56.4": "jīvitumpi na ussahe. ", "ja529:57.1": "Yathā āraññakaṁ nāgaṁ, ", "ja529:57.2": "poto anveti pacchato; ", "ja529:57.3": "Jessantaṁ giriduggesu, ", "ja529:57.4": "samesu visamesu ca. ", "ja529:58.1": "Evaṁ taṁ anugacchāmi, ", "ja529:58.2": "pattamādāya pacchato; ", "ja529:58.3": "Subharo te bhavissāmi, ", "ja529:58.4": "na te hessāmi dubbharo”. ", "ja529:59.1": "“Yathā sāmuddikaṁ nāvaṁ, ", "ja529:59.2": "vāṇijānaṁ dhanesinaṁ; ", "ja529:59.3": "Vohāro tattha gaṇheyya, ", "ja529:59.4": "vāṇijā byasanī siyā. ", "ja529:60.1": "Evamevāyaṁ puttakali, ", "ja529:60.2": "antarāyakaro mama; ", "ja529:60.3": "Imaṁ kumāraṁ pāpetha, ", "ja529:60.4": "pāsādaṁ rativaḍḍhanaṁ. ", "ja529:61.1": "Tattha kambusahatthāyo, ", "ja529:61.2": "yathā sakkaṁva accharā; ", "ja529:61.3": "Tā naṁ tattha ramessanti, ", "ja529:61.4": "tāhi ceso ramissati. ", "ja529:62.1": "Tato kumāraṁ pāpesuṁ, ", "ja529:62.2": "pāsādaṁ rativaḍḍhanaṁ; ", "ja529:62.3": "Taṁ disvā avacuṁ kaññā, ", "ja529:62.4": "dīghāvuṁ raṭṭhavaḍḍhanaṁ. ", "ja529:63.1": "Devatā nusi gandhabbo, ", "ja529:63.2": "adu sakko purindado; ", "ja529:63.3": "Ko vā tvaṁ kassa vā putto, ", "ja529:63.4": "kathaṁ jānemu taṁ mayaṁ”. ", "ja529:64.1": "“Namhi devo na gandhabbo, ", "ja529:64.2": "Nāpi sakko purindado; ", "ja529:64.3": "Kāsirañño ahaṁ putto, ", "ja529:64.4": "Dīghāvu raṭṭhavaḍḍhano; ", "ja529:64.5": "Mamaṁ bharatha bhaddaṁ vo, ", "ja529:64.6": "Ahaṁ bhattā bhavāmi vo”. ", "ja529:65.1": "Taṁ tattha avacuṁ kaññā, ", "ja529:65.2": "dīghāvuṁ raṭṭhavaḍḍhanaṁ; ", "ja529:65.3": "“Kuhiṁ rājā anuppatto, ", "ja529:65.4": "ito rājā kuhiṁ gato”. ", "ja529:66.1": "“Paṅkaṁ rājā atikkanto, ", "ja529:66.2": "thale rājā patiṭṭhito; ", "ja529:66.3": "Akaṇṭakaṁ agahanaṁ, ", "ja529:66.4": "paṭipanno mahāpathaṁ. ", "ja529:67.1": "Ahañca paṭipannosmi, ", "ja529:67.2": "maggaṁ duggatigāminaṁ; ", "ja529:67.3": "Sakaṇṭakaṁ sagahanaṁ, ", "ja529:67.4": "yena gacchanti duggatiṁ”. ", "ja529:68.1": "“Tassa te svāgataṁ rāja, ", "ja529:68.2": "sīhasseva giribbajaṁ; ", "ja529:68.3": "Anusāsa mahārāja, ", "ja529:68.4": "tvaṁ no sabbāsamissaro”ti. ", "ja529:69.1": "Soṇakajātakaṁ paṭhamaṁ. "}, "variant_text": {"ja529:0.1": "", "ja529:0.2": "", "ja529:0.3": "", "ja529:0.4": "", "ja529:1.1": "", "ja529:1.2": "diṭṭha → daṭṭhu (bj, pts-vp-pli1) ", "ja529:1.3": "", "ja529:1.4": "", "ja529:2.1": "", "ja529:2.2": "ca → yodha (bj, sya1ed, sya2ed) | niraṅkatvā → nirākatvā (?) ", "ja529:2.3": "", "ja529:2.4": "diṭṭha → daṭṭhu (bj, pts-vp-pli1) ", "ja529:2.5": "Ahaṁ te soṇakakkhissaṁ → ahaṁ soṇakamakkhissaṁ (bj, pts-vp-pli1); ahaṁ te soṇakamakkhissaṁ (sya1ed, sya2ed) ", "ja529:2.6": "", "ja529:3.1": "Katamasmiṁ → katarasmiṁ (bj, sya1ed, sya2ed, pts-vp-pli1) ", "ja529:3.2": "", "ja529:3.3": "Kattha soṇakamaddakkhi → kattha te soṇako diṭṭho (bj); kattha te sonako diṭṭho (pts-vp-pli1) ", "ja529:3.4": "", "ja529:4.1": "", "ja529:4.2": "", "ja529:4.3": "", "ja529:4.4": "", "ja529:5.1":