{"html_text": {"ja37:0.1": "<article id='ja37'><header><ul><li class='division'>{}</li>", "ja37:0.2": "<li>{}</li>", "ja37:0.3": "<li>{}</li></ul>", "ja37:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja37:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja37:1.2": "<span class='verse-line'>{}</span>", "ja37:1.3": "<span class='verse-line'>{}</span>", "ja37:1.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja37:2.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja37:0.1": "Jātaka ", "ja37:0.2": "Ekakanipāta ", "ja37:0.3": "Kulāvakavagga ", "ja37:0.4": "7. Tittirajātaka ", "ja37:1.1": "“Ye vuḍḍhamapacāyanti, ", "ja37:1.2": "narā dhammassa kovidā; ", "ja37:1.3": "Diṭṭheva dhamme pāsaṁsā, ", "ja37:1.4": "samparāye ca suggatī”ti. ", "ja37:2.1": "Tittirajātakaṁ sattamaṁ. "}, "variant_text": {"ja37:0.1": "", "ja37:0.2": "", "ja37:0.3": "", "ja37:0.4": "", "ja37:1.1": "vuḍḍhamapacāyanti → vaddhamapacāyanti (bj) ", "ja37:1.2": "", "ja37:1.3": "Diṭṭheva dhamme → diṭṭhe dhamme ca (sya1ed, sya2ed) ", "ja37:1.4": "", "ja37:2.1": ""}, "reference_text": {"ja37:0.1": "", "ja37:0.2": "", "ja37:0.3": "", "ja37:0.4": "", "ja37:1.1": "ms22J_80, msdiv37, pts-vp-pli1.219", "ja37:1.2": "", "ja37:1.3": "", "ja37:1.4": "", "ja37:2.1": "ms22J_81"}, "keys_order": ["ja37:0.1", "ja37:0.2", "ja37:0.3", "ja37:0.4", "ja37:1.1", "ja37:1.2", "ja37:1.3", "ja37:1.4", "ja37:2.1"]}