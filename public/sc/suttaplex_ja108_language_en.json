[{"acronym": "Ja 108", "alt_acronym": null, "volpages": "PTS 1.421", "alt_volpages": null, "uid": "ja108", "blurb": "“Learn thou betimes.”—This story was told by the Master, while he was dwelling in the Gabled Chamber at the Great Grove near Vesali, about a Licchavi, a pious prince who had embraced the Truth. He had invited the Brotherhood with the Buddha at their head to his house, and there had shewn great bounty towards them. Now his wife was a very fat woman, almost bloated in appearance, and she was badly dressed.", "difficulty": null, "original_title": "Bāhiyajātaka", "root_lang": "pli", "root_lang_name": "Pāli", "type": "leaf", "translated_title": "Bahiya Jātaka", "translations": [{"lang": "pli", "lang_name": "Pāli", "is_root": true, "author": "Mahāsaṅgīti Tipiṭaka Buddhavasse 2500", "author_short": "ms", "author_uid": "ms", "publication_date": null, "id": "ja108_root-pli-ms", "segmented": true, "title": null, "volpage": null, "has_comment": false}, {"lang": "de", "lang_name": "Deutsch", "is_root": false, "author": "Dr. Julius Dutoit", "author_short": "Dutoit", "author_uid": "dutoit", "publication_date": "2007", "id": "de_ja108_dutoit", "segmented": false, "volpage": null, "has_comment": false}, {"author": "Robert Chalmers", "author_short": "Chalmers", "author_uid": "chalmers", "has_comment": false, "id": "en_ja108_chalmers", "is_root": false, "lang": "en", "lang_name": "English", "publication_date": "1895", "segmented": false, "volpage": null, "title": "Bahiya Jātaka"}, {"lang": "jpn", "lang_name": "日本語", "is_root": false, "author": "関西パーリ語実習会", "author_short": "関西パーリ語実習会", "author_uid": "kansai", "publication_date": "2023", "id": "jpn_ja108_kansai", "segmented": false, "volpage": null, "has_comment": false}, {"lang": "si", "lang_name": "සිංහල", "is_root": false, "author": "A.P. de Zoysa", "author_short": "Zoysa", "author_uid": "zoysa", "publication_date": null, "id": "si_ja108_zoysa", "segmented": false, "volpage": null, "has_comment": false}], "parallel_co