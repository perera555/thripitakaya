{"html_text": {"ja403:0.1": "<article id='ja403'><header><ul><li class='division'>{}</li>", "ja403:0.2": "<li>{}</li>", "ja403:0.3": "<li>{}</li></ul>", "ja403:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja403:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja403:1.2": "<span class='verse-line'>{}</span>", "ja403:1.3": "<span class='verse-line'>{}</span>", "ja403:1.4": "<span class='verse-line'>{}</span></p>", "ja403:2.1": "<p><span class='verse-line'>{}</span>", "ja403:2.2": "<span class='verse-line'>{}</span>", "ja403:2.3": "<span class='verse-line'>{}</span>", "ja403:2.4": "<span class='verse-line'>{}</span></p>", "ja403:3.1": "<p><span class='verse-line'>{}</span>", "ja403:3.2": "<span class='verse-line'>{}</span>", "ja403:3.3": "<span class='verse-line'>{}</span>", "ja403:3.4": "<span class='verse-line'>{}</span></p>", "ja403:4.1": "<p><span class='verse-line'>{}</span>", "ja403:4.2": "<span class='verse-line'>{}</span>", "ja403:4.3": "<span class='verse-line'>{}</span>", "ja403:4.4": "<span class='verse-line'>{}</span></p>", "ja403:5.1": "<p><span class='verse-line'>{}</span>", "ja403:5.2": "<span class='verse-line'>{}</span>", "ja403:5.3": "<span class='verse-line'>{}</span>", "ja403:5.4": "<span class='verse-line'>{}</span></p>", "ja403:6.1": "<p><span class='verse-line'>{}</span>", "ja403:6.2": "<span class='verse-line'>{}</span>", "ja403:6.3": "<span class='verse-line'>{}</span>", "ja403:6.4": "<span class='verse-line'>{}</span></p>", "ja403:7.1": "<p><span class='verse-line'>{}</span>", "ja403:7.2": "<span class='verse-line'>{}</span>", "ja403:7.3": "<span class='verse-line'>{}</span>", "ja403:7.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja403:8.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja403:0.1": "Jātaka ", "ja403:0.2": "Sattakanipāta ", "ja403:0.3": "Kukkuvagga ", "ja403:0.4": "8. Aṭṭhisenakajātaka ", "ja403:1.1": "“Yeme ahaṁ na jānāmi, ", "ja403:1.2": "aṭṭhisena vanibbake; ", "ja403:1.3": "Te maṁ saṅgamma yācanti, ", "ja403:1.4": "kasmā maṁ tvaṁ na yācasi”. ", "ja403:2.1": "“Yācako appiyo hoti, ", "ja403:2.2": "yācaṁ adadamappiyo; ", "ja403:2.3": "Tasmāhaṁ taṁ na yācāmi, ", "ja403:2.4": "mā me videssanā ahu”. ", "ja403:3.1": "“Yo ve yācanajīvāno, ", "ja403:3.2": "kāle yācaṁ na yācati; ", "ja403:3.3": "Parañca puññā dhaṁseti, ", "ja403:3.4": "attanāpi na jīvati. ", "ja403:4.1": "Yo ca yācanajīvāno, ", "ja403:4.2": "kāle yācañhi yācati; ", "ja403:4.3": "Parañca puññaṁ labbheti, ", "ja403:4.4": "attanāpi ca jīvati. ", "ja403:5.1": "Na ve dessanti sappaññā, ", "ja403:5.2": "Disvā yācakamāgate; ", "ja403:5.3": "Brahmacāri piyo mesi, ", "ja403:5.4": "Vada tvaṁ bhaññamicchasi”. ", "ja403:6.1": "“Na ve yācanti sappaññā, ", "ja403:6.2": "Dhīro ca veditumarahati; ", "ja403:6.3": "Uddissa ariyā tiṭṭhanti, ", "ja403:6.4": "Esā ariyāna yācanā”. ", "ja403:7.1": "“Dadāmi te brāhmaṇa rohiṇīnaṁ, ", "ja403:7.2": "Gavaṁ sahassaṁ saha puṅgavena; ", "ja403:7.3": "Ariyo hi ariyassa kathaṁ na dajjā, ", "ja403:7.4": "Sutvāna gāthā tava dhammayuttā”ti. ", "ja403:8.1": "Aṭṭhisenakajātakaṁ aṭṭhamaṁ. "}, "variant_text": {"ja403:0.1": "", "ja403:0.2": "", "ja403:0.3": "", "ja403:0.4": "", "ja403:1.1": "", "ja403:1.2": "", "ja403:1.3": "ca → yo ve (mr) ", "ja403:1.4": "", "ja403:2.1": "", "ja403:2.2": "", "ja403:2.3": "", "ja403:2.4": "videssanā → viddesanā (bj, pts-vp-pli1); viddessanā (sya1ed, sya2ed) ", "ja403:3.1": "", "ja403:3.2": "", "ja403:3.3": "puññā → puññaṁ (sya1ed, sya2ed, mr) ", "ja403:3.4": "", "ja403:4.1": "", "ja403:4.2": "yācañhi yācati → yācaṁpi yācati (sya1ed, sya2ed); yācāni yācati (pts-vp-pli1); yācanaṁ yācati (mr); yācati yācanaṁ (bj -nissya) ", "ja403:4.3": "", "ja403:4.4": "", "ja403:5.1": "Na ve dessanti → na ve dissanti (bj); na ve dussanti (sya1ed, sya2ed); na ve dissanti (pts-vp-pli1); na videssanti (mr aṭṭha.) ", "ja403:5.2": "", "ja403:5.3": "", "ja403:5.4": "Vada tvaṁ → vara taṁ (bj); vara (sya1ed, sya2ed); vara tvaṁ (pts-vp-pli1) | bhaññamicchasi → bhaññitamicchasi (sya1ed, sya2ed); yaññamicchasi (?) ", "ja403:6.1": "", "ja403:6.2": "", "ja403:6.3": "", "ja403:6.4": "", "ja403:7.1": "", "ja403:7.2": "", "ja403:7.3": "", "ja403:7.4": "", "ja403:8.1": "Aṭṭhisenakajātakaṁ → aṭṭhisenajātakaṁ (bj, sya1ed, sya2ed, pts-vp-pli1) "}, "reference_text": {"ja403:0.1": "", "ja403:0.2": "", "ja403:0.3": "", "ja403:0.4": "", "ja403:1.1": "ms22J_1545, msdiv54, pts-vp-pli3.352, sya27.220", "ja403:1.2": "", "ja403:1.3": "", "ja403:1.4": "", "ja403:2.1": "dr27.219, ms22J_1546, msdiv55, pts-vp-pli3.353, vri68.134", "ja403:2.2": "", "ja403:2.3": "", "ja403:2.4": "", "ja403:3.1": "bj30.276, csp1ed22.162, csp2ed22.162, ms22J_1547, msdiv56", "ja403:3.2": "", "ja403:3.3": "", "ja403:3.4": "", "ja403:4.1": "ms22J_1548, msdiv57", "ja403:4.2": "", "ja403:4.3": "", "ja403:4.4": "", "ja403:5.1": "ms22J_1549, msdiv58", "ja403:5.2": "", "ja403:5.3": "", "ja403:5.4": "", "ja403:6.1": "ms22J_1550, msdiv59, pts-vp-pli3.354", "ja403:6.2": "", "ja403:6.3": "", "ja403:6.4": "", "ja403:7.1": "ms22J_1551, msdiv60, pts-vp-pli3.355", "ja403:7.2": "", "ja403:7.3": "", "ja403:7.4": "", "ja403:8.1": "ms22J_1552"}, "keys_order": ["ja403:0.1", "ja403:0.2", "ja403:0.3", "ja403:0.4", "ja403:1.1", "ja403:1.2", "ja403:1.3", "ja403:1.4", "ja403:2.1", "ja403:2.2", "ja403:2.3", "ja403:2.4", "ja403:3.1", "ja403:3.2", "ja403:3.3", "ja403:3.4", "ja403:4.1", "ja403:4.2", "ja403:4.3", "ja403:4.4", "ja403:5.1", "ja403:5.2", "ja403:5.3", "ja403:5.4", "ja403:6.1", "ja403:6.2", "ja403:6.3", "ja403:6.4", "ja403:7.1", "ja403:7.2", "ja403:7.3", "ja403:7.4", "ja403:8.1"]}