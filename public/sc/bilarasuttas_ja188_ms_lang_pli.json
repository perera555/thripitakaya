{"html_text": {"ja188:0.1": "<article id='ja188'><header><ul><li class='division'>{}</li>", "ja188:0.2": "<li>{}</li>", "ja188:0.3": "<li>{}</li></ul>", "ja188:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja188:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja188:1.2": "<span class='verse-line'>{}</span>", "ja188:1.3": "<span class='verse-line'>{}</span>", "ja188:1.4": "<span class='verse-line'>{}</span></p>", "ja188:2.1": "<p><span class='verse-line'>{}</span>", "ja188:2.2": "<span class='verse-line'>{}</span>", "ja188:2.3": "<span class='verse-line'>{}</span>", "ja188:2.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja188:3.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja188:0.1": "Jātaka ", "ja188:0.2": "Dukanipāta ", "ja188:0.3": "Asadisavagga ", "ja188:0.4": "8. Sīhakotthujātaka ", "ja188:1.1": "“Sīhaṅgulī sīhanakho, ", "ja188:1.2": "sīhapādapatiṭṭhito; ", "ja188:1.3": "So sīho sīhasaṅghamhi, ", "ja188:1.4": "eko nadati aññathā”. ", "ja188:2.1": "“Mā tvaṁ nadi rājaputta, ", "ja188:2.2": "appasaddo vane vasa; ", "ja188:2.3": "Sarena kho taṁ jāneyyuṁ, ", "ja188:2.4": "na hi te pettiko saro”ti. ", "ja188:3.1": "Sīhakotthujātakaṁ aṭṭhamaṁ. "}, "variant_text": {"ja188:0.1": "", "ja188:0.2": "", "ja188:0.3": "", "ja188:0.4": "", "ja188:1.1": "kho → mā (mr) ", "ja188:1.2": "", "ja188:1.3": "", "ja188:1.4": "", "ja188:2.1": "", "ja188:2.2": "", "ja188:2.3": "", "ja188:2.4": "", "ja188:3.1": "Sīhakotthujātakaṁ → sīhakotthukajātakaṁ (sya1ed, sya2ed); sīhakoṭṭhukajātakaṁ (pts-vp-pli1) "}, "reference_text": {"ja188:0.1": "", "ja188:0.2": "", "ja188:0.3": "", "ja188:0.4": "", "ja188:1.1": "bj30.86, csp1ed22.49, csp2ed22.49, dr27.67, ms22J_459, msdiv75, pts-vp-pli2.108", "ja188:1.2": "", "ja188:1.3": "", "ja188:1.4": "", "ja188:2.1": "ms22J_460, msdiv76, ndp22.46, pts-vp-pli2.109, sya27.68", "ja188:2.2": "", "ja188:2.3": "", "ja188:2.4": "", "ja188:3.1": "ms22J_461"}, "keys_order": ["ja188:0.1", "ja188:0.2", "ja188: