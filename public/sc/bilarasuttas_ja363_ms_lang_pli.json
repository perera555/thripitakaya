{"html_text": {"ja363:0.1": "<article id='ja363'><header><ul><li class='division'>{}</li>", "ja363:0.2": "<li>{}</li>", "ja363:0.3": "<li>{}</li></ul>", "ja363:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja363:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja363:1.2": "<span class='verse-line'>{}</span>", "ja363:1.3": "<span class='verse-line'>{}</span>", "ja363:1.4": "<span class='verse-line'>{}</span></p>", "ja363:2.1": "<p><span class='verse-line'>{}</span>", "ja363:2.2": "<span class='verse-line'>{}</span>", "ja363:2.3": "<span class='verse-line'>{}</span>", "ja363:2.4": "<span class='verse-line'>{}</span></p>", "ja363:3.1": "<p><span class='verse-line'>{}</span>", "ja363:3.2": "<span class='verse-line'>{}</span>", "ja363:3.3": "<span class='verse-line'>{}</span>", "ja363:3.4": "<span class='verse-line'>{}</span></p>", "ja363:4.1": "<p><span class='verse-line'>{}</span>", "ja363:4.2": "<span class='verse-line'>{}</span>", "ja363:4.3": "<span class='verse-line'>{}</span>", "ja363:4.4": "<span class='verse-line'>{}</span></p>", "ja363:5.1": "<p><span class='verse-line'>{}</span>", "ja363:5.2": "<span class='verse-line'>{}</span>", "ja363:5.3": "<span class='verse-line'>{}</span>", "ja363:5.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja363:6.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja363:0.1": "Jātaka ", "ja363:0.2": "Pañcakanipāta ", "ja363:0.3": "Vaṇṇārohavagga ", "ja363:0.4": "3. Hirijātaka ", "ja363:1.1": "“Hiriṁ tarantaṁ vijigucchamānaṁ, ", "ja363:1.2": "Tavāhamasmī iti bhāsamānaṁ; ", "ja363:1.3": "Seyyāni kammāni anādiyantaṁ, ", "ja363:1.4": "Neso mamanti iti naṁ vijaññā. ", "ja363:2.1": "Yañhi kayirā tañhi vade, ", "ja363:2.2": "yaṁ na kayirā na taṁ vade; ", "ja363:2.3": "Akarontaṁ bhāsamānaṁ, ", "ja363:2.4": "parijānanti paṇḍitā. ", "ja363:3.1": "Na so mitto yo sadā appamatto, ", "ja363:3.2": "Bhedāsaṅkī randhamevānupassī; ", "ja363:3.3": "Yasmiñca setī urasīva putto, ", "ja363:3.4": "Sa ve mitto yo abhejjo parehi. ", "ja363:4.1": "Pāmojjakaraṇaṁ ṭhānaṁ, ", "ja363:4.2": "pasaṁsāvahanaṁ sukhaṁ; ", "ja363:4.3": "Phalānisaṁso bhāveti, ", "ja363:4.4": "vahanto porisaṁ dhuraṁ. ", "ja363:5.1": "Pavivekarasaṁ pitvā, ", "ja363:5.2": "rasaṁ upasamassa ca; ", "ja363:5.3": "Niddaro hoti nippāpo, ", "ja363:5.4": "dhammappītirasaṁ pivan”ti. ", "ja363:6.1": "Hirijātakaṁ tatiyaṁ. "}, "reference_text": {"ja363:0.1": "", "ja363:0.2": "", "ja363:0.3": "", "ja363:0.4": "", "ja363:1.1": "bj30.220, ms22J_1229, msdiv70, pts-vp-pli3.196", "ja363:1.2": "", "ja363:1.3": "", "ja363:1.4": "", "ja363:2.1": "ms22J_1230, msdiv71, sya27.176", "ja363:2.2": "", "ja363:2.3": "", "ja363:2.4": "", "ja363:3.1": "csp1ed22.129, csp2ed22.129, ms22J_1231, msdiv72, ndp22.120", "ja363:3.2": "", "ja363:3.3": "", "ja363:3.4": "", "ja363:4.1": "ms22J_1232, msdiv73", "ja363:4.2": "", "ja363:4.3": "", "ja363:4.4": "", "ja363:5.1": "dr27.176, ms22J_1233, msdiv74, vri68.109", "ja363:5.2": "", "ja363:5.3": "", "ja363:5.4": "", "ja363:6.1": "ms22J_1234"}, "keys_order": ["ja363:0.1", "ja363:0.2", "ja363:0.3", "ja363:0.4", "ja363:1.1", "ja363:1.2", "ja363:1.3", "ja363:1.4", "ja363:2.1", "ja363:2.2", "ja363:2.3", "ja363:2.4", "ja363:3.1", "ja363:3.2", "ja363:3.3", "ja363:3.4", "ja363:4.1", "ja363:4.2", "ja363:4.3", "ja363:4.4", "ja363:5.1", "ja363:5.2", "ja363:5.3", "ja363:5.4", "ja363:6.1"]}