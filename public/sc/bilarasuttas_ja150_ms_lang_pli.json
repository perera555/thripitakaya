{"html_text": {"ja150:0.1": "<article id='ja150'><header><ul><li class='division'>{}</li>", "ja150:0.2": "<li>{}</li>", "ja150:0.3": "<li>{}</li></ul>", "ja150:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja150:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja150:1.2": "<span class='verse-line'>{}</span>", "ja150:1.3": "<span class='verse-line'>{}</span>", "ja150:1.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja150:2.1": "<p class='endsutta'>{}</p>", "ja150:2.2": "<p class='endvagga'>{}</p>", "ja150:3.1": "<p class='uddana-intro'>{}</p>", "ja150:4.1": "<blockquote class='uddanagatha'><p><span class='verse-line'>{}</span>", "ja150:4.2": "<span class='verse-line'>{}</span>", "ja150:4.3": "<span class='verse-line'>{}</span>", "ja150:4.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja150:5.1": "<p class='endsutta'>{}</p>", "ja150:6.1": "<p class='uddana-intro'>{}</p>", "ja150:7.1": "<blockquote class='uddanagatha'><p><span class='verse-line'>{}</span>", "ja150:7.2": "<span class='verse-line'>{}</span>", "ja150:7.3": "<span class='verse-line'>{}</span>", "ja150:7.4": "<span class='verse-line'>{}</span>", "ja150:7.5": "<span class='verse-line'>{}</span>", "ja150:7.6": "<span class='verse-line'>{}</span></p></blockquote>", "ja150:8.1": "<p class='endsutta'>{}</p>", "ja150:9.1": "<p class='endsection'>{}</p></article>"}, "root_text": {"ja150:0.1": "Jātaka ", "ja150:0.2": "Ekakanipāta ", "ja150:0.3": "Kakaṇṭakavagga ", "ja150:0.4": "10. Sañjīvajātaka ", "ja150:1.1": "“Asantaṁ yo paggaṇhāti, ", "ja150:1.2": "asantaṁ cūpasevati; ", "ja150:1.3": "Tameva ghāsaṁ kurute, ", "ja150:1.4": "byaggho sañjīvako yathā”ti. ", "ja150:2.1": "Sañjīvajātakaṁ dasamaṁ. ", "ja150:2.2": "Kakaṇṭakavaggo pannarasamo. ", "ja150:3.1": "Tassuddānaṁ ", "ja150:4.1": "Sukhamedhati daṇḍavaro ca puna, ", "ja150:4.2": "Lasi vāladhi pañcamarādhavaro; ", "ja150:4.3": "Samahodadhi kattika bondi puna, ", "ja150:4.4": "Caturaṅgulabyagghavarena dasāti. ", "ja150:5.1": "Uparimapaṇṇāsako. ", "ja150:6.1": "Atha vagguddānaṁ ", "ja150:7.1": "Apaṇṇakaṁ sīlavaggakuruṅga, ", "ja150:7.2": "Kulāvakaṁ atthakāmena pañcamaṁ; ", "ja150:7.3": "Āsīso itthivaruṇaṁ apāyi, ", "ja150:7.4": "Littavaggena te dasa; ", "ja150:7.5": "Parosataṁ haṁci kusanāḷi, ", "ja150:7.6": "Asampadaṁ kakaṇṭakavaggo. ", "ja150:8.1": "Ekanipātamhilaṅkatanti. ", "ja150:9.1": "Ekakanipātaṁ niṭṭhitaṁ. "}, "variant_text": {"ja150:0.1": "", "ja150:0.2": "", "ja150:0.3": "", "ja150:0.4": "", "ja150:1.1": "", "ja150:1.2": "", "ja150:1.3": "", "ja150:1.4": "", "ja150:2.1": "", "ja150:2.2": "Kakaṇṭakavaggo → pāpasevanavaggo (mr) ", "ja150:3.1": "", "ja150:4.1": "", "ja150:4.2": "", "ja150:4.3": "", "ja150:4.4": "", "ja150:5.1": "Uparimapaṇṇāsako → bj potthakeyeva ", "ja150:6.1": "", "ja150:7.1": "", "ja150:7.2": "", "ja150:7.3": "", "ja150:7.4": "", "ja150:7.5": "haṁci kusanāḷi → haṁsi sarikkhaṁ (sabbattha) ", "ja150:7.6": "", "ja150:8.1": "", "ja150:9.1": ""}, "reference_text": {"ja150:0.1": "", "ja150:0.2": "", "ja150:0.3": "", "ja150:0.4": "", "ja150:1.1": "csp1ed22.35, csp2ed22.35, dr27.49, ms22J_331, msdiv150, pts-vp-pli1.511, vri68.33", "ja150:1.2": "", "ja150:1.3": "", "ja150:1.4": "", "ja150:2.1": "ms22J_332", "ja150:2.2": "", "ja150:3.1": "ms22J_333", "ja150:4.1": "ms22J_334, sya27.49", "ja150:4.2": "", "ja150:4.3": "", "ja150:4.4": "", "ja150:5.1": "ms22J_335", "ja150:6.1": "ms22J_336", "ja150:7.1": "ms22J_337", "ja150:7.2": "", "ja150:7.3": "", "ja150:7.4": "", "ja150:7.5": "", "ja150:7.6": "", "ja150:8.1": "ms22J_338", "ja150:9.1": "ms22J_339"}, "keys_order": ["ja150:0.1", "ja150:0.2", "ja150:0.3", "ja150:0.4", "ja150:1.1", "ja150:1.2", "ja150:1.3", "ja150:1.4", "ja150:2.1", "ja150:2.2", "ja150:3.1", "ja150:4.1", "ja150:4.2", "ja150:4.3", "ja150:4.4", "ja150:5.1", "ja150:6.1", "ja150:7.1", "ja150:7.2", "ja150:7.3", "ja150:7.4", "ja150:7.5", "ja150:7.6", "ja150:8.1", "ja150:9.1"]}