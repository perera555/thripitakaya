{"html_text": {"ja184:0.1": "<article id='ja184'><header><ul><li class='division'>{}</li>", "ja184:0.2": "<li>{}</li>", "ja184:0.3": "<li>{}</li></ul>", "ja184:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja184:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja184:1.2": "<span class='verse-line'>{}</span>", "ja184:1.3": "<span class='verse-line'>{}</span>", "ja184:1.4": "<span class='verse-line'>{}</span></p>", "ja184:2.1": "<p><span class='verse-line'>{}</span>", "ja184:2.2": "<span class='verse-line'>{}</span>", "ja184:2.3": "<span class='verse-line'>{}</span>", "ja184:2.4": "<span class='verse-line'>{}</span>", "ja184:2.5": "<span class='verse-line'>{}</span>", "ja184:2.6": "<span class='verse-line'>{}</span></p></blockquote>", "ja184:3.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja184:0.1": "Jātaka ", "ja184:0.2": "Dukanipāta ", "ja184:0.3": "Asadisavagga ", "ja184:0.4": "4. Giridattajātaka ", "ja184:1.1": "“Dūsito giridattena, ", "ja184:1.2": "hayo sāmassa paṇḍavo; ", "ja184:1.3": "Porāṇaṁ pakatiṁ hitvā, ", "ja184:1.4": "tassevānuvidhiyyati. ", "ja184:2.1": "Sace ca tanujo poso, ", "ja184:2.2": "sikharākārakappito; ", "ja184:2.3": "Ānane naṁ gahetvāna, ", "ja184:2.4": "maṇḍale parivattaye; ", "ja184:2.5": "Khippameva pahantvāna, ", "ja184:2.6": "tassevānuvidhiyyatī”ti. ", "ja184:3.1": "Giridattajātakaṁ catutthaṁ. "}, "variant_text": {"ja184:0.1": "", "ja184:0.2": "", "ja184:0.3": "", "ja184:0.4": "", "ja184:1.1": "giridattena → giridantena (pts-vp-pli1) ", "ja184:1.2": "", "ja184:1.3": "", "ja184:1.4": "tassevānuvidhiyyati → tasseva anuvidhīyati (bj); tasseva anuvidhīyatīti (pts-vp-pli1) ", "ja184:2.1": "", "ja184:2.2": "sikharākārakappito → siṅgārākāra … (sya1ed, sya2ed) ", "ja184:2.3": "naṁ → taṁ (bj, sya1ed, sya2ed, pts-vp-pli1) ", "ja184:2.4": "", "ja184:2.5": "", "ja184:2.6": "", "ja184:3.1": "Giridattajātakaṁ → giridantajātakaṁ (pts-vp-pli1) "}, "reference_text": {"ja184:0.1": "", "ja184:0.2": "", "ja184:0.3": "", "ja184:0.4": "", "ja184:1.1": "ms22J_447, msdiv67, pts-vp-pli2.98", "ja184:1.2": "", "ja184:1.3": "", "ja184:1.4": "", "ja184:2.1": "ms22J_448, msdiv68, pts-vp-pli2.99, sya27.66", "ja184:2.2": "", "ja184:2.3": "", "ja184:2.4": "", "ja184:2.5": "", "ja184:2.6": "", "ja184:3.1": "ms22J_449"}, "keys_order": ["ja184:0.1", "ja184:0.2", "ja184:0.3", "ja184:0.4", "ja184:1.1", "ja184:1.2", "ja184:1.3", "ja184:1.4", "ja184:2.1", "ja184:2.2", "ja184:2.3", "ja184:2.4", "ja184:2.5", "ja184:2.6", "ja184:3.1"]}