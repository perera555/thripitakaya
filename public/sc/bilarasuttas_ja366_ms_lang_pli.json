{"html_text": {"ja366:0.1": "<article id='ja366'><header><ul><li class='division'>{}</li>", "ja366:0.2": "<li>{}</li>", "ja366:0.3": "<li>{}</li></ul>", "ja366:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja366:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja366:1.2": "<span class='verse-line'>{}</span>", "ja366:1.3": "<span class='verse-line'>{}</span>", "ja366:1.4": "<span class='verse-line'>{}</span></p>", "ja366:2.1": "<p><span class='verse-line'>{}</span>", "ja366:2.2": "<span class='verse-line'>{}</span>", "ja366:2.3": "<span class='verse-line'>{}</span>", "ja366:2.4": "<span class='verse-line'>{}</span></p>", "ja366:3.1": "<p><span class='verse-line'>{}</span>", "ja366:3.2": "<span class='verse-line'>{}</span>", "ja366:3.3": "<span class='verse-line'>{}</span>", "ja366:3.4": "<span class='verse-line'>{}</span></p>", "ja366:4.1": "<p><span class='verse-line'>{}</span>", "ja366:4.2": "<span class='verse-line'>{}</span>", "ja366:4.3": "<span class='verse-line'>{}</span>", "ja366:4.4": "<span class='verse-line'>{}</span></p>", "ja366:5.1": "<p><span class='verse-line'>{}</span>", "ja366:5.2": "<span class='verse-line'>{}</span>", "ja366:5.3": "<span class='verse-line'>{}</span>", "ja366:5.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja366:6.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja366:0.1": "Jātaka ", "ja366:0.2": "Pañcakanipāta ", "ja366:0.3": "Vaṇṇārohavagga ", "ja366:0.4": "6. Gumbiyajātaka ", "ja366:1.1": "“Madhuvaṇṇaṁ madhurasaṁ, ", "ja366:1.2": "madhugandhaṁ visaṁ ahu; ", "ja366:1.3": "Gumbiyo ghāsamesāno, ", "ja366:1.4": "araññe odahī visaṁ. ", "ja366:2.1": "Madhu iti maññamānā, ", "ja366:2.2": "ye taṁ visamakhādisuṁ; ", "ja366:2.3": "Tesaṁ taṁ kaṭukaṁ āsi, ", "ja366:2.4": "maraṇaṁ tenupāgamuṁ. ", "ja366:3.1": "Ye ca kho paṭisaṅkhāya, ", "ja366:3.2": "visaṁ taṁ parivajjayuṁ; ", "ja366:3.3": "Te āturesu sukhitā, ", "ja366:3.4": "ḍayhamānesu nibbutā. ", "ja366:4.1": "Evameva manussesu, ", "ja366:4.2": "visaṁ kāmā samohitā; ", "ja366:4.3": "Āmisaṁ bandhanañcetaṁ, ", "ja366:4.4": "maccuveso guhāsayo. ", "ja366:5.1": "Evameva ime kāme, ", "ja366:5.2": "āturā paricārike; ", "ja366:5.3": "Ye sadā parivajjenti, ", "ja366:5.4": "saṅgaṁ loke upaccagun”ti. ", "ja366:6.1": "Gumbiyajātakaṁ chaṭṭhaṁ. "}, "variant_text": {"ja366:0.1": "", "ja366:0.2": "", "ja366:0.3": "", "ja366:0.4": "", "ja366:1.1": "", "ja366:1.2": "", "ja366:1.3": "", "ja366:1.4": "", "ja366:2.1": "Madhu iti maññamānā → madhūti maññamānā ye (pts-vp-pli1); madhūti maññamānāya (mr) ", "ja366:2.2": "visamakhādisuṁ → visamasāyisuṁ (bj, sya1ed, sya2ed); visaṁ samāsāsisuṁ (pts-vp-pli1) ", "ja366:2.3": "", "ja366:2.4": "", "ja366:3.1": "", "ja366:3.2": "", "ja366:3.3": "", "ja366:3.4": "", "ja366:4.1": "", "ja366:4.2": "", "ja366:4.3": "", "ja366:4.4": "maccuveso → maccuvaso (bj, sya1ed, sya2ed) ", "ja366:5.1": "", "ja366:5.2": "paricārike → paricārake (bj, pts-vp-pli1) ", "ja366:5.3": "", "ja366:5.4": "", "ja366:6.1": ""}, "reference_text": {"ja366:0.1": "", "ja366:0.2": "", "ja366:0.3": "", "ja366:0.4": "", "ja366:1.1": "ms22J_1247, msdiv85, pts-vp-pli3.201, sya27.178, vri68.110", "ja366:1.2": "", "ja366:1.3": "", "ja366:1.4": "", "ja366:2.1": "ms22J_1248, msdiv86", "ja366:2.2": "", "ja366:2.3": "", "ja366:2.4": "", "ja366:3.1": "ms22J_1249, msdiv87", "ja366:3.2": "", "ja366:3.3": "", "ja366:3.4": "", "ja366:4.1": "ms22J_1250, msdiv88", "ja366:4.2": "", "ja366:4.3": "", "ja366:4.4": "", "ja366:5.1": "ms22J_1251, msdiv89", "ja366:5.2": "", "ja366:5.3": "", "ja366:5.4": "", "ja366:6.1": "ms22J_1252"}, "keys_order": ["ja366:0.1", "ja366:0.2", "ja366:0.3", "ja366:0.4", "ja366:1.1", "ja366:1.2", "ja366:1.3", "ja366:1.4", "ja366:2.1", "ja366:2.2", "ja366:2.3", "ja366:2.4", "ja366:3.1", "ja366:3.2", "ja366:3.3", "ja366:3.4", "ja366:4.1", "ja366:4.2", "ja366:4.3", "ja366:4.4", "ja366:5.1", "ja366:5.2", "ja366:5.3", "ja366:5.4", "ja366:6.1"]}