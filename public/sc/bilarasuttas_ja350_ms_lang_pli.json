{"html_text": {"ja350:0.1": "<article id='ja350'><header><ul><li class='division'>{}</li>", "ja350:0.2": "<li>{}</li>", "ja350:0.3": "<li>{}</li></ul>", "ja350:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja350:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja350:1.2": "<span class='verse-line'>{}</span>", "ja350:1.3": "<span class='verse-line'>{}</span>", "ja350:1.4": "<span class='verse-line'>{}</span></p>", "ja350:2.1": "<p><span class='verse-line'>{}</span>", "ja350:2.2": "<span class='verse-line'>{}</span>", "ja350:2.3": "<span class='verse-line'>{}</span>", "ja350:2.4": "<span class='verse-line'>{}</span></p>", "ja350:3.1": "<p><span class='verse-line'>{}</span>", "ja350:3.2": "<span class='verse-line'>{}</span>", "ja350:3.3": "<span class='verse-line'>{}</span>", "ja350:3.4": "<span class='verse-line'>{}</span></p>", "ja350:4.1": "<p><span class='verse-line'>{}</span>", "ja350:4.2": "<span class='verse-line'>{}</span>", "ja350:4.3": "<span class='verse-line'>{}</span>", "ja350:4.4": "<span class='verse-line'>{}</span>", "ja350:4.5": "<span class='verse-line'>{}</span></p></blockquote>", "ja350:5.1": "<p class='endsutta'>{}</p>", "ja350:5.2": "<p class='endvagga'>{}</p>", "ja350:6.1": "<p class='uddana-intro'>{}</p>", "ja350:7.1": "<blockquote class='uddanagatha'><p><span class='verse-line'>{}</span>", "ja350:7.2": "<span class='verse-line'>{}</span>", "ja350:7.3": "<span class='verse-line'>{}</span>", "ja350:7.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja350:8.1": "<p class='uddana-intro'>{}</p>", "ja350:9.1": "<blockquote class='uddanagatha'><p><span class='verse-line'>{}</span>", "ja350:9.2": "<span class='verse-line'>{}</span>", "ja350:9.3": "<span class='verse-line'>{}</span>", "ja350:9.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja350:10.1": "<p class='endsection'>{}</p></article>"}, "root_text": {"ja350:0.1": "Jātaka ", "ja350:0.2": "Catukkanipāta ", "ja350:0.3": "Cūḷakuṇālavagga ", "ja350:0.4": "10. Devatāpañhajātaka ", "ja350:1.1": "“Hanti hatthehi pādehi, ", "ja350:1.2": "mukhañca parisumbhati; ", "ja350:1.3": "Sa ve rāja piyo hoti, ", "ja350:1.4": "kaṁ tena tvābhipassasi”. ", "ja350:2.1": "“Akkosati yathākāmaṁ, ", "ja350:2.2": "āgamañcassa icchati; ", "ja350:2.3": "Sa ve rāja piyo hoti, ", "ja350:2.4": "kaṁ tena tvābhipassasi”. ", "ja350:3.1": "“Abbhakkhāti abhūtena, ", "ja350:3.2": "alikenābhisāraye; ", "ja350:3.3": "Sa ve rāja piyo hoti, ", "ja350:3.4": "kaṁ tena tvābhipassasi”. ", "ja350:4.1": "“Haraṁ annañca pānañca, ", "ja350:4.2": "Vatthasenāsanāni ca; ", "ja350:4.3": "Aññadatthuharā santā, ", "ja350:4.4": "Te ve rāja piyā honti; ", "ja350:4.5": "Kaṁ tena tvābhipassasī”ti. ", "ja350:5.1": "Devatāpañhajātakaṁ dasamaṁ. ", "ja350:5.2": "Cūḷakuṇālavaggo pañcamo. ", "ja350:6.1": "Tassuddānaṁ ", "ja350:7.1": "Narānaṁ asakkhivasimhavaro, ", "ja350:7.2": "Nīliyamaggivarañca puna; ", "ja350:7.3": "Puna rasāyasakūṭavaro, ", "ja350:7.4": "Tathārañña sārathi hanti dasāti. ", "ja350:8.1": "Atha vagguddānaṁ ", "ja350:9.1": "Kāliṅgaṁ pucimandañca, ", "ja350:9.2": "kuṭidūsaka kokilā; ", "ja350:9.3": "Cūḷakuṇālavaggo so, ", "ja350:9.4": "pañcamo suppakāsitoti. ", "ja350:10.1": "Catukkanipātaṁ niṭṭhitaṁ. "}, "variant_text": {"ja350:0.1": "", "ja350:0.2": "", "ja350:0.3": "", "ja350:0.4": "", "ja350:1.1": "", "ja350:1.2": "", "ja350:1.3": "", "ja350:1.4": "tvābhipassasi → mabhipassasi (bj) ", "ja350:2.1": "", "ja350:2.2": "", "ja350:2.3": "", "ja350:2.4": "", "ja350:3.1": "", "ja350:3.2": "", "ja350:3.3": "", "ja350:3.4": "", "ja350:4.1": "", "ja350:4.2": "", "ja350:4.3": "", "ja350:4.4": "", "ja350:4.5": "", "ja350:5.1": "", "ja350:5.2": "Cūḷakuṇālavaggo → cullakuṇālavaggo (sya1ed, sya2ed) ", "ja350:6.1": "", "ja350:7.1": "", "ja350:7.2": "", "ja350:7.3": "", "ja350:7.4": "", "ja350:8.1": "", "ja350:9.1": "Kāliṅgaṁ → vivaraṁ (bahūsu) ", "ja350:9.2": "kuṭidūsaka kokilā → kuṭidūsaṁ bahubhāṇakaṁ (bahūsu) ", "ja350:9.3": "", "ja350:9.4": "", "ja350:10.1": ""}, 