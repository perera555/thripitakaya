{"html_text": {"ja330:0.1": "<article id='ja330'><header><ul><li class='division'>{}</li>", "ja330:0.2": "<li>{}</li>", "ja330:0.3": "<li>{}</li></ul>", "ja330:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja330:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja330:1.2": "<span class='verse-line'>{}</span>", "ja330:1.3": "<span class='verse-line'>{}</span>", "ja330:1.4": "<span class='verse-line'>{}</span></p>", "ja330:2.1": "<p><span class='verse-line'>{}</span>", "ja330:2.2": "<span class='verse-line'>{}</span>", "ja330:2.3": "<span class='verse-line'>{}</span>", "ja330:2.4": "<span class='verse-line'>{}</span></p>", "ja330:3.1": "<p><span class='verse-line'>{}</span>", "ja330:3.2": "<span class='verse-line'>{}</span>", "ja330:3.3": "<span class='verse-line'>{}</span>", "ja330:3.4": "<span class='verse-line'>{}</span></p>", "ja330:4.1": "<p><span class='verse-line'>{}</span>", "ja330:4.2": "<span class='verse-line'>{}</span>", "ja330:4.3": "<span class='verse-line'>{}</span>", "ja330:4.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja330:5.1": "<p class='endsutta'>{}</p>", "ja330:5.2": "<p class='endvagga'>{}</p>", "ja330:6.1": "<p class='uddana-intro'>{}</p>", "ja330:7.1": "<blockquote class='uddanagatha'><p><span class='verse-line'>{}</span>", "ja330:7.2": "<span class='verse-line'>{}</span>", "ja330:7.3": "<span class='verse-line'>{}</span>", "ja330:7.4": "<span class='verse-line'>{}</span></p></blockquote></article>"}, "root_text": {"ja330:0.1": "Jātaka ", "ja330:0.2": "Catukkanipāta ", "ja330:0.3": "Kuṭidūsakavagga ", "ja330:0.4": "10. Sīlavīmaṁsajātaka ", "ja330:1.1": "“Sīlaṁ kireva kalyāṇaṁ, ", "ja330:1.2": "sīlaṁ loke anuttaraṁ; ", "ja330:1.3": "Passa ghoraviso nāgo, ", "ja330:1.4": "sīlavāti na haññati”. ", "ja330:2.1": "“Yāvadevassahū kiñci, ", "ja330:2.2": "tāvadeva akhādisuṁ; ", "ja330:2.3": "Saṅgamma kulalā loke, ", "ja330:2.4": "na hiṁsanti akiñcanaṁ. ", "ja330:3.1": "Sukhaṁ nirāsā supati, ", "ja330:3.2": "āsā phalavatī sukhā; ", "ja330:3.3": "Āsaṁ nirāsaṁ katvāna, ", "ja330:3.4": "sukhaṁ supati piṅgalā. ", "ja330:4.1": "Na samādhiparo atthi, ", "ja330:4.2": "asmiṁ loke paramhi ca; ", "ja330:4.3": "Na paraṁ nāpi attānaṁ, ", "ja330:4.4": "vihiṁsati samāhito”ti. ", "ja330:5.1": "Sīlavīmaṁsajātakaṁ dasamaṁ. ", "ja330:5.2": "Kuṭidūsakavaggo tatiyo. ", "ja330:6.1": "Tassuddānaṁ ", "ja330:7.1": "Samanussa saduddubha yācanako, ", "ja330:7.2": "Atha meṇḍavaruttama godhavaro; ", "ja330:7.3": "Atha kāyasakepuka bhotīvaro, ", "ja330:7.4": "Atha rādhasusīlavarena dasāti. "}, "reference_text": {"ja330:0.1": "", "ja330:0.2": "", "ja330:0.3": "", "ja330:0.4": "", "ja330:1.1": "ms22J_1032, msdiv117, ndp22.100, pts-vp-pli3.100", "ja330:1.2": "", "ja330:1.3": "", "ja330:1.4": "", "ja330:2.1": "ms22J_1033, msdiv118", "ja330:2.2": "", "ja330:2.3": "", "ja330:2.4": "", "ja330:3.1": "ms22J_1034, msdiv119, pts-vp-pli3.101", "ja330:3.2": "", "ja330:3.3": "", "ja330:3.4": "", "ja330:4.1": "ms22J_1035, msdiv120", "ja330:4.2": "", "ja330:4.3": "", "ja330:4.4": "", "ja330:5.1": "ms22J_1036", "ja330:5.2": "", "ja330:6.1": "ms22J_1037", "ja330:7.1": "ms22J_1038, sya27.149", "ja330:7.2": "", "ja330:7.3": "", "ja330:7.4": ""}, "keys_order": ["ja330:0.1", "ja330:0.2", "ja330:0.3", "ja330:0.4", "ja330:1.1", "ja330:1.2", "ja330:1.3", "ja330:1.4", "ja330:2.1", "ja330:2.2", "ja330:2.3", "ja330:2.4", "ja330:3.1", "ja330:3.2", "ja330:3.3", "ja330:3.4", "ja330:4.1", "ja330:4.2", "ja330:4.3", "ja330:4.4", "ja330:5.1", "ja330:5.2", "ja330:6.1", "ja330:7.1", "ja330:7.2", "ja330:7.3", "ja330:7.4"]}