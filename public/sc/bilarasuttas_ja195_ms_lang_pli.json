{"html_text": {"ja195:0.1": "<article id='ja195'><header><ul><li class='division'>{}</li>", "ja195:0.2": "<li>{}</li>", "ja195:0.3": "<li>{}</li></ul>", "ja195:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja195:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja195:1.2": "<span class='verse-line'>{}</span>", "ja195:1.3": "<span class='verse-line'>{}</span>", "ja195:1.4": "<span class='verse-line'>{}</span></p>", "ja195:2.1": "<p><span class='verse-line'>{}</span>", "ja195:2.2": "<span class='verse-line'>{}</span>", "ja195:2.3": "<span class='verse-line'>{}</span>", "ja195:2.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja195:3.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja195:0.1": "Jātaka ", "ja195:0.2": "Dukanipāta ", "ja195:0.3": "Ruhakavagga ", "ja195:0.4": "5. Pabbatūpattharajātaka ", "ja195:1.1": "“Pabbatūpatthare ramme, ", "ja195:1.2": "jātā pokkharaṇī sivā; ", "ja195:1.3": "Taṁ siṅgālo apāpāyi, ", "ja195:1.4": "jānaṁ sīhena rakkhitaṁ”. ", "ja195:2.1": "“Pivanti ce mahārāja, ", "ja195:2.2": "sāpadāni mahānadiṁ; ", "ja195:2.3": "Na tena anadī hoti, ", "ja195:2.4": "khamassu yadi te piyā”ti. ", "ja195:3.1": "Pabbatūpattharajātakaṁ pañcamaṁ. "}, "variant_text": {"ja195:0.1": "", "ja195:0.2": "", "ja195:0.3": "", "ja195:0.4": "", "ja195:1.1": "Pabbatūpatthare → pabbatapatthare (mr) ", "ja195:1.2": "", "ja195:1.3": "apāpāyi → apāpāsi (sya1ed, sya2ed, pts-vp-pli1) ", "ja195:1.4": "", "ja195:2.1": "Pivanti ce → pivanti ve (bj); pivantiva (pts-vp-pli1); pivanteva (?) ", "ja195:2.2": "", "ja195:2.3": "", "ja195:2.4": "", "ja195:3.1": "Pabbatūpattharajātakaṁ → pabbatapattharajātakaṁ (mr) "}, "reference_text": {"ja195:0.1": "", "ja195:0.2": "", "ja195:0.3": "", "ja195:0.4": "", "ja195:1.1": "ms22J_482, msdiv89, pts-vp-pli2.126", "ja195:1.2": "", "ja195:1.3": "", "ja195:1.4": "", "ja195:2.1": "ms22J_483, msdiv90, ndp22.48", "ja195:2.2": "", "ja195:2.3": "", "ja195:2.4": "", "ja195:3.1": "ms22J_484"}, "keys_orde