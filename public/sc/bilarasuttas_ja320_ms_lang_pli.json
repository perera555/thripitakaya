{"html_text": {"ja320:0.1": "<article id='ja320'><header><ul><li class='division'>{}</li>", "ja320:0.2": "<li>{}</li>", "ja320:0.3": "<li>{}</li></ul>", "ja320:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja320:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja320:1.2": "<span class='verse-line'>{}</span>", "ja320:1.3": "<span class='verse-line'>{}</span>", "ja320:1.4": "<span class='verse-line'>{}</span></p>", "ja320:2.1": "<p><span class='verse-line'>{}</span>", "ja320:2.2": "<span class='verse-line'>{}</span>", "ja320:2.3": "<span class='verse-line'>{}</span>", "ja320:2.4": "<span class='verse-line'>{}</span></p>", "ja320:3.1": "<p><span class='verse-line'>{}</span>", "ja320:3.2": "<span class='verse-line'>{}</span>", "ja320:3.3": "<span class='verse-line'>{}</span>", "ja320:3.4": "<span class='verse-line'>{}</span></p>", "ja320:4.1": "<p><span class='verse-line'>{}</span>", "ja320:4.2": "<span class='verse-line'>{}</span>", "ja320:4.3": "<span class='verse-line'>{}</span>", "ja320:4.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja320:5.1": "<p class='endsutta'>{}</p>", "ja320:5.2": "<p class='endvagga'>{}</p>", "ja320:6.1": "<p class='uddana-intro'>{}</p>", "ja320:7.1": "<blockquote class='uddanagatha'><p><span class='verse-line'>{}</span>", "ja320:7.2": "<span class='verse-line'>{}</span>", "ja320:7.3": "<span class='verse-line'>{}</span>", "ja320:7.4": "<span class='verse-line'>{}</span></p></blockquote></article>"}, "root_text": {"ja320:0.1": "Jātaka ", "ja320:0.2": "Catukkanipāta ", "ja320:0.3": "Pucimandavagga ", "ja320:0.4": "10. Succajajātaka ", "ja320:1.1": "“Succajaṁ vata naccaji, ", "ja320:1.2": "vācāya adadaṁ giriṁ; ", "ja320:1.3": "Kiṁ hitassa cajantassa, ", "ja320:1.4": "vācāya adada pabbataṁ”. ", "ja320:2.1": "“Yañhi kayirā tañhi vade, ", "ja320:2.2": "yaṁ na kayirā na taṁ vade; ", "ja320:2.3": "Akarontaṁ bhāsamānaṁ, ", "ja320:2.4": "parijānanti paṇḍitā”. ", "ja320:3.1": "“Rājaputta namo tyatthu, ", "ja320:3.2": "sacce dhamme ṭhito casi; ", "ja320:3.3": "Yassa te byasanaṁ patto, ", "ja320:3.4": "saccasmiṁ ramate mano”. ", "ja320:4.1": "“Yā daliddī daliddassa, ", "ja320:4.2": "aḍḍhā aḍḍhassa kittima; ", "ja320:4.3": "Sā hissa paramā bhariyā, ", "ja320:4.4": "sahiraññassa itthiyo”ti. ", "ja320:5.1": "Succajajātakaṁ dasamaṁ. ", "ja320:5.2": "Pucimandavaggo dutiyo. ", "ja320:6.1": "Tassuddānaṁ ", "ja320:7.1": "Atha cora sakassapa khantīvaro, ", "ja320:7.2": "Dujjīvitatā ca varā pharusā; ", "ja320:7.3": "Atha sasa matañca vasanta sukhaṁ, ", "ja320:7.4": "Succajaṁvatanaccajinā ca dasāti. "}, "variant_text": {"ja320:0.1": "", "ja320:0.2": "", "ja320:0.3": "", "ja320:0.4": "", "ja320:1.1": "", "ja320:1.2": "", "ja320:1.3": "", "ja320:1.4": "", "ja320:2.1": "", "ja320:2.2": "", "ja320:2.3": "", "ja320:2.4": "", "ja320:3.1": "", "ja320:3.2": "", "ja320:3.3": "", "ja320:3.4": "", "ja320:4.1": "", "ja320:4.2": "kittima → kittimā (bj, sya1ed, sya2ed, pts-vp-pli1) ", "ja320:4.3": "", "ja320:4.4": "", "ja320:5.1": "", "ja320:5.2": "", "ja320:6.1": "", "ja320:7.1": "", "ja320:7.2": "", "ja320:7.3": "", "ja320:7.4": ""}, "reference_text": {"ja320:0.1": "", "ja320:0.2": "", "ja320:0.3": "", "ja320:0.4": "", "ja320:1.1": "csp1ed22.103, csp2ed22.103, ms22J_980, msdiv77, pts-vp-pli3.69, vri68.89", "ja320:1.2": "", "ja320:1.3": "", "ja320:1.4": "", "ja320:2.1": "ms22J_981, msdiv78", "ja320:2.2": "", "ja320:2.3": "", "ja320:2.4": "", "ja320:3.1": "ms22J_982, msdiv79", "ja320:3.2": "", "ja320:3.3": "", "ja320:3.4": "", "ja320:4.1": "ms22J_983, msdiv80, pts-vp-pli3.70", "ja320:4.2": "", "ja320:4.3": "", "ja320:4.4": "", "ja320:5.1": "ms22J_984", "ja320:5.2": "", "ja320:6.1": "ms22J_985", "ja320:7.1": "ms22J_986, sya27.142", "ja320:7.2": "", "ja320:7.3": "", "ja320:7.4": ""}, "keys_order": ["ja320:0.1", "ja320:0.2", "ja320:0.3", "ja320:0.4", "ja320:1.1", "ja320:1.2", "ja320:1.3", "ja320:1.4", "ja320:2.1", "ja320:2.2", "ja320:2.3", "ja320:2.4", "ja320:3.1", "ja320:3.2", "ja320:3.3", "ja320: