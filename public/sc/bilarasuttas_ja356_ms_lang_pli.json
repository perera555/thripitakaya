{"html_text": {"ja356:0.1": "<article id='ja356'><header><ul><li class='division'>{}</li>", "ja356:0.2": "<li>{}</li>", "ja356:0.3": "<li>{}</li></ul>", "ja356:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja356:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja356:1.2": "<span class='verse-line'>{}</span>", "ja356:1.3": "<span class='verse-line'>{}</span>", "ja356:1.4": "<span class='verse-line'>{}</span></p>", "ja356:2.1": "<p><span class='verse-line'>{}</span>", "ja356:2.2": "<span class='verse-line'>{}</span>", "ja356:2.3": "<span class='verse-line'>{}</span>", "ja356:2.4": "<span class='verse-line'>{}</span></p>", "ja356:3.1": "<p><span class='verse-line'>{}</span>", "ja356:3.2": "<span class='verse-line'>{}</span>", "ja356:3.3": "<span class='verse-line'>{}</span>", "ja356:3.4": "<span class='verse-line'>{}</span></p>", "ja356:4.1": "<p><span class='verse-line'>{}</span>", "ja356:4.2": "<span class='verse-line'>{}</span>", "ja356:4.3": "<span class='verse-line'>{}</span>", "ja356:4.4": "<span class='verse-line'>{}</span></p>", "ja356:5.1": "<p><span class='verse-line'>{}</span>", "ja356:5.2": "<span class='verse-line'>{}</span>", "ja356:5.3": "<span class='verse-line'>{}</span>", "ja356:5.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja356:6.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja356:0.1": "Jātaka ", "ja356:0.2": "Pañcakanipāta ", "ja356:0.3": "Maṇikuṇḍalavagga ", "ja356:0.4": "6. Koraṇḍiyajātaka ", "ja356:1.1": "“Eko araññe girikandarāyaṁ, ", "ja356:1.2": "Paggayha paggayha silaṁ pavecchasi; ", "ja356:1.3": "Punappunaṁ santaramānarūpo, ", "ja356:1.4": "Koraṇḍiya ko nu tava yidhattho”. ", "ja356:2.1": "“Ahañhimaṁ sāgara sevitantaṁ, ", "ja356:2.2": "Samaṁ karissāmi yathāpi pāṇi; ", "ja356:2.3": "Vikiriya sānūni ca pabbatāni ca, ", "ja356:2.4": "Tasmā silaṁ dariyā pakkhipāmi”. ", "ja356:3.1": "“Nayimaṁ mahiṁ arahati pāṇikappaṁ, ", "ja356:3.2": "Samaṁ manusso karaṇāya meko; ", "ja356:3.3": "Maññāmimaññeva dariṁ jigīsaṁ, ", "ja356:3.4": "Koraṇḍiya hāhasi jīvalokaṁ”. ", "ja356:4.1": "“Sace ahaṁ bhūtadharaṁ na sakkā, ", "ja356:4.2": "Samaṁ manusso karaṇāya meko; ", "ja356:4.3": "Evameva tvaṁ brahme ime manusse, ", "ja356:4.4": "Nānādiṭṭhike nānayissasi te”. ", "ja356:5.1": "“Saṅkhittarūpena bhavaṁ mamatthaṁ, ", "ja356:5.2": "Akkhāsi koraṇḍiya evametaṁ; ", "ja356:5.3": "Yathā na sakkā pathavī samāyaṁ, ", "ja356:5.4": "Kattuṁ manussena tathā manussā”ti. ", "ja356:6.1": "Koraṇḍiyajātakaṁ chaṭṭhaṁ. "}, "variant_text": {"ja356:0.1": "", "ja356:0.2": "", "ja356:0.3": "", "ja356:0.4": "Koraṇḍiya → kāraṇḍiya (bj, pts-vp-pli1); kārandiya (sya1ed, sya2ed) ", "ja356:1.1": "", "ja356:1.2": "pavecchasi → pavejjhasi (bj-a, sya1ed, sya2ed) ", "ja356:1.3": "", "ja356:1.4": "", "ja356:2.1": "", "ja356:2.2": "", "ja356:2.3": "", "ja356:2.4": "", "ja356:3.1": "", "ja356:3.2": "", "ja356:3.3": "jigīsaṁ → jigiṁsaṁ (bj, sya1ed, sya2ed, pts-vp-pli1) ", "ja356:3.4": "hāhasi → hāyasi (bj, sya1ed, sya2ed, mr) ", "ja356:4.1": "ahaṁ → ayaṁ (bj, sya1ed, sya2ed, pts-vp-pli1) | sakkā → sakko (bj, sya1ed, sya2ed, mr); sattho (pts-vp-pli1) ", "ja356:4.2": "", "ja356:4.3": "", "ja356:4.4": "te → ne (mr) ", "ja356:5.1": "", "ja356:5.2": "", "ja356:5.3": "", "ja356:5.4": "", "ja356:6.1": "Koraṇḍiyajātakaṁ → kāraṇḍiyajātakaṁ (bj, pts-vp-pli1); kārandiyajātakaṁ (sya1ed, sya2ed) "}, "reference_text": {"ja356:0.1": "", "ja356:0.2": "", "ja356:0.3": "", "ja356:0.4": "", "ja356:1.1": "csp1ed22.124, csp2ed22.124, dr27.169, ms22J_1184, msdiv34, ndp22.115, pts-vp-pli3.172, vri68.105", "ja356:1.2": "", "ja356:1.3": "", "ja356:1.4": "", "ja356:2.1": "ms22J_1185, msdiv35", "ja356:2.2": "", "ja356:2.3": "", "ja356:2.4": "", "ja356:3.1": "ms22J_1186, msdiv36, sya27.170", "ja356:3.2": "", "ja356:3.3": "", "ja356:3.4": "", "ja356:4.1": "ms22J_1187, msdiv37, pts-vp-pli3.173", "ja356:4.2": "", "ja356:4.3": "", "ja356:4.4": "", "ja356:5.1": "dr27.170, ms22J_1188, msdiv38", "ja356:5.2": "", "ja356:5.3": "", "ja356:5.4": "", "ja356:6.1": "ms22J_1189"}, "keys_order": ["ja356:0.1", "ja356:0.2", "ja356:0.3", "ja356:0.4", "ja356:1.1", "ja356:1.2", "ja356:1.3", "ja356:1.4", "ja356:2.1", "ja356:2.2", "ja356:2.3", "ja356:2.4", "ja356:3.1", "ja356:3.2", "ja356:3.3", "ja356:3.4", "ja356:4.1", "ja356:4.2", "ja356:4.3", "ja356:4.4", "ja356:5.1", "ja356:5.2", "ja356:5.3", "ja356:5.4", "ja356:6.1"]}