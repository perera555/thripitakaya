{"html_text": {"ja453:0.1": "<article id='ja453'><header><ul><li class='division'>{}</li>", "ja453:0.2": "<li>{}</li>", "ja453:0.3": "<li>{}</li></ul>", "ja453:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja453:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja453:1.2": "<span class='verse-line'>{}</span>", "ja453:1.3": "<span class='verse-line'>{}</span>", "ja453:1.4": "<span class='verse-line'>{}</span></p>", "ja453:2.1": "<p><span class='verse-line'>{}</span>", "ja453:2.2": "<span class='verse-line'>{}</span>", "ja453:2.3": "<span class='verse-line'>{}</span>", "ja453:2.4": "<span class='verse-line'>{}</span></p>", "ja453:3.1": "<p><span class='verse-line'>{}</span>", "ja453:3.2": "<span class='verse-line'>{}</span>", "ja453:3.3": "<span class='verse-line'>{}</span>", "ja453:3.4": "<span class='verse-line'>{}</span></p>", "ja453:4.1": "<p><span class='verse-line'>{}</span>", "ja453:4.2": "<span class='verse-line'>{}</span>", "ja453:4.3": "<span class='verse-line'>{}</span>", "ja453:4.4": "<span class='verse-line'>{}</span></p>", "ja453:5.1": "<p><span class='verse-line'>{}</span>", "ja453:5.2": "<span class='verse-line'>{}</span>", "ja453:5.3": "<span class='verse-line'>{}</span>", "ja453:5.4": "<span class='verse-line'>{}</span></p>", "ja453:6.1": "<p><span class='verse-line'>{}</span>", "ja453:6.2": "<span class='verse-line'>{}</span>", "ja453:6.3": "<span class='verse-line'>{}</span>", "ja453:6.4": "<span class='verse-line'>{}</span></p>", "ja453:7.1": "<p><span class='verse-line'>{}</span>", "ja453:7.2": "<span class='verse-line'>{}</span>", "ja453:7.3": "<span class='verse-line'>{}</span>", "ja453:7.4": "<span class='verse-line'>{}</span></p>", "ja453:8.1": "<p><span class='verse-line'>{}</span>", "ja453:8.2": "<span class='verse-line'>{}</span>", "ja453:8.3": "<span class='verse-line'>{}</span>", "ja453:8.4": "<span class='verse-line'>{}</span></p>", "ja453:9.1": "<p><span class='verse-line'>{}</span>", "ja453:9.2": "<span class='verse-line'>{}</span>", "ja453:9.3": "<span class='verse-line'>{}</span>", "ja453:9.4": "<span class='verse-line'>{}</span></p>", "ja453:10.1": "<p><span class='verse-line'>{}</span>", "ja453:10.2": "<span class='verse-line'>{}</span>", "ja453:10.3": "<span class='verse-line'>{}</span>", "ja453:10.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja453:11.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja453:0.1": "Jātaka ", "ja453:0.2": "Dasakanipāta ", "ja453:0.3": "Catudvāravagga ", "ja453:0.4": "15. Mahāmaṅgalajātaka ", "ja453:1.1": "“Kiṁsu naro jappamadhiccakāle, ", "ja453:1.2": "Kaṁ vā vijjaṁ katamaṁ vā sutānaṁ; ", "ja453:1.3": "So macco asmiñca paramhi loke, ", "ja453:1.4": "Kathaṁ karo sotthānena gutto”. ", "ja453:2.1": "“Yassa devā pitaro ca sabbe, ", "ja453:2.2": "Sarīsapā sabbabhūtāni cāpi; ", "ja453:2.3": "Mettāya niccaṁ apacitāni honti, ", "ja453:2.4": "Bhūtesu ve sotthānaṁ tadāhu”. ", "ja453:3.1": "“Yo sabbalokassa nivātavutti, ", "ja453:3.2": "Itthīpumānaṁ sahadārakānaṁ; ", "ja453:3.3": "Khantā duruttānamappaṭikūlavādī, ", "ja453:3.4": "Adhivāsanaṁ sotthānaṁ tadāhu. ", "ja453:4.1": "Yo nāvajānāti sahāyamitte, ", "ja453:4.2": "Sippena kulyāhi dhanena jaccā; ", "ja453:4.3": "Rucipañño atthakāle matīmā, ", "ja453:4.4": "Sahāyesu ve sotthānaṁ tadāhu. ", "ja453:5.1": "Mittāni ve yassa bhavanti santo, ", "ja453:5.2": "Saṁvissatthā avisaṁvādakassa; ", "ja453:5.3": "Na mittadubbhī saṁvibhāgī dhanena, ", "ja453:5.4": "Mittesu ve sotthānaṁ tadāhu. ", "ja453:6.1": "Yassa bhariyā tulyavayā samaggā, ", "ja453:6.2": "Anubbatā dhammakāmā pajātā; ", "ja453:6.3": "Koliniyā sīlavatī patibbatā, ", "ja453:6.4": "Dāresu ve sotthānaṁ tadāhu. ", "ja453:7.1": "Yassa rājā bhūtapati yasassī, ", "ja453:7.2": "Jānāti soceyyaṁ parakkamañca; ", "ja453:7.3": "Advejjhatā suhadayaṁ mamanti, ", "ja453:7.4": "Rājūsu ve sotthānaṁ tadāhu. ", "ja453:8.1": "Annañca pānañca dadāti saddho, ", "ja453:8.2": "Mālañca gandhañca vilepanañca; ", "ja453:8.3": "Pasannacitto anumodamāno, ", "ja453:8.4": "Saggesu ve sotthānaṁ tadāhu. ", "ja453:9.1": "Yamariyadhammena punanti vuddhā, ", "ja453:9.2": "Ārādhitā samacariyāya santo; ", "ja453:9.3": "Bahussutā isayo sīlavanto, ", "ja453:9.4": "Arahantamajjhe sotthānaṁ tadāhu. ", "ja453:10.1": "Etāni kho sotthānāni loke, ", "ja453:10.2": "Viññuppasatthāni sukhudrayāni; ", "ja453:10.3": "Tānīdha sevetha naro sapañño, ", "ja453:10.4": "Na hi maṅgale kiñcanamatthi saccan”ti. ", "ja453:11.1": "Mahāmaṅgalajātakaṁ pannarasamaṁ. "}, "variant_text": {"ja453:0.1": "", "ja453:0.2": "", "ja453:0.3": "", "ja453:0.4": "", "ja453:1.1": "", "ja453:1.2": "", "ja453:1.3": "asmiñca → asmiṁva (pts-vp-pli1) ", "ja453:1.4": "", "ja453:2.1": "", "ja453:2.2": "Sarīsapā → siriṁsapā (bj, sya1ed, sya2ed, pts-vp-pli1) ", "ja453:2.3": "", "ja453:2.4": "", "ja453:3.1": "", "ja453:3.2": "", "ja453:3.3": "", "ja453:3.4": "", "ja453:4.1": "sahāyamitte → sahāyamatte (bj, pts-vp-pli1) ", "ja453:4.2": "", "ja453:4.3": "matīmā → mutīmā (bj, pts-vp-pli1) ", "ja453:4.4": "", "ja453:5.1": "", "ja453:5.2": "", "ja453:5.3": "", "ja453:5.4": "", "ja453:6.1": "", "ja453:6.2": "pajātā → sajātā (mr) ", "ja453:6.3": "", "ja453:6.4": "", "ja453:7.1": "bhūtapati → bhūtapatī (bj, sya1ed, sya2ed, pts-vp-pli1) ", "ja453:7.2": "", "ja453:7.3": "", "ja453:7.4": "", "ja453:8.1": "", "ja453:8.2": "", "ja453:8.3": "", "ja453:8.4": "", "ja453:9.1": "", "ja453:9.2": "", "ja453:9.3": "", "ja453:9.4": "", "ja453:10.1": "", "ja453:10.2": "sukhudrayāni → sukhindriyāni (pts-vp-pli1) ", "ja453:10.3": "", "ja453:10.4": "", "ja453:11.1": ""}, "reference_text": {"ja453:0.1": "", "ja453:0.2": "", "ja453:0.3": "", "ja453:0.4": "", "ja453:1.1": "csp1ed22.222, csp2ed22.222, ms22J_2077, msdiv155, pts-vp-pli4.75", "ja453:1.2": "", "ja453:1.3": "", "ja453:1.4": "", "ja453:2.1": "ms22J_2078, msdiv156", "ja453:2.2": "", "ja453:2.3": "", "ja453:2.4": "", "ja453:3.1": "ms22J_2079, msdiv157, pts-vp-pli4.76, sya27.299, vri68.176", "ja453:3.2": "", "ja453:3.3": "", "ja453