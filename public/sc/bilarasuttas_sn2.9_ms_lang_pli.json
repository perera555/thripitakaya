{"html_text": {"sn2.9:0.1": "<article id='sn2.9'><header><ul><li class='division'>{}</li>", "sn2.9:0.2": "<li>{}</li></ul>", "sn2.9:0.3": "<h1 class='sutta-title'>{}</h1></header>", "sn2.9:1.1": "<p>{}</p>", "sn2.9:1.2": "<p>{}", "sn2.9:1.3": "{}</p>", "sn2.9:2.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "sn2.9:2.2": "<span class='verse-line'>{}</span>", "sn2.9:2.3": "<span class='verse-line'>{}</span>", "sn2.9:2.4": "<span class='verse-line'>{}</span></p></blockquote>", "sn2.9:3.1": "<p>{}</p>", "sn2.9:4.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "sn2.9:4.2": "<span class='verse-line'>{}</span>", "sn2.9:4.3": "<span class='verse-line'>{}</span>", "sn2.9:4.4": "<span class='verse-line'>{}</span></p></blockquote>", "sn2.9:5.1": "<p>{}", "sn2.9:5.2": "{}</p>", "sn2.9:6.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "sn2.9:6.2": "<span class='verse-line'>{}</span>", "sn2.9:6.3": "<span class='verse-line'>{}</span>", "sn2.9:6.4": "<span class='verse-line'>{}</span></p>", "sn2.9:7.1": "<p><span class='verse-line'>{}</span>", "sn2.9:7.2": "<span class='verse-line'>{}</span>", "sn2.9:7.3": "<span class='verse-line'>{}</span>", "sn2.9:7.4": "<span class='verse-line'>{}</span></p></blockquote></article>"}, "root_text": {"sn2.9:0.1": "Saṁyutta Nikāya 2.9 ", "sn2.9:0.2": "1. Paṭhamavagga ", "sn2.9:0.3": "Candimasutta ", "sn2.9:1.1": "Sāvatthinidānaṁ. ", "sn2.9:1.2": "Tena kho pana samayena candimā devaputto rāhunā asurindena gahito hoti. ", "sn2.9:1.3": "Atha kho candimā devaputto bhagavantaṁ anussaramāno tāyaṁ velāyaṁ imaṁ gāthaṁ abhāsi: ", "sn2.9:2.1": "“Namo te buddha vīratthu, ", "sn2.9:2.2": "vippamuttosi sabbadhi; ", "sn2.9:2.3": "Sambādhapaṭipannosmi, ", "sn2.9:2.4": "tassa me saraṇaṁ bhavā”ti. ", "sn2.9:3.1": "Atha kho bhagavā candimaṁ devaputtaṁ ārabbha rāhuṁ asurindaṁ gāthāya ajjhabhāsi: ", "sn2.9:4.1": "“Tathāgataṁ arahantaṁ, ", "sn2.9:4.2": "candimā saraṇaṁ gato; ", "sn2.9:4.3": "Rāhu candaṁ pamuñcassu, ", "sn2.9:4.4": "buddhā lokānukampakā”ti. ", "sn2.9:5.1": "Atha kho rāhu asurindo candimaṁ devaputtaṁ muñcitvā taramānarūpo yena vepacitti asurindo tenupasaṅkami; upasaṅkamitvā saṁviggo lomahaṭṭhajāto ekamantaṁ aṭṭhāsi. ", "sn2.9:5.2": "Ekamantaṁ ṭhitaṁ kho rāhuṁ asurindaṁ vepacitti asurindo gāthāya ajjhabhāsi: ", "sn2.9:6.1": "“Kiṁ nu santaramānova, ", "sn2.9:6.2": "rāhu candaṁ pamuñcasi; ", "sn2.9:6.3": "Saṁviggarūpo āgamma, ", "sn2.9:6.4": "kiṁ nu bhītova tiṭṭhasī”ti. ", "sn2.9:7.1": "“Sattadhā me phale muddhā, ", "sn2.9:7.2": "jīvanto na sukhaṁ labhe; ", "sn2.9:7.3": "Buddhagāthābhigītomhi, ", "sn2.9:7.4": "no ce muñceyya candiman”ti. "}, "reference_text": {"sn2.9:0.1": "", "sn2.9:0.2": "", "sn2.9:0.3": "", "sn2.9:1.1": "csp1ed12.48, csp2ed12.48, ms12S1_412, msdiv90", "sn2.9:1.2": "", "sn2.9:1.3": "", "sn2.9:2.1": "ms12S1_413", "sn2.9:2.2": "", "sn2.9:2.3": "", "sn2.9:2.4": "", "sn2.9:3.1": "ms12S1_414", "sn2.9:4.1": "ms12S1_415, ndp12.48", "sn2.9:4.2": "", "sn2.9:4.3": "", "sn2.9:4.4": "", "sn2.9:5.1": "bj13.96, dr15.66, ms12S1_416, pts-vp-pli2ed1.115, sya15.70", "sn2.9:5.2": "", "sn2.9:6.1": "ms12S1_417", "sn2.9:6.2": "", "sn2.9:6.3": "", "sn2.9:6.4": "", "sn2.9:7.1": "cck15.67, ms12S1_418, vri23.61", "sn2.9:7.2": "", "sn2.9:7.3": "", "sn2.9:7.4": ""}, "keys_order": ["sn2.9:0.1", "sn2.9:0.2", "sn2.9:0.3", "sn2.9:1.1", "sn2.9:1.2", "sn2.9:1.3", "sn2.9:2.1", "sn2.9:2.2", "sn2.9:2.3", "sn2.9:2.4", "sn2.9:3.1", "sn2.9:4.1", "sn2.9:4.2", "sn2.9:4.3", "sn2.9:4.4", "sn2.9:5.1", "sn2.9:5.2", "sn2.9:6.1", "sn2.9:6.2", "sn2.9:6.3", "sn2.9:6.4", "sn2.9:7.1", "sn2.9:7.2", "sn2.9:7.3", "sn2.9:7.4"]}