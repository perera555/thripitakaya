{"html_text": {"ja417:0.1": "<article id='ja417'><header><ul><li class='division'>{}</li>", "ja417:0.2": "<li>{}</li>", "ja417:0.3": "<li>{}</li></ul>", "ja417:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja417:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja417:1.2": "<span class='verse-line'>{}</span>", "ja417:1.3": "<span class='verse-line'>{}</span>", "ja417:1.4": "<span class='verse-line'>{}</span></p>", "ja417:2.1": "<p><span class='verse-line'>{}</span>", "ja417:2.2": "<span class='verse-line'>{}</span>", "ja417:2.3": "<span class='verse-line'>{}</span>", "ja417:2.4": "<span class='verse-line'>{}</span></p>", "ja417:3.1": "<p><span class='verse-line'>{}</span>", "ja417:3.2": "<span class='verse-line'>{}</span>", "ja417:3.3": "<span class='verse-line'>{}</span>", "ja417:3.4": "<span class='verse-line'>{}</span></p>", "ja417:4.1": "<p><span class='verse-line'>{}</span>", "ja417:4.2": "<span class='verse-line'>{}</span>", "ja417:4.3": "<span class='verse-line'>{}</span>", "ja417:4.4": "<span class='verse-line'>{}</span></p>", "ja417:5.1": "<p><span class='verse-line'>{}</span>", "ja417:5.2": "<span class='verse-line'>{}</span>", "ja417:5.3": "<span class='verse-line'>{}</span>", "ja417:5.4": "<span class='verse-line'>{}</span></p>", "ja417:6.1": "<p><span class='verse-line'>{}</span>", "ja417:6.2": "<span class='verse-line'>{}</span>", "ja417:6.3": "<span class='verse-line'>{}</span>", "ja417:6.4": "<span class='verse-line'>{}</span></p>", "ja417:7.1": "<p><span class='verse-line'>{}</span>", "ja417:7.2": "<span class='verse-line'>{}</span>", "ja417:7.3": "<span class='verse-line'>{}</span>", "ja417:7.4": "<span class='verse-line'>{}</span></p>", "ja417:8.1": "<p><span class='verse-line'>{}</span>", "ja417:8.2": "<span class='verse-line'>{}</span>", "ja417:8.3": "<span class='verse-line'>{}</span>", "ja417:8.4": "<span class='verse-line'>{}</span></p>", "ja417:9.1": "<p><span class='verse-line'>{}</span>", "ja417:9.2": "<span class='verse-line'>{}</span>", "ja417:9.3": "<span class='verse-line'>{}</span>", "ja417:9.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja417:10.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja417:0.1": "Jātaka ", "ja417:0.2": "Aṭṭhakanipāta ", "ja417:0.3": "Kaccānivagga ", "ja417:0.4": "1. Kaccānijātaka ", "ja417:1.1": "“Odātavatthā suci allakesā, ", "ja417:1.2": "Kaccāni kiṁ kumbhimadhissayitvā; ", "ja417:1.3": "Piṭṭhā tilā dhovasi taṇḍulāni, ", "ja417:1.4": "Tilodano hehiti kissahetu”. ", "ja417:2.1": "“Na kho ayaṁ brāhmaṇa bhojanatthā, ", "ja417:2.2": "Tilodano hehiti sādhupakko; ", "ja417:2.3": "Dhammo mato tassa pahuttamajja, ", "ja417:2.4": "Ahaṁ karissāmi susānamajjhe”. ", "ja417:3.1": "“Anuvicca kaccāni karohi kiccaṁ, ", "ja417:3.2": "Dhammo mato ko nu taveva saṁsi; ", "ja417:3.3": "Sahassanetto atulānubhāvo, ", "ja417:3.4": "Na miyyatī dhammavaro kadāci”. ", "ja417:4.1": "“Daḷhappamāṇaṁ mama ettha brahme, ", "ja417:4.2": "Dhammo mato natthi mamettha kaṅkhā; ", "ja417:4.3": "Yeyeva dāni pāpā bhavanti, ", "ja417:4.4": "Te teva dāni sukhitā bhavanti. ", "ja417:5.1": "Suṇisā hi mayhaṁ vañjhā ahosi, ", "ja417:5.2": "Sā maṁ vadhitvāna vijāyi puttaṁ; ", "ja417:5.3": "Sā dāni sabbassa kulassa issarā, ", "ja417:5.4": "Ahaṁ panamhi apaviddhā ekikā”. ", "ja417:6.1": "“Jīvāmi vohaṁ na matohamasmi, ", "ja417:6.2": "Taveva atthāya idhāgatosmi; ", "ja417:6.3": "Yā taṁ vadhitvāna vijāyi puttaṁ, ", "ja417:6.4": "Sahāva puttena karomi bhasmaṁ”. ", "ja417:7.1": "“Evañca te ruccati devarāja, ", "ja417:7.2": "Mameva atthāya idhāgatosi; ", "ja417:7.3": "Ahañca putto suṇisā ca nattā, ", "ja417:7.4": "Sammodamānā gharamāvasema”. ", "ja417:8.1": "“Evañca te ruccati kātiyāni, ", "ja417:8.2": "Hatāpi santā na jahāsi dhammaṁ; ", "ja417:8.3": "Tuvañca putto suṇisā ca nattā, ", "ja417:8.4": "Sammodamānā gharamāvasetha. ", "ja417:9.1": "Sā kātiyānī suṇisāya saddhiṁ, ", "ja417:9.2": "Sammodamānā gharamāvasittha; ", "ja417:9.3": "Putto ca nattā ca upaṭṭhahiṁsu, ", "ja417:9.4": "Devānamindena adhiggahītā”ti. ", "ja417:10.1": "Kaccānijātakaṁ paṭhamaṁ. "}, "variant_text": {"ja417:0.1": "", "ja417:0.2": "", "ja417:0.3": "", "ja417:0.4": "", "ja417:1.1": "", "ja417:1.2": "kumbhimadhissayitvā → kumbhimapassayitvā (pts-vp-pli1) ", "ja417:1.3": "", "ja417:1.4": "", "ja417:2.1": "bhojanatthā → bhojanatthaṁ (sya1ed, sya2ed) ", "ja417:2.2": "", "ja417:2.3": "pahuttamajja → pahūtamajja (bj); pahūnamajja (sya1ed, sya2ed); bahūtamajjā (pts-vp-pli1) ", "ja417:2.4": "", "ja417:3.1": "", "ja417:3.2": "taveva → taveta (bj, sya1ed, sya2ed, pts-vp-pli1) ", "ja417:3.3": "", "ja417:3.4": "", "ja417:4.1": "", "ja417:4.2": "", "ja417:4.3": "", "ja417:4.4": "", "ja417:5.1": "", "ja417:5.2": "", "ja417:5.3": "", "ja417:5.4": "panamhi → vasāmi (sya1ed, sya2ed) ", "ja417:6.1": "na matohamasmi → nāhaṁ matosmi (bj, pts-vp-pli1) ", "ja417:6.2": "", "ja417:6.3": "", "ja417:6.4": "", "ja417:7.1": "Evañca → etañca (bj, pts-vp-pli1) ", "ja417:7.2": "", "ja417:7.3": "", "ja417:7.4": "", "ja417:8.1": "", "ja417:8.2": "", "ja417:8.3": "Tuvañca → tvañca (pts-vp-pli1, mr) ", "ja417:8.4": "", "ja417:9.1": "", "ja417:9.2": "", "ja417:9.3": "", "ja417:9.4": "", "ja417:10.1": ""}, "reference_text": {"ja417:0.1": "", "ja417:0.2": "", "ja417:0.3": "", "ja417:0.4": "", "ja417:1.1": "bj30.302, csp1ed22.175, csp2ed22.175, dr27.237, ms22J_1673, msdiv1, ndp22.167, pts-vp-pli3.425, sya27.238, vri68.144", "ja417:1.2": "", "ja417:1.3": "", "ja417:1.4": "", "ja417:2.1": "ms22J_1674, msdiv2", "ja417:2.2": "", "ja417:2.3": "", "ja417:2.4": "", "ja417:3.1": "ms22J_1675, msdiv3, pts-vp-pli3.426", "ja417:3.2": "", "ja417:3.3": "", "ja417:3.4": "", "ja417:4.1": "ms22J_1676, msdiv4, sya27.239", "ja417:4.2": "", "ja417:4.3": "", "ja417:4.4": "", "ja417:5.1": "dr27.238, ms22J_1677, msdiv5", "ja417:5.2": "", "ja417:5.3": "", "ja417:5.4": "", "ja417:6.1": "csp1ed22.176, csp2ed22.176, ms22J_1678, msdiv6, ndp22.168", "ja417:6.2": "", "ja417:6.3": "", "ja417:6.4": "", "ja417:7.1": "ms22J_16