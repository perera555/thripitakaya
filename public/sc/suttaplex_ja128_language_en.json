[{"acronym": "Ja 128", "alt_acronym": null, "volpages": "PTS 1.461", "alt_volpages": null, "uid": "ja128", "blurb": "“Where saintliness.”—This story was told by the Master while at Jetavana, about a hypocrite. When the Brother’s hypocrisy was reported to him, the Master said, “This is not the first time he has shewn himself a hypocrite; he was just the sane in times gone by.” So saying he told this story of the past.", "difficulty": null, "original_title": "Biḷāravatajātaka", "root_lang": "pli", "root_lang_name": "Pāli", "type": "leaf", "translated_title": "Bilara Jātaka", "translations": [{"lang": "pli", "lang_name": "Pāli", "is_root": true, "author": "Mahāsaṅgīti Tipiṭaka Buddhavasse 2500", "author_short": "ms", "author_uid": "ms", "publication_date": null, "id": "ja128_root-pli-ms", "segmented": true, "title": null, "volpage": null, "has_comment": false}, {"lang": "de", "lang_name": "Deutsch", "is_root": false, "author": "Dr. Julius Dutoit", "author_short": "Dutoit", "author_uid": "dutoit", "publication_date": "2007", "id": "de_ja128_dutoit", "segmented": false, "volpage": null, "has_comment": false}, {"author": "Robert Chalmers", "author_short": "Chalmers", "author_uid": "chalmers", "has_comment": false, "id": "en_ja128_chalmers", "is_root": false, "lang": "en", "lang_name": "English", "publication_date": "1895", "segmented": false, "volpage": null, "title": "Bilara Jātaka"}, {"lang": "jpn", "lang_name": "日本語", "is_root": false, "author": "関西パーリ語実習会", "author_short": "関西パーリ語実習会", "author_uid": "kansai", "publication_date": "2023", "id": "jpn_ja128_kansai", "segmented": false, "volpage": null, "has_comment": false}, {"lang": "si", "lang_name": "සිංහල", "is_root": false, "author": "A.P. de Zoysa", "author_short": "Zoysa", "author_uid": "zoysa", "publication_date": null, "id": "si_ja128_zoysa", "segmented": false, "volpage": null, "has_comment": false}], "parallel_count": 0, "biblio": null, "priority_author_uid": "sujato", "verseNo": "", "previous": {"name": "The R