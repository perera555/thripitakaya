{"html_text": {"ja371:0.1": "<article id='ja371'><header><ul><li class='division'>{}</li>", "ja371:0.2": "<li>{}</li>", "ja371:0.3": "<li>{}</li></ul>", "ja371:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja371:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja371:1.2": "<span class='verse-line'>{}</span>", "ja371:1.3": "<span class='verse-line'>{}</span>", "ja371:1.4": "<span class='verse-line'>{}</span></p>", "ja371:2.1": "<p><span class='verse-line'>{}</span>", "ja371:2.2": "<span class='verse-line'>{}</span>", "ja371:2.3": "<span class='verse-line'>{}</span>", "ja371:2.4": "<span class='verse-line'>{}</span></p>", "ja371:3.1": "<p><span class='verse-line'>{}</span>", "ja371:3.2": "<span class='verse-line'>{}</span>", "ja371:3.3": "<span class='verse-line'>{}</span>", "ja371:3.4": "<span class='verse-line'>{}</span></p>", "ja371:4.1": "<p><span class='verse-line'>{}</span>", "ja371:4.2": "<span class='verse-line'>{}</span>", "ja371:4.3": "<span class='verse-line'>{}</span>", "ja371:4.4": "<span class='verse-line'>{}</span></p>", "ja371:5.1": "<p><span class='verse-line'>{}</span>", "ja371:5.2": "<span class='verse-line'>{}</span>", "ja371:5.3": "<span class='verse-line'>{}</span>", "ja371:5.4": "<span class='verse-line'>{}</span></p>", "ja371:6.1": "<p><span class='verse-line'>{}</span>", "ja371:6.2": "<span class='verse-line'>{}</span>", "ja371:6.3": "<span class='verse-line'>{}</span>", "ja371:6.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja371:7.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja371:0.1": "Jātaka ", "ja371:0.2": "Pañcakanipāta ", "ja371:0.3": "Aḍḍhavagga ", "ja371:0.4": "1. Dīghītikosalajātaka ", "ja371:1.1": "“Evaṁbhūtassa te rāja, ", "ja371:1.2": "āgatassa vase mama; ", "ja371:1.3": "Atthi nu koci pariyāyo, ", "ja371:1.4": "yo taṁ dukkhā pamocaye”. ", "ja371:2.1": "“Evaṁbhūtassa me tāta, ", "ja371:2.2": "āgatassa vase tava; ", "ja371:2.3": "Natthi no koci pariyāyo, ", "ja371:2.4": "yo maṁ dukkhā pamocaye”. ", "ja371:3.1": "“Nāññaṁ sucaritaṁ rāja, ", "ja371:3.2": "nāññaṁ rāja subhāsitaṁ; ", "ja371:3.3": "Tāyate maraṇakāle, ", "ja371:3.4": "evamevitaraṁ dhanaṁ. ", "ja371:4.1": "Akkocchi maṁ avadhi maṁ, ", "ja371:4.2": "ajini maṁ ahāsi me; ", "ja371:4.3": "Ye ca taṁ upanayhanti, ", "ja371:4.4": "veraṁ tesaṁ na sammati. ", "ja371:5.1": "Akkocchi maṁ avadhi maṁ, ", "ja371:5.2": "ajini maṁ ahāsi me; ", "ja371:5.3": "Ye ca taṁ nupanayhanti, ", "ja371:5.4": "veraṁ tesūpasammati. ", "ja371:6.1": "Na hi verena verāni, ", "ja371:6.2": "sammantīdha kudācanaṁ; ", "ja371:6.3": "Averena ca sammanti, ", "ja371:6.4": "esa dhammo sanantano”ti. ", "ja371:7.1": "Dīghītikosalajātakaṁ paṭhamaṁ. "}, "variant_text": {"ja371:0.1": "", "ja371:0.2": "", "ja371:0.3": "", "ja371:0.4": "", "ja371:1.1": "", "ja371:1.2": "vase → vaso (pts-vp-pli1, mr) ", "ja371:1.3": "", "ja371:1.4": "", "ja371:2.1": "", "ja371:2.2": "", "ja371:2.3": "", "ja371:2.4": "", "ja371:3.1": "", "ja371:3.2": "", "ja371:3.3": "", "ja371:3.4": "", "ja371:4.1": "", "ja371:4.2": "", "ja371:4.3": "", "ja371:4.4": "", "ja371:5.1": "", "ja371:5.2": "", "ja371:5.3": "", "ja371:5.4": "", "ja371:6.1": "", "ja371:6.2": "", "ja371:6.3": "", "ja371:6.4": "", "ja371:7.1": "Dīghītikosalajātakaṁ → dīghitikosalajātakaṁ (bj, pts-vp-pli1) "}, "reference_text": {"ja371:0.1": "", "ja371:0.2": "", "ja371:0.3": "", "ja371:0.4": "", "ja371:1.1": "bj30.228, dr27.181, ms22J_1277, msdiv110, pts-vp-pli3.211, sya27.182", "ja371:1.2": "", "ja371:1.3": "", "ja371:1.4": "", "ja371:2.1": "ms22J_1278, msdiv111", "ja371:2.2": "", "ja371:2.3": "", "ja371:2.4": "", "ja371:3.1": "ms22J_1279, msdiv112, pts-vp-pli3.217", "ja371:3.2": "", "ja371:3.3": "", "ja371:3.4": "", "ja371:4.1": "ms22J_1280, msdiv113", "ja371:4.2": "", "ja371:4.3": "", "ja371:4.4": "", "ja371:5.1": "ms22J_1281, msdiv114", "ja371:5.2": "", "ja371:5.3": "", "ja371:5.4": "", "ja371:6.1": "ms22J_1282, msdiv115", "ja371:6.2": "", "ja371:6.3": "", "ja371:6.4": "", "ja371:7.