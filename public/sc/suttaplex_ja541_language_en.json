[{"acronym": "Ja 541", "alt_acronym": null, "volpages": "PTS 6.97, PTS 6.98, PTS 6.99, PTS 6.100, PTS 6.102, PTS 6.103, PTS 6.104, PTS 6.105, PTS 6.106, PTS 6.107, PTS 6.108, PTS 6.109, PTS 6.110, PTS 6.111, PTS 6.112, PTS 6.113, PTS 6.114, PTS 6.115, PTS 6.116, PTS 6.117, PTS 6.118, PTS 6.119, PTS 6.120, PTS 6.121, PTS 6.122, PTS 6.123, PTS 6.124, PTS 6.125, PTS 6.126, PTS 6.127, PTS 6.128, PTS 6.129", "alt_volpages": null, "uid": "ja541", "blurb": "“Lo these grey hairs”—This story the Master told while dwelling in Makhadeva’s mango park, near Mithila, about a smile. One day at eventide, the Master with a large company of Brethren was walking up and down in this mango park, when he espied a pleasant spot. Being desirous of telling his behaviour in former times, he allowed a smile to be seen on his face. When asked by the Reverend Ananda why he smiled, he answered, “In yonder spot, Ananda, I once dwelt, deep in ecstatic meditation, in the time of King Makhadeva.” Then at his request, he sat down upon an offered seat, and told a story of the past.", "difficulty": null, "original_title": "Nimijātaka", "root_lang": "pli", "root_lang_name": "Pāli", "type": "leaf", "translated_title": "Nimi Jātaka", "translations": [{"lang": "pli", "lang_name": "Pāli", "is_root": true, "author": "Mahāsaṅgīti Tipiṭaka Buddhavasse 2500", "author_short": "ms", "author_uid": "ms", "publication_date": null, "id": "ja541_root-pli-ms", "segmented": true, "title": null, "volpage": null, "has_comment": false}, {"lang": "de", "lang_name": "Deutsch", "is_root": false, "author": "Dr. Julius Dutoit", "author_short": "Dutoit", "author_uid": "dutoit", "publication_date": "2007", "id": "de_ja541_dutoit", "segmented": false, "volpage": null, "has_comment": false}, {"author": "E.B. Cowell, W.H.D. Rouse", "author_short": "Cowell …", "author_uid": "cowell-rouse", "has_comment": false, "id": "en_ja541_cowell-rouse", "is_root": false, "lang": "en", "lang_name": "English", "publication_date": "1907", "segmente