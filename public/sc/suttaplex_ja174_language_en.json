[{"acronym": "Ja 174", "alt_acronym": null, "volpages": "PTS 2.71", "alt_volpages": null, "uid": "ja174", "blurb": "“Plenty of water”—This story the Master told in his sojourn at Veluvana, about Devadatta. One day it happened that the Brethren were talking in the Hall of Truth about Devadatta’s ingratitude and treachery to his friends, when the Master broke in, “Not this once only, Brethren, has Devadatta been ungrateful and treacherous to his own friends. He was just the same before.” Then he told them an old story.", "difficulty": null, "original_title": "Dubbhiyamakkaṭajātaka", "root_lang": "pli", "root_lang_name": "Pāli", "type": "leaf", "translated_title": "Dubhiya-Makkata Jātaka", "translations": [{"lang": "pli", "lang_name": "Pāli", "is_root": true, "author": "Mahāsaṅgīti Tipiṭaka Buddhavasse 2500", "author_short": "ms", "author_uid": "ms", "publication_date": null, "id": "ja174_root-pli-ms", "segmented": true, "title": null, "volpage": null, "has_comment": false}, {"lang": "de", "lang_name": "Deutsch", "is_root": false, "author": "Dr. Julius Dutoit", "author_short": "Dutoit", "author_uid": "dutoit", "publication_date": "2007", "id": "de_ja174_dutoit", "segmented": false, "volpage": null, "has_comment": false}, {"author": "W.H.D. Rouse", "author_short": "Rouse", "author_uid": "rouse", "has_comment": false, "id": "en_ja174_rouse", "is_root": false, "lang": "en", "lang_name": "English", "publication_date": "1895", "segmented": false, "volpage": null, "title": "Dubhiya-Makkata Jātaka"}, {"lang": "jpn", "lang_name": "日本語", "is_root": false, "author": "関西パーリ語実習会", "author_short": "関西パーリ語実習会", "author_uid": "kansai", "publication_date": "2023", "id": "jpn_ja174_kansai", "segmented": false, "volpage": null, "has_comment": false}, {"lang": "si", "lang_name": "සිංහල", "is_root": false, "author": "A.P. de Zoysa", "author_short": "Zoysa", "author_uid": "zoysa", "publication_date": null, "id": "si_ja174_zoysa", "segmented": false, "volpage": null, "has_comment": false}],