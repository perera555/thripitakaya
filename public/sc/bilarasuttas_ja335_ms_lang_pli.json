{"html_text": {"ja335:0.1": "<article id='ja335'><header><ul><li class='division'>{}</li>", "ja335:0.2": "<li>{}</li>", "ja335:0.3": "<li>{}</li></ul>", "ja335:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja335:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja335:1.2": "<span class='verse-line'>{}</span>", "ja335:1.3": "<span class='verse-line'>{}</span>", "ja335:1.4": "<span class='verse-line'>{}</span></p>", "ja335:2.1": "<p><span class='verse-line'>{}</span>", "ja335:2.2": "<span class='verse-line'>{}</span>", "ja335:2.3": "<span class='verse-line'>{}</span>", "ja335:2.4": "<span class='verse-line'>{}</span></p>", "ja335:3.1": "<p><span class='verse-line'>{}</span>", "ja335:3.2": "<span class='verse-line'>{}</span>", "ja335:3.3": "<span class='verse-line'>{}</span>", "ja335:3.4": "<span class='verse-line'>{}</span></p>", "ja335:4.1": "<p><span class='verse-line'>{}</span>", "ja335:4.2": "<span class='verse-line'>{}</span>", "ja335:4.3": "<span class='verse-line'>{}</span>", "ja335:4.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja335:5.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja335:0.1": "Jātaka ", "ja335:0.2": "Catukkanipāta ", "ja335:0.3": "Kokilavagga ", "ja335:0.4": "5. Jambukajātaka ", "ja335:1.1": "“Brahā pavaḍḍhakāyo so, ", "ja335:1.2": "dīghadāṭho ca jambuka; ", "ja335:1.3": "Na tvaṁ tattha kule jāto, ", "ja335:1.4": "yattha gaṇhanti kuñjaraṁ”. ", "ja335:2.1": "“Asīho sīhamānena, ", "ja335:2.2": "yo attānaṁ vikubbati; ", "ja335:2.3": "Kotthūva gajamāsajja, ", "ja335:2.4": "seti bhūmyā anutthunaṁ. ", "ja335:3.1": "Yasassino uttamapuggalassa, ", "ja335:3.2": "Sañjātakhandhassa mahabbalassa; ", "ja335:3.3": "Asamekkhiya thāmabalūpapattiṁ, ", "ja335:3.4": "Sa seti nāgena hatoyaṁ jambuko. ", "ja335:4.1": "Yo cīdha kammaṁ kurute pamāya, ", "ja335:4.2": "Thāmabbalaṁ attani saṁviditvā; ", "ja335:4.3": "Jappena mantena subhāsitena, ", "ja335:4.4": "Parikkhavā so vipulaṁ jinātī”ti. ", "ja335:5.1": "Jambukajātakaṁ pañcamaṁ. "}, "variant_text": {"ja335:0.1": "", "ja335:0.2": "", "ja335:0.3": "", "ja335:0.4": "", "ja335:1.1": "", "ja335:1.2": "", "ja335:1.3": "", "ja335:1.4": "", "ja335:2.1": "", "ja335:2.2": "", "ja335:2.3": "Kotthūva → kuṭṭhūva (si); kutthuva (sya1ed, sya2ed); kutthuṁ va (pts-vp-pli1) ", "ja335:2.4": "", "ja335:3.1": "", "ja335:3.2": "", "ja335:3.3": "", "ja335:3.4": "", "ja335:4.1": "", "ja335:4.2": "", "ja335:4.3": "", "ja335:4.4": "", "ja335:5.1": ""}, "reference_text": {"ja335:0.1": "", "ja335:0.2": "", "ja335:0.3": "", "ja335:0.4": "", "ja335:1.1": "dr27.152, ms22J_1059, msdiv137, pts-vp-pli3.113", "ja335:1.2": "", "ja335:1.3": "", "ja335:1.4": "", "ja335:2.1": "ms22J_1060, msdiv138, pts-vp-pli3.114", "ja335:2.2": "", "ja335:2.3": "", "ja335:2.4": "", "ja335:3.1": "ms22J_1061, msdiv139", "ja335:3.2": "", "ja335:3.3": "", "ja335:3.4": "", "ja335:4.1": "ms22J_1062, msdiv140, ndp22.103", "ja335:4.2": "", "ja335:4.3": "", "ja335:4.4": "", "ja335:5.1": "ms22J_1063"}, "keys_order": ["ja335:0.1", "ja335:0.2", "ja335:0.3", "ja335:0.4", "ja335:1.1", "ja335:1.2", "ja335:1.3", "ja335:1.4", "ja335:2.1", "ja335:2.2", "ja335:2.3", "ja335:2.4", "ja335:3.1", "ja335:3.2", "ja335:3.3", "ja335:3.4", "ja335:4.1", "ja335:4.2", "ja335:4.3", "ja335:4.4", "ja335:5.1"]}