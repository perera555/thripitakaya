{"html_text": {"ja48:0.1": "<article id='ja48'><header><ul><li class='division'>{}</li>", "ja48:0.2": "<li>{}</li>", "ja48:0.3": "<li>{}</li></ul>", "ja48:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja48:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja48:1.2": "<span class='verse-line'>{}</span>", "ja48:1.3": "<span class='verse-line'>{}</span>", "ja48:1.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja48:2.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja48:0.1": "Jātaka ", "ja48:0.2": "Ekakanipāta ", "ja48:0.3": "Atthakāmavagga ", "ja48:0.4": "8. Vedabbajātaka ", "ja48:1.1": "“Anupāyena yo atthaṁ, ", "ja48:1.2": "Icchati so vihaññati; ", "ja48:1.3": "Cetā haniṁsu vedabbaṁ, ", "ja48:1.4": "Sabbe te byasanamajjhagūti. ", "ja48:2.1": "Vedabbajātakaṁ aṭṭhamaṁ. "}, "variant_text": {"ja48:0.1": "", "ja48:0.2": "", "ja48:0.3": "", "ja48:0.4": "", "ja48:1.1": "", "ja48:1.2": "", "ja48:1.3": "vedabbaṁ → vedabbhaṁ (bj, pts-vp-pli1) ", "ja48:1.4": "byasanamajjhagūti → byasanamajjhagunti (sya1ed, sya2ed) ", "ja48:2.1": "Vedabbajātakaṁ → vedabbhajātakaṁ (bj, pts-vp-pli1) "}, "reference_text": {"ja48:0.1": "", "ja48:0.2": "", "ja48:0.3": "", "ja48:0.4": "", "ja48:1.1": "dr27.17, ms22J_104, msdiv48, pts-vp-pli1.256, sya27.16", "ja48:1.2": "", "ja48:1.3": "", "ja48:1.4": "", "ja48:2.1": "ms22J_105"}, "keys_order": ["ja48:0.1", "ja48:0.2", "ja48:0.3", "ja48:0.4", "ja48:1.1", "ja48:1.2", "ja48:1.3", "ja48:1.4", "ja48:2.1"]}