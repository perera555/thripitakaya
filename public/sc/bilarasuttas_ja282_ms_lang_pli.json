{"html_text": {"ja282:0.1": "<article id='ja282'><header><ul><li class='division'>{}</li>", "ja282:0.2": "<li>{}</li>", "ja282:0.3": "<li>{}</li></ul>", "ja282:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja282:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja282:1.2": "<span class='verse-line'>{}</span>", "ja282:1.3": "<span class='verse-line'>{}</span>", "ja282:1.4": "<span class='verse-line'>{}</span></p>", "ja282:2.1": "<p><span class='verse-line'>{}</span>", "ja282:2.2": "<span class='verse-line'>{}</span>", "ja282:2.3": "<span class='verse-line'>{}</span>", "ja282:2.4": "<span class='verse-line'>{}</span></p>", "ja282:3.1": "<p><span class='verse-line'>{}</span>", "ja282:3.2": "<span class='verse-line'>{}</span>", "ja282:3.3": "<span class='verse-line'>{}</span>", "ja282:3.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja282:4.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja282:0.1": "Jātaka ", "ja282:0.2": "Tikanipāta ", "ja282:0.3": "Abbhantaravagga ", "ja282:0.4": "2. Seyyajātaka ", "ja282:1.1": "“Seyyaṁso seyyaso hoti, ", "ja282:1.2": "yo seyyamupasevati; ", "ja282:1.3": "Ekena sandhiṁ katvāna, ", "ja282:1.4": "sataṁ vajjhe amocayiṁ. ", "ja282:2.1": "Tasmā sabbena lokena, ", "ja282:2.2": "sandhiṁ katvāna ekato; ", "ja282:2.3": "Pecca saggaṁ nigaccheyya, ", "ja282:2.4": "idaṁ suṇātha kāsiyā”. ", "ja282:3.1": "Idaṁ vatvā mahārājā, ", "ja282:3.2": "Kaṁso bārāṇasiggaho; ", "ja282:3.3": "Dhanuṁ kaṇḍañca nikkhippa, ", "ja282:3.4": "Saṁyamaṁ ajjhupāgamīti. ", "ja282:4.1": "Seyyajātakaṁ dutiyaṁ. "}, "variant_text": {"ja282:0.1": "", "ja282:0.2": "", "ja282:0.3": "", "ja282:0.4": "", "ja282:1.1": "", "ja282:1.2": "", "ja282:1.3": "", "ja282:1.4": "vajjhe → macce (mr); bajjhe (Ma-aka) ", "ja282:2.1": "Tasmā … saggaṁ nigaccheyya → kasmā …pe… saggaṁ na gaccheyya (katthaci) ", "ja282:2.2": "ekato → ekako (bj, sya1ed, sya2ed, pts-vp-pli1) ", "ja282:2.3": "", "ja282:2.4": "kāsiyā → kāsayo (bj, pts-vp-pli1) ", "ja282:3.1": "", "ja282:3.2": "", "ja282:3.3": "kaṇḍañca → tūṇiñca (bj, pts-vp-pli1); tuṇḍiñca (sya1ed, sya2ed) ", "ja282:3.4": "", "ja282:4.1": "Seyyajātakaṁ → seyyaṁsajātakaṁ (bj) "}, "reference_text": {"ja282:0.1": "", "ja282:0.2": "", "ja282:0.3": "", "ja282:0.4": "", "ja282:1.1": "ms22J_800, msdiv94, ndp22.78, pts-vp-pli2.402, vri68.74", "ja282:1.2": "", "ja282:1.3": "", "ja282:1.4": "", "ja282:2.1": "ms22J_801, msdiv95", "ja282:2.2": "", "ja282:2.3": "", "ja282:2.4": "", "ja282:3.1": "ms22J_802, msdiv96, pts-vp-pli2.403", "ja282:3.2": "", "ja282:3.3": "", "ja282:3.4": "", "ja282:4.1": "ms22J_803"}, "keys_order": ["ja282:0.1", "ja282:0.2", "ja282:0.3", "ja282:0.4", "ja282:1.1", "ja282:1.2", "ja282:1.3", "ja282:1.4", "ja282:2.1", "ja282:2.2", "ja282:2.3", "ja282:2.4", "ja282:3.1", "ja282:3.2", "ja282:3.3", "ja282:3.4", "ja282:4.1"]}