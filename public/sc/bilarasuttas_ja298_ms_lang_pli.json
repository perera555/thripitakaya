{"html_text": {"ja298:0.1": "<article id='ja298'><header><ul><li class='division'>{}</li>", "ja298:0.2": "<li>{}</li>", "ja298:0.3": "<li>{}</li></ul>", "ja298:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja298:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja298:1.2": "<span class='verse-line'>{}</span>", "ja298:1.3": "<span class='verse-line'>{}</span>", "ja298:1.4": "<span class='verse-line'>{}</span></p>", "ja298:2.1": "<p><span class='verse-line'>{}</span>", "ja298:2.2": "<span class='verse-line'>{}</span>", "ja298:2.3": "<span class='verse-line'>{}</span>", "ja298:2.4": "<span class='verse-line'>{}</span></p>", "ja298:3.1": "<p><span class='verse-line'>{}</span>", "ja298:3.2": "<span class='verse-line'>{}</span>", "ja298:3.3": "<span class='verse-line'>{}</span>", "ja298:3.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja298:4.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja298:0.1": "Jātaka ", "ja298:0.2": "Tikanipāta ", "ja298:0.3": "Kumbhavagga ", "ja298:0.4": "8. Udumbarajātaka ", "ja298:1.1": "“Udumbarā cime pakkā, ", "ja298:1.2": "nigrodhā ca kapitthanā; ", "ja298:1.3": "Ehi nikkhama bhuñjassu, ", "ja298:1.4": "kiṁ jighacchāya miyyasi”. ", "ja298:2.1": "“Evaṁ so suhito hoti, ", "ja298:2.2": "yo vuḍḍhamapacāyati; ", "ja298:2.3": "Yathāhamajja suhito, ", "ja298:2.4": "dumapakkāni māsito”. ", "ja298:3.1": "“Yaṁ vanejo vanejassa, ", "ja298:3.2": "vañceyya kapino kapi; ", "ja298:3.3": "Daharo kapi saddheyya, ", "ja298:3.4": "na hi jiṇṇo jarākapī”ti. ", "ja298:4.1": "Udumbarajātakaṁ aṭṭhamaṁ. "}, "variant_text": {"ja298:0.1": "", "ja298:0.2": "", "ja298:0.3": "", "ja298:0.4": "", "ja298:1.1": "", "ja298:1.2": "", "ja298:1.3": "", "ja298:1.4": "", "ja298:2.1": "", "ja298:2.2": "", "ja298:2.3": "", "ja298:2.4": "", "ja298:3.1": "", "ja298:3.2": "", "ja298:3.3": "Daharo kapi → daharopi taṁ na (bj, pts-vp-pli1); daharopi na (sya1ed, sya2ed) ", "ja298:3.4": "", "ja298:4.1": ""}, "reference_text": {"ja298:0