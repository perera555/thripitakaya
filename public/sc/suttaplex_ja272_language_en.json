[{"acronym": "Ja 272", "alt_acronym": null, "volpages": "PTS 2.357, PTS 2.358", "alt_volpages": null, "uid": "ja272", "blurb": "“What time the nearness”— This story the Master told whilst living at Jetavana, about Kokalika. The circumstances of this story will be given in the Thirteenth Book, and the Takkariya-jataka. Here again Kokalika said, “I will take Sariputta and Moggallana with me.” So having left Kokalika’s country, he travelled to Jetavana, greeted the Master, and went on to the Elders. He said, “Friends, the citizens of Kokalika’s country summon you. Let us go thither!!” “Go yourself, friend, we won’t,” was the answer. After this refusal he went away by himself.", "difficulty": null, "original_title": "Byagghajātaka", "root_lang": "pli", "root_lang_name": "Pāli", "type": "leaf", "translated_title": "Vyaggha Jātaka", "translations": [{"lang": "pli", "lang_name": "Pāli", "is_root": true, "author": "Mahāsaṅgīti Tipiṭaka Buddhavasse 2500", "author_short": "ms", "author_uid": "ms", "publication_date": null, "id": "ja272_root-pli-ms", "segmented": true, "title": null, "volpage": null, "has_comment": false}, {"lang": "de", "lang_name": "Deutsch", "is_root": false, "author": "Dr. Julius Dutoit", "author_short": "Dutoit", "author_uid": "dutoit", "publication_date": "2007", "id": "de_ja272_dutoit", "segmented": false, "volpage": null, "has_comment": false}, {"author": "W.H.D. Rouse", "author_short": "Rouse", "author_uid": "rouse", "has_comment": false, "id": "en_ja272_rouse", "is_root": false, "lang": "en", "lang_name": "English", "publication_date": "1895", "segmented": false, "volpage": null, "title": "Vyaggha Jātaka"}, {"lang": "jpn", "lang_name": "日本語", "is_root": false, "author": "関西パーリ語実習会", "author_short": "関西パーリ語実習会", "author_uid": "kansai", "publication_date": "2023", "id": "jpn_ja272_kansai", "segmented": false, "volpage": null, "has_comment": false}, {"lang": "si", "lang_name": "සිංහල", "is_root": false, "author": "A.P. de Zoysa", "author_short": "Zoysa"