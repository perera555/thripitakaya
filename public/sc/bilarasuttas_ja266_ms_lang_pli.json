{"html_text": {"ja266:0.1": "<article id='ja266'><header><ul><li class='division'>{}</li>", "ja266:0.2": "<li>{}</li>", "ja266:0.3": "<li>{}</li></ul>", "ja266:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja266:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja266:1.2": "<span class='verse-line'>{}</span>", "ja266:1.3": "<span class='verse-line'>{}</span>", "ja266:1.4": "<span class='verse-line'>{}</span></p>", "ja266:2.1": "<p><span class='verse-line'>{}</span>", "ja266:2.2": "<span class='verse-line'>{}</span>", "ja266:2.3": "<span class='verse-line'>{}</span>", "ja266:2.4": "<span class='verse-line'>{}</span></p>", "ja266:3.1": "<p><span class='verse-line'>{}</span>", "ja266:3.2": "<span class='verse-line'>{}</span>", "ja266:3.3": "<span class='verse-line'>{}</span>", "ja266:3.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja266:4.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja266:0.1": "Jātaka ", "ja266:0.2": "Tikanipāta ", "ja266:0.3": "Padumavagga ", "ja266:0.4": "6. Vātaggasindhavajātaka ", "ja266:1.1": "“Yenāsi kisiyā paṇḍu, ", "ja266:1.2": "yena bhattaṁ na ruccati; ", "ja266:1.3": "Ayaṁ so āgato bhattā, ", "ja266:1.4": "kasmā dāni palāyasi”. ", "ja266:2.1": "“Sace panādikeneva, ", "ja266:2.2": "santhavo nāma jāyati; ", "ja266:2.3": "Yaso hāyati itthīnaṁ, ", "ja266:2.4": "tasmā tāta palāyahaṁ”. ", "ja266:3.1": "Yasassinaṁ kule jātaṁ, ", "ja266:3.2": "āgataṁ yā na icchati; ", "ja266:3.3": "Socati cirarattāya, ", "ja266:3.4": "vātaggamiva bhaddalīti. ", "ja266:4.1": "Vātaggasindhavajātakaṁ chaṭṭhaṁ. "}, "variant_text": {"ja266:0.1": "", "ja266:0.2": "", "ja266:0.3": "", "ja266:0.4": "", "ja266:1.1": "", "ja266:1.2": "", "ja266:1.3": "bhattā → tāto (bj, pts-vp-pli1); bhatto (sya1ed, sya2ed) ", "ja266:1.4": "", "ja266:2.1": "Sace → nu kho (sya1ed, sya2ed, mr) ", "ja266:2.2": "", "ja266:2.3": "", "ja266:2.4": "palāyahaṁ → palāyihaṁ (sya1ed, sya2ed); palāyitaṁ (mr) ", "ja266:3.1": "", "ja266:3.2": "", "ja266:3.3": "", "ja266:3.4": "bhaddalīti → kundalīti (bj, pts-vp-pli1); gadrabhīti (sya1ed, sya2ed) ", "ja266:4.1": "Vātaggasindhavajātakaṁ → vātaggajātakaṁ (bj) "}, "reference_text": {"ja266:0.1": "", "ja266:0.2": "", "ja266:0.3": "", "ja266:0.4": "", "ja266:1.1": "ms22J_732, msdiv46, ndp22.72, pts-vp-pli2.340", "ja266:1.2": "", "ja266:1.3": "", "ja266:1.4": "", "ja266:2.1": "ms22J_733, msdiv47", "ja266:2.2": "", "ja266:2.3": "", "ja266:2.4": "", "ja266:3.1": "dr27.107, ms22J_734, msdiv48, sya27.108", "ja266:3.2": "", "ja266:3.3": "", "ja266:3.4": "", "ja266:4.1": "ms22J_735"}, "keys_order": ["ja266:0.1", "ja266:0.2", "ja266:0.3", "ja266:0.4", "ja266:1.1", "ja266:1.2", "ja266:1.3", "ja266:1.4", "ja266:2.1", "ja266:2.2", "ja266:2.3", "ja266:2.4", "ja266:3.1", "ja266:3.2", "ja266:3.3", "ja266:3.4", "ja266:4.1"]}