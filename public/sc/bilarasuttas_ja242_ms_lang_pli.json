{"html_text": {"ja242:0.1": "<article id='ja242'><header><ul><li class='division'>{}</li>", "ja242:0.2": "<li>{}</li>", "ja242:0.3": "<li>{}</li></ul>", "ja242:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja242:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja242:1.2": "<span class='verse-line'>{}</span>", "ja242:1.3": "<span class='verse-line'>{}</span>", "ja242:1.4": "<span class='verse-line'>{}</span></p>", "ja242:2.1": "<p><span class='verse-line'>{}</span>", "ja242:2.2": "<span class='verse-line'>{}</span>", "ja242:2.3": "<span class='verse-line'>{}</span>", "ja242:2.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja242:3.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja242:0.1": "Jātaka ", "ja242:0.2": "Dukanipāta ", "ja242:0.3": "Siṅgālavagga ", "ja242:0.4": "2. Sunakhajātaka ", "ja242:1.1": "“Bālo vatāyaṁ sunakho, ", "ja242:1.2": "yo varattaṁ na khādati; ", "ja242:1.3": "Bandhanā ca pamuñceyya, ", "ja242:1.4": "asito ca gharaṁ vaje”. ", "ja242:2.1": "“Aṭṭhitaṁ me manasmiṁ me, ", "ja242:2.2": "atho me hadaye kataṁ; ", "ja242:2.3": "Kālañca paṭikaṅkhāmi, ", "ja242:2.4": "yāva passupatū jano”ti. ", "ja242:3.1": "Sunakhajātakaṁ dutiyaṁ. "}, "variant_text": {"ja242:0.1": "", "ja242:0.2": "", "ja242:0.3": "", "ja242:0.4": "", "ja242:1.1": "", "ja242:1.2": "varattaṁ → yo ca yottaṁ (mr) ", "ja242:1.3": "", "ja242:1.4": "", "ja242:2.1": "", "ja242:2.2": "", "ja242:2.3": "", "ja242:2.4": "passupatū jano”ti → pasupatujjanoti (sya1ed, sya2ed, mr) ", "ja242:3.1": ""}, "reference_text": {"ja242:0.1": "", "ja242:0.2": "", "ja242:0.3": "", "ja242:0.4": "", "ja242:1.1": "ms22J_638, msdiv184, pts-vp-pli2.247, sya27.94", "ja242:1.2": "", "ja242:1.3": "", "ja242:1.4": "", "ja242:2.1": "csp1ed22.68, csp2ed22.68, ms22J_639, msdiv185, ndp22.63", "ja242:2.2": "", "ja242:2.3": "", "ja242:2.4": "", "ja242:3.1": "ms22J_640"}, "keys_order": ["ja242:0.1", "ja242:0.2", "ja242:0.3", "ja242:0.4", "ja242:1.1", "ja242:1.2", "ja242:1.3