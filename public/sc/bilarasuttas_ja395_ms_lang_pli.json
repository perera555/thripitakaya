{"html_text": {"ja395:0.1": "<article id='ja395'><header><ul><li class='division'>{}</li>", "ja395:0.2": "<li>{}</li>", "ja395:0.3": "<li>{}</li></ul>", "ja395:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja395:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja395:1.2": "<span class='verse-line'>{}</span>", "ja395:1.3": "<span class='verse-line'>{}</span>", "ja395:1.4": "<span class='verse-line'>{}</span></p>", "ja395:2.1": "<p><span class='verse-line'>{}</span>", "ja395:2.2": "<span class='verse-line'>{}</span>", "ja395:2.3": "<span class='verse-line'>{}</span>", "ja395:2.4": "<span class='verse-line'>{}</span></p>", "ja395:3.1": "<p><span class='verse-line'>{}</span>", "ja395:3.2": "<span class='verse-line'>{}</span>", "ja395:3.3": "<span class='verse-line'>{}</span>", "ja395:3.4": "<span class='verse-line'>{}</span></p>", "ja395:4.1": "<p><span class='verse-line'>{}</span>", "ja395:4.2": "<span class='verse-line'>{}</span>", "ja395:4.3": "<span class='verse-line'>{}</span>", "ja395:4.4": "<span class='verse-line'>{}</span></p>", "ja395:5.1": "<p><span class='verse-line'>{}</span>", "ja395:5.2": "<span class='verse-line'>{}</span>", "ja395:5.3": "<span class='verse-line'>{}</span>", "ja395:5.4": "<span class='verse-line'>{}</span></p>", "ja395:6.1": "<p><span class='verse-line'>{}</span>", "ja395:6.2": "<span class='verse-line'>{}</span>", "ja395:6.3": "<span class='verse-line'>{}</span>", "ja395:6.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja395:7.1": "<p class='endsutta'>{}</p>", "ja395:7.2": "<p class='endvagga'>{}</p>", "ja395:8.1": "<p class='uddana-intro'>{}</p>", "ja395:9.1": "<blockquote class='uddanagatha'><p><span class='verse-line'>{}</span>", "ja395:9.2": "<span class='verse-line'>{}</span>", "ja395:9.3": "<span class='verse-line'>{}</span>", "ja395:9.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja395:10.1": "<p class='uddana-intro'>{}</p>", "ja395:11.1": "<blockquote class='uddanagatha'><p><span class='verse-line'>{}</span>", "ja395:11.2": "<span class='verse-line'>{}</span>", "ja395:11.3": "<span class='verse-line'>{}</span>", "ja395:11.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja395:12.1": "<p class='endsection'>{}</p></article>"}, "root_text": {"ja395:0.1": "Jātaka ", "ja395:0.2": "Chakkanipāta ", "ja395:0.3": "Kharaputtavagga ", "ja395:0.4": "10. Pārāvatajātaka ", "ja395:1.1": "“Cirassaṁ vata passāmi, ", "ja395:1.2": "sahāyaṁ maṇidhārinaṁ; ", "ja395:1.3": "Sukatā massukuttiyā, ", "ja395:1.4": "sobhate vata me sakhā”. ", "ja395:2.1": "“Parūḷhakacchanakhalomo, ", "ja395:2.2": "ahaṁ kammesu byāvaṭo; ", "ja395:2.3": "Cirassaṁ nhāpitaṁ laddhā, ", "ja395:2.4": "lomaṁ taṁ ajja hārayiṁ”. ", "ja395:3.1": "“Yannu lomaṁ ahāresi, ", "ja395:3.2": "dullabhaṁ laddha kappakaṁ; ", "ja395:3.3": "Atha kiñcarahi te samma, ", "ja395:3.4": "kaṇṭhe kiṇikiṇāyati”. ", "ja395:4.1": "“Manussasukhumālānaṁ, ", "ja395:4.2": "maṇi kaṇṭhesu lambati; ", "ja395:4.3": "Tesāhaṁ anusikkhāmi, ", "ja395:4.4": "mā tvaṁ maññi davā kataṁ. ", "ja395:5.1": "Sacepimaṁ pihayasi, ", "ja395:5.2": "massukuttiṁ sukāritaṁ; ", "ja395:5.3": "Kārayissāmi te samma, ", "ja395:5.4": "maṇiñcāpi dadāmi te”. ", "ja395:6.1": "“Tvaññeva maṇinā channo, ", "ja395:6.2": "Sukatāya ca massuyā; ", "ja395:6.3": "Āmanta kho taṁ gacchāmi, ", "ja395:6.4": "Piyaṁ me tavadassanan”ti. ", "ja395:7.1": "Pārāvatajātakaṁ dasamaṁ. ", "ja395:7.2": "Kharaputtavaggo dutiyo. ", "ja395:8.1": "Tassuddānaṁ ", "ja395:9.1": "Atha passa sasūci ca tuṇḍilako, ", "ja395:9.2": "Miga mayhakapañcamapakkhivaro; ", "ja395:9.3": "Atha pañjali vārija mejjha puna, ", "ja395:9.4": "Atha vaṭṭa kapotavarena dasāti. ", "ja395:10.1": "Atha vagguddānaṁ ", "ja395:11.1": "Atha vaggaṁ pakittissaṁ, ", "ja395:11.2": "chanipātaṁ varuttame; ", "ja395:11.3": "Avāriyā ca kharo ca, ", "ja395:11.4": "dve ca vuttā subyañjanāti. ", "ja395:12.1": "Chakkanipātaṁ niṭṭhitaṁ. "}, "variant_text": {"ja395:0.1": "", "ja395:0.2": "", "ja395:0.3": "", "ja395:0.4": "", "ja395:1.1": "", "ja395:1.2": "", "ja395:1.3": "Sukatā → sukatāya (bj, pts-vp-pli1) ", "ja395:1.4": "", "ja395:2.1": "", "ja395:2.2": "", "ja395:2.3": "", "ja395:2.4": "hārayiṁ → apahārayiṁ (bj, pts-vp-pli1); hārayi (sya1ed, sya2ed) ", "ja395:3.1": "", "ja395:3.2": "", "ja395:3.3": "", "ja395:3.4": "kaṇṭhe kiṇikiṇāyati → kaṇṭhe kiṇakiṇāyati (bj, pts-vp-pli1); kaṇṭhe kiṁnikilāyati (sya1ed, sya2ed); idaṁ kaṇṭhe kiṇāyati (mr) ", "ja395:4.1": "", "ja395:4.2": "", "ja395:4.3": "", "ja395:4.4": "", "ja395:5.1": "", "ja395:5.2": "", "ja395:5.3": "", "ja395:5.4": "", "ja395:6.1": "", "ja395:6.2": "", "ja395:6.3": "", "ja395:6.4": "", "ja395:7.1": "Pārāvatajātakaṁ → kākajātakaṁ (bj, pts-vp-pli1); maṇijātakaṁ (sya1ed, sya2ed) ", "ja395:7.2": "Kharaputtavaggo → senakavaggo (bj, pts-vp-pli1); khuraputtavaggo (sya1ed, sya2ed); sūcivaggo (mr) ", "ja395:8.1": "", "ja395:9.1": "", "ja395:9.2": "", "ja395:9.3": "", "ja395:9.4": "", "ja395:10.1": "", "ja395:11.1": "", "ja395:11.2": "", "ja395:11.3": "kharo ca → senako (bj); sūci ca (sya1ed, sya2ed, mr) ", "ja395:11.4": "", "ja395:12.1": ""}, "reference_text": {"ja395:0.1": "", "ja395:0.2": "", "ja395:0.3": "", "ja395:0.4": "", "ja395:1.1": "bj30.262, ms22J_1473, msdiv135, ndp22.145, pts-vp-pli3.314", "ja395:1.2": "", "ja395:1.3": "", "ja395:1.4": "", "ja395:2.1": "csp1ed22.154, csp2ed22.154, ms22J_1474, msdiv136, pts-vp-pli3.315", "ja395:2.2": "", "ja395:2.3": "", "ja395:2.4": "", "ja395:3.1": "ms22J_1475, msdiv137", "ja395:3.2": "", "ja395:3.3": "", "ja395:3.4": "", "ja395:4.1": "dr27.209, ms22J_1476, msdiv138, sya27.210", "ja395:4.2": "", "ja395:4.3": "", "ja395:4.4": "", "ja395:5.1": "ms22J_1477, msdiv139", "ja395:5.2": "", "ja395:5.3": "", "ja395:5.4": "", "ja395:6.1": "ms22J_1478, msdiv140", "ja395:6.2": "", "ja395:6.3": "", "ja395:6.4": "", "ja395:7.1": "ms22J_1479", "ja395:7.2": "", "ja395:8.1": "ms22J_1480", "ja395:9.1": "ms22J_1481", "ja395:9.2": "", "ja395:9.3": "", "ja395:9.4": "", "ja395:10.1": "ms22J_1482",