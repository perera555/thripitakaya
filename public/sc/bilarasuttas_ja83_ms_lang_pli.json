{"html_text": {"ja83:0.1": "<article id='ja83'><header><ul><li class='division'>{}</li>", "ja83:0.2": "<li>{}</li>", "ja83:0.3": "<li>{}</li></ul>", "ja83:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja83:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja83:1.2": "<span class='verse-line'>{}</span>", "ja83:1.3": "<span class='verse-line'>{}</span>", "ja83:1.4": "<span class='verse-line'>{}</span>", "ja83:1.5": "<span class='verse-line'>{}</span>", "ja83:1.6": "<span class='verse-line'>{}</span></p></blockquote>", "ja83:2.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja83:0.1": "Jātaka ", "ja83:0.2": "Ekakanipāta ", "ja83:0.3": "Apāyimhavagga ", "ja83:0.4": "3. Kāḷakaṇṇijātaka ", "ja83:1.1": "“Mitto have sattapadena hoti, ", "ja83:1.2": "Sahāyo pana dvādasakena hoti; ", "ja83:1.3": "Māsaḍḍhamāsena ca ñāti hoti, ", "ja83:1.4": "Tatuttariṁ attasamopi hoti; ", "ja83:1.5": "Sohaṁ kathaṁ attasukhassa hetu, ", "ja83:1.6": "Cirasanthutaṁ kāḷakaṇṇiṁ jaheyyan”ti. ", "ja83:2.1": "Kāḷakaṇṇijātakaṁ tatiyaṁ "}, "variant_text": {"ja83:0.1": "", "ja83:0.2": "", "ja83:0.3": "", "ja83:0.4": "", "ja83:1.1": "", "ja83:1.2": "", "ja83:1.3": "", "ja83:1.4": "", "ja83:1.5": "", "ja83:1.6": "Cirasanthutaṁ → cirasatthunaṁ (pts-vp-pli1); cirasandhavaṁ (mr) ", "ja83:2.1": "Kāḷakaṇṇijātakaṁ → kālakaṇṇijātakaṁ (bj) "}, "reference_text": {"ja83:0.1": "", "ja83:0.2": "", "ja83:0.3": "", "ja83:0.4": "", "ja83:1.1": "ms22J_184, msdiv83, pts-vp-pli1.365", "ja83:1.2": "", "ja83:1.3": "", "ja83:1.4": "", "ja83:1.5": "", "ja83:1.6": "", "ja83:2.1": "ms22J_185"}, "keys_order": ["ja83:0.1", "ja83:0.2", "ja83:0.3", "ja83:0.4", "ja83:1.1", "ja83:1.2", "ja83:1.3", "ja83:1.4", "ja83:1.5", "ja83:1.6", "ja83:2.1"]}