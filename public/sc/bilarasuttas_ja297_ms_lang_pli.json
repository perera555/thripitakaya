{"html_text": {"ja297:0.1": "<article id='ja297'><header><ul><li class='division'>{}</li>", "ja297:0.2": "<li>{}</li>", "ja297:0.3": "<li>{}</li></ul>", "ja297:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja297:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja297:1.2": "<span class='verse-line'>{}</span>", "ja297:1.3": "<span class='verse-line'>{}</span>", "ja297:1.4": "<span class='verse-line'>{}</span></p>", "ja297:2.1": "<p><span class='verse-line'>{}</span>", "ja297:2.2": "<span class='verse-line'>{}</span>", "ja297:2.3": "<span class='verse-line'>{}</span>", "ja297:2.4": "<span class='verse-line'>{}</span></p>", "ja297:3.1": "<p><span class='verse-line'>{}</span>", "ja297:3.2": "<span class='verse-line'>{}</span>", "ja297:3.3": "<span class='verse-line'>{}</span>", "ja297:3.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja297:4.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja297:0.1": "Jātaka ", "ja297:0.2": "Tikanipāta ", "ja297:0.3": "Kumbhavagga ", "ja297:0.4": "7. Kāmavilāpajātaka ", "ja297:1.1": "“Ucce sakuṇa ḍemāna, ", "ja297:1.2": "pattayāna vihaṅgama; ", "ja297:1.3": "Vajjāsi kho tvaṁ vāmūruṁ, ", "ja297:1.4": "ciraṁ kho sā karissati. ", "ja297:2.1": "Idaṁ kho sā na jānāti, ", "ja297:2.2": "asiṁ sattiñca oḍḍitaṁ; ", "ja297:2.3": "Sā caṇḍī kāhati kodhaṁ, ", "ja297:2.4": "taṁ me tapati no idaṁ. ", "ja297:3.1": "Esa uppalasannāho, ", "ja297:3.2": "nikkhañcussīsakohitaṁ; ", "ja297:3.3": "Kāsikañca muduṁ vatthaṁ, ", "ja297:3.4": "tappetu dhanikā piyā”ti. ", "ja297:4.1": "Kāmavilāpajātakaṁ sattamaṁ. "}, "variant_text": {"ja297:0.1": "", "ja297:0.2": "", "ja297:0.3": "", "ja297:0.4": "", "ja297:1.1": "", "ja297:1.2": "", "ja297:1.3": "", "ja297:1.4": "karissati → sarissati (mr) ", "ja297:2.1": "", "ja297:2.2": "", "ja297:2.3": "", "ja297:2.4": "idaṁ → no idha (bj, sya1ed, sya2ed, pts-vp-pli1) ", "ja297:3.1": "", "ja297:3.2": "nikkhañcussīsakohitaṁ → nikkhamussīsake kataṁ (bj, pts-vp-pli1); nikkhañcussīsake kataṁ (sya1ed, sya2ed) ", "ja297:3.3": "", "ja297:3.4": "dhanikā piyā”ti → dhanakāmikāti (bj); dhanakāmiyāti (sya1ed, sya2ed, pts-vp-pli1) ", "ja297:4.1": ""}, "reference_text": {"ja297:0.1": "", "ja297:0.2": "", "ja297:0.3": "", "ja297:0.4": "", "ja297:1.1": "bj30.158, dr27.125, ms22J_862, msdiv139, pts-vp-pli2.443", "ja297:1.2": "", "ja297:1.3": "", "ja297:1.4": "", "ja297:2.1": "ms22J_863, msdiv140", "ja297:2.2": "", "ja297:2.3": "", "ja297:2.4": "", "ja297:3.1": "ms22J_864, msdiv141, sya27.125", "ja297:3.2": "", "ja297:3.3": "", "ja297:3.4": "", "ja297:4.1": "ms22J_865"}, "keys_order": ["ja297:0.1", "ja297:0.2", "ja297:0.3", "ja297:0.4", "ja297:1.1", "ja297:1.2", "ja297:1.3", "ja297:1.4", "ja297:2.1", "ja297:2.2", "ja297:2.3", "ja297:2.4", "ja297:3.1", "ja297:3.2", "ja297:3.3", "ja297:3.4", "ja297:4.1"]}