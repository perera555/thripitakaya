{"html_text": {"ja348:0.1": "<article id='ja348'><header><ul><li class='division'>{}</li>", "ja348:0.2": "<li>{}</li>", "ja348:0.3": "<li>{}</li></ul>", "ja348:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja348:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja348:1.2": "<span class='verse-line'>{}</span>", "ja348:1.3": "<span class='verse-line'>{}</span>", "ja348:1.4": "<span class='verse-line'>{}</span></p>", "ja348:2.1": "<p><span class='verse-line'>{}</span>", "ja348:2.2": "<span class='verse-line'>{}</span>", "ja348:2.3": "<span class='verse-line'>{}</span>", "ja348:2.4": "<span class='verse-line'>{}</span></p>", "ja348:3.1": "<p><span class='verse-line'>{}</span>", "ja348:3.2": "<span class='verse-line'>{}</span>", "ja348:3.3": "<span class='verse-line'>{}</span>", "ja348:3.4": "<span class='verse-line'>{}</span></p>", "ja348:4.1": "<p><span class='verse-line'>{}</span>", "ja348:4.2": "<span class='verse-line'>{}</span>", "ja348:4.3": "<span class='verse-line'>{}</span>", "ja348:4.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja348:5.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja348:0.1": "Jātaka ", "ja348:0.2": "Catukkanipāta ", "ja348:0.3": "Cūḷakuṇālavagga ", "ja348:0.4": "8. Araññajātaka ", "ja348:1.1": "“Araññā gāmamāgamma, ", "ja348:1.2": "kiṁsīlaṁ kiṁvataṁ ahaṁ; ", "ja348:1.3": "Purisaṁ tāta seveyyaṁ, ", "ja348:1.4": "taṁ me akkhāhi pucchito”. ", "ja348:2.1": "“Yo taṁ vissāsaye tāta, ", "ja348:2.2": "vissāsañca khameyya te; ", "ja348:2.3": "Sussūsī ca titikkhī ca, ", "ja348:2.4": "taṁ bhajehi ito gato. ", "ja348:3.1": "Yassa kāyena vācāya, ", "ja348:3.2": "manasā natthi dukkaṭaṁ; ", "ja348:3.3": "Urasīva patiṭṭhāya, ", "ja348:3.4": "taṁ bhajehi ito gato. ", "ja348:4.1": "Haliddirāgaṁ kapicittaṁ, ", "ja348:4.2": "purisaṁ rāgavirāginaṁ; ", "ja348:4.3": "Tādisaṁ tāta mā sevi, ", "ja348:4.4": "nimmanussampi ce siyā”ti. ", "ja348:5.1": "Araññajātakaṁ aṭṭhamaṁ. "}, "variant_text": {"ja348:0.1": "", "ja348:0.2": "", "ja348:0.3": "", "ja348:0.4": "", "ja348:1.1": "", "ja348:1.2": "taṁ → yo te (ja435:3 [Haliddirāgajātaka]) ", "ja348:1.3": "", "ja348:1.4": "", "ja348:2.1": "", "ja348:2.2": "", "ja348:2.3": "", "ja348:2.4": "taṁ bhajehi ito → taṁ bhajeyyāsito (mr) ", "ja348:3.1": "", "ja348:3.2": "", "ja348:3.3": "", "ja348:3.4": "", "ja348:4.1": "", "ja348:4.2": "", "ja348:4.3": "", "ja348:4.4": "", "ja348:5.1": ""}, "reference_text": {"ja348:0.1": "", "ja348:0.2": "", "ja348:0.3": "", "ja348:0.4": "", "ja348:1.1": "ms22J_1126, msdiv189, ndp22.109, pts-vp-pli3.148", "ja348:1.2": "", "ja348:1.3": "", "ja348:1.4": "", "ja348:2.1": "ms22J_1127, msdiv190", "ja348:2.2": "", "ja348:2.3": "", "ja348:2.4": "", "ja348:3.1": "ms22J_1128, msdiv191", "ja348:3.2": "", "ja348:3.3": "", "ja348:3.4": "", "ja348:4.1": "csp1ed22.118, csp2ed22.118, ms22J_1129, msdiv192, sya27.162", "ja348:4.2": "", "ja348:4.3": "", "ja348:4.4": "", "ja348:5.1": "ms22J_1130"}, "keys_order": ["ja348:0.1", "ja348:0.2", "ja348:0.3", "ja348:0.4", "ja348:1.1", "ja348:1.2", "ja348:1.3", "ja348:1.4", "ja348:2.1", "ja348:2.2", "ja348:2.3", "ja348:2.4", "ja348:3.1", "ja348:3.2", "ja348:3.3", "ja348:3.4", "ja348:4.1", "ja348:4.2", "ja348:4.3", "ja348:4.4", "ja348:5.1"]}