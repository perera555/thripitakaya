[{"acronym": "Ja 212", "alt_acronym": null, "volpages": "PTS 2.168, PTS 2.169", "alt_volpages": null, "uid": "ja212", "blurb": "“Hot at top”—This is a story told by the Master while at Jetavana, about one who hankered after a lost wife. The Brother in question was asked by the Master if he really was lovesick. Yes, he said, so he was. “For whom?” was the next question. “For my late wife.” “Brother,” the Master said, “this same woman in former days was wicked, and made you eat the leavings of her paramour.” Then he told this story of the past.", "difficulty": null, "original_title": "Ucchiṭṭhabhattajātaka", "root_lang": "pli", "root_lang_name": "Pāli", "type": "leaf", "translated_title": "Ucchittha-Bhatta Jātaka", "translations": [{"lang": "pli", "lang_name": "Pāli", "is_root": true, "author": "Mahāsaṅgīti Tipiṭaka Buddhavasse 2500", "author_short": "ms", "author_uid": "ms", "publication_date": null, "id": "ja212_root-pli-ms", "segmented": true, "title": null, "volpage": null, "has_comment": false}, {"lang": "de", "lang_name": "Deutsch", "is_root": false, "author": "Dr. Julius Dutoit", "author_short": "Dutoit", "author_uid": "dutoit", "publication_date": "2007", "id": "de_ja212_dutoit", "segmented": false, "volpage": null, "has_comment": false}, {"author": "W.H.D. Rouse", "author_short": "Rouse", "author_uid": "rouse", "has_comment": false, "id": "en_ja212_rouse", "is_root": false, "lang": "en", "lang_name": "English", "publication_date": "1895", "segmented": false, "volpage": null, "title": "Ucchittha-Bhatta Jātaka"}, {"lang": "jpn", "lang_name": "日本語", "is_root": false, "author": "関西パーリ語実習会", "author_short": "関西パーリ語実習会", "author_uid": "kansai", "publication_date": "2023", "id": "jpn_ja212_kansai", "segmented": false, "volpage": null, "has_comment": false}, {"lang": "si", "lang_name": "සිංහල", "is_root": false, "author": "A.P. de Zoysa", "author_short": "Zoysa", "author_uid": "zoysa", "publication_date": null, "id": "si_ja212_zoysa", "segmented": false, "volpage": n