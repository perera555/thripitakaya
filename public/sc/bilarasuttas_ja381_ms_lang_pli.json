{"html_text": {"ja381:0.1": "<article id='ja381'><header><ul><li class='division'>{}</li>", "ja381:0.2": "<li>{}</li>", "ja381:0.3": "<li>{}</li></ul>", "ja381:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja381:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja381:1.2": "<span class='verse-line'>{}</span>", "ja381:1.3": "<span class='verse-line'>{}</span>", "ja381:1.4": "<span class='verse-line'>{}</span></p>", "ja381:2.1": "<p><span class='verse-line'>{}</span>", "ja381:2.2": "<span class='verse-line'>{}</span>", "ja381:2.3": "<span class='verse-line'>{}</span>", "ja381:2.4": "<span class='verse-line'>{}</span></p>", "ja381:3.1": "<p><span class='verse-line'>{}</span>", "ja381:3.2": "<span class='verse-line'>{}</span>", "ja381:3.3": "<span class='verse-line'>{}</span>", "ja381:3.4": "<span class='verse-line'>{}</span></p>", "ja381:4.1": "<p><span class='verse-line'>{}</span>", "ja381:4.2": "<span class='verse-line'>{}</span>", "ja381:4.3": "<span class='verse-line'>{}</span>", "ja381:4.4": "<span class='verse-line'>{}</span></p>", "ja381:5.1": "<p><span class='verse-line'>{}</span>", "ja381:5.2": "<span class='verse-line'>{}</span>", "ja381:5.3": "<span class='verse-line'>{}</span>", "ja381:5.4": "<span class='verse-line'>{}</span></p>", "ja381:6.1": "<p><span class='verse-line'>{}</span>", "ja381:6.2": "<span class='verse-line'>{}</span>", "ja381:6.3": "<span class='verse-line'>{}</span>", "ja381:6.4": "<span class='verse-line'>{}</span>", "ja381:6.5": "<span class='verse-line'>{}</span>", "ja381:6.6": "<span class='verse-line'>{}</span></p></blockquote>", "ja381:7.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja381:0.1": "Jātaka ", "ja381:0.2": "Chakkanipāta ", "ja381:0.3": "Avāriyavagga ", "ja381:0.4": "6. Migālopajātaka ", "ja381:1.1": "“Na me rucci migālopa, ", "ja381:1.2": "yassa te tādisī gatī; ", "ja381:1.3": "Atuccaṁ tāta patasi, ", "ja381:1.4": "abhūmiṁ tāta sevasi. ", "ja381:2.1": "Catukkaṇṇaṁva kedāraṁ, ", "ja381:2.2": "yadā te pathavī siyā; ", "ja381:2.3": "Tato tāta nivattassu, ", "ja381:2.4": "māssu etto paraṁ gami”. ", "ja381:3.1": "“Santi aññepi sakuṇā, ", "ja381:3.2": "pattayānā vihaṅgamā; ", "ja381:3.3": "Akkhittā vātavegena, ", "ja381:3.4": "naṭṭhā te sassatīsamā. ", "ja381:4.1": "Akatvā apanandassa, ", "ja381:4.2": "pitu vuddhassa sāsanaṁ; ", "ja381:4.3": "Kālavāte atikkamma, ", "ja381:4.4": "verambhānaṁ vasaṁ agā. ", "ja381:5.1": "Tassa puttā ca dārā ca, ", "ja381:5.2": "ye caññe anujīvino; ", "ja381:5.3": "Sabbe byasanamāpāduṁ, ", "ja381:5.4": "anovādakare dije. ", "ja381:6.1": "Evampi idha vuddhānaṁ, ", "ja381:6.2": "yo vākyaṁ nāvabujjhati; ", "ja381:6.3": "Atisīmacaro ditto, ", "ja381:6.4": "gijjhovātītasāsano; ", "ja381:6.5": "Sabbe byasanaṁ papponti, ", "ja381:6.6": "akatvā vuddhasāsanan”ti. ", "ja381:7.1": "Migālopajātakaṁ chaṭṭhaṁ. "}, "variant_text": {"ja381:0.1": "", "ja381:0.2": "", "ja381:0.3": "", "ja381:0.4": "", "ja381:1.1": "", "ja381:1.2": "", "ja381:1.3": "", "ja381:1.4": "", "ja381:2.1": "", "ja381:2.2": "", "ja381:2.3": "", "ja381:2.4": "", "ja381:3.1": "", "ja381:3.2": "", "ja381:3.3": "", "ja381:3.4": "", "ja381:4.1": "apanandassa → aparaṇṇassa (bj, sya1ed, sya2ed, pts-vp-pli1) ", "ja381:4.2": "", "ja381:4.3": "", "ja381:4.4": "agā → gato (bj) ", "ja381:5.1": "", "ja381:5.2": "", "ja381:5.3": "", "ja381:5.4": "", "ja381:6.1": "", "ja381:6.2": "", "ja381:6.3": "Atisīmacaro → atisīmaṁ caro (bj, sya1ed, sya2ed, mr) ", "ja381:6.4": "", "ja381:6.5": "", "ja381:6.6": "", "ja381:7.1": ""}, "reference_text": {"ja381:0.1": "", "ja381:0.2": "", "ja381:0.3": "", "ja381:0.4": "", "ja381:1.1": "ms22J_1356, msdiv34, pts-vp-pli3.255", "ja381:1.2": "", "ja381:1.3": "", "ja381:1.4": "", "ja381:2.1": "ms22J_1357, msdiv35", "ja381:2.2": "", "ja381:2.3": "", "ja381:2.4": "", "ja381:3.1": "ms22J_1358, msdiv36", "ja381:3.2": "", "ja381:3.3": "", "ja381:3.4": "", "ja381:4.1": "ms22J_1359, msdiv37, pts-vp-pli3.256, sya27.193", "ja381:4.2": "", "ja381:4.3": "", "