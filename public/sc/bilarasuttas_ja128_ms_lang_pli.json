{"html_text": {"ja128:0.1": "<article id='ja128'><header><ul><li class='division'>{}</li>", "ja128:0.2": "<li>{}</li>", "ja128:0.3": "<li>{}</li></ul>", "ja128:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja128:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja128:1.2": "<span class='verse-line'>{}</span>", "ja128:1.3": "<span class='verse-line'>{}</span>", "ja128:1.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja128:2.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja128:0.1": "Jātaka ", "ja128:0.2": "Ekakanipāta ", "ja128:0.3": "Kusanāḷivagga ", "ja128:0.4": "8. Biḷāravatajātaka ", "ja128:1.1": "“Yo ve dhammaṁ dhajaṁ katvā, ", "ja128:1.2": "Nigūḷho pāpamācare; ", "ja128:1.3": "Vissāsayitvā bhūtāni, ", "ja128:1.4": "Biḷāraṁ nāma taṁ vatan”ti. ", "ja128:2.1": "Biḷāravatajātakaṁ aṭṭhamaṁ. "}, "variant_text": {"ja128:0.1": "", "ja128:0.2": "", "ja128:0.3": "", "ja128:0.4": "", "ja128:1.1": "dhammaṁ dhajaṁ → dhammaddhajaṁ (sya1ed, sya2ed); dhammadhajaṁ (pts-vp-pli1, mr) ", "ja128:1.2": "", "ja128:1.3": "", "ja128:1.4": "", "ja128:2.1": "Biḷāravatajātakaṁ → mūsikajātakaṁ (sya1ed, sya2ed); biḷārajātakaṁ (pts-vp-pli1) "}, "reference_text": {"ja128:0.1": "", "ja128:0.2": "", "ja128:0.3": "", "ja128:0.4": "", "ja128:1.1": "csp1ed22.30, csp2ed22.30, ms22J_283, msdiv128, pts-vp-pli1.461", "ja128:1.2": "", "ja128:1.3": "", "ja128:1.4": "", "ja128:2.1": "ms22J_284"}, "keys_order": ["ja128:0.1", "ja128:0.2", "ja128:0.3", "ja128:0.4", "ja128:1.1", "ja128:1.2", "ja128:1.3", "ja128:1.4", "ja128:2.1"]}