{"html_text": {"ja204:0.1": "<article id='ja204'><header><ul><li class='division'>{}</li>", "ja204:0.2": "<li>{}</li>", "ja204:0.3": "<li>{}</li></ul>", "ja204:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja204:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja204:1.2": "<span class='verse-line'>{}</span>", "ja204:1.3": "<span class='verse-line'>{}</span>", "ja204:1.4": "<span class='verse-line'>{}</span></p>", "ja204:2.1": "<p><span class='verse-line'>{}</span>", "ja204:2.2": "<span class='verse-line'>{}</span>", "ja204:2.3": "<span class='verse-line'>{}</span>", "ja204:2.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja204:3.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja204:0.1": "Jātaka ", "ja204:0.2": "Dukanipāta ", "ja204:0.3": "Nataṁdaḷhavagga ", "ja204:0.4": "4. Vīrakajātaka ", "ja204:1.1": "“Api vīraka passesi, ", "ja204:1.2": "sakuṇaṁ mañjubhāṇakaṁ; ", "ja204:1.3": "Mayūragīvasaṅkāsaṁ, ", "ja204:1.4": "patiṁ mayhaṁ saviṭṭhakaṁ”. ", "ja204:2.1": "“Udakathalacarassa pakkhino, ", "ja204:2.2": "Niccaṁ āmakamacchabhojino; ", "ja204:2.3": "Tassānukaraṁ saviṭṭhako, ", "ja204:2.4": "Sevāle paliguṇṭhito mato”ti. ", "ja204:3.1": "Vīrakajātakaṁ catutthaṁ. "}, "reference_text": {"ja204:0.1": "", "ja204:0.2": "", "ja204:0.3": "", "ja204:0.4": "", "ja204:1.1": "ms22J_515, msdiv107, pts-vp-pli2.150", "ja204:1.2": "", "ja204:1.3": "", "ja204:1.4": "", "ja204:2.1": "dr27.75, ms22J_516, msdiv108, ndp22.51", "ja204:2.2": "", "ja204:2.3": "", "ja204:2.4": "", "ja204:3.1": "ms22J_517"}, "keys_order": ["ja204:0.1", "ja204:0.2", "ja204:0.3", "ja204:0.4", "ja204:1.1", "ja204:1.2", "ja204:1.3", "ja204:1.4", "ja204:2.1", "ja204:2.2", "ja204:2.3", "ja204:2.4", "ja204:3.1"]}