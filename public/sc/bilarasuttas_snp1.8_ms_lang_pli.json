{"html_text": {"snp1.8:0.1": "<article id='snp1.8'><header><ul><li class='division'>{}</li></ul>", "snp1.8:0.2": "<h1 class='sutta-title'>{}</h1></header>", "snp1.8:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "snp1.8:1.2": "<span class='verse-line'>{}</span>", "snp1.8:1.3": "<span class='verse-line'>{}</span>", "snp1.8:1.4": "<span class='verse-line'>{}</span></p>", "snp1.8:2.1": "<p><span class='verse-line'>{}</span>", "snp1.8:2.2": "<span class='verse-line'>{}</span>", "snp1.8:2.3": "<span class='verse-line'>{}</span>", "snp1.8:2.4": "<span class='verse-line'>{}</span></p>", "snp1.8:3.1": "<p><span class='verse-line'>{}</span>", "snp1.8:3.2": "<span class='verse-line'>{}</span>", "snp1.8:3.3": "<span class='verse-line'>{}</span>", "snp1.8:3.4": "<span class='verse-line'>{}</span></p>", "snp1.8:4.1": "<p><span class='verse-line'>{}</span>", "snp1.8:4.2": "<span class='verse-line'>{}</span>", "snp1.8:4.3": "<span class='verse-line'>{}</span>", "snp1.8:4.4": "<span class='verse-line'>{}</span></p>", "snp1.8:5.1": "<p><span class='verse-line'>{}</span>", "snp1.8:5.2": "<span class='verse-line'>{}</span>", "snp1.8:5.3": "<span class='verse-line'>{}</span>", "snp1.8:5.4": "<span class='verse-line'>{}</span></p>", "snp1.8:6.1": "<p><span class='verse-line'>{}</span>", "snp1.8:6.2": "<span class='verse-line'>{}</span>", "snp1.8:6.3": "<span class='verse-line'>{}</span>", "snp1.8:6.4": "<span class='verse-line'>{}</span></p>", "snp1.8:7.1": "<p><span class='verse-line'>{}</span>", "snp1.8:7.2": "<span class='verse-line'>{}</span>", "snp1.8:7.3": "<span class='verse-line'>{}</span>", "snp1.8:7.4": "<span class='verse-line'>{}</span></p>", "snp1.8:8.1": "<p><span class='verse-line'>{}</span>", "snp1.8:8.2": "<span class='verse-line'>{}</span>", "snp1.8:8.3": "<span class='verse-line'>{}</span>", "snp1.8:8.4": "<span class='verse-line'>{}</span></p>", "snp1.8:9.1": "<p><span class='verse-line'>{}</span>", "snp1.8:9.2": "<span class='verse-line'>{}</span>", "snp1.8:9.3": "<span class='verse-line'>{}</span>", "snp1.8:9.4": "<span class='verse-line'>{}</span></p>", "snp1.8:10.1": "<p><span class='verse-line'>{}</span>", "snp1.8:10.2": "<span class='verse-line'>{}</span>", "snp1.8:10.3": "<span class='verse-line'>{}</span>", "snp1.8:10.4": "<span class='verse-line'>{}</span></p></blockquote>", "snp1.8:10.5": "<p class='endsutta'>{}</p></article>"}, "root_text": {"snp1.8:0.1": "Sutta Nipāta 1.8 ", "snp1.8:0.2": "Mettasutta ", "snp1.8:1.1": "“Karaṇīyamatthakusalena, ", "snp1.8:1.2": "Yanta santaṁ padaṁ abhisamecca; ", "snp1.8:1.3": "Sakko ujū ca suhujū ca, ", "snp1.8:1.4": "Sūvaco cassa mudu anatimānī. ", "snp1.8:2.1": "Santussako ca subharo ca, ", "snp1.8:2.2": "Appakicco ca sallahukavutti; ", "snp1.8:2.3": "Santindriyo ca nipako ca, ", "snp1.8:2.4": "Appagabbho kulesvananugiddho. ", "snp1.8:3.1": "Na ca khuddamācare kiñci, ", "snp1.8:3.2": "Yena viññū pare upavadeyyuṁ; ", "snp1.8:3.3": "Sukhino va khemino hontu, ", "snp1.8:3.4": "Sabbasattā bhavantu sukhitattā. ", "snp1.8:4.1": "Ye keci pāṇabhūtatthi, ", "snp1.8:4.2": "Tasā vā thāvarā vanavasesā; ", "snp1.8:4.3": "Dīghā vā ye va mahantā, ", "snp1.8:4.4": "Majjhimā rassakā aṇukathūlā. ", "snp1.8:5.1": "Diṭṭhā vā ye va adiṭṭhā, ", "snp1.8:5.2": "Ye va dūre vasanti avidūre; ", "snp1.8:5.3": "Bhūtā va sambhavesī va, ", "snp1.8:5.4": "Sabbasattā bhavantu sukhitattā. ", "snp1.8:6.1": "Na paro paraṁ nikubbetha, ", "snp1.8:6.2": "Nātimaññetha katthaci na kañci; ", "snp1.8:6.3": "Byārosanā paṭighasañña, ", "snp1.8:6.4": "Nāññamaññassa dukkhamiccheyya. ", "snp1.8:7.1": "Mātā yathā niyaṁ puttam ", "snp1.8:7.2": "Āyusā ekaputtamanurakkhe; ", "snp1.8:7.3": "Evampi sabbabhūtesu, ", "snp1.8:7.4": "Mānasaṁ bhāvaye aparimāṇaṁ. ", "snp1.8:8.1": "Mettañca sabbalokasmi, ", "snp1.8:8.2": "Mānasaṁ bhāvaye aparimāṇaṁ; ", "snp1.8:8.3": "Uddhaṁ adho ca tiriyañca, ", "snp1.8:8.4": "Asambādhaṁ averamasapattaṁ. ", "snp1.8:9.1": "Tiṭṭhaṁ caraṁ nisinno va, ", "snp1.8:9.2": "Sayāno yāvatāssa vitamiddho; ", "snp1.8:9.3": "Etaṁ satiṁ adhiṭṭheyya, ", "snp1.8:9.4": "Brahmametaṁ vihāramidhamāhu. ", "snp1.8:10.1": "Diṭṭhiñca anupaggamma, ", "snp1.8:10.2": "Sīlavā dassanena sampanno; ", "snp1.8:10.3": "Kāmesu vinaya gedhaṁ, ", "snp1.8:10.4": "Na hi jātuggabbhaseyya punaretī”ti. ", "snp1.8:10.5": "Mettasuttaṁ aṭṭhamaṁ. "}, "variant_text": {"snp1.8:0.1": "", "snp1.8:0.2": "", "snp1.8:1.1": "", "snp1.8:1.2": "", "snp1.8:1.3": "suhujū → sūjū (bj, pts-vp-pli1) ", "snp1.8:1.4": "va → ye ca (bj, sya-all, km, pts-vp-pli1) ", "snp1.8:2.1": "", "snp1.8:2.2": "", "snp1.8:2.3": "", "snp1.8:2.4": "va → vā (bj, sya-all, km, pts-vp-pli1) ", "snp1.8:3.1": "", "snp1.8:3.2": "", "snp1.8:3.3": "", "snp1.8:3.4": "Sabbasattā → sabbe sattā (bj, sya-all, pts-vp-pli1) ", "snp1.8:4.1": "", "snp1.8:4.2": "", "snp1.8:4.3": "mahantā → ye mahantā vā (bj, pts-vp-pli1); mahanta (?) ", "snp1.8:4.4": "", "snp1.8:5.1": "adiṭṭhā → addiṭṭhā (bj, pts-vp-pli1); adiṭṭha (?) ", "snp1.8:5.2": "", "snp1.8:5.3": "Bhūtā va sambhavesī va → bhūtā vā sambhavesī vā (bj, sya-all, km, pts-vp-pli1, mr) ", "snp1.8:5.4": "", "snp1.8:6.1": "", "snp1.8:6.2": "na kañci → naṁ kañci (bj, pts-vp-pli1); naṁ kiñci (sya-all); na kiñci (mr) ", "snp1.8:6.3": "", "snp1.8:6.4": "", "snp1.8:7.1": "", "snp1.8:7.2": "", "snp1.8:7.3": "", "snp1.8:7.4": "", "snp1.8:8.1": "", "snp1.8:8.2": "", "snp1.8:8.3": "", "snp1.8:8.4": "", "snp1.8:9.1": "", "snp1.8:9.2": "vitamiddho → vigatamiddho (bahūsu) ", "snp1.8:9.3": "", "snp1.8:9.4": "", "snp1.8:10.1": "", "snp1.8:10.2": "", "snp1.8:10.3": "vinaya → vineyya (bj, sya-all, pts-vp-pli1) ", "snp1.8:10.4": "", "snp1.8:10.5": ""}, "reference_text": {"snp1.8:0.1": "", "snp1.8:0.2": "", "snp1.8:1.1": "bj25.44, cck25.287, dr25.398, mc0.362, ms18Sn_165, vnp143, vns143", "snp1.8:1.2": "", "snp1.8:1.3": "", "snp1.8:1.4": "", "snp1.8:2.1": "ms18Sn_166, vnp144, vns144", "snp1.8:2.2": "", "snp1.8:2.3": "", "snp1.8:2.4": "", "snp1.8:3.1": "csp1ed18.301, csp2ed18.301, ms18Sn_167, vnp145, vns145", "snp