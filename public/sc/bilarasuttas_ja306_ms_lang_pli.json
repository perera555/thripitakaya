{"html_text": {"ja306:0.1": "<article id='ja306'><header><ul><li class='division'>{}</li>", "ja306:0.2": "<li>{}</li>", "ja306:0.3": "<li>{}</li></ul>", "ja306:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja306:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja306:1.2": "<span class='verse-line'>{}</span>", "ja306:1.3": "<span class='verse-line'>{}</span>", "ja306:1.4": "<span class='verse-line'>{}</span></p>", "ja306:2.1": "<p><span class='verse-line'>{}</span>", "ja306:2.2": "<span class='verse-line'>{}</span>", "ja306:2.3": "<span class='verse-line'>{}</span>", "ja306:2.4": "<span class='verse-line'>{}</span></p>", "ja306:3.1": "<p><span class='verse-line'>{}</span>", "ja306:3.2": "<span class='verse-line'>{}</span>", "ja306:3.3": "<span class='verse-line'>{}</span>", "ja306:3.4": "<span class='verse-line'>{}</span></p>", "ja306:4.1": "<p><span class='verse-line'>{}</span>", "ja306:4.2": "<span class='verse-line'>{}</span>", "ja306:4.3": "<span class='verse-line'>{}</span>", "ja306:4.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja306:5.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja306:0.1": "Jātaka ", "ja306:0.2": "Catukkanipāta ", "ja306:0.3": "Kāliṅgavagga ", "ja306:0.4": "6. Sujātājātaka ", "ja306:1.1": "“Kimaṇḍakā ime deva, ", "ja306:1.2": "nikkhittā kaṁsamallake; ", "ja306:1.3": "Upalohitakā vaggū, ", "ja306:1.4": "taṁ me akkhāhi pucchito”. ", "ja306:2.1": "“Yāni pure tuvaṁ devi, ", "ja306:2.2": "bhaṇḍu nantakavāsinī; ", "ja306:2.3": "Ucchaṅgahatthā pacināsi, ", "ja306:2.4": "tassā te koliyaṁ phalaṁ. ", "ja306:3.1": "Uḍḍayhate na ramati, ", "ja306:3.2": "bhogā vippajahanti taṁ; ", "ja306:3.3": "Tatthevimaṁ paṭinetha, ", "ja306:3.4": "yattha kolaṁ pacissati”. ", "ja306:4.1": "“Honti hete mahārāja, ", "ja306:4.2": "iddhippattāya nāriyā; ", "ja306:4.3": "Khama deva sujātāya, ", "ja306:4.4": "māssā kujjha rathesabhā”ti. ", "ja306:5.1": "Sujātājātakaṁ chaṭṭhaṁ. "}, "variant_text": {"ja306:0.1": "", "ja306:0.2": "", "ja306:0.3": "", "ja306:0.4": "", "ja306:1.1": "", "ja306:1.2": "", "ja306:1.3": "", "ja306:1.4": "taṁ → te (pts-vp-pli1) ", "ja306:2.1": "", "ja306:2.2": "", "ja306:2.3": "", "ja306:2.4": "", "ja306:3.1": "", "ja306:3.2": "vippajahanti taṁ → vippajahanti'maṁ (?) ", "ja306:3.3": "", "ja306:3.4": "", "ja306:4.1": "", "ja306:4.2": "iddhippattāya → iddhimattāya (mr) ", "ja306:4.3": "", "ja306:4.4": "māssā → māsu (mr) ", "ja306:5.1": ""}, "reference_text": {"ja306:0.1": "", "ja306:0.2": "", "ja306:0.3": "", "ja306:0.4": "", "ja306:1.1": "csp1ed22.96, csp2ed22.96, ms22J_908, msdiv21, pts-vp-pli3.21", "ja306:1.2": "", "ja306:1.3": "", "ja306:1.4": "", "ja306:2.1": "ms22J_909, msdiv22, ndp22.89, pts-vp-pli3.22", "ja306:2.2": "", "ja306:2.3": "", "ja306:2.4": "", "ja306:3.1": "ms22J_910, msdiv23", "ja306:3.2": "", "ja306:3.3": "", "ja306:3.4": "", "ja306:4.1": "bj30.168, ms22J_911, msdiv24", "ja306:4.2": "", "ja306:4.3": "", "ja306:4.4": "", "ja306:5.1": "ms22J_912"}, "keys_order": ["ja306:0.1", "ja306:0.2", "ja306:0.3", "ja306:0.4", "ja306:1.1", "ja306:1.2", "ja306:1.3", "ja306:1.4", "ja306:2.1", "ja306:2.2", "ja306:2.3", "ja306:2.4", "ja306:3.1", "ja306:3.2", "ja306:3.3", "ja306:3.4", "ja306:4.1", "ja306:4.2", "ja306:4.3", "ja306:4.4", "ja306:5.1"]}