{"html_text": {"ja344:0.1": "<article id='ja344'><header><ul><li class='division'>{}</li>", "ja344:0.2": "<li>{}</li>", "ja344:0.3": "<li>{}</li></ul>", "ja344:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja344:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja344:1.2": "<span class='verse-line'>{}</span>", "ja344:1.3": "<span class='verse-line'>{}</span>", "ja344:1.4": "<span class='verse-line'>{}</span></p>", "ja344:2.1": "<p><span class='verse-line'>{}</span>", "ja344:2.2": "<span class='verse-line'>{}</span>", "ja344:2.3": "<span class='verse-line'>{}</span>", "ja344:2.4": "<span class='verse-line'>{}</span></p>", "ja344:3.1": "<p><span class='verse-line'>{}</span>", "ja344:3.2": "<span class='verse-line'>{}</span>", "ja344:3.3": "<span class='verse-line'>{}</span>", "ja344:3.4": "<span class='verse-line'>{}</span></p>", "ja344:4.1": "<p><span class='verse-line'>{}</span>", "ja344:4.2": "<span class='verse-line'>{}</span>", "ja344:4.3": "<span class='verse-line'>{}</span>", "ja344:4.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja344:5.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja344:0.1": "Jātaka ", "ja344:0.2": "Catukkanipāta ", "ja344:0.3": "Cūḷakuṇālavagga ", "ja344:0.4": "4. Ambajātaka ", "ja344:1.1": "“Yo nīliyaṁ maṇḍayati, ", "ja344:1.2": "saṇḍāsena vihaññati; ", "ja344:1.3": "Tassa sā vasamanvetu, ", "ja344:1.4": "yā te ambe avāhari”. ", "ja344:2.1": "“Vīsaṁ vā pañcavīsaṁ vā, ", "ja344:2.2": "ūnatiṁsaṁ va jātiyā; ", "ja344:2.3": "Tādisā pati mā laddhā, ", "ja344:2.4": "yā te ambe avāhari”. ", "ja344:3.1": "“Dīghaṁ gacchatu addhānaṁ, ", "ja344:3.2": "ekikā abhisārikā; ", "ja344:3.3": "Saṅkete pati mā adda, ", "ja344:3.4": "yā te ambe avāhari”. ", "ja344:4.1": "“Alaṅkatā suvasanā, ", "ja344:4.2": "mālinī candanussadā; ", "ja344:4.3": "Ekikā sayane setu, ", "ja344:4.4": "yā te ambe avāharī”ti. ", "ja344:5.1": "Ambajātakaṁ catutthaṁ. "}, "variant_text": {"ja344:0.1": "", "ja344:0.2": "", "ja344:0.3": "", "ja344:0.4": "", "ja344:1.1": "", "ja344:1.2": "", "ja344:1.3": "", "ja344:1.4": "", "ja344:2.1": "pañcavīsaṁ → paṇṇu vīsaṁ (si, pts-vp-pli1) ", "ja344:2.2": "", "ja344:2.3": "pati mā laddhā → patiṁ mā laddhā (pts-vp-pli1); pati mā'lattha (?) ", "ja344:2.4": "", "ja344:3.1": "", "ja344:3.2": "", "ja344:3.3": "pati mā adda → māddasa (bj, sya1ed, sya2ed); mā addasa (pts-vp-pli1) ", "ja344:3.4": "", "ja344:4.1": "", "ja344:4.2": "", "ja344:4.3": "", "ja344:4.4": "", "ja344:5.1": "Ambajātakaṁ → ambacorajātakaṁ (bj, pts-vp-pli1) "}, "reference_text": {"ja344:0.1": "", "ja344:0.2": "", "ja344:0.3": "", "ja344:0.4": "", "ja344:1.1": "dr27.159, ms22J_1106, msdiv173, pts-vp-pli3.138, vri68.99", "ja344:1.2": "", "ja344:1.3": "", "ja344:1.4": "", "ja344:2.1": "ms22J_1107, msdiv174, sya27.159", "ja344:2.2": "", "ja344:2.3": "", "ja344:2.4": "", "ja344:3.1": "csp1ed22.116, csp2ed22.116, ms22J_1108, msdiv175, pts-vp-pli3.139", "ja344:3.2": "", "ja344:3.3": "", "ja344:3.4": "", "ja344:4.1": "ms22J_1109, msdiv176", "ja344:4.2": "", "ja344:4.3": "", "ja344:4.4": "", "ja344:5.1": "ms22J_1110"}, "keys_order": ["ja344:0.1", "ja344:0.2", "ja344:0.3", "ja344:0.4", "ja344:1.1", "ja344:1.2", "ja344:1.3", "ja344:1.4", "ja344:2.1", "ja344:2.2", "ja344:2.3", "ja344:2.4", "ja344:3.1", "ja344:3.2", "ja344:3.3", "ja344:3.4", "ja344:4.1", "ja344:4.2", "ja344:4.3", "ja344:4.4", "ja344:5.1"]}