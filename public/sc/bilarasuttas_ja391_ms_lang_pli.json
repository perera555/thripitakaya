{"html_text": {"ja391:0.1": "<article id='ja391'><header><ul><li class='division'>{}</li>", "ja391:0.2": "<li>{}</li>", "ja391:0.3": "<li>{}</li></ul>", "ja391:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja391:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja391:1.2": "<span class='verse-line'>{}</span>", "ja391:1.3": "<span class='verse-line'>{}</span>", "ja391:1.4": "<span class='verse-line'>{}</span></p>", "ja391:2.1": "<p><span class='verse-line'>{}</span>", "ja391:2.2": "<span class='verse-line'>{}</span>", "ja391:2.3": "<span class='verse-line'>{}</span>", "ja391:2.4": "<span class='verse-line'>{}</span></p>", "ja391:3.1": "<p><span class='verse-line'>{}</span>", "ja391:3.2": "<span class='verse-line'>{}</span>", "ja391:3.3": "<span class='verse-line'>{}</span>", "ja391:3.4": "<span class='verse-line'>{}</span></p>", "ja391:4.1": "<p><span class='verse-line'>{}</span>", "ja391:4.2": "<span class='verse-line'>{}</span>", "ja391:4.3": "<span class='verse-line'>{}</span>", "ja391:4.4": "<span class='verse-line'>{}</span></p>", "ja391:5.1": "<p><span class='verse-line'>{}</span>", "ja391:5.2": "<span class='verse-line'>{}</span>", "ja391:5.3": "<span class='verse-line'>{}</span>", "ja391:5.4": "<span class='verse-line'>{}</span></p>", "ja391:6.1": "<p><span class='verse-line'>{}</span>", "ja391:6.2": "<span class='verse-line'>{}</span>", "ja391:6.3": "<span class='verse-line'>{}</span>", "ja391:6.4": "<span class='verse-line'>{}</span></p>", "ja391:7.1": "<p><span class='verse-line'>{}</span>", "ja391:7.2": "<span class='verse-line'>{}</span>", "ja391:7.3": "<span class='verse-line'>{}</span>", "ja391:7.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja391:8.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja391:0.1": "Jātaka ", "ja391:0.2": "Chakkanipāta ", "ja391:0.3": "Kharaputtavagga ", "ja391:0.4": "6. Vijjādharajātaka ", "ja391:1.1": "“Dubbaṇṇarūpaṁ tuvamariyavaṇṇī, ", "ja391:1.2": "Purakkhatvā pañjaliko namassasi; ", "ja391:1.3": "Seyyo nu te so udavā sarikkho, ", "ja391:1.4": "Nāmaṁ parassattano cāpi brūhi”. ", "ja391:2.1": "“Na nāmagottaṁ gaṇhanti rāja, ", "ja391:2.2": "Sammaggatānujjugatāna devā; ", "ja391:2.3": "Ahañca te nāmadheyyaṁ vadāmi, ", "ja391:2.4": "Sakkohamasmī tidasānamindo”. ", "ja391:3.1": "“Yo disvā bhikkhuṁ caraṇūpapannaṁ, ", "ja391:3.2": "Purakkhatvā pañjaliko namassati; ", "ja391:3.3": "Pucchāmi taṁ devarājetamatthaṁ, ", "ja391:3.4": "Ito cuto kiṁ labhate sukhaṁ so”. ", "ja391:4.1": "“Yo disvā bhikkhuṁ caraṇūpapannaṁ, ", "ja391:4.2": "Purakkhatvā pañjaliko namassati; ", "ja391:4.3": "Diṭṭheva dhamme labhate pasaṁsaṁ, ", "ja391:4.4": "Saggañca so yāti sarīrabhedā”. ", "ja391:5.1": "“Lakkhī vata me udapādi ajja, ", "ja391:5.2": "Yaṁ vāsavaṁ bhūtapatiddasāma; ", "ja391:5.3": "Bhikkhuñca disvāna tuvañca sakka, ", "ja391:5.4": "Kāhāmi puññāni anappakāni”. ", "ja391:6.1": "“Addhā have sevitabbā sapaññā, ", "ja391:6.2": "Bahussutā ye bahuṭhānacintino; ", "ja391:6.3": "Bhikkhuñca disvāna mamañca rāja, ", "ja391:6.4": "Karohi puññāni anappakāni”. ", "ja391:7.1": "“Akkodhano niccapasannacitto, ", "ja391:7.2": "Sabbātithīyācayogo bhavitvā; ", "ja391:7.3": "Nihacca mānaṁ abhivādayissaṁ, ", "ja391:7.4": "Sutvāna devinda subhāsitānī”ti. ", "ja391:8.1": "Vijjādharajātakaṁ chaṭṭhaṁ. "}, "variant_text": {"ja391:0.1": "", "ja391:0.2": "", "ja391:0.3": "", "ja391:0.4": "", "ja391:1.1": "", "ja391:1.2": "Purakkhatvā → purakkhitvā (sya1ed, sya2ed, mr) ", "ja391:1.3": "udavā → udāhu (sya1ed, sya2ed, mr) ", "ja391:1.4": "", "ja391:2.1": "", "ja391:2.2": "Sammaggatānujjugatāna → samaggatānujjugatāna (sya1ed, sya2ed); samuggatānujjugatāna (mr) ", "ja391:2.3": "", "ja391:2.4": "", "ja391:3.1": "", "ja391:3.2": "", "ja391:3.3": "", "ja391:3.4": "", "ja391:4.1": "", "ja391:4.2": "", "ja391:4.3": "", "ja391:4.4": "", "ja391:5.1": "", "ja391:5.2": "", "ja391:5.3": "", "ja391:5.4": "", "ja391:6.1": "", "ja391:6.2": "", "ja391:6.3": "", "ja391:6.4": "", "ja391:7.1": "", "ja391:7.2": "", "ja391:7.3": "", "ja391:7.4": "", "ja391:8.1": "Vijjādharajātakaṁ → dhajaviheṭhajātakaṁ (bj, pts-vp-pli1); pabbajitaviheṭhakajātakaṁ (sya1ed, sya2ed) "}, "reference_text": {"ja391:0.1": "", "ja391:0.2": "", "ja391:0.3": "", "ja391:0.4": "", "ja391:1.1": "ms22J_1443, msdiv109, pts-vp-pli3.305", "ja391:1.2": "", "ja391:1.3": "", "ja391:1.4": "", "ja391:2.1": "csp1ed22.151, csp2ed22.151, ms22J_1444, msdiv110, ndp22.142", "ja391:2.2": "", "ja391:2.3": "", "ja391:2.4": "", "ja391:3.1": "dr27.205, ms22J_1445, msdiv111, pts-vp-pli3.306, sya27.206, vri68.126", "ja391:3.2": "", "ja391:3.3": "", "ja391:3.4": "", "ja391:4.1": "ms22J_1446, msdiv112", "ja391:4.2": "", "ja391:4.3": "", "ja391:4.4": "", "ja391:5.1": "bj30.258, ms22J_1447, msdiv113", "ja391:5.2": "", "ja391:5.3": "", "ja391:5.4": "", "ja391:6.1": "ms22J_1448, msdiv114", "ja391:6.2": "", "ja391:6.3": "", "ja391:6.4": "", "ja391:7.1": "ms22J_1449, msdiv115, pts-vp-pli3.307", "ja391:7.2": "", "ja391:7.3": "", "ja391:7.4": "", "ja391:8.1": "ms22J_1450"}, "keys_order": ["ja391:0.1", "ja391:0.2", "ja391:0.3", "ja391:0.4", "ja391:1.1", "ja391:1.2", "ja391:1.3", "ja391:1.4", "ja391:2.1", "ja391:2.2", "ja391:2.3", "ja391:2.4", "ja391:3.1", "ja391:3.2", "ja391:3.3", "ja391:3.4", "ja391:4.1", "ja391:4.2", "ja391:4.3", "ja391:4.4", "ja391:5.1", "ja391:5.2", "ja391:5.3", "ja391:5.4", "ja391:6.1", "ja391:6.2", "ja391:6.3", "ja391:6.4", "ja391:7.1", "ja391:7.2", "ja391:7.3", "ja391:7.4", "ja391:8.1"]}