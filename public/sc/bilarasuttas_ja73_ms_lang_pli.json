{"html_text": {"ja73:0.1": "<article id='ja73'><header><ul><li class='division'>{}</li>", "ja73:0.2": "<li>{}</li>", "ja73:0.3": "<li>{}</li></ul>", "ja73:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja73:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja73:1.2": "<span class='verse-line'>{}</span>", "ja73:1.3": "<span class='verse-line'>{}</span>", "ja73:1.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja73:2.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja73:0.1": "Jātaka ", "ja73:0.2": "Ekakanipāta ", "ja73:0.3": "Varuṇavagga ", "ja73:0.4": "3. Saccaṅkirajātaka ", "ja73:1.1": "“Saccaṁ kirevamāhaṁsu, ", "ja73:1.2": "narā ekacciyā idha; ", "ja73:1.3": "Kaṭṭhaṁ niplavitaṁ seyyo, ", "ja73:1.4": "na tvevekacciyo naro”ti. ", "ja73:2.1": "Saccaṅkirajātakaṁ tatiyaṁ. "}, "variant_text": {"ja73:0.1": "", "ja73:0.2": "", "ja73:0.3": "", "ja73:0.4": "", "ja73:1.1": "", "ja73:1.2": "", "ja73:1.3": "Kaṭṭhaṁ niplavitaṁ → kaṭṭhaṁ viplāvitaṁ (bj); kaṭṭhaṁ nipphavitaṁ (sya1ed, sya2ed); kaṭṭhavipalā (pts-vp-pli1) ", "ja73:1.4": "", "ja73:2.1": ""}, "reference_text": {"ja73:0.1": "", "ja73:0.2": "", "ja73:0.3": "", "ja73:0.4": "", "ja73:1.1": "ms22J_161, msdiv73, pts-vp-pli1.326", "ja73:1.2": "", "ja73:1.3": "", "ja73:1.4": "", "ja73:2.1": "ms22J_162"}, "keys_order": ["ja73:0.1", "ja73:0.2", "ja73:0.3", "ja73:0.4", "ja73:1.1", "ja73:1.2", "ja73:1.3", "ja73:1.4", "ja73:2.1"]}