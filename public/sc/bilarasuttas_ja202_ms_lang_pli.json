{"html_text": {"ja202:0.1": "<article id='ja202'><header><ul><li class='division'>{}</li>", "ja202:0.2": "<li>{}</li>", "ja202:0.3": "<li>{}</li></ul>", "ja202:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja202:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja202:1.2": "<span class='verse-line'>{}</span>", "ja202:1.3": "<span class='verse-line'>{}</span>", "ja202:1.4": "<span class='verse-line'>{}</span></p>", "ja202:2.1": "<p><span class='verse-line'>{}</span>", "ja202:2.2": "<span class='verse-line'>{}</span>", "ja202:2.3": "<span class='verse-line'>{}</span>", "ja202:2.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja202:3.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja202:0.1": "Jātaka ", "ja202:0.2": "Dukanipāta ", "ja202:0.3": "Nataṁdaḷhavagga ", "ja202:0.4": "2. Keḷisīlajātaka ", "ja202:1.1": "“Haṁsā koñcā mayūrā ca, ", "ja202:1.2": "hatthayo pasadā migā; ", "ja202:1.3": "Sabbe sīhassa bhāyanti, ", "ja202:1.4": "natthi kāyasmi tulyatā. ", "ja202:2.1": "Evameva manussesu, ", "ja202:2.2": "daharo cepi paññavā; ", "ja202:2.3": "So hi tattha mahā hoti, ", "ja202:2.4": "neva bālo sarīravā”ti. ", "ja202:3.1": "Keḷisīlajātakaṁ dutiyaṁ. "}, "variant_text": {"ja202:0.1": "", "ja202:0.2": "", "ja202:0.3": "", "ja202:0.4": "", "ja202:1.1": "", "ja202:1.2": "hatthayo → hatthiyo (bj, sya1ed, sya2ed, pts-vp-pli1) ", "ja202:1.3": "", "ja202:1.4": "", "ja202:2.1": "", "ja202:2.2": "", "ja202:2.3": "", "ja202:2.4": "", "ja202:3.1": ""}, "reference_text": {"ja202:0.1": "", "ja202:0.2": "", "ja202:0.3": "", "ja202:0.4": "", "ja202:1.1": "ms22J_505, msdiv103, ndp22.50, pts-vp-pli2.144", "ja202:1.2": "", "ja202:1.3": "", "ja202:1.4": "", "ja202:2.1": "ms22J_506, msdiv104", "ja202:2.2": "", "ja202:2.3": "", "ja202:2.4": "", "ja202:3.1": "ms22J_507"}, "keys_order": ["ja202:0.1", "ja202:0.2", "ja202:0.3", "ja202:0.4", "ja202:1.1", "ja202:1.2", "ja202:1.3", "ja202:1.4", "ja202:2.1", "ja202:2.2", "ja202:2.3", "ja202:2.4", "j