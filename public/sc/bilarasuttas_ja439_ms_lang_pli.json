{"html_text": {"ja439:0.1": "<article id='ja439'><header><ul><li class='division'>{}</li>", "ja439:0.2": "<li>{}</li>", "ja439:0.3": "<li>{}</li></ul>", "ja439:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja439:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja439:1.2": "<span class='verse-line'>{}</span>", "ja439:1.3": "<span class='verse-line'>{}</span>", "ja439:1.4": "<span class='verse-line'>{}</span></p>", "ja439:2.1": "<p><span class='verse-line'>{}</span>", "ja439:2.2": "<span class='verse-line'>{}</span>", "ja439:2.3": "<span class='verse-line'>{}</span>", "ja439:2.4": "<span class='verse-line'>{}</span></p>", "ja439:3.1": "<p><span class='verse-line'>{}</span>", "ja439:3.2": "<span class='verse-line'>{}</span>", "ja439:3.3": "<span class='verse-line'>{}</span>", "ja439:3.4": "<span class='verse-line'>{}</span></p>", "ja439:4.1": "<p><span class='verse-line'>{}</span>", "ja439:4.2": "<span class='verse-line'>{}</span>", "ja439:4.3": "<span class='verse-line'>{}</span>", "ja439:4.4": "<span class='verse-line'>{}</span></p>", "ja439:5.1": "<p><span class='verse-line'>{}</span>", "ja439:5.2": "<span class='verse-line'>{}</span>", "ja439:5.3": "<span class='verse-line'>{}</span>", "ja439:5.4": "<span class='verse-line'>{}</span></p>", "ja439:6.1": "<p><span class='verse-line'>{}</span>", "ja439:6.2": "<span class='verse-line'>{}</span>", "ja439:6.3": "<span class='verse-line'>{}</span>", "ja439:6.4": "<span class='verse-line'>{}</span></p>", "ja439:7.1": "<p><span class='verse-line'>{}</span>", "ja439:7.2": "<span class='verse-line'>{}</span>", "ja439:7.3": "<span class='verse-line'>{}</span>", "ja439:7.4": "<span class='verse-line'>{}</span></p>", "ja439:8.1": "<p><span class='verse-line'>{}</span>", "ja439:8.2": "<span class='verse-line'>{}</span>", "ja439:8.3": "<span class='verse-line'>{}</span>", "ja439:8.4": "<span class='verse-line'>{}</span></p>", "ja439:9.1": "<p><span class='verse-line'>{}</span>", "ja439:9.2": "<span class='verse-line'>{}</span>", "ja439:9.3": "<span class='verse-line'>{}</span>", "ja439:9.4": "<span class='verse-line'>{}</span></p>", "ja439:10.1": "<p><span class='verse-line'>{}</span>", "ja439:10.2": "<span class='verse-line'>{}</span>", "ja439:10.3": "<span class='verse-line'>{}</span>", "ja439:10.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja439:11.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja439:0.1": "Jātaka ", "ja439:0.2": "Dasakanipāta ", "ja439:0.3": "Catudvāravagga ", "ja439:0.4": "1. Catudvārajātaka ", "ja439:1.1": "“Catudvāramidaṁ nagaraṁ, ", "ja439:1.2": "āyasaṁ daḷhapākāraṁ; ", "ja439:1.3": "Oruddhapaṭiruddhosmi, ", "ja439:1.4": "kiṁ pāpaṁ pakataṁ mayā”. ", "ja439:2.1": "“Sabbe apihitā dvārā, ", "ja439:2.2": "oruddhosmi yathā dijo; ", "ja439:2.3": "Kimādhikaraṇaṁ yakkha, ", "ja439:2.4": "cakkābhinihato ahaṁ. ", "ja439:3.1": "Laddhā satasahassāni, ", "ja439:3.2": "atirekāni vīsati; ", "ja439:3.3": "Anukampakānaṁ ñātīnaṁ, ", "ja439:3.4": "vacanaṁ samma nākari. ", "ja439:4.1": "Laṅghiṁ samuddaṁ pakkhandi, ", "ja439:4.2": "sāgaraṁ appasiddhikaṁ; ", "ja439:4.3": "Catubbhi aṭṭhajjhagamā, ", "ja439:4.4": "aṭṭhāhipi ca soḷasa. ", "ja439:5.1": "Soḷasāhi ca bāttiṁsa, ", "ja439:5.2": "atricchaṁ cakkamāsado; ", "ja439:5.3": "Icchāhatassa posassa, ", "ja439:5.4": "cakkaṁ bhamati matthake. ", "ja439:6.1": "Uparivisālā duppūrā, ", "ja439:6.2": "icchā visaṭagāminī; ", "ja439:6.3": "Ye ca taṁ anugijjhanti, ", "ja439:6.4": "te honti cakkadhārino. ", "ja439:7.1": "Bahubhaṇḍaṁ avahāya, ", "ja439:7.2": "maggaṁ appaṭivekkhiya; ", "ja439:7.3": "Yesañcetaṁ asaṅkhātaṁ, ", "ja439:7.4": "te honti cakkadhārino. ", "ja439:8.1": "Kammaṁ samekkhe vipulañca bhogaṁ, ", "ja439:8.2": "Icchaṁ na seveyya anatthasaṁhitaṁ; ", "ja439:8.3": "Kareyya vākyaṁ anukampakānaṁ, ", "ja439:8.4": "Taṁ tādisaṁ nātivatteyya cakkaṁ”. ", "ja439:9.1": "“Kīvaciraṁ nu me yakkha, ", "ja439:9.2": "cakkaṁ sirasi ṭhassati; ", "ja439:9.3": "Kati vassasahassāni, ", "ja439:9.4": "taṁ me akkhāhi pucchito”. ", "ja439:10.1": "“Atisaro paccasaro, ", "ja439:10.2": "mittavinda suṇohi me; ", "ja439:10.3": "Cakkaṁ te sirasi māviddhaṁ, ", "ja439:10.4": "na taṁ jīvaṁ pamokkhasī”ti. ", "ja439:11.1": "Catudvārajātakaṁ paṭhamaṁ. "}, "variant_text": {"ja439:0.1": "", "ja439:0.2": "", "ja439:0.3": "", "ja439:0.4": "", "ja439:1.1": "", "ja439:1.2": "", "ja439:1.3": "", "ja439:1.4": "", "ja439:2.1": "", "ja439:2.2": "", "ja439:2.3": "", "ja439:2.4": "", "ja439:3.1": "", "ja439:3.2": "", "ja439:3.3": "", "ja439:3.4": "", "ja439:4.1": "", "ja439:4.2": "", "ja439:4.3": "", "ja439:4.4": "", "ja439:5.1": "", "ja439:5.2": "", "ja439:5.3": "", "ja439:5.4": "", "ja439:6.1": "", "ja439:6.2": "visaṭagāminī → visatagāminaṁ (sya1ed, sya2ed); visaṭagāminiṁ (pts-vp-pli1, mr) ", "ja439:6.3": "", "ja439:6.4": "", "ja439:7.1": "Bahubhaṇḍaṁ → bahuṁ bhaṇḍaṁ (bj, pts-vp-pli1) ", "ja439:7.2": "", "ja439:7.3": "", "ja439:7.4": "", "ja439:8.1": "", "ja439:8.2": "", "ja439:8.3": "", "ja439:8.4": "", "ja439:9.1": "", "ja439:9.2": "sirasi → sira (bj); sirasmi (sya1ed, sya2ed) ", "ja439:9.3": "", "ja439:9.4": "", "ja439:10.1": "paccasaro → accasaro (bj, sya1ed, sya2ed, pts-vp-pli1) ", "ja439:10.2": "", "ja439:10.3": "", "ja439:10.4": "", "ja439:11.1": ""}, "reference_text": {"ja439:0.1": "", "ja439:0.2": "", "ja439:0.3": "", "ja439:0.4": "", "ja439:1.1": "bj30.348, csp1ed22.201, csp2ed22.201, dr27.270, ms22J_1909, msdiv1, ndp22.193, pts-vp-pli4.4, sya27.271, vri68.163", "ja439:1.2": "", "ja439:1.3": "", "ja439:1.4": "", "ja439:2.1": "ms22J_1910, msdiv2", "ja439:2.2": "", "ja439:2.3": "", "ja439:2.4": "", "ja439:3.1": "ms22J_1911, msdiv3", "ja439:3.2": "", "ja439:3.3": "", "ja439:3.4": "", "ja439:4.1": "ms22J_1912, msdiv4", "ja439:4.2": "", "ja439:4.3": "", "ja439:4.4": "", "ja439:5.1": "ms22J_1913, msdiv5", "ja439:5.2": "", "ja439:5.3": "", "ja439:5.4": "", "ja439:6.1": "ms22J_1914, msdiv6", "ja439:6.2": "", "ja439:6.3": "", "ja439:6.4": "", "ja439:7.1": "ms22J_1915, msdiv7", "ja439:7.