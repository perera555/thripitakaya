{"html_text": {"ja187:0.1": "<article id='ja187'><header><ul><li class='division'>{}</li>", "ja187:0.2": "<li>{}</li>", "ja187:0.3": "<li>{}</li></ul>", "ja187:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja187:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja187:1.2": "<span class='verse-line'>{}</span>", "ja187:1.3": "<span class='verse-line'>{}</span>", "ja187:1.4": "<span class='verse-line'>{}</span></p>", "ja187:2.1": "<p><span class='verse-line'>{}</span>", "ja187:2.2": "<span class='verse-line'>{}</span>", "ja187:2.3": "<span class='verse-line'>{}</span>", "ja187:2.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja187:3.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja187:0.1": "Jātaka ", "ja187:0.2": "Dukanipāta ", "ja187:0.3": "Asadisavagga ", "ja187:0.4": "7. Catumaṭṭhajātaka ", "ja187:1.1": "“Ucce viṭabhimāruyha, ", "ja187:1.2": "mantayavho rahogatā; ", "ja187:1.3": "Nīce oruyha mantavho, ", "ja187:1.4": "migarājāpi sossati. ", "ja187:2.1": "Yaṁ suvaṇṇo suvaṇṇena, ", "ja187:2.2": "devo devena mantaye; ", "ja187:2.3": "Kiṁ tettha catumaṭṭhassa, ", "ja187:2.4": "bilaṁ pavisa jambukā”ti. ", "ja187:3.1": "Catumaṭṭhajātakaṁ sattamaṁ. "}, "variant_text": {"ja187:0.1": "", "ja187:0.2": "", "ja187:0.3": "", "ja187:0.4": "", "ja187:1.1": "", "ja187:1.2": "", "ja187:1.3": "", "ja187:1.4": "", "ja187:2.1": "Yaṁ suvaṇṇo suvaṇṇena → yaṁ supaṇṇo supaṇṇena (bj, sya1ed, sya2ed, pts-vp-pli1) ", "ja187:2.2": "", "ja187:2.3": "", "ja187:2.4": "", "ja187:3.1": "Catumaṭṭhajātakaṁ → catumaṭṭajātakaṁ (pts-vp-pli1) "}, "reference_text": {"ja187:0.1": "", "ja187:0.2": "", "ja187:0.3": "", "ja187:0.4": "", "ja187:1.1": "ms22J_456, msdiv73, pts-vp-pli2.107", "ja187:1.2": "", "ja187:1.3": "", "ja187:1.4": "", "ja187:2.1": "ms22J_457, msdiv74", "ja187:2.2": "", "ja187:2.3": "", "ja187:2.4": "", "ja187:3.1": "ms22J_458"}, "keys_order": ["ja187:0.1", "ja187:0.2", "ja187:0.3", "ja187:0.4", "ja187:1.1", "ja187:1.2", "ja187:1.3", "