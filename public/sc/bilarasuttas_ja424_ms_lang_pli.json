{"html_text": {"ja424:0.1": "<article id='ja424'><header><ul><li class='division'>{}</li>", "ja424:0.2": "<li>{}</li>", "ja424:0.3": "<li>{}</li></ul>", "ja424:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja424:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja424:1.2": "<span class='verse-line'>{}</span>", "ja424:1.3": "<span class='verse-line'>{}</span>", "ja424:1.4": "<span class='verse-line'>{}</span></p>", "ja424:2.1": "<p><span class='verse-line'>{}</span>", "ja424:2.2": "<span class='verse-line'>{}</span>", "ja424:2.3": "<span class='verse-line'>{}</span>", "ja424:2.4": "<span class='verse-line'>{}</span></p>", "ja424:3.1": "<p><span class='verse-line'>{}</span>", "ja424:3.2": "<span class='verse-line'>{}</span>", "ja424:3.3": "<span class='verse-line'>{}</span>", "ja424:3.4": "<span class='verse-line'>{}</span></p>", "ja424:4.1": "<p><span class='verse-line'>{}</span>", "ja424:4.2": "<span class='verse-line'>{}</span>", "ja424:4.3": "<span class='verse-line'>{}</span>", "ja424:4.4": "<span class='verse-line'>{}</span></p>", "ja424:5.1": "<p><span class='verse-line'>{}</span>", "ja424:5.2": "<span class='verse-line'>{}</span>", "ja424:5.3": "<span class='verse-line'>{}</span>", "ja424:5.4": "<span class='verse-line'>{}</span></p>", "ja424:6.1": "<p><span class='verse-line'>{}</span>", "ja424:6.2": "<span class='verse-line'>{}</span>", "ja424:6.3": "<span class='verse-line'>{}</span>", "ja424:6.4": "<span class='verse-line'>{}</span></p>", "ja424:7.1": "<p><span class='verse-line'>{}</span>", "ja424:7.2": "<span class='verse-line'>{}</span>", "ja424:7.3": "<span class='verse-line'>{}</span>", "ja424:7.4": "<span class='verse-line'>{}</span></p>", "ja424:8.1": "<p><span class='verse-line'>{}</span>", "ja424:8.2": "<span class='verse-line'>{}</span>", "ja424:8.3": "<span class='verse-line'>{}</span>", "ja424:8.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja424:9.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja424:0.1": "Jātaka ", "ja424:0.2": "Aṭṭhakanipāta ", "ja424:0.3": "Kaccānivagga ", "ja424:0.4": "8. Ādittajātaka ", "ja424:1.1": "“Ādittasmiṁ agārasmiṁ, ", "ja424:1.2": "yaṁ nīharati bhājanaṁ; ", "ja424:1.3": "Taṁ tassa hoti atthāya, ", "ja424:1.4": "no ca yaṁ tattha ḍayhati. ", "ja424:2.1": "Evamādīpito loko, ", "ja424:2.2": "jarāya maraṇena ca; ", "ja424:2.3": "Nīharetheva dānena, ", "ja424:2.4": "dinnaṁ hoti sunīhataṁ”. ", "ja424:3.1": "“Yo dhammaladdhassa dadāti dānaṁ, ", "ja424:3.2": "Uṭṭhānaviriyādhigatassa jantu; ", "ja424:3.3": "Atikkamma so vetaraṇiṁ yamassa, ", "ja424:3.4": "Dibbāni ṭhānāni upeti macco. ", "ja424:4.1": "Dānañca yuddhañca samānamāhu, ", "ja424:4.2": "Appāpi santā bahuke jinanti; ", "ja424:4.3": "Appampi ce saddahāno dadāti, ", "ja424:4.4": "Teneva so hoti sukhī parattha. ", "ja424:5.1": "Viceyya dānaṁ sugatappasatthaṁ, ", "ja424:5.2": "Ye dakkhiṇeyyā idha jīvaloke; ", "ja424:5.3": "Etesu dinnāni mahapphalāni, ", "ja424:5.4": "Bījāni vuttāni yathā sukhette. ", "ja424:6.1": "Yo pāṇabhūtāni aheṭhayaṁ caraṁ, ", "ja424:6.2": "Parūpavādā na karoti pāpaṁ; ", "ja424:6.3": "Bhīruṁ pasaṁsanti na tattha sūraṁ, ", "ja424:6.4": "Bhayā hi santo na karonti pāpaṁ. ", "ja424:7.1": "Hīnena brahmacariyena, ", "ja424:7.2": "khattiye upapajjati; ", "ja424:7.3": "Majjhimena ca devattaṁ, ", "ja424:7.4": "uttamena visujjhati. ", "ja424:8.1": "Addhā hi dānaṁ bahudhā pasatthaṁ, ", "ja424:8.2": "Dānā ca kho dhammapadaṁva seyyo; ", "ja424:8.3": "Pubbeva hi pubbatareva santo, ", "ja424:8.4": "Nibbānamevajjhagamuṁ sapaññā”ti. ", "ja424:9.1": "Ādittajātakaṁ aṭṭhamaṁ. "}, "variant_text": {"ja424:0.1": "", "ja424:0.2": "", "ja424:0.3": "", "ja424:0.4": "", "ja424:1.1": "", "ja424:1.2": "", "ja424:1.3": "", "ja424:1.4": "", "ja424:2.1": "", "ja424:2.2": "", "ja424:2.3": "", "ja424:2.4": "sunīhataṁ → sunībhataṁ (bj, sya1ed, sya2ed); nībhataṁ (pts-vp-pli1); sunibbhataṁ (mr) ", "ja424:3.1": "", "ja424:3.2": "", "ja424:3.3": "vetaraṇiṁ → vettaraṇiṁ (mr) ", "ja424:3.4": "", "ja424:4.1": "", "ja424:4.2": "", "ja424:4.3": "", "ja424:4.4": "", "ja424:5.1": "", "ja424:5.2": "", "ja424:5.3": "", "ja424:5.4": "", "ja424:6.1": "", "ja424:6.2": "", "ja424:6.3": "", "ja424:6.4": "", "ja424:7.1": "", "ja424:7.2": "", "ja424:7.3": "", "ja424:7.4": "", "ja424:8.1": "", "ja424:8.2": "", "ja424:8.3": "Pubbeva hi pubbatareva santo → pubbe ca hi pubbatare ca santo (sn1.33:1 [33. Sādhusutta]) ", "ja424:8.4": "", "ja424:9.1": ""}, "reference_text": {"ja424:0.1": "", "ja424:0.2": "", "ja424:0.3": "", "ja424:0.4": "", "ja424:1.1": "ms22J_1748, msdiv69, pts-vp-pli3.471, sya27.249", "ja424:1.2": "", "ja424:1.3": "", "ja424:1.4": "", "ja424:2.1": "dr27.248, ms22J_1749, msdiv70, vri68.150", "ja424:2.2": "", "ja424:2.3": "", "ja424:2.4": "", "ja424:3.1": "ms22J_1750, msdiv71, pts-vp-pli3.472", "ja424:3.2": "", "ja424:3.3": "", "ja424:3.4": "", "ja424:4.1": "ms22J_1751, msdiv72, ndp22.176", "ja424:4.2": "", "ja424:4.3": "", "ja424:4.4": "", "ja424:5.1": "bj30.318, ms22J_1752, msdiv73", "ja424:5.2": "", "ja424:5.3": "", "ja424:5.4": "", "ja424:6.1": "ms22J_1753, msdiv74", "ja424:6.2": "", "ja424:6.3": "", "ja424:6.4": "", "ja424:7.1": "ms22J_1754, msdiv75, sya27.250", "ja424:7.2": "", "ja424:7.3": "", "ja424:7.4": "", "ja424:8.1": "csp1ed22.184, csp2ed22.184, dr27.249, ms22J_1755, msdiv76, pts-vp-pli3.473", "ja424:8.2": "", "ja424:8.3": "", "ja424:8.4": "", "ja424:9.1": "ms22J_1756"}, "keys_order": ["ja424:0.1", "ja424:0.2", "ja424:0.3", "ja424:0.4", "ja424:1.1", "ja424:1.2", "ja424:1.3", "ja424:1.4", "ja424:2.1", "ja424:2.2", "ja424:2.3", "ja424:2.4", "ja424:3.1", "ja424:3.2", "ja424:3.3", "ja424:3.4", "ja424:4.1", "ja424:4.2", "ja424:4.3", "ja424:4.4", "ja424:5.1", "ja424:5.2", "ja424:5.3", "ja424:5.4", "ja424:6.1", "ja424:6.2", "ja424:6.3", "ja424:6.4", "ja424:7.1", "ja424:7.2", "ja424:7.3", "ja424:7.4", "ja424:8.1", "ja424:8.2", "ja424:8.3", "ja424:8.4", "ja424:9.1"]}