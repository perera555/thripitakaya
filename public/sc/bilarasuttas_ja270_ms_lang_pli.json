{"html_text": {"ja270:0.1": "<article id='ja270'><header><ul><li class='division'>{}</li>", "ja270:0.2": "<li>{}</li>", "ja270:0.3": "<li>{}</li></ul>", "ja270:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja270:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja270:1.2": "<span class='verse-line'>{}</span>", "ja270:1.3": "<span class='verse-line'>{}</span>", "ja270:1.4": "<span class='verse-line'>{}</span></p>", "ja270:2.1": "<p><span class='verse-line'>{}</span>", "ja270:2.2": "<span class='verse-line'>{}</span>", "ja270:2.3": "<span class='verse-line'>{}</span>", "ja270:2.4": "<span class='verse-line'>{}</span></p>", "ja270:3.1": "<p><span class='verse-line'>{}</span>", "ja270:3.2": "<span class='verse-line'>{}</span>", "ja270:3.3": "<span class='verse-line'>{}</span>", "ja270:3.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja270:4.1": "<p class='endsutta'>{}</p>", "ja270:4.2": "<p class='endvagga'>{}</p>", "ja270:5.1": "<p class='uddana-intro'>{}</p>", "ja270:6.1": "<blockquote class='uddanagatha'><p><span class='verse-line'>{}</span>", "ja270:6.2": "<span class='verse-line'>{}</span>", "ja270:6.3": "<span class='verse-line'>{}</span>", "ja270:6.4": "<span class='verse-line'>{}</span></p></blockquote></article>"}, "root_text": {"ja270:0.1": "Jātaka ", "ja270:0.2": "Tikanipāta ", "ja270:0.3": "Padumavagga ", "ja270:0.4": "10. Ulūkajātaka ", "ja270:1.1": "“Sabbehi kira ñātīhi, ", "ja270:1.2": "kosiyo issaro kato; ", "ja270:1.3": "Sace ñātīhi anuññāto, ", "ja270:1.4": "bhaṇeyyāhaṁ ekavācikaṁ”. ", "ja270:2.1": "“Bhaṇa samma anuññāto, ", "ja270:2.2": "atthaṁ dhammañca kevalaṁ; ", "ja270:2.3": "Santi hi daharā pakkhī, ", "ja270:2.4": "paññavanto jutindharā”. ", "ja270:3.1": "“Na me ruccati bhaddaṁ vo, ", "ja270:3.2": "ulūkassābhisecanaṁ; ", "ja270:3.3": "Akkuddhassa mukhaṁ passa, ", "ja270:3.4": "kathaṁ kuddho karissatī”ti. ", "ja270:4.1": "Ulūkajātakaṁ dasamaṁ. ", "ja270:4.2": "Padumavaggo dutiyo. ", "ja270:5.1": "Tassuddānaṁ ", "ja270:6.1": "Padumuttama nāgasirivhayano, ", "ja270:6.2": "Sa-mahaṇṇava yūpa khurappavaro; ", "ja270:6.3": "Atha bhaddalī kuñjara rukkha puna, ", "ja270:6.4": "Kharavāca ulūkavarena dasāti. "}, "variant_text": {"ja270:0.1": "", "ja270:0.2": "", "ja270:0.3": "", "ja270:0.4": "", "ja270:1.1": "", "ja270:1.2": "", "ja270:1.3": "ñātīhi anuññāto → ñātīhanuññāto (bj, pts-vp-pli1) ", "ja270:1.4": "", "ja270:2.1": "", "ja270:2.2": "", "ja270:2.3": "", "ja270:2.4": "", "ja270:3.1": "bhaddaṁ vo → bhadante (mr) ", "ja270:3.2": "", "ja270:3.3": "", "ja270:3.4": "", "ja270:4.1": "", "ja270:4.2": "Padumavaggo → kosiyavaggo (pts-vp-pli1) ", "ja270:5.1": "", "ja270:6.1": "", "ja270:6.2": "", "ja270:6.3": "", "ja270:6.4": ""}, "reference_text": {"ja270:0.1": "", "ja270:0.2": "", "ja270:0.3": "", "ja270:0.4": "", "ja270:1.1": "ms22J_748, msdiv58, pts-vp-pli2.353", "ja270:1.2": "", "ja270:1.3": "", "ja270:1.4": "", "ja270:2.1": "ms22J_749, msdiv59", "ja270:2.2": "", "ja270:2.3": "", "ja270:2.4": "", "ja270:3.1": "dr27.109, ms22J_750, msdiv60, sya27.110", "ja270:3.2": "", "ja270:3.3": "", "ja270:3.4": "", "ja270:4.1": "ms22J_751", "ja270:4.2": "", "ja270:5.1": "ms22J_752", "ja270:6.1": "ms22J_753, vri68.70", "ja270:6.2": "", "ja270:6.3": "", "ja270:6.4": ""}, "keys_order": ["ja270:0.1", "ja270:0.2", "ja270:0.3", "ja270:0.4", "ja270:1.1", "ja270:1.2", "ja270:1.3", "ja270:1.4", "ja270:2.1", "ja270:2.2", "ja270:2.3", "ja270:2.4", "ja270:3.1", "ja270:3.2", "ja270:3.3", "ja270:3.4", "ja270:4.1", "ja270:4.2", "ja270:5.1", "ja270:6.1", "ja270:6.2", "ja270:6.3", "ja270:6.4"]}