{"html_text": {"ja404:0.1": "<article id='ja404'><header><ul><li class='division'>{}</li>", "ja404:0.2": "<li>{}</li>", "ja404:0.3": "<li>{}</li></ul>", "ja404:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja404:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja404:1.2": "<span class='verse-line'>{}</span>", "ja404:1.3": "<span class='verse-line'>{}</span>", "ja404:1.4": "<span class='verse-line'>{}</span></p>", "ja404:2.1": "<p><span class='verse-line'>{}</span>", "ja404:2.2": "<span class='verse-line'>{}</span>", "ja404:2.3": "<span class='verse-line'>{}</span>", "ja404:2.4": "<span class='verse-line'>{}</span></p>", "ja404:3.1": "<p><span class='verse-line'>{}</span>", "ja404:3.2": "<span class='verse-line'>{}</span>", "ja404:3.3": "<span class='verse-line'>{}</span>", "ja404:3.4": "<span class='verse-line'>{}</span></p>", "ja404:4.1": "<p><span class='verse-line'>{}</span>", "ja404:4.2": "<span class='verse-line'>{}</span>", "ja404:4.3": "<span class='verse-line'>{}</span>", "ja404:4.4": "<span class='verse-line'>{}</span></p>", "ja404:5.1": "<p><span class='verse-line'>{}</span>", "ja404:5.2": "<span class='verse-line'>{}</span>", "ja404:5.3": "<span class='verse-line'>{}</span>", "ja404:5.4": "<span class='verse-line'>{}</span></p>", "ja404:6.1": "<p><span class='verse-line'>{}</span>", "ja404:6.2": "<span class='verse-line'>{}</span>", "ja404:6.3": "<span class='verse-line'>{}</span>", "ja404:6.4": "<span class='verse-line'>{}</span></p>", "ja404:7.1": "<p><span class='verse-line'>{}</span>", "ja404:7.2": "<span class='verse-line'>{}</span>", "ja404:7.3": "<span class='verse-line'>{}</span>", "ja404:7.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja404:8.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja404:0.1": "Jātaka ", "ja404:0.2": "Sattakanipāta ", "ja404:0.3": "Kukkuvagga ", "ja404:0.4": "9. Kapijātaka ", "ja404:1.1": "“Yattha verī nivasati, ", "ja404:1.2": "na vase tattha paṇḍito; ", "ja404:1.3": "Ekarattaṁ dirattaṁ vā, ", "ja404:1.4": "dukkhaṁ vasati verisu. ", "ja404:2.1": "Diso ve lahucittassa, ", "ja404:2.2": "posassānuvidhīyato; ", "ja404:2.3": "Ekassa kapino hetu, ", "ja404:2.4": "yūthassa anayo kato. ", "ja404:3.1": "Bālova paṇḍitamānī, ", "ja404:3.2": "yūthassa parihārako; ", "ja404:3.3": "Sacittassa vasaṁ gantvā, ", "ja404:3.4": "sayethāyaṁ yathā kapi. ", "ja404:4.1": "Na sādhu balavā bālo, ", "ja404:4.2": "yūthassa parihārako; ", "ja404:4.3": "Ahito bhavati ñātīnaṁ, ", "ja404:4.4": "sakuṇānaṁva cetako. ", "ja404:5.1": "Dhīrova balavā sādhu, ", "ja404:5.2": "yūthassa parihārako; ", "ja404:5.3": "Hito bhavati ñātīnaṁ, ", "ja404:5.4": "tidasānaṁva vāsavo. ", "ja404:6.1": "Yo ca sīlañca paññañca, ", "ja404:6.2": "sutañcattani passati; ", "ja404:6.3": "Ubhinnamatthaṁ carati, ", "ja404:6.4": "attano ca parassa ca. ", "ja404:7.1": "Tasmā tuleyya mattānaṁ, ", "ja404:7.2": "sīlapaññāsutāmiva; ", "ja404:7.3": "Gaṇaṁ vā parihare dhīro, ", "ja404:7.4": "eko vāpi paribbaje”ti. ", "ja404:8.1": "Kapijātakaṁ navamaṁ. "}, "variant_text": {"ja404:0.1": "", "ja404:0.2": "", "ja404:0.3": "", "ja404:0.4": "", "ja404:1.1": "", "ja404:1.2": "", "ja404:1.3": "", "ja404:1.4": "", "ja404:2.1": "", "ja404:2.2": "", "ja404:2.3": "", "ja404:2.4": "", "ja404:3.1": "Bālova → bālo ca (bj, sya1ed, sya2ed, pts-vp-pli1) ", "ja404:3.2": "", "ja404:3.3": "", "ja404:3.4": "sayethāyaṁ → passethāyaṁ (mr) ", "ja404:4.1": "", "ja404:4.2": "", "ja404:4.3": "", "ja404:4.4": "cetako → ceṭako (mr) ", "ja404:5.1": "", "ja404:5.2": "", "ja404:5.3": "", "ja404:5.4": "", "ja404:6.1": "", "ja404:6.2": "", "ja404:6.3": "", "ja404:6.4": "", "ja404:7.1": "", "ja404:7.2": "sīlapaññāsutāmiva → sīlaṁ paññaṁ sutaṁpiva (sya1ed, sya2ed) ", "ja404:7.3": "", "ja404:7.4": "", "ja404:8.1": ""}, "reference_text": {"ja404:0.1": "", "ja404:0.2": "", "ja404:0.3": "", "ja404:0.4": "", "ja404:1.1": "ms22J_1553, msdiv61, pts-vp-pli3.357, sya27.221", "ja404:1.2": "", "ja404:1.3": "", "ja404:1.4": "", "ja404:2.1": "dr