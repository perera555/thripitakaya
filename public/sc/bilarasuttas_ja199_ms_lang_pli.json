{"html_text": {"ja199:0.1": "<article id='ja199'><header><ul><li class='division'>{}</li>", "ja199:0.2": "<li>{}</li>", "ja199:0.3": "<li>{}</li></ul>", "ja199:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja199:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja199:1.2": "<span class='verse-line'>{}</span>", "ja199:1.3": "<span class='verse-line'>{}</span>", "ja199:1.4": "<span class='verse-line'>{}</span></p>", "ja199:2.1": "<p><span class='verse-line'>{}</span>", "ja199:2.2": "<span class='verse-line'>{}</span>", "ja199:2.3": "<span class='verse-line'>{}</span>", "ja199:2.4": "<span class='verse-line'>{}</span>", "ja199:2.5": "<span class='verse-line'>{}</span>", "ja199:2.6": "<span class='verse-line'>{}</span></p></blockquote>", "ja199:3.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja199:0.1": "Jātaka ", "ja199:0.2": "Dukanipāta ", "ja199:0.3": "Ruhakavagga ", "ja199:0.4": "9. Gahapatijātaka ", "ja199:1.1": "“Ubhayaṁ me na khamati, ", "ja199:1.2": "ubhayaṁ me na ruccati; ", "ja199:1.3": "Yācāyaṁ koṭṭhamotiṇṇā, ", "ja199:1.4": "nāddasaṁ iti bhāsati. ", "ja199:2.1": "Taṁ taṁ gāmapati brūmi, ", "ja199:2.2": "kadare appasmi jīvite; ", "ja199:2.3": "Dve māse saṅgaraṁ katvā, ", "ja199:2.4": "maṁsaṁ jaraggavaṁ kisaṁ; ", "ja199:2.5": "Appattakāle codesi, ", "ja199:2.6": "tampi mayhaṁ na ruccatī”ti. ", "ja199:3.1": "Gahapatijātakaṁ navamaṁ. "}, "variant_text": {"ja199:0.1": "", "ja199:0.2": "", "ja199:0.3": "", "ja199:0.4": "", "ja199:1.1": "", "ja199:1.2": "", "ja199:1.3": "", "ja199:1.4": "", "ja199:2.1": "", "ja199:2.2": "", "ja199:2.3": "saṅgaraṁ katvā → kāraṁ katvāna (bj, pts-vp-pli1); saṅkaraṁ katvā (mr) ", "ja199:2.4": "", "ja199:2.5": "", "ja199:2.6": "", "ja199:3.1": ""}, "reference_text": {"ja199:0.1": "", "ja199:0.2": "", "ja199:0.3": "", "ja199:0.4": "", "ja199:1.1": "dr27.72, ms22J_494, msdiv97, pts-vp-pli2.136", "ja199:1.2": "", "ja199:1.3": "", "ja199:1.4": "", "ja199:2.1": "ms22J_495, msdiv98, ndp22.49", "ja199