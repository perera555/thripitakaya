[{"acronym": "Ja 51", "alt_acronym": null, "volpages": "PTS 1.267", "alt_volpages": null, "uid": "ja51", "blurb": "“Toil on, my brother.”—This story was told by the Master while at Jetavana, about a Brother who had given up all earnest effort. Being asked by the Master whether the report was true that he was a backslider, the Brother said it was true. “How can you, Brother,” said the Master, “grow cold in so saving a faith? Even when the wise and good of bygone days had lost their kingdom, yet so undaunted was their resolution that in the end they won back their sovereignty.” And so saying, he told this story of the past.", "difficulty": null, "original_title": "Mahāsīlavajātaka", "root_lang": "pli", "root_lang_name": "Pāli", "type": "leaf", "translated_title": "King Great Morality ", "translations": [{"lang": "pli", "lang_name": "Pāli", "is_root": true, "author": "Mahāsaṅgīti Tipiṭaka Buddhavasse 2500", "author_short": "ms", "author_uid": "ms", "publication_date": null, "id": "ja51_root-pli-ms", "segmented": true, "title": null, "volpage": null, "has_comment": false}, {"lang": "de", "lang_name": "Deutsch", "is_root": false, "author": "Sabbamitta", "author_short": "sabbamitta", "author_uid": "sabbamitta", "publication_date": null, "id": "ja51_translation-de-sabbamitta", "segmented": true, "title": "Der große Tugendhafte ", "volpage": null, "has_comment": true}, {"lang": "de", "lang_name": "Deutsch", "is_root": false, "author": "Dr. Julius Dutoit", "author_short": "Dutoit", "author_uid": "dutoit", "publication_date": "2007", "id": "de_ja51_dutoit", "segmented": false, "volpage": null, "has_comment": false}, {"lang": "en", "lang_name": "English", "is_root": false, "author": "Bhikkhu Sujato", "author_short": "sujato", "author_uid": "sujato", "publication_date": null, "id": "ja51_translation-en-sujato", "segmented": true, "title": "King Great Morality ", "volpage": null, "has_comment": true}, {"author": "Robert Chalmers", "author_short": "Chalmers", "author_uid": "chalm