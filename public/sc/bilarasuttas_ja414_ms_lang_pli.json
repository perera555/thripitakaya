{"html_text": {"ja414:0.1": "<article id='ja414'><header><ul><li class='division'>{}</li>", "ja414:0.2": "<li>{}</li>", "ja414:0.3": "<li>{}</li></ul>", "ja414:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja414:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja414:1.2": "<span class='verse-line'>{}</span>", "ja414:1.3": "<span class='verse-line'>{}</span>", "ja414:1.4": "<span class='verse-line'>{}</span></p>", "ja414:2.1": "<p><span class='verse-line'>{}</span>", "ja414:2.2": "<span class='verse-line'>{}</span>", "ja414:2.3": "<span class='verse-line'>{}</span>", "ja414:2.4": "<span class='verse-line'>{}</span></p>", "ja414:3.1": "<p><span class='verse-line'>{}</span>", "ja414:3.2": "<span class='verse-line'>{}</span>", "ja414:3.3": "<span class='verse-line'>{}</span>", "ja414:3.4": "<span class='verse-line'>{}</span></p>", "ja414:4.1": "<p><span class='verse-line'>{}</span>", "ja414:4.2": "<span class='verse-line'>{}</span>", "ja414:4.3": "<span class='verse-line'>{}</span>", "ja414:4.4": "<span class='verse-line'>{}</span></p>", "ja414:5.1": "<p><span class='verse-line'>{}</span>", "ja414:5.2": "<span class='verse-line'>{}</span>", "ja414:5.3": "<span class='verse-line'>{}</span>", "ja414:5.4": "<span class='verse-line'>{}</span></p>", "ja414:6.1": "<p><span class='verse-line'>{}</span>", "ja414:6.2": "<span class='verse-line'>{}</span>", "ja414:6.3": "<span class='verse-line'>{}</span>", "ja414:6.4": "<span class='verse-line'>{}</span></p>", "ja414:7.1": "<p><span class='verse-line'>{}</span>", "ja414:7.2": "<span class='verse-line'>{}</span>", "ja414:7.3": "<span class='verse-line'>{}</span>", "ja414:7.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja414:8.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja414:0.1": "Jātaka ", "ja414:0.2": "Sattakanipāta ", "ja414:0.3": "Gandhāravagga ", "ja414:0.4": "9. Jāgarajātaka ", "ja414:1.1": "“Kodha jāgarataṁ sutto, ", "ja414:1.2": "kodha suttesu jāgaro; ", "ja414:1.3": "Ko mametaṁ vijānāti, ", "ja414:1.4": "ko taṁ paṭibhaṇāti me”. ", "ja414:2.1": "“Ahaṁ jāgarataṁ sutto, ", "ja414:2.2": "ahaṁ suttesu jāgaro; ", "ja414:2.3": "Ahametaṁ vijānāmi, ", "ja414:2.4": "ahaṁ paṭibhaṇāmi te”. ", "ja414:3.1": "“Kathaṁ jāgarataṁ sutto, ", "ja414:3.2": "kathaṁ suttesu jāgaro; ", "ja414:3.3": "Kathaṁ etaṁ vijānāsi, ", "ja414:3.4": "kathaṁ paṭibhaṇāsi me”. ", "ja414:4.1": "“Ye dhammaṁ nappajānanti, ", "ja414:4.2": "saṁyamoti damoti ca; ", "ja414:4.3": "Tesu suppamānesu, ", "ja414:4.4": "ahaṁ jaggāmi devate. ", "ja414:5.1": "Yesaṁ rāgo ca doso ca, ", "ja414:5.2": "avijjā ca virājitā; ", "ja414:5.3": "Tesu jāgaramānesu, ", "ja414:5.4": "ahaṁ suttosmi devate. ", "ja414:6.1": "Evaṁ jāgarataṁ sutto, ", "ja414:6.2": "evaṁ suttesu jāgaro; ", "ja414:6.3": "Evametaṁ vijānāmi, ", "ja414:6.4": "evaṁ paṭibhaṇāmi te”. ", "ja414:7.1": "“Sādhu jāgarataṁ sutto, ", "ja414:7.2": "sādhu suttesu jāgaro; ", "ja414:7.3": "Sādhumetaṁ vijānāsi, ", "ja414:7.4": "sādhu paṭibhaṇāsi me”ti. ", "ja414:8.1": "Jāgarajātakaṁ navamaṁ. "}, "reference_text": {"ja414:0.1": "", "ja414:0.2": "", "ja414:0.3": "", "ja414:0.4": "", "ja414:1.1": "dr27.232, ms22J_1639, msdiv135, pts-vp-pli3.404, sya27.233", "ja414:1.2": "", "ja414:1.3": "", "ja414:1.4": "", "ja414:2.1": "ms22J_1640, msdiv136", "ja414:2.2": "", "ja414:2.3": "", "ja414:2.4": "", "ja414:3.1": "ms22J_1641, msdiv137", "ja414:3.2": "", "ja414:3.3": "", "ja414:3.4": "", "ja414:4.1": "ms22J_1642, msdiv138", "ja414:4.2": "", "ja414:4.3": "", "ja414:4.4": "", "ja414:5.1": "ms22J_1643, msdiv139", "ja414:5.2": "", "ja414:5.3": "", "ja414:5.4": "", "ja414:6.1": "csp1ed22.172, csp2ed22.172, ms22J_1644, msdiv140", "ja414:6.2": "", "ja414:6.3": "", "ja414:6.4": "", "ja414:7.1": "ms22J_1645, msdiv141, pts-vp-pli3.405", "ja414:7.2": "", "ja414:7.3": "", "ja414:7.4": "", "ja414:8.1": "ms22J_1646"}, "keys_order": ["ja414:0.1", "ja414:0.2", "ja414:0.3", "ja414:0.4", "ja414:1.1", "ja414:1.2", "ja414:1.3", "ja414:1.4", "ja414:2.1", "ja414:2