{"html_text": {"ja331:0.1": "<article id='ja331'><header><ul><li class='division'>{}</li>", "ja331:0.2": "<li>{}</li>", "ja331:0.3": "<li>{}</li></ul>", "ja331:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja331:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja331:1.2": "<span class='verse-line'>{}</span>", "ja331:1.3": "<span class='verse-line'>{}</span>", "ja331:1.4": "<span class='verse-line'>{}</span></p>", "ja331:2.1": "<p><span class='verse-line'>{}</span>", "ja331:2.2": "<span class='verse-line'>{}</span>", "ja331:2.3": "<span class='verse-line'>{}</span>", "ja331:2.4": "<span class='verse-line'>{}</span></p>", "ja331:3.1": "<p><span class='verse-line'>{}</span>", "ja331:3.2": "<span class='verse-line'>{}</span>", "ja331:3.3": "<span class='verse-line'>{}</span>", "ja331:3.4": "<span class='verse-line'>{}</span></p>", "ja331:4.1": "<p><span class='verse-line'>{}</span>", "ja331:4.2": "<span class='verse-line'>{}</span>", "ja331:4.3": "<span class='verse-line'>{}</span>", "ja331:4.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja331:5.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja331:0.1": "Jātaka ", "ja331:0.2": "Catukkanipāta ", "ja331:0.3": "Kokilavagga ", "ja331:0.4": "1. Kokilajātaka ", "ja331:1.1": "“Yo ve kāle asampatte, ", "ja331:1.2": "ativelaṁ pabhāsati; ", "ja331:1.3": "Evaṁ so nihato seti, ", "ja331:1.4": "kokilāyiva atrajo. ", "ja331:2.1": "Na hi satthaṁ sunisitaṁ, ", "ja331:2.2": "visaṁ halāhalāmiva; ", "ja331:2.3": "Evaṁ nikaṭṭhe pāteti, ", "ja331:2.4": "vācā dubbhāsitā yathā. ", "ja331:3.1": "Tasmā kāle akāle vā, ", "ja331:3.2": "vācaṁ rakkheyya paṇḍito; ", "ja331:3.3": "Nātivelaṁ pabhāseyya, ", "ja331:3.4": "api attasamamhi vā. ", "ja331:4.1": "Yo ca kāle mitaṁ bhāse, ", "ja331:4.2": "matipubbo vicakkhaṇo; ", "ja331:4.3": "Sabbe amitte ādeti, ", "ja331:4.4": "supaṇṇo uragāmivā”ti. ", "ja331:5.1": "Kokilajātakaṁ paṭhamaṁ. "}, "variant_text": {"ja331:0.1": "", "ja331:0.2": "", "ja331:0.3": "", "ja331:0.4": "", "ja331:1.1": "", "ja331:1.2": "", "ja331:1.3": "", "ja331:1.4": "", "ja331:2.1": "", "ja331:2.2": "halāhalāmiva → halāhalaṁ iva (bj, pts-vp-pli1); halāhalammiva (sya1ed, sya2ed) ", "ja331:2.3": "nikaṭṭhe → nikkaḍhe (sya1ed, sya2ed); nikaḍḍhe (mr) ", "ja331:2.4": "", "ja331:3.1": "akāle vā → akāle ca (bj, sya1ed, sya2ed) ", "ja331:3.2": "", "ja331:3.3": "", "ja331:3.4": "", "ja331:4.1": "", "ja331:4.2": "", "ja331:4.3": "", "ja331:4.4": "", "ja331:5.1": "Kokilajātakaṁ → kokālikajātakaṁ (sabbattha) "}, "reference_text": {"ja331:0.1": "", "ja331:0.2": "", "ja331:0.3": "", "ja331:0.4": "", "ja331:1.1": "bj30.188, csp1ed22.109, csp2ed22.109, dr27.149, ms22J_1039, msdiv121, pts-vp-pli3.103", "ja331:1.2": "", "ja331:1.3": "", "ja331:1.4": "", "ja331:2.1": "ms22J_1040, msdiv122", "ja331:2.2": "", "ja331:2.3": "", "ja331:2.4": "", "ja331:3.1": "ms22J_1041, msdiv123", "ja331:3.2": "", "ja331:3.3": "", "ja331:3.4": "", "ja331:4.1": "ms22J_1042, msdiv124, vri68.94", "ja331:4.2": "", "ja331:4.3": "", "ja331:4.4": "", "ja331:5.1": "ms22J_1043"}, "keys_order": ["ja331:0.1", "ja331:0.2", "ja331:0.3", "ja331:0.4", "ja331:1.1", "ja331:1.2", "ja331:1.3", "ja331:1.4", "ja331:2.1", "ja331:2.2", "ja331:2.3", "ja331:2.4", "ja331:3.1", "ja331:3.2", "ja331:3.3", "ja331:3.4", "ja331:4.1", "ja331:4.2", "ja331:4.3", "ja331:4.4", "ja331:5.1"]}