{"html_text": {"ja303:0.1": "<article id='ja303'><header><ul><li class='division'>{}</li>", "ja303:0.2": "<li>{}</li>", "ja303:0.3": "<li>{}</li></ul>", "ja303:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja303:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja303:1.2": "<span class='verse-line'>{}</span>", "ja303:1.3": "<span class='verse-line'>{}</span>", "ja303:1.4": "<span class='verse-line'>{}</span></p>", "ja303:2.1": "<p><span class='verse-line'>{}</span>", "ja303:2.2": "<span class='verse-line'>{}</span>", "ja303:2.3": "<span class='verse-line'>{}</span>", "ja303:2.4": "<span class='verse-line'>{}</span></p>", "ja303:3.1": "<p><span class='verse-line'>{}</span>", "ja303:3.2": "<span class='verse-line'>{}</span>", "ja303:3.3": "<span class='verse-line'>{}</span>", "ja303:3.4": "<span class='verse-line'>{}</span></p>", "ja303:4.1": "<p><span class='verse-line'>{}</span>", "ja303:4.2": "<span class='verse-line'>{}</span>", "ja303:4.3": "<span class='verse-line'>{}</span>", "ja303:4.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja303:5.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja303:0.1": "Jātaka ", "ja303:0.2": "Catukkanipāta ", "ja303:0.3": "Kāliṅgavagga ", "ja303:0.4": "3. Ekarājajātaka ", "ja303:1.1": "“Anuttare kāmaguṇe samiddhe, ", "ja303:1.2": "Bhutvāna pubbe vasī ekarāja; ", "ja303:1.3": "So dāni dugge narakamhi khitto, ", "ja303:1.4": "Nappajjahe vaṇṇabalaṁ purāṇaṁ”. ", "ja303:2.1": "“Pubbeva khantī ca tapo ca mayhaṁ, ", "ja303:2.2": "Sampatthitā dubbhisena ahosi; ", "ja303:2.3": "Taṁ dāni laddhāna kathaṁ nu rāja, ", "ja303:2.4": "Jahe ahaṁ vaṇṇabalaṁ purāṇaṁ. ", "ja303:3.1": "Sabbā kirevaṁ pariniṭṭhitāni, ", "ja303:3.2": "Yasassinaṁ paññavantaṁ visayha; ", "ja303:3.3": "Yaso ca laddhā purimaṁ uḷāraṁ, ", "ja303:3.4": "Nappajjahe vaṇṇabalaṁ purāṇaṁ. ", "ja303:4.1": "Panujja dukkhena sukhaṁ janinda, ", "ja303:4.2": "Sukhena vā dukkhamasayhasāhi; ", "ja303:4.3": "Ubhayattha santo abhinibbutattā, ", "ja303:4.4": "Sukhe ca dukkhe ca bhavanti tulyā”ti. ", "ja303:5.1": "Ekarājajātakaṁ tatiyaṁ. "}, "variant_text": {"ja303:0.1": "", "ja303:0.2": "", "ja303:0.3": "", "ja303:0.4": "", "ja303:1.1": "", "ja303:1.2": "", "ja303:1.3": "", "ja303:1.4": "", "ja303:2.1": "", "ja303:2.2": "dubbhisena → dabbasenā (bj, pts-vp-pli1) ", "ja303:2.3": "", "ja303:2.4": "", "ja303:3.1": "", "ja303:3.2": "", "ja303:3.3": "", "ja303:3.4": "", "ja303:4.1": "", "ja303:4.2": "", "ja303:4.3": "", "ja303:4.4": "", "ja303:5.1": ""}, "reference_text": {"ja303:0.1": "", "ja303:0.2": "", "ja303:0.3": "", "ja303:0.4": "", "ja303:1.1": "dr27.130, ms22J_893, msdiv9, pts-vp-pli3.14, sya27.130, vri68.82", "ja303:1.2": "", "ja303:1.3": "", "ja303:1.4": "", "ja303:2.1": "ms22J_894, msdiv10", "ja303:2.2": "", "ja303:2.3": "", "ja303:2.4": "", "ja303:3.1": "ms22J_895, msdiv11", "ja303:3.2": "", "ja303:3.3": "", "ja303:3.4": "", "ja303:4.1": "ms22J_896, msdiv12", "ja303:4.2": "", "ja303:4.3": "", "ja303:4.4": "", "ja303:5.1": "ms22J_897"}, "keys_order": ["ja303:0.1", "ja303:0.2", "ja303:0.3", "ja303:0.4", "ja303:1.1", "ja303:1.2", "ja303:1.3", "ja303:1.4", "ja303:2.1", "ja303:2.2", "ja303:2.3", "ja303:2.4", "ja303:3.1", "ja303:3.2", "ja303:3.3", "ja303:3.4", "ja303:4.1", "ja303:4.2", "ja303:4.3", "ja303:4.4", "ja303:5.1"]}