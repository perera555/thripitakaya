{"html_text": {"kp7:0.1": "<article id='kp7'><header><ul><li class='division'>{}</li></ul>", "kp7:0.2": "<h1 class='sutta-title'>{}</h1></header>", "kp7:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "kp7:1.2": "<span class='verse-line'>{}</span>", "kp7:1.3": "<span class='verse-line'>{}</span>", "kp7:1.4": "<span class='verse-line'>{}</span></p>", "kp7:2.1": "<p><span class='verse-line'>{}</span>", "kp7:2.2": "<span class='verse-line'>{}</span>", "kp7:2.3": "<span class='verse-line'>{}</span>", "kp7:2.4": "<span class='verse-line'>{}</span></p>", "kp7:3.1": "<p><span class='verse-line'>{}</span>", "kp7:3.2": "<span class='verse-line'>{}</span>", "kp7:3.3": "<span class='verse-line'>{}</span>", "kp7:3.4": "<span class='verse-line'>{}</span></p>", "kp7:4.1": "<p><span class='verse-line'>{}</span>", "kp7:4.2": "<span class='verse-line'>{}</span>", "kp7:4.3": "<span class='verse-line'>{}</span>", "kp7:4.4": "<span class='verse-line'>{}</span></p>", "kp7:5.1": "<p><span class='verse-line'>{}</span>", "kp7:5.2": "<span class='verse-line'>{}</span>", "kp7:5.3": "<span class='verse-line'>{}</span>", "kp7:5.4": "<span class='verse-line'>{}</span></p>", "kp7:6.1": "<p><span class='verse-line'>{}</span>", "kp7:6.2": "<span class='verse-line'>{}</span>", "kp7:6.3": "<span class='verse-line'>{}</span>", "kp7:6.4": "<span class='verse-line'>{}</span></p>", "kp7:7.1": "<p><span class='verse-line'>{}</span>", "kp7:7.2": "<span class='verse-line'>{}</span>", "kp7:7.3": "<span class='verse-line'>{}</span>", "kp7:7.4": "<span class='verse-line'>{}</span></p>", "kp7:8.1": "<p><span class='verse-line'>{}</span>", "kp7:8.2": "<span class='verse-line'>{}</span>", "kp7:8.3": "<span class='verse-line'>{}</span>", "kp7:8.4": "<span class='verse-line'>{}</span></p>", "kp7:9.1": "<p><span class='verse-line'>{}</span>", "kp7:9.2": "<span class='verse-line'>{}</span>", "kp7:9.3": "<span class='verse-line'>{}</span>", "kp7:9.4": "<span class='verse-line'>{}</span></p>", "kp7:10.1": "<p><span class='verse-line'>{}</span>", "kp7:10.2": "<span class='verse-line'>{}</span>", "kp7:10.3": "<span class='verse-line'>{}</span>", "kp7:10.4": "<span class='verse-line'>{}</span></p>", "kp7:11.1": "<p><span class='verse-line'>{}</span>", "kp7:11.2": "<span class='verse-line'>{}</span>", "kp7:11.3": "<span class='verse-line'>{}</span>", "kp7:11.4": "<span class='verse-line'>{}</span></p>", "kp7:12.1": "<p><span class='verse-line'>{}</span>", "kp7:12.2": "<span class='verse-line'>{}</span>", "kp7:12.3": "<span class='verse-line'>{}</span>", "kp7:12.4": "<span class='verse-line'>{}</span></p>", "kp7:13.1": "<p><span class='verse-line'>{}</span>", "kp7:13.2": "<span class='verse-line'>{}</span>", "kp7:13.3": "<span class='verse-line'>{}</span>", "kp7:13.4": "<span class='verse-line'>{}</span></p></blockquote>", "kp7:14.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"kp7:0.1": "Khuddakapāṭha 7 ", "kp7:0.2": "Tirokuṭṭasutta ", "kp7:1.1": "Tirokuṭṭesu tiṭṭhanti, ", "kp7:1.2": "sandhisiṅghāṭakesu ca; ", "kp7:1.3": "Dvārabāhāsu tiṭṭhanti, ", "kp7:1.4": "āgantvāna sakaṁ gharaṁ. ", "kp7:2.1": "Pahūte annapānamhi, ", "kp7:2.2": "khajjabhojje upaṭṭhite; ", "kp7:2.3": "Na tesaṁ koci sarati, ", "kp7:2.4": "sattānaṁ kammapaccayā. ", "kp7:3.1": "Evaṁ dadanti ñātīnaṁ, ", "kp7:3.2": "ye honti anukampakā; ", "kp7:3.3": "Suciṁ paṇītaṁ kālena, ", "kp7:3.4": "kappiyaṁ pānabhojanaṁ. ", "kp7:4.1": "Idaṁ vo ñātīnaṁ hotu, ", "kp7:4.2": "sukhitā hontu ñātayo; ", "kp7:4.3": "Te ca tattha samāgantvā, ", "kp7:4.4": "ñātipetā samāgatā. ", "kp7:5.1": "Pahūte annapānamhi, ", "kp7:5.2": "sakkaccaṁ anumodare; ", "kp7:5.3": "Ciraṁ jīvantu no ñātī, ", "kp7:5.4": "yesaṁ hetu labhāmase. ", "kp7:6.1": "Amhākañca katā pūjā, ", "kp7:6.2": "dāyakā ca anipphalā; ", "kp7:6.3": "Na hi tattha kasī atthi, ", "kp7:6.4": "gorakkhettha na vijjati. ", "kp7:7.1": "Vaṇijjā tādisī natthi, ", "kp7:7.2": "hiraññena kayākayaṁ; ", "kp7:7.3": "Ito dinnena yāpenti, ", "kp7:7.4": "petā kālagatā tahiṁ. ", "kp7:8.1": "Unname udakaṁ vuṭṭhaṁ, ", "kp7:8.2": "yathā ninnaṁ pavattati; ", "kp7:8.3": "Evamevaṁ ito dinnaṁ, ", "kp7:8.4": "petānaṁ upakappati. ", "kp7:9.1": "Yathā vārivahā pūrā, ", "kp7:9.2": "paripūrenti sāgaraṁ; ", "kp7:9.3": "Evamevaṁ ito dinnaṁ, ", "kp7:9.4": "petānaṁ upakappati. ", "kp7:10.1": "Adāsi me akāsi me, ", "kp7:10.2": "ñāti mittā sakhā ca me; ", "kp7:10.3": "Petānaṁ dakkhiṇaṁ dajjā, ", "kp7:10.4": "pubbe katamanussaraṁ. ", "kp7:11.1": "Na hi ruṇṇaṁ vā soko vā, ", "kp7:11.2": "yā caññā paridevanā; ", "kp7:11.3": "Na taṁ petānamatthāya, ", "kp7:11.4": "evaṁ tiṭṭhanti ñātayo. ", "kp7:12.1": "Ayañca kho dakkhiṇā dinnā, ", "kp7:12.2": "saṅghamhi suppatiṭṭhitā; ", "kp7:12.3": "Dīgharattaṁ hitāyassa, ", "kp7:12.4": "ṭhānaso upakappati. ", "kp7:13.1": "So ñātidhammo ca ayaṁ nidassito, ", "kp7:13.2": "Petāna pūjā ca katā uḷārā; ", "kp7:13.3": "Balañca bhikkhūnamanuppadinnaṁ, ", "kp7:13.4": "Tumhehi puññaṁ pasutaṁ anappakanti. ", "kp7:14.1": "Tirokuṭṭasuttaṁ. "}, "reference_text": {"kp7:0.1": "", "kp7:0.2": "", "kp7:1.1": "mc0.10, ms18Kh_64, msdiv1, vri47.8", "kp7:1.2": "", "kp7:1.3": "", "kp7:1.4": "", "kp7:2.1": "ms18Kh_65, msdiv2, sya25.10", "kp7:2.2": "", "kp7:2.3": "", "kp7:2.4": "", "kp7:3.1": "ms18Kh_66, msdiv3", "kp7:3.2": "", "kp7:3.3": "", "kp7:3.4": "", "kp7:4.1": "dr25.10, ms18Kh_67, msdiv4", "kp7:4.2": "", "kp7:4.3": "", "kp7:4.4": "", "kp7:5.1": "ms18Kh_68, msdiv5", "kp7:5.2": "", "kp7:5.3": "", "kp7:5.4": "", "kp7:6.1": "ms18Kh_69, msdiv6", "kp7:6.2": "", "kp7:6.3": "", "kp7:6.4": "", "kp7:7.1": "ms18Kh_70, msdiv7", "kp7:7.2": "", "kp7:7.3": "", "kp7:7.4": "", "kp7:8.1": "ms18Kh_71, msdiv8, ndp20.10", "kp7:8.2": "", "kp7:8.3": "", "kp7:8.4": "", "kp7:9.1": "bj24.16, cck25.9, mc0.11, ms18Kh_72, msdiv9", "kp7:9.2": "", "kp7:9.3": "", "kp7:9.4": "", "kp7:10.1": "csp1ed18.9, csp2ed18.9, ms18Kh_73, msdiv10, vri47.9", "kp7:10.2": "", "kp7:10.3": "", "kp7:10.4": "", "kp7:11.1": "ms18Kh_74, msdiv11", "kp7:11.2": "", "kp7:11.3": "", "kp7:11