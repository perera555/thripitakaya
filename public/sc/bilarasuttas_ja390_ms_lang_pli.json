{"html_text": {"ja390:0.1": "<article id='ja390'><header><ul><li class='division'>{}</li>", "ja390:0.2": "<li>{}</li>", "ja390:0.3": "<li>{}</li></ul>", "ja390:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja390:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja390:1.2": "<span class='verse-line'>{}</span>", "ja390:1.3": "<span class='verse-line'>{}</span>", "ja390:1.4": "<span class='verse-line'>{}</span></p>", "ja390:2.1": "<p><span class='verse-line'>{}</span>", "ja390:2.2": "<span class='verse-line'>{}</span>", "ja390:2.3": "<span class='verse-line'>{}</span>", "ja390:2.4": "<span class='verse-line'>{}</span></p>", "ja390:3.1": "<p><span class='verse-line'>{}</span>", "ja390:3.2": "<span class='verse-line'>{}</span>", "ja390:3.3": "<span class='verse-line'>{}</span>", "ja390:3.4": "<span class='verse-line'>{}</span></p>", "ja390:4.1": "<p><span class='verse-line'>{}</span>", "ja390:4.2": "<span class='verse-line'>{}</span>", "ja390:4.3": "<span class='verse-line'>{}</span>", "ja390:4.4": "<span class='verse-line'>{}</span></p>", "ja390:5.1": "<p><span class='verse-line'>{}</span>", "ja390:5.2": "<span class='verse-line'>{}</span>", "ja390:5.3": "<span class='verse-line'>{}</span>", "ja390:5.4": "<span class='verse-line'>{}</span>", "ja390:5.5": "<span class='verse-line'>{}</span>", "ja390:5.6": "<span class='verse-line'>{}</span></p>", "ja390:6.1": "<p><span class='verse-line'>{}</span>", "ja390:6.2": "<span class='verse-line'>{}</span>", "ja390:6.3": "<span class='verse-line'>{}</span>", "ja390:6.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja390:7.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja390:0.1": "Jātaka ", "ja390:0.2": "Chakkanipāta ", "ja390:0.3": "Kharaputtavagga ", "ja390:0.4": "5. Mayhakajātaka ", "ja390:1.1": "“Sakuṇo mayhako nāma, ", "ja390:1.2": "girisānudarīcaro; ", "ja390:1.3": "Pakkaṁ pipphalimāruyha, ", "ja390:1.4": "mayhaṁ mayhanti kandati. ", "ja390:2.1": "Tassevaṁ vilapantassa, ", "ja390:2.2": "dijasaṅghā samāgatā; ", "ja390:2.3": "Bhutvāna pipphaliṁ yanti, ", "ja390:2.4": "vilapatveva so dijo. ", "ja390:3.1": "Evameva idhekacco, ", "ja390:3.2": "saṅgharitvā bahuṁ dhanaṁ; ", "ja390:3.3": "Nevattano na ñātīnaṁ, ", "ja390:3.4": "yathodhiṁ paṭipajjati. ", "ja390:4.1": "Na so acchādanaṁ bhattaṁ, ", "ja390:4.2": "na mālaṁ na vilepanaṁ; ", "ja390:4.3": "Anubhoti sakiṁ kiñci, ", "ja390:4.4": "na saṅgaṇhāti ñātake. ", "ja390:5.1": "Tassevaṁ vilapantassa, ", "ja390:5.2": "mayhaṁ mayhanti rakkhato; ", "ja390:5.3": "Rājāno atha vā corā, ", "ja390:5.4": "dāyādā ye va appiyā; ", "ja390:5.5": "Dhanamādāya gacchanti, ", "ja390:5.6": "vilapatveva so naro. ", "ja390:6.1": "Dhīro bhoge adhigamma, ", "ja390:6.2": "saṅgaṇhāti ca ñātake; ", "ja390:6.3": "Tena so kittiṁ pappoti, ", "ja390:6.4": "pecca sagge pamodatī”ti. ", "ja390:7.1": "Mayhakajātakaṁ pañcamaṁ. "}, "variant_text": {"ja390:0.1": "", "ja390:0.2": "", "ja390:0.3": "va → ye ca (sya1ed, sya2ed, mr) ", "ja390:0.4": "", "ja390:1.1": "", "ja390:1.2": "", "ja390:1.3": "", "ja390:1.4": "", "ja390:2.1": "", "ja390:2.2": "", "ja390:2.3": "", "ja390:2.4": "", "ja390:3.1": "", "ja390:3.2": "", "ja390:3.3": "", "ja390:3.4": "", "ja390:4.1": "", "ja390:4.2": "", "ja390:4.3": "Anubhoti → nānubhoti (sya1ed, sya2ed, mr) ", "ja390:4.4": "", "ja390:5.1": "", "ja390:5.2": "", "ja390:5.3": "", "ja390:5.4": "", "ja390:5.5": "", "ja390:5.6": "", "ja390:6.1": "Dhīro → dhīro ca (bj) ", "ja390:6.2": "", "ja390:6.3": "", "ja390:6.4": "sagge pamodatī”ti → sagge ca modatīti (bj, pts-vp-pli1) ", "ja390:7.1": "Mayhakajātakaṁ → mayhakasakuṇajātakaṁ (sya1ed, sya2ed) "}, "reference_text": {"ja390:0.1": "", "ja390:0.2": "", "ja390:0.3": "", "ja390:0.4": "", "ja390:1.1": "bj30.256, ms22J_1436, msdiv103, pts-vp-pli3.301", "ja390:1.2": "", "ja390:1.3": "", "ja390:1.4": "", "ja390:2.1": "ms22J_1437, msdiv104, pts-vp-pli3.302", "ja390:2.2": "", "ja390:2.3": "", "ja390:2.4": "", "ja390:3.1": "dr27.204, ms22J_1438, msdiv105", "ja390:3.2"