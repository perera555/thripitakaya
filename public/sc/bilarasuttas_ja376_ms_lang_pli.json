{"html_text": {"ja376:0.1": "<article id='ja376'><header><ul><li class='division'>{}</li>", "ja376:0.2": "<li>{}</li>", "ja376:0.3": "<li>{}</li></ul>", "ja376:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja376:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja376:1.2": "<span class='verse-line'>{}</span>", "ja376:1.3": "<span class='verse-line'>{}</span>", "ja376:1.4": "<span class='verse-line'>{}</span></p>", "ja376:2.1": "<p><span class='verse-line'>{}</span>", "ja376:2.2": "<span class='verse-line'>{}</span>", "ja376:2.3": "<span class='verse-line'>{}</span>", "ja376:2.4": "<span class='verse-line'>{}</span></p>", "ja376:3.1": "<p><span class='verse-line'>{}</span>", "ja376:3.2": "<span class='verse-line'>{}</span>", "ja376:3.3": "<span class='verse-line'>{}</span>", "ja376:3.4": "<span class='verse-line'>{}</span>", "ja376:3.5": "<span class='verse-line'>{}</span>", "ja376:3.6": "<span class='verse-line'>{}</span></p>", "ja376:4.1": "<p><span class='verse-line'>{}</span>", "ja376:4.2": "<span class='verse-line'>{}</span>", "ja376:4.3": "<span class='verse-line'>{}</span>", "ja376:4.4": "<span class='verse-line'>{}</span></p>", "ja376:5.1": "<p><span class='verse-line'>{}</span>", "ja376:5.2": "<span class='verse-line'>{}</span>", "ja376:5.3": "<span class='verse-line'>{}</span>", "ja376:5.4": "<span class='verse-line'>{}</span></p>", "ja376:6.1": "<p><span class='verse-line'>{}</span>", "ja376:6.2": "<span class='verse-line'>{}</span>", "ja376:6.3": "<span class='verse-line'>{}</span>", "ja376:6.4": "<span class='verse-line'>{}</span></p>", "ja376:7.1": "<p><span class='verse-line'>{}</span>", "ja376:7.2": "<span class='verse-line'>{}</span>", "ja376:7.3": "<span class='verse-line'>{}</span>", "ja376:7.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja376:8.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja376:0.1": "Jātaka ", "ja376:0.2": "Chakkanipāta ", "ja376:0.3": "Avāriyavagga ", "ja376:0.4": "1. Avāriyajātaka ", "ja376:1.1": "“Māsu kujjha bhūmipati, ", "ja376:1.2": "māsu kujjha rathesabha; ", "ja376:1.3": "Kuddhaṁ appaṭikujjhanto, ", "ja376:1.4": "rājā raṭṭhassa pūjito. ", "ja376:2.1": "Gāme vā yadi vāraññe, ", "ja376:2.2": "ninne vā yadi vā thale; ", "ja376:2.3": "Sabbattha anusāsāmi, ", "ja376:2.4": "māsu kujjha rathesabha”. ", "ja376:3.1": "“Avāriyapitā nāma, ", "ja376:3.2": "ahu gaṅgāya nāviko; ", "ja376:3.3": "Pubbe janaṁ tāretvāna, ", "ja376:3.4": "pacchā yācati vetanaṁ; ", "ja376:3.5": "Tenassa bhaṇḍanaṁ hoti, ", "ja376:3.6": "na ca bhogehi vaḍḍhati”. ", "ja376:4.1": "“Atiṇṇaṁyeva yācassu, ", "ja376:4.2": "apāraṁ tāta nāvika; ", "ja376:4.3": "Añño hi tiṇṇassa mano, ", "ja376:4.4": "añño hoti pāresino. ", "ja376:5.1": "Gāme vā yadi vāraññe, ", "ja376:5.2": "ninne vā yadi vā thale; ", "ja376:5.3": "Sabbattha anusāsāmi, ", "ja376:5.4": "māsu kujjhittha nāvika”. ", "ja376:6.1": "“Yāyevānusāsaniyā, ", "ja376:6.2": "rājā gāmavaraṁ adā; ", "ja376:6.3": "Tāyevānusāsaniyā, ", "ja376:6.4": "nāviko paharī mukhaṁ. ", "ja376:7.1": "Bhattaṁ bhinnaṁ hatā bhariyā, ", "ja376:7.2": "Gabbho ca patito chamā; ", "ja376:7.3": "Migova jātarūpena, ", "ja376:7.4": "Na tenatthaṁ abandhi sū”ti. ", "ja376:8.1": "Avāriyajātakaṁ paṭhamaṁ. "}, "variant_text": {"ja376:0.1": "", "ja376:0.2": "", "ja376:0.3": "", "ja376:0.4": "", "ja376:1.1": "kujjha → māssu kujjhi (bj, pts-vp-pli1) ", "ja376:1.2": "kujjha → māssu kujjhi (bj, pts-vp-pli1) ", "ja376:1.3": "kujjha → māssu kujjhi (bj, pts-vp-pli1) ", "ja376:1.4": "", "ja376:2.1": "", "ja376:2.2": "", "ja376:2.3": "", "ja376:2.4": "", "ja376:3.1": "", "ja376:3.2": "", "ja376:3.3": "", "ja376:3.4": "", "ja376:3.5": "", "ja376:3.6": "", "ja376:4.1": "", "ja376:4.2": "", "ja376:4.3": "", "ja376:4.4": "pāresino → taresino (bj, pts-vp-pli1); tiresino (sya1ed, sya2ed) ", "ja376:5.1": "", "ja376:5.2": "", "ja376:5.3": "", "ja376:5.4": "", "ja376:6.1": "", "ja376:6.2": "", "ja376:6.3": "", "ja376:6.4": "", "ja376:7.1": "", "ja376:7.2": "", "ja376:7.3": "", "ja376:7.4": "abandhi sū”ti → avaḍḍhitunti (bj, sya1ed, sya2ed); avaḍḍhi sūti (?) ", "ja376:8.1": "Avāriyajātakaṁ → āvāriyajātakaṁ (sya1ed, sya2ed) "}, "reference_text": {"ja376:0.1": "", "ja376:0.2": "", "ja376:0.3": "", "ja376:0.4": "", "ja376:1.1": "bj30.234, csp1ed22.137, csp2ed22.137, dr27.186, ms22J_1318, msdiv1, ndp22.128, pts-vp-pli3.229, sya27.187, vri68.116", "ja376:1.2": "", "ja376:1.3": "", "ja376:1.4": "", "ja376:2.1": "ms22J_1319, msdiv2", "ja376:2.2": "", "ja376:2.3": "", "ja376:2.4": "", "ja376:3.1": "ms22J_1320, msdiv3, pts-vp-pli3.230", "ja376:3.2": "", "ja376:3.3": "", "ja376:3.4": "", "ja376:3.5": "", "ja376:3.6": "", "ja376:4.1": "ms22J_1321, msdiv4", "ja376:4.2": "", "ja376:4.3": "", "ja376:4.4": "", "ja376:5.1": "ms22J_1322, msdiv5, pts-vp-pli3.231", "ja376:5.2": "", "ja376:5.3": "", "ja376:5.4": "", "ja376:6.1": "ms22J_1323, msdiv6", "ja376:6.2": "", "ja376:6.3": "", "ja376:6.4": "", "ja376:7.1": "ms22J_1324, msdiv7, pts-vp-pli3.232", "ja376:7.2": "", "ja376:7.3": "", "ja376:7.4": "", "ja376:8.1": "ms22J_1325"}, "keys_order": ["ja376:0.1", "ja376:0.2", "ja376:0.3", "ja376:0.4", "ja376:1.1", "ja376:1.2", "ja376:1.3", "ja376:1.4", "ja376:2.1", "ja376:2.2", "ja376:2.3", "ja376:2.4", "ja376:3.1", "ja376:3.2", "ja376:3.3", "ja376:3.4", "ja376:3.5", "ja376:3.6", "ja376:4.1", "ja376:4.2", "ja376:4.3", "ja376:4.4", "ja376:5.1", "ja376:5.2", "ja376:5.3", "ja376:5.4", "ja376:6.1", "ja376:6.2", "ja376:6.3", "ja376:6.4", "ja376:7.1", "ja376:7.2", "ja376:7.3", "ja376:7.4", "ja376:8.1"]}