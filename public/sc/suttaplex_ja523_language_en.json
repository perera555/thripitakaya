[{"acronym": "Ja 523", "alt_acronym": null, "volpages": "PTS 5.153, PTS 5.154, PTS 5.155, PTS 5.156, PTS 5.157, PTS 5.158, PTS 5.159, PTS 5.160, PTS 5.161", "alt_volpages": null, "uid": "ja523", "blurb": "“Then mighty Indra”—This story the Master, while residing at Jetavana, told about the temptation of a Brother by the wife of his unregenerate days. The subject-matter of the tale is related in full in the Indriya Birth. Now the Master asked the Brother, “Is it true, Brother, that you were rendered discontented?” “It is true, Reverend Sir.” “By whom?” “By my wife of former days.” “Brother,” he said, “this woman wrought mischief for you: it was owing to her that you fell away from mystic meditation, and lay for three years in a lost and distracted condition, and on the recovery of your senses you uttered a great lamentation,” and so saying he told him a story of the past.", "difficulty": null, "original_title": "Alambusājātaka", "root_lang": "pli", "root_lang_name": "Pāli", "type": "leaf", "translated_title": "Alambusa Jātaka", "translations": [{"lang": "pli", "lang_name": "Pāli", "is_root": true, "author": "Mahāsaṅgīti Tipiṭaka Buddhavasse 2500", "author_short": "ms", "author_uid": "ms", "publication_date": null, "id": "ja523_root-pli-ms", "segmented": true, "title": null, "volpage": null, "has_comment": false}, {"lang": "de", "lang_name": "Deutsch", "is_root": false, "author": "Dr. Julius Dutoit", "author_short": "Dutoit", "author_uid": "dutoit", "publication_date": "2007", "id": "de_ja523_dutoit", "segmented": false, "volpage": null, "has_comment": false}, {"author": "H.T. Francis", "author_short": "Francis", "author_uid": "francis", "has_comment": false, "id": "en_ja523_francis", "is_root": false, "lang": "en", "lang_name": "English", "publication_date": "1905", "segmented": false, "volpage": null, "title": "Alambusa Jātaka"}, {"lang": "jpn", "lang_name": "日本語", "is_root": false, "author": "関西パーリ語実習会", "author_short": "関西パーリ語実習会", "author_uid": "kansai", "publica