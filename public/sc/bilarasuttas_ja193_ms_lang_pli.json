{"html_text": {"ja193:0.1": "<article id='ja193'><header><ul><li class='division'>{}</li>", "ja193:0.2": "<li>{}</li>", "ja193:0.3": "<li>{}</li></ul>", "ja193:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja193:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja193:1.2": "<span class='verse-line'>{}</span>", "ja193:1.3": "<span class='verse-line'>{}</span>", "ja193:1.4": "<span class='verse-line'>{}</span></p>", "ja193:2.1": "<p><span class='verse-line'>{}</span>", "ja193:2.2": "<span class='verse-line'>{}</span>", "ja193:2.3": "<span class='verse-line'>{}</span>", "ja193:2.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja193:3.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja193:0.1": "Jātaka ", "ja193:0.2": "Dukanipāta ", "ja193:0.3": "Ruhakavagga ", "ja193:0.4": "3. Cūḷapadumajātaka ", "ja193:1.1": "“Ayameva sā ahamapi so anañño, ", "ja193:1.2": "Ayameva so hatthacchinno anañño; ", "ja193:1.3": "Yamāha ‘komārapatī maman’ti, ", "ja193:1.4": "Vajjhitthiyo natthi itthīsu saccaṁ. ", "ja193:2.1": "Imañca jammaṁ musalena hantvā, ", "ja193:2.2": "Luddaṁ chavaṁ paradārūpaseviṁ; ", "ja193:2.3": "Imissā ca naṁ pāpapatibbatāya, ", "ja193:2.4": "Jīvantiyā chindatha kaṇṇanāsan”ti. ", "ja193:3.1": "Cūḷapadumajātakaṁ tatiyaṁ. "}, "variant_text": {"ja193:0.1": "", "ja193:0.2": "", "ja193:0.3": "", "ja193:0.4": "", "ja193:1.1": "ahamapi → ahampi (bj, sya1ed, pts-vp-pli1); ayampi (sya2ed); ahasmi (mr) ", "ja193:1.2": "", "ja193:1.3": "", "ja193:1.4": "", "ja193:2.1": "", "ja193:2.2": "", "ja193:2.3": "", "ja193:2.4": "", "ja193:3.1": "Cūḷapadumajātakaṁ → cullapadumajātakaṁ (bj, sya1ed, sya2ed, pts-vp-pli1) "}, "reference_text": {"ja193:0.1": "", "ja193:0.2": "", "ja193:0.3": "", "ja193:0.4": "", "ja193:1.1": "ms22J_476, msdiv85, pts-vp-pli2.120", "ja193:1.2": "", "ja193:1.3": "", "ja193:1.4": "", "ja193:2.1": "dr27.70, ms22J_477, msdiv86", "ja193:2.2": "", "ja193:2.3": "", "ja193:2.4": "", "ja193:3.1": "ms22J_478"}, "keys_or