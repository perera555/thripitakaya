{"html_text": {"ja283:0.1": "<article id='ja283'><header><ul><li class='division'>{}</li>", "ja283:0.2": "<li>{}</li>", "ja283:0.3": "<li>{}</li></ul>", "ja283:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja283:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja283:1.2": "<span class='verse-line'>{}</span>", "ja283:1.3": "<span class='verse-line'>{}</span>", "ja283:1.4": "<span class='verse-line'>{}</span></p>", "ja283:2.1": "<p><span class='verse-line'>{}</span>", "ja283:2.2": "<span class='verse-line'>{}</span>", "ja283:2.3": "<span class='verse-line'>{}</span>", "ja283:2.4": "<span class='verse-line'>{}</span></p>", "ja283:3.1": "<p><span class='verse-line'>{}</span>", "ja283:3.2": "<span class='verse-line'>{}</span>", "ja283:3.3": "<span class='verse-line'>{}</span>", "ja283:3.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja283:4.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja283:0.1": "Jātaka ", "ja283:0.2": "Tikanipāta ", "ja283:0.3": "Abbhantaravagga ", "ja283:0.4": "3. Vaḍḍhakīsūkarajātaka ", "ja283:1.1": "“Varaṁ varaṁ tvaṁ nihanaṁ pure cari, ", "ja283:1.2": "Asmiṁ padese abhibhuyya sūkare; ", "ja283:1.3": "So dāni eko byapagamma jhāyasi, ", "ja283:1.4": "Balaṁ nu te byaggha na cajja vijjati”. ", "ja283:2.1": "“Ime sudaṁ yanti disodisaṁ pure, ", "ja283:2.2": "Bhayaṭṭitā leṇagavesino puthū; ", "ja283:2.3": "Te dāni saṅgamma vasanti ekato, ", "ja283:2.4": "Yatthaṭṭhitā duppasahajjame mayā”. ", "ja283:3.1": "“Namatthu saṅghāna samāgatānaṁ, ", "ja283:3.2": "Disvā sayaṁ sakhya vadāmi abbhutaṁ; ", "ja283:3.3": "Byagghaṁ migā yattha jiniṁsu dāṭhino, ", "ja283:3.4": "Sāmaggiyā dāṭhabalesu muccare”ti. ", "ja283:4.1": "Vaḍḍhakīsūkarajātakaṁ tatiyaṁ. "}, "variant_text": {"ja283:0.1": "", "ja283:0.2": "", "ja283:0.3": "", "ja283:0.4": "", "ja283:1.1": "", "ja283:1.2": "", "ja283:1.3": "", "ja283:1.4": "", "ja283:2.1": "sudaṁ → imassutā (sya1ed, sya2ed, mr) ", "ja283:2.2": "", "ja283:2.3": "", "ja283:2.4": "duppasahajjame → duppasahajjime (sya1ed, sya2ed) ", "ja283:3.1": "", "ja283:3.2": "", "ja283:3.3": "", "ja283:3.4": "", "ja283:4.1": "Vaḍḍhakīsūkarajātakaṁ → vaḍḍhakisūkarajātakaṁ (pts-vp-pli1) "}, "reference_text": {"ja283:0.1": "", "ja283:0.2": "", "ja283:0.3": "", "ja283:0.4": "", "ja283:1.1": "dr27.117, ms22J_804, msdiv97, pts-vp-pli2.407, sya27.117", "ja283:1.2": "", "ja283:1.3": "", "ja283:1.4": "", "ja283:2.1": "csp1ed22.85, csp2ed22.85, ms22J_805, msdiv98", "ja283:2.2": "", "ja283:2.3": "", "ja283:2.4": "", "ja283:3.1": "bj30.148, ms22J_806, msdiv99, pts-vp-pli2.409", "ja283:3.2": "", "ja283:3.3": "", "ja283:3.4": "", "ja283:4.1": "ms22J_807"}, "keys_order": ["ja283:0.1", "ja283:0.2", "ja283:0.3", "ja283:0.4", "ja283:1.1", "ja283:1.2", "ja283:1.3", "ja283:1.4", "ja283:2.1", "ja283:2.2", "ja283:2.3", "ja283:2.4", "ja283:3.1", "ja283:3.2", "ja283:3.3", "ja283:3.4", "ja283:4.1"]}