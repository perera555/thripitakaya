[{"acronym": "Ja 262", "alt_acronym": null, "volpages": "PTS 2.324, PTS 2.326", "alt_volpages": null, "uid": "ja262", "blurb": "“A soft hand”—This story the Master told at Jetavana, about a back-sliding Brother. They brought him to the Hall of Truth, and the Master asked him if he were really a backslider? He replied, yes, he was. Then said the Master, “O Brethren! It is impossible to keep women from going after their desires. In olden days, even wise men could not guard their own daughters; while they stood holding their fathers’ hand, without their fathers’ knowing, they went away wrong-doing with a paramour”; and he told them an old-world tale.", "difficulty": null, "original_title": "Mudupāṇijātaka", "root_lang": "pli", "root_lang_name": "Pāli", "type": "leaf", "translated_title": "Mudu-Pani Jātaka", "translations": [{"lang": "pli", "lang_name": "Pāli", "is_root": true, "author": "Mahāsaṅgīti Tipiṭaka Buddhavasse 2500", "author_short": "ms", "author_uid": "ms", "publication_date": null, "id": "ja262_root-pli-ms", "segmented": true, "title": null, "volpage": null, "has_comment": false}, {"lang": "de", "lang_name": "Deutsch", "is_root": false, "author": "Dr. Julius Dutoit", "author_short": "Dutoit", "author_uid": "dutoit", "publication_date": "2007", "id": "de_ja262_dutoit", "segmented": false, "volpage": null, "has_comment": false}, {"author": "W.H.D. Rouse", "author_short": "Rouse", "author_uid": "rouse", "has_comment": false, "id": "en_ja262_rouse", "is_root": false, "lang": "en", "lang_name": "English", "publication_date": "1895", "segmented": false, "volpage": null, "title": "Mudu-Pani Jātaka"}, {"lang": "jpn", "lang_name": "日本語", "is_root": false, "author": "関西パーリ語実習会", "author_short": "関西パーリ語実習会", "author_uid": "kansai", "publication_date": "2023", "id": "jpn_ja262_kansai", "segmented": false, "volpage": null, "has_comment": false}, {"lang": "si", "lang_name": "සිංහල", "is_root": false, "author": "A.P. de Zoysa", "author_short": "Zoysa", "author_uid": "zoys