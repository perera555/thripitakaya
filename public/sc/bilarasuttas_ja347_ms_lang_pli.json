{"html_text": {"ja347:0.1": "<article id='ja347'><header><ul><li class='division'>{}</li>", "ja347:0.2": "<li>{}</li>", "ja347:0.3": "<li>{}</li></ul>", "ja347:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja347:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja347:1.2": "<span class='verse-line'>{}</span>", "ja347:1.3": "<span class='verse-line'>{}</span>", "ja347:1.4": "<span class='verse-line'>{}</span></p>", "ja347:2.1": "<p><span class='verse-line'>{}</span>", "ja347:2.2": "<span class='verse-line'>{}</span>", "ja347:2.3": "<span class='verse-line'>{}</span>", "ja347:2.4": "<span class='verse-line'>{}</span></p>", "ja347:3.1": "<p><span class='verse-line'>{}</span>", "ja347:3.2": "<span class='verse-line'>{}</span>", "ja347:3.3": "<span class='verse-line'>{}</span>", "ja347:3.4": "<span class='verse-line'>{}</span></p>", "ja347:4.1": "<p><span class='verse-line'>{}</span>", "ja347:4.2": "<span class='verse-line'>{}</span>", "ja347:4.3": "<span class='verse-line'>{}</span>", "ja347:4.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja347:5.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja347:0.1": "Jātaka ", "ja347:0.2": "Catukkanipāta ", "ja347:0.3": "Cūḷakuṇālavagga ", "ja347:0.4": "7. Ayakūṭajātaka ", "ja347:1.1": "“Sabbāyasaṁ kūṭamatippamāṇaṁ, ", "ja347:1.2": "Paggayha yo tiṭṭhasi antalikkhe; ", "ja347:1.3": "Rakkhāya me tvaṁ vihito nusajja, ", "ja347:1.4": "Udāhu me cetayase vadhāya”. ", "ja347:2.1": "“Dūto ahaṁ rājidha rakkhasānaṁ, ", "ja347:2.2": "Vadhāya tuyhaṁ pahitohamasmi; ", "ja347:2.3": "Indo ca taṁ rakkhati devarājā, ", "ja347:2.4": "Tenuttamaṅgaṁ na te phālayāmi”. ", "ja347:3.1": "“Sace ca maṁ rakkhati devarājā, ", "ja347:3.2": "Devānamindo maghavā sujampati; ", "ja347:3.3": "Kāmaṁ pisācā vinadantu sabbe, ", "ja347:3.4": "Na santase rakkhasiyā pajāya. ", "ja347:4.1": "Kāmaṁ kandantu kumbhaṇḍā, ", "ja347:4.2": "Sabbe paṁsupisācakā; ", "ja347:4.3": "Nālaṁ pisācā yuddhāya, ", "ja347:4.4": "Mahatī sā vibhiṁsikā”ti. ", "ja347:5.1": "Ayakūṭajātakaṁ sattamaṁ. "}, "variant_text": {"ja347:0.1": "", "ja347:0.2": "", "ja347:0.3": "", "ja347:0.4": "", "ja347:1.1": "", "ja347:1.2": "yo → so (bj, pts-vp-pli1) ", "ja347:1.3": "me → maṁ (sya2ed) ", "ja347:1.4": "cetayase → vāyamase (bj, sya1ed, sya2ed) ", "ja347:2.1": "", "ja347:2.2": "", "ja347:2.3": "", "ja347:2.4": "na te → na hi (si, pts-vp-pli1); te na (mr) ", "ja347:3.1": "", "ja347:3.2": "", "ja347:3.3": "", "ja347:3.4": "", "ja347:4.1": "kandantu → kaṇḍantu (sya1ed, sya2ed); kantantu (mr) ", "ja347:4.2": "", "ja347:4.3": "", "ja347:4.4": "vibhiṁsikā”ti → vibhesikāti (sya1ed, sya2ed); vihesikāti (pts-vp-pli1) ", "ja347:5.1": ""}, "reference_text": {"ja347:0.1": "", "ja347:0.2": "", "ja347:0.3": "", "ja347:0.4": "", "ja347:1.1": "csp1ed22.117, csp2ed22.117, ms22J_1121, msdiv185, pts-vp-pli3.146", "ja347:1.2": "", "ja347:1.3": "", "ja347:1.4": "", "ja347:2.1": "dr27.161, ms22J_1122, msdiv186, sya27.161", "ja347:2.2": "", "ja347:2.3": "", "ja347:2.4": "", "ja347:3.1": "bj30.202, ms22J_1123, msdiv187, pts-vp-pli3.147", "ja347:3.2": "", "ja347:3.3": "", "ja347:3.4": "", "ja347:4.1": "ms22J_1124, msdiv188", "ja347:4.2": "", "ja347:4.3": "", "ja347:4.4": "", "ja347:5.1": "ms22J_1125"}, "keys_order": ["ja347:0.1", "ja347:0.2", "ja347:0.3", "ja347:0.4", "ja347:1.1", "ja347:1.2", "ja347:1.3", "ja347:1.4", "ja347:2.1", "ja347:2.2", "ja347:2.3", "ja347:2.4", "ja347:3.1", "ja347:3.2", "ja347:3.3", "ja347:3.4", "ja347:4.1", "ja347:4.2", "ja347:4.3", "ja347:4.4", "ja347:5.1"]}