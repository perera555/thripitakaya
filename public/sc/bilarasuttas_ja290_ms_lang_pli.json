{"html_text": {"ja290:0.1": "<article id='ja290'><header><ul><li class='division'>{}</li>", "ja290:0.2": "<li>{}</li>", "ja290:0.3": "<li>{}</li></ul>", "ja290:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja290:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja290:1.2": "<span class='verse-line'>{}</span>", "ja290:1.3": "<span class='verse-line'>{}</span>", "ja290:1.4": "<span class='verse-line'>{}</span></p>", "ja290:2.1": "<p><span class='verse-line'>{}</span>", "ja290:2.2": "<span class='verse-line'>{}</span>", "ja290:2.3": "<span class='verse-line'>{}</span>", "ja290:2.4": "<span class='verse-line'>{}</span></p>", "ja290:3.1": "<p><span class='verse-line'>{}</span>", "ja290:3.2": "<span class='verse-line'>{}</span>", "ja290:3.3": "<span class='verse-line'>{}</span>", "ja290:3.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja290:4.1": "<p class='endsutta'>{}</p>", "ja290:4.2": "<p class='endvagga'>{}</p>", "ja290:5.1": "<p class='uddana-intro'>{}</p>", "ja290:6.1": "<blockquote class='uddanagatha'><p><span class='verse-line'>{}</span>", "ja290:6.2": "<span class='verse-line'>{}</span>", "ja290:6.3": "<span class='verse-line'>{}</span>", "ja290:6.4": "<span class='verse-line'>{}</span></p></blockquote></article>"}, "root_text": {"ja290:0.1": "Jātaka ", "ja290:0.2": "Tikanipāta ", "ja290:0.3": "Abbhantaravagga ", "ja290:0.4": "10. Sīlavīmaṁsakajātaka ", "ja290:1.1": "“Sīlaṁ kireva kalyāṇaṁ, ", "ja290:1.2": "sīlaṁ loke anuttaraṁ; ", "ja290:1.3": "Passa ghoraviso nāgo, ", "ja290:1.4": "sīlavāti na haññati. ", "ja290:2.1": "Sohaṁ sīlaṁ samādissaṁ, ", "ja290:2.2": "loke anumataṁ sivaṁ; ", "ja290:2.3": "Ariyavuttisamācāro, ", "ja290:2.4": "yena vuccati sīlavā. ", "ja290:3.1": "Ñātīnañca piyo hoti, ", "ja290:3.2": "mittesu ca virocati; ", "ja290:3.3": "Kāyassa bhedā sugatiṁ, ", "ja290:3.4": "upapajjati sīlavā”ti. ", "ja290:4.1": "Sīlavīmaṁsakajātakaṁ dasamaṁ. ", "ja290:4.2": "Abbhantaravaggo catuttho. ", "ja290:5.1": "Tassuddānaṁ ", "ja290:6.1": "Duma kaṁsavaruttamabyagghamigā, ", "ja290:6.2": "Maṇayo maṇi sālukamavhayano; ", "ja290:6.3": "Anusāsaniyopi ca macchavaro, ", "ja290:6.4": "Maṇikuṇḍalakena kirena dasāti. "}, "variant_text": {"ja290:0.1": "", "ja290:0.2": "", "ja290:0.3": "", "ja290:0.4": "", "ja290:1.1": "", "ja290:1.2": "", "ja290:1.3": "", "ja290:1.4": "", "ja290:2.1": "", "ja290:2.2": "", "ja290:2.3": "", "ja290:2.4": "", "ja290:3.1": "", "ja290:3.2": "", "ja290:3.3": "", "ja290:3.4": "", "ja290:4.1": "Sīlavīmaṁsakajātakaṁ → sīlavīmaṁsajātakaṁ (bj, sya1ed, sya2ed, pts-vp-pli1) ", "ja290:4.2": "", "ja290:5.1": "", "ja290:6.1": "", "ja290:6.2": "", "ja290:6.3": "", "ja290:6.4": ""}, "reference_text": {"ja290:0.1": "", "ja290:0.2": "", "ja290:0.3": "", "ja290:0.4": "", "ja290:1.1": "ms22J_832, msdiv118", "ja290:1.2": "", "ja290:1.3": "", "ja290:1.4": "", "ja290:2.1": "dr27.121, ms22J_833, msdiv119, pts-vp-pli2.430, sya27.121", "ja290:2.2": "", "ja290:2.3": "", "ja290:2.4": "", "ja290:3.1": "ms22J_834, msdiv120", "ja290:3.2": "", "ja290:3.3": "", "ja290:3.4": "", "ja290:4.1": "ms22J_835", "ja290:4.2": "", "ja290:5.1": "ms22J_836", "ja290:6.1": "csp1ed22.88, csp2ed22.88, ms22J_837, vri68.77", "ja290:6.2": "", "ja290:6.3": "", "ja290:6.4": ""}, "keys_order": ["ja290:0.1", "ja290:0.2", "ja290:0.3", "ja290:0.4", "ja290:1.1", "ja290:1.2", "ja290:1.3", "ja290:1.4", "ja290:2.1", "ja290:2.2", "ja290:2.3", "ja290:2.4", "ja290:3.1", "ja290:3.2", "ja290:3.3", "ja290:3.4", "ja290:4.1", "ja290:4.2", "ja290:5.1", "ja290:6.1", "ja290:6.2", "ja290:6.3", "ja290:6.4"]}