{"html_text": {"ja235:0.1": "<article id='ja235'><header><ul><li class='division'>{}</li>", "ja235:0.2": "<li>{}</li>", "ja235:0.3": "<li>{}</li></ul>", "ja235:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja235:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja235:1.2": "<span class='verse-line'>{}</span>", "ja235:1.3": "<span class='verse-line'>{}</span>", "ja235:1.4": "<span class='verse-line'>{}</span></p>", "ja235:2.1": "<p><span class='verse-line'>{}</span>", "ja235:2.2": "<span class='verse-line'>{}</span>", "ja235:2.3": "<span class='verse-line'>{}</span>", "ja235:2.4": "<span class='verse-line'>{}</span>", "ja235:2.5": "<span class='verse-line'>{}</span>", "ja235:2.6": "<span class='verse-line'>{}</span></p></blockquote>", "ja235:3.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja235:0.1": "Jātaka ", "ja235:0.2": "Dukanipāta ", "ja235:0.3": "Upāhanavagga ", "ja235:0.4": "5. Vacchanakhajātaka ", "ja235:1.1": "“Sukhā gharā vacchanakha, ", "ja235:1.2": "sahiraññā sabhojanā; ", "ja235:1.3": "Yattha bhutvā pivitvā ca, ", "ja235:1.4": "sayeyyātha anussuko”. ", "ja235:2.1": "“Gharā nānīhamānassa, ", "ja235:2.2": "Gharā nābhaṇato musā; ", "ja235:2.3": "Gharā nādinnadaṇḍassa, ", "ja235:2.4": "Paresaṁ anikubbato; ", "ja235:2.5": "Evaṁ chiddaṁ durabhisambhavaṁ, ", "ja235:2.6": "Ko gharaṁ paṭipajjatī”ti. ", "ja235:3.1": "Vacchanakhajātakaṁ pañcamaṁ. "}, "variant_text": {"ja235:0.1": "", "ja235:0.2": "", "ja235:0.3": "", "ja235:0.4": "", "ja235:1.1": "", "ja235:1.2": "", "ja235:1.3": "", "ja235:1.4": "", "ja235:2.1": "", "ja235:2.2": "", "ja235:2.3": "", "ja235:2.4": "anikubbato → anikrubbato (mr) ", "ja235:2.5": "durabhisambhavaṁ → durabhibhavaṁ (bj, pts-vp-pli1) ", "ja235:2.6": "", "ja235:3.1": ""}, "reference_text": {"ja235:0.1": "", "ja235:0.2": "", "ja235:0.3": "", "ja235:0.4": "", "ja235:1.1": "ms22J_614, msdiv169, pts-vp-pli2.232", "ja235:1.2": "", "ja235:1.3": "", "ja235:1.4": "", "ja235:2.1": "dr27.90, ms22J_615, msdi