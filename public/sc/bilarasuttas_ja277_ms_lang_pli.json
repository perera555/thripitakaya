{"html_text": {"ja277:0.1": "<article id='ja277'><header><ul><li class='division'>{}</li>", "ja277:0.2": "<li>{}</li>", "ja277:0.3": "<li>{}</li></ul>", "ja277:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja277:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja277:1.2": "<span class='verse-line'>{}</span>", "ja277:1.3": "<span class='verse-line'>{}</span>", "ja277:1.4": "<span class='verse-line'>{}</span></p>", "ja277:2.1": "<p><span class='verse-line'>{}</span>", "ja277:2.2": "<span class='verse-line'>{}</span>", "ja277:2.3": "<span class='verse-line'>{}</span>", "ja277:2.4": "<span class='verse-line'>{}</span></p>", "ja277:3.1": "<p><span class='verse-line'>{}</span>", "ja277:3.2": "<span class='verse-line'>{}</span>", "ja277:3.3": "<span class='verse-line'>{}</span>", "ja277:3.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja277:4.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja277:0.1": "Jātaka ", "ja277:0.2": "Tikanipāta ", "ja277:0.3": "Udapānavagga ", "ja277:0.4": "7. Romakajātaka ", "ja277:1.1": "“Vassāni paññāsa samādhikāni, ", "ja277:1.2": "Vasimha selassa guhāya romaka; ", "ja277:1.3": "Asaṅkamānā abhinibbutattā, ", "ja277:1.4": "Hatthattamāyanti mamaṇḍajā pure. ", "ja277:2.1": "Te dāni vakkaṅga kimatthamussukā, ", "ja277:2.2": "Bhajanti aññaṁ girikandaraṁ dijā; ", "ja277:2.3": "Na nūna maññanti mamaṁ yathā pure, ", "ja277:2.4": "Cirappavutthā atha vā na te ime”. ", "ja277:3.1": "“Jānāma taṁ na mayaṁ sampamūḷhā, ", "ja277:3.2": "Soyeva tvaṁ te mayamasma nāññe; ", "ja277:3.3": "Cittañca te asmiṁ jane paduṭṭhaṁ, ", "ja277:3.4": "Ājīvikā tena tamuttasāmā”ti. ", "ja277:4.1": "Romakajātakaṁ sattamaṁ. "}, "variant_text": {"ja277:0.1": "", "ja277:0.2": "", "ja277:0.3": "", "ja277:0.4": "", "ja277:1.1": "", "ja277:1.2": "", "ja277:1.3": "abhinibbutattā → abhinibbutacittā (sya1ed, sya2ed, mr) ", "ja277:1.4": "Hatthattamāyanti → hatthattha … (sya1ed, sya2ed) ", "ja277:2.1": "", "ja277:2.2": "", "ja277:2.3": "", "ja277:2.4": "", "ja277:3.1": "na mayaṁ sampamūḷhā → na maya'masma mūḷhā (bj, pts-vp-pli1); na mayaṁ sammuḷhā (sya1ed, sya2ed) ", "ja277:3.2": "", "ja277:3.3": "", "ja277:3.4": "Ājīvikā → ājīvaka (bj, sya1ed, sya2ed); ājīvika (pts-vp-pli1) ", "ja277:4.1": "Romakajātakaṁ → romajātakaṁ (sya1ed, sya2ed) "}, "reference_text": {"ja277:0.1": "", "ja277:0.2": "", "ja277:0.3": "", "ja277:0.4": "", "ja277:1.1": "csp1ed22.82, csp2ed22.82, dr27.113, ms22J_778, msdiv79, ndp22.76, pts-vp-pli2.383", "ja277:1.2": "", "ja277:1.3": "", "ja277:1.4": "", "ja277:2.1": "ms22J_779, msdiv80", "ja277:2.2": "", "ja277:2.3": "", "ja277:2.4": "", "ja277:3.1": "ms22J_780, msdiv81, pts-vp-pli2.384, sya27.114", "ja277:3.2": "", "ja277:3.3": "", "ja277:3.4": "", "ja277:4.1": "ms22J_781"}, "keys_order": ["ja277:0.1", "ja277:0.2", "ja277:0.3", "ja277:0.4", "ja277:1.1", "ja277:1.2", "ja277:1.3", "ja277:1.4", "ja277:2.1", "ja277:2.2", "ja277:2.3", "ja277:2.4", "ja277:3.1", "ja277:3.2", "ja277:3.3", "ja277:3.4", "ja277:4.1"]}