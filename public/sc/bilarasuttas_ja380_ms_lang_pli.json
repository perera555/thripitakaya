{"html_text": {"ja380:0.1": "<article id='ja380'><header><ul><li class='division'>{}</li>", "ja380:0.2": "<li>{}</li>", "ja380:0.3": "<li>{}</li></ul>", "ja380:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja380:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja380:1.2": "<span class='verse-line'>{}</span>", "ja380:1.3": "<span class='verse-line'>{}</span>", "ja380:1.4": "<span class='verse-line'>{}</span></p>", "ja380:2.1": "<p><span class='verse-line'>{}</span>", "ja380:2.2": "<span class='verse-line'>{}</span>", "ja380:2.3": "<span class='verse-line'>{}</span>", "ja380:2.4": "<span class='verse-line'>{}</span></p>", "ja380:3.1": "<p><span class='verse-line'>{}</span>", "ja380:3.2": "<span class='verse-line'>{}</span>", "ja380:3.3": "<span class='verse-line'>{}</span>", "ja380:3.4": "<span class='verse-line'>{}</span>", "ja380:3.5": "<span class='verse-line'>{}</span>", "ja380:3.6": "<span class='verse-line'>{}</span></p>", "ja380:4.1": "<p><span class='verse-line'>{}</span>", "ja380:4.2": "<span class='verse-line'>{}</span>", "ja380:4.3": "<span class='verse-line'>{}</span>", "ja380:4.4": "<span class='verse-line'>{}</span></p>", "ja380:5.1": "<p><span class='verse-line'>{}</span>", "ja380:5.2": "<span class='verse-line'>{}</span>", "ja380:5.3": "<span class='verse-line'>{}</span>", "ja380:5.4": "<span class='verse-line'>{}</span></p>", "ja380:6.1": "<p><span class='verse-line'>{}</span>", "ja380:6.2": "<span class='verse-line'>{}</span>", "ja380:6.3": "<span class='verse-line'>{}</span>", "ja380:6.4": "<span class='verse-line'>{}</span></p>", "ja380:7.1": "<p><span class='verse-line'>{}</span>", "ja380:7.2": "<span class='verse-line'>{}</span>", "ja380:7.3": "<span class='verse-line'>{}</span>", "ja380:7.4": "<span class='verse-line'>{}</span></p>", "ja380:8.1": "<p><span class='verse-line'>{}</span>", "ja380:8.2": "<span class='verse-line'>{}</span>", "ja380:8.3": "<span class='verse-line'>{}</span>", "ja380:8.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja380:9.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja380:0.1": "Jātaka ", "ja380:0.2": "Chakkanipāta ", "ja380:0.3": "Avāriyavagga ", "ja380:0.4": "5. Āsaṅkajātaka ", "ja380:1.1": "“Āsāvatī nāma latā, ", "ja380:1.2": "jātā cittalatāvane; ", "ja380:1.3": "Tassā vassasahassena, ", "ja380:1.4": "ekaṁ nibbattate phalaṁ. ", "ja380:2.1": "Taṁ devā payirupāsanti, ", "ja380:2.2": "tāva dūraphalaṁ satiṁ; ", "ja380:2.3": "Āsīseva tuvaṁ rāja, ", "ja380:2.4": "āsā phalavatī sukhā. ", "ja380:3.1": "Āsīsateva so pakkhī, ", "ja380:3.2": "āsīsateva so dijo; ", "ja380:3.3": "Tassa cāsā samijjhati, ", "ja380:3.4": "tāva dūragatā satī; ", "ja380:3.5": "Āsīseva tuvaṁ rāja, ", "ja380:3.6": "āsā phalavatī sukhā”. ", "ja380:4.1": "“Sampesi kho maṁ vācāya, ", "ja380:4.2": "na ca sampesi kammunā; ", "ja380:4.3": "Mālā sereyyakasseva, ", "ja380:4.4": "vaṇṇavantā agandhikā. ", "ja380:5.1": "Aphalaṁ madhuraṁ vācaṁ, ", "ja380:5.2": "yo mittesu pakubbati; ", "ja380:5.3": "Adadaṁ avissajaṁ bhogaṁ, ", "ja380:5.4": "sandhi tenassa jīrati. ", "ja380:6.1": "Yañhi kayirā tañhi vade, ", "ja380:6.2": "yaṁ na kayirā na taṁ vade; ", "ja380:6.3": "Akarontaṁ bhāsamānaṁ, ", "ja380:6.4": "parijānanti paṇḍitā. ", "ja380:7.1": "Balañca vata me khīṇaṁ, ", "ja380:7.2": "pātheyyañca na vijjati; ", "ja380:7.3": "Saṅke pāṇūparodhāya, ", "ja380:7.4": "handa dāni vajāmahaṁ”. ", "ja380:8.1": "“Etadeva hi me nāmaṁ, ", "ja380:8.2": "Yaṁ nāmasmi rathesabha; ", "ja380:8.3": "Āgamehi mahārāja, ", "ja380:8.4": "Pitaraṁ āmantayāmahan”ti. ", "ja380:9.1": "Āsaṅkajātakaṁ pañcamaṁ. "}, "variant_text": {"ja380:0.1": "", "ja380:0.2": "", "ja380:0.3": "", "ja380:0.4": "", "ja380:1.1": "", "ja380:1.2": "", "ja380:1.3": "", "ja380:1.4": "", "ja380:2.1": "", "ja380:2.2": "", "ja380:2.3": "Āsīseva → āsiṁseva (bj, sya1ed, sya2ed, pts-vp-pli1) ", "ja380:2.4": "", "ja380:3.1": "Āsīsateva → āsiṁsetheva (bj, pts-vp-pli1); āsiṁsatheva (sya1ed, sya2ed) ", "ja380:3.2": "āsīsateva → āsiṁsetheva (bj, pts-vp-pli1); āsiṁsatheva (sya1ed, sya2ed) ", "ja380:3.3": "Tassa cāsā → tassevāsā (sya1ed, sya2ed) ", "ja380:3.4": "", "ja380:3.5": "", "ja380:3.6": "", "ja380:4.1": "Sampesi → saṁsesi (mr) ", "ja380:4.2": "sampesi → saṁsesi (mr) ", "ja380:4.3": "", "ja380:4.4": "", "ja380:5.1": "", "ja380:5.2": "", "ja380:5.3": "", "ja380:5.4": "", "ja380:6.1": "", "ja380:6.2": "", "ja380:6.3": "", "ja380:6.4": "", "ja380:7.1": "", "ja380:7.2": "", "ja380:7.3": "", "ja380:7.4": "", "ja380:8.1": "", "ja380:8.2": "", "ja380:8.3": "", "ja380:8.4": "", "ja380:9.1": ""}, "reference_text": {"ja380:0.1": "", "ja380:0.2": "", "ja380:0.3": "", "ja380:0.4": "", "ja380:1.1": "ms22J_1347, msdiv26, pts-vp-pli3.251", "ja380:1.2": "", "ja380:1.3": "", "ja380:1.4": "", "ja380:2.1": "ms22J_1348, msdiv27", "ja380:2.2": "", "ja380:2.3": "", "ja380:2.4": "", "ja380:3.1": "ms22J_1349, msdiv28", "ja380:3.2": "", "ja380:3.3": "", "ja380:3.4": "", "ja380:3.5": "", "ja380:3.6": "", "ja380:4.1": "bj30.240, ms22J_1350, msdiv29, pts-vp-pli3.253, sya27.192", "ja380:4.2": "", "ja380:4.3": "", "ja380:4.4": "", "ja380:5.1": "ms22J_1351, msdiv30", "ja380:5.2": "", "ja380:5.3": "", "ja380:5.4": "", "ja380:6.1": "dr27.191, ms22J_1352, msdiv31, ndp22.132", "ja380:6.2": "", "ja380:6.3": "", "ja380:6.4": "", "ja380:7.1": "ms22J_1353, msdiv32", "ja380:7.2": "", "ja380:7.3": "", "ja380:7.4": "", "ja380:8.1": "csp1ed22.141, csp2ed22.141, ms22J_1354, msdiv33, pts-vp-pli3.254, vri68.119", "ja380:8.2": "", "ja380:8.3": "", "ja380:8.4": "", "ja380:9.1": "ms22J_1355"}, "keys_order": ["ja380:0.1", "ja380:0.2", "ja380:0.3", "ja380:0.4", "ja380:1.1", "ja380:1.2", "ja380:1.3", "ja380:1.4", "ja380:2.1", "ja380:2.2", "ja380:2.3", "ja380:2.4", "ja380:3.1", "ja380:3.2", "ja380:3.3", "ja380:3.4", "ja380:3.5", "ja380:3.6", "ja380:4.1", "ja380:4.2", "ja380:4.3", "ja380:4.4", "ja380:5.1", "ja380:5.2", "ja380:5.3", "ja380:5.4", "ja380:6.1", "ja380:6.2", "ja380:6.3", "ja380:6.4", "ja380:7.1", "ja380:7.2", "ja380:7.3", "ja380:7.4