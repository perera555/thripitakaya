{"html_text": {"ja264:0.1": "<article id='ja264'><header><ul><li class='division'>{}</li>", "ja264:0.2": "<li>{}</li>", "ja264:0.3": "<li>{}</li></ul>", "ja264:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja264:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja264:1.2": "<span class='verse-line'>{}</span>", "ja264:1.3": "<span class='verse-line'>{}</span>", "ja264:1.4": "<span class='verse-line'>{}</span></p>", "ja264:2.1": "<p><span class='verse-line'>{}</span>", "ja264:2.2": "<span class='verse-line'>{}</span>", "ja264:2.3": "<span class='verse-line'>{}</span>", "ja264:2.4": "<span class='verse-line'>{}</span></p>", "ja264:3.1": "<p><span class='verse-line'>{}</span>", "ja264:3.2": "<span class='verse-line'>{}</span>", "ja264:3.3": "<span class='verse-line'>{}</span>", "ja264:3.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja264:4.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja264:0.1": "Jātaka ", "ja264:0.2": "Tikanipāta ", "ja264:0.3": "Padumavagga ", "ja264:0.4": "4. Mahāpanādajātaka ", "ja264:1.1": "“Panādo nāma so rājā, ", "ja264:1.2": "yassa yūpo suvaṇṇayo; ", "ja264:1.3": "Tiriyaṁ soḷasubbedho, ", "ja264:1.4": "uddhamāhu sahassadhā. ", "ja264:2.1": "Sahassakaṇḍo satageṇḍu, ", "ja264:2.2": "dhajālu haritāmayo; ", "ja264:2.3": "Anaccuṁ tattha gandhabbā, ", "ja264:2.4": "cha sahassāni sattadhā. ", "ja264:3.1": "Evametaṁ tadā āsi, ", "ja264:3.2": "yathā bhāsasi bhaddaji; ", "ja264:3.3": "Sakko ahaṁ tadā āsiṁ, ", "ja264:3.4": "veyyāvaccakaro tavā”ti. ", "ja264:4.1": "Mahāpanādajātakaṁ catutthaṁ. "}, "variant_text": {"ja264:0.1": "", "ja264:0.2": "", "ja264:0.3": "", "ja264:0.4": "", "ja264:1.1": "Panādo → paṇādo (bj) ", "ja264:1.2": "", "ja264:1.3": "soḷasubbedho → soḷasapabbedho (bj, pts-vp-pli1) ", "ja264:1.4": "uddhamāhu → uccamāhu (bj, sya1ed, sya2ed, pts-vp-pli1) ", "ja264:2.1": "Sahassakaṇḍo → sahassakaṇḍaṁ (bj) | satageṇḍu → satabheṇḍuṁ (bj); satabhedo (pts-vp-pli1) ", "ja264:2.2": "", "ja264:2.3": "", "ja264:2.4": "", "ja264:3.1": "Evametaṁ → evameva (mr) ", "ja264:3.2": "", "ja264:3.3": "", "ja264:3.4": "", "ja264:4.1": "Mahāpanādajātakaṁ → mahāpaṇādajātakaṁ (bj) "}, "reference_text": {"ja264:0.1": "", "ja264:0.2": "", "ja264:0.3": "", "ja264:0.4": "", "ja264:1.1": "ms22J_724, msdiv40, pts-vp-pli2.334", "ja264:1.2": "", "ja264:1.3": "", "ja264:1.4": "", "ja264:2.1": "bj30.134, ms22J_725, msdiv41", "ja264:2.2": "", "ja264:2.3": "", "ja264:2.4": "", "ja264:3.1": "ms22J_726, msdiv42", "ja264:3.2": "", "ja264:3.3": "", "ja264:3.4": "", "ja264:4.1": "ms22J_727"}, "keys_order": ["ja264:0.1", "ja264:0.2", "ja264:0.3", "ja264:0.4", "ja264:1.1", "ja264:1.2", "ja264:1.3", "ja264:1.4", "ja264:2.1", "ja264:2.2", "ja264:2.3", "ja264:2.4", "ja264:3.1", "ja264:3.2", "ja264:3.3", "ja264:3.4", "ja264:4.1"]}