{"html_text": {"ja322:0.1": "<article id='ja322'><header><ul><li class='division'>{}</li>", "ja322:0.2": "<li>{}</li>", "ja322:0.3": "<li>{}</li></ul>", "ja322:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja322:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja322:1.2": "<span class='verse-line'>{}</span>", "ja322:1.3": "<span class='verse-line'>{}</span>", "ja322:1.4": "<span class='verse-line'>{}</span></p>", "ja322:2.1": "<p><span class='verse-line'>{}</span>", "ja322:2.2": "<span class='verse-line'>{}</span>", "ja322:2.3": "<span class='verse-line'>{}</span>", "ja322:2.4": "<span class='verse-line'>{}</span></p>", "ja322:3.1": "<p><span class='verse-line'>{}</span>", "ja322:3.2": "<span class='verse-line'>{}</span>", "ja322:3.3": "<span class='verse-line'>{}</span>", "ja322:3.4": "<span class='verse-line'>{}</span></p>", "ja322:4.1": "<p><span class='verse-line'>{}</span>", "ja322:4.2": "<span class='verse-line'>{}</span>", "ja322:4.3": "<span class='verse-line'>{}</span>", "ja322:4.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja322:5.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja322:0.1": "Jātaka ", "ja322:0.2": "Catukkanipāta ", "ja322:0.3": "Kuṭidūsakavagga ", "ja322:0.4": "2. Duddubhajātaka ", "ja322:1.1": "“Duddubhāyati bhaddante, ", "ja322:1.2": "yasmiṁ dese vasāmahaṁ; ", "ja322:1.3": "Ahampetaṁ na jānāmi, ", "ja322:1.4": "kimetaṁ duddubhāyati”. ", "ja322:2.1": "“Beluvaṁ patitaṁ sutvā, ", "ja322:2.2": "duddubhanti saso javi; ", "ja322:2.3": "Sasassa vacanaṁ sutvā, ", "ja322:2.4": "santattā migavāhinī. ", "ja322:3.1": "Appatvā padaviññāṇaṁ, ", "ja322:3.2": "paraghosānusārino; ", "ja322:3.3": "Panādaparamā bālā, ", "ja322:3.4": "te honti parapattiyā. ", "ja322:4.1": "Ye ca sīlena sampannā, ", "ja322:4.2": "paññāyūpasame ratā; ", "ja322:4.3": "Ārakā viratā dhīrā, ", "ja322:4.4": "na honti parapattiyā”ti. ", "ja322:5.1": "Duddubhajātakaṁ dutiyaṁ. "}, "variant_text": {"ja322:0.1": "", "ja322:0.2": "", "ja322:0.3": "", "ja322:0.4": "", "ja322:1.1": "Duddubhāyati → daddabhāyati (bj, pts-vp-pli1) ", "ja322:1.2": "", "ja322:1.3": "", "ja322:1.4": "", "ja322:2.1": "Beluvaṁ → veluvaṁ (sya1ed, sya2ed); bellaṁ (pts-vp-pli1) ", "ja322:2.2": "duddubhanti → daddabhanti (bj); dabhakkanti (pts-vp-pli1) ", "ja322:2.3": "", "ja322:2.4": "", "ja322:3.1": "", "ja322:3.2": "", "ja322:3.3": "", "ja322:3.4": "", "ja322:4.1": "", "ja322:4.2": "", "ja322:4.3": "", "ja322:4.4": "", "ja322:5.1": "Duddubhajātakaṁ → daddabhajātakaṁ (bj, pts-vp-pli1); daddubhāyajātakaṁ (sya1ed, sya2ed) "}, "reference_text": {"ja322:0.1": "", "ja322:0.2": "", "ja322:0.3": "", "ja322:0.4": "", "ja322:1.1": "ms22J_992, msdiv85, pts-vp-pli3.77", "ja322:1.2": "", "ja322:1.3": "", "ja322:1.4": "", "ja322:2.1": "ms22J_993, msdiv86, sya27.143", "ja322:2.2": "", "ja322:2.3": "", "ja322:2.4": "", "ja322:3.1": "dr27.143, ms22J_994, msdiv87", "ja322:3.2": "", "ja322:3.3": "", "ja322:3.4": "", "ja322:4.1": "ms22J_995, msdiv88, pts-vp-pli3.78", "ja322:4.2": "", "ja322:4.3": "", "ja322:4.4": "", "ja322:5.1": "ms22J_996"}, "keys_order": ["ja322:0.1", "ja322:0.2", "ja322:0.3", "ja322:0.4", "ja322:1.1", "ja322:1.2", "ja322:1.3", "ja322:1.4", "ja322:2.1", "ja322:2.2", "ja322:2.3", "ja322:2.4", "ja322:3.1", "ja322:3.2", "ja322:3.3", "ja322:3.4", "ja322:4.1", "ja322:4.2", "ja322:4.3", "ja322:4.4", "ja322:5.1"]}