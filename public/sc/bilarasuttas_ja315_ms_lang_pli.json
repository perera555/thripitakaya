{"html_text": {"ja315:0.1": "<article id='ja315'><header><ul><li class='division'>{}</li>", "ja315:0.2": "<li>{}</li>", "ja315:0.3": "<li>{}</li></ul>", "ja315:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja315:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja315:1.2": "<span class='verse-line'>{}</span>", "ja315:1.3": "<span class='verse-line'>{}</span>", "ja315:1.4": "<span class='verse-line'>{}</span></p>", "ja315:2.1": "<p><span class='verse-line'>{}</span>", "ja315:2.2": "<span class='verse-line'>{}</span>", "ja315:2.3": "<span class='verse-line'>{}</span>", "ja315:2.4": "<span class='verse-line'>{}</span></p>", "ja315:3.1": "<p><span class='verse-line'>{}</span>", "ja315:3.2": "<span class='verse-line'>{}</span>", "ja315:3.3": "<span class='verse-line'>{}</span>", "ja315:3.4": "<span class='verse-line'>{}</span></p>", "ja315:4.1": "<p><span class='verse-line'>{}</span>", "ja315:4.2": "<span class='verse-line'>{}</span>", "ja315:4.3": "<span class='verse-line'>{}</span>", "ja315:4.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja315:5.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja315:0.1": "Jātaka ", "ja315:0.2": "Catukkanipāta ", "ja315:0.3": "Pucimandavagga ", "ja315:0.4": "5. Sabbamaṁsalābhajātaka ", "ja315:1.1": "“Pharusā vata te vācā, ", "ja315:1.2": "maṁsaṁ yācanako asi; ", "ja315:1.3": "Kilomasadisī vācā, ", "ja315:1.4": "kilomaṁ samma dammi te”. ", "ja315:2.1": "“Aṅgametaṁ manussānaṁ, ", "ja315:2.2": "bhātā loke pavuccati; ", "ja315:2.3": "Aṅgassa sadisī vācā, ", "ja315:2.4": "aṅgaṁ samma dadāmi te”. ", "ja315:3.1": "“Tātāti putto vadamāno, ", "ja315:3.2": "kampeti hadayaṁ pitu; ", "ja315:3.3": "Hadayassa sadisī vācā, ", "ja315:3.4": "hadayaṁ samma dammi te”. ", "ja315:4.1": "“Yassa gāme sakhā natthi, ", "ja315:4.2": "yathāraññaṁ tatheva taṁ; ", "ja315:4.3": "Sabbassa sadisī vācā, ", "ja315:4.4": "sabbaṁ samma dadāmi te”ti. ", "ja315:5.1": "Sabbamaṁsalābhajātakaṁ pañcamaṁ. "}, "variant_text": {"ja315:0.1": "", "ja315:0.2": "", "ja315:0.3": "", "ja315:0.4": "", "ja315:1.1": "", "ja315:1.2": "maṁsaṁ → samma (pts-vp-pli1, mr) | asi → casi (pts-vp-pli1) ", "ja315:1.3": "Kilomasadisī → kilomassa sadisā (pts-vp-pli1) ", "ja315:1.4": "", "ja315:2.1": "", "ja315:2.2": "", "ja315:2.3": "Aṅgassa sadisī vācā → aṅgassadisī te vācā (mr) ", "ja315:2.4": "", "ja315:3.1": "", "ja315:3.2": "kampeti → sammeti (mr) ", "ja315:3.3": "Hadayassa sadisī → hadayassadisī (mr) ", "ja315:3.4": "", "ja315:4.1": "", "ja315:4.2": "", "ja315:4.3": "", "ja315:4.4": "", "ja315:5.1": "Sabbamaṁsalābhajātakaṁ → maṁsajātakaṁ (bj, sya1ed, sya2ed, pts-vp-pli1) "}, "reference_text": {"ja315:0.1": "", "ja315:0.2": "", "ja315:0.3": "", "ja315:0.4": "", "ja315:1.1": "ms22J_955, msdiv57, ndp22.93, pts-vp-pli3.49, vri68.87", "ja315:1.2": "", "ja315:1.3": "", "ja315:1.4": "", "ja315:2.1": "ms22J_956, msdiv58, pts-vp-pli3.50", "ja315:2.2": "", "ja315:2.3": "", "ja315:2.4": "", "ja315:3.1": "ms22J_957, msdiv59", "ja315:3.2": "", "ja315:3.3": "", "ja315:3.4": "", "ja315:4.1": "ms22J_958, msdiv60", "ja315:4.2": "", "ja315:4.3": "", "ja315:4.4": "", "ja315:5.1": "ms22J_959"}, "keys_order": ["ja315:0.1", "ja315:0.2", "ja315:0.3", "ja315:0.4", "ja315:1.1", "ja315:1.2", "ja315:1.3", "ja315:1.4", "ja315:2.1", "ja315:2.2", "ja315:2.3", "ja315:2.4", "ja315:3.1", "ja315:3.2", "ja315:3.3", "ja315:3.4", "ja315:4.1", "ja315:4.2", "ja315:4.3", "ja315:4.4", "ja315:5.1"]}