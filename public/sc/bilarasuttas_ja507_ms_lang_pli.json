p>", "ja507:28.1": "<p><span class='verse-line'>{}</span>", "ja507:28.2": "<span class='verse-line'>{}</span>", "ja507:28.3": "<span class='verse-line'>{}</span>", "ja507:28.4": "<span class='verse-line'>{}</span></p>", "ja507:29.1": "<p><span class='verse-line'>{}</span>", "ja507:29.2": "<span class='verse-line'>{}</span>", "ja507:29.3": "<span class='verse-line'>{}</span>", "ja507:29.4": "<span class='verse-line'>{}</span></p>", "ja507:30.1": "<p><span class='verse-line'>{}</span>", "ja507:30.2": "<span class='verse-line'>{}</span>", "ja507:30.3": "<span class='verse-line'>{}</span>", "ja507:30.4": "<span class='verse-line'>{}</span></p>", "ja507:31.1": "<p><span class='verse-line'>{}</span>", "ja507:31.2": "<span class='verse-line'>{}</span>", "ja507:31.3": "<span class='verse-line'>{}</span>", "ja507:31.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja507:32.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja507:0.1": "Jātaka ", "ja507:0.2": "Vīsatinipāta ", "ja507:0.3": "Mātaṅgavagga ", "ja507:0.4": "11. Mahāpalobhanajātaka ", "ja507:1.1": "Brahmalokā cavitvāna, ", "ja507:1.2": "devaputto mahiddhiko; ", "ja507:1.3": "Rañño putto udapādi, ", "ja507:1.4": "sabbakāmasamiddhisu. ", "ja507:2.1": "Kāmā vā kāmasaññā vā, ", "ja507:2.2": "brahmaloke na vijjati; ", "ja507:2.3": "Svāssu tāyeva saññāya, ", "ja507:2.4": "kāmehi vijigucchatha. ", "ja507:3.1": "Tassa cantepure āsi, ", "ja507:3.2": "jhānāgāraṁ sumāpitaṁ; ", "ja507:3.3": "So tattha paṭisallīno, ", "ja507:3.4": "eko rahasi jhāyatha. ", "ja507:4.1": "Sa rājā paridevesi, ", "ja507:4.2": "puttasokena aṭṭito; ", "ja507:4.3": "“Ekaputto cayaṁ mayhaṁ, ", "ja507:4.4": "na ca kāmāni bhuñjati. ", "ja507:5.1": "Ko nu khvettha upāyo so, ", "ja507:5.2": "ko vā jānāti kiñcanaṁ; ", "ja507:5.3": "Yo me puttaṁ palobheyya, ", "ja507:5.4": "yathā kāmāni patthaye”. ", "ja507:6.1": "Ahu kumārī tattheva, ", "ja507:6.2": "vaṇṇarūpasamāhitā; ", "ja507:6.3": "Kusalā naccagītassa, ", "ja507:6.4": "vādite ca padakkhiṇā. ", "ja507:7.1": "Sā tattha upasaṅkamma, ", "ja507:7.2": "rājānaṁ etadabravi; ", "ja507:7.3": "“Ahaṁ kho naṁ palobheyyaṁ, ", "ja507:7.4": "sace bhattā bhavissati”. ", "ja507:8.1": "Taṁ tathāvādiniṁ rājā, ", "ja507:8.2": "kumāriṁ etadabravi; ", "ja507:8.3": "“Tvaññeva naṁ palobhehi, ", "ja507:8.4": "tava bhattā bhavissati”. ", "ja507:9.1": "Sā ca antepuraṁ gantvā, ", "ja507:9.2": "bahuṁ kāmupasaṁhitaṁ; ", "ja507:9.3": "Hadayaṅgamā pemanīyā, ", "ja507:9.4": "citrā gāthā abhāsatha. ", "ja507:10.1": "Tassā ca gāyamānāya, ", "ja507:10.2": "saddaṁ sutvāna nāriyā; ", "ja507:10.3": "Kāmacchandassa uppajji, ", "ja507:10.4": "janaṁ so paripucchatha. ", "ja507:11.1": "“Kasseso saddo ko vā so, ", "ja507:11.2": "bhaṇati uccāvacaṁ bahuṁ; ", "ja507:11.3": "Hadayaṅgamaṁ pemanīyaṁ, ", "ja507:11.4": "aho kaṇṇasukhaṁ mama”. ", "ja507:12.1": "“Esā kho pamadā deva, ", "ja507:12.2": "khiḍḍā esā anappikā; ", "ja507:12.3": "Sace tvaṁ kāme bhuñjeyya, ", "ja507:12.4": "bhiyyo bhiyyo chādeyyu taṁ”. ", "ja507:13.1": "“Iṅgha āgacchatorena, ", "ja507:13.2": "avidūramhi gāyatu; ", "ja507:13.3": "Assamassa samīpamhi, ", "ja507:13.4": "santike mayhaṁ gāyatu”. ", "ja507:14.1": "Tirokuṭṭamhi gāyitvā, ", "ja507:14.2": "jhānāgāramhi pāvisi; ", "ja507:14.3": "Bandhi naṁ anupubbena, ", "ja507:14.4": "āraññamiva kuñjaraṁ. ", "ja507:15.1": "Tassa kāmarasaṁ ñatvā, ", "ja507:15.2": "issādhammo ajāyatha; ", "ja507:15.3": "“Ahameva kāme bhuñjeyyaṁ, ", "ja507:15.4": "mā añño puriso ahu”. ", "ja507:16.1": "Tato asiṁ gahetvāna, ", "ja507:16.2": "purise hantuṁ upakkami; ", "ja507:16.3": "“Ahameveko bhuñjissaṁ, ", "ja507:16.4": "mā añño puriso siyā”. ", "ja507:17.1": "Tato jānapadā sabbe, ", "ja507:17.2": "vikkandiṁsu samāgatā; ", "ja507:17.3": "“Putto tyāyaṁ mahārāja, ", "ja507:17.4": "janaṁ heṭhetyadūsakaṁ”. ", "ja507:18.1": "Tañca rājā vivāhesi, ", "ja507:18.2": "samhā raṭṭhā ca khattiyo; ", "ja507:18.3": "“Yāvatā vijitaṁ mayhaṁ, ", "ja507:18.4": "na te vatthabba tāvade”. ", "ja507:19.1": "Tato so bhariyamādāya, ", "ja507:19.2": "samuddaṁ upasaṅkami; ", "ja507:19.3": "Paṇṇasālaṁ karitvāna, ", "ja507:19.4": "vanamuñchāya pāvisi. ", "ja507:20.1": "Athettha isi māgacchi, ", "ja507:20.2": "samuddaṁ uparūpari; ", "ja507:20.3": "So tassa gehaṁ pāvekkhi, ", "ja507:20.4": "bhattakāle upaṭṭhite. ", "ja507:21.1": "Tañca bhariyā palobhesi, ", "ja507:21.2": "passa yāva sudāruṇaṁ; ", "ja507:21.3": "Cuto so brahmacariyamhā, ", "ja507:21.4": "iddhiyā parihāyatha. ", "ja507:22.1": "Rājaputto ca uñchāto, ", "ja507:22.2": "vanamūlaphalaṁ bahuṁ; ", "ja507:22.3": "Sāyaṁ kājena ādāya, ", "ja507:22.4": "assamaṁ upasaṅkami. ", "ja507:23.1": "Isī ca khattiyaṁ disvā, ", "ja507:23.2": "samuddaṁ upasaṅkami; ", "ja507:23.3": "“Vehāyasaṁ gamissan”ti, ", "ja507:23.4": "sīdate so mahaṇṇave. ", "ja507:24.1": "Khattiyo ca isiṁ disvā, ", "ja507:24.2": "sīdamānaṁ mahaṇṇave; ", "ja507:24.3": "Tasseva anukampāya, ", "ja507:24.4": "imā gāthā abhāsatha. ", "ja507:25.1": "“Abhijjamāne vārismiṁ, ", "ja507:25.2": "sayaṁ āgamma iddhiyā; ", "ja507:25.3": "Missībhāvitthiyā gantvā, ", "ja507:25.4": "saṁsīdasi mahaṇṇave. ", "ja507:26.1": "Āvaṭṭanī mahāmāyā, ", "ja507:26.2": "brahmacariyavikopanā; ", "ja507:26.3": "Sīdanti naṁ viditvāna, ", "ja507:26.4": "ārakā parivajjaye. ", "ja507:27.1": "Analā mudusambhāsā, ", "ja507:27.2": "duppūrā tā nadīsamā; ", "ja507:27.3": "Sīdanti naṁ viditvāna, ", "ja507:27.4": "ārakā parivajjaye. ", "ja507:28.1": "Yaṁ etā upasevanti, ", "ja507:28.2": "chandasā vā dhanena vā; ", "ja507:28.3": "Jātavedova saṁ ṭhānaṁ, ", "ja507:28.4": "khippaṁ anudahanti naṁ”. ", "ja507:29.1": "Khattiyassa vaco sutvā, ", "ja507:29.2": "isissa nibbidā ahu; ", "ja507:29.3": "Laddhā porāṇakaṁ maggaṁ, ", "ja507:29.4": "gacchate so vihāyasaṁ. ", "ja507:30.1": "Khattiyo ca isiṁ disvā, ", "ja507:30.2": "gacchamānaṁ vihāyasaṁ; ", "ja507:30.3": "Saṁvegaṁ alabhī dhīro, ", "ja507:30.4": "pabbajjaṁ samarocayi. ", "ja507:31.1": "Tato so pabbajitvāna, ", "ja507:31.2": "kāmarāgaṁ virājayi; ", "ja507:31.3": "Kāmarāgaṁ virājetvā, ", "ja507:31.4": "brahmalokūpago ahūti. ", "ja507:32.1": "Mahāpalobhanajātakaṁ ekādasamaṁ. "}, "variant_text": {"ja507:0.1": "", "ja507:0.2": "", "ja507:0.3": "", "ja507:0.4": "", "ja507:1.1": "", "ja507:1.2": "", "ja507:1.3": "", "ja507:1.4": "", "ja507:2.1": "", "ja507:2.2": "", "ja507:2.3": "Svāssu → yvāssa (bj) ", "ja507:2.4": "", "ja507:3.1": "Tassa → tassā (sya1ed, sya2ed) ", "ja507:3.2": "", "ja507:3.3": "paṭisallīno → patasallīno (bj); patisallīno (pts-vp-pli1); paṭisallāno (mr) ", "ja507:3.4": "", "ja507:4.1": "", "ja507:4.2": "", "ja507:4.3": "", "ja507:4.4": "", "ja507:5.1": "khvettha → khettha (bj, pts-vp-pli1) ", "ja507:5.2": "", "ja507:5.3": "Yo → ko (bj, pts-vp-pli1) ", "ja507:5.4": "", "ja507:6.1": "", "ja507:6.2": "", "ja507:6.3": "", "ja507:6.4": "", "ja507:7.1": "", "ja507:7.2": "", "ja507:7.3": "", "ja507:7.4": "", "ja507:8.1": "", "ja507:8.2": "", "ja507:8.3": "", "ja507:8.4": "", "ja507:9.1": "", "ja507:9.2": "", "ja507:9.3": "", "ja507:9.4": "", "ja507:10.1": "", "ja507:10.2": "", "ja507:10.3": "", "ja507:10.4": "", "ja507:11.1": "", "ja507:11.2": "", "ja507:11.3": "", "ja507:11.4": "aho → atho (bj, pts-vp-pli1) ", "ja507:12.1": "", "ja507:12.2": "anappikā → anappakā (mr) ", "ja507:12.3": "", "ja507:12.4": "", "ja507:13.1": "āgacchatorena → āgaccha corena (pts-vp-pli1); āgacchatorenaṁ (mr) ", "ja507:13.2": "", "ja507:13.3": "", "ja507:13.4": "", "ja507:14.1": "", "ja507:14.2": "", "ja507:14.3": "Bandhi naṁ → bhandhituṁ (sya1ed, sya2ed, mr) ", "ja507:14.4": "", "ja507:15.1": "", "ja507:15.2": "", "ja507:15.3": "", "ja507:15.4": "", "ja507:16.1": "", "ja507:16.2": "", "ja507:16.3": "", "ja507:16.4": "", "ja507:17.1": "", "ja507:17.2": "", "ja507:17.3": "", "ja507:17.4": "", "ja507:18.1": "vivāhesi → nivāhesi (sya1ed, sya2ed); vihāhesi (pts-vp-pli1) ", "ja507:18.2": "raṭṭhā ca → raṭṭhāto (bj, pts-vp-pli1); raṭṭhato (mr) ", "ja507:18.3": "", "ja507:18.4": "vatthabba → vattabba (bj, pts-vp-pli1) ", "ja507:19.1": "", "ja507:19.2": "", "ja5