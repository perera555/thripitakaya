{"html_text": {"ja312:0.1": "<article id='ja312'><header><ul><li class='division'>{}</li>", "ja312:0.2": "<li>{}</li>", "ja312:0.3": "<li>{}</li></ul>", "ja312:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja312:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja312:1.2": "<span class='verse-line'>{}</span>", "ja312:1.3": "<span class='verse-line'>{}</span>", "ja312:1.4": "<span class='verse-line'>{}</span></p>", "ja312:2.1": "<p><span class='verse-line'>{}</span>", "ja312:2.2": "<span class='verse-line'>{}</span>", "ja312:2.3": "<span class='verse-line'>{}</span>", "ja312:2.4": "<span class='verse-line'>{}</span></p>", "ja312:3.1": "<p><span class='verse-line'>{}</span>", "ja312:3.2": "<span class='verse-line'>{}</span>", "ja312:3.3": "<span class='verse-line'>{}</span>", "ja312:3.4": "<span class='verse-line'>{}</span></p>", "ja312:4.1": "<p><span class='verse-line'>{}</span>", "ja312:4.2": "<span class='verse-line'>{}</span>", "ja312:4.3": "<span class='verse-line'>{}</span>", "ja312:4.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja312:5.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja312:0.1": "Jātaka ", "ja312:0.2": "Catukkanipāta ", "ja312:0.3": "Pucimandavagga ", "ja312:0.4": "2. Kassapamandiyajātaka ", "ja312:1.1": "“Api kassapa mandiyā, ", "ja312:1.2": "yuvā sapati hanti vā; ", "ja312:1.3": "Sabbaṁ taṁ khamate dhīro, ", "ja312:1.4": "paṇḍito taṁ titikkhati. ", "ja312:2.1": "Sacepi santo vivadanti, ", "ja312:2.2": "khippaṁ sandhīyare puna; ", "ja312:2.3": "Bālā pattāva bhijjanti, ", "ja312:2.4": "na te samathamajjhagū. ", "ja312:3.1": "Ete bhiyyo samāyanti, ", "ja312:3.2": "sandhi tesaṁ na jīrati; ", "ja312:3.3": "Yo cādhipannaṁ jānāti, ", "ja312:3.4": "yo ca jānāti desanaṁ. ", "ja312:4.1": "Eso hi uttaritaro, ", "ja312:4.2": "Bhāravaho dhuraddharo; ", "ja312:4.3": "Yo paresādhipannānaṁ, ", "ja312:4.4": "Sayaṁ sandhātumarahatī”ti. ", "ja312:5.1": "Kassapamandiyajātakaṁ dutiyaṁ. "}, "variant_text": {"