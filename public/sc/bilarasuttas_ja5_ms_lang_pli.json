{"html_text": {"ja5:0.1": "<article id='ja5'><header><ul><li class='division'>{}</li>", "ja5:0.2": "<li>{}</li>", "ja5:0.3": "<li>{}</li></ul>", "ja5:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja5:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja5:1.2": "<span class='verse-line'>{}</span>", "ja5:1.3": "<span class='verse-line'>{}</span>", "ja5:1.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja5:2.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja5:0.1": "Jātaka ", "ja5:0.2": "Ekakanipāta ", "ja5:0.3": "Apaṇṇakavagga ", "ja5:0.4": "5. Taṇḍulanāḷijātaka ", "ja5:1.1": "“Kimagghati taṇḍulanāḷikāyaṁ, ", "ja5:1.2": "Assāna mūlāya vadehi rāja; ", "ja5:1.3": "Bārāṇasiṁ santarabāhirantaṁ, ", "ja5:1.4": "Ayamagghati taṇḍulanāḷikā”ti. ", "ja5:2.1": "Taṇḍulanāḷijātakaṁ pañcamaṁ. "}, "variant_text": {"ja5:0.1": "", "ja5:0.2": "", "ja5:0.3": "", "ja5:0.4": "", "ja5:1.1": "Kimagghati… taṇḍulanāḷikā”ti → kimagghatī taṇḍulanāḷikā ca, bārāṇasīantarabāhirāni. assapañcasatetāni, ekā taṇḍulanāḷikāti. (sya1ed, sya2ed) | taṇḍulanāḷikāyaṁ → … nāḷikā ca (si, sya1ed, sya2ed); … nāḷikāya (bj-a) ", "ja5:1.2": "", "ja5:1.3": "santarabāhirantaṁ → bāhirāni (sya1ed, sya2ed); … bāhirato (csp1ed) ", "ja5:1.4": "", "ja5:2.1": "Taṇḍulanāḷijātakaṁ → taṇḍulanālijātakaṁ (pts-vp-pli1) "}, "reference_text": {"ja5:0.1": "", "ja5:0.2": "", "ja5:0.3": "", "ja5:0.4": "", "ja5:1.1": "bj30.4, ms22J_10, msdiv5, pts-vp-pli1.123", "ja5:1.2": "", "ja5:1.3": "", "ja5:1.4": "", "ja5:2.1": "ms22J_11"}, "keys_order": ["ja5:0.1", "ja5:0.2", "ja5:0.3", "ja5:0.4", "ja5:1.1", "ja5:1.2", "ja5:1.3", "ja5:1.4", "ja5:2.1"]}