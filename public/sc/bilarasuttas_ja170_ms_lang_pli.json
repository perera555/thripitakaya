{"html_text": {"ja170:0.1": "<article id='ja170'><header><ul><li class='division'>{}</li>", "ja170:0.2": "<li>{}</li>", "ja170:0.3": "<li>{}</li></ul>", "ja170:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja170:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja170:1.2": "<span class='verse-line'>{}</span>", "ja170:1.3": "<span class='verse-line'>{}</span>", "ja170:1.4": "<span class='verse-line'>{}</span></p>", "ja170:2.1": "<p><span class='verse-line'>{}</span>", "ja170:2.2": "<span class='verse-line'>{}</span>", "ja170:2.3": "<span class='verse-line'>{}</span>", "ja170:2.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja170:3.1": "<p class='endsutta'>{}</p>", "ja170:3.2": "<p class='endvagga'>{}</p>", "ja170:4.1": "<p class='uddana-intro'>{}</p>", "ja170:5.1": "<blockquote class='uddanagatha'><p><span class='verse-line'>{}</span>", "ja170:5.2": "<span class='verse-line'>{}</span>", "ja170:5.3": "<span class='verse-line'>{}</span>", "ja170:5.4": "<span class='verse-line'>{}</span></p></blockquote></article>"}, "root_text": {"ja170:0.1": "Jātaka ", "ja170:0.2": "Dukanipāta ", "ja170:0.3": "Santhavavagga ", "ja170:0.4": "10. Kakaṇṭakajātaka ", "ja170:1.1": "“Nāyaṁ pure uṇṇamati, ", "ja170:1.2": "toraṇagge kakaṇṭako; ", "ja170:1.3": "Mahosadha vijānāhi, ", "ja170:1.4": "kena thaddho kakaṇṭako”. ", "ja170:2.1": "“Aladdhapubbaṁ laddhāna, ", "ja170:2.2": "aḍḍhamāsaṁ kakaṇṭako; ", "ja170:2.3": "Atimaññati rājānaṁ, ", "ja170:2.4": "vedehaṁ mithilaggahan”ti. ", "ja170:3.1": "Kakaṇṭakajātakaṁ dasamaṁ. ", "ja170:3.2": "Santhavavaggo dutiyo. ", "ja170:4.1": "Tassuddānaṁ ", "ja170:5.1": "Atha indasamāna sapaṇṇakuṭi, ", "ja170:5.2": "Susimuttama gijjha jalābujako; ", "ja170:5.3": "Upasāḷaka bhikkhu salāpavaro, ", "ja170:5.4": "Atha mettavaro dasapuṇṇamatīti. "}, "variant_text": {"ja170:0.1": "", "ja170:0.2": "", "ja170:0.3": "", "ja170:0.4": "", "ja170:1.1": "uṇṇamati → unnamati (sya1ed, sya2ed) ", "ja170:1.2": "", "ja170:1.3": "", "ja