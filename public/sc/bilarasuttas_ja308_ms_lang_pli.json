{"html_text": {"ja308:0.1": "<article id='ja308'><header><ul><li class='division'>{}</li>", "ja308:0.2": "<li>{}</li>", "ja308:0.3": "<li>{}</li></ul>", "ja308:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja308:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja308:1.2": "<span class='verse-line'>{}</span>", "ja308:1.3": "<span class='verse-line'>{}</span>", "ja308:1.4": "<span class='verse-line'>{}</span></p>", "ja308:2.1": "<p><span class='verse-line'>{}</span>", "ja308:2.2": "<span class='verse-line'>{}</span>", "ja308:2.3": "<span class='verse-line'>{}</span>", "ja308:2.4": "<span class='verse-line'>{}</span></p>", "ja308:3.1": "<p><span class='verse-line'>{}</span>", "ja308:3.2": "<span class='verse-line'>{}</span>", "ja308:3.3": "<span class='verse-line'>{}</span>", "ja308:3.4": "<span class='verse-line'>{}</span></p>", "ja308:4.1": "<p><span class='verse-line'>{}</span>", "ja308:4.2": "<span class='verse-line'>{}</span>", "ja308:4.3": "<span class='verse-line'>{}</span>", "ja308:4.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja308:5.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja308:0.1": "Jātaka ", "ja308:0.2": "Catukkanipāta ", "ja308:0.3": "Kāliṅgavagga ", "ja308:0.4": "8. Sakuṇajātaka ", "ja308:1.1": "“Akaramhasa te kiccaṁ, ", "ja308:1.2": "yaṁ balaṁ ahuvamhase; ", "ja308:1.3": "Migarāja namo tyatthu, ", "ja308:1.4": "api kiñci labhāmase”. ", "ja308:2.1": "“Mama lohitabhakkhassa, ", "ja308:2.2": "niccaṁ luddāni kubbato; ", "ja308:2.3": "Dantantaragato santo, ", "ja308:2.4": "taṁ bahuṁ yampi jīvasi”. ", "ja308:3.1": "“Akataññumakattāraṁ, ", "ja308:3.2": "katassa appaṭikārakaṁ; ", "ja308:3.3": "Yasmiṁ kataññutā natthi, ", "ja308:3.4": "niratthā tassa sevanā. ", "ja308:4.1": "Yassa sammukhaciṇṇena, ", "ja308:4.2": "Mittadhammo na labbhati; ", "ja308:4.3": "Anusūyamanakkosaṁ, ", "ja308:4.4": "Saṇikaṁ tamhā apakkame”ti. ", "ja308:5.1": "Sakuṇajātakaṁ aṭṭhamaṁ. "}, "variant_text": {"ja308:0.1": "", "ja308:0.2": "", "ja308:0.3": "", "ja308:0.4": "", "ja308:1.1": "", "ja308:1.2": "", "ja308:1.3": "", "ja308:1.4": "", "ja308:2.1": "", "ja308:2.2": "", "ja308:2.3": "", "ja308:2.4": "", "ja308:3.1": "", "ja308:3.2": "", "ja308:3.3": "", "ja308:3.4": "", "ja308:4.1": "", "ja308:4.2": "", "ja308:4.3": "Anusūyamanakkosaṁ → anusuyya … (bj, pts-vp-pli1); anussūya … (sya1ed, sya2ed) ", "ja308:4.4": "", "ja308:5.1": "Sakuṇajātakaṁ → javasakuṇajātakaṁ (bj, sya1ed, sya2ed, pts-vp-pli1) "}, "reference_text": {"ja308:0.1": "", "ja308:0.2": "", "ja308:0.3": "", "ja308:0.4": "", "ja308:1.1": "ms22J_918, msdiv29, ndp22.90, pts-vp-pli3.26", "ja308:1.2": "", "ja308:1.3": "", "ja308:1.4": "", "ja308:2.1": "ms22J_919, msdiv30, vri68.84", "ja308:2.2": "", "ja308:2.3": "", "ja308:2.4": "", "ja308:3.1": "ms22J_920, msdiv31, sya27.134", "ja308:3.2": "", "ja308:3.3": "", "ja308:3.4": "", "ja308:4.1": "dr27.134, ms22J_921, msdiv32, pts-vp-pli3.27", "ja308:4.2": "", "ja308:4.3": "", "ja308:4.4": "", "ja308:5.1": "ms22J_922"}, "keys_order": ["ja308:0.1", "ja308:0.2", "ja308:0.3", "ja308:0.4", "ja308:1.1", "ja308:1.2", "ja308:1.3", "ja308:1.4", "ja308:2.1", "ja308:2.2", "ja308:2.3", "ja308:2.4", "ja308:3.1", "ja308:3.2", "ja308:3.3", "ja308:3.4", "ja308:4.1", "ja308:4.2", "ja308:4.3", "ja308:4.4", "ja308:5.1"]}