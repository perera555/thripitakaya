{"html_text": {"ja340:0.1": "<article id='ja340'><header><ul><li class='division'>{}</li>", "ja340:0.2": "<li>{}</li>", "ja340:0.3": "<li>{}</li></ul>", "ja340:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja340:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja340:1.2": "<span class='verse-line'>{}</span>", "ja340:1.3": "<span class='verse-line'>{}</span>", "ja340:1.4": "<span class='verse-line'>{}</span></p>", "ja340:2.1": "<p><span class='verse-line'>{}</span>", "ja340:2.2": "<span class='verse-line'>{}</span>", "ja340:2.3": "<span class='verse-line'>{}</span>", "ja340:2.4": "<span class='verse-line'>{}</span></p>", "ja340:3.1": "<p><span class='verse-line'>{}</span>", "ja340:3.2": "<span class='verse-line'>{}</span>", "ja340:3.3": "<span class='verse-line'>{}</span>", "ja340:3.4": "<span class='verse-line'>{}</span></p>", "ja340:4.1": "<p><span class='verse-line'>{}</span>", "ja340:4.2": "<span class='verse-line'>{}</span>", "ja340:4.3": "<span class='verse-line'>{}</span>", "ja340:4.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja340:5.1": "<p class='endsutta'>{}</p>", "ja340:5.2": "<p class='endvagga'>{}</p>", "ja340:6.1": "<p class='uddana-intro'>{}</p>", "ja340:7.1": "<blockquote class='uddanagatha'><p><span class='verse-line'>{}</span>", "ja340:7.2": "<span class='verse-line'>{}</span>", "ja340:7.3": "<span class='verse-line'>{}</span>", "ja340:7.4": "<span class='verse-line'>{}</span></p></blockquote></article>"}, "root_text": {"ja340:0.1": "Jātaka ", "ja340:0.2": "Catukkanipāta ", "ja340:0.3": "Kokilavagga ", "ja340:0.4": "10. Visayhajātaka ", "ja340:1.1": "“Adāsi dānāni pure visayha, ", "ja340:1.2": "Dadato ca te khayadhammo ahosi; ", "ja340:1.3": "Ito parañce na dadeyya dānaṁ, ", "ja340:1.4": "Tiṭṭheyyuṁ te saṁyamantassa bhogā”. ", "ja340:2.1": "“Anariyamariyena sahassanetta, ", "ja340:2.2": "Suduggatenāpi akiccamāhu; ", "ja340:2.3": "Mā vo dhanaṁ taṁ ahu devarāja, ", "ja340:2.4": "Yaṁ bhogahetu vijahemu saddhaṁ. ", "ja340:3.1": "Yena eko ratho yāti, ", "ja340:3.2": "yāti tenāparo ratho; ", "ja340:3.3": "Porāṇaṁ nihitaṁ vattaṁ, ", "ja340:3.4": "vattataññeva vāsava. ", "ja340:4.1": "Yadi hessati dassāma, ", "ja340:4.2": "asante kiṁ dadāmase; ", "ja340:4.3": "Evaṁbhūtāpi dassāma, ", "ja340:4.4": "mā dānaṁ pamadamhase”ti. ", "ja340:5.1": "Visayhajātakaṁ dasamaṁ. ", "ja340:5.2": "Kokilavaggo catuttho. ", "ja340:6.1": "Tassuddānaṁ ", "ja340:7.1": "Ativelapabhāsati jītavaro, ", "ja340:7.2": "Vanamajjha rathesabha jimhagamo; ", "ja340:7.3": "Atha jambu tiṇāsanapīṭhavaraṁ, ", "ja340:7.4": "Atha taṇḍula mora visayha dasāti. "}, "variant_text": {"ja340:0.1": "", "ja340:0.2": "", "ja340:0.3": "", "ja340:0.4": "", "ja340:1.1": "", "ja340:1.2": "", "ja340:1.3": "", "ja340:1.4": "", "ja340:2.1": "", "ja340:2.2": "", "ja340:2.3": "ahu devarāja → janinda ahuvā (bj); ahu vā janinda (sya1ed, sya2ed, pts-vp-pli1) ", "ja340:2.4": "", "ja340:3.1": "", "ja340:3.2": "", "ja340:3.3": "", "ja340:3.4": "vattataññeva → vaddhataññeva (si); vaḍḍhaṁ vaḍḍhataṁ ñeva (pts-vp-pli1) ", "ja340:4.1": "", "ja340:4.2": "", "ja340:4.3": "", "ja340:4.4": "", "ja340:5.1": "", "ja340:5.2": "Kokilavaggo → kokālikavaggo (bj, mr) ", "ja340:6.1": "", "ja340:7.1": "", "ja340:7.2": "", "ja340:7.3": "", "ja340:7.4": ""}, "reference_text": {"ja340:0.1": "", "ja340:0.2": "", "ja340:0.3": "", "ja340:0.4": "", "ja340:1.1": "ms22J_1084, msdiv157, pts-vp-pli3.130", "ja340:1.2": "", "ja340:1.3": "", "ja340:1.4": "", "ja340:2.1": "ms22J_1085, msdiv158, ndp22.105, pts-vp-pli3.131", "ja340:2.2": "", "ja340:2.3": "", "ja340:2.4": "", "ja340:3.1": "ms22J_1086, msdiv159", "ja340:3.2": "", "ja340:3.3": "", "ja340:3.4": "", "ja340:4.1": "ms22J_1087, msdiv160, sya27.156", "ja340:4.2": "", "ja340:4.3": "", "ja340:4.4": "", "ja340:5.1": "ms22J_1088", "ja340:5.2": "", "ja340:6.1": "ms22J_1089", "ja340:7.1": "csp1ed22.114, csp2ed22.114, dr27.156, ms22J_1090", "ja340:7.2": "", "ja340:7.3": "", "ja340:7.4": ""}, "keys_order": ["ja340:0.1", 