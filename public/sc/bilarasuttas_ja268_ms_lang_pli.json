{"html_text": {"ja268:0.1": "<article id='ja268'><header><ul><li class='division'>{}</li>", "ja268:0.2": "<li>{}</li>", "ja268:0.3": "<li>{}</li></ul>", "ja268:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja268:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja268:1.2": "<span class='verse-line'>{}</span>", "ja268:1.3": "<span class='verse-line'>{}</span>", "ja268:1.4": "<span class='verse-line'>{}</span></p>", "ja268:2.1": "<p><span class='verse-line'>{}</span>", "ja268:2.2": "<span class='verse-line'>{}</span>", "ja268:2.3": "<span class='verse-line'>{}</span>", "ja268:2.4": "<span class='verse-line'>{}</span></p>", "ja268:3.1": "<p><span class='verse-line'>{}</span>", "ja268:3.2": "<span class='verse-line'>{}</span>", "ja268:3.3": "<span class='verse-line'>{}</span>", "ja268:3.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja268:4.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja268:0.1": "Jātaka ", "ja268:0.2": "Tikanipāta ", "ja268:0.3": "Padumavagga ", "ja268:0.4": "8. Ārāmadūsakajātaka ", "ja268:1.1": "“Yo ve sabbasametānaṁ, ", "ja268:1.2": "ahuvā seṭṭhasammato; ", "ja268:1.3": "Tassāyaṁ edisī paññā, ", "ja268:1.4": "kimeva itarā pajā”. ", "ja268:2.1": "“Evameva tuvaṁ brahme, ", "ja268:2.2": "anaññāya vinindasi; ", "ja268:2.3": "Kathaṁ mūlaṁ adisvāna, ", "ja268:2.4": "rukkhaṁ jaññā patiṭṭhitaṁ”. ", "ja268:3.1": "“Nāhaṁ tumhe vinindāmi, ", "ja268:3.2": "ye caññe vānarā vane; ", "ja268:3.3": "Vissasenova gārayho, ", "ja268:3.4": "yassatthā rukkharopakā”ti. ", "ja268:4.1": "Ārāmadūsakajātakaṁ aṭṭhamaṁ. "}, "variant_text": {"ja268:0.1": "", "ja268:0.2": "", "ja268:0.3": "", "ja268:0.4": "", "ja268:1.1": "", "ja268:1.2": "", "ja268:1.3": "", "ja268:1.4": "", "ja268:2.1": "", "ja268:2.2": "", "ja268:2.3": "Kathaṁ mūlaṁ adisvāna → kathaṁ hi mūlaṁ adisvā (sya1ed, sya2ed, pts-vp-pli1) ", "ja268:2.4": "", "ja268:3.1": "", "ja268:3.2": "", "ja268:3.3": "", "ja268:3.4": "", "ja268:4.1": ""}, "reference_text": {"ja