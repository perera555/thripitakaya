{"html_text": {"ja384:0.1": "<article id='ja384'><header><ul><li class='division'>{}</li>", "ja384:0.2": "<li>{}</li>", "ja384:0.3": "<li>{}</li></ul>", "ja384:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja384:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja384:1.2": "<span class='verse-line'>{}</span>", "ja384:1.3": "<span class='verse-line'>{}</span>", "ja384:1.4": "<span class='verse-line'>{}</span></p>", "ja384:2.1": "<p><span class='verse-line'>{}</span>", "ja384:2.2": "<span class='verse-line'>{}</span>", "ja384:2.3": "<span class='verse-line'>{}</span>", "ja384:2.4": "<span class='verse-line'>{}</span></p>", "ja384:3.1": "<p><span class='verse-line'>{}</span>", "ja384:3.2": "<span class='verse-line'>{}</span>", "ja384:3.3": "<span class='verse-line'>{}</span>", "ja384:3.4": "<span class='verse-line'>{}</span></p>", "ja384:4.1": "<p><span class='verse-line'>{}</span>", "ja384:4.2": "<span class='verse-line'>{}</span>", "ja384:4.3": "<span class='verse-line'>{}</span>", "ja384:4.4": "<span class='verse-line'>{}</span></p>", "ja384:5.1": "<p><span class='verse-line'>{}</span>", "ja384:5.2": "<span class='verse-line'>{}</span>", "ja384:5.3": "<span class='verse-line'>{}</span>", "ja384:5.4": "<span class='verse-line'>{}</span></p>", "ja384:6.1": "<p><span class='verse-line'>{}</span>", "ja384:6.2": "<span class='verse-line'>{}</span>", "ja384:6.3": "<span class='verse-line'>{}</span>", "ja384:6.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja384:7.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja384:0.1": "Jātaka ", "ja384:0.2": "Chakkanipāta ", "ja384:0.3": "Avāriyavagga ", "ja384:0.4": "9. Dhammadhajajātaka ", "ja384:1.1": "“Dhammaṁ caratha ñātayo, ", "ja384:1.2": "Dhammaṁ caratha bhaddaṁ vo; ", "ja384:1.3": "Dhammacārī sukhaṁ seti, ", "ja384:1.4": "Asmiṁ loke paramhi ca”. ", "ja384:2.1": "“Bhaddako vatayaṁ pakkhī, ", "ja384:2.2": "dijo paramadhammiko; ", "ja384:2.3": "Ekapādena tiṭṭhanto, ", "ja384:2.4": "dhammamevānusāsati”. ", "ja384:3.1": "“Nāssa sīlaṁ vijānātha, ", "ja384:3.2": "anaññāya pasaṁsatha; ", "ja384:3.3": "Bhutvā aṇḍañca potañca, ", "ja384:3.4": "dhammo dhammoti bhāsati. ", "ja384:4.1": "Aññaṁ bhaṇati vācāya, ", "ja384:4.2": "aññaṁ kāyena kubbati; ", "ja384:4.3": "Vācāya no ca kāyena, ", "ja384:4.4": "na taṁ dhammaṁ adhiṭṭhito. ", "ja384:5.1": "Vācāya sakhilo manoviduggo, ", "ja384:5.2": "Channo kūpasayova kaṇhasappo; ", "ja384:5.3": "Dhammadhajo gāmanigamāsu sādhu, ", "ja384:5.4": "Dujjāno purisena bālisena. ", "ja384:6.1": "Imaṁ tuṇḍehi pakkhehi, ", "ja384:6.2": "pādā cimaṁ viheṭhatha; ", "ja384:6.3": "Chavañhimaṁ vināsetha, ", "ja384:6.4": "nāyaṁ saṁvāsanāraho”ti. ", "ja384:7.1": "Dhammadhajajātakaṁ navamaṁ. "}, "variant_text": {"ja384:0.1": "", "ja384:0.2": "", "ja384:0.3": "", "ja384:0.4": "", "ja384:1.1": "", "ja384:1.2": "bhaddaṁ vo → bhadda vo (sya1ed, sya2ed, mr) ", "ja384:1.3": "", "ja384:1.4": "", "ja384:2.1": "", "ja384:2.2": "", "ja384:2.3": "", "ja384:2.4": "", "ja384:3.1": "", "ja384:3.2": "", "ja384:3.3": "potañca → chāpe ca (bj, sya1ed, sya2ed) ", "ja384:3.4": "", "ja384:4.1": "", "ja384:4.2": "", "ja384:4.3": "", "ja384:4.4": "", "ja384:5.1": "", "ja384:5.2": "", "ja384:5.3": "gāmanigamāsu sādhu → gāmanigamāsu sādhu sammato (bj); gāmanigamasādhu (pts-vp-pli1) ", "ja384:5.4": "", "ja384:6.1": "", "ja384:6.2": "viheṭhatha → vipothatha (pts-vp-pli1) ", "ja384:6.3": "", "ja384:6.4": "", "ja384:7.1": "Dhammadhajajātakaṁ → dhammaddhajajātakaṁ (sya1ed, sya2ed, pts-vp-pli1) "}, "reference_text": {"ja384:0.1": "", "ja384:0.2": "", "ja384:0.3": "", "ja384:0.4": "", "ja384:1.1": "dr27.196, ms22J_1390, msdiv65, pts-vp-pli3.268", "ja384:1.2": "", "ja384:1.3": "", "ja384:1.4": "", "ja384:2.1": "ms22J_1391, msdiv66, ndp22.136", "ja384:2.2": "", "ja384:2.3": "", "ja384:2.4": "", "ja384:3.1": "ms22J_1392, msdiv67, pts-vp-pli3.269", "ja384:3.2": "", "ja384:3.3": "", "ja384:3.4": "", "ja384:4.1": "ms22J_1393, msdiv68", "ja384:4.2": "", "ja384:4.3": "", "ja384:4.4": "", "ja384:5.1": "bj30.248, csp1ed22.145, csp2ed22.145, ms22J_1394, msdiv69, sya27.198, vri68.122", "ja384:5.2": "", "ja384:5.3": "", "ja384:5.4": "", "ja384:6.1": "ms22J_1395, msdiv70", "ja384:6.2": "", "ja384:6.3": "", "ja384:6.4": "", "ja384:7.1": "ms22J_1396"}, "keys_order": ["ja384:0.1", "ja384:0.2", "ja384:0.3", "ja384:0.4", "ja384:1.1", "ja384:1.2", "ja384:1.3", "ja384:1.4", "ja384:2.1", "ja384:2.2", "ja384:2.3", "ja384:2.4", "ja384:3.1", "ja384:3.2", "ja384:3.3", "ja384:3.4", "ja384:4.1", "ja384:4.2", "ja384:4.3", "ja384:4.4", "ja384:5.1", "ja384:5.2", "ja384:5.3", "ja384:5.4", "ja384:6.1", "ja384:6.2", "ja384:6.3", "ja384:6.4", "ja384:7.1"]}