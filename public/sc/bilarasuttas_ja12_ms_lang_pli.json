{"html_text": {"ja12:0.1": "<article id='ja12'><header><ul><li class='division'>{}</li>", "ja12:0.2": "<li>{}</li>", "ja12:0.3": "<li>{}</li></ul>", "ja12:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja12:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja12:1.2": "<span class='verse-line'>{}</span>", "ja12:1.3": "<span class='verse-line'>{}</span>", "ja12:1.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja12:2.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja12:0.1": "Jātaka ", "ja12:0.2": "Ekakanipāta ", "ja12:0.3": "Sīlavagga ", "ja12:0.4": "2. Nigrodhamigajātaka ", "ja12:1.1": "“Nigrodhameva seveyya, ", "ja12:1.2": "na sākhamupasaṁvase; ", "ja12:1.3": "Nigrodhasmiṁ mataṁ seyyo, ", "ja12:1.4": "yañce sākhasmi jīvitan”ti. ", "ja12:2.1": "Nigrodhamigajātakaṁ dutiyaṁ. "}, "variant_text": {"ja12:0.1": "", "ja12:0.2": "", "ja12:0.3": "", "ja12:0.4": "", "ja12:1.1": "", "ja12:1.2": "", "ja12:1.3": "", "ja12:1.4": "sākhasmi → sākhasmiṁ (bj, pts-vp-pli1) ", "ja12:2.1": ""}, "reference_text": {"ja12:0.1": "", "ja12:0.2": "", "ja12:0.3": "", "ja12:0.4": "", "ja12:1.1": "csp1ed22.4, csp2ed22.4, ms22J_26, msdiv12, pts-vp-pli1.152, sya27.5, vri68.4", "ja12:1.2": "", "ja12:1.3": "", "ja12:1.4": "", "ja12:2.1": "ms22J_27"}, "keys_order": ["ja12:0.1", "ja12:0.2", "ja12:0.3", "ja12:0.4", "ja12:1.1", "ja12:1.2", "ja12:1.3", "ja12:1.4", "ja12:2.1"]}