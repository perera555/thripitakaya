{"html_text": {"ja246:0.1": "<article id='ja246'><header><ul><li class='division'>{}</li>", "ja246:0.2": "<li>{}</li>", "ja246:0.3": "<li>{}</li></ul>", "ja246:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja246:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja246:1.2": "<span class='verse-line'>{}</span>", "ja246:1.3": "<span class='verse-line'>{}</span>", "ja246:1.4": "<span class='verse-line'>{}</span></p>", "ja246:2.1": "<p><span class='verse-line'>{}</span>", "ja246:2.2": "<span class='verse-line'>{}</span>", "ja246:2.3": "<span class='verse-line'>{}</span>", "ja246:2.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja246:3.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja246:0.1": "Jātaka ", "ja246:0.2": "Dukanipāta ", "ja246:0.3": "Siṅgālavagga ", "ja246:0.4": "6. Bālovādajātaka ", "ja246:1.1": "“Hantvā chetvā vadhitvā ca, ", "ja246:1.2": "deti dānaṁ asaññato; ", "ja246:1.3": "Edisaṁ bhattaṁ bhuñjamāno, ", "ja246:1.4": "sa pāpena upalippati”. ", "ja246:2.1": "“Puttadārampi ce hantvā, ", "ja246:2.2": "Deti dānaṁ asaññato; ", "ja246:2.3": "Bhuñjamānopi sappañño, ", "ja246:2.4": "Na pāpena upalippatī”ti. ", "ja246:3.1": "Bālovādajātakaṁ chaṭṭhaṁ. "}, "variant_text": {"ja246:0.1": "", "ja246:0.2": "", "ja246:0.3": "", "ja246:0.4": "", "ja246:1.1": "chetvā → jhatvā (bj, pts-vp-pli1); ghatvā (sya1ed, sya2ed) ", "ja246:1.2": "", "ja246:1.3": "", "ja246:1.4": "sa pāpena upalippati → sa pāpamupalimpati (sya1ed, sya2ed, mr); so pāpena upalippatīti (pts-vp-pli1) ", "ja246:2.1": "", "ja246:2.2": "", "ja246:2.3": "", "ja246:2.4": "", "ja246:3.1": "Bālovādajātakaṁ → telovādajātakaṁ (bj, pts-vp-pli1) "}, "reference_text": {"ja246:0.1": "", "ja246:0.2": "", "ja246:0.3": "", "ja246:0.4": "", "ja246:1.1": "ms22J_650, msdiv192, ndp22.64, pts-vp-pli2.262", "ja246:1.2": "", "ja246:1.3": "", "ja246:1.4": "", "ja246:2.1": "csp1ed22.69, csp2ed22.69, ms22J_651, msdiv193, pts-vp-pli2.263", "ja246:2.2": "", "ja246:2.3": "", "ja246:2.4": "", "ja246:3.1": "ms22J_652"}, "keys_order": ["ja246:0.1", "ja246:0.2", "ja246:0.3", "ja246:0.4", "ja246:1.1", "ja246:1.2", "ja246:1.3", "ja246:1.4", "ja246:2.1", "ja246:2.2", "ja246:2.3", "ja246:2.4", "ja246:3.1"]}