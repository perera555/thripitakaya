{"html_text": {"ja221:0.1": "<article id='ja221'><header><ul><li class='division'>{}</li>", "ja221:0.2": "<li>{}</li>", "ja221:0.3": "<li>{}</li></ul>", "ja221:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja221:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja221:1.2": "<span class='verse-line'>{}</span>", "ja221:1.3": "<span class='verse-line'>{}</span>", "ja221:1.4": "<span class='verse-line'>{}</span></p>", "ja221:2.1": "<p><span class='verse-line'>{}</span>", "ja221:2.2": "<span class='verse-line'>{}</span>", "ja221:2.3": "<span class='verse-line'>{}</span>", "ja221:2.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja221:3.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja221:0.1": "Jātaka ", "ja221:0.2": "Dukanipāta ", "ja221:0.3": "Kāsāvavagga ", "ja221:0.4": "1. Kāsāvajātaka ", "ja221:1.1": "“Anikkasāvo kāsāvaṁ, ", "ja221:1.2": "yo vatthaṁ paridahissati; ", "ja221:1.3": "Apeto damasaccena, ", "ja221:1.4": "na so kāsāvamarahati. ", "ja221:2.1": "Yo ca vantakasāvassa, ", "ja221:2.2": "Sīlesu susamāhito; ", "ja221:2.3": "Upeto damasaccena, ", "ja221:2.4": "Sa ve kāsāvamarahatī”ti. ", "ja221:3.1": "Kāsāvajātakaṁ paṭhamaṁ. "}, "variant_text": {"ja221:0.1": "", "ja221:0.2": "", "ja221:0.3": "", "ja221:0.4": "", "ja221:1.1": "", "ja221:1.2": "paridahissati → paridahessati (bj, pts-vp-pli1) ", "ja221:1.3": "", "ja221:1.4": "", "ja221:2.1": "", "ja221:2.2": "", "ja221:2.3": "", "ja221:2.4": "", "ja221:3.1": ""}, "reference_text": {"ja221:0.1": "", "ja221:0.2": "", "ja221:0.3": "", "ja221:0.4": "", "ja221:1.1": "bj30.106, dr27.83, ms22J_570, msdiv141, pts-vp-pli2.198", "ja221:1.2": "", "ja221:1.3": "", "ja221:1.4": "", "ja221:2.1": "ms22J_571, msdiv142", "ja221:2.2": "", "ja221:2.3": "", "ja221:2.4": "", "ja221:3.1": "ms22J_572"}, "keys_order": ["ja221:0.1", "ja221:0.2", "ja221:0.3", "ja221:0.4", "ja221:1.1", "ja221:1.2", "ja221:1.3", "ja221:1.4", "ja221:2.1", "ja221:2.2", "ja221:2.3", "ja221:2.4", "ja221:3.1"]}