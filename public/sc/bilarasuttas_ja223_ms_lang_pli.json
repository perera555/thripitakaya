{"html_text": {"ja223:0.1": "<article id='ja223'><header><ul><li class='division'>{}</li>", "ja223:0.2": "<li>{}</li>", "ja223:0.3": "<li>{}</li></ul>", "ja223:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja223:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja223:1.2": "<span class='verse-line'>{}</span>", "ja223:1.3": "<span class='verse-line'>{}</span>", "ja223:1.4": "<span class='verse-line'>{}</span></p>", "ja223:2.1": "<p><span class='verse-line'>{}</span>", "ja223:2.2": "<span class='verse-line'>{}</span>", "ja223:2.3": "<span class='verse-line'>{}</span>", "ja223:2.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja223:3.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja223:0.1": "Jātaka ", "ja223:0.2": "Dukanipāta ", "ja223:0.3": "Kāsāvavagga ", "ja223:0.4": "3. Puṭabhattajātaka ", "ja223:1.1": "“Name namantassa bhaje bhajantaṁ, ", "ja223:1.2": "Kiccānukubbassa kareyya kiccaṁ; ", "ja223:1.3": "Nānatthakāmassa kareyya atthaṁ, ", "ja223:1.4": "Asambhajantampi na sambhajeyya. ", "ja223:2.1": "Caje cajantaṁ vanathaṁ na kayirā, ", "ja223:2.2": "Apetacittena na sambhajeyya; ", "ja223:2.3": "Dijo dumaṁ khīṇaphalanti ñatvā, ", "ja223:2.4": "Aññaṁ samekkheyya mahā hi loko”ti. ", "ja223:3.1": "Puṭabhattajātakaṁ tatiyaṁ. "}, "reference_text": {"ja223:0.1": "", "ja223:0.2": "", "ja223:0.3": "", "ja223:0.4": "", "ja223:1.1": "ms22J_576, msdiv145, pts-vp-pli2.205, vri68.55", "ja223:1.2": "", "ja223:1.3": "", "ja223:1.4": "", "ja223:2.1": "csp1ed22.61, csp2ed22.61, dr27.84, ms22J_577, msdiv146", "ja223:2.2": "", "ja223:2.3": "", "ja223:2.4": "", "ja223:3.1": "ms22J_578"}, "keys_order": ["ja223:0.1", "ja223:0.2", "ja223:0.3", "ja223:0.4", "ja223:1.1", "ja223:1.2", "ja223:1.3", "ja223:1.4", "ja223:2.1", "ja223:2.2", "ja223:2.3", "ja223:2.4", "ja223:3.1"]}