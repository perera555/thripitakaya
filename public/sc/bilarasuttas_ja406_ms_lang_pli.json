{"html_text": {"ja406:0.1": "<article id='ja406'><header><ul><li class='division'>{}</li>", "ja406:0.2": "<li>{}</li>", "ja406:0.3": "<li>{}</li></ul>", "ja406:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja406:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja406:1.2": "<span class='verse-line'>{}</span>", "ja406:1.3": "<span class='verse-line'>{}</span>", "ja406:1.4": "<span class='verse-line'>{}</span></p>", "ja406:2.1": "<p><span class='verse-line'>{}</span>", "ja406:2.2": "<span class='verse-line'>{}</span>", "ja406:2.3": "<span class='verse-line'>{}</span>", "ja406:2.4": "<span class='verse-line'>{}</span></p>", "ja406:3.1": "<p><span class='verse-line'>{}</span>", "ja406:3.2": "<span class='verse-line'>{}</span>", "ja406:3.3": "<span class='verse-line'>{}</span>", "ja406:3.4": "<span class='verse-line'>{}</span></p>", "ja406:4.1": "<p><span class='verse-line'>{}</span>", "ja406:4.2": "<span class='verse-line'>{}</span>", "ja406:4.3": "<span class='verse-line'>{}</span>", "ja406:4.4": "<span class='verse-line'>{}</span></p>", "ja406:5.1": "<p><span class='verse-line'>{}</span>", "ja406:5.2": "<span class='verse-line'>{}</span>", "ja406:5.3": "<span class='verse-line'>{}</span>", "ja406:5.4": "<span class='verse-line'>{}</span></p>", "ja406:6.1": "<p><span class='verse-line'>{}</span>", "ja406:6.2": "<span class='verse-line'>{}</span>", "ja406:6.3": "<span class='verse-line'>{}</span>", "ja406:6.4": "<span class='verse-line'>{}</span></p>", "ja406:7.1": "<p><span class='verse-line'>{}</span>", "ja406:7.2": "<span class='verse-line'>{}</span>", "ja406:7.3": "<span class='verse-line'>{}</span>", "ja406:7.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja406:8.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja406:0.1": "Jātaka ", "ja406:0.2": "Sattakanipāta ", "ja406:0.3": "Gandhāravagga ", "ja406:0.4": "1. Gandhārajātaka ", "ja406:1.1": "“Hitvā gāmasahassāni, ", "ja406:1.2": "paripuṇṇāni soḷasa; ", "ja406:1.3": "Koṭṭhāgārāni phītāni, ", "ja406:1.4": "sannidhiṁ dāni kubbasi”. ", "ja406:2.1": "“Hitvā gandhāravisayaṁ, ", "ja406:2.2": "pahūtadhanadhāriyaṁ; ", "ja406:2.3": "Pasāsanato nikkhanto, ", "ja406:2.4": "idha dāni pasāsasi”. ", "ja406:3.1": "“Dhammaṁ bhaṇāmi vedeha, ", "ja406:3.2": "adhammo me na ruccati; ", "ja406:3.3": "Dhammaṁ me bhaṇamānassa, ", "ja406:3.4": "na pāpamupalimpati”. ", "ja406:4.1": "“Yena kenaci vaṇṇena, ", "ja406:4.2": "paro labhati ruppanaṁ; ", "ja406:4.3": "Mahatthiyampi ce vācaṁ, ", "ja406:4.4": "na taṁ bhāseyya paṇḍito”. ", "ja406:5.1": "“Kāmaṁ ruppatu vā mā vā, ", "ja406:5.2": "bhusaṁva vikirīyatu; ", "ja406:5.3": "Dhammaṁ me bhaṇamānassa, ", "ja406:5.4": "na pāpamupalimpati”. ", "ja406:6.1": "“No ce assa sakā buddhi, ", "ja406:6.2": "vinayo vā susikkhito; ", "ja406:6.3": "Vane andhamahiṁsova, ", "ja406:6.4": "careyya bahuko jano. ", "ja406:7.1": "Yasmā ca panidhekacce, ", "ja406:7.2": "āceramhi susikkhitā; ", "ja406:7.3": "Tasmā vinītavinayā, ", "ja406:7.4": "caranti susamāhitā”ti. ", "ja406:8.1": "Gandhārajātakaṁ paṭhamaṁ. "}, "variant_text": {"ja406:0.1": "", "ja406:0.2": "", "ja406:0.3": "", "ja406:0.4": "", "ja406:1.1": "", "ja406:1.2": "", "ja406:1.3": "", "ja406:1.4": "", "ja406:2.1": "", "ja406:2.2": "pahūtadhanadhāriyaṁ → … dhāniyaṁ (bj, pts-vp-pli1); … pāniyaṁ (sya1ed, sya2ed) ", "ja406:2.3": "Pasāsanato → pasāsanito (bj, sya1ed, sya2ed); pasāsanāto (pts-vp-pli1) ", "ja406:2.4": "", "ja406:3.1": "", "ja406:3.2": "", "ja406:3.3": "", "ja406:3.4": "", "ja406:4.1": "", "ja406:4.2": "", "ja406:4.3": "", "ja406:4.4": "", "ja406:5.1": "", "ja406:5.2": "", "ja406:5.3": "", "ja406:5.4": "", "ja406:6.1": "", "ja406:6.2": "", "ja406:6.3": "andhamahiṁsova → andhamahisova (bj, pts-vp-pli1) ", "ja406:6.4": "", "ja406:7.1": "", "ja406:7.2": "āceramhi → ācāramhi (bj, pts-vp-pli1) ", "ja406:7.3": "", "ja406:7.4": "", "ja406:8.1": ""}, "reference_text": {"ja406:0.1": "", "ja406:0.2": "", "ja406:0.3": "", "ja406:0.4": "", "ja406:1.1": "bj30.282, csp1