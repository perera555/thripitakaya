{"html_text": {"ja248:0.1": "<article id='ja248'><header><ul><li class='division'>{}</li>", "ja248:0.2": "<li>{}</li>", "ja248:0.3": "<li>{}</li></ul>", "ja248:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja248:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja248:1.2": "<span class='verse-line'>{}</span>", "ja248:1.3": "<span class='verse-line'>{}</span>", "ja248:1.4": "<span class='verse-line'>{}</span></p>", "ja248:2.1": "<p><span class='verse-line'>{}</span>", "ja248:2.2": "<span class='verse-line'>{}</span>", "ja248:2.3": "<span class='verse-line'>{}</span>", "ja248:2.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja248:3.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja248:0.1": "Jātaka ", "ja248:0.2": "Dukanipāta ", "ja248:0.3": "Siṅgālavagga ", "ja248:0.4": "8. Kiṁsukopamajātaka ", "ja248:1.1": "“Sabbehi kiṁsuko diṭṭho, ", "ja248:1.2": "kinnvettha vicikicchatha; ", "ja248:1.3": "Na hi sabbesu ṭhānesu, ", "ja248:1.4": "sārathī paripucchito”. ", "ja248:2.1": "“Evaṁ sabbehi ñāṇehi, ", "ja248:2.2": "yesaṁ dhammā ajānitā; ", "ja248:2.3": "Te ve dhammesu kaṅkhanti, ", "ja248:2.4": "kiṁsukasmiṁva bhātaro”ti. ", "ja248:3.1": "Kiṁsukopamajātakaṁ aṭṭhamaṁ. "}, "reference_text": {"ja248:0.1": "", "ja248:0.2": "", "ja248:0.3": "", "ja248:0.4": "", "ja248:1.1": "ms22J_656, msdiv196, pts-vp-pli2.266", "ja248:1.2": "", "ja248:1.3": "", "ja248:1.4": "", "ja248:2.1": "bj30.122, ms22J_657, msdiv197", "ja248:2.2": "", "ja248:2.3": "", "ja248:2.4": "", "ja248:3.1": "ms22J_658"}, "keys_order": ["ja248:0.1", "ja248:0.2", "ja248:0.3", "ja248:0.4", "ja248:1.1", "ja248:1.2", "ja248:1.3", "ja248:1.4", "ja248:2.1", "ja248:2.2", "ja248:2.3", "ja248:2.4", "ja248:3.1"]}