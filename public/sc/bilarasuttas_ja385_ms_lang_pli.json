{"html_text": {"ja385:0.1": "<article id='ja385'><header><ul><li class='division'>{}</li>", "ja385:0.2": "<li>{}</li>", "ja385:0.3": "<li>{}</li></ul>", "ja385:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja385:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja385:1.2": "<span class='verse-line'>{}</span>", "ja385:1.3": "<span class='verse-line'>{}</span>", "ja385:1.4": "<span class='verse-line'>{}</span>", "ja385:1.5": "<span class='verse-line'>{}</span>", "ja385:1.6": "<span class='verse-line'>{}</span></p>", "ja385:2.1": "<p><span class='verse-line'>{}</span>", "ja385:2.2": "<span class='verse-line'>{}</span>", "ja385:2.3": "<span class='verse-line'>{}</span>", "ja385:2.4": "<span class='verse-line'>{}</span></p>", "ja385:3.1": "<p><span class='verse-line'>{}</span>", "ja385:3.2": "<span class='verse-line'>{}</span>", "ja385:3.3": "<span class='verse-line'>{}</span>", "ja385:3.4": "<span class='verse-line'>{}</span></p>", "ja385:4.1": "<p><span class='verse-line'>{}</span>", "ja385:4.2": "<span class='verse-line'>{}</span>", "ja385:4.3": "<span class='verse-line'>{}</span>", "ja385:4.4": "<span class='verse-line'>{}</span></p>", "ja385:5.1": "<p><span class='verse-line'>{}</span>", "ja385:5.2": "<span class='verse-line'>{}</span>", "ja385:5.3": "<span class='verse-line'>{}</span>", "ja385:5.4": "<span class='verse-line'>{}</span></p>", "ja385:6.1": "<p><span class='verse-line'>{}</span>", "ja385:6.2": "<span class='verse-line'>{}</span>", "ja385:6.3": "<span class='verse-line'>{}</span>", "ja385:6.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja385:7.1": "<p class='endsutta'>{}</p>", "ja385:7.2": "<p class='endvagga'>{}</p>", "ja385:8.1": "<p class='uddana-intro'>{}</p>", "ja385:9.1": "<blockquote class='uddanagatha'><p><span class='verse-line'>{}</span>", "ja385:9.2": "<span class='verse-line'>{}</span>", "ja385:9.3": "<span class='verse-line'>{}</span>", "ja385:9.4": "<span class='verse-line'>{}</span></p></blockquote></article>"}, "root_text": {"ja385:0.1": "Jātaka ", "ja385:0.2": "Chakkanipāta ", "ja385:0.3": "Avāriyavagga ", "ja385:0.4": "10. Nandiyamigarājajātaka ", "ja385:1.1": "“Sace brāhmaṇa gacchesi, ", "ja385:1.2": "sākete ajjunaṁ vanaṁ; ", "ja385:1.3": "Vajjāsi nandiyaṁ nāma, ", "ja385:1.4": "puttaṁ asmākamorasaṁ; ", "ja385:1.5": "Mātā pitā ca te vuddhā, ", "ja385:1.6": "te taṁ icchanti passituṁ”. ", "ja385:2.1": "“Bhuttā mayā nivāpāni, ", "ja385:2.2": "Rājino pānabhojanaṁ; ", "ja385:2.3": "Taṁ rājapiṇḍaṁ avabhottuṁ, ", "ja385:2.4": "Nāhaṁ brāhmaṇa mussahe”. ", "ja385:3.1": "“Odahissāmahaṁ passaṁ, ", "ja385:3.2": "khurappānissa rājino; ", "ja385:3.3": "Tadāhaṁ sukhito mutto, ", "ja385:3.4": "api passeyya mātaraṁ. ", "ja385:4.1": "Migarājā pure āsiṁ, ", "ja385:4.2": "kosalassa niketane; ", "ja385:4.3": "Nandiyo nāma nāmena, ", "ja385:4.4": "abhirūpo catuppado. ", "ja385:5.1": "Taṁ maṁ vadhitumāgacchi, ", "ja385:5.2": "dāyasmiṁ ajjune vane; ", "ja385:5.3": "Dhanuṁ advejjhaṁ katvāna, ", "ja385:5.4": "usuṁ sannayha kosalo. ", "ja385:6.1": "Tassāhaṁ odahiṁ passaṁ, ", "ja385:6.2": "khurappānissa rājino; ", "ja385:6.3": "Tadāhaṁ sukhito mutto, ", "ja385:6.4": "mātaraṁ daṭṭhumāgato”ti. ", "ja385:7.1": "Nandiyamigarājajātakaṁ dasamaṁ. ", "ja385:7.2": "Avāriyavaggo paṭhamo. ", "ja385:8.1": "Tassuddānaṁ ", "ja385:9.1": "Atha kujjharathesabha ketuvaro, ", "ja385:9.2": "Sadarīmukha neru latā ca puna; ", "ja385:9.3": "Apananda sirī ca sucittavaro, ", "ja385:9.4": "Atha dhammika nandimigena dasāti. "}, "variant_text": {"ja385:0.1": "", "ja385:0.2": "", "ja385:0.3": "", "ja385:0.4": "", "ja385:1.1": "", "ja385:1.2": "sākete → sāketaṁ (bj, sya1ed, sya2ed) | ajjunaṁ → añjanaṁ (sya1ed, sya2ed); añjhanaṁ (pts-vp-pli1) ", "ja385:1.3": "", "ja385:1.4": "", "ja385:1.5": "", "ja385:1.6": "", "ja385:2.1": "", "ja385:2.2": "", "ja385:2.3": "avabhottuṁ → avabhottaṁ (mr) ", "ja385:2.4": "", "ja385:3.1": "", "ja385:3.2": "khurappānissa → khurappāṇissa (bj); khurapāṇissa (pts-vp-pli1); khurappapāṇissa (?) ", "ja385:3.3": "", "ja385:3.4": "", "ja385:4.1": "", "ja385:4.2": "niketane → niketave (bj, sya1ed, sya2ed, pts-vp-pli1) ", "ja385:4.3": "", "ja385:4.4": "", "ja385:5.1": "", "ja385:5.2": "", "ja385:5.3": "advejjhaṁ → ārajjuṁ (nissya); adejjhaṁ (bj, pts-vp-pli1); ārajjaṁ (sya1ed, sya2ed) ", "ja385:5.4": "sannayha → sandhāya (bj, sya1ed, sya2ed, pts-vp-pli1) ", "ja385:6.1": "", "ja385:6.2": "", "ja385:6.3": "", "ja385:6.4": "", "ja385:7.1": "Nandiyamigarājajātakaṁ → nandiyamigajātakaṁ (bj, pts-vp-pli1) ", "ja385:7.2": "Avāriyavaggo → āvāriyavaggo (sya1ed, sya2ed) ", "ja385:8.1": "", "ja385:9.1": "", "ja385:9.2": "", "ja385:9.3": "", "ja385:9.4": ""}, "reference_text": {"ja385:0.1": "", "ja385:0.2": "", "ja385:0.3": "", "ja385:0.4": "", "ja385:1.1": "dr27.197, ms22J_1397, msdiv71, pts-vp-pli3.272", "ja385:1.2": "", "ja385:1.3": "", "ja385:1.4": "", "ja385:1.5": "", "ja385:1.6": "", "ja385:2.1": "ms22J_1398, msdiv72", "ja385:2.2": "", "ja385:2.3": "", "ja385:2.4": "", "ja385:3.1": "ms22J_1399, msdiv73", "ja385:3.2": "", "ja385:3.3": "", "ja385:3.4": "", "ja385:4.1": "ms22J_1400, msdiv74, pts-vp-pli3.274", "ja385:4.2": "", "ja385:4.3": "", "ja385:4.4": "", "ja385:5.1": "ms22J_1401, msdiv75, ndp22.137", "ja385:5.2": "", "ja385:5.3": "", "ja385:5.4": "", "ja385:6.1": "csp1ed22.146, csp2ed22.146, ms22J_1402, msdiv76, sya27.199", "ja385:6.2": "", "ja385:6.3": "", "ja385:6.4": "", "ja385:7.1": "ms22J_1403", "ja385:7.2": "", "ja385:8.1": "ms22J_1404", "ja385:9.1": "dr27.198, ms22J_1405", "ja385:9.2": "", "ja385:9.3": "", "ja385:9.4": ""}, "keys_order": ["ja385:0.1", "ja385:0.2", "ja385:0.3", "ja385:0.4", "ja385:1.1", "ja385:1.2", "ja385:1.3", "ja385:1.4", "ja385:1.5", "ja385:1.6", "ja385:2.1", "ja385:2.2", "ja385:2.3", "ja385:2.4", "ja385:3.1", "ja385:3.2", "ja385:3.3", "ja385:3.4", "ja385:4.1", "ja385:4.2", "ja385:4.3", "ja385:4.4", "ja385:5.1", "ja385:5.2", "ja385:5.3", "ja385:5.4", "ja385:6.1", "ja385:6.2", "ja385:6.3", "ja385:6.4", "ja385:7.1", "ja385:7.2", "ja