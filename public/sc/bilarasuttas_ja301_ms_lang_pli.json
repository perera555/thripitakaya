{"html_text": {"ja301:0.1": "<article id='ja301'><header><ul><li class='division'>{}</li>", "ja301:0.2": "<li>{}</li>", "ja301:0.3": "<li>{}</li></ul>", "ja301:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja301:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja301:1.2": "<span class='verse-line'>{}</span>", "ja301:1.3": "<span class='verse-line'>{}</span>", "ja301:1.4": "<span class='verse-line'>{}</span></p>", "ja301:2.1": "<p><span class='verse-line'>{}</span>", "ja301:2.2": "<span class='verse-line'>{}</span>", "ja301:2.3": "<span class='verse-line'>{}</span>", "ja301:2.4": "<span class='verse-line'>{}</span></p>", "ja301:3.1": "<p><span class='verse-line'>{}</span>", "ja301:3.2": "<span class='verse-line'>{}</span>", "ja301:3.3": "<span class='verse-line'>{}</span>", "ja301:3.4": "<span class='verse-line'>{}</span></p>", "ja301:4.1": "<p><span class='verse-line'>{}</span>", "ja301:4.2": "<span class='verse-line'>{}</span>", "ja301:4.3": "<span class='verse-line'>{}</span>", "ja301:4.4": "<span class='verse-line'>{}</span>", "ja301:4.5": "<span class='verse-line'>{}</span>", "ja301:4.6": "<span class='verse-line'>{}</span></p></blockquote>", "ja301:5.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja301:0.1": "Jātaka ", "ja301:0.2": "Catukkanipāta ", "ja301:0.3": "Kāliṅgavagga ", "ja301:0.4": "1. Cūḷakāliṅgajātaka ", "ja301:1.1": "“Vivarathimāsaṁ dvāraṁ, ", "ja301:1.2": "Nagaraṁ pavisantu aruṇarājassa; ", "ja301:1.3": "Sīhena susiṭṭhena, ", "ja301:1.4": "Surakkhitaṁ nandisenena”. ", "ja301:2.1": "“Jayo kaliṅgānamasayhasāhinaṁ, ", "ja301:2.2": "Parājayo anayo assakānaṁ; ", "ja301:2.3": "Icceva te bhāsitaṁ brahmacāri, ", "ja301:2.4": "Na ujjubhūtā vitathaṁ bhaṇanti”. ", "ja301:3.1": "“Devā musāvādamupātivattā, ", "ja301:3.2": "Saccaṁ dhanaṁ paramaṁ tesu sakka; ", "ja301:3.3": "Taṁ te musā bhāsitaṁ devarāja, ", "ja301:3.4": "Kiṁ vā paṭicca maghavā mahinda”. ", "ja301:4.1": "“Nanu te sutaṁ brāhmaṇa bhaññamāne, ", "ja301:4.2": "Devā na issanti purisaparakkamassa; ", "ja301:4.3": "Damo samādhi manaso abhejjo, ", "ja301:4.4": "Abyaggatā nikkamanañca kāle; ", "ja301:4.5": "Daḷhañca viriyaṁ purisaparakkamo ca, ", "ja301:4.6": "Teneva āsi vijayo assakānan”ti. ", "ja301:5.1": "Cūḷakāliṅgajātakaṁ paṭhamaṁ. "}, "variant_text": {"ja301:0.1": "", "ja301:0.2": "", "ja301:0.3": "", "ja301:0.4": "", "ja301:1.1": "Vivarathimāsaṁ → vivaratha imāsaṁ (bj, sya1ed, sya2ed, pts-vp-pli1) ", "ja301:1.2": "Nagaraṁ pavisantu → pavisituṁ mayā (bj, mr); nagarantaṁ pavīsituṁ (sya1ed, sya2ed) ", "ja301:1.3": "", "ja301:1.4": "Surakkhitaṁ → surakkhitaṁ (pts-vp-pli1); susiṭṭhena (mr) ", "ja301:2.1": "", "ja301:2.2": "anayo → ajayo (sya1ed, sya2ed); anvito (mr) ", "ja301:2.3": "", "ja301:2.4": "", "ja301:3.1": "", "ja301:3.2": "dhanaṁ paramaṁ tesu → tathaṁ paramaṁ karaṁ nu (sya1ed, sya2ed); tathaṁ pemakaraṁ nu (mr) ", "ja301:3.3": "", "ja301:3.4": "", "ja301:4.1": "", "ja301:4.2": "", "ja301:4.3": "abhejjo → adejjho (bj, pts-vp-pli1); abhijjo (mr) ", "ja301:4.4": "nikkamanañca → nikkhamanañca (bj) ", "ja301:4.5": "", "ja301:4.6": "", "ja301:5.1": "Cūḷakāliṅgajātakaṁ → cullakaliṅgajātakaṁ (bj); cullakāliṅgajātakaṁ (sya1ed, sya2ed, pts-vp-pli1) "}, "reference_text": {"ja301:0.1": "", "ja301:0.2": "", "ja301:0.3": "", "ja301:0.4": "", "ja301:1.1": "bj30.162, csp1ed22.93, csp2ed22.93, dr27.128, ms22J_883, msdiv1, ndp22.86, pts-vp-pli3.3, sya27.128, vri68.81", "ja301:1.2": "", "ja301:1.3": "", "ja301:1.4": "", "ja301:2.1": "ms22J_884, msdiv2, pts-vp-pli3.6, pts-vp-pli3.7", "ja301:2.2": "", "ja301:2.3": "", "ja301:2.4": "", "ja301:3.1": "ms22J_885, msdiv3", "ja301:3.2": "", "ja301:3.3": "", "ja301:3.4": "", "ja301:4.1": "dr27.129, ms22J_886, msdiv4, sya27.129", "ja301:4.2": "", "ja301:4.3": "", "ja301:4.4": "", "ja301:4.5": "", "ja301:4.6": "", "ja301:5.1": "ms22J_887"}, "keys_order": ["ja301:0.1", "ja301:0.2", "ja301:0.3", "ja301:0.4", "ja301:1.1", "ja301:1.2", "ja301:1.3", "ja301:1.4", "ja301:2.1", "ja301:2.2", "ja301:2