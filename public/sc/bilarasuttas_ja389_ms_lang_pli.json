{"html_text": {"ja389:0.1": "<article id='ja389'><header><ul><li class='division'>{}</li>", "ja389:0.2": "<li>{}</li>", "ja389:0.3": "<li>{}</li></ul>", "ja389:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja389:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja389:1.2": "<span class='verse-line'>{}</span>", "ja389:1.3": "<span class='verse-line'>{}</span>", "ja389:1.4": "<span class='verse-line'>{}</span></p>", "ja389:2.1": "<p><span class='verse-line'>{}</span>", "ja389:2.2": "<span class='verse-line'>{}</span>", "ja389:2.3": "<span class='verse-line'>{}</span>", "ja389:2.4": "<span class='verse-line'>{}</span></p>", "ja389:3.1": "<p><span class='verse-line'>{}</span>", "ja389:3.2": "<span class='verse-line'>{}</span>", "ja389:3.3": "<span class='verse-line'>{}</span>", "ja389:3.4": "<span class='verse-line'>{}</span></p>", "ja389:4.1": "<p><span class='verse-line'>{}</span>", "ja389:4.2": "<span class='verse-line'>{}</span>", "ja389:4.3": "<span class='verse-line'>{}</span>", "ja389:4.4": "<span class='verse-line'>{}</span></p>", "ja389:5.1": "<p><span class='verse-line'>{}</span>", "ja389:5.2": "<span class='verse-line'>{}</span>", "ja389:5.3": "<span class='verse-line'>{}</span>", "ja389:5.4": "<span class='verse-line'>{}</span></p>", "ja389:6.1": "<p><span class='verse-line'>{}</span>", "ja389:6.2": "<span class='verse-line'>{}</span>", "ja389:6.3": "<span class='verse-line'>{}</span>", "ja389:6.4": "<span class='verse-line'>{}</span></p>", "ja389:7.1": "<p><span class='verse-line'>{}</span>", "ja389:7.2": "<span class='verse-line'>{}</span>", "ja389:7.3": "<span class='verse-line'>{}</span>", "ja389:7.4": "<span class='verse-line'>{}</span></p>", "ja389:8.1": "<p><span class='verse-line'>{}</span>", "ja389:8.2": "<span class='verse-line'>{}</span>", "ja389:8.3": "<span class='verse-line'>{}</span>", "ja389:8.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja389:9.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja389:0.1": "Jātaka ", "ja389:0.2": "Chakkanipāta ", "ja389:0.3": "Kharaputtavagga ", "ja389:0.4": "4. Suvaṇṇakakkaṭajātaka ", "ja389:1.1": "“Siṅgīmigo āyatacakkhunetto, ", "ja389:1.2": "Aṭṭhittaco vārisayo alomo; ", "ja389:1.3": "Tenābhibhūto kapaṇaṁ rudāmi, ", "ja389:1.4": "Hare sakhā kissa nu maṁ jahāsi”. ", "ja389:2.1": "So passasanto mahatā phaṇena, ", "ja389:2.2": "Bhujaṅgamo kakkaṭamajjhapatto; ", "ja389:2.3": "Sakhā sakhāraṁ paritāyamāno, ", "ja389:2.4": "Bhujaṅgamaṁ kakkaṭako gahesi. ", "ja389:3.1": "“Na vāyasaṁ no pana kaṇhasappaṁ, ", "ja389:3.2": "Ghāsatthiko kakkaṭako adeyya; ", "ja389:3.3": "Pucchāmi taṁ āyatacakkhunetta, ", "ja389:3.4": "Atha kissa hetumha ubho gahītā”. ", "ja389:4.1": "“Ayaṁ puriso mama atthakāmo, ", "ja389:4.2": "Yo maṁ gahetvāna dakāya neti; ", "ja389:4.3": "Tasmiṁ mate dukkhamanappakaṁ me, ", "ja389:4.4": "Ahañca eso ca ubho na homa. ", "ja389:5.1": "Mamañca disvāna pavaddhakāyaṁ, ", "ja389:5.2": "Sabbo jano hiṁsitumeva micche; ", "ja389:5.3": "Sāduñca thūlañca muduñca maṁsaṁ, ", "ja389:5.4": "Kākāpi maṁ disvāna viheṭhayeyyuṁ”. ", "ja389:6.1": "“Sacetassa hetumha ubho gahītā, ", "ja389:6.2": "Uṭṭhātu poso visamāvamāmi; ", "ja389:6.3": "Mamañca kākañca pamuñca khippaṁ, ", "ja389:6.4": "Pure visaṁ gāḷhamupeti maccaṁ”. ", "ja389:7.1": "“Sappaṁ pamokkhāmi na tāva kākaṁ, ", "ja389:7.2": "Paṭibandhako hohiti tāva kāko; ", "ja389:7.3": "Purisañca disvāna sukhiṁ arogaṁ, ", "ja389:7.4": "Kākaṁ pamokkhāmi yatheva sappaṁ”. ", "ja389:8.1": "“Kāko tadā devadatto ahosi, ", "ja389:8.2": "Māro pana kaṇhasappo ahosi; ", "ja389:8.3": "Ānandabhaddo kakkaṭako ahosi, ", "ja389:8.4": "Ahaṁ tadā brāhmaṇo homi satthā”ti. ", "ja389:9.1": "Suvaṇṇakakkaṭajātakaṁ catutthaṁ. "}, "variant_text": {"ja389:0.1": "", "ja389:0.2": "", "ja389:0.3": "", "ja389:0.4": "", "ja389:1.1": "", "ja389:1.2": "", "ja389:1.3": "", "ja389:1.4": "", "ja389:2.1": "", "ja389:2.2": "", "ja389:2.3": "", "ja389:2.4": "", "ja389:3.1": "", "ja389:3.2": "", "ja389:3.3": "", "ja389:3.4": "", "ja389:4.1": "", "ja389:4.2": "", "ja389:4.3": "", "ja389:4.4": "", "ja389:5.1": "disvāna → disvā (bj); disva (pts-vp-pli1) ", "ja389:5.2": "", "ja389:5.3": "", "ja389:5.4": "", "ja389:6.1": "", "ja389:6.2": "visamāvamāmi → visamācamāmi (bj, pts-vp-pli1, mr) ", "ja389:6.3": "", "ja389:6.4": "", "ja389:7.1": "", "ja389:7.2": "Paṭibandhako → paṭibaddhako (bj, sya1ed, sya2ed, pts-vp-pli1) | hohiti → hoti hi (sya1ed, sya2ed) ", "ja389:7.3": "", "ja389:7.4": "", "ja389:8.1": "", "ja389:8.2": "", "ja389:8.3": "", "ja389:8.4": "satthā”ti → tatthāti (pts-vp-pli1) ", "ja389:9.1": "Suvaṇṇakakkaṭajātakaṁ → suvaṇṇakakkaṭakajātakaṁ (bj, sya1ed, sya2ed, pts-vp-pli1) "}, "reference_text": {"ja389:0.1": "", "ja389:0.2": "", "ja389:0.3": "", "ja389:0.4": "", "ja389:1.1": "bj30.254, dr27.202, ms22J_1427, msdiv95, pts-vp-pli3.295", "ja389:1.2": "", "ja389:1.3": "", "ja389:1.4": "", "ja389:2.1": "csp1ed22.149, csp2ed22.149, ms22J_1428, msdiv96, ndp22.140, pts-vp-pli3.296, sya27.203", "ja389:2.2": "", "ja389:2.3": "", "ja389:2.4": "", "ja389:3.1": "ms22J_1429, msdiv97", "ja389:3.2": "", "ja389:3.3": "", "ja389:3.4": "", "ja389:4.1": "ms22J_1430, msdiv98", "ja389:4.2": "", "ja389:4.3": "", "ja389:4.4": "", "ja389:5.1": "ms22J_1431, msdiv99", "ja389:5.2": "", "ja389:5.3": "", "ja389:5.4": "", "ja389:6.1": "dr27.203, ms22J_1432, msdiv100, pts-vp-pli3.297, sya27.204, vri68.125", "ja389:6.2": "", "ja389:6.3": "", "ja389:6.4": "", "ja389:7.1": "ms22J_1433, msdiv101, pts-vp-pli3.298", "ja389:7.2": "", "ja389:7.3": "", "ja389:7.4": "", "ja389:8.1": "csp1ed22.150, csp2ed22.150, ms22J_1434, msdiv102, ndp22.141", "ja389:8.2": "", "ja389:8.3": "", "ja389:8.4": "", "ja389:9.1": "ms22J_1435"}, "keys_order": ["ja389:0.1", "ja389:0.2", "ja389:0.3", "ja389:0.4", "ja389:1.1", "ja389:1.2", "ja389:1.3", "ja389:1.4", "ja389:2.1", "ja389:2.2", "ja389:2.3", "ja389:2.4", "ja389:3.1", "ja389:3.2", "ja389:3.3", "ja389:3.4", "ja389:4.1", "ja389:4.2", "ja389:4.3", "ja389:4.4", "ja389:5.1", "ja389:5.2", "j