1": "<p><span class='verse-line'>{}</span>", "ja494:16.2": "<span class='verse-line'>{}</span>", "ja494:16.3": "<span class='verse-line'>{}</span>", "ja494:16.4": "<span class='verse-line'>{}</span></p>", "ja494:17.1": "<p><span class='verse-line'>{}</span>", "ja494:17.2": "<span class='verse-line'>{}</span>", "ja494:17.3": "<span class='verse-line'>{}</span>", "ja494:17.4": "<span class='verse-line'>{}</span></p>", "ja494:18.1": "<p><span class='verse-line'>{}</span>", "ja494:18.2": "<span class='verse-line'>{}</span>", "ja494:18.3": "<span class='verse-line'>{}</span>", "ja494:18.4": "<span class='verse-line'>{}</span></p>", "ja494:19.1": "<p><span class='verse-line'>{}</span>", "ja494:19.2": "<span class='verse-line'>{}</span>", "ja494:19.3": "<span class='verse-line'>{}</span>", "ja494:19.4": "<span class='verse-line'>{}</span></p>", "ja494:20.1": "<p><span class='verse-line'>{}</span>", "ja494:20.2": "<span class='verse-line'>{}</span>", "ja494:20.3": "<span class='verse-line'>{}</span>", "ja494:20.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja494:21.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja494:0.1": "Jātaka ", "ja494:0.2": "Pakiṇṇakanipāta ", "ja494:0.3": "Sālikedāravagga ", "ja494:0.4": "11. Sādhinajātaka ", "ja494:1.1": "“Abbhuto vata lokasmiṁ, ", "ja494:1.2": "uppajji lomahaṁsano; ", "ja494:1.3": "Dibbo ratho pāturahu, ", "ja494:1.4": "vedehassa yasassino”. ", "ja494:2.1": "Devaputto mahiddhiko, ", "ja494:2.2": "mātali devasārathi; ", "ja494:2.3": "Nimantayittha rājānaṁ, ", "ja494:2.4": "vedehaṁ mithilaggahaṁ. ", "ja494:3.1": "“Ehimaṁ rathamāruyha, ", "ja494:3.2": "rājaseṭṭha disampati; ", "ja494:3.3": "Devā dassanakāmā te, ", "ja494:3.4": "tāvatiṁsā saindakā; ", "ja494:3.5": "Saramānā hi te devā, ", "ja494:3.6": "sudhammāyaṁ samacchare”. ", "ja494:4.1": "Tato ca rājā sādhino, ", "ja494:4.2": "vedeho mithilaggaho; ", "ja494:4.3": "Sahassayuttamāruyha, ", "ja494:4.4": "agā devāna santike; ", "ja494:4.5": "Taṁ devā paṭinandiṁsu, ", "ja494:4.6": "disvā rājānamāgataṁ. ", "ja494:5.1": "“Svāgataṁ te mahārāja, ", "ja494:5.2": "atho te adurāgataṁ; ", "ja494:5.3": "Nisīda dāni rājīsi, ", "ja494:5.4": "devarājassa santike”. ", "ja494:6.1": "Sakkopi paṭinandittha, ", "ja494:6.2": "vedehaṁ mithilaggahaṁ; ", "ja494:6.3": "Nimantayittha kāmehi, ", "ja494:6.4": "āsanena ca vāsavo. ", "ja494:7.1": "“Sādhu khosi anuppatto, ", "ja494:7.2": "āvāsaṁ vasavattinaṁ; ", "ja494:7.3": "Vasa devesu rājīsi, ", "ja494:7.4": "sabbakāmasamiddhisu; ", "ja494:7.5": "Tāvatiṁsesu devesu, ", "ja494:7.6": "bhuñja kāme amānuse”. ", "ja494:8.1": "“Ahaṁ pure saggagato ramāmi, ", "ja494:8.2": "Naccehi gītehi ca vāditehi; ", "ja494:8.3": "So dāni ajja na ramāmi sagge, ", "ja494:8.4": "Āyuṁ nu khīṇo maraṇaṁ nu santike; ", "ja494:8.5": "Udāhu mūḷhosmi janindaseṭṭha”. ", "ja494:9.1": "“Na tāyu khīṇaṁ maraṇañca dūre, ", "ja494:9.2": "Na cāpi mūḷho naravīraseṭṭha; ", "ja494:9.3": "Tuyhañca puññāni parittakāni, ", "ja494:9.4": "Yesaṁ vipākaṁ idha vedayittho. ", "ja494:10.1": "Vasa devānubhāvena, ", "ja494:10.2": "rājaseṭṭha disampati; ", "ja494:10.3": "Tāvatiṁsesu devesu, ", "ja494:10.4": "bhuñja kāme amānuse”. ", "ja494:11.1": "“Yathā yācitakaṁ yānaṁ, ", "ja494:11.2": "yathā yācitakaṁ dhanaṁ; ", "ja494:11.3": "Evaṁsampadamevetaṁ, ", "ja494:11.4": "yaṁ parato dānapaccayā. ", "ja494:12.1": "Na cāhametamicchāmi, ", "ja494:12.2": "yaṁ parato dānapaccayā; ", "ja494:12.3": "Sayaṅkatāni puññāni, ", "ja494:12.4": "taṁ me āveṇikaṁ dhanaṁ. ", "ja494:13.1": "Sohaṁ gantvā manussesu, ", "ja494:13.2": "kāhāmi kusalaṁ bahuṁ; ", "ja494:13.3": "Dānena samacariyāya, ", "ja494:13.4": "saṁyamena damena ca; ", "ja494:13.5": "Yaṁ katvā sukhito hoti, ", "ja494:13.6": "na ca pacchānutappati. ", "ja494:14.1": "Imāni tāni khettāni, ", "ja494:14.2": "imaṁ nikkhaṁ sukuṇḍalaṁ; ", "ja494:14.3": "Imā tā haritānūpā, ", "ja494:14.4": "imā najjo savantiyo. ", "ja494:15.1": "Imā tā pokkharaṇī rammā, ", "ja494:15.2": "cakkavākapakūjitā; ", "ja494:15.3": "Mandālakehi sañchannā, ", "ja494:15.4": "padumuppalakehi ca; ", "ja494:15.5": "Yassimāni mamāyiṁsu, ", "ja494:15.6": "kiṁ nu te disataṁ gatā. ", "ja494:16.1": "Tānīdha khettāni so bhūmibhāgo, ", "ja494:16.2": "Teyeva ārāmavanūpacārā; ", "ja494:16.3": "Tameva mayhaṁ janataṁ apassato, ", "ja494:16.4": "Suññaṁva me nārada khāyate disā”. ", "ja494:17.1": "“Diṭṭhā mayā vimānāni, ", "ja494:17.2": "obhāsentā catuddisā; ", "ja494:17.3": "Sammukhā devarājassa, ", "ja494:17.4": "tidasānañca sammukhā. ", "ja494:18.1": "Vutthaṁ me bhavanaṁ dibyaṁ, ", "ja494:18.2": "Bhuttā kāmā amānusā; ", "ja494:18.3": "Tāvatiṁsesu devesu, ", "ja494:18.4": "Sabbakāmasamiddhisu. ", "ja494:19.1": "Sohaṁ etādisaṁ hitvā, ", "ja494:19.2": "puññāyamhi idhāgato; ", "ja494:19.3": "Dhammameva carissāmi, ", "ja494:19.4": "nāhaṁ rajjena atthiko. ", "ja494:20.1": "Adaṇḍāvacaraṁ maggaṁ, ", "ja494:20.2": "sammāsambuddhadesitaṁ; ", "ja494:20.3": "Taṁ maggaṁ paṭipajjissaṁ, ", "ja494:20.4": "yena gacchanti subbatā”ti. ", "ja494:21.1": "Sādhinajātakaṁ ekādasamaṁ. "}, "variant_text": {"ja494:0.1": "", "ja494:0.2": "", "ja494:0.3": "", "ja494:0.4": "", "ja494:1.1": "", "ja494:1.2": "", "ja494:1.3": "", "ja494:1.4": "", "ja494:2.1": "", "ja494:2.2": "mātali → mātalī (bj) ", "ja494:2.3": "Nimantayittha → nimantayī ca (bj, pts-vp-pli1) ", "ja494:2.4": "", "ja494:3.1": "", "ja494:3.2": "", "ja494:3.3": "", "ja494:3.4": "", "ja494:3.5": "", "ja494:3.6": "", "ja494:4.1": "sādhino → sādhīno (bj, pts-vp-pli1) ", "ja494:4.2": "vedeho mithilaggaho → pamukho rathamāruhi (bj, pts-vp-pli1) ", "ja494:4.3": "Sahassayuttamāruyha → … yuttaṁ abhiruyha (bj, sya1ed, sya2ed) ", "ja494:4.4": "", "ja494:4.5": "", "ja494:4.6": "", "ja494:5.1": "", "ja494:5.2": "", "ja494:5.3": "rājīsi → rājisi (bj, sya1ed, sya2ed, pts-vp-pli1) ", "ja494:5.4": "", "ja494:6.1": "", "ja494:6.2": "", "ja494:6.3": "", "ja494:6.4": "", "ja494:7.1": "", "ja494:7.2": "", "ja494:7.3": "", "ja494:7.4": "", "ja494:7.5": "", "ja494:7.6": "", "ja494:8.1": "", "ja494:8.2": ""