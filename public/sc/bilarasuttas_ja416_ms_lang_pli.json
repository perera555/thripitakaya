{"html_text": {"ja416:0.1": "<article id='ja416'><header><ul><li class='division'>{}</li>", "ja416:0.2": "<li>{}</li>", "ja416:0.3": "<li>{}</li></ul>", "ja416:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja416:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja416:1.2": "<span class='verse-line'>{}</span>", "ja416:1.3": "<span class='verse-line'>{}</span>", "ja416:1.4": "<span class='verse-line'>{}</span></p>", "ja416:2.1": "<p><span class='verse-line'>{}</span>", "ja416:2.2": "<span class='verse-line'>{}</span>", "ja416:2.3": "<span class='verse-line'>{}</span>", "ja416:2.4": "<span class='verse-line'>{}</span></p>", "ja416:3.1": "<p><span class='verse-line'>{}</span>", "ja416:3.2": "<span class='verse-line'>{}</span>", "ja416:3.3": "<span class='verse-line'>{}</span>", "ja416:3.4": "<span class='verse-line'>{}</span></p>", "ja416:4.1": "<p><span class='verse-line'>{}</span>", "ja416:4.2": "<span class='verse-line'>{}</span>", "ja416:4.3": "<span class='verse-line'>{}</span>", "ja416:4.4": "<span class='verse-line'>{}</span></p>", "ja416:5.1": "<p><span class='verse-line'>{}</span>", "ja416:5.2": "<span class='verse-line'>{}</span>", "ja416:5.3": "<span class='verse-line'>{}</span>", "ja416:5.4": "<span class='verse-line'>{}</span></p>", "ja416:6.1": "<p><span class='verse-line'>{}</span>", "ja416:6.2": "<span class='verse-line'>{}</span>", "ja416:6.3": "<span class='verse-line'>{}</span>", "ja416:6.4": "<span class='verse-line'>{}</span></p>", "ja416:7.1": "<p><span class='verse-line'>{}</span>", "ja416:7.2": "<span class='verse-line'>{}</span>", "ja416:7.3": "<span class='verse-line'>{}</span>", "ja416:7.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja416:8.1": "<p class='endsutta'>{}</p>", "ja416:8.2": "<p class='endvagga'>{}</p>", "ja416:9.1": "<p class='uddana-intro'>{}</p>", "ja416:10.1": "<blockquote class='uddanagatha'><p><span class='verse-line'>{}</span>", "ja416:10.2": "<span class='verse-line'>{}</span>", "ja416:10.3": "<span class='verse-line'>{}</span>", "ja416:10.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja416:11.1": "<p class='uddana-intro'>{}</p>", "ja416:12.1": "<blockquote class='uddanagatha'><p><span class='verse-line'>{}</span>", "ja416:12.2": "<span class='verse-line'>{}</span>", "ja416:12.3": "<span class='verse-line'>{}</span>", "ja416:12.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja416:13.1": "<p class='endsection'>{}</p></article>"}, "root_text": {"ja416:0.1": "Jātaka ", "ja416:0.2": "Sattakanipāta ", "ja416:0.3": "Gandhāravagga ", "ja416:0.4": "11. Parantapajātaka ", "ja416:1.1": "“Āgamissati me pāpaṁ, ", "ja416:1.2": "āgamissati me bhayaṁ; ", "ja416:1.3": "Tadā hi calitā sākhā, ", "ja416:1.4": "manussena migena vā”. ", "ja416:2.1": "“Bhīruyā nūna me kāmo, ", "ja416:2.2": "avidūre vasantiyā; ", "ja416:2.3": "Karissati kisaṁ paṇḍuṁ, ", "ja416:2.4": "sāva sākhā parantapaṁ. ", "ja416:3.1": "Socayissati maṁ kantā, ", "ja416:3.2": "gāme vasamaninditā; ", "ja416:3.3": "Karissati kisaṁ paṇḍuṁ, ", "ja416:3.4": "sāva sākhā parantapaṁ. ", "ja416:4.1": "Tayā maṁ asitāpaṅgi, ", "ja416:4.2": "sitāni bhaṇitāni ca; ", "ja416:4.3": "Kisaṁ paṇḍuṁ karissanti, ", "ja416:4.4": "sāva sākhā parantapaṁ”. ", "ja416:5.1": "“Agamā nūna so saddo, ", "ja416:5.2": "asaṁsi nūna so tava; ", "ja416:5.3": "Akkhātaṁ nūna taṁ tena, ", "ja416:5.4": "yo taṁ sākhamakampayi. ", "ja416:6.1": "Idaṁ kho taṁ samāgamma, ", "ja416:6.2": "mama bālassa cintitaṁ; ", "ja416:6.3": "Tadā hi calitā sākhā, ", "ja416:6.4": "manussena migena vā”. ", "ja416:7.1": "“Tatheva tvaṁ avedesi, ", "ja416:7.2": "Avañci pitaraṁ mama; ", "ja416:7.3": "Hantvā sākhāhi chādento, ", "ja416:7.4": "Āgamissati me bhayan”ti. ", "ja416:8.1": "Parantapajātakaṁ ekādasamaṁ. ", "ja416:8.2": "Gandhāravaggo dutiyo. ", "ja416:9.1": "Tassuddānaṁ ", "ja416:10.1": "Varagāma mahākapi bhaggava ca, ", "ja416:10.2": "Daḷhadhamma sakuñjara kesavaro; ", "ja416:10.3": "Urago vidhuro puna jāgarataṁ, ", "ja416:10.4": "Atha kosalādhipa parantapa cāti. ", "ja416:11.1": "Atha vagguddānaṁ ", "ja416:12.1": "Atha sattanipātamhi, ", "ja416:12.2": "vaggaṁ me bhaṇato suṇa; ", "ja416:12.3": "Kukku ca puna gandhāro, ", "ja416:12.4": "dveva vuttā mahesināti. ", "ja416:13.1": "Sattakanipātaṁ niṭṭhitaṁ. "}, "variant_text": {"ja416:0.1": "", "ja416:0.2": "", "ja416:0.3": "", "ja416:0.4": "", "ja416:1.1": "me → te (sya1ed, sya2ed, mr) ", "ja416:1.2": "", "ja416:1.3": "", "ja416:1.4": "", "ja416:2.1": "", "ja416:2.2": "", "ja416:2.3": "", "ja416:2.4": "", "ja416:3.1": "", "ja416:3.2": "", "ja416:3.3": "", "ja416:3.4": "", "ja416:4.1": "asitāpaṅgi → hasitāpaṅgi (bj, pts-vp-pli1); hasitāpaṅgī (sya1ed, sya2ed) ", "ja416:4.2": "sitāni → mihitāni (bj, sya1ed, sya2ed, pts-vp-pli1) ", "ja416:4.3": "", "ja416:4.4": "", "ja416:5.1": "", "ja416:5.2": "", "ja416:5.3": "", "ja416:5.4": "", "ja416:6.1": "", "ja416:6.2": "", "ja416:6.3": "", "ja416:6.4": "", "ja416:7.1": "", "ja416:7.2": "Avañci → avajjhi (mr) ", "ja416:7.3": "", "ja416:7.4": "", "ja416:8.1": "", "ja416:8.2": "", "ja416:9.1": "", "ja416:10.1": "", "ja416:10.2": "", "ja416:10.3": "", "ja416:10.4": "", "ja416:11.1": "", "ja416:12.1": "", "ja416:12.2": "", "ja416:12.3": "", "ja416:12.4": "", "ja416:13.1": ""}, "reference_text": {"ja416:0.1": "", "ja416:0.2": "", "ja416:0.3": "", "ja416:0.4": "", "ja416:1.1": "dr27.235, ms22J_1660, msdiv154, pts-vp-pli3.418, sya27.236", "ja416:1.2": "", "ja416:1.3": "", "ja416:1.4": "", "ja416:2.1": "ms22J_1661, msdiv155, pts-vp-pli3.419", "ja416:2.2": "", "ja416:2.3": "", "ja416:2.4": "", "ja416:3.1": "csp1ed22.174, csp2ed22.174, ms22J_1662, msdiv156", "ja416:3.2": "", "ja416:3.3": "", "ja416:3.4": "", "ja416:4.1": "ms22J_1663, msdiv157", "ja416:4.2": "", "ja416:4.3": "", "ja416:4.4": "", "ja416:5.1": "ms22J_1664, msdiv158, pts-vp-pli3.420", "ja416:5.2": "", "ja416:5.3": "", "ja416:5.4": "", "ja416:6.1": "bj30.300, ms22J_1665, msdiv159, ndp22.166, vri68.143", "ja416:6.2": "", "ja416:6.3": "", "ja416:6.4": "