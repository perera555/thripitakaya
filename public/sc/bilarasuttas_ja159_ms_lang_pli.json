{"html_text": {"ja159:0.1": "<article id='ja159'><header><ul><li class='division'>{}</li>", "ja159:0.2": "<li>{}</li>", "ja159:0.3": "<li>{}</li></ul>", "ja159:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja159:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja159:1.2": "<span class='verse-line'>{}</span>", "ja159:1.3": "<span class='verse-line'>{}</span>", "ja159:1.4": "<span class='verse-line'>{}</span></p>", "ja159:2.1": "<p><span class='verse-line'>{}</span>", "ja159:2.2": "<span class='verse-line'>{}</span>", "ja159:2.3": "<span class='verse-line'>{}</span>", "ja159:2.4": "<span class='verse-line'>{}</span>", "ja159:2.5": "<span class='verse-line'>{}</span>", "ja159:2.6": "<span class='verse-line'>{}</span></p>", "ja159:3.1": "<p><span class='verse-line'>{}</span>", "ja159:3.2": "<span class='verse-line'>{}</span>", "ja159:3.3": "<span class='verse-line'>{}</span>", "ja159:3.4": "<span class='verse-line'>{}</span></p>", "ja159:4.1": "<p><span class='verse-line'>{}</span>", "ja159:4.2": "<span class='verse-line'>{}</span>", "ja159:4.3": "<span class='verse-line'>{}</span>", "ja159:4.4": "<span class='verse-line'>{}</span>", "ja159:4.5": "<span class='verse-line'>{}</span>", "ja159:4.6": "<span class='verse-line'>{}</span></p></blockquote>", "ja159:5.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja159:0.1": "Jātaka ", "ja159:0.2": "Dukanipāta ", "ja159:0.3": "Daḷhavagga ", "ja159:0.4": "9. Morajātaka ", "ja159:1.1": "“Udetayañ cakkhumā ekarājā, ", "ja159:1.2": "Harissavaṇṇo pathavippabhāso; ", "ja159:1.3": "Taṁ taṁ namassāmi harissavaṇṇaṁ pathavippabhāsaṁ, ", "ja159:1.4": "Tayājja guttā viharemu divasaṁ. ", "ja159:2.1": "Ye brāhmaṇā vedagū sabbadhamme, ", "ja159:2.2": "Te me namo te ca maṁ pālayantu; ", "ja159:2.3": "Namatthu buddhānaṁ namatthu bodhiyā, ", "ja159:2.4": "Namo vimuttānaṁ namo vimuttiyā; ", "ja159:2.5": "Imaṁ so parittaṁ katvā, ", "ja159:2.6": "Moro carati esanā. ", "ja159:3.1": "Apetayaṁ cakkhumā ekarājā, ", "ja159:3.2": "Harissavaṇṇo pathavippabhāso; ", "ja159:3.3": "Taṁ taṁ namassāmi harissavaṇṇaṁ pathavippabhāsaṁ, ", "ja159:3.4": "Tayājja guttā viharemu rattiṁ. ", "ja159:4.1": "Ye brāhmaṇā vedagū sabbadhamme, ", "ja159:4.2": "Te me namo te ca maṁ pālayantu; ", "ja159:4.3": "Namatthu buddhānaṁ namatthu bodhiyā, ", "ja159:4.4": "Namo vimuttānaṁ namo vimuttiyā; ", "ja159:4.5": "Imaṁ so parittaṁ katvā, ", "ja159:4.6": "Moro vāsamakappayī”ti. ", "ja159:5.1": "Morajātakaṁ navamaṁ. "}, "variant_text": {"ja159:0.1": "", "ja159:0.2": "", "ja159:0.3": "", "ja159:0.4": "", "ja159:1.1": "", "ja159:1.2": "pathavippabhāso → paṭhavippabhāso (bj, sya1ed, sya2ed, pts-vp-pli1) ", "ja159:1.3": "", "ja159:1.4": "", "ja159:2.1": "vedagū → vedagu (sya1ed, sya2ed) ", "ja159:2.2": "", "ja159:2.3": "buddhānaṁ → buddhāna (?) ", "ja159:2.4": "vimuttānaṁ → vimuttāna (?) ", "ja159:2.5": "", "ja159:2.6": "", "ja159:3.1": "", "ja159:3.2": "", "ja159:3.3": "", "ja159:3.4": "", "ja159:4.1": "", "ja159:4.2": "", "ja159:4.3": "", "ja159:4.4": "", "ja159:4.5": "", "ja159:4.6": "", "ja159:5.1": ""}, "reference_text": {"ja159:0.1": "", "ja159:0.2": "", "ja159:0.3": "", "ja159:0.4": "", "ja159:1.1": "ms22J_364, msdiv17, pts-vp-pli2.33", "ja159:1.2": "", "ja159:1.3": "", "ja159:1.4": "", "ja159:2.1": "ms22J_365, pts-vp-pli2.34", "ja159:2.2": "", "ja159:2.3": "", "ja159:2.4": "", "ja159:2.5": "", "ja159:2.6": "", "ja159:3.1": "csp1ed22.39, csp2ed22.39, ms22J_366, msdiv18, ndp22.37, pts-vp-pli2.35, sya27.54", "ja159:3.2": "", "ja159:3.3": "", "ja159:3.4": "", "ja159:4.1": "dr27.54, ms22J_367", "ja159:4.2": "", "ja159:4.3": "", "ja159:4.4": "", "ja159:4.5": "", "ja159:4.6": "", "ja159:5.1": "ms22J_368"}, "keys_order": ["ja159:0.1", "ja159:0.2", "ja159:0.3", "ja159:0.4", "ja159:1.1", "ja159:1.2", "ja159:1.3", "ja159:1.4", "ja159:2.1", "ja159:2.2", "ja159:2.3", "ja159:2.4", "ja159:2.5", "ja159:2.6", "ja159:3.1", "ja159:3.2", "ja159:3.3", "ja159:3.4", "ja159:4.1", "ja159:4.2", "ja159:4.3", "ja159:4.4", "ja