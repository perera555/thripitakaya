{"html_text": {"ja211:0.1": "<article id='ja211'><header><ul><li class='division'>{}</li>", "ja211:0.2": "<li>{}</li>", "ja211:0.3": "<li>{}</li></ul>", "ja211:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja211:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja211:1.2": "<span class='verse-line'>{}</span>", "ja211:1.3": "<span class='verse-line'>{}</span>", "ja211:1.4": "<span class='verse-line'>{}</span></p>", "ja211:2.1": "<p><span class='verse-line'>{}</span>", "ja211:2.2": "<span class='verse-line'>{}</span>", "ja211:2.3": "<span class='verse-line'>{}</span>", "ja211:2.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja211:3.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja211:0.1": "Jātaka ", "ja211:0.2": "Dukanipāta ", "ja211:0.3": "Bīraṇathambhavagga ", "ja211:0.4": "1. Somadattajātaka ", "ja211:1.1": "“Akāsi yoggaṁ dhuvamappamatto, ", "ja211:1.2": "Saṁvaccharaṁ bīraṇathambhakasmiṁ; ", "ja211:1.3": "Byākāsi saññaṁ parisaṁ vigayha, ", "ja211:1.4": "Na niyyamo tāyati appapaññaṁ”. ", "ja211:2.1": "“Dvayaṁ yācanako tāta, ", "ja211:2.2": "somadatta nigacchati; ", "ja211:2.3": "Alābhaṁ dhanalābhaṁ vā, ", "ja211:2.4": "evaṁ dhammā hi yācanā”ti. ", "ja211:3.1": "Somadattajātakaṁ paṭhamaṁ. "}, "reference_text": {"ja211:0.1": "", "ja211:0.2": "", "ja211:0.3": "", "ja211:0.4": "", "ja211:1.1": "bj30.100, dr27.78, ms22J_538, msdiv121, ndp22.53, pts-vp-pli2.166", "ja211:1.2": "", "ja211:1.3": "", "ja211:1.4": "", "ja211:2.1": "csp1ed22.57, csp2ed22.57, ms22J_539, msdiv122, pts-vp-pli2.167, sya27.79", "ja211:2.2": "", "ja211:2.3": "", "ja211:2.4": "", "ja211:3.1": "ms22J_540"}, "keys_order": ["ja211:0.1", "ja211:0.2", "ja211:0.3", "ja211:0.4", "ja211:1.1", "ja211:1.2", "ja211:1.3", "ja211:1.4", "ja211:2.1", "ja211:2.2", "ja211:2.3", "ja211:2.4", "ja211:3.1"]}