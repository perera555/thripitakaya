[{"acronym": "Ja 103", "alt_acronym": null, "volpages": "PTS 1.413", "alt_volpages": null, "uid": "ja103", "blurb": "“If wise, thou ‘lt loiter not.”—This story was told by the Master at Jetavana about Anatha-pindika. For we hear that Anatha-pindika was returning from the village of which he was headman, when he saw robbers on the road. “It won’t do to loiter by the way,” thought he; “I must hurry on to Savatthi.” So he urged his oxen to speed and got safely into Savatthi. Next day he went to the monastery and told the Master what had befallen him. “Sir,” said the Master, “in other times too the wise and good espied robbers on the road and hastened without delay to their homes.” Then at the merchant’s request he told this story of the past.", "difficulty": null, "original_title": "Verijātaka", "root_lang": "pli", "root_lang_name": "Pāli", "type": "leaf", "translated_title": "Veri Jātaka", "translations": [{"lang": "pli", "lang_name": "Pāli", "is_root": true, "author": "Mahāsaṅgīti Tipiṭaka Buddhavasse 2500", "author_short": "ms", "author_uid": "ms", "publication_date": null, "id": "ja103_root-pli-ms", "segmented": true, "title": null, "volpage": null, "has_comment": false}, {"lang": "de", "lang_name": "Deutsch", "is_root": false, "author": "Dr. Julius Dutoit", "author_short": "Dutoit", "author_uid": "dutoit", "publication_date": "2007", "id": "de_ja103_dutoit", "segmented": false, "volpage": null, "has_comment": false}, {"author": "Robert Chalmers", "author_short": "Chalmers", "author_uid": "chalmers", "has_comment": false, "id": "en_ja103_chalmers", "is_root": false, "lang": "en", "lang_name": "English", "publication_date": "1895", "segmented": false, "volpage": null, "title": "Veri Jātaka"}, {"lang": "jpn", "lang_name": "日本語", "is_root": false, "author": "関西パーリ語実習会", "author_short": "関西パーリ語実習会", "author_uid": "kansai", "publication_date": "2023", "id": "jpn_ja103_kansai", "segmented": false, "volpage": null, "has_comment": false}, {"lang": "si", "lang_name": "සිංහල