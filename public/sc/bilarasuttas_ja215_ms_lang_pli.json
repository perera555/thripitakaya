{"html_text": {"ja215:0.1": "<article id='ja215'><header><ul><li class='division'>{}</li>", "ja215:0.2": "<li>{}</li>", "ja215:0.3": "<li>{}</li></ul>", "ja215:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja215:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja215:1.2": "<span class='verse-line'>{}</span>", "ja215:1.3": "<span class='verse-line'>{}</span>", "ja215:1.4": "<span class='verse-line'>{}</span></p>", "ja215:2.1": "<p><span class='verse-line'>{}</span>", "ja215:2.2": "<span class='verse-line'>{}</span>", "ja215:2.3": "<span class='verse-line'>{}</span>", "ja215:2.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja215:3.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja215:0.1": "Jātaka ", "ja215:0.2": "Dukanipāta ", "ja215:0.3": "Bīraṇathambhavagga ", "ja215:0.4": "5. Kacchapajātaka ", "ja215:1.1": "“Avadhī vata attānaṁ, ", "ja215:1.2": "kacchapo byāharaṁ giraṁ; ", "ja215:1.3": "Suggahītasmiṁ kaṭṭhasmiṁ, ", "ja215:1.4": "vācāya sakiyāvadhi. ", "ja215:2.1": "Etampi disvā naravīriyaseṭṭha, ", "ja215:2.2": "Vācaṁ pamuñce kusalaṁ nātivelaṁ; ", "ja215:2.3": "Passasi bahubhāṇena, ", "ja215:2.4": "Kacchapaṁ byasanaṁ gatan”ti. ", "ja215:3.1": "Kacchapajātakaṁ pañcamaṁ. "}, "variant_text": {"ja215:0.1": "", "ja215:0.2": "", "ja215:0.3": "", "ja215:0.4": "", "ja215:1.1": "", "ja215:1.2": "kacchapo byāharaṁ giraṁ → kacchapova pabyāharaṁ (sya1ed, sya2ed); kacchapo so pabyāharaṁ (mr) ", "ja215:1.3": "", "ja215:1.4": "", "ja215:2.1": "", "ja215:2.2": "", "ja215:2.3": "", "ja215:2.4": "", "ja215:3.1": ""}, "reference_text": {"ja215:0.1": "", "ja215:0.2": "", "ja215:0.3": "", "ja215:0.4": "", "ja215:1.1": "bj30.102, csp1ed22.58, csp2ed22.58, ms22J_550, msdiv129, pts-vp-pli2.177", "ja215:1.2": "", "ja215:1.3": "", "ja215:1.4": "", "ja215:2.1": "ms22J_551, msdiv130", "ja215:2.2": "", "ja215:2.3": "", "ja215:2.4": "", "ja215:3.1": "ms22J_552"}, "keys_order": ["ja215:0.1", "ja215:0.2", "ja215:0.3", "ja215:0.4", "ja215:1.1