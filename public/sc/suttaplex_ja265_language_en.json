[{"acronym": "Ja 265", "alt_acronym": null, "volpages": "PTS 2.336", "alt_volpages": null, "uid": "ja265", "blurb": "“When many a bow”—This story the Master told in Jetavana, about a Brother who had lost all energy. The Master asked, was it true that this Brother had lost his energy. Yes, he replied. “Why,” asked he, “have you slackened your energy, after embracing this doctrine of salvation? In days of yore, wise men were energetic even in matters which do not lead to salvation;” and so saying he told an old-world tale.", "difficulty": null, "original_title": "Khurappajātaka", "root_lang": "pli", "root_lang_name": "Pāli", "type": "leaf", "translated_title": "Khurappa Jātaka", "translations": [{"lang": "pli", "lang_name": "Pāli", "is_root": true, "author": "Mahāsaṅgīti Tipiṭaka Buddhavasse 2500", "author_short": "ms", "author_uid": "ms", "publication_date": null, "id": "ja265_root-pli-ms", "segmented": true, "title": null, "volpage": null, "has_comment": false}, {"lang": "de", "lang_name": "Deutsch", "is_root": false, "author": "Dr. Julius Dutoit", "author_short": "Dutoit", "author_uid": "dutoit", "publication_date": "2007", "id": "de_ja265_dutoit", "segmented": false, "volpage": null, "has_comment": false}, {"author": "W.H.D. Rouse", "author_short": "Rouse", "author_uid": "rouse", "has_comment": false, "id": "en_ja265_rouse", "is_root": false, "lang": "en", "lang_name": "English", "publication_date": "1895", "segmented": false, "volpage": null, "title": "Khurappa Jātaka"}, {"lang": "jpn", "lang_name": "日本語", "is_root": false, "author": "関西パーリ語実習会", "author_short": "関西パーリ語実習会", "author_uid": "kansai", "publication_date": "2023", "id": "jpn_ja265_kansai", "segmented": false, "volpage": null, "has_comment": false}, {"lang": "si", "lang_name": "සිංහල", "is_root": false, "author": "A.P. de Zoysa", "author_short": "Zoysa", "author_uid": "zoysa", "publication_date": null, "id": "si_ja265_zoysa", "segmented": false, "volpage": null, "has_comment": false}], "parallel_count"