{"html_text": {"ja214:0.1": "<article id='ja214'><header><ul><li class='division'>{}</li>", "ja214:0.2": "<li>{}</li>", "ja214:0.3": "<li>{}</li></ul>", "ja214:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja214:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja214:1.2": "<span class='verse-line'>{}</span>", "ja214:1.3": "<span class='verse-line'>{}</span>", "ja214:1.4": "<span class='verse-line'>{}</span></p>", "ja214:2.1": "<p><span class='verse-line'>{}</span>", "ja214:2.2": "<span class='verse-line'>{}</span>", "ja214:2.3": "<span class='verse-line'>{}</span>", "ja214:2.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja214:3.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja214:0.1": "Jātaka ", "ja214:0.2": "Dukanipāta ", "ja214:0.3": "Bīraṇathambhavagga ", "ja214:0.4": "4. Puṇṇanadījātaka ", "ja214:1.1": "“Puṇṇaṁ nadiṁ yena ca peyyamāhu, ", "ja214:1.2": "Jātaṁ yavaṁ yena ca guyhamāhu; ", "ja214:1.3": "Dūraṁ gataṁ yena ca avhayanti, ", "ja214:1.4": "So tyāgato handa ca bhuñja brāhmaṇa”. ", "ja214:2.1": "“Yato maṁ saratī rājā, ", "ja214:2.2": "vāyasampi pahetave; ", "ja214:2.3": "Haṁsā koñcā mayūrā ca, ", "ja214:2.4": "asatīyeva pāpiyā”ti. ", "ja214:3.1": "Puṇṇanadījātakaṁ catutthaṁ. "}, "variant_text": {"ja214:0.1": "", "ja214:0.2": "", "ja214:0.3": "", "ja214:0.4": "", "ja214:1.1": "", "ja214:1.2": "", "ja214:1.3": "", "ja214:1.4": "tyāgato → tyābhato (sya1ed, sya2ed, mr) ", "ja214:2.1": "", "ja214:2.2": "", "ja214:2.3": "Haṁsā koñcā mayūrā ca → haṁsakoñcamayūrānaṁ (mr, aṭṭhakathāyaṁ pāṭhantaraṁ) ", "ja214:2.4": "", "ja214:3.1": ""}, "reference_text": {"ja214:0.1": "", "ja214:0.2": "", "ja214:0.3": "", "ja214:0.4": "", "ja214:1.1": "ms22J_547, msdiv127, pts-vp-pli2.174, sya27.80", "ja214:1.2": "", "ja214:1.3": "", "ja214:1.4": "", "ja214:2.1": "ms22J_548, msdiv128, ndp22.54, pts-vp-pli2.175", "ja214:2.2": "", "ja214:2.3": "", "ja214:2.4": "", "ja214:3.1": "ms22J_549"}, "keys_order": ["ja214:0.1", "ja214:0.2", "ja214:0.3", "ja214:0.4", "ja214:1.1", "ja214:1.2", "ja214:1.3", "ja214:1.4", "ja214:2.1", "ja214:2.2", "ja214:2.3", "ja214:2.4", "ja214:3.1"]}