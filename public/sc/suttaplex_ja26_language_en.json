[{"acronym": "Ja 26", "alt_acronym": null, "volpages": "PTS 1.188", "alt_volpages": null, "uid": "ja26", "blurb": "“Through hearing first.”—This story was told by the Master while at the Bamboo-grove, about Devadatta, who, having secured the adherence of Prince Ajata-sattu, had attained both gain and honour. Prince Ajata-sattu had a Monastery built for Devadatta at Gaya-sisa, and every day brought to him five hundred kettles of perfumed three-year-old rice flavoured with all the choicest flavourings. All this gain and honour brought Devadatta a great following, with whom Devadatta lived on, without ever stirring out of his Monastery.", "difficulty": null, "original_title": "Mahiḷāmukhajātaka", "root_lang": "pli", "root_lang_name": "Pāli", "type": "leaf", "translated_title": "Damsel-face the Brigand ", "translations": [{"lang": "pli", "lang_name": "Pāli", "is_root": true, "author": "Mahāsaṅgīti Tipiṭaka Buddhavasse 2500", "author_short": "ms", "author_uid": "ms", "publication_date": null, "id": "ja26_root-pli-ms", "segmented": true, "title": null, "volpage": null, "has_comment": false}, {"lang": "de", "lang_name": "Deutsch", "is_root": false, "author": "Sabbamitta", "author_short": "sabbamitta", "author_uid": "sabbamitta", "publication_date": null, "id": "ja26_translation-de-sabbamitta", "segmented": true, "title": "Der Elefant Damengesicht ", "volpage": null, "has_comment": true}, {"lang": "de", "lang_name": "Deutsch", "is_root": false, "author": "Dr. Julius Dutoit", "author_short": "Dutoit", "author_uid": "dutoit", "publication_date": "2007", "id": "de_ja26_dutoit", "segmented": false, "volpage": null, "has_comment": false}, {"lang": "en", "lang_name": "English", "is_root": false, "author": "Bhikkhu Sujato", "author_short": "sujato", "author_uid": "sujato", "publication_date": null, "id": "ja26_translation-en-sujato", "segmented": true, "title": "Damsel-face the Brigand ", "volpage": null, "has_comment": true}, {"author": "Robert Chalmers", "author_short": "Chalmer