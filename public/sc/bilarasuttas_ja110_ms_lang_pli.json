{"html_text": {"ja110:0.1": "<article id='ja110'><header><ul><li class='division'>{}</li>", "ja110:0.2": "<li>{}</li>", "ja110:0.3": "<li>{}</li></ul>", "ja110:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja110:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja110:1.2": "<span class='verse-line'>{}</span>", "ja110:1.3": "<span class='verse-line'>{}</span>", "ja110:1.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja110:2.1": "<p class='endsutta'>{}</p>", "ja110:2.2": "<p class='endvagga'>{}</p>", "ja110:3.1": "<p class='uddana-intro'>{}</p>", "ja110:4.1": "<blockquote class='uddanagatha'><p><span class='verse-line'>{}</span>", "ja110:4.2": "<span class='verse-line'>{}</span>", "ja110:4.3": "<span class='verse-line'>{}</span>", "ja110:4.4": "<span class='verse-line'>{}</span></p></blockquote></article>"}, "root_text": {"ja110:0.1": "Jātaka ", "ja110:0.2": "Ekakanipāta ", "ja110:0.3": "Parosatavagga ", "ja110:0.4": "10. Sabbasaṁhārakapañhajātaka ", "ja110:1.1": "“Sabbasaṁhārako natthi, ", "ja110:1.2": "suddhaṁ kaṅgu pavāyati; ", "ja110:1.3": "Alikaṁ bhāyatiyaṁ dhuttī, ", "ja110:1.4": "saccamāha mahallikā”ti. ", "ja110:2.1": "Sabbasaṁhārakapañhajātakaṁ dasamaṁ. ", "ja110:2.2": "Parosatavaggo ekādasamo. ", "ja110:3.1": "Tassuddānaṁ ", "ja110:4.1": "Saparosatatāyitaverī puna, ", "ja110:4.2": "Bhamacakkatha nāgasirivhayano; ", "ja110:4.3": "Sukhakañca vata sippaka bāhiyā, ", "ja110:4.4": "Kuṇḍapūva mahallikakā ca dasāti. "}, "variant_text": {"ja110:0.1": "", "ja110:0.2": "", "ja110:0.3": "", "ja110:0.4": "", "ja110:1.1": "Sabbasaṁhārako → sabbasāhārako (mr) ", "ja110:1.2": "", "ja110:1.3": "", "ja110:1.4": "", "ja110:2.1": "Sabbasaṁhārakapañhajātakaṁ dasamaṁ → sabbasaṁhārakapañho dasamo (sya1ed, sya2ed, pts-vp-pli1) ", "ja110:2.2": "", "ja110:3.1": "", "ja110:4.1": "", "ja110:4.2": "", "ja110:4.3": "", "ja110:4.4": ""}, "reference_text": {"ja110:0.1": "", "ja110:0.2": "", "ja110:0.3": "", "ja110:0.4": "", "ja110:1.1": "csp1ed22.