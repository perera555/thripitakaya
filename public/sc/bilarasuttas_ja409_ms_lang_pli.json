{"html_text": {"ja409:0.1": "<article id='ja409'><header><ul><li class='division'>{}</li>", "ja409:0.2": "<li>{}</li>", "ja409:0.3": "<li>{}</li></ul>", "ja409:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja409:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja409:1.2": "<span class='verse-line'>{}</span>", "ja409:1.3": "<span class='verse-line'>{}</span>", "ja409:1.4": "<span class='verse-line'>{}</span></p>", "ja409:2.1": "<p><span class='verse-line'>{}</span>", "ja409:2.2": "<span class='verse-line'>{}</span>", "ja409:2.3": "<span class='verse-line'>{}</span>", "ja409:2.4": "<span class='verse-line'>{}</span></p>", "ja409:3.1": "<p><span class='verse-line'>{}</span>", "ja409:3.2": "<span class='verse-line'>{}</span>", "ja409:3.3": "<span class='verse-line'>{}</span>", "ja409:3.4": "<span class='verse-line'>{}</span></p>", "ja409:4.1": "<p><span class='verse-line'>{}</span>", "ja409:4.2": "<span class='verse-line'>{}</span>", "ja409:4.3": "<span class='verse-line'>{}</span>", "ja409:4.4": "<span class='verse-line'>{}</span></p>", "ja409:5.1": "<p><span class='verse-line'>{}</span>", "ja409:5.2": "<span class='verse-line'>{}</span>", "ja409:5.3": "<span class='verse-line'>{}</span>", "ja409:5.4": "<span class='verse-line'>{}</span></p>", "ja409:6.1": "<p><span class='verse-line'>{}</span>", "ja409:6.2": "<span class='verse-line'>{}</span>", "ja409:6.3": "<span class='verse-line'>{}</span>", "ja409:6.4": "<span class='verse-line'>{}</span></p>", "ja409:7.1": "<p><span class='verse-line'>{}</span>", "ja409:7.2": "<span class='verse-line'>{}</span>", "ja409:7.3": "<span class='verse-line'>{}</span>", "ja409:7.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja409:8.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja409:0.1": "Jātaka ", "ja409:0.2": "Sattakanipāta ", "ja409:0.3": "Gandhāravagga ", "ja409:0.4": "4. Daḷhadhammajātaka ", "ja409:1.1": "“Ahañce daḷhadhammassa, ", "ja409:1.2": "vahantī nābhirādhayiṁ; ", "ja409:1.3": "Dharantī urasi sallaṁ, ", "ja409:1.4": "yuddhe vikkantacārinī. ", "ja409:2.1": "Nūna rājā na jānāti, ", "ja409:2.2": "mama vikkamaporisaṁ; ", "ja409:2.3": "Saṅgāme sukatantāni, ", "ja409:2.4": "dūtavippahitāni ca. ", "ja409:3.1": "Sā nūnāhaṁ marissāmi, ", "ja409:3.2": "abandhu aparāyinī; ", "ja409:3.3": "Tadā hi kumbhakārassa, ", "ja409:3.4": "dinnā chakaṇahārikā”. ", "ja409:4.1": "“Yāvatāsīsatī poso, ", "ja409:4.2": "tāvadeva pavīṇati; ", "ja409:4.3": "Atthāpāye jahanti naṁ, ", "ja409:4.4": "oṭṭhibyādhiṁva khattiyo. ", "ja409:5.1": "Yo pubbe katakalyāṇo, ", "ja409:5.2": "katattho nāvabujjhati; ", "ja409:5.3": "Atthā tassa palujjanti, ", "ja409:5.4": "ye honti abhipatthitā. ", "ja409:6.1": "Yo pubbe katakalyāṇo, ", "ja409:6.2": "katattho manubujjhati; ", "ja409:6.3": "Atthā tassa pavaḍḍhanti, ", "ja409:6.4": "ye honti abhipatthitā. ", "ja409:7.1": "Taṁ vo vadāmi bhaddante, ", "ja409:7.2": "yāvantettha samāgatā; ", "ja409:7.3": "Sabbe kataññuno hotha, ", "ja409:7.4": "ciraṁ saggamhi ṭhassathā”ti. ", "ja409:8.1": "Daḷhadhammajātakaṁ catutthaṁ. "}, "variant_text": {"ja409:0.1": "", "ja409:0.2": "", "ja409:0.3": "", "ja409:0.4": "", "ja409:1.1": "daḷhadhammassa → daḷhadhammāya (bj, pts-vp-pli1) ", "ja409:1.2": "", "ja409:1.3": "", "ja409:1.4": "", "ja409:2.1": "Nūna rājā na jānāti → naha nūna rājā jānāti (bj, pts-vp-pli1) ", "ja409:2.2": "", "ja409:2.3": "", "ja409:2.4": "", "ja409:3.1": "", "ja409:3.2": "aparāyinī → aparāyaṇī (?) ", "ja409:3.3": "Tadā hi → tathā hi (pts-vp-pli1) ", "ja409:3.4": "", "ja409:4.1": "", "ja409:4.2": "", "ja409:4.3": "", "ja409:4.4": "", "ja409:5.1": "", "ja409:5.2": "", "ja409:5.3": "", "ja409:5.4": "", "ja409:6.1": "", "ja409:6.2": "", "ja409:6.3": "", "ja409:6.4": "", "ja409:7.1": "bhaddante → bhaddaṁ vo (bj, sya1ed, sya2ed, pts-vp-pli1) ", "ja409:7.2": "", "ja409:7.3": "", "ja409:7.4": "", "ja409:8.1": ""}, "reference_text": {"ja409:0.1": "", "ja409:0.2": "", "ja409:0.3": "", "ja409:0.4": "", "ja409:1.1": "ms22J_1597, msdiv9