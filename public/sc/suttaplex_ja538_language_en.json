[{"acronym": "Ja 538", "alt_acronym": null, "volpages": "PTS 6.4, PTS 6.12, PTS 6.13, PTS 6.14, PTS 6.15, PTS 6.16, PTS 6.17, PTS 6.18, PTS 6.19, PTS 6.20, PTS 6.21, PTS 6.22, PTS 6.23, PTS 6.24, PTS 6.25, PTS 6.26, PTS 6.27, PTS 6.28", "alt_volpages": null, "uid": "ja538", "blurb": "“Shew no intelligence”—This story the Master told at Jatavana concerning the great renunciation. One day the Brethren seated in the Hall of Truth were discussing the praises of the Blessed One’s great renunciation. When the Master came and inquired of the Brethren what was the topic which they were discussing as they sat there, on hearing what it was, he said, “No, Brethren, this my renunciation of the world, after leaving my kingdom, was not wonderful, when I had fully exercised the perfections; for before, even when my wisdom was still immature, and while I was still attaining the perfections, I left my kingdom and renounced the world.” And at their request he told them a story of the past.", "difficulty": null, "original_title": "Mūgapakkhajātaka", "root_lang": "pli", "root_lang_name": "Pāli", "type": "leaf", "translated_title": "Muga-Pakkha Jātaka", "translations": [{"lang": "pli", "lang_name": "Pāli", "is_root": true, "author": "Mahāsaṅgīti Tipiṭaka Buddhavasse 2500", "author_short": "ms", "author_uid": "ms", "publication_date": null, "id": "ja538_root-pli-ms", "segmented": true, "title": null, "volpage": null, "has_comment": false}, {"lang": "de", "lang_name": "Deutsch", "is_root": false, "author": "Dr. Julius Dutoit", "author_short": "Dutoit", "author_uid": "dutoit", "publication_date": "2007", "id": "de_ja538_dutoit", "segmented": false, "volpage": null, "has_comment": false}, {"author": "E.B. Cowell, W.H.D. Rouse", "author_short": "Cowell …", "author_uid": "cowell-rouse", "has_comment": false, "id": "en_ja538_cowell-rouse", "is_root": false, "lang": "en", "lang_name": "English", "publication_date": "1907", "segmented": false, "volpage": null, "title": "Muga-Pakkha Jātaka"}, {"l