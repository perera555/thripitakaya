[{"acronym": "Ja 69", "alt_acronym": null, "volpages": "PTS 1.311", "alt_volpages": null, "uid": "ja69", "blurb": "“May shame.”—This story was told by the Master while at Jetavana about Sariputta, the Captain of the Faith. Tradition says that in the days when the Elder used to eat meal-cakes, folks came to the monastery with a quantity of such cakes for the Brotherhood. After the Brethren had all eaten their fill, much remained over; and the givers said, “Sirs, take some for those too who are away in the village.”", "difficulty": null, "original_title": "Visavantajātaka", "root_lang": "pli", "root_lang_name": "Pāli", "type": "leaf", "translated_title": "Poison Once Expelled ", "translations": [{"lang": "pli", "lang_name": "Pāli", "is_root": true, "author": "Mahāsaṅgīti Tipiṭaka Buddhavasse 2500", "author_short": "ms", "author_uid": "ms", "publication_date": null, "id": "ja69_root-pli-ms", "segmented": true, "title": null, "volpage": null, "has_comment": false}, {"lang": "de", "lang_name": "Deutsch", "is_root": false, "author": "Sabbamitta", "author_short": "sabbamitta", "author_uid": "sabbamitta", "publication_date": null, "id": "ja69_translation-de-sabbamitta", "segmented": true, "title": "Ausgespienes Gift ", "volpage": null, "has_comment": true}, {"lang": "de", "lang_name": "Deutsch", "is_root": false, "author": "Dr. Julius Dutoit", "author_short": "Dutoit", "author_uid": "dutoit", "publication_date": "2007", "id": "de_ja69_dutoit", "segmented": false, "volpage": null, "has_comment": false}, {"lang": "en", "lang_name": "English", "is_root": false, "author": "Bhikkhu Sujato", "author_short": "sujato", "author_uid": "sujato", "publication_date": null, "id": "ja69_translation-en-sujato", "segmented": true, "title": "Poison Once Expelled ", "volpage": null, "has_comment": true}, {"author": "Robert Chalmers", "author_short": "Chalmers", "author_uid": "chalmers", "has_comment": false, "id": "en_ja69_chalmers", "is_root": false, "lang": "en", "lang_name": "English", "pu