{"html_text": {"ja10:0.1": "<article id='ja10'><header><ul><li class='division'>{}</li>", "ja10:0.2": "<li>{}</li>", "ja10:0.3": "<li>{}</li></ul>", "ja10:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja10:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja10:1.2": "<span class='verse-line'>{}</span>", "ja10:1.3": "<span class='verse-line'>{}</span>", "ja10:1.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja10:2.1": "<p class='endsutta'>{}</p>", "ja10:2.2": "<p class='endvagga'>{}</p>", "ja10:3.1": "<p class='uddana-intro'>{}</p>", "ja10:4.1": "<blockquote class='uddanagatha'><p><span class='verse-line'>{}</span>", "ja10:4.2": "<span class='verse-line'>{}</span>", "ja10:4.3": "<span class='verse-line'>{}</span>", "ja10:4.4": "<span class='verse-line'>{}</span></p></blockquote></article>"}, "root_text": {"ja10:0.1": "Jātaka ", "ja10:0.2": "Ekakanipāta ", "ja10:0.3": "Apaṇṇakavagga ", "ja10:0.4": "10. Sukhavihārijātaka ", "ja10:1.1": "“Yañca aññe na rakkhanti, ", "ja10:1.2": "yo ca aññe na rakkhati; ", "ja10:1.3": "Sa ve rāja sukhaṁ seti, ", "ja10:1.4": "kāmesu anapekkhavā”ti. ", "ja10:2.1": "Sukhavihārijātakaṁ dasamaṁ. ", "ja10:2.2": "Apaṇṇakavaggo paṭhamo. ", "ja10:3.1": "Tassuddānaṁ ", "ja10:4.1": "Varāpaṇṇaka vaṇṇupatha serivaro, ", "ja10:4.2": "Suvicakkhaṇa taṇḍulanāḷikassā; ", "ja10:4.3": "Hiri puttavaruttagāmaṇinā, ", "ja10:4.4": "Yo ca na rakkhati tena dasāti. "}, "reference_text": {"ja10:0.1": "", "ja10:0.2": "", "ja10:0.3": "", "ja10:0.4": "", "ja10:1.1": "dr27.4, ms22J_20, msdiv10, ndp22.5, pts-vp-pli1.141, sya27.4", "ja10:1.2": "", "ja10:1.3": "", "ja10:1.4": "", "ja10:2.1": "ms22J_21", "ja10:2.2": "", "ja10:3.1": "ms22J_22", "ja10:4.1": "ms22J_23", "ja10:4.2": "", "ja10:4.3": "", "ja10:4.4": ""}, "keys_order": ["ja10:0.1", "ja10:0.2", "ja10:0.3", "ja10:0.4", "ja10:1.1", "ja10:1.2", "ja10:1.3", "ja10:1.4", "ja10:2.1", "ja10:2.2", "ja10:3.1", "ja10:4.1", "ja10:4.2", "ja10:4.3", "ja10:4.4"]}