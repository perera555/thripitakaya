{"html_text": {"ja133:0.1": "<article id='ja133'><header><ul><li class='division'>{}</li>", "ja133:0.2": "<li>{}</li>", "ja133:0.3": "<li>{}</li></ul>", "ja133:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja133:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja133:1.2": "<span class='verse-line'>{}</span>", "ja133:1.3": "<span class='verse-line'>{}</span>", "ja133:1.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja133:2.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja133:0.1": "Jātaka ", "ja133:0.2": "Ekakanipāta ", "ja133:0.3": "Asampadānavagga ", "ja133:0.4": "3. Ghatāsanajātaka ", "ja133:1.1": "“Khemaṁ yahiṁ tattha arī udīrito, ", "ja133:1.2": "Dakassa majjhe jalate ghatāsano; ", "ja133:1.3": "Na ajja vāso mahiyā mahīruhe, ", "ja133:1.4": "Disā bhajavho saraṇājja no bhayan”ti. ", "ja133:2.1": "Ghatāsanajātakaṁ tatiyaṁ. "}, "variant_text": {"ja133:0.1": "", "ja133:0.2": "", "ja133:0.3": "", "ja133:0.4": "", "ja133:1.1": "arī udīrito → ari uddharito (mr) ", "ja133:1.2": "", "ja133:1.3": "", "ja133:1.4": "", "ja133:2.1": ""}, "reference_text": {"ja133:0.1": "", "ja133:0.2": "", "ja133:0.3": "", "ja133:0.4": "", "ja133:1.1": "ms22J_295, msdiv133, pts-vp-pli1.472", "ja133:1.2": "", "ja133:1.3": "", "ja133:1.4": "", "ja133:2.1": "ms22J_296"}, "keys_order": ["ja133:0.1", "ja133:0.2", "ja133:0.3", "ja133:0.4", "ja133:1.1", "ja133:1.2", "ja133:1.3", "ja133:1.4", "ja133:2.1"]}