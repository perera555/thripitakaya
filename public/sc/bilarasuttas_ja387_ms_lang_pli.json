{"html_text": {"ja387:0.1": "<article id='ja387'><header><ul><li class='division'>{}</li>", "ja387:0.2": "<li>{}</li>", "ja387:0.3": "<li>{}</li></ul>", "ja387:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja387:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja387:1.2": "<span class='verse-line'>{}</span>", "ja387:1.3": "<span class='verse-line'>{}</span>", "ja387:1.4": "<span class='verse-line'>{}</span></p>", "ja387:2.1": "<p><span class='verse-line'>{}</span>", "ja387:2.2": "<span class='verse-line'>{}</span>", "ja387:2.3": "<span class='verse-line'>{}</span>", "ja387:2.4": "<span class='verse-line'>{}</span></p>", "ja387:3.1": "<p><span class='verse-line'>{}</span>", "ja387:3.2": "<span class='verse-line'>{}</span>", "ja387:3.3": "<span class='verse-line'>{}</span>", "ja387:3.4": "<span class='verse-line'>{}</span></p>", "ja387:4.1": "<p><span class='verse-line'>{}</span>", "ja387:4.2": "<span class='verse-line'>{}</span>", "ja387:4.3": "<span class='verse-line'>{}</span>", "ja387:4.4": "<span class='verse-line'>{}</span></p>", "ja387:5.1": "<p><span class='verse-line'>{}</span>", "ja387:5.2": "<span class='verse-line'>{}</span>", "ja387:5.3": "<span class='verse-line'>{}</span>", "ja387:5.4": "<span class='verse-line'>{}</span></p>", "ja387:6.1": "<p><span class='verse-line'>{}</span>", "ja387:6.2": "<span class='verse-line'>{}</span>", "ja387:6.3": "<span class='verse-line'>{}</span>", "ja387:6.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja387:7.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja387:0.1": "Jātaka ", "ja387:0.2": "Chakkanipāta ", "ja387:0.3": "Kharaputtavagga ", "ja387:0.4": "2. Sūcijātaka ", "ja387:1.1": "“Akakkasaṁ apharusaṁ, ", "ja387:1.2": "kharadhotaṁ supāsiyaṁ; ", "ja387:1.3": "Sukhumaṁ tikhiṇaggañca, ", "ja387:1.4": "ko sūciṁ ketumicchati. ", "ja387:2.1": "Sumajjañca supāsañca, ", "ja387:2.2": "anupubbaṁ suvaṭṭitaṁ; ", "ja387:2.3": "Ghanaghātimaṁ paṭithaddhaṁ, ", "ja387:2.4": "ko sūciṁ ketumicchati”. ", "ja387:3.1": "“Ito dāni patāyanti, ", "ja387:3.2": "sūciyo baḷisāni ca; ", "ja387:3.3": "Koyaṁ kammāragāmasmiṁ, ", "ja387:3.4": "sūciṁ vikketumicchati. ", "ja387:4.1": "Ito satthāni gacchanti, ", "ja387:4.2": "Kammantā vividhā puthū; ", "ja387:4.3": "Koyaṁ kammāragāmasmiṁ, ", "ja387:4.4": "Sūciṁ vikketumicchati”. ", "ja387:5.1": "“Sūciṁ kammāragāmasmiṁ, ", "ja387:5.2": "vikketabbā pajānatā; ", "ja387:5.3": "Ācariyāva jānanti, ", "ja387:5.4": "kammaṁ sukatadukkaṭaṁ. ", "ja387:6.1": "Imañce te pitā bhadde, ", "ja387:6.2": "Sūciṁ jaññā mayā kataṁ; ", "ja387:6.3": "Tayā ca maṁ nimanteyya, ", "ja387:6.4": "Yañcatthaññaṁ ghare dhanan”ti. ", "ja387:7.1": "Sūcijātakaṁ dutiyaṁ. "}, "variant_text": {"ja387:0.1": "", "ja387:0.2": "", "ja387:0.3": "", "ja387:0.4": "", "ja387:1.1": "", "ja387:1.2": "", "ja387:1.3": "", "ja387:1.4": "", "ja387:2.1": "", "ja387:2.2": "anupubbaṁ → anupubba (sya1ed, sya2ed) ", "ja387:2.3": "", "ja387:2.4": "", "ja387:3.1": "", "ja387:3.2": "", "ja387:3.3": "", "ja387:3.4": "", "ja387:4.1": "", "ja387:4.2": "", "ja387:4.3": "", "ja387:4.4": "Sūciṁ → sūcī (pts-vp-pli1) | vikketumicchati → … marahati (bj, sya1ed, sya2ed) ", "ja387:5.1": "", "ja387:5.2": "", "ja387:5.3": "Ācariyāva jānanti → ācariyā pajānanti (sya1ed, sya2ed); ācariyāva sañjānanti (pts-vp-pli1); ācariyā sañjānanti (mr) ", "ja387:5.4": "sukatadukkaṭaṁ → … dukkataṁ (bj, pts-vp-pli1) ", "ja387:6.1": "Imañce → imañca (bj, sya1ed, sya2ed, pts-vp-pli1) ", "ja387:6.2": "", "ja387:6.3": "", "ja387:6.4": "", "ja387:7.1": ""}, "reference_text": {"ja387:0.1": "", "ja387:0.2": "", "ja387:0.3": "", "ja387:0.4": "", "ja387:1.1": "dr27.200, ms22J_1413, msdiv83, pts-vp-pli3.282", "ja387:1.2": "", "ja387:1.3": "", "ja387:1.4": "", "ja387:2.1": "ms22J_1414, msdiv84", "ja387:2.2": "", "ja387:2.3": "", "ja387:2.4": "", "ja387:3.1": "ms22J_1415, msdiv85, pts-vp-pli3.283", "ja387:3.2": "", "ja387:3.3": "", "ja387:3.4": "", "ja387:4.1": "ms22J_1416, msdiv86", "ja387:4.2": "", "ja387:4