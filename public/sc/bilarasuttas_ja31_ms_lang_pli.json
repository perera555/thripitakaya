{"html_text": {"ja31:0.1": "<article id='ja31'><header><ul><li class='division'>{}</li>", "ja31:0.2": "<li>{}</li>", "ja31:0.3": "<li>{}</li></ul>", "ja31:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja31:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja31:1.2": "<span class='verse-line'>{}</span>", "ja31:1.3": "<span class='verse-line'>{}</span>", "ja31:1.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja31:2.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja31:0.1": "Jātaka ", "ja31:0.2": "Ekakanipāta ", "ja31:0.3": "Kulāvakavagga ", "ja31:0.4": "1. Kulāvakajātaka ", "ja31:1.1": "“Kulāvakā mātali simbalismiṁ, ", "ja31:1.2": "Īsāmukhena parivajjayassu; ", "ja31:1.3": "Kāmaṁ cajāma asuresu pāṇaṁ, ", "ja31:1.4": "Māme dijā vikkulāvā ahesun”ti. ", "ja31:2.1": "Kulāvakajātakaṁ paṭhamaṁ. "}, "variant_text": {"ja31:0.1": "", "ja31:0.2": "", "ja31:0.3": "", "ja31:0.4": "", "ja31:1.1": "", "ja31:1.2": "", "ja31:1.3": "", "ja31:1.4": "vikkulāvā → māyime dijā vikulāvā (bj, sya1ed, sya2ed, pts-vp-pli1); mā me dijā vikkulavā (csp1ed) ", "ja31:2.1": "Kulāvakajātakaṁ → vikkulāvājātakaṁ (sya2ed) "}, "reference_text": {"ja31:0.1": "", "ja31:0.2": "", "ja31:0.3": "", "ja31:0.4": "", "ja31:1.1": "bj30.14, dr27.12, ms22J_68, msdiv31, pts-vp-pli1.203, sya27.11", "ja31:1.2": "", "ja31:1.3": "", "ja31:1.4": "", "ja31:2.1": "ms22J_69"}, "keys_order": ["ja31:0.1", "ja31:0.2", "ja31:0.3", "ja31:0.4", "ja31:1.1", "ja31:1.2", "ja31:1.3", "ja31:1.4", "ja31:2.1"]}