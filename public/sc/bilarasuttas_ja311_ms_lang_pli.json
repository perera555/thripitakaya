{"html_text": {"ja311:0.1": "<article id='ja311'><header><ul><li class='division'>{}</li>", "ja311:0.2": "<li>{}</li>", "ja311:0.3": "<li>{}</li></ul>", "ja311:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja311:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja311:1.2": "<span class='verse-line'>{}</span>", "ja311:1.3": "<span class='verse-line'>{}</span>", "ja311:1.4": "<span class='verse-line'>{}</span></p>", "ja311:2.1": "<p><span class='verse-line'>{}</span>", "ja311:2.2": "<span class='verse-line'>{}</span>", "ja311:2.3": "<span class='verse-line'>{}</span>", "ja311:2.4": "<span class='verse-line'>{}</span></p>", "ja311:3.1": "<p><span class='verse-line'>{}</span>", "ja311:3.2": "<span class='verse-line'>{}</span>", "ja311:3.3": "<span class='verse-line'>{}</span>", "ja311:3.4": "<span class='verse-line'>{}</span>", "ja311:3.5": "<span class='verse-line'>{}</span>", "ja311:3.6": "<span class='verse-line'>{}</span></p>", "ja311:4.1": "<p><span class='verse-line'>{}</span>", "ja311:4.2": "<span class='verse-line'>{}</span>", "ja311:4.3": "<span class='verse-line'>{}</span>", "ja311:4.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja311:5.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja311:0.1": "Jātaka ", "ja311:0.2": "Catukkanipāta ", "ja311:0.3": "Pucimandavagga ", "ja311:0.4": "1. Pucimandajātaka ", "ja311:1.1": "“Uṭṭhehi cora kiṁ sesi, ", "ja311:1.2": "ko attho supanena te; ", "ja311:1.3": "Mā taṁ gahesuṁ rājāno, ", "ja311:1.4": "gāme kibbisakārakaṁ”. ", "ja311:2.1": "“Yannu coraṁ gahessanti, ", "ja311:2.2": "gāme kibbisakārakaṁ; ", "ja311:2.3": "Kiṁ tattha pucimandassa, ", "ja311:2.4": "vane jātassa tiṭṭhato”. ", "ja311:3.1": "“Na tvaṁ assattha jānāsi, ", "ja311:3.2": "mama corassa cantaraṁ; ", "ja311:3.3": "Coraṁ gahetvā rājāno, ", "ja311:3.4": "gāme kibbisakārakaṁ; ", "ja311:3.5": "Appenti nimbasūlasmiṁ, ", "ja311:3.6": "tasmiṁ me saṅkate mano”. ", "ja311:4.1": "“Saṅkeyya saṅkitabbāni, ", "ja311:4.2": "rakkheyyānāgataṁ bhayaṁ; ", "ja311:4.3": "Anāgatabhayā dhīro, ", "ja311:4.4": "ubho loke avekkhatī”ti. ", "ja311:5.1": "Pucimandajātakaṁ paṭhamaṁ. "}, "variant_text": {"ja311:0.1": "", "ja311:0.2": "", "ja311:0.3": "", "ja311:0.4": "", "ja311:1.1": "", "ja311:1.2": "supanena → supinena (bj, pts-vp-pli1, mr) ", "ja311:1.3": "gahesuṁ → gahesu (sya1ed, sya2ed); gaṇheyyuṁ (mr) ", "ja311:1.4": "", "ja311:2.1": "Yannu → nanu (sya1ed, sya2ed) ", "ja311:2.2": "", "ja311:2.3": "", "ja311:2.4": "", "ja311:3.1": "", "ja311:3.2": "", "ja311:3.3": "", "ja311:3.4": "", "ja311:3.5": "Appenti → accenti (sya1ed, sya2ed) ", "ja311:3.6": "", "ja311:4.1": "", "ja311:4.2": "", "ja311:4.3": "", "ja311:4.4": "", "ja311:5.1": ""}, "reference_text": {"ja311:0.1": "", "ja311:0.2": "", "ja311:0.3": "", "ja311:0.4": "", "ja311:1.1": "bj30.172, dr27.136, ms22J_935, msdiv41, pts-vp-pli3.34, sya27.136", "ja311:1.2": "", "ja311:1.3": "", "ja311:1.4": "", "ja311:2.1": "csp1ed22.99, csp2ed22.99, ms22J_936, msdiv42", "ja311:2.2": "", "ja311:2.3": "", "ja311:2.4": "", "ja311:3.1": "ms22J_937, msdiv43", "ja311:3.2": "", "ja311:3.3": "", "ja311:3.4": "", "ja311:3.5": "", "ja311:3.6": "", "ja311:4.1": "ms22J_938, msdiv44", "ja311:4.2": "", "ja311:4.3": "", "ja311:4.4": "", "ja311:5.1": "ms22J_939"}, "keys_order": ["ja311:0.1", "ja311:0.2", "ja311:0.3", "ja311:0.4", "ja311:1.1", "ja311:1.2", "ja311:1.3", "ja311:1.4", "ja311:2.1", "ja311:2.2", "ja311:2.3", "ja311:2.4", "ja311:3.1", "ja311:3.2", "ja311:3.3", "ja311:3.4", "ja311:3.5", "ja311:3.6", "ja311:4.1", "ja311:4.2", "ja311:4.3", "ja311:4.4", "ja311:5.1"]}