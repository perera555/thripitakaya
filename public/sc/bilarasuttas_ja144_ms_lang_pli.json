{"html_text": {"ja144:0.1": "<article id='ja144'><header><ul><li class='division'>{}</li>", "ja144:0.2": "<li>{}</li>", "ja144:0.3": "<li>{}</li></ul>", "ja144:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja144:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja144:1.2": "<span class='verse-line'>{}</span>", "ja144:1.3": "<span class='verse-line'>{}</span>", "ja144:1.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja144:2.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja144:0.1": "Jātaka ", "ja144:0.2": "Ekakanipāta ", "ja144:0.3": "Kakaṇṭakavagga ", "ja144:0.4": "4. Naṅguṭṭhajātaka ", "ja144:1.1": "“Bahumpetaṁ asabbhi jātaveda, ", "ja144:1.2": "Yaṁ taṁ vāladhinābhipūjayāma; ", "ja144:1.3": "Maṁsārahassa natthajja maṁsaṁ, ", "ja144:1.4": "Naṅguṭṭhampi bhavaṁ paṭiggahātū”ti. ", "ja144:2.1": "Naṅguṭṭhajātakaṁ catutthaṁ. "}, "variant_text": {"ja144:0.1": "", "ja144:0.2": "", "ja144:0.3": "", "ja144:0.4": "", "ja144:1.1": "Bahumpetaṁ asabbhi → bahupetamasabbhi (mr) ", "ja144:1.2": "", "ja144:1.3": "", "ja144:1.4": "", "ja144:2.1": ""}, "reference_text": {"ja144:0.1": "", "ja144:0.2": "", "ja144:0.3": "", "ja144:0.4": "", "ja144:1.1": "ms22J_319, msdiv144, pts-vp-pli1.494, pts-vp-pli1.495, sya27.47, vri68.32", "ja144:1.2": "", "ja144:1.3": "", "ja144:1.4": "", "ja144:2.1": "ms22J_320"}, "keys_order": ["ja144:0.1", "ja144:0.2", "ja144:0.3", "ja144:0.4", "ja144:1.1", "ja144:1.2", "ja144:1.3", "ja144:1.4", "ja144:2.1"]}