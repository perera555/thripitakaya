{"html_text": {"ja386:0.1": "<article id='ja386'><header><ul><li class='division'>{}</li>", "ja386:0.2": "<li>{}</li>", "ja386:0.3": "<li>{}</li></ul>", "ja386:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja386:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja386:1.2": "<span class='verse-line'>{}</span>", "ja386:1.3": "<span class='verse-line'>{}</span>", "ja386:1.4": "<span class='verse-line'>{}</span></p>", "ja386:2.1": "<p><span class='verse-line'>{}</span>", "ja386:2.2": "<span class='verse-line'>{}</span>", "ja386:2.3": "<span class='verse-line'>{}</span>", "ja386:2.4": "<span class='verse-line'>{}</span></p>", "ja386:3.1": "<p><span class='verse-line'>{}</span>", "ja386:3.2": "<span class='verse-line'>{}</span>", "ja386:3.3": "<span class='verse-line'>{}</span>", "ja386:3.4": "<span class='verse-line'>{}</span></p>", "ja386:4.1": "<p><span class='verse-line'>{}</span>", "ja386:4.2": "<span class='verse-line'>{}</span>", "ja386:4.3": "<span class='verse-line'>{}</span>", "ja386:4.4": "<span class='verse-line'>{}</span></p>", "ja386:5.1": "<p><span class='verse-line'>{}</span>", "ja386:5.2": "<span class='verse-line'>{}</span>", "ja386:5.3": "<span class='verse-line'>{}</span>", "ja386:5.4": "<span class='verse-line'>{}</span></p>", "ja386:6.1": "<p><span class='verse-line'>{}</span>", "ja386:6.2": "<span class='verse-line'>{}</span>", "ja386:6.3": "<span class='verse-line'>{}</span>", "ja386:6.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja386:7.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja386:0.1": "Jātaka ", "ja386:0.2": "Chakkanipāta ", "ja386:0.3": "Kharaputtavagga ", "ja386:0.4": "1. Kharaputtajātaka ", "ja386:1.1": "“Saccaṁ kirevamāhaṁsu, ", "ja386:1.2": "vastaṁ bāloti paṇḍitā; ", "ja386:1.3": "Passa bālo rahokammaṁ, ", "ja386:1.4": "āvikubbaṁ na bujjhati”. ", "ja386:2.1": "“Tvaṁ khopi samma bālosi, ", "ja386:2.2": "kharaputta vijānahi; ", "ja386:2.3": "Rajjuyā hi parikkhitto, ", "ja386:2.4": "vaṅkoṭṭho ohitomukho. ", "ja386:3.1": "Aparampi samma te bālyaṁ, ", "ja386:3.2": "yo mutto na palāyasi; ", "ja386:3.3": "So ca bālataro samma, ", "ja386:3.4": "yaṁ tvaṁ vahasi senakaṁ”. ", "ja386:4.1": "“Yannu samma ahaṁ bālo, ", "ja386:4.2": "ajarāja vijānahi; ", "ja386:4.3": "Atha kena senako bālo, ", "ja386:4.4": "taṁ me akkhāhi pucchito”. ", "ja386:5.1": "“Uttamatthaṁ labhitvāna, ", "ja386:5.2": "bhariyāya yo padassati; ", "ja386:5.3": "Tena jahissatattānaṁ, ", "ja386:5.4": "sā cevassa na hessati”. ", "ja386:6.1": "“Na ve piyammeti janinda tādiso, ", "ja386:6.2": "Attaṁ niraṅkatvā piyāni sevati; ", "ja386:6.3": "Attāva seyyo paramā ca seyyo, ", "ja386:6.4": "Labbhā piyā ocitatthena pacchā”ti. ", "ja386:7.1": "Kharaputtajātakaṁ paṭhamaṁ. "}, "variant_text": {"ja386:0.1": "", "ja386:0.2": "", "ja386:0.3": "", "ja386:0.4": "", "ja386:1.1": "", "ja386:1.2": "vastaṁ → bhastaṁ (bj, pts-vp-pli1); kalakaṁ (sya1ed, sya2ed); garaṁ (mr) ", "ja386:1.3": "", "ja386:1.4": "", "ja386:2.1": "Tvaṁ khopi → tvaṁ nu kho (bj, sya1ed, sya2ed); tvaṁ ca kho (pts-vp-pli1) ", "ja386:2.2": "", "ja386:2.3": "Rajjuyā hi → rajjuyāhi (sya1ed, sya2ed); rajjuyāsi (pts-vp-pli1) ", "ja386:2.4": "", "ja386:3.1": "Aparampi samma te bālyaṁ → ayampi samma te bālo (mr) ", "ja386:3.2": "", "ja386:3.3": "", "ja386:3.4": "", "ja386:4.1": "", "ja386:4.2": "", "ja386:4.3": "", "ja386:4.4": "", "ja386:5.1": "", "ja386:5.2": "bhariyāya yo padassati → bhariyā yo padassati (pts-vp-pli1); bhariyā na bhavissati (mr) ", "ja386:5.3": "", "ja386:5.4": "", "ja386:6.1": "Na ve piyammeti → na piyammeti (sya1ed, sya2ed); na piyameti (mr); na piyamedanti (katthaci) ", "ja386:6.2": "sevati → sevaye (?) ", "ja386:6.3": "", "ja386:6.4": "", "ja386:7.1": "Kharaputtajātakaṁ → khuraputtajātakaṁ (sya1ed, sya2ed) "}, "reference_text": {"ja386:0.1": "", "ja386:0.2": "", "ja386:0.3": "", "ja386:0.4": "", "ja386:1.1": "bj30.250, dr27.199, ms22J_1406, msdiv77, pts-vp-pli3.278, vri68.123", "ja386:1.2": "", "ja386:1.3": "", "ja386:1.4": "", "ja386:2.1": "ms22J_1407, msdiv78", "ja386:2.2": "", "ja386:2.3": "", "ja386:2.4": "", "ja386:3.1": "ms22J_1408, msdiv79", "ja386:3.2": "", "ja386:3.3": "", "ja386:3.4": "", "ja386:4.1": "ms22J_1409, msdiv80, pts-vp-pli3.279, sya27.200", "ja386:4.2": "", "ja386:4.3": "", "ja386:4.4": "", "ja386:5.1": "ms22J_1410, msdiv81", "ja386:5.2": "", "ja386:5.3": "", "ja386:5.4": "", "ja386:6.1": "csp1ed22.147, csp2ed22.147, ms22J_1411, msdiv82, ndp22.138, pts-vp-pli3.280", "ja386:6.2": "", "ja386:6.3": "", "ja386:6.4": "", "ja386:7.1": "ms22J_1412"}, "keys_order": ["ja386:0.1", "ja386:0.2", "ja386:0.3", "ja386:0.4", "ja386:1.1", "ja386:1.2", "ja386:1.3", "ja386:1.4", "ja386:2.1", "ja386:2.2", "ja386:2.3", "ja386:2.4", "ja386:3.1", "ja386:3.2", "ja386:3.3", "ja386:3.4", "ja386:4.1", "ja386:4.2", "ja386:4.3", "ja386:4.4", "ja386:5.1", "ja386:5.2", "ja386:5.3", "ja386:5.4", "ja386:6.1", "ja386:6.2", "ja386:6.3", "ja386:6.4", "ja386:7.1"]}