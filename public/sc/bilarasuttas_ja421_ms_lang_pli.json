{"html_text": {"ja421:0.1": "<article id='ja421'><header><ul><li class='division'>{}</li>", "ja421:0.2": "<li>{}</li>", "ja421:0.3": "<li>{}</li></ul>", "ja421:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja421:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja421:1.2": "<span class='verse-line'>{}</span>", "ja421:1.3": "<span class='verse-line'>{}</span>", "ja421:1.4": "<span class='verse-line'>{}</span></p>", "ja421:2.1": "<p><span class='verse-line'>{}</span>", "ja421:2.2": "<span class='verse-line'>{}</span>", "ja421:2.3": "<span class='verse-line'>{}</span>", "ja421:2.4": "<span class='verse-line'>{}</span></p>", "ja421:3.1": "<p><span class='verse-line'>{}</span>", "ja421:3.2": "<span class='verse-line'>{}</span>", "ja421:3.3": "<span class='verse-line'>{}</span>", "ja421:3.4": "<span class='verse-line'>{}</span></p>", "ja421:4.1": "<p><span class='verse-line'>{}</span>", "ja421:4.2": "<span class='verse-line'>{}</span>", "ja421:4.3": "<span class='verse-line'>{}</span>", "ja421:4.4": "<span class='verse-line'>{}</span></p>", "ja421:5.1": "<p><span class='verse-line'>{}</span>", "ja421:5.2": "<span class='verse-line'>{}</span>", "ja421:5.3": "<span class='verse-line'>{}</span>", "ja421:5.4": "<span class='verse-line'>{}</span></p>", "ja421:6.1": "<p><span class='verse-line'>{}</span>", "ja421:6.2": "<span class='verse-line'>{}</span>", "ja421:6.3": "<span class='verse-line'>{}</span>", "ja421:6.4": "<span class='verse-line'>{}</span></p>", "ja421:7.1": "<p><span class='verse-line'>{}</span>", "ja421:7.2": "<span class='verse-line'>{}</span>", "ja421:7.3": "<span class='verse-line'>{}</span>", "ja421:7.4": "<span class='verse-line'>{}</span></p>", "ja421:8.1": "<p><span class='verse-line'>{}</span>", "ja421:8.2": "<span class='verse-line'>{}</span>", "ja421:8.3": "<span class='verse-line'>{}</span>", "ja421:8.4": "<span class='verse-line'>{}</span></p>", "ja421:9.1": "<p><span class='verse-line'>{}</span>", "ja421:9.2": "<span class='verse-line'>{}</span>", "ja421:9.3": "<span class='verse-line'>{}</span>", "ja421:9.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja421:10.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja421:0.1": "Jātaka ", "ja421:0.2": "Aṭṭhakanipāta ", "ja421:0.3": "Kaccānivagga ", "ja421:0.4": "5. Gaṅgamālajātaka ", "ja421:1.1": "“Aṅgārajātā pathavī, ", "ja421:1.2": "kukkuḷānugatā mahī; ", "ja421:1.3": "Atha gāyasi vattāni, ", "ja421:1.4": "na taṁ tapati ātapo. ", "ja421:2.1": "Uddhaṁ tapati ādicco, ", "ja421:2.2": "adho tapati vālukā; ", "ja421:2.3": "Atha gāyasi vattāni, ", "ja421:2.4": "na taṁ tapati ātapo”. ", "ja421:3.1": "“Na maṁ tapati ātapo, ", "ja421:3.2": "ātapā tapayanti maṁ; ", "ja421:3.3": "Atthā hi vividhā rāja, ", "ja421:3.4": "te tapanti na ātapo”. ", "ja421:4.1": "“Addasaṁ kāma te mūlaṁ, ", "ja421:4.2": "saṅkappā kāma jāyasi; ", "ja421:4.3": "Na taṁ saṅkappayissāmi, ", "ja421:4.4": "evaṁ kāma na hehisi”. ", "ja421:5.1": "“Appāpi kāmā na alaṁ, ", "ja421:5.2": "bahūhipi na tappati; ", "ja421:5.3": "Ahahā bālalapanā, ", "ja421:5.4": "parivajjetha jaggato”. ", "ja421:6.1": "“Appassa kammassa phalaṁ mamedaṁ, ", "ja421:6.2": "Udayo ajjhāgamā mahattapattaṁ; ", "ja421:6.3": "Suladdhalābho vata māṇavassa, ", "ja421:6.4": "Yo pabbajī kāmarāgaṁ pahāya”. ", "ja421:7.1": "“Tapasā pajahanti pāpakammaṁ, ", "ja421:7.2": "Tapasā nhāpitakumbhakārabhāvaṁ; ", "ja421:7.3": "Tapasā abhibhuyya gaṅgamāla, ", "ja421:7.4": "Nāmenālapasajja brahmadattaṁ”. ", "ja421:8.1": "“Sandiṭṭhikameva ‘amma’ passatha, ", "ja421:8.2": "Khantīsoraccassa ayaṁ vipāko; ", "ja421:8.3": "Yo sabbajanassa vanditohu, ", "ja421:8.4": "Taṁ vandāma sarājikā samaccā”. ", "ja421:9.1": "“Mā kiñci avacuttha gaṅgamālaṁ, ", "ja421:9.2": "Muninaṁ monapathesu sikkhamānaṁ; ", "ja421:9.3": "Eso hi atari aṇṇavaṁ, ", "ja421:9.4": "Yaṁ taritvā caranti vītasokā”ti. ", "ja421:10.1": "Gaṅgamālajātakaṁ pañcamaṁ. "}, "variant_text": {"ja421:0.1": "", "ja421:0.2": "", "ja421:0.3": "", "ja421:0.4": "", "ja421:1.1": "", "ja421:1.2": "", "ja421:1.3": "vattāni → vatthāni (mr) ", "ja421:1.4": "", "ja421:2.1": "", "ja421:2.2": "", "ja421:2.3": "vattāni → vatthāni (mr) ", "ja421:2.4": "", "ja421:3.1": "", "ja421:3.2": "ātapā → ātappā (bj, sya1ed, sya2ed, pts-vp-pli1) ", "ja421:3.3": "", "ja421:3.4": "", "ja421:4.1": "", "ja421:4.2": "", "ja421:4.3": "", "ja421:4.4": "", "ja421:5.1": "", "ja421:5.2": "", "ja421:5.3": "", "ja421:5.4": "parivajjetha → paṭivijjhetha (bj, pts-vp-pli1) ", "ja421:6.1": "", "ja421:6.2": "", "ja421:6.3": "", "ja421:6.4": "Yo → so (sya1ed, sya2ed, mr) ", "ja421:7.1": "", "ja421:7.2": "", "ja421:7.3": "", "ja421:7.4": "", "ja421:8.1": "", "ja421:8.2": "ayaṁ → yo (sya1ed, sya2ed, pts-vp-pli1, mr) ", "ja421:8.3": "", "ja421:8.4": "", "ja421:9.1": "", "ja421:9.2": "", "ja421:9.3": "", "ja421:9.4": "", "ja421:10.1": ""}, "reference_text": {"ja421:0.1": "", "ja421:0.2": "", "ja421:0.3": "", "ja421:0.4": "", "ja421:1.1": "ms22J_1712, msdiv36, pts-vp-pli3.447", "ja421:1.2": "", "ja421:1.3": "", "ja421:1.4": "", "ja421:2.1": "ms22J_1713, msdiv37", "ja421:2.2": "", "ja421:2.3": "", "ja421:2.4": "", "ja421:3.1": "csp1ed22.180, csp2ed22.180, ms22J_1714, msdiv38", "ja421:3.2": "", "ja421:3.3": "", "ja421:3.4": "", "ja421:4.1": "ms22J_1715, msdiv39, pts-vp-pli3.450", "ja421:4.2": "", "ja421:4.3": "", "ja421:4.4": "", "ja421:5.1": "ms22J_1716, msdiv40", "ja421:5.2": "", "ja421:5.3": "", "ja421:5.4": "", "ja421:6.1": "ms22J_1717, msdiv41, sya27.245", "ja421:6.2": "", "ja421:6.3": "", "ja421:6.4": "", "ja421:7.1": "dr27.244, ms22J_1718, msdiv42, pts-vp-pli3.452", "ja421:7.2": "", "ja421:7.3": "", "ja421:7.4": "", "ja421:8.1": "bj30.312, ms22J_1719, msdiv43, ndp22.173, pts-vp-pli3.453", "ja421:8.2": "", "ja421:8.3": "", "ja421:8.4": "", "ja421:9.1": "ms22J_1720, msdiv44", "ja421:9.2": "", "ja421:9.3": "", "ja421:9.4": "", "ja421:10.1": "ms22J_1721"}, "keys_order": ["ja421:0.1", "ja421:0.2", "ja421:0.3", "ja421:0.4", "ja421:1.1", "ja421:1.2", "ja421:1.3", "ja421: