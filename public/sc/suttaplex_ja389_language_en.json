[{"acronym": "Ja 389", "alt_acronym": null, "volpages": "PTS 3.295, PTS 3.296, PTS 3.297, PTS 3.298", "alt_volpages": null, "uid": "ja389", "blurb": "“Gold-clawed creature”—The Master told this tale when dwelling in the Bamboo-grove, of Ananda’s dying for his sake. The occasion is told in the Khandahala Birth about the hiring of bowmen, and in the Cullahamsa Birth about the roar of the elephant Dhanapala. Then they began a discussion in the Hall of Truth: “Sirs, has the Elder Ananda, Treasurer of the Law, who attained all the wisdom possible to one still under discipline, given up his life for the Perfect Buddha when Dhanapala came?” The Master came and was told the subject of their discussion: he said, “Brother, in former times also Ananda gave up his life for me:” and so he told an old tale.", "difficulty": null, "original_title": "Suvaṇṇakakkaṭajātaka", "root_lang": "pli", "root_lang_name": "Pāli", "type": "leaf", "translated_title": "Suvannakakkata Jātaka", "translations": [{"lang": "pli", "lang_name": "Pāli", "is_root": true, "author": "Mahāsaṅgīti Tipiṭaka Buddhavasse 2500", "author_short": "ms", "author_uid": "ms", "publication_date": null, "id": "ja389_root-pli-ms", "segmented": true, "title": null, "volpage": null, "has_comment": false}, {"lang": "de", "lang_name": "Deutsch", "is_root": false, "author": "Dr. Julius Dutoit", "author_short": "Dutoit", "author_uid": "dutoit", "publication_date": "2007", "id": "de_ja389_dutoit", "segmented": false, "volpage": null, "has_comment": false}, {"author": "H.T. Francis, R.A. Neil", "author_short": "Francis …", "author_uid": "francis-neil", "has_comment": false, "id": "en_ja389_francis-neil", "is_root": false, "lang": "en", "lang_name": "English", "publication_date": "1897", "segmented": false, "volpage": null, "title": "Suvannakakkata Jātaka"}, {"lang": "jpn", "lang_name": "日本語", "is_root": false, "author": "関西パーリ語実習会", "author_short": "関西パーリ語実習会", "author_uid": "kansai", "publication_date": "2023", "id": "jpn_ja389_k