{"html_text": {"ja351:0.1": "<article id='ja351'><header><ul><li class='division'>{}</li>", "ja351:0.2": "<li>{}</li>", "ja351:0.3": "<li>{}</li></ul>", "ja351:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja351:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja351:1.2": "<span class='verse-line'>{}</span>", "ja351:1.3": "<span class='verse-line'>{}</span>", "ja351:1.4": "<span class='verse-line'>{}</span></p>", "ja351:2.1": "<p><span class='verse-line'>{}</span>", "ja351:2.2": "<span class='verse-line'>{}</span>", "ja351:2.3": "<span class='verse-line'>{}</span>", "ja351:2.4": "<span class='verse-line'>{}</span></p>", "ja351:3.1": "<p><span class='verse-line'>{}</span>", "ja351:3.2": "<span class='verse-line'>{}</span>", "ja351:3.3": "<span class='verse-line'>{}</span>", "ja351:3.4": "<span class='verse-line'>{}</span></p>", "ja351:4.1": "<p><span class='verse-line'>{}</span>", "ja351:4.2": "<span class='verse-line'>{}</span>", "ja351:4.3": "<span class='verse-line'>{}</span>", "ja351:4.4": "<span class='verse-line'>{}</span></p>", "ja351:5.1": "<p><span class='verse-line'>{}</span>", "ja351:5.2": "<span class='verse-line'>{}</span>", "ja351:5.3": "<span class='verse-line'>{}</span>", "ja351:5.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja351:6.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja351:0.1": "Jātaka ", "ja351:0.2": "Pañcakanipāta ", "ja351:0.3": "Maṇikuṇḍalavagga ", "ja351:0.4": "1. Maṇikuṇḍalajātaka ", "ja351:1.1": "“Jīno rathassaṁ maṇikuṇḍale ca, ", "ja351:1.2": "Putte ca dāre ca tatheva jīno; ", "ja351:1.3": "Sabbesu bhogesu asesakesu, ", "ja351:1.4": "Kasmā na santappasi sokakāle”. ", "ja351:2.1": "“Pubbeva maccaṁ vijahanti bhogā, ", "ja351:2.2": "Macco vā te pubbataraṁ jahāti; ", "ja351:2.3": "Asassatā bhogino kāmakāmi, ", "ja351:2.4": "Tasmā na socāmahaṁ sokakāle. ", "ja351:3.1": "Udeti āpūrati veti cando, ", "ja351:3.2": "Atthaṁ tapetvāna paleti sūriyo; ", "ja351:3.3": "Viditā mayā sattuka lokadhammā, ", "ja351:3.4": "Tasmā na socāmahaṁ sokakāle”. ", "ja351:4.1": "“Alaso gihī kāmabhogī na sādhu, ", "ja351:4.2": "Asaññato pabbajito na sādhu; ", "ja351:4.3": "Rājā na sādhu anisammakārī, ", "ja351:4.4": "Yo paṇḍito kodhano taṁ na sādhu. ", "ja351:5.1": "Nisamma khattiyo kayirā, ", "ja351:5.2": "nānisamma disampati; ", "ja351:5.3": "Nisammakārino rāja, ", "ja351:5.4": "yaso kitti ca vaḍḍhatī”ti. ", "ja351:6.1": "Maṇikuṇḍalajātakaṁ paṭhamaṁ. "}, "variant_text": {"ja351:0.1": "", "ja351:0.2": "", "ja351:0.3": "", "ja351:0.4": "", "ja351:1.1": "", "ja351:1.2": "", "ja351:1.3": "asesakesu → asesitesu (bj, pts-vp-pli1); asesikesu (mr) ", "ja351:1.4": "", "ja351:2.1": "", "ja351:2.2": "Macco vā te → ca ne (pts-vp-pli1); dhane (mr) ", "ja351:2.3": "", "ja351:2.4": "", "ja351:3.1": "āpūrati veti → pūreti khīyati (sya1ed, sya2ed) ", "ja351:3.2": "Atthaṁ tapetvāna → atthaṅgametvāna (sya1ed, sya2ed); andhaṁ tapetvāna (mr) ", "ja351:3.3": "Viditā → vijitā (sya1ed, sya2ed) ", "ja351:3.4": "", "ja351:4.1": "", "ja351:4.2": "", "ja351:4.3": "", "ja351:4.4": "", "ja351:5.1": "", "ja351:5.2": "", "ja351:5.3": "rāja → rañño (bj, sya1ed, sya2ed) ", "ja351:5.4": "", "ja351:6.1": ""}, "reference_text": {"ja351:0.1": "", "ja351:0.2": "", "ja351:0.3": "", "ja351:0.4": "", "ja351:1.1": "bj30.206, csp1ed22.120, csp2ed22.120, dr27.164, ms22J_1146, msdiv1, ndp22.111, pts-vp-pli3.153, sya27.164, vri68.102", "ja351:1.2": "", "ja351:1.3": "", "ja351:1.4": "", "ja351:2.1": "ms22J_1147, msdiv2, pts-vp-pli3.154", "ja351:2.2": "", "ja351:2.3": "", "ja351:2.4": "", "ja351:3.1": "ms22J_1148, msdiv3", "ja351:3.2": "", "ja351:3.3": "", "ja351:3.4": "", "ja351:4.1": "ms22J_1149, msdiv4, sya27.165", "ja351:4.2": "", "ja351:4.3": "", "ja351:4.4": "", "ja351:5.1": "dr27.165, ms22J_1150, msdiv5", "ja351:5.2": "", "ja351:5.3": "", "ja351:5.4": "", "ja351:6.1": "ms22J_1151"}, "keys_order": ["ja351:0.1", "ja351:0.2", "ja351:0.3", "ja351:0.4", "ja351:1.1", "ja351:1.2", "ja351:1.3", "ja351:1.4", "ja3