hort": "Krüger", "author_uid": "kruger", "publication_date": "1999", "id": "af_snp1.8_kruger", "segmented": false, "volpage": null, "has_comment": false}, {"lang": "cs", "lang_name": "Čeština", "is_root": false, "author": "Štěpán Chromovský", "author_short": "Chromovský", "author_uid": "chromovsky", "publication_date": null, "id": "cs_snp1.8_chromovsky", "segmented": false, "volpage": null, "has_comment": false}, {"lang": "de", "lang_name": "Deutsch", "is_root": false, "author": "Nyanaponika Thera", "author_short": "Nyanaponika", "author_uid": "nyanaponika", "publication_date": null, "id": "de_snp1.8_nyanaponika", "segmented": false, "volpage": null, "has_comment": false}, {"lang": "de", "lang_name": "Deutsch", "is_root": false, "author": "Karl Seidenstücker", "author_short": "Seidenstücker", "author_uid": "seidenstuecker", "publication_date": "1910", "id": "de_snp1.8_seidenstuecker", "segmented": false, "volpage": null, "has_comment": false}, {"lang": "en", "lang_name": "English", "is_root": false, "author": "Ācāriya Buddharakkhita", "author_short": "Buddharakkhita", "author_uid": "buddharakkhita", "publication_date": "1989", "id": "en_snp1.8_buddharakkhita", "segmented": false, "volpage": null, "has_comment": false}, {"lang": "en", "lang_name": "English", "is_root": false, "author": "Piyadassi Thera", "author_short": "Piyadassi", "author_uid": "piyadassi", "publication_date": "1999", "id": "en_snp1.8_piyadassi", "segmented": false, "volpage": null, "has_comment": false}, {"lang": "en", "lang_name": "English", "is_root": false, "author": "Ñanamoli Thera", "author_short": "Ñanamoli", "author_uid": "nanamoli", "publication_date": "1987", "id": "en_snp1.8_nanamoli", "segmented": false, "volpage": null, "has_comment": false}, {"lang": "en", "lang_name": "English", "is_root": false, "author": "Amaravati Sangha", "author_short": "Amaravati", "author_uid": "amaravati", "publication_date": "1994", "id": "en_snp1.8_amaravati", "segmented": false, "volpage": null, "has_comme