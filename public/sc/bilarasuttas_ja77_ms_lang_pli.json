{"html_text": {"ja77:0.1": "<article id='ja77'><header><ul><li class='division'>{}</li>", "ja77:0.2": "<li>{}</li>", "ja77:0.3": "<li>{}</li></ul>", "ja77:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja77:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja77:1.2": "<span class='verse-line'>{}</span>", "ja77:1.3": "<span class='verse-line'>{}</span>", "ja77:1.4": "<span class='verse-line'>{}</span></p>", "ja77:2.1": "<p><span class='verse-line'>{}</span>", "ja77:2.2": "<span class='verse-line'>{}</span>", "ja77:2.3": "<span class='verse-line'>{}</span></p></blockquote>", "ja77:2.4": "<p>{}</p>", "ja77:3.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja77:0.1": "Jātaka ", "ja77:0.2": "Ekakanipāta ", "ja77:0.3": "Varuṇavagga ", "ja77:0.4": "7. Mahāsupinajātaka ", "ja77:1.1": "“Usabhā rukkhā gāviyo gavā ca, ", "ja77:1.2": "Asso kaṁso siṅgālī ca kumbho; ", "ja77:1.3": "Pokkharaṇī ca apākacandanaṁ, ", "ja77:1.4": "Lābūni sīdanti silā plavan”ti. ", "ja77:2.1": "Maṇḍūkiyo kaṇhasappe gilanti, ", "ja77:2.2": "Kākaṁ supaṇṇā parivārayanti; ", "ja77:2.3": "Tasā vakā eḷakānaṁ bhayāhi, ", "ja77:2.4": "Vipariyāso vattati nayidha matthīti. ", "ja77:3.1": "Mahāsupinajātakaṁ sattamaṁ. "}, "variant_text": {"ja77:0.1": "", "ja77:0.2": "", "ja77:0.3": "", "ja77:0.4": "", "ja77:1.1": "", "ja77:1.2": "siṅgālī → sigālī (bj, sya1ed, sya2ed, pts-vp-pli1) ", "ja77:1.3": "", "ja77:1.4": "", "ja77:2.1": "", "ja77:2.2": "", "ja77:2.3": "", "ja77:2.4": "Vipariyāso → vipariyāyo (sya1ed, sya2ed, mr) ", "ja77:3.1": ""}, "reference_text": {"ja77:0.1": "", "ja77:0.2": "", "ja77:0.3": "", "ja77:0.4": "", "ja77:1.1": "bj30.32, ms22J_169, msdiv77, ndp22.19, pts-vp-pli1.344, vri68.18", "ja77:1.2": "", "ja77:1.3": "", "ja77:1.4": "", "ja77:2.1": "ms22J_170, sya27.25", "ja77:2.2": "", "ja77:2.3": "", "ja77:2.4": "", "ja77:3.1": "ms22J_171"}, "keys_order": ["ja77:0.1", "ja77:0.2", "ja77:0.3", "ja77:0.4", "ja77:1.1", "ja77:1.2", "ja77:1.3", "ja77:1.4", "ja77:2.1", "j