{"html_text": {"ja460:0.1": "<article id='ja460'><header><ul><li class='division'>{}</li>", "ja460:0.2": "<li>{}</li>", "ja460:0.3": "<li>{}</li></ul>", "ja460:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja460:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja460:1.2": "<span class='verse-line'>{}</span>", "ja460:1.3": "<span class='verse-line'>{}</span>", "ja460:1.4": "<span class='verse-line'>{}</span></p>", "ja460:2.1": "<p><span class='verse-line'>{}</span>", "ja460:2.2": "<span class='verse-line'>{}</span>", "ja460:2.3": "<span class='verse-line'>{}</span>", "ja460:2.4": "<span class='verse-line'>{}</span></p>", "ja460:3.1": "<p><span class='verse-line'>{}</span>", "ja460:3.2": "<span class='verse-line'>{}</span>", "ja460:3.3": "<span class='verse-line'>{}</span>", "ja460:3.4": "<span class='verse-line'>{}</span></p>", "ja460:4.1": "<p><span class='verse-line'>{}</span>", "ja460:4.2": "<span class='verse-line'>{}</span>", "ja460:4.3": "<span class='verse-line'>{}</span>", "ja460:4.4": "<span class='verse-line'>{}</span></p>", "ja460:5.1": "<p><span class='verse-line'>{}</span>", "ja460:5.2": "<span class='verse-line'>{}</span>", "ja460:5.3": "<span class='verse-line'>{}</span>", "ja460:5.4": "<span class='verse-line'>{}</span></p>", "ja460:6.1": "<p><span class='verse-line'>{}</span>", "ja460:6.2": "<span class='verse-line'>{}</span>", "ja460:6.3": "<span class='verse-line'>{}</span>", "ja460:6.4": "<span class='verse-line'>{}</span></p>", "ja460:7.1": "<p><span class='verse-line'>{}</span>", "ja460:7.2": "<span class='verse-line'>{}</span>", "ja460:7.3": "<span class='verse-line'>{}</span>", "ja460:7.4": "<span class='verse-line'>{}</span></p>", "ja460:8.1": "<p><span class='verse-line'>{}</span>", "ja460:8.2": "<span class='verse-line'>{}</span>", "ja460:8.3": "<span class='verse-line'>{}</span>", "ja460:8.4": "<span class='verse-line'>{}</span></p>", "ja460:9.1": "<p><span class='verse-line'>{}</span>", "ja460:9.2": "<span class='verse-line'>{}</span>", "ja460:9.3": "<span class='verse-line'>{}</span>", "ja460:9.4": "<span class='verse-line'>{}</span></p>", "ja460:10.1": "<p><span class='verse-line'>{}</span>", "ja460:10.2": "<span class='verse-line'>{}</span>", "ja460:10.3": "<span class='verse-line'>{}</span>", "ja460:10.4": "<span class='verse-line'>{}</span></p>", "ja460:11.1": "<p><span class='verse-line'>{}</span>", "ja460:11.2": "<span class='verse-line'>{}</span>", "ja460:11.3": "<span class='verse-line'>{}</span>", "ja460:11.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja460:12.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja460:0.1": "Jātaka ", "ja460:0.2": "Ekādasakanipāta ", "ja460:0.3": "Mātuposakavagga ", "ja460:0.4": "6. Yudhañcayajātaka ", "ja460:1.1": "“Mittāmaccaparibyūḷhaṁ, ", "ja460:1.2": "ahaṁ vande rathesabhaṁ; ", "ja460:1.3": "Pabbajissāmahaṁ rāja, ", "ja460:1.4": "taṁ devo anumaññatu”. ", "ja460:2.1": "“Sace te ūnaṁ kāmehi, ", "ja460:2.2": "ahaṁ paripūrayāmi te; ", "ja460:2.3": "Yo taṁ hiṁsati vāremi, ", "ja460:2.4": "mā pabbaja yudhañcaya”. ", "ja460:3.1": "“Na matthi ūnaṁ kāmehi, ", "ja460:3.2": "hiṁsitā me na vijjati; ", "ja460:3.3": "Dīpañca kātumicchāmi, ", "ja460:3.4": "yaṁ jarā nābhikīrati”. ", "ja460:4.1": "“Putto vā pitaraṁ yāce, ", "ja460:4.2": "pitā vā puttamorasaṁ; ", "ja460:4.3": "Negamo taṁ yāce tāta, ", "ja460:4.4": "mā pabbaja yudhañcaya”. ", "ja460:5.1": "“Mā maṁ deva nivārehi, ", "ja460:5.2": "pabbajantaṁ rathesabha; ", "ja460:5.3": "Māhaṁ kāmehi sammatto, ", "ja460:5.4": "jarāya vasamanvagū”. ", "ja460:6.1": "“Ahaṁ taṁ tāta yācāmi, ", "ja460:6.2": "ahaṁ putta nivāraye; ", "ja460:6.3": "Ciraṁ taṁ daṭṭhumicchāmi, ", "ja460:6.4": "mā pabbaja yudhañcaya”. ", "ja460:7.1": "“Ussāvova tiṇaggamhi, ", "ja460:7.2": "sūriyuggamanaṁ pati; ", "ja460:7.3": "Evamāyu manussānaṁ, ", "ja460:7.4": "mā maṁ amma nivāraya”. ", "ja460:8.1": "“Taramāno imaṁ yānaṁ, ", "ja460:8.2": "āropetu rathesabha; ", "ja460:8.3": "Mā me mātā tarantassa, ", "ja460:8.4": "antarāyakarā ahu”. ", "ja460:9.1": "“Abhidhāvatha bhaddante, ", "ja460:9.2": "suññaṁ hessati rammakaṁ; ", "ja460:9.3": "Yudhañcayo anuññāto, ", "ja460:9.4": "sabbadattena rājinā. ", "ja460:10.1": "Yohu seṭṭho sahassassa, ", "ja460:10.2": "yuvā kañcanasannibho; ", "ja460:10.3": "Soyaṁ kumāro pabbajito, ", "ja460:10.4": "kāsāyavasano balī”. ", "ja460:11.1": "“Ubho kumārā pabbajitā, ", "ja460:11.2": "yudhañcayo yudhiṭṭhilo; ", "ja460:11.3": "Pahāya mātāpitaro, ", "ja460:11.4": "saṅgaṁ chetvāna maccuno”ti. ", "ja460:12.1": "Yudhañcayajātakaṁ chaṭṭhaṁ. "}, "variant_text": {"ja460:0.1": "", "ja460:0.2": "", "ja460:0.3": "", "ja460:0.4": "", "ja460:1.1": "Mittāmaccaparibyūḷhaṁ → … paribbūḷhaṁ (bj, pts-vp-pli1); … paribyuḷhaṁ (sya1ed, sya2ed) ", "ja460:1.2": "", "ja460:1.3": "Pabbajissāmahaṁ rāja → pabbajissaṁ mahārāja (bj, pts-vp-pli1) ", "ja460:1.4": "", "ja460:2.1": "", "ja460:2.2": "ahaṁ paripūrayāmi → ahaṁva pūrayāmi (mr) ", "ja460:2.3": "", "ja460:2.4": "pabbaja → pabbaji (bj, pts-vp-pli1); pabbajja (sya1ed, sya2ed) | yudhañcaya → yudhañjaya (bj, sya1ed, sya2ed); yuvañjaya (pts-vp-pli1) ", "ja460:3.1": "", "ja460:3.2": "", "ja460:3.3": "", "ja460:3.4": "", "ja460:4.1": "", "ja460:4.2": "", "ja460:4.3": "Negamo taṁ yāce → negamo yācate (bj, sya1ed, sya2ed, pts-vp-pli1) ", "ja460:4.4": "", "ja460:5.1": "", "ja460:5.2": "", "ja460:5.3": "", "ja460:5.4": "", "ja460:6.1": "", "ja460:6.2": "", "ja460:6.3": "", "ja460:6.4": "", "ja460:7.1": "", "ja460:7.2": "", "ja460:7.3": "", "ja460:7.4": "", "ja460:8.1": "", "ja460:8.2": "āropetu → āropentu (pts-vp-pli1) ", "ja460:8.3": "", "ja460:8.4": "", "ja460:9.1": "", "ja460:9.2": "", "ja460:9.3": "", "ja460:9.4": "", "ja460:10.1": "sahassassa → manussānaṁ (sya1ed, sya2ed); sahassānaṁ (mr) ", "ja460:10.2": "", "ja460:10.3": "", "ja460:10.4": "", "ja460:11.1": "", "ja460:11.2": "", "ja460:11.3": "", "ja460:11.4": "", "ja460:12.1": "Yudhañcayajātakaṁ → yudhañjayajātakaṁ (bj, sya1ed, sya2ed); yuvañjayajātakaṁ (pts-vp-pli1) "}, "reference_text": {"ja460:0.1": "", "ja460:0.2": "", "ja460:0.3": "", "ja460:0.4": "", "ja460:1.1": "ms22J_2184, msdiv73, ndp22.228, pts-vp-pli4.120", "ja460:1.2": "", "ja460:1.3": "", "ja460:1.4": "", "ja460:2.1": "ms22J_2185, msdiv74, vri68.184", "ja460:2.2": "", "ja460:2.3": "", "ja460:2.4": "", "ja460:3.1": "ms22J_2186, msdiv75, pts-vp-pli4.121, sya27.316", "ja460:3.2": "", "ja460:3.3": "", "ja460:3.4": "", "ja460:4.1": "csp1ed22.236, csp2ed22.236, dr27.314, ms22J_2187, msdiv76", "ja460:4.2": "", "ja460:4.3": "", "ja460:4.4": "", "ja460:5.1": "ms22J_2188, msdiv77", "ja460:5.2": "", "ja460:5.3": "", "ja460:5.4": "", "ja460:6.1": "ms22J_2189, msdiv78", "ja460:6.2": "", "ja460:6.3": "", "ja460:6.4": "", "ja460:7.1": "ms22J_2190, msdiv79, pts-vp-pli4.122", "ja460:7.2": "", "ja460:7.3": "", "ja460:7.4": "", "ja460:8.1": "bj30.404, ms22J_2191, msdiv80", "ja460:8.2": "", "ja460:8.3": "", "ja460:8.4": "", "ja460:9.1": "ms22J_2192, msdiv81", "ja460:9.2": "", "ja460:9.3": "", "ja460:9.4": "", "ja460:10.1": "ms22J_2193, msdiv82, pts-vp-pli4.123", "ja460:10.2": "", "ja460:10.3": "", "ja460:10.4": "", "ja460:11.1": "ms22J_2194, msdiv83", "ja460:11.2": "", "ja460:11.3": "", "ja460:11.4": "", "ja460:12.1": "ms22J_2195"}, "keys_order": ["ja460:0.1", "ja460:0.2", "ja460:0.3", "ja460:0.4", "ja460:1.1", "ja460:1.2", "ja460:1.3", "ja460:1.4", "ja460:2.1", "ja460:2.2", "ja460:2.3", "ja460:2.4", "ja460:3.1", "ja460:3.2", "ja460:3.3", "ja460:3.4", "ja460:4.1", "ja460:4.2", "ja460:4.3", "ja460:4.4", "ja460:5.1", "ja460:5.2", "ja460:5.3", "ja460:5.4", "ja460:6.1", "ja460:6.2", "ja460:6.3", "ja460:6.4", "ja460:7.1", "ja460:7.2", "ja460:7.3", "ja460:7.4", "ja460:8.1", "ja460:8.2", "ja460:8.3", "ja460:8.4", "ja460:9.1", "ja460:9.2", "ja460:9.3", "ja460:9.4", "ja460:10.1", "ja460:10.2", "ja460:10.3", "ja460:10.4", "ja460:11.1", "ja460:11.2", "ja460:11.3", "ja460:11.4", "ja460:12.1"]}