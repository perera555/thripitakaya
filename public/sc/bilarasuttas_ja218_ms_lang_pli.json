{"html_text": {"ja218:0.1": "<article id='ja218'><header><ul><li class='division'>{}</li>", "ja218:0.2": "<li>{}</li>", "ja218:0.3": "<li>{}</li></ul>", "ja218:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja218:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja218:1.2": "<span class='verse-line'>{}</span>", "ja218:1.3": "<span class='verse-line'>{}</span>", "ja218:1.4": "<span class='verse-line'>{}</span></p>", "ja218:2.1": "<p><span class='verse-line'>{}</span>", "ja218:2.2": "<span class='verse-line'>{}</span>", "ja218:2.3": "<span class='verse-line'>{}</span>", "ja218:2.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja218:3.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja218:0.1": "Jātaka ", "ja218:0.2": "Dukanipāta ", "ja218:0.3": "Bīraṇathambhavagga ", "ja218:0.4": "8. Kūṭavāṇijajātaka ", "ja218:1.1": "“Saṭhassa sāṭheyyamidaṁ sucintitaṁ, ", "ja218:1.2": "Paccoḍḍitaṁ paṭikūṭassa kūṭaṁ; ", "ja218:1.3": "Phālañce khādeyyuṁ mūsikā, ", "ja218:1.4": "Kasmā kumāraṁ kulalā na hareyyuṁ. ", "ja218:2.1": "Kūṭassa hi santi kūṭakūṭā, ", "ja218:2.2": "Bhavati cāpi nikatino nikatyā; ", "ja218:2.3": "Dehi puttanaṭṭha phālanaṭṭhassa phālaṁ, ", "ja218:2.4": "Mā te puttamahāsi phālanaṭṭho”ti. ", "ja218:3.1": "Kūṭavāṇijajātakaṁ aṭṭhamaṁ. "}, "variant_text": {"ja218:0.1": "", "ja218:0.2": "", "ja218:0.3": "", "ja218:0.4": "", "ja218:1.1": "", "ja218:1.2": "", "ja218:1.3": "khādeyyuṁ → adeyyuṁ (bj, pts-vp-pli1) ", "ja218:1.4": "na → no (bj, sya1ed, sya2ed, pts-vp-pli1) ", "ja218:2.1": "santi → santīdha (mr) ", "ja218:2.2": "Bhavati → bhavanti (mr) ", "ja218:2.3": "", "ja218:2.4": "", "ja218:3.1": ""}, "reference_text": {"ja218:0.1": "", "ja218:0.2": "", "ja218:0.3": "", "ja218:0.4": "", "ja218:1.1": "csp1ed22.59, csp2ed22.59, ms22J_559, msdiv135, ndp22.55, pts-vp-pli2.183", "ja218:1.2": "", "ja218:1.3": "", "ja218:1.4": "", "ja218:2.1": "bj30.104, dr27.81, ms22J_560, msdiv136, sya27.82", "ja218:2.2": "", "ja218:2.3": "", "ja218:2.4": "", "ja218:3.1": "ms22J_561"}, "keys_order": ["ja218:0.1", "ja218:0.2", "ja218:0.3", "ja218:0.4", "ja218:1.1", "ja218:1.2", "ja218:1.3", "ja218:1.4", "ja218:2.1", "ja218:2.2", "ja218:2.3", "ja218:2.4", "ja218:3.1"]}