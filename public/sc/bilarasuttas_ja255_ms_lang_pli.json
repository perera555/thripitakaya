{"html_text": {"ja255:0.1": "<article id='ja255'><header><ul><li class='division'>{}</li>", "ja255:0.2": "<li>{}</li>", "ja255:0.3": "<li>{}</li></ul>", "ja255:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja255:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja255:1.2": "<span class='verse-line'>{}</span>", "ja255:1.3": "<span class='verse-line'>{}</span>", "ja255:1.4": "<span class='verse-line'>{}</span></p>", "ja255:2.1": "<p><span class='verse-line'>{}</span>", "ja255:2.2": "<span class='verse-line'>{}</span>", "ja255:2.3": "<span class='verse-line'>{}</span>", "ja255:2.4": "<span class='verse-line'>{}</span></p>", "ja255:3.1": "<p><span class='verse-line'>{}</span>", "ja255:3.2": "<span class='verse-line'>{}</span>", "ja255:3.3": "<span class='verse-line'>{}</span>", "ja255:3.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja255:4.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja255:0.1": "Jātaka ", "ja255:0.2": "Tikanipāta ", "ja255:0.3": "Saṅkappavagga ", "ja255:0.4": "5. Sukajātaka ", "ja255:1.1": "“Yāva so mattamaññāsi, ", "ja255:1.2": "bhojanasmiṁ vihaṅgamo; ", "ja255:1.3": "Tāva addhānamāpādi, ", "ja255:1.4": "mātarañca aposayi. ", "ja255:2.1": "Yato ca kho bahutaraṁ, ", "ja255:2.2": "bhojanaṁ ajjhavāhari; ", "ja255:2.3": "Tato tattheva saṁsīdi, ", "ja255:2.4": "amattaññū hi so ahu. ", "ja255:3.1": "Tasmā mattaññutā sādhu, ", "ja255:3.2": "bhojanasmiṁ agiddhatā; ", "ja255:3.3": "Amattaññū hi sīdanti, ", "ja255:3.4": "mattaññū ca na sīdare”ti. ", "ja255:4.1": "Sukajātakaṁ pañcamaṁ. "}, "variant_text": {"ja255:0.1": "", "ja255:0.2": "", "ja255:0.3": "", "ja255:0.4": "", "ja255:1.1": "", "ja255:1.2": "", "ja255:1.3": "", "ja255:1.4": "", "ja255:2.1": "", "ja255:2.2": "ajjhavāhari → ajjhupāhari (bj, pts-vp-pli1) ", "ja255:2.3": "", "ja255:2.4": "", "ja255:3.1": "", "ja255:3.2": "agiddhatā → agiddhitā (sya1ed, sya2ed, pts-vp-pli1, mr) ", "ja255:3.3": "", "ja255:3.4": "", "ja255:4.1": ""}, "reference_text": {"ja255:0.1": "", "ja255:0.2": "", "ja255:0.3": "", "ja255:0.4": "", "ja255:1.1": "ms22J_686, msdiv13, pts-vp-pli2.293", "ja255:1.2": "", "ja255:1.3": "", "ja255:1.4": "", "ja255:2.1": "ms22J_687, msdiv14", "ja255:2.2": "", "ja255:2.3": "", "ja255:2.4": "", "ja255:3.1": "ms22J_688, msdiv15", "ja255:3.2": "", "ja255:3.3": "", "ja255:3.4": "", "ja255:4.1": "ms22J_689"}, "keys_order": ["ja255:0.1", "ja255:0.2", "ja255:0.3", "ja255:0.4", "ja255:1.1", "ja255:1.2", "ja255:1.3", "ja255:1.4", "ja255:2.1", "ja255:2.2", "ja255:2.3", "ja255:2.4", "ja255:3.1", "ja255:3.2", "ja255:3.3", "ja255:3.4", "ja255:4.1"]}