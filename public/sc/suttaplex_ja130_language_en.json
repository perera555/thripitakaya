[{"acronym": "Ja 130", "alt_acronym": null, "volpages": "PTS 1.464", "alt_volpages": null, "uid": "ja130", "blurb": "“You may ail or eat.”—This story was told by the Master while at Jetavana, about a woman of Savatthi. She is said to have been the wicked wife of a good and virtuous brahmin, who was a lay-brother. Her nights she spent in gadding about; whilst by day she did not a stroke of work, but made out to be ill and lay abed groaning.", "difficulty": null, "original_title": "Kosiyajātaka", "root_lang": "pli", "root_lang_name": "Pāli", "type": "leaf", "translated_title": "Kosiya Jātaka", "translations": [{"lang": "pli", "lang_name": "Pāli", "is_root": true, "author": "Mahāsaṅgīti Tipiṭaka Buddhavasse 2500", "author_short": "ms", "author_uid": "ms", "publication_date": null, "id": "ja130_root-pli-ms", "segmented": true, "title": null, "volpage": null, "has_comment": false}, {"lang": "de", "lang_name": "Deutsch", "is_root": false, "author": "Dr. Julius Dutoit", "author_short": "Dutoit", "author_uid": "dutoit", "publication_date": "2007", "id": "de_ja130_dutoit", "segmented": false, "volpage": null, "has_comment": false}, {"author": "Robert Chalmers", "author_short": "Chalmers", "author_uid": "chalmers", "has_comment": false, "id": "en_ja130_chalmers", "is_root": false, "lang": "en", "lang_name": "English", "publication_date": "1895", "segmented": false, "volpage": null, "title": "Kosiya Jātaka"}, {"lang": "jpn", "lang_name": "日本語", "is_root": false, "author": "関西パーリ語実習会", "author_short": "関西パーリ語実習会", "author_uid": "kansai", "publication_date": "2023", "id": "jpn_ja130_kansai", "segmented": false, "volpage": null, "has_comment": false}, {"lang": "si", "lang_name": "සිංහල", "is_root": false, "author": "A.P. de Zoysa", "author_short": "Zoysa", "author_uid": "zoysa", "publication_date": null, "id": "si_ja130_zoysa", "segmented": false, "volpage": null, "has_comment": false}], "parallel_count": 0, "biblio": null, "priority_author_uid": "sujato", "verseNo": "", "previou