{"html_text": {"ja240:0.1": "<article id='ja240'><header><ul><li class='division'>{}</li>", "ja240:0.2": "<li>{}</li>", "ja240:0.3": "<li>{}</li></ul>", "ja240:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja240:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja240:1.2": "<span class='verse-line'>{}</span>", "ja240:1.3": "<span class='verse-line'>{}</span>", "ja240:1.4": "<span class='verse-line'>{}</span></p>", "ja240:2.1": "<p><span class='verse-line'>{}</span>", "ja240:2.2": "<span class='verse-line'>{}</span>", "ja240:2.3": "<span class='verse-line'>{}</span>", "ja240:2.4": "<span class='verse-line'>{}</span></p>", "ja240:3.1": "<p><span class='verse-line'>{}</span>", "ja240:3.2": "<span class='verse-line'>{}</span>", "ja240:3.3": "<span class='verse-line'>{}</span>", "ja240:3.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja240:4.1": "<p class='endsutta'>{}</p>", "ja240:4.2": "<p class='endvagga'>{}</p>", "ja240:5.1": "<p class='uddana-intro'>{}</p>", "ja240:6.1": "<blockquote class='uddanagatha'><p><span class='verse-line'>{}</span>", "ja240:6.2": "<span class='verse-line'>{}</span>", "ja240:6.3": "<span class='verse-line'>{}</span>", "ja240:6.4": "<span class='verse-line'>{}</span></p></blockquote></article>"}, "root_text": {"ja240:0.1": "Jātaka ", "ja240:0.2": "Dukanipāta ", "ja240:0.3": "Upāhanavagga ", "ja240:0.4": "10. Mahāpiṅgalajātaka ", "ja240:1.1": "“Sabbo jano hiṁsito piṅgalena, ", "ja240:1.2": "Tasmiṁ mate paccayā vedayanti; ", "ja240:1.3": "Piyo nu te āsi akaṇhanetto, ", "ja240:1.4": "Kasmā nu tvaṁ rodasi dvārapāla”. ", "ja240:2.1": "“Na me piyo āsi akaṇhanetto, ", "ja240:2.2": "Bhāyāmi paccāgamanāya tassa; ", "ja240:2.3": "Ito gato hiṁseyya maccurājaṁ, ", "ja240:2.4": "So hiṁsito āneyya puna idha”. ", "ja240:3.1": "“Daḍḍho vāhasahassehi, ", "ja240:3.2": "sitto ghaṭasatehi so; ", "ja240:3.3": "Parikkhatā ca sā bhūmi, ", "ja240:3.4": "mā bhāyi nāgamissatī”ti. ", "ja240:4.1": "Mahāpiṅgalajātakaṁ dasamaṁ. ", "ja240:4.2": "Upāhanavaggo navamo. ", "ja240:5.1": "Tassuddānaṁ ", "ja240:6.1": "Varupāhana khujja vikaṇṇakako, ", "ja240:6.2": "Asitābhuya pañcamavacchanakho; ", "ja240:6.3": "Dija pemavaruttamaekapadaṁ, ", "ja240:6.4": "Kumināmukha piṅgalakena dasāti. "}, "variant_text": {"ja240:0.1": "", "ja240:0.2": "", "ja240:0.3": "", "ja240:0.4": "", "ja240:1.1": "", "ja240:1.2": "paccayā → paccayaṁ (bj, sya1ed, sya2ed, pts-vp-pli1) ", "ja240:1.3": "", "ja240:1.4": "", "ja240:2.1": "", "ja240:2.2": "", "ja240:2.3": "", "ja240:2.4": "", "ja240:3.1": "", "ja240:3.2": "", "ja240:3.3": "", "ja240:3.4": "", "ja240:4.1": "", "ja240:4.2": "", "ja240:5.1": "", "ja240:6.1": "", "ja240:6.2": "", "ja240:6.3": "", "ja240:6.4": ""}, "reference_text": {"ja240:0.1": "", "ja240:0.2": "", "ja240:0.3": "", "ja240:0.4": "", "ja240:1.1": "ms22J_629, msdiv179, ndp22.62, pts-vp-pli2.241", "ja240:1.2": "", "ja240:1.3": "", "ja240:1.4": "", "ja240:2.1": "csp1ed22.67, csp2ed22.67, ms22J_630, msdiv180, pts-vp-pli2.242", "ja240:2.2": "", "ja240:2.3": "", "ja240:2.4": "", "ja240:3.1": "dr27.92, ms22J_631, msdiv181, sya27.93", "ja240:3.2": "", "ja240:3.3": "", "ja240:3.4": "", "ja240:4.1": "ms22J_632", "ja240:4.2": "", "ja240:5.1": "ms22J_633", "ja240:6.1": "ms22J_634", "ja240:6.2": "", "ja240:6.3": "", "ja240:6.4": ""}, "keys_order": ["ja240:0.1", "ja240:0.2", "ja240:0.3", "ja240:0.4", "ja240:1.1", "ja240:1.2", "ja240:1.3", "ja240:1.4", "ja240:2.1", "ja240:2.2", "ja240:2.3", "ja240:2.4", "ja240:3.1", "ja240:3.2", "ja240:3.3", "ja240:3.4", "ja240:4.1", "ja240:4.2", "ja240:5.1", "ja240:6.1", "ja240:6.2", "ja240:6.3", "ja240:6.4"]}