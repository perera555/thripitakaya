[{"acronym": "Ja 410", "alt_acronym": null, "volpages": "PTS 3.389, PTS 3.390, PTS 3.391", "alt_volpages": null, "uid": "ja410", "blurb": "“Deep in the wood”—The Master told this while dwelling at Jetavana, about a certain old Brother. The story was that this Brother ordained a novice, who waited on him but soon died of a fatal disease. The old man went about weeping and wailing for his death. Seeing him, the Brethren began to talk in the Hall of Truth, “Sirs, this old Brother goes about weeping and wailing for the novice’s death: he must surely have neglected the meditation on death.” The Master came, and hearing the subject of their talk, he said, “Brethren, this is not the first time this man is weeping for the other’s death,” and so he told the old tale.", "difficulty": null, "original_title": "Somadattajātaka", "root_lang": "pli", "root_lang_name": "Pāli", "type": "leaf", "translated_title": "Somadatta Jātaka", "translations": [{"lang": "pli", "lang_name": "Pāli", "is_root": true, "author": "Mahāsaṅgīti Tipiṭaka Buddhavasse 2500", "author_short": "ms", "author_uid": "ms", "publication_date": null, "id": "ja410_root-pli-ms", "segmented": true, "title": null, "volpage": null, "has_comment": false}, {"lang": "de", "lang_name": "Deutsch", "is_root": false, "author": "Dr. Julius Dutoit", "author_short": "Dutoit", "author_uid": "dutoit", "publication_date": "2007", "id": "de_ja410_dutoit", "segmented": false, "volpage": null, "has_comment": false}, {"author": "H.T. Francis, R.A. Neil", "author_short": "Francis …", "author_uid": "francis-neil", "has_comment": false, "id": "en_ja410_francis-neil", "is_root": false, "lang": "en", "lang_name": "English", "publication_date": "1897", "segmented": false, "volpage": null, "title": "Somadatta Jātaka"}, {"lang": "jpn", "lang_name": "日本語", "is_root": false, "author": "関西パーリ語実習会", "author_short": "関西パーリ語実習会", "author_uid": "kansai", "publication_date": "2023", "id": "jpn_ja410_kansai", "segmented": false, "volpage": null, "has_comment": false}, {"lang": "si", "lang_name": "සිංහල", "is_root": false, "author": "A.P. de Zoysa", "author_short": "Zoysa", "author_uid": "zoysa", "publication_date": null, "id": "si_ja410_zoysa", "segmented": false, "volpage": null, "has_comment": false}], "parallel_count": 9, "biblio": null, "priority_author_uid": "sujato", "verseNo": "", "previous": {"name": "King Daḷhadhamma ", "uid": "ja409"}, "next": {"name": "King Susīma ", "uid": "ja411"}}]