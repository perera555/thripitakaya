{"html_text": {"ja257:0.1": "<article id='ja257'><header><ul><li class='division'>{}</li>", "ja257:0.2": "<li>{}</li>", "ja257:0.3": "<li>{}</li></ul>", "ja257:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja257:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja257:1.2": "<span class='verse-line'>{}</span>", "ja257:1.3": "<span class='verse-line'>{}</span>", "ja257:1.4": "<span class='verse-line'>{}</span></p>", "ja257:2.1": "<p><span class='verse-line'>{}</span>", "ja257:2.2": "<span class='verse-line'>{}</span>", "ja257:2.3": "<span class='verse-line'>{}</span>", "ja257:2.4": "<span class='verse-line'>{}</span></p>", "ja257:3.1": "<p><span class='verse-line'>{}</span>", "ja257:3.2": "<span class='verse-line'>{}</span>", "ja257:3.3": "<span class='verse-line'>{}</span>", "ja257:3.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja257:4.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja257:0.1": "Jātaka ", "ja257:0.2": "Tikanipāta ", "ja257:0.3": "Saṅkappavagga ", "ja257:0.4": "7. Gāmaṇicandajātaka ", "ja257:1.1": "“Nāyaṁ gharānaṁ kusalo, ", "ja257:1.2": "lolo ayaṁ valīmukho; ", "ja257:1.3": "Kataṁ kataṁ kho dūseyya, ", "ja257:1.4": "evaṁdhammamidaṁ kulaṁ. ", "ja257:2.1": "Nayidaṁ cittavato lomaṁ, ", "ja257:2.2": "nāyaṁ assāsiko migo; ", "ja257:2.3": "Siṭṭhaṁ me janasandhena, ", "ja257:2.4": "nāyaṁ kiñci vijānati. ", "ja257:3.1": "Na mātaraṁ pitaraṁ vā, ", "ja257:3.2": "bhātaraṁ bhaginiṁ sakaṁ; ", "ja257:3.3": "Bhareyya tādiso poso, ", "ja257:3.4": "siṭṭhaṁ dasarathena me”ti. ", "ja257:4.1": "Gāmaṇicanda jātakaṁ sattamaṁ. "}, "variant_text": {"ja257:0.1": "", "ja257:0.2": "", "ja257:0.3": "", "ja257:0.4": "", "ja257:1.1": "", "ja257:1.2": "", "ja257:1.3": "", "ja257:1.4": "", "ja257:2.1": "", "ja257:2.2": "", "ja257:2.3": "Siṭṭhaṁ → satthaṁ (bj, sya1ed, sya2ed, pts-vp-pli1) ", "ja257:2.4": "", "ja257:3.1": "", "ja257:3.2": "", "ja257:3.3": "", "ja257:3.4": "", "ja257:4.1": "Gāmaṇicanda jātakaṁ → gāmaṇicaṇḍajātakaṁ (bj, pts-vp-pli1) "}, "reference_text": {"ja257:0.1": "", "ja257:0.2": "", "ja257:0.3": "", "ja257:0.4": "", "ja257:1.1": "ms22J_694, msdiv19, pts-vp-pli2.298", "ja257:1.2": "", "ja257:1.3": "", "ja257:1.4": "", "ja257:2.1": "ms22J_695, msdiv20", "ja257:2.2": "", "ja257:2.3": "", "ja257:2.4": "", "ja257:3.1": "ms22J_696, msdiv21, pts-vp-pli2.299", "ja257:3.2": "", "ja257:3.3": "", "ja257:3.4": "", "ja257:4.1": "ms22J_697"}, "keys_order": ["ja257:0.1", "ja257:0.2", "ja257:0.3", "ja257:0.4", "ja257:1.1", "ja257:1.2", "ja257:1.3", "ja257:1.4", "ja257:2.1", "ja257:2.2", "ja257:2.3", "ja257:2.4", "ja257:3.1", "ja257:3.2", "ja257:3.3", "ja257:3.4", "ja257:4.1"]}