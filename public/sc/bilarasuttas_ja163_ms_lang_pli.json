{"html_text": {"ja163:0.1": "<article id='ja163'><header><ul><li class='division'>{}</li>", "ja163:0.2": "<li>{}</li>", "ja163:0.3": "<li>{}</li></ul>", "ja163:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja163:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja163:1.2": "<span class='verse-line'>{}</span>", "ja163:1.3": "<span class='verse-line'>{}</span>", "ja163:1.4": "<span class='verse-line'>{}</span></p>", "ja163:2.1": "<p><span class='verse-line'>{}</span>", "ja163:2.2": "<span class='verse-line'>{}</span>", "ja163:2.3": "<span class='verse-line'>{}</span>", "ja163:2.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja163:3.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja163:0.1": "Jātaka ", "ja163:0.2": "Dukanipāta ", "ja163:0.3": "Santhavavagga ", "ja163:0.4": "3. Susīmajātaka ", "ja163:1.1": "“Kāḷā migā setadantā tavīme, ", "ja163:1.2": "Parosataṁ hemajālābhichannā; ", "ja163:1.3": "Te te dadāmīti susīma brūsi, ", "ja163:1.4": "Anussaraṁ pettipitāmahānaṁ”. ", "ja163:2.1": "“Kāḷā migā setadantā mamīme, ", "ja163:2.2": "Parosataṁ hemajālābhichannā; ", "ja163:2.3": "Te te dadāmīti vadāmi māṇava, ", "ja163:2.4": "Anussaraṁ pettipitāmahānan”ti. ", "ja163:3.1": "Susīmajātakaṁ tatiyaṁ. "}, "variant_text": {"ja163:0.1": "", "ja163:0.2": "", "ja163:0.3": "", "ja163:0.4": "", "ja163:1.1": "tavīme → tava ime (bj, pts-vp-pli1) ", "ja163:1.2": "hemajālābhichannā → hemajālābhisañchannā (bj) ", "ja163:1.3": "", "ja163:1.4": "", "ja163:2.1": "mamīme → mama ime (bj, pts-vp-pli1) ", "ja163:2.2": "", "ja163:2.3": "", "ja163:2.4": "", "ja163:3.1": ""}, "reference_text": {"ja163:0.1": "", "ja163:0.2": "", "ja163:0.3": "", "ja163:0.4": "", "ja163:1.1": "dr27.56, ms22J_380, msdiv25, pts-vp-pli2.48", "ja163:1.2": "", "ja163:1.3": "", "ja163:1.4": "", "ja163:2.1": "csp1ed22.41, csp2ed22.41, ms22J_381, msdiv26, pts-vp-pli2.49, sya27.57, vri68.38", "ja163:2.2": "", "ja163:2.3": "", "ja163:2.4": "", "ja163:3.1": "ms22J_382"}, "ke