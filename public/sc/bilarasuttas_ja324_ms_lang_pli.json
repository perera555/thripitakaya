{"html_text": {"ja324:0.1": "<article id='ja324'><header><ul><li class='division'>{}</li>", "ja324:0.2": "<li>{}</li>", "ja324:0.3": "<li>{}</li></ul>", "ja324:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja324:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja324:1.2": "<span class='verse-line'>{}</span>", "ja324:1.3": "<span class='verse-line'>{}</span>", "ja324:1.4": "<span class='verse-line'>{}</span></p>", "ja324:2.1": "<p><span class='verse-line'>{}</span>", "ja324:2.2": "<span class='verse-line'>{}</span>", "ja324:2.3": "<span class='verse-line'>{}</span>", "ja324:2.4": "<span class='verse-line'>{}</span></p>", "ja324:3.1": "<p><span class='verse-line'>{}</span>", "ja324:3.2": "<span class='verse-line'>{}</span>", "ja324:3.3": "<span class='verse-line'>{}</span>", "ja324:3.4": "<span class='verse-line'>{}</span></p>", "ja324:4.1": "<p><span class='verse-line'>{}</span>", "ja324:4.2": "<span class='verse-line'>{}</span>", "ja324:4.3": "<span class='verse-line'>{}</span>", "ja324:4.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja324:5.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja324:0.1": "Jātaka ", "ja324:0.2": "Catukkanipāta ", "ja324:0.3": "Kuṭidūsakavagga ", "ja324:0.4": "4. Cammasāṭakajātaka ", "ja324:1.1": "“Kalyāṇarūpo vatayaṁ catuppado, ", "ja324:1.2": "Subhaddako ceva supesalo ca; ", "ja324:1.3": "Yo brāhmaṇaṁ jātimantūpapannaṁ, ", "ja324:1.4": "Apacāyati meṇḍavaro yasassī”. ", "ja324:2.1": "“Mā brāhmaṇa ittaradassanena, ", "ja324:2.2": "Vissāsamāpajji catuppadassa; ", "ja324:2.3": "Daḷhappahāraṁ abhikaṅkhamāno, ", "ja324:2.4": "Avasakkatī dassati suppahāraṁ”. ", "ja324:3.1": "Ūruṭṭhi bhaggaṁ pavaṭṭito khāribhāro, ", "ja324:3.2": "Sabbañca bhaṇḍaṁ brāhmaṇassa bhinnaṁ; ", "ja324:3.3": "Ubhopi bāhā paggayha kandati, ", "ja324:3.4": "“Abhidhāvatha haññate brahmacārī. ", "ja324:4.1": "Evaṁ so nihato seti, ", "ja324:4.2": "yo apūjaṁ pasaṁsati; ", "ja324:4.3": "Yathāhamajja pahato, ", "ja324:4.4": "hato meṇḍena dummatī”ti. ", "ja324:5.1": "Cammasāṭakajātakaṁ catutthaṁ. "}, "variant_text": {"ja324:0.1": "", "ja324:0.2": "", "ja324:0.3": "", "ja324:0.4": "", "ja324:1.1": "", "ja324:1.2": "", "ja324:1.3": "", "ja324:1.4": "", "ja324:2.1": "", "ja324:2.2": "", "ja324:2.3": "abhikaṅkhamāno → abhikattukāmo (sya1ed, sya2ed) ", "ja324:2.4": "", "ja324:3.1": "Ūruṭṭhi → ūraṭṭhi (bj); uruṭṭhī (sya1ed, sya2ed); satthi (pts-vp-pli1) | bhaggaṁ → bhaggā (sya1ed, sya2ed, pts-vp-pli1) | pavaṭṭito → patito (bj, sya1ed, sya2ed) ", "ja324:3.2": "brāhmaṇassa → brāhmaṇassīdha (bj, pts-vp-pli1); brāhmaṇasseva (si, sya1ed, sya2ed, mr) ", "ja324:3.3": "paggayha → paggayheva (sya1ed, sya2ed); paggahīya (?) ", "ja324:3.4": "", "ja324:4.1": "", "ja324:4.2": "pasaṁsati → namassati (bj, pts-vp-pli1) ", "ja324:4.3": "", "ja324:4.4": "", "ja324:5.1": ""}, "reference_text": {"ja324:0.1": "", "ja324:0.2": "", "ja324:0.3": "", "ja324:0.4": "", "ja324:1.1": "dr27.144, ms22J_1002, msdiv93, ndp22.97, pts-vp-pli3.82, sya27.144", "ja324:1.2": "", "ja324:1.3": "", "ja324:1.4": "", "ja324:2.1": "ms22J_1003, msdiv94, pts-vp-pli3.83, vri68.91", "ja324:2.2": "", "ja324:2.3": "", "ja324:2.4": "", "ja324:3.1": "ms22J_1004, msdiv95", "ja324:3.2": "", "ja324:3.3": "", "ja324:3.4": "", "ja324:4.1": "ms22J_1005, msdiv96", "ja324:4.2": "", "ja324:4.3": "", "ja324:4.4": "", "ja324:5.1": "ms22J_1006"}, "keys_order": ["ja324:0.1", "ja324:0.2", "ja324:0.3", "ja324:0.4", "ja324:1.1", "ja324:1.2", "ja324:1.3", "ja324:1.4", "ja324:2.1", "ja324:2.2", "ja324:2.3", "ja324:2.4", "ja324:3.1", "ja324:3.2", "ja324:3.3", "ja324:3.4", "ja324:4.1", "ja324:4.2", "ja324:4.3", "ja324:4.4", "ja324:5.1"]}