{"html_text": {"ja251:0.1": "<article id='ja251'><header><ul><li class='division'>{}</li>", "ja251:0.2": "<li>{}</li>", "ja251:0.3": "<li>{}</li></ul>", "ja251:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja251:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja251:1.2": "<span class='verse-line'>{}</span>", "ja251:1.3": "<span class='verse-line'>{}</span>", "ja251:1.4": "<span class='verse-line'>{}</span></p>", "ja251:2.1": "<p><span class='verse-line'>{}</span>", "ja251:2.2": "<span class='verse-line'>{}</span>", "ja251:2.3": "<span class='verse-line'>{}</span>", "ja251:2.4": "<span class='verse-line'>{}</span></p>", "ja251:3.1": "<p><span class='verse-line'>{}</span>", "ja251:3.2": "<span class='verse-line'>{}</span>", "ja251:3.3": "<span class='verse-line'>{}</span>", "ja251:3.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja251:4.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja251:0.1": "Jātaka ", "ja251:0.2": "Tikanipāta ", "ja251:0.3": "Saṅkappavagga ", "ja251:0.4": "1. Saṅkapparāgajātaka ", "ja251:1.1": "“Saṅkapparāgadhotena, ", "ja251:1.2": "vitakkanisitena ca; ", "ja251:1.3": "Nālaṅkatena bhadrena, ", "ja251:1.4": "usukārākatena ca. ", "ja251:2.1": "Na kaṇṇāyatamuttena, ", "ja251:2.2": "nāpi morūpasevinā; ", "ja251:2.3": "Tenamhi hadaye viddho, ", "ja251:2.4": "sabbaṅgaparidāhinā. ", "ja251:3.1": "Āvedhañca na passāmi, ", "ja251:3.2": "Yato ruhiramassave; ", "ja251:3.3": "Yāva ayoniso cittaṁ, ", "ja251:3.4": "Sayaṁ me dukkhamābhatan”ti. ", "ja251:4.1": "Saṅkapparāgajātakaṁ paṭhamaṁ. "}, "variant_text": {"ja251:0.1": "", "ja251:0.2": "", "ja251:0.3": "", "ja251:0.4": "", "ja251:1.1": "", "ja251:1.2": "", "ja251:1.3": "bhadrena → … bhaddena (bj); nevālaṅkatabhadrena (sya1ed, sya2ed) ", "ja251:1.4": "usukārākatena ca → na usukārakatena ca (bj, sya1ed, sya2ed, pts-vp-pli1) ", "ja251:2.1": "", "ja251:2.2": "", "ja251:2.3": "", "ja251:2.4": "", "ja251:3.1": "", "ja251:3.2": "", "ja251:3.3": "", "ja251:3.4