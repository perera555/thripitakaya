{"html_text": {"ja269:0.1": "<article id='ja269'><header><ul><li class='division'>{}</li>", "ja269:0.2": "<li>{}</li>", "ja269:0.3": "<li>{}</li></ul>", "ja269:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja269:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja269:1.2": "<span class='verse-line'>{}</span>", "ja269:1.3": "<span class='verse-line'>{}</span>", "ja269:1.4": "<span class='verse-line'>{}</span></p>", "ja269:2.1": "<p><span class='verse-line'>{}</span>", "ja269:2.2": "<span class='verse-line'>{}</span>", "ja269:2.3": "<span class='verse-line'>{}</span>", "ja269:2.4": "<span class='verse-line'>{}</span></p>", "ja269:3.1": "<p><span class='verse-line'>{}</span>", "ja269:3.2": "<span class='verse-line'>{}</span>", "ja269:3.3": "<span class='verse-line'>{}</span>", "ja269:3.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja269:4.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja269:0.1": "Jātaka ", "ja269:0.2": "Tikanipāta ", "ja269:0.3": "Padumavagga ", "ja269:0.4": "9. Sujātajātaka ", "ja269:1.1": "“Na hi vaṇṇena sampannā, ", "ja269:1.2": "mañjukā piyadassanā; ", "ja269:1.3": "Kharavācā piyā hoti, ", "ja269:1.4": "asmiṁ loke paramhi ca. ", "ja269:2.1": "Nanu passasimaṁ kāḷiṁ, ", "ja269:2.2": "dubbaṇṇaṁ tilakāhataṁ; ", "ja269:2.3": "Kokilaṁ saṇhavācena, ", "ja269:2.4": "bahūnaṁ pāṇinaṁ piyaṁ. ", "ja269:3.1": "Tasmā sakhilavācassa, ", "ja269:3.2": "mantabhāṇī anuddhato; ", "ja269:3.3": "Atthaṁ dhammañca dīpeti, ", "ja269:3.4": "madhuraṁ tassa bhāsitan”ti. ", "ja269:4.1": "Sujātajātakaṁ navamaṁ. "}, "reference_text": {"ja269:0.1": "", "ja269:0.2": "", "ja269:0.3": "", "ja269:0.4": "", "ja269:1.1": "ms22J_744, msdiv55, pts-vp-pli2.350", "ja269:1.2": "", "ja269:1.3": "", "ja269:1.4": "", "ja269:2.1": "ms22J_745, msdiv56", "ja269:2.2": "", "ja269:2.3": "", "ja269:2.4": "", "ja269:3.1": "csp1ed22.79, csp2ed22.79, ms22J_746, msdiv57", "ja269:3.2": "", "ja269:3.3": "", "ja269:3.4": "", "ja269:4.1": "ms22J_747"},