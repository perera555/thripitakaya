{"html_text": {"ja437:0.1": "<article id='ja437'><header><ul><li class='division'>{}</li>", "ja437:0.2": "<li>{}</li>", "ja437:0.3": "<li>{}</li></ul>", "ja437:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja437:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja437:1.2": "<span class='verse-line'>{}</span>", "ja437:1.3": "<span class='verse-line'>{}</span>", "ja437:1.4": "<span class='verse-line'>{}</span></p>", "ja437:2.1": "<p><span class='verse-line'>{}</span>", "ja437:2.2": "<span class='verse-line'>{}</span>", "ja437:2.3": "<span class='verse-line'>{}</span>", "ja437:2.4": "<span class='verse-line'>{}</span></p>", "ja437:3.1": "<p><span class='verse-line'>{}</span>", "ja437:3.2": "<span class='verse-line'>{}</span>", "ja437:3.3": "<span class='verse-line'>{}</span>", "ja437:3.4": "<span class='verse-line'>{}</span></p>", "ja437:4.1": "<p><span class='verse-line'>{}</span>", "ja437:4.2": "<span class='verse-line'>{}</span>", "ja437:4.3": "<span class='verse-line'>{}</span>", "ja437:4.4": "<span class='verse-line'>{}</span></p>", "ja437:5.1": "<p><span class='verse-line'>{}</span>", "ja437:5.2": "<span class='verse-line'>{}</span>", "ja437:5.3": "<span class='verse-line'>{}</span>", "ja437:5.4": "<span class='verse-line'>{}</span></p>", "ja437:6.1": "<p><span class='verse-line'>{}</span>", "ja437:6.2": "<span class='verse-line'>{}</span>", "ja437:6.3": "<span class='verse-line'>{}</span>", "ja437:6.4": "<span class='verse-line'>{}</span></p>", "ja437:7.1": "<p><span class='verse-line'>{}</span>", "ja437:7.2": "<span class='verse-line'>{}</span>", "ja437:7.3": "<span class='verse-line'>{}</span>", "ja437:7.4": "<span class='verse-line'>{}</span></p>", "ja437:8.1": "<p><span class='verse-line'>{}</span>", "ja437:8.2": "<span class='verse-line'>{}</span>", "ja437:8.3": "<span class='verse-line'>{}</span>", "ja437:8.4": "<span class='verse-line'>{}</span></p>", "ja437:9.1": "<p><span class='verse-line'>{}</span>", "ja437:9.2": "<span class='verse-line'>{}</span>", "ja437:9.3": "<span class='verse-line'>{}</span>", "ja437:9.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja437:10.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja437:0.1": "Jātaka ", "ja437:0.2": "Navakanipāta ", "ja437:0.3": "Gijjhavagga ", "ja437:0.4": "11. Pūtimaṁsajātaka ", "ja437:1.1": "“Na kho me ruccati āḷi, ", "ja437:1.2": "pūtimaṁsassa pekkhanā; ", "ja437:1.3": "Etādisā sakhārasmā, ", "ja437:1.4": "ārakā parivajjaye”. ", "ja437:2.1": "“Ummattikā ayaṁ veṇī, ", "ja437:2.2": "vaṇṇeti patino sakhiṁ; ", "ja437:2.3": "Pajjhāyi paṭigacchantiṁ, ", "ja437:2.4": "āgataṁ meṇḍamātaraṁ”. ", "ja437:3.1": "“Tvaṁ khosi samma ummatto, ", "ja437:3.2": "dummedho avicakkhaṇo; ", "ja437:3.3": "Yo tvaṁ matālayaṁ katvā, ", "ja437:3.4": "akālena vipekkhasi”. ", "ja437:4.1": "“Na akāle vipekkheyya, ", "ja437:4.2": "kāle pekkheyya paṇḍito; ", "ja437:4.3": "Pūtimaṁsova pajjhāyi, ", "ja437:4.4": "yo akāle vipekkhati”. ", "ja437:5.1": "“Piyaṁ kho āḷi me hotu, ", "ja437:5.2": "puṇṇapattaṁ dadāhi me; ", "ja437:5.3": "Pati sañjīvito mayhaṁ, ", "ja437:5.4": "eyyāsi piyapucchikā”. ", "ja437:6.1": "“Piyaṁ kho āḷi te hotu, ", "ja437:6.2": "puṇṇapattaṁ dadāmi te; ", "ja437:6.3": "Mahatā parivārena, ", "ja437:6.4": "essaṁ kayirāhi bhojanaṁ”. ", "ja437:7.1": "“Kīdiso tuyhaṁ parivāro, ", "ja437:7.2": "yesaṁ kāhāmi bhojanaṁ; ", "ja437:7.3": "Kiṁnāmakā ca te sabbe, ", "ja437:7.4": "taṁ me akkhāhi pucchitā”. ", "ja437:8.1": "“Māliyo caturakkho ca, ", "ja437:8.2": "piṅgiyo atha jambuko; ", "ja437:8.3": "Ediso mayhaṁ parivāro, ", "ja437:8.4": "tesaṁ kayirāhi bhojanaṁ”. ", "ja437:9.1": "“Nikkhantāya agārasmā, ", "ja437:9.2": "bhaṇḍakampi vinassati; ", "ja437:9.3": "Ārogyaṁ āḷino vajjaṁ, ", "ja437:9.4": "idheva vasa māgamā”ti. ", "ja437:10.1": "Pūtimaṁsajātakaṁ ekādasamaṁ. "}, "variant_text": {"ja437:0.1": "", "ja437:0.2": "", "ja437:0.3": "", "ja437:0.4": "", "ja437:1.1": "", "ja437:1.2": "", "ja437:1.3": "", "ja437:1.4": "", "ja437:2.1": "", "ja437:2.2": "", "ja437:2.3": "Pajjhāyi → pajjhāti (bj, pts-vp-pli1); pajjhāyati (bj -nissya) ", "ja437:2.4": "meṇḍamātaraṁ → meḷamātaraṁ (bj, pts-vp-pli1) | taṁ → te (si, sya1ed, sya2ed, pts-vp-pli1) ", "ja437:3.1": "", "ja437:3.2": "", "ja437:3.3": "tvaṁ → so tvaṁ (sya1ed, sya2ed) ", "ja437:3.4": "", "ja437:4.1": "", "ja437:4.2": "", "ja437:4.3": "pajjhāyi → pajjhāti (bj, pts-vp-pli1); pajjhāyati (bj -nissya) ", "ja437:4.4": "", "ja437:5.1": "", "ja437:5.2": "", "ja437:5.3": "", "ja437:5.4": "piyapucchikā → pucchitā (sya1ed, sya2ed, mr) ", "ja437:6.1": "", "ja437:6.2": "", "ja437:6.3": "parivārena → parihārena (sya1ed) ", "ja437:6.4": "essaṁ → esaṁ (si, pts-vp-pli1) | kayirāhi → kayirāsi (pts-vp-pli1) ", "ja437:7.1": "", "ja437:7.2": "", "ja437:7.3": "", "ja437:7.4": "", "ja437:8.1": "", "ja437:8.2": "", "ja437:8.3": "", "ja437:8.4": "kayirāhi → kayirāsi (pts-vp-pli1) ", "ja437:9.1": "", "ja437:9.2": "", "ja437:9.3": "vajjaṁ → vacchaṁ (?) ", "ja437:9.4": "", "ja437:10.1": ""}, "reference_text": {"ja437:0.1": "", "ja437:0.2": "", "ja437:0.3": "", "ja437:0.4": "", "ja437:1.1": "csp1ed22.198, csp2ed22.198, ms22J_1886, msdiv96, pts-vp-pli3.534", "ja437:1.2": "", "ja437:1.3": "", "ja437:1.4": "", "ja437:2.1": "ms22J_1887, msdiv97, vri68.161", "ja437:2.2": "", "ja437:2.3": "", "ja437:2.4": "", "ja437:3.1": "ms22J_1888, msdiv98", "ja437:3.2": "", "ja437:3.3": "", "ja437:3.4": "", "ja437:4.1": "ms22J_1889, msdiv99", "ja437:4.2": "", "ja437:4.3": "", "ja437:4.4": "", "ja437:5.1": "dr27.267, ms22J_1890, msdiv100, pts-vp-pli3.535, sya27.268", "ja437:5.2": "", "ja437:5.3": "", "ja437:5.4": "", "ja437:6.1": "ms22J_1891, msdiv101", "ja437:6.2": "", "ja437:6.3": "", "ja437:6.4": "", "ja437:7.1": "ms22J_1892, msdiv102", "ja437:7.2": "", "ja437:7.3": "", "ja437:7.4": "", "ja437:8.1": "ms22J_1893, msdiv103, ndp22.191", "ja437:8.2": "", "ja437:8.3": "", "ja437:8.4": "", "ja437:9.1": "ms22J_1894, msdiv104, pts-vp-pli3.536", "ja437:9.2": "", "ja437:9.3": "", "ja437:9.4": "", "ja437:10.1