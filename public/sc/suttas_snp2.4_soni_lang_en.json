le": "Maṅgalasutta", "previous": {"author_uid": "ms", "lang": "pli", "name": null, "uid": null}, "next": {"author_uid": "ms", "lang": "pli", "name": null, "uid": null}}, "bilara_translated_text": null, "candidate_authors": ["sujato", "piyadassi", "anandajoti", "brahmali", "narada"]}