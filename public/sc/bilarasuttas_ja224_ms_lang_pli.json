{"html_text": {"ja224:0.1": "<article id='ja224'><header><ul><li class='division'>{}</li>", "ja224:0.2": "<li>{}</li>", "ja224:0.3": "<li>{}</li></ul>", "ja224:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja224:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja224:1.2": "<span class='verse-line'>{}</span>", "ja224:1.3": "<span class='verse-line'>{}</span>", "ja224:1.4": "<span class='verse-line'>{}</span></p>", "ja224:2.1": "<p><span class='verse-line'>{}</span>", "ja224:2.2": "<span class='verse-line'>{}</span>", "ja224:2.3": "<span class='verse-line'>{}</span>", "ja224:2.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja224:3.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja224:0.1": "Jātaka ", "ja224:0.2": "Dukanipāta ", "ja224:0.3": "Kāsāvavagga ", "ja224:0.4": "4. Kumbhilajātaka ", "ja224:1.1": "“Yassete caturo dhammā, ", "ja224:1.2": "vānarinda yathā tava; ", "ja224:1.3": "Saccaṁ dhammo dhiti cāgo, ", "ja224:1.4": "diṭṭhaṁ so ativattati. ", "ja224:2.1": "Yassa cete na vijjanti, ", "ja224:2.2": "guṇā paramabhaddakā; ", "ja224:2.3": "Saccaṁ dhammo dhiti cāgo, ", "ja224:2.4": "diṭṭhaṁ so nātivattatī”ti. ", "ja224:3.1": "Kumbhilajātakaṁ catutthaṁ. "}, "variant_text": {"ja224:0.1": "", "ja224:0.2": "", "ja224:0.3": "", "ja224:0.4": "", "ja224:1.1": "", "ja224:1.2": "", "ja224:1.3": "", "ja224:1.4": "", "ja224:2.1": "", "ja224:2.2": "", "ja224:2.3": "", "ja224:2.4": "", "ja224:3.1": "Kumbhilajātakaṁ → kumbhīlajātakaṁ (bj, sya1ed, sya2ed, pts-vp-pli1) "}, "reference_text": {"ja224:0.1": "", "ja224:0.2": "", "ja224:0.3": "", "ja224:0.4": "", "ja224:1.1": "bj30.108, ms22J_579, msdiv147, ndp22.57, pts-vp-pli2.206, sya27.85", "ja224:1.2": "", "ja224:1.3": "", "ja224:1.4": "", "ja224:2.1": "ms22J_580, msdiv148", "ja224:2.2": "", "ja224:2.3": "", "ja224:2.4": "", "ja224:3.1": "ms22J_581"}, "keys_order": ["ja224:0.1", "ja224:0.2", "ja224:0.3", "ja224:0.4", "ja224:1.1", "ja224:1.2", "ja224:1.3", "ja224:1.4", "ja224:2.1