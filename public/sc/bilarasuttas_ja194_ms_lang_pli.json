{"html_text": {"ja194:0.1": "<article id='ja194'><header><ul><li class='division'>{}</li>", "ja194:0.2": "<li>{}</li>", "ja194:0.3": "<li>{}</li></ul>", "ja194:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja194:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja194:1.2": "<span class='verse-line'>{}</span>", "ja194:1.3": "<span class='verse-line'>{}</span>", "ja194:1.4": "<span class='verse-line'>{}</span></p>", "ja194:2.1": "<p><span class='verse-line'>{}</span>", "ja194:2.2": "<span class='verse-line'>{}</span>", "ja194:2.3": "<span class='verse-line'>{}</span>", "ja194:2.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja194:3.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja194:0.1": "Jātaka ", "ja194:0.2": "Dukanipāta ", "ja194:0.3": "Ruhakavagga ", "ja194:0.4": "4. Maṇicorajātaka ", "ja194:1.1": "“Na santi devā pavasanti nūna, ", "ja194:1.2": "Na hi nūna santi idha lokapālā; ", "ja194:1.3": "Sahasā karontānamasaññatānaṁ, ", "ja194:1.4": "Na hi nūna santī paṭisedhitāro”. ", "ja194:2.1": "“Akāle vassatī tassa, ", "ja194:2.2": "kāle tassa na vassati; ", "ja194:2.3": "Saggā ca cavati ṭhānā, ", "ja194:2.4": "nanu so tāvatā hato”ti. ", "ja194:3.1": "Maṇicorajātakaṁ catutthaṁ. "}, "reference_text": {"ja194:0.1": "", "ja194:0.2": "", "ja194:0.3": "", "ja194:0.4": "", "ja194:1.1": "csp1ed22.51, csp2ed22.51, ms22J_479, msdiv87, pts-vp-pli2.123", "ja194:1.2": "", "ja194:1.3": "", "ja194:1.4": "", "ja194:2.1": "bj30.90, ms22J_480, msdiv88, pts-vp-pli2.124, sya27.71", "ja194:2.2": "", "ja194:2.3": "", "ja194:2.4": "", "ja194:3.1": "ms22J_481"}, "keys_order": ["ja194:0.1", "ja194:0.2", "ja194:0.3", "ja194:0.4", "ja194:1.1", "ja194:1.2", "ja194:1.3", "ja194:1.4", "ja194:2.1", "ja194:2.2", "ja194:2.3", "ja194:2.4", "ja194:3.1"]}