{"html_text": {"ja280:0.1": "<article id='ja280'><header><ul><li class='division'>{}</li>", "ja280:0.2": "<li>{}</li>", "ja280:0.3": "<li>{}</li></ul>", "ja280:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja280:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja280:1.2": "<span class='verse-line'>{}</span>", "ja280:1.3": "<span class='verse-line'>{}</span>", "ja280:1.4": "<span class='verse-line'>{}</span></p>", "ja280:2.1": "<p><span class='verse-line'>{}</span>", "ja280:2.2": "<span class='verse-line'>{}</span>", "ja280:2.3": "<span class='verse-line'>{}</span>", "ja280:2.4": "<span class='verse-line'>{}</span></p>", "ja280:3.1": "<p><span class='verse-line'>{}</span>", "ja280:3.2": "<span class='verse-line'>{}</span>", "ja280:3.3": "<span class='verse-line'>{}</span>", "ja280:3.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja280:4.1": "<p class='endsutta'>{}</p>", "ja280:4.2": "<p class='endvagga'>{}</p>", "ja280:5.1": "<p class='uddana-intro'>{}</p>", "ja280:6.1": "<blockquote class='uddanagatha'><p><span class='verse-line'>{}</span>", "ja280:6.2": "<span class='verse-line'>{}</span>", "ja280:6.3": "<span class='verse-line'>{}</span>", "ja280:6.4": "<span class='verse-line'>{}</span></p></blockquote></article>"}, "root_text": {"ja280:0.1": "Jātaka ", "ja280:0.2": "Tikanipāta ", "ja280:0.3": "Udapānavagga ", "ja280:0.4": "10. Puṭadūsakajātaka ", "ja280:1.1": "“Addhā hi nūna migarājā, ", "ja280:1.2": "puṭakammassa kovido; ", "ja280:1.3": "Tathā hi puṭaṁ dūseti, ", "ja280:1.4": "aññaṁ nūna karissati”. ", "ja280:2.1": "“Na me mātā vā pitā vā, ", "ja280:2.2": "puṭakammassa kovido; ", "ja280:2.3": "Kataṁ kataṁ kho dūsema, ", "ja280:2.4": "evaṁ dhammamidaṁ kulaṁ”. ", "ja280:3.1": "“Yesaṁ vo ediso dhammo, ", "ja280:3.2": "Adhammo pana kīdiso; ", "ja280:3.3": "Mā vo dhammaṁ adhammaṁ vā, ", "ja280:3.4": "Addasāma kudācanan”ti. ", "ja280:4.1": "Puṭadūsakajātakaṁ dasamaṁ. ", "ja280:4.2": "Udapānavaggo tatiyo. ", "ja280:5.1": "Tassuddānaṁ ", "ja280:6.1": "Udapānavaraṁ vanabyaggha kapi, ", "ja280:6.2": "Sikhinī ca balāka ruciravaro; ", "ja280:6.3": "Sujanādhiparomakadūsa puna, ", "ja280:6.4": "Satapattavaro puṭakamma dasāti. "}, "variant_text": {"ja280:0.1": "", "ja280:0.2": "", "ja280:0.3": "", "ja280:0.4": "", "ja280:1.1": "", "ja280:1.2": "", "ja280:1.3": "", "ja280:1.4": "", "ja280:2.1": "", "ja280:2.2": "", "ja280:2.3": "", "ja280:2.4": "", "ja280:3.1": "", "ja280:3.2": "", "ja280:3.3": "", "ja280:3.4": "", "ja280:4.1": "Puṭadūsakajātakaṁ → pūṭadūsakajātakaṁ (sya1ed, sya2ed) ", "ja280:4.2": "Udapānavaggo → araññavaggo (bj, pts-vp-pli1, mr) ", "ja280:5.1": "", "ja280:6.1": "", "ja280:6.2": "", "ja280:6.3": "", "ja280:6.4": ""}, "reference_text": {"ja280:0.1": "", "ja280:0.2": "", "ja280:0.3": "", "ja280:0.4": "", "ja280:1.1": "ms22J_790, msdiv88, pts-vp-pli2.391", "ja280:1.2": "", "ja280:1.3": "", "ja280:1.4": "", "ja280:2.1": "dr27.115, ms22J_791, msdiv89", "ja280:2.2": "", "ja280:2.3": "", "ja280:2.4": "", "ja280:3.1": "ms22J_792, msdiv90, pts-vp-pli2.392", "ja280:3.2": "", "ja280:3.3": "", "ja280:3.4": "", "ja280:4.1": "ms22J_793", "ja280:4.2": "", "ja280:5.1": "ms22J_794", "ja280:6.1": "ms22J_795", "ja280:6.2": "", "ja280:6.3": "", "ja280:6.4": ""}, "keys_order": ["ja280:0.1", "ja280:0.2", "ja280:0.3", "ja280:0.4", "ja280:1.1", "ja280:1.2", "ja280:1.3", "ja280:1.4", "ja280:2.1", "ja280:2.2", "ja280:2.3", "ja280:2.4", "ja280:3.1", "ja280:3.2", "ja280:3.3", "ja280:3.4", "ja280:4.1", "ja280:4.2", "ja280:5.1", "ja280:6.1", "ja280:6.2", "ja280:6.3", "ja280:6.4"]}