{"html_text": {"ja197:0.1": "<article id='ja197'><header><ul><li class='division'>{}</li>", "ja197:0.2": "<li>{}</li>", "ja197:0.3": "<li>{}</li></ul>", "ja197:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja197:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja197:1.2": "<span class='verse-line'>{}</span>", "ja197:1.3": "<span class='verse-line'>{}</span>", "ja197:1.4": "<span class='verse-line'>{}</span></p>", "ja197:2.1": "<p><span class='verse-line'>{}</span>", "ja197:2.2": "<span class='verse-line'>{}</span>", "ja197:2.3": "<span class='verse-line'>{}</span>", "ja197:2.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja197:3.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja197:0.1": "Jātaka ", "ja197:0.2": "Dukanipāta ", "ja197:0.3": "Ruhakavagga ", "ja197:0.4": "7. Mittāmittajātaka ", "ja197:1.1": "“Na naṁ umhayate disvā, ", "ja197:1.2": "na ca naṁ paṭinandati; ", "ja197:1.3": "Cakkhūni cassa na dadāti, ", "ja197:1.4": "paṭilomañca vattati. ", "ja197:2.1": "Ete bhavanti ākārā, ", "ja197:2.2": "amittasmiṁ patiṭṭhitā; ", "ja197:2.3": "Yehi amittaṁ jāneyya, ", "ja197:2.4": "disvā sutvā ca paṇḍito”ti. ", "ja197:3.1": "Mittāmittajātakaṁ sattamaṁ. "}, "reference_text": {"ja197:0.1": "", "ja197:0.2": "", "ja197:0.3": "", "ja197:0.4": "", "ja197:1.1": "ms22J_488, msdiv93, pts-vp-pli2.131", "ja197:1.2": "", "ja197:1.3": "", "ja197:1.4": "", "ja197:2.1": "csp1ed22.52, csp2ed22.52, ms22J_489, msdiv94, sya27.72", "ja197:2.2": "", "ja197:2.3": "", "ja197:2.4": "", "ja197:3.1": "ms22J_490"}, "keys_order": ["ja197:0.1", "ja197:0.2", "ja197:0.3", "ja197:0.4", "ja197:1.1", "ja197:1.2", "ja197:1.3", "ja197:1.4", "ja197:2.1", "ja197:2.2", "ja197:2.3", "ja197:2.4", "ja197:3.1"]}