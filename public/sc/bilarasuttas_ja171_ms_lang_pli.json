{"html_text": {"ja171:0.1": "<article id='ja171'><header><ul><li class='division'>{}</li>", "ja171:0.2": "<li>{}</li>", "ja171:0.3": "<li>{}</li></ul>", "ja171:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja171:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja171:1.2": "<span class='verse-line'>{}</span>", "ja171:1.3": "<span class='verse-line'>{}</span>", "ja171:1.4": "<span class='verse-line'>{}</span></p>", "ja171:2.1": "<p><span class='verse-line'>{}</span>", "ja171:2.2": "<span class='verse-line'>{}</span>", "ja171:2.3": "<span class='verse-line'>{}</span>", "ja171:2.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja171:3.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja171:0.1": "Jātaka ", "ja171:0.2": "Dukanipāta ", "ja171:0.3": "Kalyāṇavagga ", "ja171:0.4": "1. Kalyāṇadhammajātaka ", "ja171:1.1": "“Kalyāṇadhammoti yadā janinda, ", "ja171:1.2": "Loke samaññaṁ anupāpuṇāti; ", "ja171:1.3": "Tasmā na hiyyetha naro sapañño, ", "ja171:1.4": "Hiriyāpi santo dhuramādiyanti. ", "ja171:2.1": "Sāyaṁ samaññā idha majja pattā, ", "ja171:2.2": "Kalyāṇadhammoti janinda loke; ", "ja171:2.3": "Tāhaṁ samekkhaṁ idha pabbajissaṁ, ", "ja171:2.4": "Na hi matthi chando idha kāmabhoge”ti. ", "ja171:3.1": "Kalyāṇadhammajātakaṁ paṭhamaṁ. "}, "variant_text": {"ja171:0.1": "", "ja171:0.2": "", "ja171:0.3": "", "ja171:0.4": "", "ja171:1.1": "", "ja171:1.2": "", "ja171:1.3": "hiyyetha → hīyetha (bj) ", "ja171:1.4": "", "ja171:2.1": "", "ja171:2.2": "", "ja171:2.3": "", "ja171:2.4": "", "ja171:3.1": ""}, "reference_text": {"ja171:0.1": "", "ja171:0.2": "", "ja171:0.3": "", "ja171:0.4": "", "ja171:1.1": "bj30.76, dr27.59, ms22J_406, msdiv41, ndp22.41, pts-vp-pli2.65, sya27.60, vri68.40", "ja171:1.2": "", "ja171:1.3": "", "ja171:1.4": "", "ja171:2.1": "ms22J_407, msdiv42", "ja171:2.2": "", "ja171:2.3": "", "ja171:2.4": "", "ja171:3.1": "ms22J_408"}, "keys_order": ["ja171:0.1", "ja171:0.2", "ja171:0.3", "ja171:0.4", "ja171:1.1", "ja17