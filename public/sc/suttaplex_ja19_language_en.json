[{"acronym": "Ja 19", "alt_acronym": null, "volpages": "PTS 1.169", "alt_volpages": null, "uid": "ja19", "blurb": "“Take thought of life hereafter.” This story was told by the Master while at Jetavana about the offering of a sacrifice under vow to gods. Tradition says that in those days folk when going a journey on business, used to slay living creatures and offer them as a sacrifice to gods, and set out on their way, after making this vow,—“If we come safely back with a profit, we will give you another sacrifice.” And when they did come safely back with a profit, the Idea that this was all due to gods made them slay a number of living creatures and offer them up as a sacrifice to obtain a release from their vow.", "difficulty": null, "original_title": "Āyācitabhattajātaka", "root_lang": "pli", "root_lang_name": "Pāli", "type": "leaf", "translated_title": "Sacrifice to Fulfill a Wish ", "translations": [{"lang": "pli", "lang_name": "Pāli", "is_root": true, "author": "Mahāsaṅgīti Tipiṭaka Buddhavasse 2500", "author_short": "ms", "author_uid": "ms", "publication_date": null, "id": "ja19_root-pli-ms", "segmented": true, "title": null, "volpage": null, "has_comment": false}, {"lang": "de", "lang_name": "Deutsch", "is_root": false, "author": "Sabbamitta", "author_short": "sabbamitta", "author_uid": "sabbamitta", "publication_date": null, "id": "ja19_translation-de-sabbamitta", "segmented": true, "title": "Das Gelöbnis-Festmahl ", "volpage": null, "has_comment": true}, {"lang": "de", "lang_name": "Deutsch", "is_root": false, "author": "Dr. Julius Dutoit", "author_short": "Dutoit", "author_uid": "dutoit", "publication_date": "2007", "id": "de_ja19_dutoit", "segmented": false, "volpage": null, "has_comment": false}, {"lang": "en", "lang_name": "English", "is_root": false, "author": "Bhikkhu Sujato", "author_short": "sujato", "author_uid": "sujato", "publication_date": null, "id": "ja19_translation-en-sujato", "segmented": true, "title": "Sacrifice to Fulfill a Wish ", "volp