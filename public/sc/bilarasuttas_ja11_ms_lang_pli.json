{"html_text": {"ja11:0.1": "<article id='ja11'><header><ul><li class='division'>{}</li>", "ja11:0.2": "<li>{}</li>", "ja11:0.3": "<li>{}</li></ul>", "ja11:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja11:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja11:1.2": "<span class='verse-line'>{}</span>", "ja11:1.3": "<span class='verse-line'>{}</span>", "ja11:1.4": "<span class='verse-line'>{}</span>", "ja11:1.5": "<span class='verse-line'>{}</span>", "ja11:1.6": "<span class='verse-line'>{}</span></p></blockquote>", "ja11:2.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja11:0.1": "Jātaka ", "ja11:0.2": "Ekakanipāta ", "ja11:0.3": "Sīlavagga ", "ja11:0.4": "1. Lakkhaṇamigajātaka ", "ja11:1.1": "“Hoti sīlavataṁ attho, ", "ja11:1.2": "paṭisanthāravuttinaṁ; ", "ja11:1.3": "Lakkhaṇaṁ passa āyantaṁ, ", "ja11:1.4": "ñātisaṅghapurakkhataṁ; ", "ja11:1.5": "Atha passasimaṁ kāḷaṁ, ", "ja11:1.6": "suvihīnaṁva ñātibhī”ti. ", "ja11:2.1": "Lakkhaṇamigajātakaṁ paṭhamaṁ. "}, "variant_text": {"ja11:0.1": "", "ja11:0.2": "", "ja11:0.3": "", "ja11:0.4": "", "ja11:1.1": "", "ja11:1.2": "paṭisanthāravuttinaṁ → paṭisandhāra … (mr) ", "ja11:1.3": "", "ja11:1.4": "ñātisaṅghapurakkhataṁ → purakkhitaṁ (sya1ed, sya2ed); purekkhitaṁ (mr) ", "ja11:1.5": "", "ja11:1.6": "", "ja11:2.1": "Lakkhaṇamigajātakaṁ → lakkhaṇajātakaṁ (sya1ed, sya2ed, pts-vp-pli1) "}, "reference_text": {"ja11:0.1": "", "ja11:0.2": "", "ja11:0.3": "", "ja11:0.4": "", "ja11:1.1": "bj30.6, dr27.5, ms22J_24, msdiv11, pts-vp-pli1.144", "ja11:1.2": "", "ja11:1.3": "", "ja11:1.4": "", "ja11:1.5": "", "ja11:1.6": "", "ja11:2.1": "ms22J_25"}, "keys_order": ["ja11:0.1", "ja11:0.2", "ja11:0.3", "ja11:0.4", "ja11:1.1", "ja11:1.2", "ja11:1.3", "ja11:1.4", "ja11:1.5", "ja11:1.6", "ja11:2.1"]}