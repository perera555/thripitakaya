{"html_text": {"ja407:0.1": "<article id='ja407'><header><ul><li class='division'>{}</li>", "ja407:0.2": "<li>{}</li>", "ja407:0.3": "<li>{}</li></ul>", "ja407:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja407:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja407:1.2": "<span class='verse-line'>{}</span>", "ja407:1.3": "<span class='verse-line'>{}</span>", "ja407:1.4": "<span class='verse-line'>{}</span></p>", "ja407:2.1": "<p><span class='verse-line'>{}</span>", "ja407:2.2": "<span class='verse-line'>{}</span>", "ja407:2.3": "<span class='verse-line'>{}</span>", "ja407:2.4": "<span class='verse-line'>{}</span></p>", "ja407:3.1": "<p><span class='verse-line'>{}</span>", "ja407:3.2": "<span class='verse-line'>{}</span>", "ja407:3.3": "<span class='verse-line'>{}</span>", "ja407:3.4": "<span class='verse-line'>{}</span></p>", "ja407:4.1": "<p><span class='verse-line'>{}</span>", "ja407:4.2": "<span class='verse-line'>{}</span>", "ja407:4.3": "<span class='verse-line'>{}</span>", "ja407:4.4": "<span class='verse-line'>{}</span></p>", "ja407:5.1": "<p><span class='verse-line'>{}</span>", "ja407:5.2": "<span class='verse-line'>{}</span>", "ja407:5.3": "<span class='verse-line'>{}</span>", "ja407:5.4": "<span class='verse-line'>{}</span></p>", "ja407:6.1": "<p><span class='verse-line'>{}</span>", "ja407:6.2": "<span class='verse-line'>{}</span>", "ja407:6.3": "<span class='verse-line'>{}</span>", "ja407:6.4": "<span class='verse-line'>{}</span></p>", "ja407:7.1": "<p><span class='verse-line'>{}</span>", "ja407:7.2": "<span class='verse-line'>{}</span>", "ja407:7.3": "<span class='verse-line'>{}</span>", "ja407:7.4": "<span class='verse-line'>{}</span>", "ja407:7.5": "<span class='verse-line'>{}</span>", "ja407:7.6": "<span class='verse-line'>{}</span></p></blockquote>", "ja407:8.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja407:0.1": "Jātaka ", "ja407:0.2": "Sattakanipāta ", "ja407:0.3": "Gandhāravagga ", "ja407:0.4": "2. Mahākapijātaka ", "ja407:1.1": "“Attānaṁ saṅkamaṁ katvā, ", "ja407:1.2": "Yo sotthiṁ samatārayi; ", "ja407:1.3": "Kiṁ tvaṁ tesaṁ kime tuyhaṁ, ", "ja407:1.4": "Honti ete mahākapi”. ", "ja407:2.1": "“Rājāhaṁ issaro tesaṁ, ", "ja407:2.2": "yūthassa parihārako; ", "ja407:2.3": "Tesaṁ sokaparetānaṁ, ", "ja407:2.4": "bhītānaṁ te arindama. ", "ja407:3.1": "Ullaṅghayitvā attānaṁ, ", "ja407:3.2": "vissaṭṭhadhanuno sataṁ; ", "ja407:3.3": "Tato aparapādesu, ", "ja407:3.4": "daḷhaṁ bandhaṁ latāguṇaṁ. ", "ja407:4.1": "Chinnabbhamiva vātena, ", "ja407:4.2": "Nuṇṇo rukkhaṁ upāgamiṁ; ", "ja407:4.3": "Sohaṁ appabhavaṁ tattha, ", "ja407:4.4": "Sākhaṁ hatthehi aggahiṁ. ", "ja407:5.1": "Taṁ maṁ viyāyataṁ santaṁ, ", "ja407:5.2": "sākhāya ca latāya ca; ", "ja407:5.3": "Samanukkamantā pādehi, ", "ja407:5.4": "sotthiṁ sākhāmigā gatā. ", "ja407:6.1": "Taṁ maṁ na tapate bandho, ", "ja407:6.2": "mato me na tapessati; ", "ja407:6.3": "Sukhamāharitaṁ tesaṁ, ", "ja407:6.4": "yesaṁ rajjamakārayiṁ. ", "ja407:7.1": "Esā te upamā rāja, ", "ja407:7.2": "taṁ suṇohi arindama; ", "ja407:7.3": "Raññā raṭṭhassa yoggassa, ", "ja407:7.4": "balassa nigamassa ca; ", "ja407:7.5": "Sabbesaṁ sukhameṭṭhabbaṁ, ", "ja407:7.6": "khattiyena pajānatā”ti. ", "ja407:8.1": "Mahākapijātakaṁ dutiyaṁ. "}, "variant_text": {"ja407:0.1": "", "ja407:0.2": "", "ja407:0.3": "", "ja407:0.4": "", "ja407:1.1": "", "ja407:1.2": "", "ja407:1.3": "kime → kimo (bj, pts-vp-pli1); kiṁme (sya1ed, sya2ed) ", "ja407:1.4": "ete → hete (sya1ed, sya2ed); so te (mr) ", "ja407:2.1": "", "ja407:2.2": "", "ja407:2.3": "", "ja407:2.4": "", "ja407:3.1": "Ullaṅghayitvā → sa laṅghayitvā (pts-vp-pli1); sulaṅghayitvā (mr) ", "ja407:3.2": "", "ja407:3.3": "", "ja407:3.4": "", "ja407:4.1": "", "ja407:4.2": "Nuṇṇo → nunno (bj) ", "ja407:4.3": "", "ja407:4.4": "", "ja407:5.1": "", "ja407:5.2": "", "ja407:5.3": "", "ja407:5.4": "", "ja407:6.1": "", "ja407:6.2": "mato → vadho (bj, sya1ed, sya2ed, pts-vp-pli1) ", "ja407:6.3": "", "ja407:6.4": "", "ja407:7.1": "", "ja407:7.2": "taṁ suṇohi arindama → atthasandassanī katā (si, pts1ed), taṁ suṇāhi arindama (sya1ed), taṁ suṇāhi arindamaṁ (sya2ed) ", "ja407:7.3": "", "ja407:7.4": "", "ja407:7.5": "", "ja407:7.6": "", "ja407:8.1": ""}, "reference_text": {"ja407:0.1": "", "ja407:0.2": "", "ja407:0.3": "", "ja407:0.4": "", "ja407:1.1": "dr27.224, ms22J_1580, msdiv83, ndp22.157, pts-vp-pli3.373, sya27.225", "ja407:1.2": "", "ja407:1.3": "", "ja407:1.4": "", "ja407:2.1": "ms22J_1581, msdiv84", "ja407:2.2": "", "ja407:2.3": "", "ja407:2.4": "", "ja407:3.1": "ms22J_1582, msdiv85", "ja407:3.2": "", "ja407:3.3": "", "ja407:3.4": "", "ja407:4.1": "csp1ed22.166, csp2ed22.166, ms22J_1583, msdiv86", "ja407:4.2": "", "ja407:4.3": "", "ja407:4.4": "", "ja407:5.1": "bj30.284, ms22J_1584, msdiv87, vri68.137", "ja407:5.2": "", "ja407:5.3": "", "ja407:5.4": "", "ja407:6.1": "ms22J_1585, msdiv88", "ja407:6.2": "", "ja407:6.3": "", "ja407:6.4": "", "ja407:7.1": "ms22J_1586, msdiv89", "ja407:7.2": "", "ja407:7.3": "", "ja407:7.4": "", "ja407:7.5": "", "ja407:7.6": "", "ja407:8.1": "ms22J_1587"}, "keys_order": ["ja407:0.1", "ja407:0.2", "ja407:0.3", "ja407:0.4", "ja407:1.1", "ja407:1.2", "ja407:1.3", "ja407:1.4", "ja407:2.1", "ja407:2.2", "ja407:2.3", "ja407:2.4", "ja407:3.1", "ja407:3.2", "ja407:3.3", "ja407:3.4", "ja407:4.1", "ja407:4.2", "ja407:4.3", "ja407:4.4", "ja407:5.1", "ja407:5.2", "ja407:5.3", "ja407:5.4", "ja407:6.1", "ja407:6.2", "ja407:6.3", "ja407:6.4", "ja407:7.1", "ja407:7.2", "ja407:7.3", "ja407:7.4", "ja407:7.5", "ja407:7.6", "ja407:8.1"]}