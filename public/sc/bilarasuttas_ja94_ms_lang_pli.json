{"html_text": {"ja94:0.1": "<article id='ja94'><header><ul><li class='division'>{}</li>", "ja94:0.2": "<li>{}</li>", "ja94:0.3": "<li>{}</li></ul>", "ja94:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja94:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja94:1.2": "<span class='verse-line'>{}</span>", "ja94:1.3": "<span class='verse-line'>{}</span>", "ja94:1.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja94:2.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja94:0.1": "Jātaka ", "ja94:0.2": "Ekakanipāta ", "ja94:0.3": "Littavagga ", "ja94:0.4": "4. Lomahaṁsajātaka ", "ja94:1.1": "Sotatto sosindo ceva, ", "ja94:1.2": "eko bhiṁsanake vane; ", "ja94:1.3": "Naggo na caggimāsīno, ", "ja94:1.4": "esanāpasuto munī”ti. ", "ja94:2.1": "Lomahaṁsajātakaṁ catutthaṁ. "}, "variant_text": {"ja94:0.1": "", "ja94:0.2": "", "ja94:0.3": "", "ja94:0.4": "", "ja94:1.1": "sosindo → sosino (bj, mr); sosīto (sya1ed, sya2ed, pts-vp-pli1) ", "ja94:1.2": "", "ja94:1.3": "", "ja94:1.4": "", "ja94:2.1": ""}, "reference_text": {"ja94:0.1": "", "ja94:0.2": "", "ja94:0.3": "", "ja94:0.4": "", "ja94:1.1": "ms22J_208, msdiv94, pts-vp-pli1.390", "ja94:1.2": "", "ja94:1.3": "", "ja94:1.4": "", "ja94:2.1": "ms22J_209"}, "keys_order": ["ja94:0.1", "ja94:0.2", "ja94:0.3", "ja94:0.4", "ja94:1.1", "ja94:1.2", "ja94:1.3", "ja94:1.4", "ja94:2.1"]}