{"html_text": {"ja309:0.1": "<article id='ja309'><header><ul><li class='division'>{}</li>", "ja309:0.2": "<li>{}</li>", "ja309:0.3": "<li>{}</li></ul>", "ja309:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja309:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja309:1.2": "<span class='verse-line'>{}</span>", "ja309:1.3": "<span class='verse-line'>{}</span>", "ja309:1.4": "<span class='verse-line'>{}</span>", "ja309:1.5": "<span class='verse-line'>{}</span></p>", "ja309:2.1": "<p><span class='verse-line'>{}</span>", "ja309:2.2": "<span class='verse-line'>{}</span>", "ja309:2.3": "<span class='verse-line'>{}</span>", "ja309:2.4": "<span class='verse-line'>{}</span></p>", "ja309:3.1": "<p><span class='verse-line'>{}</span>", "ja309:3.2": "<span class='verse-line'>{}</span>", "ja309:3.3": "<span class='verse-line'>{}</span>", "ja309:3.4": "<span class='verse-line'>{}</span></p>", "ja309:4.1": "<p><span class='verse-line'>{}</span>", "ja309:4.2": "<span class='verse-line'>{}</span>", "ja309:4.3": "<span class='verse-line'>{}</span>", "ja309:4.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja309:5.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja309:0.1": "Jātaka ", "ja309:0.2": "Catukkanipāta ", "ja309:0.3": "Kāliṅgavagga ", "ja309:0.4": "9. Chavakajātaka ", "ja309:1.1": "“Sabbamidaṁ carimaṁ kataṁ, ", "ja309:1.2": "Ubho dhammaṁ na passare; ", "ja309:1.3": "Ubho pakatiyā cutā, ", "ja309:1.4": "Yo cāyaṁ mantejjhāpeti; ", "ja309:1.5": "Yo ca mantaṁ adhīyati”. ", "ja309:2.1": "“Sālīnaṁ odanaṁ bhuñje, ", "ja309:2.2": "suciṁ maṁsūpasecanaṁ; ", "ja309:2.3": "Tasmā etaṁ na sevāmi, ", "ja309:2.4": "dhammaṁ isīhi sevitaṁ”. ", "ja309:3.1": "“Paribbaja mahā loko, ", "ja309:3.2": "pacantaññepi pāṇino; ", "ja309:3.3": "Mā taṁ adhammo ācarito, ", "ja309:3.4": "asmā kumbhamivābhidā. ", "ja309:4.1": "Dhiratthu taṁ yasalābhaṁ, ", "ja309:4.2": "dhanalābhañca brāhmaṇa; ", "ja309:4.3": "Yā vutti vinipātena, ", "ja309:4.4": "adhammacaraṇena vā”ti. ", "ja309:5.1": "Chavakajātakaṁ navamaṁ. "}, "variant_text": {"ja309:0.1": "", "ja309:0.2": "", "ja309:0.3": "", "ja309:0.4": "", "ja309:1.1": "carimaṁ kataṁ → carimavataṁ (bj, pts-vp-pli1); ca marikataṁ (sya1ed, sya2ed) ", "ja309:1.2": "", "ja309:1.3": "", "ja309:1.4": "mantejjhāpeti → sajjhāpayati (bj, pts-vp-pli1); mantajjhāyati (si); mante jhāpeti (sya1ed, sya2ed) ", "ja309:1.5": "", "ja309:2.1": "", "ja309:2.2": "", "ja309:2.3": "", "ja309:2.4": "", "ja309:3.1": "mahā loko → mahābrahme (mr) ", "ja309:3.2": "", "ja309:3.3": "", "ja309:3.4": "", "ja309:4.1": "", "ja309:4.2": "", "ja309:4.3": "", "ja309:4.4": "", "ja309:5.1": "Chavakajātakaṁ → chavajātakaṁ (sya1ed, sya2ed) "}, "reference_text": {"ja309:0.1": "", "ja309:0.2": "", "ja309:0.3": "", "ja309:0.4": "", "ja309:1.1": "bj30.170, ms22J_923, msdiv33, pts-vp-pli3.28", "ja309:1.2": "", "ja309:1.3": "", "ja309:1.4": "", "ja309:1.5": "", "ja309:2.1": "ms22J_924, msdiv34, pts-vp-pli3.29", "ja309:2.2": "", "ja309:2.3": "", "ja309:2.4": "", "ja309:3.1": "ms22J_925, msdiv35", "ja309:3.2": "", "ja309:3.3": "", "ja309:3.4": "", "ja309:4.1": "csp1ed22.98, csp2ed22.98, dr27.135, ms22J_926, msdiv36", "ja309:4.2": "", "ja309:4.3": "", "ja309:4.4": "", "ja309:5.1": "ms22J_927"}, "keys_order": ["ja309:0.1", "ja309:0.2", "ja309:0.3", "ja309:0.4", "ja309:1.1", "ja309:1.2", "ja309:1.3", "ja309:1.4", "ja309:1.5", "ja309:2.1", "ja309:2.2", "ja309:2.3", "ja309:2.4", "ja309:3.1", "ja309:3.2", "ja309:3.3", "ja309:3.4", "ja309:4.1", "ja309:4.2", "ja309:4.3", "ja309:4.4", "ja309:5.1"]}