{"html_text": {"ja220:0.1": "<article id='ja220'><header><ul><li class='division'>{}</li>", "ja220:0.2": "<li>{}</li>", "ja220:0.3": "<li>{}</li></ul>", "ja220:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja220:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja220:1.2": "<span class='verse-line'>{}</span>", "ja220:1.3": "<span class='verse-line'>{}</span>", "ja220:1.4": "<span class='verse-line'>{}</span></p>", "ja220:2.1": "<p><span class='verse-line'>{}</span>", "ja220:2.2": "<span class='verse-line'>{}</span>", "ja220:2.3": "<span class='verse-line'>{}</span>", "ja220:2.4": "<span class='verse-line'>{}</span>", "ja220:2.5": "<span class='verse-line'>{}</span></p></blockquote>", "ja220:3.1": "<p class='endsutta'>{}</p>", "ja220:3.2": "<p class='endvagga'>{}</p>", "ja220:4.1": "<p class='uddana-intro'>{}</p>", "ja220:5.1": "<blockquote class='uddanagatha'><p><span class='verse-line'>{}</span>", "ja220:5.2": "<span class='verse-line'>{}</span>", "ja220:5.3": "<span class='verse-line'>{}</span>", "ja220:5.4": "<span class='verse-line'>{}</span></p></blockquote></article>"}, "root_text": {"ja220:0.1": "Jātaka ", "ja220:0.2": "Dukanipāta ", "ja220:0.3": "Bīraṇathambhavagga ", "ja220:0.4": "10. Dhammadhajajātaka ", "ja220:1.1": "“Sukhaṁ jīvitarūposi, ", "ja220:1.2": "raṭṭhā vivanamāgato; ", "ja220:1.3": "So ekako rukkhamūle, ", "ja220:1.4": "kapaṇo viya jhāyasi”. ", "ja220:2.1": "“Sukhaṁ jīvitarūposmi, ", "ja220:2.2": "raṭṭhā vivanamāgato; ", "ja220:2.3": "So ekako rukkhamūle, ", "ja220:2.4": "kapaṇo viya jhāyāmi; ", "ja220:2.5": "Sataṁ dhammaṁ anussaran”ti. ", "ja220:3.1": "Dhammadhajajātakaṁ dasamaṁ. ", "ja220:3.2": "Bīraṇathambhavaggo sattamo. ", "ja220:4.1": "Tassuddānaṁ ", "ja220:5.1": "Atha bīraṇathambhavaro ca naṭo, ", "ja220:5.2": "Bharurājavaruttamapuṇṇanadī; ", "ja220:5.3": "Bahubhāṇi aggipavane mūsikā, ", "ja220:5.4": "Sahalambatthano kapaṇena dasāti. "}, "variant_text": {"ja220:0.1": "", "ja220:0.2": "", "ja220:0.3": "", "ja220:0.4": "", "ja220:1.1": "", "ja220:1.2": "", "ja220:1.3": "rukkhamūle → araññasmiṁ (bj, sya1ed, sya2ed, pts-vp-pli1) ", "ja220:1.4": "", "ja220:2.1": "", "ja220:2.2": "", "ja220:2.3": "", "ja220:2.4": "", "ja220:2.5": "", "ja220:3.1": "Dhammadhajajātakaṁ → dhammaddhajajātakaṁ (bj, sya1ed, sya2ed, pts-vp-pli1) ", "ja220:3.2": "Bīraṇathambhavaggo → bīraṇatthambhakavaggo (bj, sya1ed, sya2ed, pts-vp-pli1) ", "ja220:4.1": "", "ja220:5.1": "", "ja220:5.2": "", "ja220:5.3": "", "ja220:5.4": ""}, "reference_text": {"ja220:0.1": "", "ja220:0.2": "", "ja220:0.3": "", "ja220:0.4": "", "ja220:1.1": "ms22J_565, msdiv139, pts-vp-pli2.190", "ja220:1.2": "", "ja220:1.3": "", "ja220:1.4": "", "ja220:2.1": "dr27.82, ms22J_566, msdiv140, pts-vp-pli2.191, sya27.83, vri68.54", "ja220:2.2": "", "ja220:2.3": "", "ja220:2.4": "", "ja220:2.5": "", "ja220:3.1": "ms22J_567", "ja220:3.2": "", "ja220:4.1": "ms22J_568", "ja220:5.1": "csp1ed22.60, csp2ed22.60, ms22J_569, ndp22.56", "ja220:5.2": "", "ja220:5.3": "", "ja220:5.4": ""}, "keys_order": ["ja220:0.1", "ja220:0.2", "ja220:0.3", "ja220:0.4", "ja220:1.1", "ja220:1.2", "ja220:1.3", "ja220:1.4", "ja220:2.1", "ja220:2.2", "ja220:2.3", "ja220:2.4", "ja220:2.5", "ja220:3.1", "ja220:3.2", "ja220:4.1", "ja220:5.1", "ja220:5.2", "ja220:5.3", "ja220:5.4"]}