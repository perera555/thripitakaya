4": "<span class='verse-line'>{}</span></p>", "ja500:21.1": "<p><span class='verse-line'>{}</span>", "ja500:21.2": "<span class='verse-line'>{}</span>", "ja500:21.3": "<span class='verse-line'>{}</span>", "ja500:21.4": "<span class='verse-line'>{}</span>", "ja500:21.5": "<span class='verse-line'>{}</span>", "ja500:21.6": "<span class='verse-line'>{}</span></p></blockquote>", "ja500:22.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja500:0.1": "Jātaka ", "ja500:0.2": "Vīsatinipāta ", "ja500:0.3": "Mātaṅgavagga ", "ja500:0.4": "4. Sirīmantajātaka ", "ja500:1.1": "“Paññāyupetaṁ siriyā vihīnaṁ, ", "ja500:1.2": "Yasassinaṁ vāpi apetapaññaṁ; ", "ja500:1.3": "Pucchāmi taṁ senaka etamatthaṁ, ", "ja500:1.4": "Kamettha seyyo kusalā vadanti”. ", "ja500:2.1": "“Dhīrā ca bālā ca have janinda, ", "ja500:2.2": "Sippūpapannā ca asippino ca; ", "ja500:2.3": "Sujātimantopi ajātimassa, ", "ja500:2.4": "Yasassino pesakarā bhavanti; ", "ja500:2.5": "Etampi disvāna ahaṁ vadāmi, ", "ja500:2.6": "Pañño nihīno sirīmāva seyyo”. ", "ja500:3.1": "“Tuvampi pucchāmi anomapañña, ", "ja500:3.2": "Mahosadha kevaladhammadassi; ", "ja500:3.3": "Bālaṁ yasassiṁ paṇḍitaṁ appabhogaṁ, ", "ja500:3.4": "Kamettha seyyo kusalā vadanti”. ", "ja500:4.1": "“Pāpāni kammāni karoti bālo, ", "ja500:4.2": "Idhameva seyyo iti maññamāno; ", "ja500:4.3": "Idhalokadassī paralokamadassī, ", "ja500:4.4": "Ubhayattha bālo kalimaggahesi; ", "ja500:4.5": "Etampi disvāna ahaṁ vadāmi, ", "ja500:4.6": "Paññova seyyo na yasassi bālo”. ", "ja500:5.1": "“Na sippametaṁ vidadhāti bhogaṁ, ", "ja500:5.2": "Na bandhuvā na sarīravaṇṇo yo; ", "ja500:5.3": "Passeḷamūgaṁ sukhamedhamānaṁ, ", "ja500:5.4": "Sirī hi naṁ bhajate goravindaṁ; ", "ja500:5.5": "Etampi disvāna ahaṁ vadāmi, ", "ja500:5.6": "Pañño nihīno sirīmāva seyyo”. ", "ja500:6.1": "“Laddhā sukhaṁ majjati appapañño, ", "ja500:6.2": "Dukkhena phuṭṭhopi pamohameti; ", "ja500:6.3": "Āgantunā dukkhasukhena phuṭṭho, ", "ja500:6.4": "Pavedhati vāricarova ghamme; ", "ja500:6.5": "Etampi disvāna ahaṁ vadāmi, ", "ja500:6.6": "Paññova seyyo na yasassi bālo”. ", "ja500:7.1": "“Dumaṁ yathā sāduphalaṁ araññe, ", "ja500:7.2": "Samantato samabhisaranti pakkhī; ", "ja500:7.3": "Evampi aḍḍhaṁ sadhanaṁ sabhogaṁ, ", "ja500:7.4": "Bahujjano bhajati atthahetu; ", "ja500:7.5": "Etampi disvāna ahaṁ vadāmi, ", "ja500:7.6": "Pañño nihīno sirīmāva seyyo”. ", "ja500:8.1": "“Na sādhu balavā bālo, ", "ja500:8.2": "Sāhasā vindate dhanaṁ; ", "ja500:8.3": "Kandantametaṁ dummedhaṁ, ", "ja500:8.4": "Kaḍḍhanti nirayaṁ bhusaṁ; ", "ja500:8.5": "Etampi disvāna ahaṁ vadāmi, ", "ja500:8.6": "Paññova seyyo na yasassi bālo”. ", "ja500:9.1": "“Yā kāci najjo gaṅgamabhissavanti, ", "ja500:9.2": "Sabbāva tā nāmagottaṁ jahanti; ", "ja500:9.3": "Gaṅgā samuddaṁ paṭipajjamānā, ", "ja500:9.4": "Na khāyate iddhiṁ paññopi loke; ", "ja500:9.5": "Etampi disvāna ahaṁ vadāmi, ", "ja500:9.6": "Pañño nihīno sirīmāva seyyo”. ", "ja500:10.1": "“Yametamakkhā udadhiṁ mahantaṁ, ", "ja500:10.2": "Savanti najjo sabbakālamasaṅkhyaṁ; ", "ja500:10.3": "So sāgaro niccamuḷāravego, ", "ja500:10.4": "Velaṁ na acceti mahāsamuddo. ", "ja500:11.1": "Evampi bālassa pajappitāni, ", "ja500:11.2": "Paññaṁ na acceti sirī kadāci; ", "ja500:11.3": "Etampi disvāna ahaṁ vadāmi, ", "ja500:11.4": "Paññova seyyo na yasassi bālo”. ", "ja500:12.1": "“Asaññato cepi paresamatthaṁ, ", "ja500:12.2": "Bhaṇāti sandhānagato yasassī; ", "ja500:12.3": "Tasseva taṁ rūhati ñātimajjhe, ", "ja500:12.4": "Sirī hi naṁ kārayate na paññā; ", "ja500:12.5": "Etampi disvāna ahaṁ vadāmi, ", "ja500:12.6": "Pañño nihīno sirīmāva seyyo”. ", "ja500:13.1": "“Parassa vā attano vāpi hetu, ", "ja500:13.2": "Bālo musā bhāsati appapañño; ", "ja500:13.3": "So nindito hoti sabhāya majjhe, ", "ja500:13.4": "Pacchāpi so duggatigāmī hoti; ", "ja500:13.5": "Etampi disvāna ahaṁ vadāmi, ", "ja500:13.6": "Paññova seyyo na yasassi bālo”. ", "ja500:14.1": "“Atthampi ce bhāsati bhūripañño, ", "ja500:14.2": "Anāḷhiyo appadhano daliddo; ", "ja500:14.3": "Na tassa taṁ rūhati ñātimajjhe, ", "ja500:14.4": "Sirī ca paññāṇavato na hoti; ", "ja500:14.5": "Etampi disvāna ahaṁ vadāmi, ", "ja500:14.6": "Pañño nihīno sirīmāva seyyo”. ", "ja500:15.1": "“Parassa vā attano vāpi hetu, ", "ja500:15.2": "Na bhāsati alikaṁ bhūripañño; ", "ja500:15.3": "So pūjito hoti sabhāya majjhe, ", "ja500:15.4": "Pacchāpi so suggatigāmī hoti; ", "ja500:15.5": "Etampi disvāna ahaṁ vadāmi, ", "ja500:15.6": "Paññova seyyo na yasassi bālo”. ", "ja500:16.1": "“Hatthī gavassā maṇikuṇḍalā ca, ", "ja500:16.2": "Thiyo ca iddhesu kulesu jātā; ", "ja500:16.3": "Sabbāva tā upabhogā bhavanti, ", "ja500:16.4": "Iddhassa posassa aniddhimanto; ", "ja500:16.5": "Etampi disvāna ahaṁ vadāmi, ", "ja500:16.6": "Pañño nihīno sirīmāva seyyo”. ", "ja500:17.1": "“Asaṁvihitakammantaṁ, ", "ja500:17.2": "Bālaṁ dummedhamantinaṁ; ", "ja500:17.3": "Sirī jahati dummedhaṁ, ", "ja500:17.4": "Jiṇṇaṁva urago tacaṁ; ", "ja500:17.5": "Etampi disvāna ahaṁ vadāmi, ", "ja500:17.6": "Paññova seyyo na yasassi bālo”. ", "ja500:18.1": "“Pañca paṇḍitā mayaṁ bhaddante, ", "ja500:18.2": "Sabbe pañjalikā upaṭṭhitā; ", "ja500:18.3": "Tvaṁ no abhibhuyya issarosi, ", "ja500:18.4": "Sakkova bhūtapati devarājā; ", "ja500:18.5": "Etampi disvāna ahaṁ vadāmi, ", "ja500:18.6": "Pañño nihīno sirīmāva seyyo”. ", "ja500:19.1": "“Dāsova paññassa yasassi bālo, ", "ja500:19.2": "Atthesu jātesu tathāvidhesu; ", "ja500:19.3": "Yaṁ paṇḍito nipuṇaṁ saṁvidheti, ", "ja500:19.4": "Sammohamāpajjati tattha bālo; ", "ja500:19.5": "Etampi disvāna ahaṁ vadāmi, ", "ja500:19.6": "Paññova seyyo na yasassi bālo. ", "ja500:20.1": "Addhā hi paññāva sataṁ pasatthā, ", "ja500:20.2": "Kantā sirī bhogaratā manussā; ", "ja500:20.3": "Ñāṇañca buddhānamatulyarūpaṁ, ", "ja500:20.4": "Paññaṁ na acceti sirī kadāci”. ", "ja500:21.1": "“Yaṁ taṁ apucchimha akittayī no, ", "ja500:21.2": "Mahosadha kevaladhammadassī; ", "ja500:21.3": "Gavaṁ sahassaṁ usabhañca nāgaṁ, ", "ja500:21.4": "Ājaññayutte ca rathe dasa ime; ", "ja500:21.5": "Pañhassa veyyākaraṇena tuṭṭho, ", "ja500:21.6": "Dadāmi te gāmavarāni soḷasā”ti. ", "ja500:22.1": "Sirīmantajātakaṁ catutthaṁ. "}, "variant_text": {"ja500:0.1": "", "ja500:0.2": "", "ja500:0.3": "", "ja500:0.4": "", "ja500:1.1": "", "ja500:1.2": "", "ja500:1.3": "", "ja500:1.4": "", "ja500:2.1": "", "ja500:2.2": "", "ja500:2.3": "", "ja500:2.4": "pesakarā → pessakarā (bj, pts-vp-pli1) ", "ja500:2.5": "", "ja500:2.6": "sirīmāva → sirimāva (bj, sya1ed, sya2ed, pts-vp-pli1) ", "ja500:3.1": "", "ja500:3.2": "", "ja500:3.3": "", "ja500:3.4": "", "ja500:4.1": "kammāni karoti bālo → karonti bālā (sya1ed, sya2ed, mr) ", "ja500:4.2": "Idhameva → idameva (bj, sya1ed, sya2ed, Ma-aka); imameva (mr) | maññamāno → maññamānā (sya1ed, sya2ed, mr) ", "ja500:4.3": "", "ja500:4.4": "", "ja500:4.5": "", "ja500:4.6": "", "ja500:5.1": "", "ja500:5.2": "Na bandhuvā → na bandhavā (bj, sya1ed, sya2ed, mr) | na sarīravaṇṇo yo → na sarīrāvakāso (bj, sya1ed, sya2ed, pts-vp-pli1) ", "ja500:5.3": "", "ja500:5.4": "goravindaṁ → gorimandaṁ (bj, pts-vp-pli1) | hi naṁ → sirihīnaṁ (bj, mr); sirīhīnaṁ (sya1ed, sya2ed, pts-vp-pli1) | na paññā → na paññaṁ (sya1ed, sya2ed, mr) ", "ja500:5.5": "", "ja500:5.6": "", "ja500:6.1": "", "ja500:6.2": "", "ja500:6.3": "", "ja500:6.4": "", "ja500:6.5": "", "ja500:6.6": "", "ja500:7.1": "", "ja500:7.2": "samabhisaranti → sambhi caranti (bj); samabhicaranti (pts-vp-pli1) ", "ja500:7.3": "", "ja500:7.4": "", "ja500:7.5": "", "ja500:7.6": "", "ja500:8.1": "", "ja500:8.2": "", "ja500:8.3": "", "ja500:8.4": "", "ja500:8.5": "", "ja500:8.6": "", "ja500:9.1": "", "ja500:9.2": "", "ja500:9.3": "", "ja500:9.4": "iddhiṁ paññopi loke → iddhiparo hi loke (bj, sya1ed, sya2ed); iddhiparo hi loko (pts-vp-pli1) ", "ja500:9.5": "", "ja500:9.6": "", "ja500:10.1": "", "ja500:10.2": "", "ja500:10.3": "", "ja500:10.4": "", "ja500:11.1": "", "ja500:11.2": "", "ja500:11.3": "", "ja500:11.4": "", "ja500:12.1": "", "ja500:12.2": "sandhānagato → santhānagato (bj); saṇṭhānagato (sya1ed, sya2ed, pts-vp-pli