{"html_text": {"ja337:0.1": "<article id='ja337'><header><ul><li class='division'>{}</li>", "ja337:0.2": "<li>{}</li>", "ja337:0.3": "<li>{}</li></ul>", "ja337:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja337:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja337:1.2": "<span class='verse-line'>{}</span>", "ja337:1.3": "<span class='verse-line'>{}</span>", "ja337:1.4": "<span class='verse-line'>{}</span></p>", "ja337:2.1": "<p><span class='verse-line'>{}</span>", "ja337:2.2": "<span class='verse-line'>{}</span>", "ja337:2.3": "<span class='verse-line'>{}</span>", "ja337:2.4": "<span class='verse-line'>{}</span></p>", "ja337:3.1": "<p><span class='verse-line'>{}</span>", "ja337:3.2": "<span class='verse-line'>{}</span>", "ja337:3.3": "<span class='verse-line'>{}</span>", "ja337:3.4": "<span class='verse-line'>{}</span></p>", "ja337:4.1": "<p><span class='verse-line'>{}</span>", "ja337:4.2": "<span class='verse-line'>{}</span>", "ja337:4.3": "<span class='verse-line'>{}</span>", "ja337:4.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja337:5.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja337:0.1": "Jātaka ", "ja337:0.2": "Catukkanipāta ", "ja337:0.3": "Kokilavagga ", "ja337:0.4": "7. Pīṭhajātaka ", "ja337:1.1": "“Na te pīṭhamadāyimhā, ", "ja337:1.2": "na pānaṁ napi bhojanaṁ; ", "ja337:1.3": "Brahmacāri khamassu me, ", "ja337:1.4": "etaṁ passāmi accayaṁ”. ", "ja337:2.1": "“Nevābhisajjāmi na cāpi kuppe, ", "ja337:2.2": "Na cāpi me appiyamāsi kiñci; ", "ja337:2.3": "Athopi me āsi manovitakko, ", "ja337:2.4": "Etādiso nūna kulassa dhammo”. ", "ja337:3.1": "“Esasmākaṁ kule dhammo, ", "ja337:3.2": "pitupitāmaho sadā; ", "ja337:3.3": "Āsanaṁ udakaṁ pajjaṁ, ", "ja337:3.4": "sabbetaṁ nipadāmase. ", "ja337:4.1": "Esasmākaṁ kule dhammo, ", "ja337:4.2": "pitupitāmaho sadā; ", "ja337:4.3": "Sakkaccaṁ upatiṭṭhāma, ", "ja337:4.4": "uttamaṁ viya ñātakan”ti. ", "ja337:5.1": "Pīṭhajātakaṁ sattamaṁ. "}, "variant_text": {"ja337