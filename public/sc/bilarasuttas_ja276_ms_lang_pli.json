{"html_text": {"ja276:0.1": "<article id='ja276'><header><ul><li class='division'>{}</li>", "ja276:0.2": "<li>{}</li>", "ja276:0.3": "<li>{}</li></ul>", "ja276:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja276:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja276:1.2": "<span class='verse-line'>{}</span>", "ja276:1.3": "<span class='verse-line'>{}</span>", "ja276:1.4": "<span class='verse-line'>{}</span></p>", "ja276:2.1": "<p><span class='verse-line'>{}</span>", "ja276:2.2": "<span class='verse-line'>{}</span>", "ja276:2.3": "<span class='verse-line'>{}</span>", "ja276:2.4": "<span class='verse-line'>{}</span></p>", "ja276:3.1": "<p><span class='verse-line'>{}</span>", "ja276:3.2": "<span class='verse-line'>{}</span>", "ja276:3.3": "<span class='verse-line'>{}</span>", "ja276:3.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja276:4.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja276:0.1": "Jātaka ", "ja276:0.2": "Tikanipāta ", "ja276:0.3": "Udapānavagga ", "ja276:0.4": "6. Garudhammajātaka ", "ja276:1.1": "“Tava saddhañca sīlañca, ", "ja276:1.2": "viditvāna janādhipa; ", "ja276:1.3": "Vaṇṇaṁ añjanavaṇṇena, ", "ja276:1.4": "kāliṅgasmiṁ nimimhase”. ", "ja276:2.1": "“Annabhaccā cabhaccā ca, ", "ja276:2.2": "yodha uddissa gacchati; ", "ja276:2.3": "Sabbe te appaṭikkhippā, ", "ja276:2.4": "pubbācariyavaco idaṁ. ", "ja276:3.1": "Dadāmi vo brāhmaṇā nāgametaṁ, ", "ja276:3.2": "Rājārahaṁ rājabhoggaṁ yasassinaṁ; ", "ja276:3.3": "Alaṅkataṁ hemajālābhichannaṁ, ", "ja276:3.4": "Sasārathiṁ gacchatha yena kāman”ti. ", "ja276:4.1": "Garudhammajātakaṁ chaṭṭhaṁ. "}, "variant_text": {"ja276:0.1": "", "ja276:0.2": "", "ja276:0.3": "", "ja276:0.4": "", "ja276:1.1": "", "ja276:1.2": "", "ja276:1.3": "", "ja276:1.4": "nimimhase → vinimhase (sya1ed, sya2ed); vanimhase (mr) ", "ja276:2.1": "", "ja276:2.2": "", "ja276:2.3": "", "ja276:2.4": "", "ja276:3.1": "", "ja276:3.2": "", "ja276:3.3": "", "ja276:3.4": "", "ja276:4.1": "Garudhammajātakaṁ → kurudhammajātakaṁ (bj, sya1ed, sya2ed, pts-vp-pli1) "}, "reference_text": {"ja276:0.1": "", "ja276:0.2": "", "ja276:0.3": "", "ja276:0.4": "", "ja276:1.1": "ms22J_774, msdiv76, pts-vp-pli2.369", "ja276:1.2": "", "ja276:1.3": "", "ja276:1.4": "", "ja276:2.1": "ms22J_775, msdiv77, pts-vp-pli2.37, sya27.113", "ja276:2.2": "", "ja276:2.3": "", "ja276:2.4": "", "ja276:3.1": "bj30.142, ms22J_776, msdiv78, vri68.72", "ja276:3.2": "", "ja276:3.3": "", "ja276:3.4": "", "ja276:4.1": "ms22J_777"}, "keys_order": ["ja276:0.1", "ja276:0.2", "ja276:0.3", "ja276:0.4", "ja276:1.1", "ja276:1.2", "ja276:1.3", "ja276:1.4", "ja276:2.1", "ja276:2.2", "ja276:2.3", "ja276:2.4", "ja276:3.1", "ja276:3.2", "ja276:3.3", "ja276:3.4", "ja276:4.1"]}