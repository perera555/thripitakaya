{"html_text": {"ja318:0.1": "<article id='ja318'><header><ul><li class='division'>{}</li>", "ja318:0.2": "<li>{}</li>", "ja318:0.3": "<li>{}</li></ul>", "ja318:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja318:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja318:1.2": "<span class='verse-line'>{}</span>", "ja318:1.3": "<span class='verse-line'>{}</span>", "ja318:1.4": "<span class='verse-line'>{}</span></p>", "ja318:2.1": "<p><span class='verse-line'>{}</span>", "ja318:2.2": "<span class='verse-line'>{}</span>", "ja318:2.3": "<span class='verse-line'>{}</span>", "ja318:2.4": "<span class='verse-line'>{}</span>", "ja318:2.5": "<span class='verse-line'>{}</span>", "ja318:2.6": "<span class='verse-line'>{}</span></p>", "ja318:3.1": "<p><span class='verse-line'>{}</span>", "ja318:3.2": "<span class='verse-line'>{}</span>", "ja318:3.3": "<span class='verse-line'>{}</span>", "ja318:3.4": "<span class='verse-line'>{}</span></p>", "ja318:4.1": "<p><span class='verse-line'>{}</span>", "ja318:4.2": "<span class='verse-line'>{}</span>", "ja318:4.3": "<span class='verse-line'>{}</span>", "ja318:4.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja318:5.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja318:0.1": "Jātaka ", "ja318:0.2": "Catukkanipāta ", "ja318:0.3": "Pucimandavagga ", "ja318:0.4": "8. Kaṇaverajātaka ", "ja318:1.1": "“Yaṁ taṁ vasantasamaye, ", "ja318:1.2": "kaṇaveresu bhāṇusu; ", "ja318:1.3": "Sāmaṁ bāhāya pīḷesi, ", "ja318:1.4": "sā taṁ ārogyamabravi”. ", "ja318:2.1": "“Ambho na kira saddheyyaṁ, ", "ja318:2.2": "yaṁ vāto pabbataṁ vahe; ", "ja318:2.3": "Pabbatañce vahe vāto, ", "ja318:2.4": "sabbampi pathaviṁ vahe; ", "ja318:2.5": "Yattha sāmā kālakatā, ", "ja318:2.6": "sā maṁ ārogyamabravi”. ", "ja318:3.1": "“Na ceva sā kālakatā, ", "ja318:3.2": "na ca sā aññamicchati; ", "ja318:3.3": "Ekabhattikinī sāmā, ", "ja318:3.4": "tameva abhikaṅkhati”. ", "ja318:4.1": "“Asanthutaṁ maṁ cirasanthutena, ", "ja318:4.2": "Nimīni sāmā adhuvaṁ dhuvena; ", "ja318:4.3": "Mayāpi sāmā nimineyya aññaṁ, ", "ja318:4.4": "Ito ahaṁ dūrataraṁ gamissan”ti. ", "ja318:5.1": "Kaṇaverajātakaṁ aṭṭhamaṁ. "}, "variant_text": {"ja318:0.1": "", "ja318:0.2": "", "ja318:0.3": "", "ja318:0.4": "", "ja318:1.1": "", "ja318:1.2": "", "ja318:1.3": "", "ja318:1.4": "", "ja318:2.1": "", "ja318:2.2": "", "ja318:2.3": "", "ja318:2.4": "", "ja318:2.5": "kālakatā → kālaṅkatā (mr) ", "ja318:2.6": "", "ja318:3.1": "", "ja318:3.2": "", "ja318:3.3": "Ekabhattikinī → ekabhattā kira (bj, sya1ed, sya2ed); ekabhattakinī (pts-vp-pli1) ", "ja318:3.4": "", "ja318:4.1": "Asanthutaṁ maṁ cirasanthutena → asandhataṁ maṁ cirasandhatena (mr) ", "ja318:4.2": "", "ja318:4.3": "", "ja318:4.4": "", "ja318:5.1": ""}, "reference_text": {"ja318:0.1": "", "ja318:0.2": "", "ja318:0.3": "", "ja318:0.4": "", "ja318:1.1": "csp1ed22.102, csp2ed22.102, dr27.140, ms22J_970, msdiv69, pts-vp-pli3.62, sya27.140", "ja318:1.2": "", "ja318:1.3": "", "ja318:1.4": "", "ja318:2.1": "ms22J_971, msdiv70", "ja318:2.2": "", "ja318:2.3": "", "ja318:2.4": "", "ja318:2.5": "", "ja318:2.6": "", "ja318:3.1": "ms22J_972, msdiv71, pts-vp-pli3.63", "ja318:3.2": "", "ja318:3.3": "", "ja318:3.4": "", "ja318:4.1": "bj30.178, ms22J_973, msdiv72", "ja318:4.2": "", "ja318:4.3": "", "ja318:4.4": "", "ja318:5.1": "ms22J_974"}, "keys_order": ["ja318:0.1", "ja318:0.2", "ja318:0.3", "ja318:0.4", "ja318:1.1", "ja318:1.2", "ja318:1.3", "ja318:1.4", "ja318:2.1", "ja318:2.2", "ja318:2.3", "ja318:2.4", "ja318:2.5", "ja318:2.6", "ja318:3.1", "ja318:3.2", "ja318:3.3", "ja318:3.4", "ja318:4.1", "ja318:4.2", "ja318:4.3", "ja318:4.4", "ja318:5.1"]}