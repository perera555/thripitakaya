{"html_text": {"ja205:0.1": "<article id='ja205'><header><ul><li class='division'>{}</li>", "ja205:0.2": "<li>{}</li>", "ja205:0.3": "<li>{}</li></ul>", "ja205:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja205:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja205:1.2": "<span class='verse-line'>{}</span>", "ja205:1.3": "<span class='verse-line'>{}</span>", "ja205:1.4": "<span class='verse-line'>{}</span>", "ja205:1.5": "<span class='verse-line'>{}</span>", "ja205:1.6": "<span class='verse-line'>{}</span></p>", "ja205:2.1": "<p><span class='verse-line'>{}</span>", "ja205:2.2": "<span class='verse-line'>{}</span>", "ja205:2.3": "<span class='verse-line'>{}</span>", "ja205:2.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja205:3.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja205:0.1": "Jātaka ", "ja205:0.2": "Dukanipāta ", "ja205:0.3": "Nataṁdaḷhavagga ", "ja205:0.4": "5. Gaṅgeyyajātaka ", "ja205:1.1": "“Sobhati maccho gaṅgeyyo, ", "ja205:1.2": "atho sobhati yāmuno; ", "ja205:1.3": "Catuppadoyaṁ puriso, ", "ja205:1.4": "nigrodhaparimaṇḍalo; ", "ja205:1.5": "Īsakāyatagīvo ca, ", "ja205:1.6": "sabbeva atirocati”. ", "ja205:2.1": "“Yaṁ pucchito na taṁ akkhāsi, ", "ja205:2.2": "Aññaṁ akkhāsi pucchito; ", "ja205:2.3": "Attappasaṁsako poso, ", "ja205:2.4": "Nāyaṁ asmāka ruccatī”ti. ", "ja205:3.1": "Gaṅgeyyajātakaṁ pañcamaṁ. "}, "variant_text": {"ja205:0.1": "", "ja205:0.2": "", "ja205:0.3": "", "ja205:0.4": "", "ja205:1.1": "", "ja205:1.2": "atho sobhati yāmuno → atho sobhanti yāmunā (sya1ed, sya2ed, pts-vp-pli1) ", "ja205:1.3": "", "ja205:1.4": "", "ja205:1.5": "Īsakāyatagīvo → īsamāyata (mr) ", "ja205:1.6": "", "ja205:2.1": "akkhāsi → akkhā (bj, sya1ed, sya2ed, pts-vp-pli1) ", "ja205:2.2": "akkhāsi → akkhāti (bj, sya1ed, sya2ed, pts-vp-pli1) ", "ja205:2.3": "", "ja205:2.4": "", "ja205:3.1": ""}, "reference_text": {"ja205:0.1": "", "ja205:0.2": "", "ja205:0.3": "", "ja205:0.4": "", "ja205:1.1": "ms22J_518, msdiv109, pts-vp-pli2.152, sya27.76", "ja205:1.2": "", "ja205:1.3": "", "ja205:1.4": "", "ja205:1.5": "", "ja205:1.6": "", "ja205:2.1": "csp1ed22.55, csp2ed22.55, ms22J_519, msdiv110", "ja205:2.2": "", "ja205:2.3": "", "ja205:2.4": "", "ja205:3.1": "ms22J_520"}, "keys_order": ["ja205:0.1", "ja205:0.2", "ja205:0.3", "ja205:0.4", "ja205:1.1", "ja205:1.2", "ja205:1.3", "ja205:1.4", "ja205:1.5", "ja205:1.6", "ja205:2.1", "ja205:2.2", "ja205:2.3", "ja205:2.4", "ja205:3.1"]}