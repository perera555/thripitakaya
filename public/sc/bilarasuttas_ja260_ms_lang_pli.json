{"html_text": {"ja260:0.1": "<article id='ja260'><header><ul><li class='division'>{}</li>", "ja260:0.2": "<li>{}</li>", "ja260:0.3": "<li>{}</li></ul>", "ja260:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja260:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja260:1.2": "<span class='verse-line'>{}</span>", "ja260:1.3": "<span class='verse-line'>{}</span>", "ja260:1.4": "<span class='verse-line'>{}</span></p>", "ja260:2.1": "<p><span class='verse-line'>{}</span>", "ja260:2.2": "<span class='verse-line'>{}</span>", "ja260:2.3": "<span class='verse-line'>{}</span>", "ja260:2.4": "<span class='verse-line'>{}</span></p>", "ja260:3.1": "<p><span class='verse-line'>{}</span>", "ja260:3.2": "<span class='verse-line'>{}</span>", "ja260:3.3": "<span class='verse-line'>{}</span>", "ja260:3.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja260:4.1": "<p class='endsutta'>{}</p>", "ja260:4.2": "<p class='endvagga'>{}</p>", "ja260:5.1": "<p class='uddana-intro'>{}</p>", "ja260:6.1": "<blockquote class='uddanagatha'><p><span class='verse-line'>{}</span>", "ja260:6.2": "<span class='verse-line'>{}</span>", "ja260:6.3": "<span class='verse-line'>{}</span>", "ja260:6.4": "<span class='verse-line'>{}</span></p></blockquote></article>"}, "root_text": {"ja260:0.1": "Jātaka ", "ja260:0.2": "Tikanipāta ", "ja260:0.3": "Saṅkappavagga ", "ja260:0.4": "10. Dūtajātaka ", "ja260:1.1": "“Yassatthā dūramāyanti, ", "ja260:1.2": "amittamapi yācituṁ; ", "ja260:1.3": "Tassūdarassahaṁ dūto, ", "ja260:1.4": "mā me kujjha rathesabha”. ", "ja260:2.1": "“Yassa divā ca ratto ca, ", "ja260:2.2": "vasamāyanti māṇavā; ", "ja260:2.3": "Tassūdarassahaṁ dūto, ", "ja260:2.4": "mā me kujjha rathesabha. ", "ja260:3.1": "Dadāmi te brāhmaṇa rohiṇīnaṁ, ", "ja260:3.2": "Gavaṁ sahassaṁ saha puṅgavena; ", "ja260:3.3": "Dūto hi dūtassa kathaṁ na dajjaṁ, ", "ja260:3.4": "Mayampi tasseva bhavāma dūtā”ti. ", "ja260:4.1": "Dūtajātakaṁ dasamaṁ. ", "ja260:4.2": "Saṅkappavaggo paṭhamo. ", "ja260:5.1": "Tassuddānaṁ ", "ja260:6.1": "Usukāravaro tilamuṭṭhi maṇi, ", "ja260:6.2": "Hayarāja vihaṅgama āsiviso; ", "ja260:6.3": "Janasandha kahāpaṇavassa puna, ", "ja260:6.4": "Tiriṭaṁ puna dūtavarena dasāti. "}, "variant_text": {"ja260:0.1": "", "ja260:0.2": "", "ja260:0.3": "", "ja260:0.4": "", "ja260:1.1": "", "ja260:1.2": "", "ja260:1.3": "", "ja260:1.4": "kujjha → kujjhi (bj, pts-vp-pli1) ", "ja260:2.1": "", "ja260:2.2": "", "ja260:2.3": "", "ja260:2.4": "kujjha → kujjhi (bj, pts-vp-pli1) ", "ja260:3.1": "", "ja260:3.2": "", "ja260:3.3": "", "ja260:3.4": "", "ja260:4.1": "", "ja260:4.2": "", "ja260:5.1": "", "ja260:6.1": "", "ja260:6.2": "", "ja260:6.3": "", "ja260:6.4": ""}, "reference_text": {"ja260:0.1": "", "ja260:0.2": "", "ja260:0.3": "", "ja260:0.4": "", "ja260:1.1": "ms22J_706, msdiv28, pts-vp-pli2.320, sya27.104", "ja260:1.2": "", "ja260:1.3": "", "ja260:1.4": "", "ja260:2.1": "ms22J_707, msdiv29", "ja260:2.2": "", "ja260:2.3": "", "ja260:2.4": "", "ja260:3.1": "csp1ed22.75, csp2ed22.75, dr27.103, ms22J_708, msdiv30", "ja260:3.2": "", "ja260:3.3": "", "ja260:3.4": "", "ja260:4.1": "ms22J_709", "ja260:4.2": "", "ja260:5.1": "ms22J_710", "ja260:6.1": "ms22J_711, ndp22.70", "ja260:6.2": "", "ja260:6.3": "", "ja260:6.4": ""}, "keys_order": ["ja260:0.1", "ja260:0.2", "ja260:0.3", "ja260:0.4", "ja260:1.1", "ja260:1.2", "ja260:1.3", "ja260:1.4", "ja260:2.1", "ja260:2.2", "ja260:2.3", "ja260:2.4", "ja260:3.1", "ja260:3.2", "ja260:3.3", "ja260:3.4", "ja260:4.1", "ja260:4.2", "ja260:5.1", "ja260:6.1", "ja260:6.2", "ja260:6.3", "ja260:6.4"]}