[{"acronym": "Ja 156", "alt_acronym": null, "volpages": "PTS 2.22", "alt_volpages": null, "uid": "ja156", "blurb": "“Prince Winheart once upon a time”—This story the Master told at Jetavana, about a fainthearted Brother. The circumstances will be set forth in the Samvara Birth in the eleventh Book. When the Master asked this Brother if he really were fainthearted, as was said, he replied, “Yes, Blessed One.” To which the Master said, “What, Brother! in former days did you not gain supremacy over the kingdom of Benares, twelve leagues either way, and give it to a baby boy, like a lump of flesh and nothing more, and all this just by perseverance! And now that you have embraced this great salvation, are you to lose heart and faint?” And he told a story of olden days.", "difficulty": null, "original_title": "Alīnacittajātaka", "root_lang": "pli", "root_lang_name": "Pāli", "type": "leaf", "translated_title": "Alinacitta Jātaka", "translations": [{"lang": "pli", "lang_name": "Pāli", "is_root": true, "author": "Mahāsaṅgīti Tipiṭaka Buddhavasse 2500", "author_short": "ms", "author_uid": "ms", "publication_date": null, "id": "ja156_root-pli-ms", "segmented": true, "title": null, "volpage": null, "has_comment": false}, {"lang": "de", "lang_name": "Deutsch", "is_root": false, "author": "Dr. Julius Dutoit", "author_short": "Dutoit", "author_uid": "dutoit", "publication_date": "2007", "id": "de_ja156_dutoit", "segmented": false, "volpage": null, "has_comment": false}, {"author": "W.H.D. Rouse", "author_short": "Rouse", "author_uid": "rouse", "has_comment": false, "id": "en_ja156_rouse", "is_root": false, "lang": "en", "lang_name": "English", "publication_date": "1895", "segmented": false, "volpage": null, "title": "Alinacitta Jātaka"}, {"lang": "jpn", "lang_name": "日本語", "is_root": false, "author": "関西パーリ語実習会", "author_short": "関西パーリ語実習会", "author_uid": "kansai", "publication_date": "2023", "id": "jpn_ja156_kansai", "segmented": false, "volpage": null, "has_comment": false}, {"l