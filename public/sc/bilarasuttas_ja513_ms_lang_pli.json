 "ja513:27.2": "<span class='verse-line'>{}</span>", "ja513:27.3": "<span class='verse-line'>{}</span>", "ja513:27.4": "<span class='verse-line'>{}</span></p>", "ja513:28.1": "<p><span class='verse-line'>{}</span>", "ja513:28.2": "<span class='verse-line'>{}</span>", "ja513:28.3": "<span class='verse-line'>{}</span>", "ja513:28.4": "<span class='verse-line'>{}</span></p>", "ja513:29.1": "<p><span class='verse-line'>{}</span>", "ja513:29.2": "<span class='verse-line'>{}</span>", "ja513:29.3": "<span class='verse-line'>{}</span>", "ja513:29.4": "<span class='verse-line'>{}</span></p>", "ja513:30.1": "<p><span class='verse-line'>{}</span>", "ja513:30.2": "<span class='verse-line'>{}</span>", "ja513:30.3": "<span class='verse-line'>{}</span>", "ja513:30.4": "<span class='verse-line'>{}</span></p>", "ja513:31.1": "<p><span class='verse-line'>{}</span>", "ja513:31.2": "<span class='verse-line'>{}</span>", "ja513:31.3": "<span class='verse-line'>{}</span>", "ja513:31.4": "<span class='verse-line'>{}</span>", "ja513:31.5": "<span class='verse-line'>{}</span>", "ja513:31.6": "<span class='verse-line'>{}</span></p>", "ja513:32.1": "<p><span class='verse-line'>{}</span>", "ja513:32.2": "<span class='verse-line'>{}</span>", "ja513:32.3": "<span class='verse-line'>{}</span>", "ja513:32.4": "<span class='verse-line'>{}</span></p>", "ja513:33.1": "<p><span class='verse-line'>{}</span>", "ja513:33.2": "<span class='verse-line'>{}</span>", "ja513:33.3": "<span class='verse-line'>{}</span>", "ja513:33.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja513:34.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja513:0.1": "Jātaka ", "ja513:0.2": "Tiṁsanipāta ", "ja513:0.3": "Kiṁchandavagga ", "ja513:0.4": "3. Jayaddisajātaka ", "ja513:1.1": "“Cirassaṁ vata me udapādi ajja, ", "ja513:1.2": "Bhakkho mahā sattamibhattakāle; ", "ja513:1.3": "Kutosi ko vāsi tadiṅgha brūhi, ", "ja513:1.4": "Ācikkha jātiṁ vidito yathāsi”. ", "ja513:2.1": "“Pañcālarājā migavaṁ paviṭṭho, ", "ja513:2.2": "Jayaddiso nāma yadissuto te; ", "ja513:2.3": "Carāmi kacchāni vanāni cāhaṁ, ", "ja513:2.4": "Pasadaṁ imaṁ khāda mamajja muñca”. ", "ja513:3.1": "“Seneva tvaṁ paṇasi sassamāno, ", "ja513:3.2": "Mamesa bhakkho pasado yaṁ vadesi; ", "ja513:3.3": "Taṁ khādiyāna pasadaṁ jighaññaṁ, ", "ja513:3.4": "Khādissaṁ pacchā na vilāpakālo”. ", "ja513:4.1": "“Na catthi mokkho mama nikkayena, ", "ja513:4.2": "Gantvāna paccāgamanāya paṇhe; ", "ja513:4.3": "Taṁ saṅgaraṁ brāhmaṇassappadāya, ", "ja513:4.4": "Saccānurakkhī punarāvajissaṁ”. ", "ja513:5.1": "“Kiṁ kammajātaṁ anutappate tvaṁ, ", "ja513:5.2": "Pattaṁ samīpaṁ maraṇassa rāja; ", "ja513:5.3": "Ācikkha me taṁ api sakkuṇemu, ", "ja513:5.4": "Anujānituṁ āgamanāya paṇhe”. ", "ja513:6.1": "“Katā mayā brāhmaṇassa dhanāsā, ", "ja513:6.2": "Taṁ saṅgaraṁ paṭimukkaṁ na muttaṁ; ", "ja513:6.3": "Taṁ saṅgaraṁ brāhmaṇassappadāya, ", "ja513:6.4": "Saccānurakkhī punarāvajissaṁ”. ", "ja513:7.1": "“Yā te katā brāhmaṇassa dhanāsā, ", "ja513:7.2": "Taṁ saṅgaraṁ paṭimukkaṁ na muttaṁ; ", "ja513:7.3": "Taṁ saṅgaraṁ brāhmaṇassappadāya, ", "ja513:7.4": "Saccānurakkhī punarāvajassu”. ", "ja513:8.1": "Mutto ca so porisādassa hatthā, ", "ja513:8.2": "Gantvā sakaṁ mandiraṁ kāmakāmī; ", "ja513:8.3": "Taṁ saṅgaraṁ brāhmaṇassappadāya, ", "ja513:8.4": "Āmantayī puttamalīnasattaṁ. ", "ja513:9.1": "“Ajjeva rajjaṁ abhisiñcayassu, ", "ja513:9.2": "Dhammaṁ cara sesu paresu cāpi; ", "ja513:9.3": "Adhammakāro ca te māhu raṭṭhe, ", "ja513:9.4": "Gacchāmahaṁ porisādassa ñatte”. ", "ja513:10.1": "“Kiṁ kamma kubbaṁ tava deva pāva, ", "ja513:10.2": "Nārādhayī taṁ tadicchāmi sotuṁ; ", "ja513:10.3": "Yamajja rajjamhi udassaye tuvaṁ, ", "ja513:10.4": "Rajjampi niccheyyaṁ tayā vināhaṁ”. ", "ja513:11.1": "“Na kammunā vā vacasā va tāta, ", "ja513:11.2": "Aparādhitohaṁ tuviyaṁ sarāmi; ", "ja513:11.3": "Sandhiñca katvā purisādakena, ", "ja513:11.4": "Saccānurakkhī punāhaṁ gamissaṁ”. ", "ja513:12.1": "“Ahaṁ gamissāmi idheva hohi, ", "ja513:12.2": "Natthi tato jīvato vippamokkho; ", "ja513:12.3": "Sace tuvaṁ gacchasiyeva rāja, ", "ja513:12.4": "Ahampi gacchāmi ubho na homa”. ", "ja513:13.1": "“Addhā hi tāta satānesa dhammo, ", "ja513:13.2": "Maraṇā ca me dukkhataraṁ tadassa; ", "ja513:13.3": "Kammāsapādo taṁ yadā pacitvā, ", "ja513:13.4": "Pasayha khāde bhidā rukkhasūle”. ", "ja513:14.1": "“Pāṇena te pāṇamahaṁ nimissaṁ, ", "ja513:14.2": "Mā tvaṁ agā porisādassa ñatte; ", "ja513:14.3": "Etañca te pāṇamahaṁ nimissaṁ, ", "ja513:14.4": "Tasmā mataṁ jīvitassa vaṇṇemi”. ", "ja513:15.1": "Tato have dhitimā rājaputto, ", "ja513:15.2": "Vanditvā mātu ca pitu ca pāde; ", "ja513:15.3": "Dukhinissa mātā nipatā pathabyā, ", "ja513:15.4": "Pitāssa paggayha bhujāni kandati. ", "ja513:16.1": "Taṁ gacchantaṁ tāva pitā viditvā, ", "ja513:16.2": "Parammukho vandati pañjalīko; ", "ja513:16.3": "“Somo ca rājā varuṇo ca rājā, ", "ja513:16.4": "Pajāpatī candimā sūriyo ca; ", "ja513:16.5": "Etehi gutto purisādakamhā, ", "ja513:16.6": "Anuññāto sotthi paccehi tāta”. ", "ja513:17.1": "“Yaṁ daṇḍakirañño gatassa mātā, ", "ja513:17.2": "Rāmassakāsi sotthānaṁ suguttā; ", "ja513:17.3": "Taṁ te ahaṁ sotthānaṁ karomi, ", "ja513:17.4": "Etena saccena sarantu devā; ", "ja513:17.5": "Anuññāto sotthi paccehi putta”. ", "ja513:18.1": "“Āvī raho vāpi manopadosaṁ, ", "ja513:18.2": "Nāhaṁ sare jātu malīnasatte; ", "ja513:18.3": "Etena saccena sarantu devā, ", "ja513:18.4": "Anuññāto sotthi paccehi bhātika”. ", "ja513:19.1": "“Yasmā ca me anadhimanosi sāmi, ", "ja513:19.2": "Na cāpi me manasā appiyosi; ", "ja513:19.3": "Etena saccena sarantu devā, ", "ja513:19.4": "Anuññāto sotthi paccehi sāmi”. ", "ja513:20.1": "“Brahā ujū cārumukho kutosi, ", "ja513:20.2": "Na maṁ pajānāsi vane vasantaṁ; ", "ja513:20.3": "Luddaṁ maṁ ñatvā ‘purisādako’ti, ", "ja513:20.4": "Ko sotthimājānamidhāvajeyya”. ", "ja513:21.1": "“Jānāmi ludda purisādako tvaṁ, ", "ja513:21.2": "Na taṁ na jānāmi vane vasantaṁ; ", "ja513:21.3": "Ahañca puttosmi jayaddisassa, ", "ja513:21.4": "Mamajja khāda pituno pamokkhā”. ", "ja513:22.1": "“Jānāmi puttoti jayaddisassa, ", "ja513:22.2": "Tathā hi vo mukhavaṇṇo ubhinnaṁ; ", "ja513:22.3": "Sudukkaraññeva kataṁ tavedaṁ, ", "ja513:22.4": "Yo mattumicche pituno pamokkhā”. ", "ja513:23.1": "“Na dukkaraṁ kiñci mahettha maññe, ", "ja513:23.2": "Yo mattumicche pituno pamokkhā; ", "ja513:23.3": "Mātu ca hetu paraloka gantvā, ", "ja513:23.4": "Sukhena saggena ca sampayutto”. ", "ja513:24.1": "“Ahañca kho attano pāpakiriyaṁ, ", "ja513:24.2": "Āvī raho vāpi sare na jātu; ", "ja513:24.3": "Saṅkhātajātīmaraṇohamasmi, ", "ja513:24.4": "Yatheva me idha tathā parattha. ", "ja513:25.1": "Khādajja maṁ dāni mahānubhāva, ", "ja513:25.2": "Karassu kiccāni imaṁ sarīraṁ; ", "ja513:25.3": "Rukkhassa vā te papatāmi aggā, ", "ja513:25.4": "Chādayamāno mayhaṁ tvamadesi maṁsaṁ”. ", "ja513:26.1": "“Idañca te ruccati rājaputta, ", "ja513:26.2": "Cajesi pāṇaṁ pituno pamokkhā; ", "ja513:26.3": "Tasmā hi so tvaṁ taramānarūpo, ", "ja513:26.4": "Sambhañja kaṭṭhāni jalehi aggiṁ”. ", "ja513:27.1": "Tato have dhitimā rājaputto, ", "ja513:27.2": "Dāruṁ samāhatvā mahantamaggiṁ; ", "ja513:27.3": "Sandīpayitvā paṭivedayittha, ", "ja513:27.4": "“Ādīpito dāni mahāyamaggi”. ", "ja513:28.1": "“Khādajja maṁ dāni pasayhakāri, ", "ja513:28.2": "Kiṁ maṁ muhuṁ pekkhasi haṭṭhalomo; ", "ja513:28.3": "Tathā tathā tuyhamahaṁ karomi, ", "ja513:28.4": "Yathā yathā maṁ chādayamāno adesi”. ", "ja513:29.1": "“Ko tādisaṁ arahati khāditāye, ", "ja513:29.2": "Dhamme ṭhitaṁ saccavādiṁ vadaññuṁ; ", "ja513:29.3": "Muddhāpi tassa viphaleyya sattadhā, ", "ja513:29.4": "Yo tādisaṁ saccavādiṁ adeyya”. ", "ja513:30.1": "“Idañhi so brāhmaṇaṁ maññamāno, ", "ja513:30.2": "Saso avāsesi sake sarīre; ", "ja513:30.3": "Teneva so candimā devaputto, ", "ja513:30.4": "Sasatthuto kāmaduhajja yakkha”. ", "ja513:31.1": "“Cando yathā rāhumukhā pamutto, ", "ja513:31.2": "Virocate pannaraseva bhāṇumā; ", "ja513:31.3": "Evaṁ tuvaṁ porisādā pamutto, ", "ja513:31.4": "Viroca kapile mahānubhāva; ", "ja513:31.5": "Āmodayaṁ pitaraṁ mātarañca, ", "ja513:31.6": "Sabbo ca te nandatu ñātipakkho”. ", "ja513:32.1": "Tato have dhitimā rājaputto, ", "ja513:32.2": "Katañjalī pariyāya porisādaṁ; ", "ja513:32.3": "Anuññāto sotthi sukhī arogo, ", "ja513:32.4": "Paccāgamā kapilamalīnasatto. ", "ja513:33.1": "Taṁ negamā jānapadā ca sabbe, ", "ja513:33.2": "Hatthārohā rathikā pattikā ca; ", "ja513:33.3": "Namassamānā pañjalikā upāgamuṁ, ", "ja513:33.4": "“Namatthu te dukkarakārakosī”ti. ", "ja513:34.1": "Jayaddisajātakaṁ tatiyaṁ. "}, "variant_text": {"ja513:0.1": "", "ja513:0.2": "", "ja513:0.3": "", "ja513:0.4": "", "ja513:1.1": "", "ja513:1.2": "", "ja513:1.3": "", "ja513:1.4": "", "ja513:2.1": "", "ja513:2.2": "", "ja513:2.3": "", "ja513:2.4": "ca → mātucca (bj); mātū ca (sya1ed, sya2ed) | gantvā → gamyā (bj, sya1ed, sya2ed); gamya (pts-vp-pli1) ", "ja513:3.1": "sassamāno → sayhamāno (sya1ed, sya2ed, mr) ", "ja513:3.2": "", "ja513:3.3": "jighaññaṁ → dighaññaṁ (pts-vp-pli1); jighacchaṁ (?) ", "ja513:3.4": "", "ja513:4.1": "nikkayena → vikkayena (bj) ", "ja513:4.2": "", "ja513:4.3": "saṅgaraṁ → saṅkaraṁ (mr) ", "ja513:4.4": "", "ja513:5.1": "anutappate tvaṁ → anutappatī taṁ (bj, pts-vp-pli1) ", "ja513:5.2": "", "ja513:5.3": "", "ja513:5.4": "", "ja513:6.1": "", "ja513:6.2": "", "ja513:6.3": "", "ja513:6.4": "", "ja513:7.1": "", "ja513:7.2": "", "ja513:7.3": "", "ja513:7.4": "", "ja513:8.1": "porisādassa → purisādassa (pts-vp-pli1) ", "ja513:8.2": "", "ja513:8.3": "", "ja513:8.4": "puttamalīnasattaṁ → … sattuṁ (sya1ed, sya2ed, pts-vp-pli1, mr) ", "ja513:9.1": "", "ja513:9.2": "", "ja513:9.3": "", "ja513:9.4": "ñatte → ñante (sya1ed, sya2ed) ", "ja513:10.1": "deva pāva → devapāde (bj, sya1ed, sya2ed, pts-vp-pli1) ", "ja513:10.2": "", "ja513:10.3": "", "ja513:10.4": "", "ja513:11.1": "", "ja513:11.2": "", "ja513:11.3": "Sandhiñca → saddhiñca (sya1ed, sya2ed, mr) ", "ja513:11.4": "", "ja513:12.1": "", "ja513:12.2": "", "ja513:12.3": "", "ja513:12.4": "", "ja513:13.1": "", "ja513:13.2": "", "ja513: