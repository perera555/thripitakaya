ass='verse-line'>{}</span>", "ja419:9.3": "<span class='verse-line'>{}</span>", "ja419:9.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja419:10.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja419:0.1": "Jātaka ", "ja419:0.2": "Aṭṭhakanipāta ", "ja419:0.3": "Kaccānivagga ", "ja419:0.4": "3. Sulasājātaka ", "ja419:1.1": "“Idaṁ suvaṇṇakāyūraṁ, ", "ja419:1.2": "muttā veḷuriyā bahū; ", "ja419:1.3": "Sabbaṁ harassu bhaddante, ", "ja419:1.4": "mañca dāsīti sāvaya”. ", "ja419:2.1": "“Oropayassu kalyāṇi, ", "ja419:2.2": "mā bāḷhaṁ paridevasi; ", "ja419:2.3": "Na cāhaṁ abhijānāmi, ", "ja419:2.4": "ahantvā dhanamābhataṁ”. ", "ja419:3.1": "“Yato sarāmi attānaṁ, ", "ja419:3.2": "yato pattāsmi viññutaṁ; ", "ja419:3.3": "Na cāhaṁ abhijānāmi, ", "ja419:3.4": "aññaṁ piyataraṁ tayā. ", "ja419:4.1": "Ehi taṁ upagūhissaṁ, ", "ja419:4.2": "karissañca padakkhiṇaṁ; ", "ja419:4.3": "Na hi dāni puna atthi, ", "ja419:4.4": "mama tuyhañca saṅgamo”. ", "ja419:5.1": "“Na hi sabbesu ṭhānesu, ", "ja419:5.2": "puriso hoti paṇḍito; ", "ja419:5.3": "Itthīpi paṇḍitā hoti, ", "ja419:5.4": "tattha tattha vicakkhaṇā. ", "ja419:6.1": "Na hi sabbesu ṭhānesu, ", "ja419:6.2": "puriso hoti paṇḍito; ", "ja419:6.3": "Itthīpi paṇḍitā hoti, ", "ja419:6.4": "lahuṁ atthaṁ vicintikā. ", "ja419:7.1": "Lahuñca vata khippañca, ", "ja419:7.2": "nikaṭṭhe samacetayi; ", "ja419:7.3": "Migaṁ puṇṇāyateneva, ", "ja419:7.4": "sulasā sattukaṁ vadhi. ", "ja419:8.1": "Yodha uppatitaṁ atthaṁ, ", "ja419:8.2": "na khippamanubujjhati; ", "ja419:8.3": "So haññati mandamati, ", "ja419:8.4": "corova girigabbhare. ", "ja419:9.1": "Yo ca uppatitaṁ atthaṁ, ", "ja419:9.2": "khippameva nibodhati; ", "ja419:9.3": "Muccate sattusambādhā, ", "ja419:9.4": "sulasā sattukāmivā”ti. ", "ja419:10.1": "Sulasājātakaṁ tatiyaṁ. "}, "variant_text": {"ja419:0.1": "", "ja419:0.2": "", "ja419:0.3": "", "ja419:0.4": "", "ja419:1.1": "", "ja419:1.2": "", "ja419:1.3": "", "ja419:1.4": "", "ja419:2.1": "", "ja419:2.2": "bāḷhaṁ → bahuṁ (bj, sya1ed, sya2ed, pts-vp-pli1) ", "ja419:2.3": "", "ja419:2.4": "", "ja419:3.1": "", "ja419:3.2": "", "ja419:3.3": "", "ja419:3.4": "", "ja419:4.1": "upagūhissaṁ → upaguyhissaṁ (mr) ", "ja419:4.2": "", "ja419:4.3": "", "ja419:4.4": "", "ja419:5.1": "", "ja419:5.2": "", "ja419:5.3": "", "ja419:5.4": "", "ja419:6.1": "", "ja419:6.2": "", "ja419:6.3": "", "ja419:6.4": "lahuṁ atthaṁ vicintikā → lahumatthavicintikā (bj, pts-vp-pli1); lahumatthaṁ vicintikā (sya1ed, sya2ed) ", "ja419:7.1": "", "ja419:7.2": "", "ja419:7.3": "puṇṇāyateneva → puṇṇāya tenevaṁ (bj); puṇṇāyataneva (sya1ed, sya2ed) ", "ja419:7.4": "", "ja419:8.1": "Yodha → yo ca (ja448:9 [Kukkuṭajātaka] kukkuṭajātake) ", "ja419:8.2": "", "ja419:8.3": "", "ja419:8.4": "", "ja419:9.1": "", "ja419:9.2": "", "ja419:9.3": "", "ja419:9.4": "", "ja419:10.1": ""}, "reference_text": {"ja419:0.1": "", "ja419:0.2": "", "ja419:0.3": "", "ja419:0.4": "", "ja419:1.1": "bj30.306, ms22J_1692, msdiv18, pts-vp-pli3.437", "ja419:1.2": "", "ja419:1.3": "", "ja419:1.4": "", "ja419:2.1": "ms22J_1693, msdiv19", "ja419:2.2": "", "ja419:2.3": "", "ja419:2.4": "", "ja419:3.1": "ms22J_1694, msdiv20", "ja419:3.2": "", "ja419:3.3": "", "ja419:3.4": "", "ja419:4.1": "ms22J_1695, msdiv21, ndp22.170", "ja419:4.2": "", "ja419:4.3": "", "ja419:4.4": "", "ja419:5.1": "ms22J_1696, msdiv22, pts-vp-pli3.438, vri68.146", "ja419:5.2": "", "ja419:5.3": "", "ja419:5.4": "", "ja419:6.1": "csp1ed22.178, csp2ed22.178, ms22J_1697, msdiv23, sya27.242", "ja419:6.2": "", "ja419:6.3": "", "ja419:6.4": "", "ja419:7.1": "dr27.241, ms22J_1698, msdiv24", "ja419:7.2": "", "ja419:7.3": "", "ja419:7.4": "", "ja419:8.1": "ms22J_1699, msdiv25", "ja419:8.2": "", "ja419:8.3": "", "ja419:8.4": "", "ja419:9.1": "ms22J_1700, msdiv26", "ja419:9.2": "", "ja419:9.3": "", "ja419:9.4": "", "ja419:10.1": "ms22J_1701"}, "keys_order": ["ja419:0.1", "ja419:0.2", "ja419:0.3", "ja419:0.4", "ja419:1.1", "ja419:1.2", "ja419:1.3", "ja419:1.4", "ja419:2.1", "ja419:2.2", "ja419:2.3", "j