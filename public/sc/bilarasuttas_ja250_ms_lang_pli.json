{"html_text": {"ja250:0.1": "<article id='ja250'><header><ul><li class='division'>{}</li>", "ja250:0.2": "<li>{}</li>", "ja250:0.3": "<li>{}</li></ul>", "ja250:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja250:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja250:1.2": "<span class='verse-line'>{}</span>", "ja250:1.3": "<span class='verse-line'>{}</span>", "ja250:1.4": "<span class='verse-line'>{}</span></p>", "ja250:2.1": "<p><span class='verse-line'>{}</span>", "ja250:2.2": "<span class='verse-line'>{}</span>", "ja250:2.3": "<span class='verse-line'>{}</span>", "ja250:2.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja250:3.1": "<p class='endsutta'>{}</p>", "ja250:3.2": "<p class='endvagga'>{}</p>", "ja250:4.1": "<p class='uddana-intro'>{}</p>", "ja250:5.1": "<blockquote class='uddanagatha'><p><span class='verse-line'>{}</span>", "ja250:5.2": "<span class='verse-line'>{}</span>", "ja250:5.3": "<span class='verse-line'>{}</span>", "ja250:5.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja250:6.1": "<p class='uddana-intro'>{}</p>", "ja250:7.1": "<blockquote class='uddanagatha'><p><span class='verse-line'>{}</span>", "ja250:7.2": "<span class='verse-line'>{}</span>", "ja250:7.3": "<span class='verse-line'>{}</span>", "ja250:7.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja250:8.1": "<p class='endsection'>{}</p></article>"}, "root_text": {"ja250:0.1": "Jātaka ", "ja250:0.2": "Dukanipāta ", "ja250:0.3": "Siṅgālavagga ", "ja250:0.4": "10. Kapijātaka ", "ja250:1.1": "“Ayaṁ isī upasamasaṁyame rato, ", "ja250:1.2": "Sa tiṭṭhati sisirabhayena aṭṭito; ", "ja250:1.3": "Handa ayaṁ pavisatumaṁ agārakaṁ, ", "ja250:1.4": "Vinetu sītaṁ darathañca kevalaṁ”. ", "ja250:2.1": "“Nāyaṁ isī upasamasaṁyame rato, ", "ja250:2.2": "Kapī ayaṁ dumavarasākhagocaro; ", "ja250:2.3": "So dūsako rosako cāpi jammo, ", "ja250:2.4": "Sacevajemampi dūseyyagāran”ti. ", "ja250:3.1": "Kapijātakaṁ dasamaṁ. ", "ja250:3.2": "Siṅgālavaggo dasamo. ", "ja250:4.1": "Tassuddānaṁ ", "ja250:5.1": "Atha rājā siṅgālavaro sunakho, ", "ja250:5.2": "Tathā kosiya icchati kālaghaso; ", "ja250:5.3": "Atha dānavaroṭṭhapi sārathinā, ", "ja250:5.4": "Punambavanañca sisirakapi dasāti. ", "ja250:6.1": "Atha vagguddānaṁ ", "ja250:7.1": "Daḷhañca vaggaṁ aparena santhavaṁ, ", "ja250:7.2": "Kalyāṇavaggāsadiso ca rūhakaṁ; ", "ja250:7.3": "Nataṁdaḷha bīraṇathambhakaṁ puna, ", "ja250:7.4": "Kāsāvupāhana siṅgālakena dasāti. ", "ja250:8.1": "Dukanipātaṁ niṭṭhitaṁ. "}, "variant_text": {"ja250:0.1": "", "ja250:0.2": "", "ja250:0.3": "", "ja250:0.4": "", "ja250:1.1": "", "ja250:1.2": "Sa tiṭṭhati → santiṭṭhati (bj, pts-vp-pli1) ", "ja250:1.3": "", "ja250:1.4": "", "ja250:2.1": "", "ja250:2.2": "", "ja250:2.3": "", "ja250:2.4": "Sacevajemampi → sace vaje imampi (bj, sya1ed, sya2ed, pts-vp-pli1) | dūseyyagāran”ti → dūsaye gharanti (bj, sya1ed, sya2ed, pts-vp-pli1) ", "ja250:3.1": "", "ja250:3.2": "Siṅgālavaggo → sigālavaggo (bj, sya1ed, sya2ed, pts-vp-pli1) ", "ja250:4.1": "", "ja250:5.1": "", "ja250:5.2": "", "ja250:5.3": "", "ja250:5.4": "", "ja250:6.1": "", "ja250:7.1": "", "ja250:7.2": "", "ja250:7.3": "", "ja250:7.4": "", "ja250:8.1": ""}, "reference_text": {"ja250:0.1": "", "ja250:0.2": "", "ja250:0.3": "", "ja250:0.4": "", "ja250:1.1": "csp1ed22.70, csp2ed22.70, ms22J_662, msdiv200, ndp22.65, pts-vp-pli2.269, sya27.97", "ja250:1.2": "", "ja250:1.3": "", "ja250:1.4": "", "ja250:2.1": "ms22J_663, msdiv201, pts-vp-pli2.270", "ja250:2.2": "", "ja250:2.3": "", "ja250:2.4": "", "ja250:3.1": "ms22J_664", "ja250:3.2": "", "ja250:4.1": "ms22J_665", "ja250:5.1": "dr27.97, ms22J_666", "ja250:5.2": "", "ja250:5.3": "", "ja250:5.4": "", "ja250:6.1": "ms22J_667", "ja250:7.1": "ms22J_668, sya27.98", "ja250:7.2": "", "ja250:7.3": "", "ja250:7.4": "", "ja250:8.1": "ms22J_669"}, "keys_order": ["ja250:0.1", "ja250:0.2", "ja250:0.3", "ja250:0.4", "ja250:1.1", "ja250:1.2", "ja250:1.3", "ja250:1.4", "ja250:2.1", "ja250:2.2", "ja250:2.3", "ja250