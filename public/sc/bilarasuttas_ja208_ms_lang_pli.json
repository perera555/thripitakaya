{"html_text": {"ja208:0.1": "<article id='ja208'><header><ul><li class='division'>{}</li>", "ja208:0.2": "<li>{}</li>", "ja208:0.3": "<li>{}</li></ul>", "ja208:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja208:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja208:1.2": "<span class='verse-line'>{}</span>", "ja208:1.3": "<span class='verse-line'>{}</span>", "ja208:1.4": "<span class='verse-line'>{}</span></p>", "ja208:2.1": "<p><span class='verse-line'>{}</span>", "ja208:2.2": "<span class='verse-line'>{}</span>", "ja208:2.3": "<span class='verse-line'>{}</span>", "ja208:2.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja208:3.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja208:0.1": "Jātaka ", "ja208:0.2": "Dukanipāta ", "ja208:0.3": "Nataṁdaḷhavagga ", "ja208:0.4": "8. Susumārajātaka ", "ja208:1.1": "“Alaṁ metehi ambehi, ", "ja208:1.2": "jambūhi panasehi ca; ", "ja208:1.3": "Yāni pāraṁ samuddassa, ", "ja208:1.4": "varaṁ mayhaṁ udumbaro. ", "ja208:2.1": "Mahatī vata te bondi, ", "ja208:2.2": "na ca paññā tadūpikā; ", "ja208:2.3": "Susumāra vañcito mesi, ", "ja208:2.4": "gaccha dāni yathāsukhan”ti. ", "ja208:3.1": "Susumārajātakaṁ aṭṭhamaṁ. "}, "variant_text": {"ja208:0.1": "", "ja208:0.2": "", "ja208:0.3": "", "ja208:0.4": "Susumāra → suṁsumāra (bj, sya1ed, sya2ed, pts-vp-pli1) ", "ja208:1.1": "", "ja208:1.2": "", "ja208:1.3": "", "ja208:1.4": "", "ja208:2.1": "", "ja208:2.2": "", "ja208:2.3": "", "ja208:2.4": "", "ja208:3.1": "Susumārajātakaṁ → suṁsumārajātakaṁ (bj, sya1ed, sya2ed, pts-vp-pli1) "}, "reference_text": {"ja208:0.1": "", "ja208:0.2": "", "ja208:0.3": "", "ja208:0.4": "", "ja208:1.1": "ms22J_527, msdiv115, ndp22.52, pts-vp-pli2.160, sya27.77", "ja208:1.2": "", "ja208:1.3": "", "ja208:1.4": "", "ja208:2.1": "ms22J_528, msdiv116", "ja208:2.2": "", "ja208:2.3": "", "ja208:2.4": "", "ja208:3.1": "ms22J_529"}, "keys_order": ["ja208:0.1", "ja208:0.2", "ja208:0.3", "ja208:0.4", "ja208:1.1", "ja208:1.2