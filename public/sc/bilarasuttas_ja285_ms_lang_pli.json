{"html_text": {"ja285:0.1": "<article id='ja285'><header><ul><li class='division'>{}</li>", "ja285:0.2": "<li>{}</li>", "ja285:0.3": "<li>{}</li></ul>", "ja285:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja285:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja285:1.2": "<span class='verse-line'>{}</span>", "ja285:1.3": "<span class='verse-line'>{}</span>", "ja285:1.4": "<span class='verse-line'>{}</span></p>", "ja285:2.1": "<p><span class='verse-line'>{}</span>", "ja285:2.2": "<span class='verse-line'>{}</span>", "ja285:2.3": "<span class='verse-line'>{}</span>", "ja285:2.4": "<span class='verse-line'>{}</span></p>", "ja285:3.1": "<p><span class='verse-line'>{}</span>", "ja285:3.2": "<span class='verse-line'>{}</span>", "ja285:3.3": "<span class='verse-line'>{}</span>", "ja285:3.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja285:4.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja285:0.1": "Jātaka ", "ja285:0.2": "Tikanipāta ", "ja285:0.3": "Abbhantaravagga ", "ja285:0.4": "5. Maṇisūkarajātaka ", "ja285:1.1": "“Dariyā satta vassāni, ", "ja285:1.2": "tiṁsamattā vasāmase; ", "ja285:1.3": "Haññāma maṇino ābhaṁ, ", "ja285:1.4": "iti no mantanaṁ ahu. ", "ja285:2.1": "Yāvatā maṇiṁ ghaṁsāma, ", "ja285:2.2": "bhiyyo vodāyate maṇi; ", "ja285:2.3": "Idañca dāni pucchāma, ", "ja285:2.4": "kiṁ kiccaṁ idha maññasi”. ", "ja285:3.1": "“Ayaṁ maṇi veḷūriyo, ", "ja285:3.2": "akāco vimalo subho; ", "ja285:3.3": "Nāssa sakkā siriṁ hantuṁ, ", "ja285:3.4": "apakkamatha sūkarā”ti. ", "ja285:4.1": "Maṇisūkarajātakaṁ pañcamaṁ. "}, "variant_text": {"ja285:0.1": "", "ja285:0.2": "", "ja285:0.3": "", "ja285:0.4": "", "ja285:1.1": "", "ja285:1.2": "", "ja285:1.3": "Haññāma → hañchema (bj, pts-vp-pli1); hañchāma (?) ", "ja285:1.4": "", "ja285:2.1": "Yāvatā maṇiṁ ghaṁsāma → yāva yāva nighaṁsāma (bj, pts-vp-pli1); yavatā maṇi ghaṁsāma (sya1ed, sya2ed) ", "ja285:2.2": "", "ja285:2.3": "", "ja285:2.4": "", "ja285:3.1": "", "ja285:3.2": "vimalo → vipulo (mr) ", "ja285:3.3": "", "ja285:3.4": "", "ja285:4.1": "Maṇisūkarajātakaṁ → maṇighaṁsajātakaṁ (mr) "}, "reference_text": {"ja285:0.1": "", "ja285:0.2": "", "ja285:0.3": "", "ja285:0.4": "", "ja285:1.1": "ms22J_812, msdiv103, pts-vp-pli2.418, vri68.75", "ja285:1.2": "", "ja285:1.3": "", "ja285:1.4": "", "ja285:2.1": "ms22J_813, msdiv104", "ja285:2.2": "", "ja285:2.3": "", "ja285:2.4": "", "ja285:3.1": "ms22J_814, msdiv105", "ja285:3.2": "", "ja285:3.3": "", "ja285:3.4": "", "ja285:4.1": "ms22J_815"}, "keys_order": ["ja285:0.1", "ja285:0.2", "ja285:0.3", "ja285:0.4", "ja285:1.1", "ja285:1.2", "ja285:1.3", "ja285:1.4", "ja285:2.1", "ja285:2.2", "ja285:2.3", "ja285:2.4", "ja285:3.1", "ja285:3.2", "ja285:3.3", "ja285:3.4", "ja285:4.1"]}