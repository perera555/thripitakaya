{"html_text": {"ja305:0.1": "<article id='ja305'><header><ul><li class='division'>{}</li>", "ja305:0.2": "<li>{}</li>", "ja305:0.3": "<li>{}</li></ul>", "ja305:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja305:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja305:1.2": "<span class='verse-line'>{}</span>", "ja305:1.3": "<span class='verse-line'>{}</span>", "ja305:1.4": "<span class='verse-line'>{}</span></p>", "ja305:2.1": "<p><span class='verse-line'>{}</span>", "ja305:2.2": "<span class='verse-line'>{}</span>", "ja305:2.3": "<span class='verse-line'>{}</span>", "ja305:2.4": "<span class='verse-line'>{}</span></p>", "ja305:3.1": "<p><span class='verse-line'>{}</span>", "ja305:3.2": "<span class='verse-line'>{}</span>", "ja305:3.3": "<span class='verse-line'>{}</span>", "ja305:3.4": "<span class='verse-line'>{}</span></p>", "ja305:4.1": "<p><span class='verse-line'>{}</span>", "ja305:4.2": "<span class='verse-line'>{}</span>", "ja305:4.3": "<span class='verse-line'>{}</span>", "ja305:4.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja305:5.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja305:0.1": "Jātaka ", "ja305:0.2": "Catukkanipāta ", "ja305:0.3": "Kāliṅgavagga ", "ja305:0.4": "5. Sīlavīmaṁsanajātaka ", "ja305:1.1": "“Natthi loke raho nāma, ", "ja305:1.2": "pāpakammaṁ pakubbato; ", "ja305:1.3": "Passanti vanabhūtāni, ", "ja305:1.4": "taṁ bālo maññatī raho. ", "ja305:2.1": "Ahaṁ raho na passāmi, ", "ja305:2.2": "suññaṁ vāpi na vijjati; ", "ja305:2.3": "Yattha aññaṁ na passāmi, ", "ja305:2.4": "asuññaṁ hoti taṁ mayā”. ", "ja305:3.1": "“Dujjacco ca sujacco ca, ", "ja305:3.2": "nando ca sukhavaḍḍhito; ", "ja305:3.3": "Vejjo ca addhuvasīlo ca, ", "ja305:3.4": "te dhammaṁ jahu matthikā. ", "ja305:4.1": "Brāhmaṇo ca kathaṁ jahe, ", "ja305:4.2": "sabbadhammāna pāragū; ", "ja305:4.3": "Yo dhammamanupāleti, ", "ja305:4.4": "dhitimā saccanikkamo”ti. ", "ja305:5.1": "Sīlavīmaṁsanajātakaṁ pañcamaṁ. "}, "variant_text": {"ja305:0.1": "", "ja305:0.2": "", "ja305:0.3": "", "ja305:0.4": "", "ja305:1.1": "", "ja305:1.2": "", "ja305:1.3": "", "ja305:1.4": "", "ja305:2.1": "", "ja305:2.2": "", "ja305:2.3": "aññaṁ → suññaṁ (sya1ed, sya2ed, mr) ", "ja305:2.4": "", "ja305:3.1": "sujacco → ajacco (pts-vp-pli1) ", "ja305:3.2": "sukhavaḍḍhito → sukhavacchako (bj); sukhavacchano (sya1ed, sya2ed, pts-vp-pli1) ", "ja305:3.3": "addhuvasīlo → atha sīlo (mr) ", "ja305:3.4": "", "ja305:4.1": "", "ja305:4.2": "", "ja305:4.3": "", "ja305:4.4": "", "ja305:5.1": "Sīlavīmaṁsanajātakaṁ → sīlavīmaṁsajātakaṁ (bj, sya1ed, sya2ed) "}, "reference_text": {"ja305:0.1": "", "ja305:0.2": "", "ja305:0.3": "", "ja305:0.4": "", "ja305:1.1": "ms22J_903, msdiv17, pts-vp-pli3.19", "ja305:1.2": "", "ja305:1.3": "", "ja305:1.4": "", "ja305:2.1": "ms22J_904, msdiv18", "ja305:2.2": "", "ja305:2.3": "", "ja305:2.4": "", "ja305:3.1": "ms22J_905, msdiv19, sya27.132", "ja305:3.2": "", "ja305:3.3": "", "ja305:3.4": "", "ja305:4.1": "dr27.132, ms22J_906, msdiv20, vri68.83", "ja305:4.2": "", "ja305:4.3": "", "ja305:4.4": "", "ja305:5.1": "ms22J_907"}, "keys_order": ["ja305:0.1", "ja305:0.2", "ja305:0.3", "ja305:0.4", "ja305:1.1", "ja305:1.2", "ja305:1.3", "ja305:1.4", "ja305:2.1", "ja305:2.2", "ja305:2.3", "ja305:2.4", "ja305:3.1", "ja305:3.2", "ja305:3.3", "ja305:3.4", "ja305:4.1", "ja305:4.2", "ja305:4.3", "ja305:4.4", "ja305:5.1"]}