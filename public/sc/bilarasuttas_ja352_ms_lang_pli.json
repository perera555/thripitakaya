{"html_text": {"ja352:0.1": "<article id='ja352'><header><ul><li class='division'>{}</li>", "ja352:0.2": "<li>{}</li>", "ja352:0.3": "<li>{}</li></ul>", "ja352:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja352:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja352:1.2": "<span class='verse-line'>{}</span>", "ja352:1.3": "<span class='verse-line'>{}</span>", "ja352:1.4": "<span class='verse-line'>{}</span></p>", "ja352:2.1": "<p><span class='verse-line'>{}</span>", "ja352:2.2": "<span class='verse-line'>{}</span>", "ja352:2.3": "<span class='verse-line'>{}</span>", "ja352:2.4": "<span class='verse-line'>{}</span></p>", "ja352:3.1": "<p><span class='verse-line'>{}</span>", "ja352:3.2": "<span class='verse-line'>{}</span>", "ja352:3.3": "<span class='verse-line'>{}</span>", "ja352:3.4": "<span class='verse-line'>{}</span></p>", "ja352:4.1": "<p><span class='verse-line'>{}</span>", "ja352:4.2": "<span class='verse-line'>{}</span>", "ja352:4.3": "<span class='verse-line'>{}</span>", "ja352:4.4": "<span class='verse-line'>{}</span></p>", "ja352:5.1": "<p><span class='verse-line'>{}</span>", "ja352:5.2": "<span class='verse-line'>{}</span>", "ja352:5.3": "<span class='verse-line'>{}</span>", "ja352:5.4": "<span class='verse-line'>{}</span></p>", "ja352:6.1": "<p><span class='verse-line'>{}</span>", "ja352:6.2": "<span class='verse-line'>{}</span>", "ja352:6.3": "<span class='verse-line'>{}</span>", "ja352:6.4": "<span class='verse-line'>{}</span></p>", "ja352:7.1": "<p><span class='verse-line'>{}</span>", "ja352:7.2": "<span class='verse-line'>{}</span>", "ja352:7.3": "<span class='verse-line'>{}</span>", "ja352:7.4": "<span class='verse-line'>{}</span></p>", "ja352:8.1": "<p><span class='verse-line'>{}</span>", "ja352:8.2": "<span class='verse-line'>{}</span>", "ja352:8.3": "<span class='verse-line'>{}</span>", "ja352:8.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja352:9.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja352:0.1": "Jātaka ", "ja352:0.2": "Pañcakanipāta ", "ja352:0.3": "Maṇikuṇḍalavagga ", "ja352:0.4": "2. Sujātajātaka ", "ja352:1.1": "“Kiṁ nu santaramānova, ", "ja352:1.2": "lāyitvā haritaṁ tiṇaṁ; ", "ja352:1.3": "Khāda khādāti lapasi, ", "ja352:1.4": "gatasattaṁ jaraggavaṁ. ", "ja352:2.1": "Na hi annena pānena, ", "ja352:2.2": "mato goṇo samuṭṭhahe; ", "ja352:2.3": "Tvañca tucchaṁ vilapasi, ", "ja352:2.4": "yathā taṁ dummatī tathā”. ", "ja352:3.1": "“Tatheva tiṭṭhati sīsaṁ, ", "ja352:3.2": "hatthapādā ca vāladhi; ", "ja352:3.3": "Sotā tatheva tiṭṭhanti, ", "ja352:3.4": "maññe goṇo samuṭṭhahe. ", "ja352:4.1": "Nevayyakassa sīsañca, ", "ja352:4.2": "hatthapādā ca dissare; ", "ja352:4.3": "Rudaṁ mattikathūpasmiṁ, ", "ja352:4.4": "nanu tvaññeva dummati”. ", "ja352:5.1": "“Ādittaṁ vata maṁ santaṁ, ", "ja352:5.2": "ghatasittaṁva pāvakaṁ; ", "ja352:5.3": "Vārinā viya osiñcaṁ, ", "ja352:5.4": "sabbaṁ nibbāpaye daraṁ. ", "ja352:6.1": "Abbahī vata me sallaṁ, ", "ja352:6.2": "yamāsi hadayassitaṁ; ", "ja352:6.3": "Yo me sokaparetassa, ", "ja352:6.4": "pitusokaṁ apānudi. ", "ja352:7.1": "Sohaṁ abbūḷhasallosmi, ", "ja352:7.2": "vītasoko anāvilo; ", "ja352:7.3": "Na socāmi na rodāmi, ", "ja352:7.4": "tava sutvāna māṇava. ", "ja352:8.1": "Evaṁ karonti sappaññā, ", "ja352:8.2": "ye honti anukampakā; ", "ja352:8.3": "Vinivattenti sokamhā, ", "ja352:8.4": "sujāto pitaraṁ yathā”ti. ", "ja352:9.1": "Sujātajātakaṁ dutiyaṁ. "}, "variant_text": {"ja352:0.1": "", "ja352:0.2": "", "ja352:0.3": "", "ja352:0.4": "", "ja352:1.1": "", "ja352:1.2": "", "ja352:1.3": "", "ja352:1.4": "", "ja352:2.1": "", "ja352:2.2": "", "ja352:2.3": "", "ja352:2.4": "", "ja352:3.1": "", "ja352:3.2": "", "ja352:3.3": "tatheva tiṭṭhanti → so tāta tatheva tiṭṭhati (mr) ", "ja352:3.4": "", "ja352:4.1": "sīsañca → sīsaṁ vā (bj, sya1ed, sya2ed, pts-vp-pli1) ", "ja352:4.2": "", "ja352:4.3": "", "ja352:4.4": "", "ja352:5.1": "", "ja352:5.2": "", "ja352:5.3": "osiñcaṁ → osiñci (mr) ", "ja352:5.4": "", "ja352:6.1": "Abbahī → abbūḷhaṁ (bj, sya1ed, sya2ed); abbahi (pts-vp-pli1); abbhūḷhaṁ (mr) ", "ja352:6.2": "yamāsi hadayassitaṁ → sokaṁ hadayanissitaṁ (bj, sya1ed, sya2ed); yamāsi hadayanissitaṁ (pts-vp-pli1) ", "ja352:6.3": "", "ja352:6.4": "", "ja352:7.1": "", "ja352:7.2": "", "ja352:7.3": "", "ja352:7.4": "", "ja352:8.1": "", "ja352:8.2": "", "ja352:8.3": "", "ja352:8.4": "", "ja352:9.1": ""}, "reference_text": {"ja352:0.1": "", "ja352:0.2": "", "ja352:0.3": "", "ja352:0.4": "", "ja352:1.1": "csp1ed22.121, csp2ed22.121, ms22J_1152, msdiv6, ndp22.112, pts-vp-pli3.156", "ja352:1.2": "", "ja352:1.3": "", "ja352:1.4": "", "ja352:2.1": "ms22J_1153, msdiv7", "ja352:2.2": "", "ja352:2.3": "", "ja352:2.4": "", "ja352:3.1": "ms22J_1154, msdiv8", "ja352:3.2": "", "ja352:3.3": "", "ja352:3.4": "", "ja352:4.1": "bj30.208, ms22J_1155, msdiv9", "ja352:4.2": "", "ja352:4.3": "", "ja352:4.4": "", "ja352:5.1": "ms22J_1156, msdiv10, pts-vp-pli3.157, vri68.103", "ja352:5.2": "", "ja352:5.3": "", "ja352:5.4": "", "ja352:6.1": "ms22J_1157, msdiv11, sya27.166", "ja352:6.2": "", "ja352:6.3": "", "ja352:6.4": "", "ja352:7.1": "ms22J_1158, msdiv12", "ja352:7.2": "", "ja352:7.3": "", "ja352:7.4": "", "ja352:8.1": "dr27.166, ms22J_1159, msdiv13", "ja352:8.2": "", "ja352:8.3": "", "ja352:8.4": "", "ja352:9.1": "ms22J_1160"}, "keys_order": ["ja352:0.1", "ja352:0.2", "ja352:0.3", "ja352:0.4", "ja352:1.1", "ja352:1.2", "ja352:1.3", "ja352:1.4", "ja352:2.1", "ja352:2.2", "ja352:2.3", "ja352:2.4", "ja352:3.1", "ja352:3.2", "ja352:3.3", "ja352:3.4", "ja352:4.1", "ja352:4.2", "ja352:4.3", "ja352:4.4", "ja352:5.1", "ja352:5.2", "ja352:5.3", "ja352:5.4", "ja352:6.1", "ja352:6.2", "ja352:6.3", "ja352:6.4", "ja352:7.1", "ja352:7.2", "ja352:7.3", "ja352:7.4", "ja352:8.1", "ja352:8.2", "ja352:8.3", "ja352:8.4", "ja352:9.1"]}