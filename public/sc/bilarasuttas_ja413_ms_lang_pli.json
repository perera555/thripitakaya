{"html_text": {"ja413:0.1": "<article id='ja413'><header><ul><li class='division'>{}</li>", "ja413:0.2": "<li>{}</li>", "ja413:0.3": "<li>{}</li></ul>", "ja413:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja413:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja413:1.2": "<span class='verse-line'>{}</span>", "ja413:1.3": "<span class='verse-line'>{}</span>", "ja413:1.4": "<span class='verse-line'>{}</span></p>", "ja413:2.1": "<p><span class='verse-line'>{}</span>", "ja413:2.2": "<span class='verse-line'>{}</span>", "ja413:2.3": "<span class='verse-line'>{}</span>", "ja413:2.4": "<span class='verse-line'>{}</span></p>", "ja413:3.1": "<p><span class='verse-line'>{}</span>", "ja413:3.2": "<span class='verse-line'>{}</span>", "ja413:3.3": "<span class='verse-line'>{}</span>", "ja413:3.4": "<span class='verse-line'>{}</span></p>", "ja413:4.1": "<p><span class='verse-line'>{}</span>", "ja413:4.2": "<span class='verse-line'>{}</span>", "ja413:4.3": "<span class='verse-line'>{}</span>", "ja413:4.4": "<span class='verse-line'>{}</span></p>", "ja413:5.1": "<p><span class='verse-line'>{}</span>", "ja413:5.2": "<span class='verse-line'>{}</span>", "ja413:5.3": "<span class='verse-line'>{}</span>", "ja413:5.4": "<span class='verse-line'>{}</span></p>", "ja413:6.1": "<p><span class='verse-line'>{}</span>", "ja413:6.2": "<span class='verse-line'>{}</span>", "ja413:6.3": "<span class='verse-line'>{}</span>", "ja413:6.4": "<span class='verse-line'>{}</span></p>", "ja413:7.1": "<p><span class='verse-line'>{}</span>", "ja413:7.2": "<span class='verse-line'>{}</span>", "ja413:7.3": "<span class='verse-line'>{}</span>", "ja413:7.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja413:8.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja413:0.1": "Jātaka ", "ja413:0.2": "Sattakanipāta ", "ja413:0.3": "Gandhāravagga ", "ja413:0.4": "8. Dhūmakārijātaka ", "ja413:1.1": "“Rājā apucchi vidhuraṁ, ", "ja413:1.2": "dhammakāmo yudhiṭṭhilo; ", "ja413:1.3": "Api brāhmaṇa jānāsi, ", "ja413:1.4": "ko eko bahu socati”. ", "ja413:2.1": "“Brāhmaṇo ajayūthena, ", "ja413:2.2": "pahūtedho vane vasaṁ; ", "ja413:2.3": "Dhūmaṁ akāsi vāseṭṭho, ", "ja413:2.4": "rattindivamatandito. ", "ja413:3.1": "Tassa taṁ dhūmagandhena, ", "ja413:3.2": "sarabhā makasaḍḍitā; ", "ja413:3.3": "Vassāvāsaṁ upāgacchuṁ, ", "ja413:3.4": "dhūmakārissa santike. ", "ja413:4.1": "Sarabhesu manaṁ katvā, ", "ja413:4.2": "ajā so nāvabujjhatha; ", "ja413:4.3": "Āgacchantī vajantī vā, ", "ja413:4.4": "tassa tā vinasuṁ ajā. ", "ja413:5.1": "Sarabhā sarade kāle, ", "ja413:5.2": "pahīnamakase vane; ", "ja413:5.3": "Pāvisuṁ giriduggāni, ", "ja413:5.4": "nadīnaṁ pabhavāni ca. ", "ja413:6.1": "Sarabhe ca gate disvā, ", "ja413:6.2": "ajā ca vibhavaṁ gatā; ", "ja413:6.3": "Kiso ca vivaṇṇo cāsi, ", "ja413:6.4": "paṇḍurogī ca brāhmaṇo. ", "ja413:7.1": "Evaṁ yo saṁ niraṅkatvā, ", "ja413:7.2": "āgantuṁ kurute piyaṁ; ", "ja413:7.3": "So eko bahu socati, ", "ja413:7.4": "dhūmakārīva brāhmaṇo”ti. ", "ja413:8.1": "Dhūmakārijātakaṁ aṭṭhamaṁ. "}, "variant_text": {"ja413:0.1": "", "ja413:0.2": "", "ja413:0.3": "", "ja413:0.4": "", "ja413:1.1": "", "ja413:1.2": "", "ja413:1.3": "", "ja413:1.4": "", "ja413:2.1": "", "ja413:2.2": "pahūtedho → bahutendo (sya1ed, sya2ed); bahutejo (pts-vp-pli1); bahūtejo (mr) ", "ja413:2.3": "", "ja413:2.4": "", "ja413:3.1": "", "ja413:3.2": "makasaḍḍitā → makasadditā (bj, sya1ed, sya2ed); makasaṭṭitā (pts-vp-pli1, mr) ", "ja413:3.3": "", "ja413:3.4": "", "ja413:4.1": "", "ja413:4.2": "", "ja413:4.3": "Āgacchantī vajantī vā → āgacchanti vajanti vā (sya1ed, sya2ed, pts-vp-pli1); āgacchantiṁ vajantiṁ vā (mr) ", "ja413:4.4": "vinasuṁ → vinassuṁ (bj) ", "ja413:5.1": "", "ja413:5.2": "", "ja413:5.3": "", "ja413:5.4": "", "ja413:6.1": "", "ja413:6.2": "ajā ca vibhavaṁ gatā → aje ca vibhavaṁ gate (mr) ", "ja413:6.3": "", "ja413:6.4": "", "ja413:7.1": "", "ja413:7.2": "", "ja413:7.3": "", "ja413:7.4": "", "ja413:8.1": ""}, "reference_text": {"ja413: