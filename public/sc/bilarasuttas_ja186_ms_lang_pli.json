{"html_text": {"ja186:0.1": "<article id='ja186'><header><ul><li class='division'>{}</li>", "ja186:0.2": "<li>{}</li>", "ja186:0.3": "<li>{}</li></ul>", "ja186:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja186:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja186:1.2": "<span class='verse-line'>{}</span>", "ja186:1.3": "<span class='verse-line'>{}</span>", "ja186:1.4": "<span class='verse-line'>{}</span></p>", "ja186:2.1": "<p><span class='verse-line'>{}</span>", "ja186:2.2": "<span class='verse-line'>{}</span>", "ja186:2.3": "<span class='verse-line'>{}</span>", "ja186:2.4": "<span class='verse-line'>{}</span>", "ja186:2.5": "<span class='verse-line'>{}</span>", "ja186:2.6": "<span class='verse-line'>{}</span></p></blockquote>", "ja186:3.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja186:0.1": "Jātaka ", "ja186:0.2": "Dukanipāta ", "ja186:0.3": "Asadisavagga ", "ja186:0.4": "6. Dadhivāhanajātaka ", "ja186:1.1": "“Vaṇṇagandharasūpeto, ", "ja186:1.2": "amboyaṁ ahuvā pure; ", "ja186:1.3": "Tameva pūjaṁ labhamāno, ", "ja186:1.4": "kenambo kaṭukapphalo”. ", "ja186:2.1": "“Pucimandaparivāro, ", "ja186:2.2": "ambo te dadhivāhana; ", "ja186:2.3": "Mūlaṁ mūlena saṁsaṭṭhaṁ, ", "ja186:2.4": "sākhā sākhā nisevare; ", "ja186:2.5": "Asātasannivāsena, ", "ja186:2.6": "tenambo kaṭukapphalo”ti. ", "ja186:3.1": "Dadhivāhanajātakaṁ chaṭṭhaṁ. "}, "variant_text": {"ja186:0.1": "", "ja186:0.2": "", "ja186:0.3": "", "ja186:0.4": "", "ja186:1.1": "", "ja186:1.2": "", "ja186:1.3": "", "ja186:1.4": "", "ja186:2.1": "", "ja186:2.2": "", "ja186:2.3": "", "ja186:2.4": "sākhā → sākhaṁ (sya1ed, sya2ed, mr) | nisevare → nivīsare (mr) ", "ja186:2.5": "", "ja186:2.6": "", "ja186:3.1": ""}, "reference_text": {"ja186:0.1": "", "ja186:0.2": "", "ja186:0.3": "", "ja186:0.4": "", "ja186:1.1": "ms22J_453, msdiv71, pts-vp-pli2.106, sya27.67", "ja186:1.2": "", "ja186:1.3": "", "ja186:1.4": "", "ja186:2.1": "ms22J_454, msdiv72", "ja186:2.2": "", "ja186:2.3": "