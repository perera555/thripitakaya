{"html_text": {"ja60:0.1": "<article id='ja60'><header><ul><li class='division'>{}</li>", "ja60:0.2": "<li>{}</li>", "ja60:0.3": "<li>{}</li></ul>", "ja60:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja60:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja60:1.2": "<span class='verse-line'>{}</span>", "ja60:1.3": "<span class='verse-line'>{}</span>", "ja60:1.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja60:2.1": "<p class='endsutta'>{}</p>", "ja60:2.2": "<p class='endvagga'>{}</p>", "ja60:3.1": "<p class='uddana-intro'>{}</p>", "ja60:4.1": "<blockquote class='uddanagatha'><p><span class='verse-line'>{}</span>", "ja60:4.2": "<span class='verse-line'>{}</span>", "ja60:4.3": "<span class='verse-line'>{}</span>", "ja60:4.4": "<span class='verse-line'>{}</span></p></blockquote></article>"}, "root_text": {"ja60:0.1": "Jātaka ", "ja60:0.2": "Ekakanipāta ", "ja60:0.3": "Āsīsavagga ", "ja60:0.4": "10. Saṅkhadhamajātaka ", "ja60:1.1": "“Dhame dhame nātidhame, ", "ja60:1.2": "atidhantañhi pāpakaṁ; ", "ja60:1.3": "Dhantenādhigatā bhogā, ", "ja60:1.4": "te tāto vidhamī dhaman”ti. ", "ja60:2.1": "Saṅkhadhamajātakaṁ dasamaṁ. ", "ja60:2.2": "Āsīsavaggo chaṭṭho. ", "ja60:3.1": "Tassuddānaṁ ", "ja60:4.1": "Yathā icchiṁ tathāhudakā thalā, ", "ja60:4.2": "Sura sāduphalo ca alīnamano; ", "ja60:4.3": "Sampahaṭṭhamano caturo ca tayo, ", "ja60:4.4": "Sataladdhaka bhogadhanena dasāti. "}, "variant_text": {"ja60:0.1": "", "ja60:0.2": "", "ja60:0.3": "", "ja60:0.4": "", "ja60:1.1": "", "ja60:1.2": "", "ja60:1.3": "", "ja60:1.4": "", "ja60:2.1": "Saṅkhadhamajātakaṁ → saṅkhadhamanajātakaṁ (bj, sya1ed, sya2ed, pts-vp-pli1) ", "ja60:2.2": "Āsīsavaggo → āsiṁsavaggo (bj, sya1ed, sya2ed, pts-vp-pli1) ", "ja60:3.1": "", "ja60:4.1": "", "ja60:4.2": "", "ja60:4.3": "", "ja60:4.4": "bhogadhanena → bhogamanena (sya1ed, sya2ed) "}, "reference_text": {"ja60:0.1": "", "ja60:0.2": "", "ja60:0.3": "", "ja60:0.4": "", "ja60:1.1": "ms22J_131, msdiv60, pts-vp-pli1.284", "ja60:1.2": "", "ja60:1.3": "", "ja60:1.4": "", "ja60:2.1": "ms22J_132", "ja60:2.2": "", "ja60:3.1": "ms22J_133", "ja60:4.1": "csp1ed22.15, csp2ed22.15, ms22J_134, sya27.20", "ja60:4.2": "", "ja60:4.3": "", "ja60:4.4": ""}, "keys_order": ["ja60:0.1", "ja60:0.2", "ja60:0.3", "ja60:0.4", "ja60:1.1", "ja60:1.2", "ja60:1.3", "ja60:1.4", "ja60:2.1", "ja60:2.2", "ja60:3.1", "ja60:4.1", "ja60:4.2", "ja60:4.3", "ja60:4.4"]}