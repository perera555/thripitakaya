{"html_text": {"ja23:0.1": "<article id='ja23'><header><ul><li class='division'>{}</li>", "ja23:0.2": "<li>{}</li>", "ja23:0.3": "<li>{}</li></ul>", "ja23:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja23:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja23:1.2": "<span class='verse-line'>{}</span>", "ja23:1.3": "<span class='verse-line'>{}</span>", "ja23:1.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja23:2.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja23:0.1": "Jātaka ", "ja23:0.2": "Ekakanipāta ", "ja23:0.3": "Kuruṅgavagga ", "ja23:0.4": "3. Bhojājānīyajātaka ", "ja23:1.1": "“Api passena semāno, ", "ja23:1.2": "sallebhi sallalīkato; ", "ja23:1.3": "Seyyova vaḷavā bhojjo, ", "ja23:1.4": "yuñja maññeva sārathī”ti. ", "ja23:2.1": "Bhojājānīyajātakaṁ tatiyaṁ. "}, "variant_text": {"ja23:0.1": "", "ja23:0.2": "", "ja23:0.3": "", "ja23:0.4": "", "ja23:1.1": "", "ja23:1.2": "", "ja23:1.3": "bhojjo → bhojjho (sya1ed, sya2ed, pts-vp-pli1); gojo (csp1ed) ", "ja23:1.4": "", "ja23:2.1": "Bhojājānīyajātakaṁ → gojānīyajātakaṁ (csp1ed) "}, "reference_text": {"ja23:0.1": "", "ja23:0.2": "", "ja23:0.3": "", "ja23:0.4": "", "ja23:1.1": "ms22J_50, msdiv23, ndp22.8, pts-vp-pli1.180", "ja23:1.2": "", "ja23:1.3": "", "ja23:1.4": "", "ja23:2.1": "ms22J_51"}, "keys_order": ["ja23:0.1", "ja23:0.2", "ja23:0.3", "ja23:0.4", "ja23:1.1", "ja23:1.2", "ja23:1.3", "ja23:1.4", "ja23:2.1"]}