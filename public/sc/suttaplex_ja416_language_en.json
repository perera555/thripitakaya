[{"acronym": "Ja 416", "alt_acronym": null, "volpages": "PTS 3.418, PTS 3.419, PTS 3.420", "alt_volpages": null, "uid": "ja416", "blurb": "“Terror and fear”—The Master told this while dwelling in the Bamboo-grove, concerning Devadatta’s going about to kill him. They were discussing it in the Hall of Truth, “Sirs, Devadatta is going about to kill the Tathagata, he has hired bowmen, thrown down a rock, let loose Nalagiri, and uses special means for the destruction of the Tathagata.” The Master came and asked the subject of their discussion as they sat together: when they told him, he said, “Brethren, this is not the first time he has gone about to kill me: but he could not even make me afraid, and gained only sorrow for himself:” and so he told the tale of old.", "difficulty": null, "original_title": "Parantapajātaka", "root_lang": "pli", "root_lang_name": "Pāli", "type": "leaf", "translated_title": "Parantapa Jātaka", "translations": [{"lang": "pli", "lang_name": "Pāli", "is_root": true, "author": "Mahāsaṅgīti Tipiṭaka Buddhavasse 2500", "author_short": "ms", "author_uid": "ms", "publication_date": null, "id": "ja416_root-pli-ms", "segmented": true, "title": null, "volpage": null, "has_comment": false}, {"lang": "de", "lang_name": "Deutsch", "is_root": false, "author": "Dr. Julius Dutoit", "author_short": "Dutoit", "author_uid": "dutoit", "publication_date": "2007", "id": "de_ja416_dutoit", "segmented": false, "volpage": null, "has_comment": false}, {"author": "H.T. Francis, R.A. Neil", "author_short": "Francis …", "author_uid": "francis-neil", "has_comment": false, "id": "en_ja416_francis-neil", "is_root": false, "lang": "en", "lang_name": "English", "publication_date": "1897", "segmented": false, "volpage": null, "title": "Parantapa Jātaka"}, {"lang": "jpn", "lang_name": "日本語", "is_root": false, "author": "関西パーリ語実習会", "author_short": "関西パーリ語実習会", "author_uid": "kansai", "publication_date": "2023", "id": "jpn_ja416_kansai", "segmented": false, "volpage": null, "has_