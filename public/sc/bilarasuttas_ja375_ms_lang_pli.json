{"html_text": {"ja375:0.1": "<article id='ja375'><header><ul><li class='division'>{}</li>", "ja375:0.2": "<li>{}</li>", "ja375:0.3": "<li>{}</li></ul>", "ja375:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja375:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja375:1.2": "<span class='verse-line'>{}</span>", "ja375:1.3": "<span class='verse-line'>{}</span>", "ja375:1.4": "<span class='verse-line'>{}</span></p>", "ja375:2.1": "<p><span class='verse-line'>{}</span>", "ja375:2.2": "<span class='verse-line'>{}</span>", "ja375:2.3": "<span class='verse-line'>{}</span>", "ja375:2.4": "<span class='verse-line'>{}</span></p>", "ja375:3.1": "<p><span class='verse-line'>{}</span>", "ja375:3.2": "<span class='verse-line'>{}</span>", "ja375:3.3": "<span class='verse-line'>{}</span>", "ja375:3.4": "<span class='verse-line'>{}</span></p>", "ja375:4.1": "<p><span class='verse-line'>{}</span>", "ja375:4.2": "<span class='verse-line'>{}</span>", "ja375:4.3": "<span class='verse-line'>{}</span>", "ja375:4.4": "<span class='verse-line'>{}</span></p>", "ja375:5.1": "<p><span class='verse-line'>{}</span>", "ja375:5.2": "<span class='verse-line'>{}</span>", "ja375:5.3": "<span class='verse-line'>{}</span>", "ja375:5.4": "<span class='verse-line'>{}</span></p>", "ja375:6.1": "<p><span class='verse-line'>{}</span>", "ja375:6.2": "<span class='verse-line'>{}</span>", "ja375:6.3": "<span class='verse-line'>{}</span>", "ja375:6.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja375:7.1": "<p class='endsutta'>{}</p>", "ja375:7.2": "<p class='endvagga'>{}</p>", "ja375:8.1": "<p class='uddana-intro'>{}</p>", "ja375:9.1": "<blockquote class='uddanagatha'><p><span class='verse-line'>{}</span>", "ja375:9.2": "<span class='verse-line'>{}</span>", "ja375:9.3": "<span class='verse-line'>{}</span>", "ja375:9.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja375:10.1": "<p class='uddana-intro'>{}</p>", "ja375:11.1": "<blockquote class='uddanagatha'><p><span class='verse-line'>{}</span>", "ja375:11.2": "<span class='verse-line'>{}</span>", "ja375:11.3": "<span class='verse-line'>{}</span>", "ja375:11.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja375:12.1": "<p class='endsection'>{}</p></article>"}, "root_text": {"ja375:0.1": "Jātaka ", "ja375:0.2": "Pañcakanipāta ", "ja375:0.3": "Aḍḍhavagga ", "ja375:0.4": "5. Kapotajātaka ", "ja375:1.1": "“Idāni khomhi sukhito arogo, ", "ja375:1.2": "Nikkaṇṭako nippatito kapoto; ", "ja375:1.3": "Kāhāmi dānī hadayassa tuṭṭhiṁ, ", "ja375:1.4": "Tathāhimaṁ maṁsasākaṁ baleti”. ", "ja375:2.1": "“Kāyaṁ balākā sikhinī, ", "ja375:2.2": "corī laṅghipitāmahā; ", "ja375:2.3": "Oraṁ balāke āgaccha, ", "ja375:2.4": "caṇḍo me vāyaso sakhā”. ", "ja375:3.1": "“Alañhi te jagghitāye, ", "ja375:3.2": "Mamaṁ disvāna edisaṁ; ", "ja375:3.3": "Vilūnaṁ sūdaputtena, ", "ja375:3.4": "Piṭṭhamaṇḍena makkhitaṁ”. ", "ja375:4.1": "“Sunhāto suvilittosi, ", "ja375:4.2": "annapānena tappito; ", "ja375:4.3": "Kaṇṭhe ca te veḷuriyo, ", "ja375:4.4": "agamā nu kajaṅgalaṁ”. ", "ja375:5.1": "“Mā te mitto amitto vā, ", "ja375:5.2": "agamāsi kajaṅgalaṁ; ", "ja375:5.3": "Piñchāni tattha lāyitvā, ", "ja375:5.4": "kaṇṭhe bandhanti vaṭṭanaṁ”. ", "ja375:6.1": "“Punapāpajjasī samma, ", "ja375:6.2": "Sīlañhi tava tādisaṁ; ", "ja375:6.3": "Na hi mānusakā bhogā, ", "ja375:6.4": "Subhuñjā honti pakkhinā”ti. ", "ja375:7.1": "Kapotajātakaṁ pañcamaṁ. ", "ja375:7.2": "Aḍḍhavaggo tatiyo. ", "ja375:8.1": "Tassuddānaṁ ", "ja375:9.1": "Atha vaṇṇa sasīla hiri labhate, ", "ja375:9.2": "Sumukhā visa sāḷiyamittavaro; ", "ja375:9.3": "Atha cakka palāsa sarāja sato, ", "ja375:9.4": "Yava bāla kapotaka pannarasāti. ", "ja375:10.1": "Atha vagguddānaṁ ", "ja375:11.1": "Jīnañca vaṇṇaṁ asamaṁvaguppari, ", "ja375:11.2": "Sudesitā jātakanti santi vīsati; ", "ja375:11.3": "Mahesino brahmacarittamuttam- ", "ja375:11.4": "avoca gāthā atthavatī subyañjanāti. ", "ja375:12.1": "Pañcakanipātaṁ niṭṭhitaṁ. "}, "variant_text": {"ja375:0.1": "", "ja375:0.2": "", "ja375:0.3": "", "ja375:0.4": "", "ja375:1.1": "", "ja375:1.2": "", "ja375:1.3": "", "ja375:1.4": "", "ja375:2.1": "", "ja375:2.2": "", "ja375:2.3": "", "ja375:2.4": "", "ja375:3.1": "", "ja375:3.2": "", "ja375:3.3": "", "ja375:3.4": "Piṭṭhamaṇḍena → piṭṭhamaddena (bj); piṭṭhamaṭṭhena (sya1ed, sya2ed); pitthimaddena (pts-vp-pli1) ", "ja375:4.1": "", "ja375:4.2": "", "ja375:4.3": "", "ja375:4.4": "", "ja375:5.1": "", "ja375:5.2": "", "ja375:5.3": "", "ja375:5.4": "", "ja375:6.1": "", "ja375:6.2": "", "ja375:6.3": "", "ja375:6.4": "", "ja375:7.1": "Kapotajātakaṁ → kapotakajātakaṁ (sya1ed, sya2ed) ", "ja375:7.2": "", "ja375:8.1": "", "ja375:9.1": "", "ja375:9.2": "", "ja375:9.3": "", "ja375:9.4": "", "ja375:10.1": "", "ja375:11.1": "", "ja375:11.2": "jātakanti santi vīsati → jātaka pañcavīsati (?) ", "ja375:11.3": "", "ja375:11.4": "", "ja375:12.1": ""}, "reference_text": {"ja375:0.1": "", "ja375:0.2": "", "ja375:0.3": "", "ja375:0.4": "", "ja375:1.1": "ms22J_1306, msdiv135, ndp22.127, pts-vp-pli3.225", "ja375:1.2": "", "ja375:1.3": "", "ja375:1.4": "", "ja375:2.1": "csp1ed22.136, csp2ed22.136, ms22J_1307, msdiv136, pts-vp-pli3.226", "ja375:2.2": "", "ja375:2.3": "", "ja375:2.4": "", "ja375:3.1": "ms22J_1308, msdiv137", "ja375:3.2": "", "ja375:3.3": "", "ja375:3.4": "", "ja375:4.1": "ms22J_1309, msdiv138, sya27.186, vri68.115", "ja375:4.2": "", "ja375:4.3": "", "ja375:4.4": "", "ja375:5.1": "dr27.185, ms22J_1310, msdiv139", "ja375:5.2": "", "ja375:5.3": "", "ja375:5.4": "", "ja375:6.1": "ms22J_1311, msdiv140, pts-vp-pli3.227", "ja375:6.2": "", "ja375:6.3": "", "ja375:6.4": "", "ja375:7.1": "ms22J_1312", "ja375:7.2": "", "ja375:8.1": "ms22J_1313", "ja375:9.1": "ms22J_1314", "ja375:9.2": "", "ja375:9.3": "", "ja375:9.4": "", "ja375:10.1": "ms22J_1315", "ja375:11.1": "ms22J_1316", "ja375:11.2": "", "ja375:11.3": "", "ja375:11.4": "", "ja375:12.1": "ms22J_1317"}, "keys_order": ["ja375:0.1", "ja375:0.2", "ja375:0.3", "ja375:0.4", "ja375:1.1", "ja375:1.2",