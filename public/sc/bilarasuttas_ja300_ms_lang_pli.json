{"html_text": {"ja300:0.1": "<article id='ja300'><header><ul><li class='division'>{}</li>", "ja300:0.2": "<li>{}</li>", "ja300:0.3": "<li>{}</li></ul>", "ja300:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja300:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja300:1.2": "<span class='verse-line'>{}</span>", "ja300:1.3": "<span class='verse-line'>{}</span>", "ja300:1.4": "<span class='verse-line'>{}</span></p>", "ja300:2.1": "<p><span class='verse-line'>{}</span>", "ja300:2.2": "<span class='verse-line'>{}</span>", "ja300:2.3": "<span class='verse-line'>{}</span>", "ja300:2.4": "<span class='verse-line'>{}</span></p>", "ja300:3.1": "<p><span class='verse-line'>{}</span>", "ja300:3.2": "<span class='verse-line'>{}</span>", "ja300:3.3": "<span class='verse-line'>{}</span>", "ja300:3.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja300:4.1": "<p class='endsutta'>{}</p>", "ja300:4.2": "<p class='endvagga'>{}</p>", "ja300:5.1": "<p class='uddana-intro'>{}</p>", "ja300:6.1": "<blockquote class='uddanagatha'><p><span class='verse-line'>{}</span>", "ja300:6.2": "<span class='verse-line'>{}</span>", "ja300:6.3": "<span class='verse-line'>{}</span>", "ja300:6.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja300:7.1": "<p class='uddana-intro'>{}</p>", "ja300:8.1": "<blockquote class='uddanagatha'><p><span class='verse-line'>{}</span>", "ja300:8.2": "<span class='verse-line'>{}</span>", "ja300:8.3": "<span class='verse-line'>{}</span>", "ja300:8.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja300:9.1": "<p class='endsection'>{}</p></article>"}, "root_text": {"ja300:0.1": "Jātaka ", "ja300:0.2": "Tikanipāta ", "ja300:0.3": "Kumbhavagga ", "ja300:0.4": "10. Vakajātaka ", "ja300:1.1": "“Parapāṇarodhā jīvanto, ", "ja300:1.2": "maṁsalohitabhojano; ", "ja300:1.3": "Vako vataṁ samādāya, ", "ja300:1.4": "upapajji uposathaṁ. ", "ja300:2.1": "Tassa sakko vataññāya, ", "ja300:2.2": "ajarūpenupāgami; ", "ja300:2.3": "Vītatapo ajjhappatto, ", "ja300:2.4": "bhañji lohitapo tapaṁ. ", "ja300:3.1": "Evameva idhekacce, ", "ja300:3.2": "Samādānamhi dubbalā; ", "ja300:3.3": "Lahuṁ karonti attānaṁ, ", "ja300:3.4": "Vakova ajakāraṇā”ti. ", "ja300:4.1": "Vakajātakaṁ dasamaṁ. ", "ja300:4.2": "Kumbhavaggo pañcamo. ", "ja300:5.1": "Tassuddānaṁ ", "ja300:6.1": "Varakumbha supattasirivhayano, ", "ja300:6.2": "Sucisammata bindusaro cusabho; ", "ja300:6.3": "Saritaṁpati caṇḍi jarākapinā, ", "ja300:6.4": "Atha makkaṭiyā vakakena dasāti. ", "ja300:7.1": "Atha vagguddānaṁ ", "ja300:8.1": "Saṅkappo padumo ceva, ", "ja300:8.2": "Udapānena tatiyaṁ; ", "ja300:8.3": "Abbhantaraṁ ghaṭabhedaṁ, ", "ja300:8.4": "Tikanipātamhilaṅkatanti. ", "ja300:9.1": "Tikanipātaṁ niṭṭhitaṁ. "}, "variant_text": {"ja300:0.1": "", "ja300:0.2": "", "ja300:0.3": "", "ja300:0.4": "", "ja300:1.1": "Parapāṇarodhā → parapāṇaghāte (sya1ed, sya2ed); parapāṇarocaṁ (mr) ", "ja300:1.2": "", "ja300:1.3": "", "ja300:1.4": "", "ja300:2.1": "", "ja300:2.2": "", "ja300:2.3": "", "ja300:2.4": "", "ja300:3.1": "", "ja300:3.2": "", "ja300:3.3": "", "ja300:3.4": "", "ja300:4.1": "Vakajātakaṁ → bakajātakaṁ (sya1ed, sya2ed) ", "ja300:4.2": "", "ja300:5.1": "", "ja300:6.1": "", "ja300:6.2": "", "ja300:6.3": "", "ja300:6.4": "", "ja300:7.1": "", "ja300:8.1": "", "ja300:8.2": "", "ja300:8.3": "", "ja300:8.4": "", "ja300:9.1": ""}, "reference_text": {"ja300:0.1": "", "ja300:0.2": "", "ja300:0.3": "", "ja300:0.4": "", "ja300:1.1": "ms22J_874, msdiv148, pts-vp-pli2.450, vri68.80", "ja300:1.2": "", "ja300:1.3": "", "ja300:1.4": "", "ja300:2.1": "ms22J_875, msdiv149, ndp22.85", "ja300:2.2": "", "ja300:2.3": "", "ja300:2.4": "", "ja300:3.1": "csp1ed22.92, csp2ed22.92, dr27.127, ms22J_876, msdiv150, pts-vp-pli2.451", "ja300:3.2": "", "ja300:3.3": "", "ja300:3.4": "", "ja300:4.1": "ms22J_877", "ja300:4.2": "", "ja300:5.1": "ms22J_878", "ja300:6.1": "ms22J_879, sya27.127", "ja300:6.2": "", "ja300:6.3": "", "ja300:6.4": "", "ja300:7.1": "ms22J_880", "ja300:8.1":