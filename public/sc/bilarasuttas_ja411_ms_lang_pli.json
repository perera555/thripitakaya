{"html_text": {"ja411:0.1": "<article id='ja411'><header><ul><li class='division'>{}</li>", "ja411:0.2": "<li>{}</li>", "ja411:0.3": "<li>{}</li></ul>", "ja411:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja411:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja411:1.2": "<span class='verse-line'>{}</span>", "ja411:1.3": "<span class='verse-line'>{}</span>", "ja411:1.4": "<span class='verse-line'>{}</span></p>", "ja411:2.1": "<p><span class='verse-line'>{}</span>", "ja411:2.2": "<span class='verse-line'>{}</span>", "ja411:2.3": "<span class='verse-line'>{}</span>", "ja411:2.4": "<span class='verse-line'>{}</span></p>", "ja411:3.1": "<p><span class='verse-line'>{}</span>", "ja411:3.2": "<span class='verse-line'>{}</span>", "ja411:3.3": "<span class='verse-line'>{}</span>", "ja411:3.4": "<span class='verse-line'>{}</span></p>", "ja411:4.1": "<p><span class='verse-line'>{}</span>", "ja411:4.2": "<span class='verse-line'>{}</span>", "ja411:4.3": "<span class='verse-line'>{}</span>", "ja411:4.4": "<span class='verse-line'>{}</span></p>", "ja411:5.1": "<p><span class='verse-line'>{}</span>", "ja411:5.2": "<span class='verse-line'>{}</span>", "ja411:5.3": "<span class='verse-line'>{}</span>", "ja411:5.4": "<span class='verse-line'>{}</span></p>", "ja411:6.1": "<p><span class='verse-line'>{}</span>", "ja411:6.2": "<span class='verse-line'>{}</span>", "ja411:6.3": "<span class='verse-line'>{}</span>", "ja411:6.4": "<span class='verse-line'>{}</span></p>", "ja411:7.1": "<p><span class='verse-line'>{}</span>", "ja411:7.2": "<span class='verse-line'>{}</span>", "ja411:7.3": "<span class='verse-line'>{}</span>", "ja411:7.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja411:8.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja411:0.1": "Jātaka ", "ja411:0.2": "Sattakanipāta ", "ja411:0.3": "Gandhāravagga ", "ja411:0.4": "6. Susīmajātaka ", "ja411:1.1": "“Kāḷāni kesāni pure ahesuṁ, ", "ja411:1.2": "Jātāni sīsamhi yathāpadese; ", "ja411:1.3": "Tānajja setāni susīma disvā, ", "ja411:1.4": "Dhammaṁ cara brahmacariyassa kālo”. ", "ja411:2.1": "“Mameva deva palitaṁ na tuyhaṁ, ", "ja411:2.2": "Mameva sīsaṁ mama uttamaṅgaṁ; ", "ja411:2.3": "‘Atthaṁ karissan’ti musā abhāṇiṁ, ", "ja411:2.4": "Ekāparādhaṁ khama rājaseṭṭha. ", "ja411:3.1": "Daharo tuvaṁ dassaniyosi rāja, ", "ja411:3.2": "Paṭhamuggato hosi yathā kaḷīro; ", "ja411:3.3": "Rajjañca kārehi mamañca passa, ", "ja411:3.4": "Mā kālikaṁ anudhāvī janinda”. ", "ja411:4.1": "“Passāmi vohaṁ dahariṁ kumāriṁ, ", "ja411:4.2": "Sāmaṭṭhapassaṁ sutanuṁ sumajjhaṁ; ", "ja411:4.3": "Kāḷappavāḷāva pavellamānā, ", "ja411:4.4": "Palobhayantīva naresu gacchati. ", "ja411:5.1": "Tamena passāmiparena nāriṁ, ", "ja411:5.2": "Āsītikaṁ nāvutikaṁ va jaccā; ", "ja411:5.3": "Daṇḍaṁ gahetvāna pavedhamānaṁ, ", "ja411:5.4": "Gopānasībhoggasamaṁ carantiṁ. ", "ja411:6.1": "Sohaṁ tamevānuvicintayanto, ", "ja411:6.2": "Eko sayāmi sayanassa majjhe; ", "ja411:6.3": "‘Ahampi evaṁ’ iti pekkhamāno, ", "ja411:6.4": "Na gahe rame brahmacariyassa kālo. ", "ja411:7.1": "Rajjuvālambanī cesā, ", "ja411:7.2": "Yā gehe vasato rati; ", "ja411:7.3": "Evampi chetvāna vajanti dhīrā, ", "ja411:7.4": "Anapekkhino kāmasukhaṁ pahāyā”ti. ", "ja411:8.1": "Susīmajātakaṁ chaṭṭhaṁ. "}, "variant_text": {"ja411:0.1": "", "ja411:0.2": "", "ja411:0.3": "", "ja411:0.4": "", "ja411:1.1": "", "ja411:1.2": "", "ja411:1.3": "susīma → susima (mr) ", "ja411:1.4": "", "ja411:2.1": "", "ja411:2.2": "", "ja411:2.3": "abhāṇiṁ → abhāsiṁ (mr) ", "ja411:2.4": "", "ja411:3.1": "", "ja411:3.2": "hosi → hohi (bj); hoti (mr) ", "ja411:3.3": "", "ja411:3.4": "", "ja411:4.1": "", "ja411:4.2": "", "ja411:4.3": "", "ja411:4.4": "Palobhayantīva → sā lobhayantīva (pts-vp-pli1) ", "ja411:5.1": "", "ja411:5.2": "", "ja411:5.3": "", "ja411:5.4": "", "ja411:6.1": "", "ja411:6.2": "sayāmi → passāmi (mr) ", "ja411:6.3": "", "ja411:6.4": "Na gahe rame → na gehe rame (bj); gehe na rame (sya1ed, sya2ed, mr) ", "ja411:7.1": "", "ja411:7.2": "", "ja411:7.3": "", "ja411:7.4": "", "ja411:8.1": ""}, "reference_text": {"ja411:0.1": "", "ja411:0.2": "", "ja411:0.3": "", "ja411:0.4": "", "ja411:1.1": "bj30.290, csp1ed22.169, csp2ed22.169, ms22J_1615, msdiv114, pts-vp-pli3.393", "ja411:1.2": "", "ja411:1.3": "", "ja411:1.4": "", "ja411:2.1": "dr27.229, ms22J_1616, msdiv115, pts-vp-pli3.394, sya27.230", "ja411:2.2": "", "ja411:2.3": "", "ja411:2.4": "", "ja411:3.1": "ms22J_1617, msdiv116, ndp22.161", "ja411:3.2": "", "ja411:3.3": "", "ja411:3.4": "", "ja411:4.1": "ms22J_1618, msdiv117, pts-vp-pli3.395", "ja411:4.2": "", "ja411:4.3": "", "ja411:4.4": "", "ja411:5.1": "ms22J_1619, msdiv118", "ja411:5.2": "", "ja411:5.3": "", "ja411:5.4": "", "ja411:6.1": "ms22J_1620, msdiv119, pts-vp-pli3.396", "ja411:6.2": "", "ja411:6.3": "", "ja411:6.4": "", "ja411:7.1": "csp1ed22.170, csp2ed22.170, dr27.230, ms22J_1621, msdiv120, sya27.231", "ja411:7.2": "", "ja411:7.3": "", "ja411:7.4": "", "ja411:8.1": "ms22J_1622"}, "keys_order": ["ja411:0.1", "ja411:0.2", "ja411:0.3", "ja411:0.4", "ja411:1.1", "ja411:1.2", "ja411:1.3", "ja411:1.4", "ja411:2.1", "ja411:2.2", "ja411:2.3", "ja411:2.4", "ja411:3.1", "ja411:3.2", "ja411:3.3", "ja411:3.4", "ja411:4.1", "ja411:4.2", "ja411:4.3", "ja411:4.4", "ja411:5.1", "ja411:5.2", "ja411:5.3", "ja411:5.4", "ja411:6.1", "ja411:6.2", "ja411:6.3", "ja411:6.4", "ja411:7.1", "ja411:7.2", "ja411:7.3", "ja411:7.4", "ja411:8.1"]}