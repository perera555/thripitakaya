p>", "ja505:28.1": "<p><span class='verse-line'>{}</span>", "ja505:28.2": "<span class='verse-line'>{}</span>", "ja505:28.3": "<span class='verse-line'>{}</span>", "ja505:28.4": "<span class='verse-line'>{}</span></p>", "ja505:29.1": "<p><span class='verse-line'>{}</span>", "ja505:29.2": "<span class='verse-line'>{}</span>", "ja505:29.3": "<span class='verse-line'>{}</span>", "ja505:29.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja505:30.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja505:0.1": "Jātaka ", "ja505:0.2": "Vīsatinipāta ", "ja505:0.3": "Mātaṅgavagga ", "ja505:0.4": "9. Somanassajātaka ", "ja505:1.1": "“Ko taṁ hiṁsati heṭheti, ", "ja505:1.2": "Kiṁ dummano socasi appatīto; ", "ja505:1.3": "Kassajja mātāpitaro rudantu, ", "ja505:1.4": "Kvajja setu nihato pathabyā”. ", "ja505:2.1": "“Tuṭṭhosmi deva tava dassanena, ", "ja505:2.2": "Cirassaṁ passāmi taṁ bhūmipāla; ", "ja505:2.3": "Ahiṁsako reṇumanuppavissa, ", "ja505:2.4": "Puttena te heṭhayitosmi deva”. ", "ja505:3.1": "“Āyantu dovārikā khaggabandhā, ", "ja505:3.2": "Kāsāviyā yantu antepurantaṁ; ", "ja505:3.3": "Hantvāna taṁ somanassaṁ kumāraṁ, ", "ja505:3.4": "Chetvāna sīsaṁ varamāharantu”. ", "ja505:4.1": "“Pesitā rājino dūtā, ", "ja505:4.2": "kumāraṁ etadabravuṁ; ", "ja505:4.3": "Issarena vitiṇṇosi, ", "ja505:4.4": "vadhaṁ pattosi khattiya”. ", "ja505:5.1": "“Sa rājaputto paridevayanto, ", "ja505:5.2": "Dasaṅguliṁ añjaliṁ paggahetvā; ", "ja505:5.3": "Ahampi icchāmi janinda daṭṭhuṁ, ", "ja505:5.4": "Jīvaṁ maṁ netvā paṭidassayetha”. ", "ja505:6.1": "Tassa taṁ vacanaṁ sutvā, ", "ja505:6.2": "rañño puttaṁ adassayuṁ; ", "ja505:6.3": "Putto ca pitaraṁ disvā, ", "ja505:6.4": "dūratovajjhabhāsatha. ", "ja505:7.1": "“Āgacchuṁ dovārikā khaggabandhā, ", "ja505:7.2": "Kāsāviyā hantu mamaṁ janinda; ", "ja505:7.3": "Akkhāhi me pucchito etamatthaṁ, ", "ja505:7.4": "Aparādho ko nidha mamajja atthi”. ", "ja505:8.1": "“Sāyañca pāto udakaṁ sajāti, ", "ja505:8.2": "Aggiṁ sadā pāricaratappamatto; ", "ja505:8.3": "Taṁ tādisaṁ saṁyataṁ brahmacāriṁ, ", "ja505:8.4": "Kasmā tuvaṁ brūsi gahappatīti”. ", "ja505:9.1": "“Tālā ca mūlā ca phalā ca deva, ", "ja505:9.2": "Pariggahā vividhā santimassa; ", "ja505:9.3": "Te rakkhati gopayatappamatto, ", "ja505:9.4": "Tasmā ahaṁ brūmi gahappatīti”. ", "ja505:10.1": "“Saccaṁ kho etaṁ vadasi kumāra, ", "ja505:10.2": "Pariggahā vividhā santimassa; ", "ja505:10.3": "Te rakkhati gopayatappamatto, ", "ja505:10.4": "Sa brāhmaṇo gahapati tena hoti”. ", "ja505:11.1": "“Suṇantu mayhaṁ parisā samāgatā, ", "ja505:11.2": "Sanegamā jānapadā ca sabbe; ", "ja505:11.3": "Bālāyaṁ bālassa vaco nisamma, ", "ja505:11.4": "Ahetunā ghātayate maṁ janindo. ", "ja505:12.1": "Daḷhasmi mūle visaṭe virūḷhe, ", "ja505:12.2": "Dunnikkayo veḷu pasākhajāto; ", "ja505:12.3": "Vandāmi pādāni tava janinda, ", "ja505:12.4": "Anujāna maṁ pabbajissāmi deva”. ", "ja505:13.1": "“Bhuñjassu bhoge vipule kumāra, ", "ja505:13.2": "Sabbañca te issariyaṁ dadāmi; ", "ja505:13.3": "Ajjeva tvaṁ kurūnaṁ hohi rājā, ", "ja505:13.4": "Mā pabbajī pabbajjā hi dukkhā”. ", "ja505:14.1": "“Kinnūdha deva tavamatthi bhogā, ", "ja505:14.2": "Pubbevahaṁ devaloke ramissaṁ; ", "ja505:14.3": "Rūpehi saddehi atho rasehi, ", "ja505:14.4": "Gandhehi phassehi manoramehi. ", "ja505:15.1": "Bhuttā ca me bhogā tidivasmiṁ deva, ", "ja505:15.2": "Parivārito accharānaṁ gaṇena; ", "ja505:15.3": "Tuvañca bālaṁ paraneyyaṁ viditvā, ", "ja505:15.4": "Na tādise rājakule vaseyyaṁ”. ", "ja505:16.1": "“Sacāhaṁ bālo paraneyyo asmi, ", "ja505:16.2": "Ekāparādhaṁ khama putta mayhaṁ; ", "ja505:16.3": "Punapi ce edisakaṁ bhaveyya, ", "ja505:16.4": "Yathāmatiṁ somanassa karohi”. ", "ja505:17.1": "“Anisamma kataṁ kammaṁ, ", "ja505:17.2": "anavatthāya cintitaṁ; ", "ja505:17.3": "Bhesajjasseva vebhaṅgo, ", "ja505:17.4": "vipāko hoti pāpako. ", "ja505:18.1": "Nisamma ca kataṁ kammaṁ, ", "ja505:18.2": "sammāvatthāya cintitaṁ; ", "ja505:18.3": "Bhesajjasseva sampatti, ", "ja505:18.4": "vipāko hoti bhadrako. ", "ja505:19.1": "Alaso gihī kāmabhogī na sādhu, ", "ja505:19.2": "Asaññato pabbajito na sādhu; ", "ja505:19.3": "Rājā na sādhu anisammakārī, ", "ja505:19.4": "Yo paṇḍito kodhano taṁ na sādhu. ", "ja505:20.1": "Nisamma khattiyo kayirā, ", "ja505:20.2": "nānisamma disampati; ", "ja505:20.3": "Nisammakārino rāja, ", "ja505:20.4": "yaso kitti ca vaḍḍhati. ", "ja505:21.1": "Nisamma daṇḍaṁ paṇayeyya issaro, ", "ja505:21.2": "Vegā kataṁ tappati bhūmipāla; ", "ja505:21.3": "Sammāpaṇīdhī ca narassa atthā, ", "ja505:21.4": "Anānutappā te bhavanti pacchā. ", "ja505:22.1": "Anānutappāni hi ye karonti, ", "ja505:22.2": "Vibhajja kammāyatanāni loke; ", "ja505:22.3": "Viññuppasatthāni sukhudrayāni, ", "ja505:22.4": "Bhavanti buddhānumatāni tāni. ", "ja505:23.1": "Āgacchuṁ dovārikā khaggabandhā, ", "ja505:23.2": "Kāsāviyā hantu mamaṁ janinda; ", "ja505:23.3": "Mātuñca aṅkasmimahaṁ nisinno, ", "ja505:23.4": "Ākaḍḍhito sahasā tehi deva. ", "ja505:24.1": "Kaṭukañhi sambādhaṁ sukicchaṁ patto, ", "ja505:24.2": "Madhurampi yaṁ jīvitaṁ laddha rāja; ", "ja505:24.3": "Kicchenahaṁ ajja vadhā pamutto, ", "ja505:24.4": "Pabbajjamevābhimanohamasmi”. ", "ja505:25.1": "“Putto tavāyaṁ taruṇo sudhamme, ", "ja505:25.2": "Anukampako somanasso kumāro; ", "ja505:25.3": "Taṁ yācamāno na labhāmi svajja, ", "ja505:25.4": "Arahasi naṁ yācitave tuvampi”. ", "ja505:26.1": "“Ramassu bhikkhācariyāya putta, ", "ja505:26.2": "Nisamma dhammesu paribbajassu; ", "ja505:26.3": "Sabbesu bhūtesu nidhāya daṇḍaṁ, ", "ja505:26.4": "Anindito brahmamupehi ṭhānaṁ”. ", "ja505:27.1": "“Acchera rūpaṁ vata yādisañca, ", "ja505:27.2": "Dukkhitaṁ maṁ dukkhāpayase sudhamme; ", "ja505:27.3": "Yācassu puttaṁ iti vuccamānā, ", "ja505:27.4": "Bhiyyova ussāhayase kumāraṁ”. ", "ja505:28.1": "“Ye vippamuttā anavajjabhogino, ", "ja505:28.2": "Parinibbutā lokamimaṁ caranti; ", "ja505:28.3": "Tamariyamaggaṁ paṭipajjamānaṁ, ", "ja505:28.4": "Na ussahe vārayituṁ kumāraṁ”. ", "ja505:29.1": "“Addhā have sevitabbā sapaññā, ", "ja505:29.2": "Bahussutā ye bahuṭhānacintino; ", "ja505:29.3": "Yesāyaṁ sutvāna subhāsitāni, ", "ja505:29.4": "Appossukkā vītasokā sudhammā”ti. ", "ja505:30.1": "Somanassajātakaṁ navamaṁ. "}, "variant_text": {"ja505:0.1": "", "ja505:0.2": "", "ja505:0.3": "", "ja505:0.4": "", "ja505:1.1": "", "ja505:1.2": "Kiṁ → kinnu (pts-vp-pli1, mr) ", "ja505:1.3": "", "ja505:1.4": "Kvajja setu → ko nvajja seti (mr); ko ajja setu (?) ", "ja505:2.1": "tava → tavaṁ (bj, pts-vp-pli1) ", "ja505:2.2": "", "ja505:2.3": "", "ja505:2.4": "heṭhayitosmi → pothayitosmi (mr) ", "ja505:3.1": "khaggabandhā → khaggabaddhā (bj, pts-vp-pli1) | yantu → hantu (mr) ", "ja505:3.2": "", "ja505:3.3": "", "ja505:3.4": "", "ja505:4.1": "", "ja505:4.2": "", "ja505:4.3": "", "ja505:4.4": "", "ja505:5.1": "Sa → idaṁ bj, sya1ed, sya2ed, pts-vp-pli1 potthakesu ", "ja505:5.2": "", "ja505:5.3": "", "ja505:5.4": "Jīvaṁ maṁ netvā → jīvaṁ panetvā (bj, pts-vp-pli1) ", "ja505:6.1": "", "ja505:6.2": "", "ja505:6.3": "", "ja505:6.4": "", "ja505:7.1": "Āgacchuṁ → āgañchuṁ (bj); āgañchu (pts-vp-pli1) ", "ja505:7.2": "", "ja505:7.3": "", "ja505:7.4": "", "ja505:8.1": "", "ja505:8.2": "", "ja505:8.3": "", "ja505:8.4": "", "ja505:9.1": "", "ja505:9.2": "", "ja505:9.3": "", "ja505:9.4": "Tasmā ahaṁ brūmi gahappatīti” → brāhmaṇo gahapati tena hoti (si, pts1ed) ", "ja505:10.1": "", "ja505:10.2": "", "ja505:10.3": "", "ja505:10.4": "", "ja505:11.1": "", "ja505:11.2": "", "ja505:11.3": "", "ja505:11.4": "ghātayate maṁ → ghātayate (bj, pts-vp-pli1) ", "ja505:12.1": "", "ja505:12.2": "", "ja505:12.3": "", "ja505:12.4": "", "ja505:13.1": "", "ja505:13.2": "", "ja505:13.3": "", "ja505:13.4": "", "ja505:14.1": "", "ja505:14.2": "Pubbevahaṁ → pubbe cahaṁ (mr) ", "ja505:14.3": "", "ja505:14.4": "", "ja505:15.1": "Bhuttā ca me → bhuttā me (bj, pts-vp-pli1) ", "ja505:15.2": "Parivārito → parivāritā (bj, pts-vp-pli1); paricāritā (mr) | accharānaṁ gaṇena → accharāsaṁ gaṇena (sya1ed, sya2ed, pts-vp-pli1, mr) ", "ja505:15.3": "Tuvañca → tavañca (pts-vp-pli1) ", "ja505:1