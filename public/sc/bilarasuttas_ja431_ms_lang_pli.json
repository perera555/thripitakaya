{"html_text": {"ja431:0.1": "<article id='ja431'><header><ul><li class='division'>{}</li>", "ja431:0.2": "<li>{}</li>", "ja431:0.3": "<li>{}</li></ul>", "ja431:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja431:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja431:1.2": "<span class='verse-line'>{}</span>", "ja431:1.3": "<span class='verse-line'>{}</span>", "ja431:1.4": "<span class='verse-line'>{}</span></p>", "ja431:2.1": "<p><span class='verse-line'>{}</span>", "ja431:2.2": "<span class='verse-line'>{}</span>", "ja431:2.3": "<span class='verse-line'>{}</span>", "ja431:2.4": "<span class='verse-line'>{}</span></p>", "ja431:3.1": "<p><span class='verse-line'>{}</span>", "ja431:3.2": "<span class='verse-line'>{}</span>", "ja431:3.3": "<span class='verse-line'>{}</span>", "ja431:3.4": "<span class='verse-line'>{}</span></p>", "ja431:4.1": "<p><span class='verse-line'>{}</span>", "ja431:4.2": "<span class='verse-line'>{}</span>", "ja431:4.3": "<span class='verse-line'>{}</span>", "ja431:4.4": "<span class='verse-line'>{}</span></p>", "ja431:5.1": "<p><span class='verse-line'>{}</span>", "ja431:5.2": "<span class='verse-line'>{}</span>", "ja431:5.3": "<span class='verse-line'>{}</span>", "ja431:5.4": "<span class='verse-line'>{}</span></p>", "ja431:6.1": "<p><span class='verse-line'>{}</span>", "ja431:6.2": "<span class='verse-line'>{}</span>", "ja431:6.3": "<span class='verse-line'>{}</span>", "ja431:6.4": "<span class='verse-line'>{}</span></p>", "ja431:7.1": "<p><span class='verse-line'>{}</span>", "ja431:7.2": "<span class='verse-line'>{}</span>", "ja431:7.3": "<span class='verse-line'>{}</span>", "ja431:7.4": "<span class='verse-line'>{}</span></p>", "ja431:8.1": "<p><span class='verse-line'>{}</span>", "ja431:8.2": "<span class='verse-line'>{}</span>", "ja431:8.3": "<span class='verse-line'>{}</span>", "ja431:8.4": "<span class='verse-line'>{}</span></p>", "ja431:9.1": "<p><span class='verse-line'>{}</span>", "ja431:9.2": "<span class='verse-line'>{}</span>", "ja431:9.3": "<span class='verse-line'>{}</span>", "ja431:9.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja431:10.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja431:0.1": "Jātaka ", "ja431:0.2": "Navakanipāta ", "ja431:0.3": "Gijjhavagga ", "ja431:0.4": "5. Haritacajātaka ", "ja431:1.1": "“Sutaṁ metaṁ mahābrahme, ", "ja431:1.2": "kāme bhuñjati hārito; ", "ja431:1.3": "Kaccetaṁ vacanaṁ tucchaṁ, ", "ja431:1.4": "kacci suddho iriyyasi”. ", "ja431:2.1": "“Evametaṁ mahārāja, ", "ja431:2.2": "yathā te vacanaṁ sutaṁ; ", "ja431:2.3": "Kummaggaṁ paṭipannosmi, ", "ja431:2.4": "mohaneyyesu mucchito”. ", "ja431:3.1": "“Adu paññā kimatthiyā, ", "ja431:3.2": "nipuṇā sādhucintinī; ", "ja431:3.3": "Yāya uppatitaṁ rāgaṁ, ", "ja431:3.4": "kiṁ mano na vinodaye”. ", "ja431:4.1": "“Cattārome mahārāja, ", "ja431:4.2": "loke atibalā bhusā; ", "ja431:4.3": "Rāgo doso mado moho, ", "ja431:4.4": "yattha paññā na gādhati”. ", "ja431:5.1": "“Arahā sīlasampanno, ", "ja431:5.2": "suddho carati hārito; ", "ja431:5.3": "Medhāvī paṇḍito ceva, ", "ja431:5.4": "iti no sammato bhavaṁ”. ", "ja431:6.1": "“Medhāvīnampi hiṁsanti, ", "ja431:6.2": "isiṁ dhammaguṇe rataṁ; ", "ja431:6.3": "Vitakkā pāpakā rāja, ", "ja431:6.4": "subhā rāgūpasaṁhitā”. ", "ja431:7.1": "“Uppannāyaṁ sarīrajo, ", "ja431:7.2": "Rāgo vaṇṇavidūsano tava; ", "ja431:7.3": "Taṁ pajaha bhaddamatthu te, ", "ja431:7.4": "Bahunnāsi medhāvisammato”. ", "ja431:8.1": "“Te andhakārake kāme, ", "ja431:8.2": "Bahudukkhe mahāvise; ", "ja431:8.3": "Tesaṁ mūlaṁ gavesissaṁ, ", "ja431:8.4": "Checchaṁ rāgaṁ sabandhanaṁ”. ", "ja431:9.1": "“Idaṁ vatvāna hārito, ", "ja431:9.2": "isi saccaparakkamo; ", "ja431:9.3": "Kāmarāgaṁ virājetvā, ", "ja431:9.4": "brahmalokūpago ahū”ti. ", "ja431:10.1": "Haritacajātakaṁ pañcamaṁ. "}, "variant_text": {"ja431:0.1": "", "ja431:0.2": "", "ja431:0.3": "", "ja431:0.4": "", "ja431:1.1": "", "ja431:1.2": "", "ja431:1.3": "", "ja431:1.4": "", "ja431:2.1": "", "ja431:2.2": "", "ja431:2.3": "", "ja431:2.4": "", "ja431:3.1": "Adu → ādu (bj, pts-vp-pli1) ", "ja431:3.2": "sādhucintinī → sādhu cintanī (bj, pts-vp-pli1) ", "ja431:3.3": "", "ja431:3.4": "", "ja431:4.1": "", "ja431:4.2": "", "ja431:4.3": "", "ja431:4.4": "", "ja431:5.1": "", "ja431:5.2": "", "ja431:5.3": "", "ja431:5.4": "", "ja431:6.1": "", "ja431:6.2": "", "ja431:6.3": "", "ja431:6.4": "", "ja431:7.1": "", "ja431:7.2": "", "ja431:7.3": "", "ja431:7.4": "", "ja431:8.1": "andhakārake → andhakaraṇe (bj, sya1ed, sya2ed, pts-vp-pli1) ", "ja431:8.2": "", "ja431:8.3": "", "ja431:8.4": "", "ja431:9.1": "", "ja431:9.2": "", "ja431:9.3": "", "ja431:9.4": "", "ja431:10.1": "Haritacajātakaṁ → hāritajātakaṁ (bj, pts-vp-pli1) "}, "reference_text": {"ja431:0.1": "", "ja431:0.2": "", "ja431:0.3": "", "ja431:0.4": "", "ja431:1.1": "ms22J_1824, msdiv40, pts-vp-pli3.498", "ja431:1.2": "", "ja431:1.3": "", "ja431:1.4": "", "ja431:2.1": "dr27.258, ms22J_1825, msdiv41, pts-vp-pli3.499, sya27.259", "ja431:2.2": "", "ja431:2.3": "", "ja431:2.4": "", "ja431:3.1": "ms22J_1826, msdiv42", "ja431:3.2": "", "ja431:3.3": "", "ja431:3.4": "", "ja431:4.1": "ms22J_1827, msdiv43, ndp22.184", "ja431:4.2": "", "ja431:4.3": "", "ja431:4.4": "", "ja431:5.1": "ms22J_1828, msdiv44, pts-vp-pli3.500", "ja431:5.2": "", "ja431:5.3": "", "ja431:5.4": "", "ja431:6.1": "ms22J_1829, msdiv45", "ja431:6.2": "", "ja431:6.3": "", "ja431:6.4": "", "ja431:7.1": "csp1ed22.192, csp2ed22.192, ms22J_1830, msdiv46", "ja431:7.2": "", "ja431:7.3": "", "ja431:7.4": "", "ja431:8.1": "ms22J_1831, msdiv47", "ja431:8.2": "", "ja431:8.3": "", "ja431:8.4": "", "ja431:9.1": "ms22J_1832, msdiv48, pts-vp-pli3.501, vri68.157", "ja431:9.2": "", "ja431:9.3": "", "ja431:9.4": "", "ja431:10.1": "ms22J_1833"}, "keys_order": ["ja431:0.1", "ja431:0.2", "ja431:0.3", "ja431:0.4", "ja431:1.1", "ja431:1.2", "ja431:1.3", "ja431:1.4", "ja431:2.1", "ja431:2.2", "ja431:2.3", "ja431:2.4", "ja431:3.1", "ja431:3.2", "ja431:3.3", "ja431:3.4", "ja431:4.1", "ja43