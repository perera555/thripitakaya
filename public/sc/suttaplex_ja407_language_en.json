[{"acronym": "Ja 407", "alt_acronym": null, "volpages": "PTS 3.373", "alt_volpages": null, "uid": "ja407", "blurb": "“You made yourself”—The Master told this while dwelling in Jetavana, concerning good works towards one’s relatives. The occasion will appear in the Bhaddasala Birth. They began talking in the Hall of Truth, saying, “The supreme Buddha does good works towards his relatives.” When the Master had asked and been told their theme, he said, “Brethren, this is not the first time a Tathagata has done good works towards his relatives,” and so he told a tale of old time.", "difficulty": null, "original_title": "Mahākapijātaka", "root_lang": "pli", "root_lang_name": "Pāli", "type": "leaf", "translated_title": "Mahakapi Jātaka", "translations": [{"lang": "pli", "lang_name": "Pāli", "is_root": true, "author": "Mahāsaṅgīti Tipiṭaka Buddhavasse 2500", "author_short": "ms", "author_uid": "ms", "publication_date": null, "id": "ja407_root-pli-ms", "segmented": true, "title": null, "volpage": null, "has_comment": false}, {"lang": "de", "lang_name": "Deutsch", "is_root": false, "author": "Dr. Julius Dutoit", "author_short": "Dutoit", "author_uid": "dutoit", "publication_date": "2007", "id": "de_ja407_dutoit", "segmented": false, "volpage": null, "has_comment": false}, {"author": "H.T. Francis, R.A. Neil", "author_short": "Francis …", "author_uid": "francis-neil", "has_comment": false, "id": "en_ja407_francis-neil", "is_root": false, "lang": "en", "lang_name": "English", "publication_date": "1897", "segmented": false, "volpage": null, "title": "Mahakapi Jātaka"}, {"lang": "jpn", "lang_name": "日本語", "is_root": false, "author": "関西パーリ語実習会", "author_short": "関西パーリ語実習会", "author_uid": "kansai", "publication_date": "2023", "id": "jpn_ja407_kansai", "segmented": false, "volpage": null, "has_comment": false}, {"lang": "si", "lang_name": "සිංහල", "is_root": false, "author": "A.P. de Zoysa", "author_short": "Zoysa", "author_uid": "zoysa", "publication_date": null, "id": "si_ja407_