{"html_text": {"ja102:0.1": "<article id='ja102'><header><ul><li class='division'>{}</li>", "ja102:0.2": "<li>{}</li>", "ja102:0.3": "<li>{}</li></ul>", "ja102:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja102:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja102:1.2": "<span class='verse-line'>{}</span>", "ja102:1.3": "<span class='verse-line'>{}</span>", "ja102:1.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja102:2.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja102:0.1": "Jātaka ", "ja102:0.2": "Ekakanipāta ", "ja102:0.3": "Parosatavagga ", "ja102:0.4": "2. Paṇṇikajātaka ", "ja102:1.1": "“Yo dukkhaphuṭṭhāya bhaveyya tāṇaṁ, ", "ja102:1.2": "So me pitā dubbhi vane karoti; ", "ja102:1.3": "Sā kassa kandāmi vanassa majjhe, ", "ja102:1.4": "Yo tāyitā so sahasaṁ karotī”ti. ", "ja102:2.1": "Paṇṇikajātakaṁ dutiyaṁ. "}, "variant_text": {"ja102:0.1": "", "ja102:0.2": "", "ja102:0.3": "", "ja102:0.4": "", "ja102:1.1": "", "ja102:1.2": "dubbhi → dūbhi (bj, pts-vp-pli1) ", "ja102:1.3": "", "ja102:1.4": "sahasaṁ → sahasā (bj, sya1ed, sya2ed, pts-vp-pli1) ", "ja102:2.1": ""}, "reference_text": {"ja102:0.1": "", "ja102:0.2": "", "ja102:0.3": "", "ja102:0.4": "", "ja102:1.1": "ms22J_227, msdiv102, pts-vp-pli1.412", "ja102:1.2": "", "ja102:1.3": "", "ja102:1.4": "", "ja102:2.1": "ms22J_228"}, "keys_order": ["ja102:0.1", "ja102:0.2", "ja102:0.3", "ja102:0.4", "ja102:1.1", "ja102:1.2", "ja102:1.3", "ja102:1.4", "ja102:2.1"]}