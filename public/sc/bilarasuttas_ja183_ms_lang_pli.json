{"html_text": {"ja183:0.1": "<article id='ja183'><header><ul><li class='division'>{}</li>", "ja183:0.2": "<li>{}</li>", "ja183:0.3": "<li>{}</li></ul>", "ja183:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja183:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja183:1.2": "<span class='verse-line'>{}</span>", "ja183:1.3": "<span class='verse-line'>{}</span>", "ja183:1.4": "<span class='verse-line'>{}</span></p>", "ja183:2.1": "<p><span class='verse-line'>{}</span>", "ja183:2.2": "<span class='verse-line'>{}</span>", "ja183:2.3": "<span class='verse-line'>{}</span>", "ja183:2.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja183:3.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja183:0.1": "Jātaka ", "ja183:0.2": "Dukanipāta ", "ja183:0.3": "Asadisavagga ", "ja183:0.4": "3. Vālodakajātaka ", "ja183:1.1": "“Vālodakaṁ apparasaṁ nihīnaṁ, ", "ja183:1.2": "Pitvā mado jāyati gadrabhānaṁ; ", "ja183:1.3": "Imañca pitvāna rasaṁ paṇītaṁ, ", "ja183:1.4": "Mado na sañjāyati sindhavānaṁ”. ", "ja183:2.1": "“Appaṁ pivitvāna nihīnajacco, ", "ja183:2.2": "So majjatī tena janinda puṭṭho; ", "ja183:2.3": "Dhorayhasīlī ca kulamhi jāto, ", "ja183:2.4": "Na majjatī aggarasaṁ pivitvā”ti. ", "ja183:3.1": "Vālodakajātakaṁ tatiyaṁ. "}, "variant_text": {"ja183:0.1": "", "ja183:0.2": "", "ja183:0.3": "", "ja183:0.4": "", "ja183:1.1": "", "ja183:1.2": "Pitvā → pītvā (bj, pts-vp-pli1) ", "ja183:1.3": "", "ja183:1.4": "", "ja183:2.1": "", "ja183:2.2": "puṭṭho → phuṭṭho (bj, sya1ed, sya2ed); muṭṭho (mr) ", "ja183:2.3": "", "ja183:2.4": "", "ja183:3.1": "Vālodakajātakaṁ → vāḷodakajātakaṁ (bj) "}, "reference_text": {"ja183:0.1": "", "ja183:0.2": "", "ja183:0.3": "", "ja183:0.4": "", "ja183:1.1": "ms22J_444, msdiv65, pts-vp-pli2.97", "ja183:1.2": "", "ja183:1.3": "", "ja183:1.4": "", "ja183:2.1": "dr27.65, ms22J_445, msdiv66", "ja183:2.2": "", "ja183:2.3": "", "ja183:2.4": "", "ja183:3.1": "ms22J_446"}, "keys_order": ["ja183:0.1", "ja183:0.2", "ja1