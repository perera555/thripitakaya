{"html_text": {"ja317:0.1": "<article id='ja317'><header><ul><li class='division'>{}</li>", "ja317:0.2": "<li>{}</li>", "ja317:0.3": "<li>{}</li></ul>", "ja317:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja317:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja317:1.2": "<span class='verse-line'>{}</span>", "ja317:1.3": "<span class='verse-line'>{}</span>", "ja317:1.4": "<span class='verse-line'>{}</span></p>", "ja317:2.1": "<p><span class='verse-line'>{}</span>", "ja317:2.2": "<span class='verse-line'>{}</span>", "ja317:2.3": "<span class='verse-line'>{}</span>", "ja317:2.4": "<span class='verse-line'>{}</span></p>", "ja317:3.1": "<p><span class='verse-line'>{}</span>", "ja317:3.2": "<span class='verse-line'>{}</span>", "ja317:3.3": "<span class='verse-line'>{}</span>", "ja317:3.4": "<span class='verse-line'>{}</span></p>", "ja317:4.1": "<p><span class='verse-line'>{}</span>", "ja317:4.2": "<span class='verse-line'>{}</span>", "ja317:4.3": "<span class='verse-line'>{}</span>", "ja317:4.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja317:5.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja317:0.1": "Jātaka ", "ja317:0.2": "Catukkanipāta ", "ja317:0.3": "Pucimandavagga ", "ja317:0.4": "7. Matarodanajātaka ", "ja317:1.1": "“Mataṁ mataṁ evaṁ rodatha, ", "ja317:1.2": "Na hi taṁ rodatha yo marissati; ", "ja317:1.3": "Sabbepi sarīradhārino, ", "ja317:1.4": "Anupubbena jahanti jīvitaṁ. ", "ja317:2.1": "Devamanussā catuppadā, ", "ja317:2.2": "Pakkhigaṇā uragā ca bhogino; ", "ja317:2.3": "Samhi sarīre anissarā, ", "ja317:2.4": "Ramamānāva jahanti jīvitaṁ. ", "ja317:3.1": "Evaṁ calitaṁ asaṇṭhitaṁ, ", "ja317:3.2": "Sukhadukkhaṁ manujesvapekkhiya; ", "ja317:3.3": "Kanditaruditaṁ niratthakaṁ, ", "ja317:3.4": "Kiṁ vo sokagaṇābhikīrare. ", "ja317:4.1": "Dhuttā ca soṇḍā akatā, ", "ja317:4.2": "bālā sūrā ayogino; ", "ja317:4.3": "Dhīraṁ maññanti bāloti, ", "ja317:4.4": "ye dhammassa akovidā”ti. ", "ja317:5.1": "Matarodanajātakaṁ sattamaṁ. "}, "variant_text": {"ja317:0.1": "", "ja317:0.2": "", "ja317:0.3": "", "ja317:0.4": "", "ja317:1.1": "Mataṁ mataṁ evaṁ → matamatameva (bj, sya1ed, sya2ed, pts-vp-pli1) ", "ja317:1.2": "", "ja317:1.3": "Sabbepi → sabbeva (bj, sya1ed, sya2ed, pts-vp-pli1) ", "ja317:1.4": "", "ja317:2.1": "", "ja317:2.2": "", "ja317:2.3": "Samhi → yamhi (sya1ed, sya2ed); asmiṁ (pts-vp-pli1, mr) ", "ja317:2.4": "", "ja317:3.1": "", "ja317:3.2": "", "ja317:3.3": "", "ja317:3.4": "", "ja317:4.1": "Dhuttā ca soṇḍā → dhuttā soṇḍā (bj, pts-vp-pli1); dhuttā soṇḍā ca (sya1ed, sya2ed) ", "ja317:4.2": "bālā sūrā ayogino → bālā sūrā vīrā ayogino (pts-vp-pli1) ", "ja317:4.3": "", "ja317:4.4": "", "ja317:5.1": ""}, "reference_text": {"ja317:0.1": "", "ja317:0.2": "", "ja317:0.3": "", "ja317:0.4": "", "ja317:1.1": "ms22J_965, msdiv65, pts-vp-pli3.57", "ja317:1.2": "", "ja317:1.3": "", "ja317:1.4": "", "ja317:2.1": "ms22J_966, msdiv66, ndp22.94", "ja317:2.2": "", "ja317:2.3": "", "ja317:2.4": "", "ja317:3.1": "ms22J_967, msdiv67, vri68.88", "ja317:3.2": "", "ja317:3.3": "", "ja317:3.4": "", "ja317:4.1": "ms22J_968, msdiv68", "ja317:4.2": "", "ja317:4.3": "", "ja317:4.4": "", "ja317:5.1": "ms22J_969"}, "keys_order": ["ja317:0.1", "ja317:0.2", "ja317:0.3", "ja317:0.4", "ja317:1.1", "ja317:1.2", "ja317:1.3", "ja317:1.4", "ja317:2.1", "ja317:2.2", "ja317:2.3", "ja317:2.4", "ja317:3.1", "ja317:3.2", "ja317:3.3", "ja317:3.4", "ja317:4.1", "ja317:4.2", "ja317:4.3", "ja317:4.4", "ja317:5.1"]}