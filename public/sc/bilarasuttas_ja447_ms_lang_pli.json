{"html_text": {"ja447:0.1": "<article id='ja447'><header><ul><li class='division'>{}</li>", "ja447:0.2": "<li>{}</li>", "ja447:0.3": "<li>{}</li></ul>", "ja447:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja447:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja447:1.2": "<span class='verse-line'>{}</span>", "ja447:1.3": "<span class='verse-line'>{}</span>", "ja447:1.4": "<span class='verse-line'>{}</span></p>", "ja447:2.1": "<p><span class='verse-line'>{}</span>", "ja447:2.2": "<span class='verse-line'>{}</span>", "ja447:2.3": "<span class='verse-line'>{}</span>", "ja447:2.4": "<span class='verse-line'>{}</span></p>", "ja447:3.1": "<p><span class='verse-line'>{}</span>", "ja447:3.2": "<span class='verse-line'>{}</span>", "ja447:3.3": "<span class='verse-line'>{}</span>", "ja447:3.4": "<span class='verse-line'>{}</span></p>", "ja447:4.1": "<p><span class='verse-line'>{}</span>", "ja447:4.2": "<span class='verse-line'>{}</span>", "ja447:4.3": "<span class='verse-line'>{}</span>", "ja447:4.4": "<span class='verse-line'>{}</span></p>", "ja447:5.1": "<p><span class='verse-line'>{}</span>", "ja447:5.2": "<span class='verse-line'>{}</span>", "ja447:5.3": "<span class='verse-line'>{}</span>", "ja447:5.4": "<span class='verse-line'>{}</span></p>", "ja447:6.1": "<p><span class='verse-line'>{}</span>", "ja447:6.2": "<span class='verse-line'>{}</span>", "ja447:6.3": "<span class='verse-line'>{}</span>", "ja447:6.4": "<span class='verse-line'>{}</span></p>", "ja447:7.1": "<p><span class='verse-line'>{}</span>", "ja447:7.2": "<span class='verse-line'>{}</span>", "ja447:7.3": "<span class='verse-line'>{}</span>", "ja447:7.4": "<span class='verse-line'>{}</span></p>", "ja447:8.1": "<p><span class='verse-line'>{}</span>", "ja447:8.2": "<span class='verse-line'>{}</span>", "ja447:8.3": "<span class='verse-line'>{}</span>", "ja447:8.4": "<span class='verse-line'>{}</span></p>", "ja447:9.1": "<p><span class='verse-line'>{}</span>", "ja447:9.2": "<span class='verse-line'>{}</span>", "ja447:9.3": "<span class='verse-line'>{}</span>", "ja447:9.4": "<span class='verse-line'>{}</span></p>", "ja447:10.1": "<p><span class='verse-line'>{}</span>", "ja447:10.2": "<span class='verse-line'>{}</span>", "ja447:10.3": "<span class='verse-line'>{}</span>", "ja447:10.4": "<span class='verse-line'>{}</span></p>", "ja447:11.1": "<p><span class='verse-line'>{}</span>", "ja447:11.2": "<span class='verse-line'>{}</span>", "ja447:11.3": "<span class='verse-line'>{}</span>", "ja447:11.4": "<span class='verse-line'>{}</span></p>", "ja447:12.1": "<p><span class='verse-line'>{}</span>", "ja447:12.2": "<span class='verse-line'>{}</span>", "ja447:12.3": "<span class='verse-line'>{}</span>", "ja447:12.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja447:13.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja447:0.1": "Jātaka ", "ja447:0.2": "Dasakanipāta ", "ja447:0.3": "Catudvāravagga ", "ja447:0.4": "9. Mahādhammapālajātaka ", "ja447:1.1": "“Kiṁ te vataṁ kiṁ pana brahmacariyaṁ, ", "ja447:1.2": "Kissa suciṇṇassa ayaṁ vipāko; ", "ja447:1.3": "Akkhāhi me brāhmaṇa etamatthaṁ, ", "ja447:1.4": "Kasmā nu tumhaṁ daharā na miyyare”. ", "ja447:2.1": "“Dhammaṁ carāma na musā bhaṇāma, ", "ja447:2.2": "Pāpāni kammāni parivajjayāma; ", "ja447:2.3": "Anariyaṁ parivajjemu sabbaṁ, ", "ja447:2.4": "Tasmā hi amhaṁ daharā na miyyare. ", "ja447:3.1": "Suṇoma dhammaṁ asataṁ satañca, ", "ja447:3.2": "Na cāpi dhammaṁ asataṁ rocayāma; ", "ja447:3.3": "Hitvā asante na jahāma sante, ", "ja447:3.4": "Tasmā hi amhaṁ daharā na miyyare. ", "ja447:4.1": "Pubbeva dānā sumanā bhavāma, ", "ja447:4.2": "Dadampi ve attamanā bhavāma; ", "ja447:4.3": "Datvāpi ve nānutappāma pacchā, ", "ja447:4.4": "Tasmā hi amhaṁ daharā na miyyare. ", "ja447:5.1": "Samaṇe mayaṁ brāhmaṇe addhike ca, ", "ja447:5.2": "Vanibbake yācanake dalidde; ", "ja447:5.3": "Annena pānena abhitappayāma, ", "ja447:5.4": "Tasmā hi amhaṁ daharā na miyyare. ", "ja447:6.1": "Mayañca bhariyaṁ nātikkamāma, ", "ja447:6.2": "Amhe ca bhariyā nātikkamanti; ", "ja447:6.3": "Aññatra tāhi brahmacariyaṁ carāma, ", "ja447:6.4": "Tasmā hi amhaṁ daharā na miyyare. ", "ja447:7.1": "Pāṇātipātā viramāma sabbe, ", "ja447:7.2": "Loke adinnaṁ parivajjayāma; ", "ja447:7.3": "Amajjapā nopi musā bhaṇāma, ", "ja447:7.4": "Tasmā hi amhaṁ daharā na miyyare. ", "ja447:8.1": "Etāsu ve jāyare suttamāsu, ", "ja447:8.2": "Medhāvino honti pahūtapaññā; ", "ja447:8.3": "Bahussutā vedaguno ca honti, ", "ja447:8.4": "Tasmā hi amhaṁ daharā na miyyare. ", "ja447:9.1": "Mātā pitā ca bhaginī bhātaro ca, ", "ja447:9.2": "Puttā ca dārā ca mayañca sabbe; ", "ja447:9.3": "Dhammaṁ carāma paralokahetu, ", "ja447:9.4": "Tasmā hi amhaṁ daharā na miyyare. ", "ja447:10.1": "Dāsā ca dāsyo anujīvino ca, ", "ja447:10.2": "Paricārakā kammakarā ca sabbe; ", "ja447:10.3": "Dhammaṁ caranti paralokahetu, ", "ja447:10.4": "Tasmā hi amhaṁ daharā na miyyare”. ", "ja447:11.1": "“Dhammo have rakkhati dhammacāriṁ, ", "ja447:11.2": "Dhammo suciṇṇo sukhamāvahāti; ", "ja447:11.3": "Esānisaṁso dhamme suciṇṇe, ", "ja447:11.4": "Na duggatiṁ gacchati dhammacārī. ", "ja447:12.1": "Dhammo have rakkhati dhammacāriṁ, ", "ja447:12.2": "Chattaṁ mahantaṁ viya vassakāle; ", "ja447:12.3": "Dhammena gutto mama dhammapālo, ", "ja447:12.4": "Aññassa aṭṭhīni sukhī kumāro”ti. ", "ja447:13.1": "Mahādhammapālajātakaṁ navamaṁ. "}, "variant_text": {"ja447:0.1": "", "ja447:0.2": "", "ja447:0.3": "", "ja447:0.4": "", "ja447:1.1": "", "ja447:1.2": "", "ja447:1.3": "", "ja447:1.4": "miyyare → mīyare (bj, pts-vp-pli1) ", "ja447:2.1": "", "ja447:2.2": "parivajjayāma → vivajjayāma (bj, sya1ed, sya2ed, pts-vp-pli1) ", "ja447:2.3": "", "ja447:2.4": "", "ja447:3.1": "", "ja447:3.2": "", "ja447:3.3": "", "ja447:3.4": "", "ja447:4.1": "", "ja447:4.2": "", "ja447:4.3": "", "ja447:4.4": "", "ja447:5.1": "", "ja447:5.2": "", "ja447:5.3": "", "ja447:5.4": "", "ja447:6.1": "", "ja447:6.2": "", "ja447:6.3": "", "ja447:6.4": "", "ja447:7.1": "", "ja447:7.2": "", "ja447:7.3": "", "ja447:7.4": "", "ja447:8.1": "", "ja447:8.2": "", "ja447:8.3": "vedaguno → vedagunā (sya1ed, sya2ed); vedaguṇā (mr) ", "ja447:8.4": "", "ja447:9.1": "pitā ca → mātāpitaro (sya1ed, sya2ed); mātā ca pitā (mr) ", "ja447:9.2": "", "ja447:9.3": "", "ja447:9.4": "", "ja447:10.1": "dāsyo → dasso (bj, pts-vp-pli1); dāsī (sya1ed, sya2ed) ", "ja447:10.2": "", "ja447:10.3": "", "ja447:10.4": "", "ja447:11.1": "", "ja447:11.2": "", "ja447:11.3": "", "ja447:11.4": "", "ja447:12.1": "", "ja447:12.2": "", "ja447:12.3": "", "ja447:12.4": "", "ja447:13.1": ""}, "reference_text": {"ja447:0.1": "", "ja447:0.2": "", "ja447:0.3": "", "ja447:0.4": "", "ja447:1.1": "csp1ed22.214, csp2ed22.214, ms22J_2008, msdiv92, pts-vp-pli4.52, sya27.288", "ja447:1.2": "", "ja447:1.3": "", "ja447:1.4": "", "ja447:2.1": "ms22J_2009, msdiv93, pts-vp-pli4.53", "ja447:2.2": "", "ja447:2.3": "", "ja447:2.4": "", "ja447:3.1": "ms22J_2010, msdiv94, vri68.171", "ja447:3.2": "", "ja447:3.3": "", "ja447:3.4": "", "ja447:4.1": "dr27.287, ms22J_2011, msdiv95", "ja447:4.2": "", "ja447:4.3": "", "ja447:4.4": "", "ja447:5.1": "ms22J_2012, msdiv96, sya27.289", "ja447:5.2": "", "ja447:5.3": "", "ja447:5.4": "", "ja447:6.1": "bj30.370, ms22J_2013, msdiv97, ndp22.207", "ja447:6.2": "", "ja447:6.3": "", "ja447:6.4": "", "ja447:7.1": "csp1ed22.215, csp2ed22.215, ms22J_2014, msdiv98", "ja447:7.2": "", "ja447:7.3": "", "ja447:7.4": "", "ja447:8.1": "ms22J_2015, msdiv99", "ja447:8.2": "", "ja447:8.3": "", "ja447:8.4": "", "ja447:9.1": "ms22J_2016, msdiv100", "ja447:9.2": "", "ja447:9.3": "", "ja447:9.4": "", "ja447:10.1": "dr27.288, ms22J_2017, msdiv101, pts-vp-pli4.54, sya27.290", "ja447:10.2": "", "ja447:10.3": "", "ja447:10.4": "", "ja447:11.1": "ms22J_2018, msdiv102", "ja447:11.2": "", "ja447:11.3": "", "ja447:11.4": "", "ja447:12.1": "ms22J_2019, msdiv103, pts-vp-pli4.55", "ja447:12.2": "", "ja447:12.3": "", "ja447:12.4": "", "ja447:13.1": "ms22J_2020"}, "keys_order": ["ja447:0.1", "ja447:0.2", "ja447