{"html_text": {"ja451:0.1": "<article id='ja451'><header><ul><li class='division'>{}</li>", "ja451:0.2": "<li>{}</li>", "ja451:0.3": "<li>{}</li></ul>", "ja451:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja451:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja451:1.2": "<span class='verse-line'>{}</span>", "ja451:1.3": "<span class='verse-line'>{}</span>", "ja451:1.4": "<span class='verse-line'>{}</span></p>", "ja451:2.1": "<p><span class='verse-line'>{}</span>", "ja451:2.2": "<span class='verse-line'>{}</span>", "ja451:2.3": "<span class='verse-line'>{}</span>", "ja451:2.4": "<span class='verse-line'>{}</span></p>", "ja451:3.1": "<p><span class='verse-line'>{}</span>", "ja451:3.2": "<span class='verse-line'>{}</span>", "ja451:3.3": "<span class='verse-line'>{}</span>", "ja451:3.4": "<span class='verse-line'>{}</span></p>", "ja451:4.1": "<p><span class='verse-line'>{}</span>", "ja451:4.2": "<span class='verse-line'>{}</span>", "ja451:4.3": "<span class='verse-line'>{}</span>", "ja451:4.4": "<span class='verse-line'>{}</span></p>", "ja451:5.1": "<p><span class='verse-line'>{}</span>", "ja451:5.2": "<span class='verse-line'>{}</span>", "ja451:5.3": "<span class='verse-line'>{}</span>", "ja451:5.4": "<span class='verse-line'>{}</span></p>", "ja451:6.1": "<p><span class='verse-line'>{}</span>", "ja451:6.2": "<span class='verse-line'>{}</span>", "ja451:6.3": "<span class='verse-line'>{}</span>", "ja451:6.4": "<span class='verse-line'>{}</span></p>", "ja451:7.1": "<p><span class='verse-line'>{}</span>", "ja451:7.2": "<span class='verse-line'>{}</span>", "ja451:7.3": "<span class='verse-line'>{}</span>", "ja451:7.4": "<span class='verse-line'>{}</span></p>", "ja451:8.1": "<p><span class='verse-line'>{}</span>", "ja451:8.2": "<span class='verse-line'>{}</span>", "ja451:8.3": "<span class='verse-line'>{}</span>", "ja451:8.4": "<span class='verse-line'>{}</span></p>", "ja451:9.1": "<p><span class='verse-line'>{}</span>", "ja451:9.2": "<span class='verse-line'>{}</span>", "ja451:9.3": "<span class='verse-line'>{}</span>", "ja451:9.4": "<span class='verse-line'>{}</span></p>", "ja451:10.1": "<p><span class='verse-line'>{}</span>", "ja451:10.2": "<span class='verse-line'>{}</span>", "ja451:10.3": "<span class='verse-line'>{}</span>", "ja451:10.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja451:11.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja451:0.1": "Jātaka ", "ja451:0.2": "Dasakanipāta ", "ja451:0.3": "Catudvāravagga ", "ja451:0.4": "13. Cakkavākajātaka ", "ja451:1.1": "“Vaṇṇavā abhirūposi, ", "ja451:1.2": "ghano sañjātarohito; ", "ja451:1.3": "Cakkavāka surūposi, ", "ja451:1.4": "vippasannamukhindriyo. ", "ja451:2.1": "Pāṭhīnaṁ pāvusaṁ macchaṁ, ", "ja451:2.2": "balajaṁ muñjarohitaṁ; ", "ja451:2.3": "Gaṅgāya tīre nisinno, ", "ja451:2.4": "evaṁ bhuñjasi bhojanaṁ”. ", "ja451:3.1": "“Na vāhametaṁ bhuñjāmi, ", "ja451:3.2": "Jaṅgalānodakāni vā; ", "ja451:3.3": "Aññatra sevālapaṇakā, ", "ja451:3.4": "Etaṁ me samma bhojanaṁ”. ", "ja451:4.1": "“Na vāhametaṁ saddahāmi, ", "ja451:4.2": "cakkavākassa bhojanaṁ; ", "ja451:4.3": "Ahampi samma bhuñjāmi, ", "ja451:4.4": "gāme loṇiyateliyaṁ. ", "ja451:5.1": "Manussesu kataṁ bhattaṁ, ", "ja451:5.2": "suciṁ maṁsūpasecanaṁ; ", "ja451:5.3": "Na ca me tādiso vaṇṇo, ", "ja451:5.4": "cakkavāka yathā tuvaṁ”. ", "ja451:6.1": "“Sampassaṁ attani veraṁ, ", "ja451:6.2": "hiṁsayaṁ mānusiṁ pajaṁ; ", "ja451:6.3": "Utrasto ghasasī bhīto, ", "ja451:6.4": "tena vaṇṇo tavediso. ", "ja451:7.1": "Sabbalokaviruddhosi, ", "ja451:7.2": "dhaṅka pāpena kammunā; ", "ja451:7.3": "Laddho piṇḍo na pīṇeti, ", "ja451:7.4": "tena vaṇṇo tavediso. ", "ja451:8.1": "Ahampi samma bhuñjāmi, ", "ja451:8.2": "ahiṁsaṁ sabbapāṇinaṁ; ", "ja451:8.3": "Appossukko nirāsaṅkī, ", "ja451:8.4": "asoko akutobhayo. ", "ja451:9.1": "So karassu ānubhāvaṁ, ", "ja451:9.2": "vītivattassu sīliyaṁ; ", "ja451:9.3": "Ahiṁsāya cara loke, ", "ja451:9.4": "piyo hohisi maṁmiva. ", "ja451:10.1": "Yo na hanti na ghāteti, ", "ja451:10.2": "na jināti na jāpaye; ", "ja451:10.3": "Mettaṁso sabbabhūtesu, ", "ja451:10.4": "veraṁ tassa na kenacī”ti. ", "ja451:11.1": "Cakkavākajātakaṁ terasamaṁ. "}, "variant_text": {"ja451:0.1": "", "ja451:0.2": "", "ja451:0.3": "", "ja451:0.4": "", "ja451:1.1": "", "ja451:1.2": "", "ja451:1.3": "", "ja451:1.4": "", "ja451:2.1": "", "ja451:2.2": "balajaṁ → valajaṁ (bj); vālajaṁ (pts-vp-pli1); balajjaṁ (sya1ed, sya2ed) ", "ja451:2.3": "Gaṅgāya tīre nisinno → gaṅgātīre nisinnosi (sya1ed, sya2ed, mr); gaṅgātīresu nisinno (pts-vp-pli1) ", "ja451:2.4": "", "ja451:3.1": "vāhametaṁ → sabbatthapi ", "ja451:3.2": "", "ja451:3.3": "", "ja451:3.4": "Etaṁ → aññaṁ (sya1ed, sya2ed) ", "ja451:4.1": "", "ja451:4.2": "", "ja451:4.3": "Ahampi → ahañca (?) ", "ja451:4.4": "", "ja451:5.1": "", "ja451:5.2": "", "ja451:5.3": "", "ja451:5.4": "", "ja451:6.1": "", "ja451:6.2": "hiṁsayaṁ → hiṁsāya (sya1ed, sya2ed, pts-vp-pli1, mr) ", "ja451:6.3": "", "ja451:6.4": "", "ja451:7.1": "", "ja451:7.2": "", "ja451:7.3": "", "ja451:7.4": "", "ja451:8.1": "", "ja451:8.2": "", "ja451:8.3": "", "ja451:8.4": "", "ja451:9.1": "", "ja451:9.2": "", "ja451:9.3": "", "ja451:9.4": "", "ja451:10.1": "", "ja451:10.2": "", "ja451:10.3": "", "ja451:10.4": "", "ja451:11.1": ""}, "reference_text": {"ja451:0.1": "", "ja451:0.2": "", "ja451:0.3": "", "ja451:0.4": "", "ja451:1.1": "bj30.378, ms22J_2055, msdiv135, pts-vp-pli4.70", "ja451:1.2": "", "ja451:1.3": "", "ja451:1.4": "", "ja451:2.1": "ms22J_2056, msdiv136, ndp22.212", "ja451:2.2": "", "ja451:2.3": "", "ja451:2.4": "", "ja451:3.1": "ms22J_2057, msdiv137, pts-vp-pli4.71", "ja451:3.2": "", "ja451:3.3": "", "ja451:3.4": "", "ja451:4.1": "csp1ed22.220, csp2ed22.220, ms22J_2058, msdiv138", "ja451:4.2": "", "ja451:4.3": "", "ja451:4.4": "", "ja451:5.1": "ms22J_2059, msdiv139, sya27.296", "ja451:5.2": "", "ja451:5.3": "", "ja451:5.4": "", "ja451:6.1": "dr27.294, ms22J_2060, msdiv140", "ja451:6.2": "", "ja451:6.3": "", "ja451:6.4": "", "ja451:7