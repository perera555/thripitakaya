{"html_text": {"ja271:0.1": "<article id='ja271'><header><ul><li class='division'>{}</li>", "ja271:0.2": "<li>{}</li>", "ja271:0.3": "<li>{}</li></ul>", "ja271:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja271:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja271:1.2": "<span class='verse-line'>{}</span>", "ja271:1.3": "<span class='verse-line'>{}</span>", "ja271:1.4": "<span class='verse-line'>{}</span></p>", "ja271:2.1": "<p><span class='verse-line'>{}</span>", "ja271:2.2": "<span class='verse-line'>{}</span>", "ja271:2.3": "<span class='verse-line'>{}</span>", "ja271:2.4": "<span class='verse-line'>{}</span></p>", "ja271:3.1": "<p><span class='verse-line'>{}</span>", "ja271:3.2": "<span class='verse-line'>{}</span>", "ja271:3.3": "<span class='verse-line'>{}</span>", "ja271:3.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja271:4.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja271:0.1": "Jātaka ", "ja271:0.2": "Tikanipāta ", "ja271:0.3": "Udapānavagga ", "ja271:0.4": "1. Udapānadūsakajātaka ", "ja271:1.1": "“Āraññikassa isino, ", "ja271:1.2": "cirarattatapassino; ", "ja271:1.3": "Kicchākataṁ udapānaṁ, ", "ja271:1.4": "kathaṁ samma avāhayi”. ", "ja271:2.1": "“Esa dhammo siṅgālānaṁ, ", "ja271:2.2": "yaṁ pitvā ohadāmase; ", "ja271:2.3": "Pitupitāmahaṁ dhammo, ", "ja271:2.4": "na taṁ ujjhātumarahasi”. ", "ja271:3.1": "“Yesaṁ vo ediso dhammo, ", "ja271:3.2": "Adhammo pana kīdiso; ", "ja271:3.3": "Mā vo dhammaṁ adhammaṁ vā, ", "ja271:3.4": "Addasāma kudācanan”ti. ", "ja271:4.1": "Udapānadūsakajātakaṁ paṭhamaṁ. "}, "variant_text": {"ja271:0.1": "", "ja271:0.2": "", "ja271:0.3": "", "ja271:0.4": "", "ja271:1.1": "", "ja271:1.2": "cirarattatapassino → ciraṁ rattaṁ tapassino (sya1ed, sya2ed); cirarattaṁ tapassino (csp1ed) ", "ja271:1.3": "", "ja271:1.4": "avāhayi → avāhasi (bj, mr); apāhasi (sya1ed, sya2ed) ", "ja271:2.1": "", "ja271:2.2": "", "ja271:2.3": "", "ja271:2.4": "na taṁ → na naṁ (bj, pts-vp-pli1) ", "ja271:3.1": "", "ja271:3.2": "", "ja271:3.3": "", "ja271:3.4": "", "ja271:4.1": ""}, "reference_text": {"ja271:0.1": "", "ja271:0.2": "", "ja271:0.3": "", "ja271:0.4": "", "ja271:1.1": "bj30.138, dr27.110, ms22J_754, msdiv61, ndp22.74, pts-vp-pli2.354", "ja271:1.2": "", "ja271:1.3": "", "ja271:1.4": "", "ja271:2.1": "ms22J_755, msdiv62, pts-vp-pli2.355", "ja271:2.2": "", "ja271:2.3": "", "ja271:2.4": "", "ja271:3.1": "csp1ed22.80, csp2ed22.80, ms22J_756, msdiv63", "ja271:3.2": "", "ja271:3.3": "", "ja271:3.4": "", "ja271:4.1": "ms22J_757"}, "keys_order": ["ja271:0.1", "ja271:0.2", "ja271:0.3", "ja271:0.4", "ja271:1.1", "ja271:1.2", "ja271:1.3", "ja271:1.4", "ja271:2.1", "ja271:2.2", "ja271:2.3", "ja271:2.4", "ja271:3.1", "ja271:3.2", "ja271:3.3", "ja271:3.4", "ja271:4.1"]}