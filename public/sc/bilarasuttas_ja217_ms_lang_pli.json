{"html_text": {"ja217:0.1": "<article id='ja217'><header><ul><li class='division'>{}</li>", "ja217:0.2": "<li>{}</li>", "ja217:0.3": "<li>{}</li></ul>", "ja217:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja217:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja217:1.2": "<span class='verse-line'>{}</span>", "ja217:1.3": "<span class='verse-line'>{}</span>", "ja217:1.4": "<span class='verse-line'>{}</span></p>", "ja217:2.1": "<p><span class='verse-line'>{}</span>", "ja217:2.2": "<span class='verse-line'>{}</span>", "ja217:2.3": "<span class='verse-line'>{}</span>", "ja217:2.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja217:3.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja217:0.1": "Jātaka ", "ja217:0.2": "Dukanipāta ", "ja217:0.3": "Bīraṇathambhavagga ", "ja217:0.4": "7. Seggujātaka ", "ja217:1.1": "“Sabbo loko attamano ahosi, ", "ja217:1.2": "Akovidā gāmadhammassa seggu; ", "ja217:1.3": "Komāri ko nāma tavajja dhammo, ", "ja217:1.4": "Yaṁ tvaṁ gahitā pavane parodasi”. ", "ja217:2.1": "“Yo dukkhaphuṭṭhāya bhaveyya tāṇaṁ, ", "ja217:2.2": "So me pitā dubbhi vane karoti; ", "ja217:2.3": "Sā kassa kandāmi vanassa majjhe, ", "ja217:2.4": "Yo tāyitā so sahasaṁ karotī”ti. ", "ja217:3.1": "Seggujātakaṁ sattamaṁ. "}, "variant_text": {"ja217:0.1": "", "ja217:0.2": "", "ja217:0.3": "", "ja217:0.4": "", "ja217:1.1": "", "ja217:1.2": "", "ja217:1.3": "nāma → komāriko nāma (bj, sya1ed, sya2ed, pts-vp-pli1); komārikā nāma (mr) ", "ja217:1.4": "", "ja217:2.1": "", "ja217:2.2": "", "ja217:2.3": "", "ja217:2.4": "", "ja217:3.1": ""}, "reference_text": {"ja217:0.1": "", "ja217:0.2": "", "ja217:0.3": "", "ja217:0.4": "", "ja217:1.1": "ms22J_556, msdiv133, pts-vp-pli2.180, vri68.53", "ja217:1.2": "", "ja217:1.3": "", "ja217:1.4": "", "ja217:2.1": "ms22J_557, msdiv134", "ja217:2.2": "", "ja217:2.3": "", "ja217:2.4": "", "ja217:3.1": "ms22J_558"}, "keys_order": ["ja217:0.1", "ja217:0.2", "ja217:0.3", "ja217:0.4", "ja217:1.1", "