 "ja520:27.3": "<span class='verse-line'>{}</span>", "ja520:27.4": "<span class='verse-line'>{}</span></p>", "ja520:28.1": "<p><span class='verse-line'>{}</span>", "ja520:28.2": "<span class='verse-line'>{}</span>", "ja520:28.3": "<span class='verse-line'>{}</span>", "ja520:28.4": "<span class='verse-line'>{}</span></p>", "ja520:29.1": "<p><span class='verse-line'>{}</span>", "ja520:29.2": "<span class='verse-line'>{}</span>", "ja520:29.3": "<span class='verse-line'>{}</span>", "ja520:29.4": "<span class='verse-line'>{}</span></p>", "ja520:30.1": "<p><span class='verse-line'>{}</span>", "ja520:30.2": "<span class='verse-line'>{}</span>", "ja520:30.3": "<span class='verse-line'>{}</span>", "ja520:30.4": "<span class='verse-line'>{}</span></p>", "ja520:31.1": "<p><span class='verse-line'>{}</span>", "ja520:31.2": "<span class='verse-line'>{}</span>", "ja520:31.3": "<span class='verse-line'>{}</span>", "ja520:31.4": "<span class='verse-line'>{}</span></p>", "ja520:32.1": "<p><span class='verse-line'>{}</span>", "ja520:32.2": "<span class='verse-line'>{}</span>", "ja520:32.3": "<span class='verse-line'>{}</span>", "ja520:32.4": "<span class='verse-line'>{}</span></p>", "ja520:33.1": "<p><span class='verse-line'>{}</span>", "ja520:33.2": "<span class='verse-line'>{}</span>", "ja520:33.3": "<span class='verse-line'>{}</span>", "ja520:33.4": "<span class='verse-line'>{}</span></p>", "ja520:34.1": "<p><span class='verse-line'>{}</span>", "ja520:34.2": "<span class='verse-line'>{}</span>", "ja520:34.3": "<span class='verse-line'>{}</span>", "ja520:34.4": "<span class='verse-line'>{}</span>", "ja520:34.5": "<span class='verse-line'>{}</span>", "ja520:34.6": "<span class='verse-line'>{}</span></p>", "ja520:35.1": "<p><span class='verse-line'>{}</span>", "ja520:35.2": "<span class='verse-line'>{}</span>", "ja520:35.3": "<span class='verse-line'>{}</span>", "ja520:35.4": "<span class='verse-line'>{}</span></p>", "ja520:36.1": "<p><span class='verse-line'>{}</span>", "ja520:36.2": "<span class='verse-line'>{}</span>", "ja520:36.3": "<span class='verse-line'>{}</span>", "ja520:36.4": "<span class='verse-line'>{}</span></p>", "ja520:37.1": "<p><span class='verse-line'>{}</span>", "ja520:37.2": "<span class='verse-line'>{}</span>", "ja520:37.3": "<span class='verse-line'>{}</span>", "ja520:37.4": "<span class='verse-line'>{}</span></p>", "ja520:38.1": "<p><span class='verse-line'>{}</span>", "ja520:38.2": "<span class='verse-line'>{}</span>", "ja520:38.3": "<span class='verse-line'>{}</span>", "ja520:38.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja520:39.1": "<p class='endsutta'>{}</p>", "ja520:40.1": "<p class='endsection'>{}</p>", "ja520:41.1": "<p class='uddana-intro'>{}</p>", "ja520:42.1": "<blockquote class='uddanagatha'><p><span class='verse-line'>{}</span>", "ja520:42.2": "<span class='verse-line'>{}</span>", "ja520:42.3": "<span class='verse-line'>{}</span>", "ja520:42.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja520:43.1": "<p class='endbook'>{}</p></article>"}, "root_text": {"ja520:0.1": "Jātaka ", "ja520:0.2": "Tiṁsanipāta ", "ja520:0.3": "Kiṁchandavagga ", "ja520:0.4": "10. Gandhatindukajātaka ", "ja520:1.1": "“Appamādo amataṁ padaṁ, ", "ja520:1.2": "Pamādo maccuno padaṁ; ", "ja520:1.3": "Appamattā na mīyanti, ", "ja520:1.4": "Ye pamattā yathā matā. ", "ja520:2.1": "Madā pamādo jāyetha, ", "ja520:2.2": "pamādā jāyate khayo; ", "ja520:2.3": "Khayā padosā jāyanti, ", "ja520:2.4": "mā pamādo bharatūsabha. ", "ja520:3.1": "Bahū hi khattiyā jīnā, ", "ja520:3.2": "atthaṁ raṭṭhaṁ pamādino; ", "ja520:3.3": "Athopi gāmino gāmā, ", "ja520:3.4": "anagārā agārino. ", "ja520:4.1": "Khattiyassa pamattassa, ", "ja520:4.2": "raṭṭhasmiṁ raṭṭhavaḍḍhana; ", "ja520:4.3": "Sabbe bhogā vinassanti, ", "ja520:4.4": "rañño taṁ vuccate aghaṁ. ", "ja520:5.1": "Nesa dhammo mahārāja, ", "ja520:5.2": "ativelaṁ pamajjasi; ", "ja520:5.3": "Iddhaṁ phītaṁ janapadaṁ, ", "ja520:5.4": "corā viddhaṁsayanti naṁ. ", "ja520:6.1": "Na te puttā bhavissanti, ", "ja520:6.2": "na hiraññaṁ na dhāniyaṁ; ", "ja520:6.3": "Raṭṭhe viluppamānamhi, ", "ja520:6.4": "sabbabhogehi jiyyasi. ", "ja520:7.1": "Sabbabhogā parijiṇṇaṁ, ", "ja520:7.2": "rājānaṁ vāpi khattiyaṁ; ", "ja520:7.3": "Ñātimittā suhajjā ca, ", "ja520:7.4": "na taṁ maññanti māniyaṁ. ", "ja520:8.1": "Hatthārohā anikaṭṭhā, ", "ja520:8.2": "rathikā pattikārakā; ", "ja520:8.3": "Tamevamupajīvantā, ", "ja520:8.4": "na taṁ maññanti māniyaṁ. ", "ja520:9.1": "Asaṁvihitakammantaṁ, ", "ja520:9.2": "bālaṁ dummantimantinaṁ; ", "ja520:9.3": "Sirī jahati dummedhaṁ, ", "ja520:9.4": "jiṇṇaṁva urago tacaṁ. ", "ja520:10.1": "Susaṁvihitakammantaṁ, ", "ja520:10.2": "kāluṭṭhāyiṁ atanditaṁ; ", "ja520:10.3": "Sabbe bhogābhivaḍḍhanti, ", "ja520:10.4": "gāvo sausabhāmiva. ", "ja520:11.1": "Upassutiṁ mahārāja, ", "ja520:11.2": "raṭṭhe janapade cara; ", "ja520:11.3": "Tattha disvā ca sutvā ca, ", "ja520:11.4": "tato taṁ paṭipajjasi”. ", "ja520:12.1": "“Evaṁ vedetu pañcālo, ", "ja520:12.2": "saṅgāme saramappito; ", "ja520:12.3": "Yathāhamajja vedemi, ", "ja520:12.4": "kaṇṭakena samappito”. ", "ja520:13.1": "“Jiṇṇo dubbalacakkhūsi, ", "ja520:13.2": "na rūpaṁ sādhu passasi; ", "ja520:13.3": "Kiṁ tattha brahmadattassa, ", "ja520:13.4": "yaṁ taṁ maggeyya kaṇṭako”. ", "ja520:14.1": "“Bahvettha brahmadattassa, ", "ja520:14.2": "Sohaṁ maggasmi brāhmaṇa; ", "ja520:14.3": "Arakkhitā jānapadā, ", "ja520:14.4": "Adhammabalinā hatā. ", "ja520:15.1": "Rattiñhi corā khādanti, ", "ja520:15.2": "divā khādanti tuṇḍiyā; ", "ja520:15.3": "Raṭṭhasmiṁ kūṭarājassa, ", "ja520:15.4": "bahu adhammiko jano. ", "ja520:16.1": "Etādise bhaye jāte, ", "ja520:16.2": "bhayaṭṭā tāta māṇavā; ", "ja520:16.3": "Nillenakāni kubbanti, ", "ja520:16.4": "vane āhatva kaṇṭakaṁ”. ", "ja520:17.1": "“Kadāssu nāmayaṁ rājā, ", "ja520:17.2": "brahmadatto marissati; ", "ja520:17.3": "Yassa raṭṭhamhi jiyyanti, ", "ja520:17.4": "appatikā kumārikā”. ", "ja520:18.1": "“Dubbhāsitañhi te jammi, ", "ja520:18.2": "anatthapadakovide; ", "ja520:18.3": "Kuhiṁ rājā kumārīnaṁ, ", "ja520:18.4": "bhattāraṁ pariyesati”. ", "ja520:19.1": "“Na me dubbhāsitaṁ brahme, ", "ja520:19.2": "kovidatthapadā ahaṁ; ", "ja520:19.3": "Arakkhitā jānapadā, ", "ja520:19.4": "adhammabalinā hatā. ", "ja520:20.1": "Rattiñhi corā khādanti, ", "ja520:20.2": "divā khādanti tuṇḍiyā; ", "ja520:20.3": "Raṭṭhasmiṁ kūṭarājassa, ", "ja520:20.4": "bahu adhammiko jano; ", "ja520:20.5": "Dujjīve dubbhare dāre, ", "ja520:20.6": "kuto bhattā kumāriyo”. ", "ja520:21.1": "“Evaṁ sayatu pañcālo, ", "ja520:21.2": "saṅgāme sattiyā hato; ", "ja520:21.3": "Yathāyaṁ kapaṇo seti, ", "ja520:21.4": "hato phālena sāliyo”. ", "ja520:22.1": "“Adhammena tuvaṁ jamma, ", "ja520:22.2": "brahmadattassa kujjhasi; ", "ja520:22.3": "Yo tvaṁ sapasi rājānaṁ, ", "ja520:22.4": "aparajjhitvāna attano”. ", "ja520:23.1": "“Dhammena brahmadattassa, ", "ja520:23.2": "ahaṁ kujjhāmi brāhmaṇa; ", "ja520:23.3": "Arakkhitā jānapadā, ", "ja520:23.4": "adhammabalinā hatā. ", "ja520:24.1": "Rattiñhi corā khādanti, ", "ja520:24.2": "divā khādanti tuṇḍiyā; ", "ja520:24.3": "Raṭṭhasmiṁ kūṭarājassa, ", "ja520:24.4": "bahu adhammiko jano. ", "ja520:25.1": "Sā nūna puna re pakkā, ", "ja520:25.2": "vikāle bhattamāhari; ", "ja520:25.3": "Bhattahāriṁ apekkhanto, ", "ja520:25.4": "hato phālena sāliyo”. ", "ja520:26.1": "“Evaṁ haññatu pañcālo, ", "ja520:26.2": "saṅgāme asinā hato; ", "ja520:26.3": "Yathāhamajja pahato, ", "ja520:26.4": "khīrañca me pavaṭṭitaṁ”. ", "ja520:27.1": "“Yaṁ pasu khīraṁ chaḍḍeti, ", "ja520:27.2": "pasupālaṁ vihiṁsati; ", "ja520:27.3": "Kiṁ tattha brahmadattassa, ", "ja520:27.4": "yaṁ no garahate bhavaṁ”. ", "ja520:28.1": "“Gārayho brahme pañcālo, ", "ja520:28.2": "brahmadattassa rājino; ", "ja520:28.3": "Arakkhitā jānapadā, ", "ja520:28.4": "adhammabalinā hatā. ", "ja520:29.1": "Rattiñhi corā khādanti, ", "ja520:29.2": "divā khādanti tuṇḍiyā; ", "ja520:29.3": "Raṭṭhasmiṁ kūṭarājassa, ", "ja520:29.4": "bahu adhammiko jano. ", "ja520:30.1": "Caṇḍā aṭanakā gāvī, ", "ja520:30.2": "yaṁ pure na duhāmase; ", "ja520:30.3": "Taṁ dāni ajja dohāma, ", "ja520:30.4": "khīrakāmehupaddutā”. ", "ja520:31.1": "“Evaṁ kandatu pañcālo, ", "ja520:31.2": "viputto vippasukkhatu; ", "ja520:31.3": "Yathāyaṁ kapaṇā gāvī, ", "ja520:31.4": "viputtā paridhāvati”. ", "ja520:32.1": "“Yaṁ pasu pasupālassa, ", "ja520:32.2": "sambhameyya raveyya vā; ", "ja520:32.3": "Ko nīdha aparādhatthi, ", "ja520:32.4": "brahmadattassa rājino”. ", "ja520:33.1": "“Aparādho mahābrahme, ", "ja520:33.2": "brahmadattassa rājino; ", "ja520:33.3": "Arakkhitā jānapadā, ", "ja520:33.4": "adhammabalinā hatā. ", "ja520:34.1": "Rattiñhi corā khādanti, ", "ja520:34.2": "divā khādanti tuṇḍiyā; ", "ja520:34.3": "Raṭṭhasmiṁ kūṭarājassa, ", "ja520:34.4": "bahu adhammiko jano; ", "ja520:34.5": "Kathaṁ no asikosatthā, ", "ja520:34.6": "khīrapā haññate pajā”. ", "ja520:35.1": "“Evaṁ khajjatu pañcālo, ", "ja520:35.2": "hato yuddhe saputtako; ", "ja520:35.3": "Yathāhamajja khajjāmi, ", "ja520:35.4": "gāmikehi araññajo”. ", "ja520:36.1": "“Na sabbabhūtesu vidhenti rakkhaṁ, ", "ja520:36.2": "Rājāno maṇḍūka manussaloke; ", "ja520:36.3": "Nettāvatā rājā adhammacārī, ", "ja520:36.4": "Yaṁ tādisaṁ jīvamadeyyu dhaṅkā”. ", "ja520:37.1": "“Adhammarūpo vata brahmacārī, ", "ja520:37.2": "Anuppiyaṁ bhāsasi khattiyassa; ", "ja520:37.3": "Viluppamānāya puthuppajāya, ", "ja520:37.4": "Pūjesi rājaṁ paramappamādaṁ. ", "ja520:38.1": "Sace idaṁ brahme surajjakaṁ siyā, ", "ja520:38.2": "Phītaṁ raṭṭhaṁ muditaṁ vippasannaṁ; ", "ja520:38.3": "Bhutvā baliṁ aggapiṇḍañca kākā, ", "ja520:38.4": "Na mādisaṁ jīvamadeyyu dhaṅkā”ti. ", "ja520:39.1": "Gandhatindukajātakaṁ dasamaṁ. ", "ja520:40.1": "Tiṁsanipātaṁ niṭṭhitaṁ. ", "ja520:41.1": "Tassuddānaṁ ", "ja520:42.1": "Kiṁchanda kumbha jayaddisa chaddanta, ", "ja520:42.2": "Atha paṇḍitasambhava sirakapi; ", "ja520:42.3": "Dakarakkhasa paṇḍaranāgavaro, ", "ja520:42.4": "Atha sambula tindukadevasutoti. ", "ja520:43.1": "Jātakapāḷiyā paṭhamo bhāgo niṭṭhito. "}, "variant_tex