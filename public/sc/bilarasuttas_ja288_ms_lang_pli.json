{"html_text": {"ja288:0.1": "<article id='ja288'><header><ul><li class='division'>{}</li>", "ja288:0.2": "<li>{}</li>", "ja288:0.3": "<li>{}</li></ul>", "ja288:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja288:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja288:1.2": "<span class='verse-line'>{}</span>", "ja288:1.3": "<span class='verse-line'>{}</span>", "ja288:1.4": "<span class='verse-line'>{}</span></p>", "ja288:2.1": "<p><span class='verse-line'>{}</span>", "ja288:2.2": "<span class='verse-line'>{}</span>", "ja288:2.3": "<span class='verse-line'>{}</span>", "ja288:2.4": "<span class='verse-line'>{}</span></p>", "ja288:3.1": "<p><span class='verse-line'>{}</span>", "ja288:3.2": "<span class='verse-line'>{}</span>", "ja288:3.3": "<span class='verse-line'>{}</span>", "ja288:3.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja288:4.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja288:0.1": "Jātaka ", "ja288:0.2": "Tikanipāta ", "ja288:0.3": "Abbhantaravagga ", "ja288:0.4": "8. Macchuddānajātaka ", "ja288:1.1": "“Agghanti macchā adhikaṁ sahassaṁ, ", "ja288:1.2": "Na so atthi yo imaṁ saddaheyya; ", "ja288:1.3": "Mayhañca assu idha satta māsā, ", "ja288:1.4": "Ahampi taṁ macchuddānaṁ kiṇeyyaṁ”. ", "ja288:2.1": "“Macchānaṁ bhojanaṁ datvā, ", "ja288:2.2": "mama dakkhiṇamādisi; ", "ja288:2.3": "Taṁ dakkhiṇaṁ sarantiyā, ", "ja288:2.4": "kataṁ apacitiṁ tayā”. ", "ja288:3.1": "“Paduṭṭhacittassa na phāti hoti, ", "ja288:3.2": "Na cāpi taṁ devatā pūjayanti; ", "ja288:3.3": "Yo bhātaraṁ pettikaṁ sāpateyyaṁ, ", "ja288:3.4": "Avañcayī dukkaṭakammakārī”ti. ", "ja288:4.1": "Macchuddānajātakaṁ aṭṭhamaṁ. "}, "variant_text": {"ja288:0.1": "", "ja288:0.2": "", "ja288:0.3": "", "ja288:0.4": "", "ja288:1.1": "", "ja288:1.2": "", "ja288:1.3": "", "ja288:1.4": "taṁ → naṁ (bj, sya1ed, sya2ed) ", "ja288:2.1": "", "ja288:2.2": "", "ja288:2.3": "", "ja288:2.4": "", "ja288:3.1": "", "ja288:3.2": "", "ja288:3.3": "", "ja288:3.4": "", "ja288:4.1": "Macchuddānajātakaṁ → macchadānajātakaṁ (sya1ed, sya2ed) "}, "reference_text": {"ja288:0.1": "", "ja288:0.2": "", "ja288:0.3": "", "ja288:0.4": "", "ja288:1.1": "ms22J_824, msdiv112, pts-vp-pli2.425, vri68.76", "ja288:1.2": "", "ja288:1.3": "", "ja288:1.4": "", "ja288:2.1": "dr27.120, ms22J_825, msdiv113", "ja288:2.2": "", "ja288:2.3": "", "ja288:2.4": "", "ja288:3.1": "bj30.152, csp1ed22.87, csp2ed22.87, ms22J_826, msdiv114, pts-vp-pli2.426, sya27.120", "ja288:3.2": "", "ja288:3.3": "", "ja288:3.4": "", "ja288:4.1": "ms22J_827"}, "keys_order": ["ja288:0.1", "ja288:0.2", "ja288:0.3", "ja288:0.4", "ja288:1.1", "ja288:1.2", "ja288:1.3", "ja288:1.4", "ja288:2.1", "ja288:2.2", "ja288:2.3", "ja288:2.4", "ja288:3.1", "ja288:3.2", "ja288:3.3", "ja288:3.4", "ja288:4.1"]}