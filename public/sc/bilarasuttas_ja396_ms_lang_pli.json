{"html_text": {"ja396:0.1": "<article id='ja396'><header><ul><li class='division'>{}</li>", "ja396:0.2": "<li>{}</li>", "ja396:0.3": "<li>{}</li></ul>", "ja396:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja396:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja396:1.2": "<span class='verse-line'>{}</span>", "ja396:1.3": "<span class='verse-line'>{}</span>", "ja396:1.4": "<span class='verse-line'>{}</span></p>", "ja396:2.1": "<p><span class='verse-line'>{}</span>", "ja396:2.2": "<span class='verse-line'>{}</span>", "ja396:2.3": "<span class='verse-line'>{}</span>", "ja396:2.4": "<span class='verse-line'>{}</span></p>", "ja396:3.1": "<p><span class='verse-line'>{}</span>", "ja396:3.2": "<span class='verse-line'>{}</span>", "ja396:3.3": "<span class='verse-line'>{}</span>", "ja396:3.4": "<span class='verse-line'>{}</span></p>", "ja396:4.1": "<p><span class='verse-line'>{}</span>", "ja396:4.2": "<span class='verse-line'>{}</span>", "ja396:4.3": "<span class='verse-line'>{}</span>", "ja396:4.4": "<span class='verse-line'>{}</span></p>", "ja396:5.1": "<p><span class='verse-line'>{}</span>", "ja396:5.2": "<span class='verse-line'>{}</span>", "ja396:5.3": "<span class='verse-line'>{}</span>", "ja396:5.4": "<span class='verse-line'>{}</span></p>", "ja396:6.1": "<p><span class='verse-line'>{}</span>", "ja396:6.2": "<span class='verse-line'>{}</span>", "ja396:6.3": "<span class='verse-line'>{}</span>", "ja396:6.4": "<span class='verse-line'>{}</span></p>", "ja396:7.1": "<p><span class='verse-line'>{}</span>", "ja396:7.2": "<span class='verse-line'>{}</span>", "ja396:7.3": "<span class='verse-line'>{}</span>", "ja396:7.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja396:8.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja396:0.1": "Jātaka ", "ja396:0.2": "Sattakanipāta ", "ja396:0.3": "Kukkuvagga ", "ja396:0.4": "1. Kukkujātaka ", "ja396:1.1": "“Diyaḍḍhakukkū udayena kaṇṇikā, ", "ja396:1.2": "Vidatthiyo aṭṭha parikkhipanti naṁ; ", "ja396:1.3": "Sā siṁsapā sāramayā apheggukā, ", "ja396:1.4": "Kuhiṁ ṭhitā upparito na dhaṁsati”. ", "ja396:2.1": "“Yā tiṁsati sāramayā anujjukā, ", "ja396:2.2": "Parikiriya gopānasiyo samaṁ ṭhitā; ", "ja396:2.3": "Tāhi susaṅgahitā balasā pīḷitā, ", "ja396:2.4": "Samaṁ ṭhitā upparito na dhaṁsati. ", "ja396:3.1": "Evampi mittehi daḷhehi paṇḍito, ", "ja396:3.2": "Abhejjarūpehi sucīhi mantibhi; ", "ja396:3.3": "Susaṅgahīto siriyā na dhaṁsati, ", "ja396:3.4": "Gopānasī bhāravahāva kaṇṇikā. ", "ja396:4.1": "Kharattacaṁ bellaṁ yathāpi satthavā, ", "ja396:4.2": "Anāmasantopi karoti tittakaṁ; ", "ja396:4.3": "Samāharaṁ sāduṁ karoti patthiva, ", "ja396:4.4": "Asāduṁ kayirā tanubandhamuddharaṁ. ", "ja396:5.1": "Evampi gāmanigamesu paṇḍito, ", "ja396:5.2": "Asāhasaṁ rājadhanāni saṅgharaṁ; ", "ja396:5.3": "Dhammānuvattī paṭipajjamāno, ", "ja396:5.4": "Sa phāti kayirā aviheṭhayaṁ paraṁ. ", "ja396:6.1": "Odātamūlaṁ sucivārisambhavaṁ, ", "ja396:6.2": "Jātaṁ yathā pokkharaṇīsu ambujaṁ; ", "ja396:6.3": "Padumaṁ yathā agginikāsiphālimaṁ, ", "ja396:6.4": "Na kaddamo na rajo na vāri limpati. ", "ja396:7.1": "Evampi vohārasuciṁ asāhasaṁ, ", "ja396:7.2": "Visuddhakammantamapetapāpakaṁ; ", "ja396:7.3": "Na limpati kammakilesa tādiso, ", "ja396:7.4": "Jātaṁ yathā pokkharaṇīsu ambujan”ti. ", "ja396:8.1": "Kukkujātakaṁ paṭhamaṁ. "}, "variant_text": {"ja396:0.1": "", "ja396:0.2": "", "ja396:0.3": "", "ja396:0.4": "", "ja396:1.1": "", "ja396:1.2": "", "ja396:1.3": "siṁsapā → sasiṁsapā (bj, pts-vp-pli1); sā sīsapā (sya1ed, sya2ed); yā siṁsapā (si -nissya) ", "ja396:1.4": "upparito → uparito (bj, sya1ed, sya2ed, pts-vp-pli1) ", "ja396:2.1": "", "ja396:2.2": "Parikiriya → pakiriyā (mr) | samaṁ ṭhitā → samaṭṭhitā (bj, sya1ed, sya2ed) ", "ja396:2.3": "Tāhi susaṅgahitā balasā pīḷitā → tā saṅgahitā balasā ca pīḷitā (bj); tāhi susaṅgahitā balasā ca pīḷitā (sya1ed, sya2ed); tāhi saṅgahītā balasā papīḷitā (pts-vp-pli1) ", "ja396:2.4": "", "ja396:3.1": "", "ja396:3.2": "", "ja396:3.3": "", "ja396:3.4": "", "ja396:4.1": "", "ja396:4.2": "", "ja396:4.3": "", "ja396:4.4": "tanubandhamuddharaṁ → tanuvaṭṭamuddharaṁ (bj, pts-vp-pli1) ", "ja396:5.1": "", "ja396:5.2": "", "ja396:5.3": "", "ja396:5.4": "", "ja396:6.1": "", "ja396:6.2": "", "ja396:6.3": "", "ja396:6.4": "", "ja396:7.1": "", "ja396:7.2": "", "ja396:7.3": "", "ja396:7.4": "", "ja396:8.1": ""}, "reference_text": {"ja396:0.1": "", "ja396:0.2": "", "ja396:0.3": "", "ja396:0.4": "", "ja396:1.1": "bj30.264, csp1ed22.155, csp2ed22.155, dr27.210, ms22J_1485, msdiv1, ndp22.146, pts-vp-pli3.318, sya27.211, vri68.129", "ja396:1.2": "", "ja396:1.3": "", "ja396:1.4": "", "ja396:2.1": "ms22J_1486, msdiv2", "ja396:2.2": "", "ja396:2.3": "", "ja396:2.4": "", "ja396:3.1": "ms22J_1487, msdiv3", "ja396:3.2": "", "ja396:3.3": "", "ja396:3.4": "", "ja396:4.1": "ms22J_1488, msdiv4, pts-vp-pli3.319", "ja396:4.2": "", "ja396:4.3": "", "ja396:4.4": "", "ja396:5.1": "dr27.211, ms22J_1489, msdiv5, ndp22.147, sya27.212", "ja396:5.2": "", "ja396:5.3": "", "ja396:5.4": "", "ja396:6.1": "csp1ed22.156, csp2ed22.156, ms22J_1490, msdiv6, pts-vp-pli3.320", "ja396:6.2": "", "ja396:6.3": "", "ja396:6.4": "", "ja396:7.1": "ms22J_1491, msdiv7", "ja396:7.2": "", "ja396:7.3": "", "ja396:7.4": "", "ja396:8.1": "ms22J_1492"}, "keys_order": ["ja396:0.1", "ja396:0.2", "ja396:0.3", "ja396:0.4", "ja396:1.1", "ja396:1.2", "ja396:1.3", "ja396:1.4", "ja396:2.1", "ja396:2.2", "ja396:2.3", "ja396:2.4", "ja396:3.1", "ja396:3.2", "ja396:3.3", "ja396:3.4", "ja396:4.1", "ja396:4.2", "ja396:4.3", "ja396:4.4", "ja396:5.1", "ja396:5.2", "ja396:5.3", "ja396:5.4", "ja396:6.1", "ja396:6.2", "ja396:6.3", "ja396:6.4", "ja396:7.1", "ja396:7.2", "ja396:7.3", "ja396:7.4", "ja396:8.1"]}