{"html_text": {"ja231:0.1": "<article id='ja231'><header><ul><li class='division'>{}</li>", "ja231:0.2": "<li>{}</li>", "ja231:0.3": "<li>{}</li></ul>", "ja231:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja231:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja231:1.2": "<span class='verse-line'>{}</span>", "ja231:1.3": "<span class='verse-line'>{}</span>", "ja231:1.4": "<span class='verse-line'>{}</span></p>", "ja231:2.1": "<p><span class='verse-line'>{}</span>", "ja231:2.2": "<span class='verse-line'>{}</span>", "ja231:2.3": "<span class='verse-line'>{}</span>", "ja231:2.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja231:3.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja231:0.1": "Jātaka ", "ja231:0.2": "Dukanipāta ", "ja231:0.3": "Upāhanavagga ", "ja231:0.4": "1. Upāhanajātaka ", "ja231:1.1": "“Yathāpi kītā purisassupāhanā, ", "ja231:1.2": "Sukhassa atthāya dukhaṁ udabbahe; ", "ja231:1.3": "Ghammābhitattā thalasā papīḷitā, ", "ja231:1.4": "Tasseva pāde purisassa khādare. ", "ja231:2.1": "Evameva yo dukkulīno anariyo, ", "ja231:2.2": "Tammāka vijjañca sutañca ādiya; ", "ja231:2.3": "Tameva so tattha sutena khādati, ", "ja231:2.4": "Anariyo vuccati dupāhanūpamo”ti. ", "ja231:3.1": "Upāhanajātakaṁ paṭhamaṁ. "}, "variant_text": {"ja231:0.1": "", "ja231:0.2": "", "ja231:0.3": "", "ja231:0.4": "", "ja231:1.1": "", "ja231:1.2": "", "ja231:1.3": "", "ja231:1.4": "", "ja231:2.1": "", "ja231:2.2": "Tammāka → tamhāka (bj); tumhāka (sya1ed, pts-vp-pli1); tumhākaṁ (sya2ed) ", "ja231:2.3": "", "ja231:2.4": "dupāhanūpamo”ti → pānadūpamoti (bj, pts-vp-pli1) ", "ja231:3.1": ""}, "reference_text": {"ja231:0.1": "", "ja231:0.2": "", "ja231:0.3": "", "ja231:0.4": "", "ja231:1.1": "bj30.112, csp1ed22.64, csp2ed22.64, dr27.88, ms22J_602, msdiv161, pts-vp-pli2.223", "ja231:1.2": "", "ja231:1.3": "", "ja231:1.4": "", "ja231:2.1": "ms22J_603, msdiv162, sya27.89", "ja231:2.2": "", "ja231:2.3": "", "ja231:2.4": "", "ja231:3.1": "