{"html_text": {"ja374:0.1": "<article id='ja374'><header><ul><li class='division'>{}</li>", "ja374:0.2": "<li>{}</li>", "ja374:0.3": "<li>{}</li></ul>", "ja374:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja374:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja374:1.2": "<span class='verse-line'>{}</span>", "ja374:1.3": "<span class='verse-line'>{}</span>", "ja374:1.4": "<span class='verse-line'>{}</span></p>", "ja374:2.1": "<p><span class='verse-line'>{}</span>", "ja374:2.2": "<span class='verse-line'>{}</span>", "ja374:2.3": "<span class='verse-line'>{}</span>", "ja374:2.4": "<span class='verse-line'>{}</span></p>", "ja374:3.1": "<p><span class='verse-line'>{}</span>", "ja374:3.2": "<span class='verse-line'>{}</span>", "ja374:3.3": "<span class='verse-line'>{}</span>", "ja374:3.4": "<span class='verse-line'>{}</span>", "ja374:3.5": "<span class='verse-line'>{}</span>", "ja374:3.6": "<span class='verse-line'>{}</span></p>", "ja374:4.1": "<p><span class='verse-line'>{}</span>", "ja374:4.2": "<span class='verse-line'>{}</span>", "ja374:4.3": "<span class='verse-line'>{}</span>", "ja374:4.4": "<span class='verse-line'>{}</span></p>", "ja374:5.1": "<p><span class='verse-line'>{}</span>", "ja374:5.2": "<span class='verse-line'>{}</span>", "ja374:5.3": "<span class='verse-line'>{}</span>", "ja374:5.4": "<span class='verse-line'>{}</span></p>", "ja374:6.1": "<p><span class='verse-line'>{}</span>", "ja374:6.2": "<span class='verse-line'>{}</span>", "ja374:6.3": "<span class='verse-line'>{}</span>", "ja374:6.4": "<span class='verse-line'>{}</span></p>", "ja374:7.1": "<p><span class='verse-line'>{}</span>", "ja374:7.2": "<span class='verse-line'>{}</span>", "ja374:7.3": "<span class='verse-line'>{}</span>", "ja374:7.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja374:8.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja374:0.1": "Jātaka ", "ja374:0.2": "Pañcakanipāta ", "ja374:0.3": "Aḍḍhavagga ", "ja374:0.4": "4. Cūḷadhanuggahajātaka ", "ja374:1.1": "“Sabbaṁ bhaṇḍaṁ samādāya, ", "ja374:1.2": "pāraṁ tiṇṇosi brāhmaṇa; ", "ja374:1.3": "Paccāgaccha lahuṁ khippaṁ, ", "ja374:1.4": "mampi tārehi dānito”. ", "ja374:2.1": "“Asanthutaṁ maṁ cirasanthutena, ", "ja374:2.2": "Nimīni bhotī addhuvaṁ dhuvena; ", "ja374:2.3": "Mayāpi bhotī nimineyya aññaṁ, ", "ja374:2.4": "Ito ahaṁ dūrataraṁ gamissaṁ”. ", "ja374:3.1": "“Kāyaṁ eḷagalāgumbe, ", "ja374:3.2": "karoti ahuhāsiyaṁ; ", "ja374:3.3": "Nayīdha naccagītaṁ vā, ", "ja374:3.4": "tāḷaṁ vā susamāhitaṁ; ", "ja374:3.5": "Anamhikāle susoṇi, ", "ja374:3.6": "kiṁ nu jagghasi sobhane”. ", "ja374:4.1": "“Siṅgāla bāla dummedha, ", "ja374:4.2": "appapaññosi jambuka; ", "ja374:4.3": "Jīno macchañca pesiñca, ", "ja374:4.4": "kapaṇo viya jhāyasi”. ", "ja374:5.1": "“Sudassaṁ vajjamaññesaṁ, ", "ja374:5.2": "attano pana duddasaṁ; ", "ja374:5.3": "Jīnā patiñca jārañca, ", "ja374:5.4": "maññe tvaññeva jhāyasi”. ", "ja374:6.1": "“Evametaṁ migarāja, ", "ja374:6.2": "yathā bhāsasi jambuka; ", "ja374:6.3": "Sā nūnāhaṁ ito gantvā, ", "ja374:6.4": "bhattu hessaṁ vasānugā”. ", "ja374:7.1": "“Yo hare mattikaṁ thālaṁ, ", "ja374:7.2": "kaṁsathālampi so hare; ", "ja374:7.3": "Katañceva tayā pāpaṁ, ", "ja374:7.4": "punapevaṁ karissasī”ti. ", "ja374:8.1": "Cūḷadhanuggahajātakaṁ catutthaṁ. "}, "variant_text": {"ja374:0.1": "", "ja374:0.2": "", "ja374:0.3": "", "ja374:0.4": "", "ja374:1.1": "", "ja374:1.2": "", "ja374:1.3": "", "ja374:1.4": "dānito → dāni bho (sya1ed, sya2ed) ", "ja374:2.1": "", "ja374:2.2": "", "ja374:2.3": "", "ja374:2.4": "", "ja374:3.1": "eḷagalāgumbe → eḷagaṇigumbe (sya1ed, sya2ed); eḷagaṇagumbe (mr) ", "ja374:3.2": "", "ja374:3.3": "Nayīdha naccagītaṁ vā → nayidha naccaṁ vā gītaṁ vā (bj, sya1ed, sya2ed, pts-vp-pli1) ", "ja374:3.4": "", "ja374:3.5": "Anamhikāle → anamhakāle (pts-vp-pli1) | susoṇi → sussoṇi (bj, sya1ed, sya2ed, pts-vp-pli1) ", "ja374:3.6": "sobhane → sobhaṇe (pts-vp-pli1, mr) ", "ja374:4.1": "", "ja374:4.2": "", "ja374:4.3": "", "ja374:4.4": "", "ja374:5.1": "", "ja374:5.2": "", "ja374:5.3": "", "ja374:5.4": "maññe tvaññeva → mampi tvaññeva (bj, sya1ed, sya2ed); tvampi maññeva (pts-vp-pli1) ", "ja374:6.1": "", "ja374:6.2": "", "ja374:6.3": "", "ja374:6.4": "", "ja374:7.1": "", "ja374:7.2": "", "ja374:7.3": "Katañceva → kataṁyeva (bj, sya1ed, sya2ed, pts-vp-pli1) ", "ja374:7.4": "", "ja374:8.1": "Cūḷadhanuggahajātakaṁ → culladhanuggahajātakaṁ (bj, sya1ed, sya2ed, pts-vp-pli1) "}, "reference_text": {"ja374:0.1": "", "ja374:0.2": "", "ja374:0.3": "", "ja374:0.4": "", "ja374:1.1": "csp1ed22.135, csp2ed22.135, ms22J_1298, msdiv128, ndp22.126, pts-vp-pli3.221", "ja374:1.2": "", "ja374:1.3": "", "ja374:1.4": "", "ja374:2.1": "ms22J_1299, msdiv129, pts-vp-pli3.222", "ja374:2.2": "", "ja374:2.3": "", "ja374:2.4": "", "ja374:3.1": "ms22J_1300, msdiv130, pts-vp-pli3.223", "ja374:3.2": "", "ja374:3.3": "", "ja374:3.4": "", "ja374:3.5": "", "ja374:3.6": "", "ja374:4.1": "ms22J_1301, msdiv131, sya27.185", "ja374:4.2": "", "ja374:4.3": "", "ja374:4.4": "", "ja374:5.1": "dr27.184, ms22J_1302, msdiv132", "ja374:5.2": "", "ja374:5.3": "", "ja374:5.4": "", "ja374:6.1": "bj30.232, ms22J_1303, msdiv133, pts-vp-pli3.224", "ja374:6.2": "", "ja374:6.3": "", "ja374:6.4": "", "ja374:7.1": "ms22J_1304, msdiv134", "ja374:7.2": "", "ja374:7.3": "", "ja374:7.4": "", "ja374:8.1": "ms22J_1305"}, "keys_order": ["ja374:0.1", "ja374:0.2", "ja374:0.3", "ja374:0.4", "ja374:1.1", "ja374:1.2", "ja374:1.3", "ja374:1.4", "ja374:2.1", "ja374:2.2", "ja374:2.3", "ja374:2.4", "ja374:3.1", "ja374:3.2", "ja374:3.3", "ja374:3.4", "ja374:3.5", "ja374:3.6", "ja374:4.1", "ja374:4.2", "ja374:4.3", "ja374:4.4", "ja374:5.1", "ja374:5.2", "ja374:5.3", "ja374:5.4", "ja374:6.1", "ja374:6.2", "ja374:6.3", "ja374:6.4", "ja374:7.1", "ja374:7.2", "ja374:7.3", "ja374:7.4", "ja374:8.1"]}