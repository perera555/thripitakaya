{"html_text": {"ja293:0.1": "<article id='ja293'><header><ul><li class='division'>{}</li>", "ja293:0.2": "<li>{}</li>", "ja293:0.3": "<li>{}</li></ul>", "ja293:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja293:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja293:1.2": "<span class='verse-line'>{}</span>", "ja293:1.3": "<span class='verse-line'>{}</span>", "ja293:1.4": "<span class='verse-line'>{}</span></p>", "ja293:2.1": "<p><span class='verse-line'>{}</span>", "ja293:2.2": "<span class='verse-line'>{}</span>", "ja293:2.3": "<span class='verse-line'>{}</span>", "ja293:2.4": "<span class='verse-line'>{}</span></p>", "ja293:3.1": "<p><span class='verse-line'>{}</span>", "ja293:3.2": "<span class='verse-line'>{}</span>", "ja293:3.3": "<span class='verse-line'>{}</span>", "ja293:3.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja293:4.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja293:0.1": "Jātaka ", "ja293:0.2": "Tikanipāta ", "ja293:0.3": "Kumbhavagga ", "ja293:0.4": "3. Kāyanibbindajātaka ", "ja293:1.1": "“Phuṭṭhassa me aññatarena byādhinā, ", "ja293:1.2": "Rogena bāḷhaṁ dukhitassa ruppato; ", "ja293:1.3": "Parisussati khippamidaṁ kaḷevaraṁ, ", "ja293:1.4": "Pupphaṁ yathā paṁsuni ātape kataṁ. ", "ja293:2.1": "Ajaññaṁ jaññasaṅkhātaṁ, ", "ja293:2.2": "asuciṁ sucisammataṁ; ", "ja293:2.3": "Nānākuṇapaparipūraṁ, ", "ja293:2.4": "jaññarūpaṁ apassato. ", "ja293:3.1": "Dhiratthumaṁ āturaṁ pūtikāyaṁ, ", "ja293:3.2": "Jegucchiyaṁ assuciṁ byādhidhammaṁ; ", "ja293:3.3": "Yatthappamattā adhimucchitā pajā, ", "ja293:3.4": "Hāpenti maggaṁ sugatūpapattiyā”ti. ", "ja293:4.1": "Kāyanibbindajātakaṁ tatiyaṁ. "}, "variant_text": {"ja293:0.1": "", "ja293:0.2": "", "ja293:0.3": "", "ja293:0.4": "", "ja293:1.1": "", "ja293:1.2": "", "ja293:1.3": "", "ja293:1.4": "", "ja293:2.1": "", "ja293:2.2": "", "ja293:2.3": "", "ja293:2.4": "", "ja293:3.1": "", "ja293:3.2": "", "ja293:3.3": "", "ja293:3.4": "", "ja293:4.1": "Kāyanibbindajā