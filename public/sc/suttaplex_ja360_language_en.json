[{"acronym": "Ja 360", "alt_acronym": null, "volpages": "PTS 3.189, PTS 3.190", "alt_volpages": null, "uid": "ja360", "blurb": "“I scent the fragrance”—This story the Master, while living at Jetavana, told concerning a backsliding Brother. The Master asked if it were true that he longed for the world, and what he had seen to make him regret having taken orders. The Brother answered, “It was all owing to the charms of a woman.” The Master said, “Verily, Brother, there is no possibility of being on one’s guard against womenfolk. Sages of old, though they took the precaution to dwell in the abode of the Garudas, failed to be on their guard against them.” And being urged by him, the Master related a story of the past. ", "difficulty": null, "original_title": "Suyonandījātaka", "root_lang": "pli", "root_lang_name": "Pāli", "type": "leaf", "translated_title": "Sussondi Jātaka", "translations": [{"lang": "pli", "lang_name": "Pāli", "is_root": true, "author": "Mahāsaṅgīti Tipiṭaka Buddhavasse 2500", "author_short": "ms", "author_uid": "ms", "publication_date": null, "id": "ja360_root-pli-ms", "segmented": true, "title": null, "volpage": null, "has_comment": false}, {"lang": "de", "lang_name": "Deutsch", "is_root": false, "author": "Dr. Julius Dutoit", "author_short": "Dutoit", "author_uid": "dutoit", "publication_date": "2007", "id": "de_ja360_dutoit", "segmented": false, "volpage": null, "has_comment": false}, {"author": "H.T. Francis, R.A. Neil", "author_short": "Francis …", "author_uid": "francis-neil", "has_comment": false, "id": "en_ja360_francis-neil", "is_root": false, "lang": "en", "lang_name": "English", "publication_date": "1897", "segmented": false, "volpage": null, "title": "Sussondi Jātaka"}, {"lang": "jpn", "lang_name": "日本語", "is_root": false, "author": "関西パーリ語実習会", "author_short": "関西パーリ語実習会", "author_uid": "kansai", "publication_date": "2023", "id": "jpn_ja360_kansai", "segmented": false, "volpage": null, "has_comment": false}, {"lang": "si", "lang_name": "