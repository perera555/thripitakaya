6:37.2": "<span class='verse-line'>{}</span>", "ja516:37.3": "<span class='verse-line'>{}</span>", "ja516:37.4": "<span class='verse-line'>{}</span></p>", "ja516:38.1": "<p><span class='verse-line'>{}</span>", "ja516:38.2": "<span class='verse-line'>{}</span>", "ja516:38.3": "<span class='verse-line'>{}</span>", "ja516:38.4": "<span class='verse-line'>{}</span></p>", "ja516:39.1": "<p><span class='verse-line'>{}</span>", "ja516:39.2": "<span class='verse-line'>{}</span>", "ja516:39.3": "<span class='verse-line'>{}</span>", "ja516:39.4": "<span class='verse-line'>{}</span></p>", "ja516:40.1": "<p><span class='verse-line'>{}</span>", "ja516:40.2": "<span class='verse-line'>{}</span>", "ja516:40.3": "<span class='verse-line'>{}</span>", "ja516:40.4": "<span class='verse-line'>{}</span></p>", "ja516:41.1": "<p><span class='verse-line'>{}</span>", "ja516:41.2": "<span class='verse-line'>{}</span>", "ja516:41.3": "<span class='verse-line'>{}</span>", "ja516:41.4": "<span class='verse-line'>{}</span></p>", "ja516:42.1": "<p><span class='verse-line'>{}</span>", "ja516:42.2": "<span class='verse-line'>{}</span>", "ja516:42.3": "<span class='verse-line'>{}</span>", "ja516:42.4": "<span class='verse-line'>{}</span></p>", "ja516:43.1": "<p><span class='verse-line'>{}</span>", "ja516:43.2": "<span class='verse-line'>{}</span>", "ja516:43.3": "<span class='verse-line'>{}</span>", "ja516:43.4": "<span class='verse-line'>{}</span></p>", "ja516:44.1": "<p><span class='verse-line'>{}</span>", "ja516:44.2": "<span class='verse-line'>{}</span>", "ja516:44.3": "<span class='verse-line'>{}</span>", "ja516:44.4": "<span class='verse-line'>{}</span></p>", "ja516:45.1": "<p><span class='verse-line'>{}</span>", "ja516:45.2": "<span class='verse-line'>{}</span>", "ja516:45.3": "<span class='verse-line'>{}</span>", "ja516:45.4": "<span class='verse-line'>{}</span></p>", "ja516:46.1": "<p><span class='verse-line'>{}</span>", "ja516:46.2": "<span class='verse-line'>{}</span>", "ja516:46.3": "<span class='verse-line'>{}</span>", "ja516:46.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja516:47.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja516:0.1": "Jātaka ", "ja516:0.2": "Tiṁsanipāta ", "ja516:0.3": "Kiṁchandavagga ", "ja516:0.4": "6. Mahākapijātaka ", "ja516:1.1": "Bārāṇasyaṁ ahū rājā, ", "ja516:1.2": "kāsīnaṁ raṭṭhavaḍḍhano; ", "ja516:1.3": "Mittāmaccaparibyūḷho, ", "ja516:1.4": "agamāsi migājinaṁ. ", "ja516:2.1": "Tattha brāhmaṇamaddakkhi, ", "ja516:2.2": "setaṁ citraṁ kilāsinaṁ; ", "ja516:2.3": "Viddhastaṁ koviḷāraṁva, ", "ja516:2.4": "kisaṁ dhamanisanthataṁ. ", "ja516:3.1": "Paramakāruññataṁ pattaṁ, ", "ja516:3.2": "disvā kicchagataṁ naraṁ; ", "ja516:3.3": "Avaca byamhito rājā, ", "ja516:3.4": "“yakkhānaṁ katamo nusi. ", "ja516:4.1": "Hatthapādā ca te setā, ", "ja516:4.2": "tato setataraṁ siro; ", "ja516:4.3": "Gattaṁ kammāsavaṇṇaṁ te, ", "ja516:4.4": "kilāsabahulo casi. ", "ja516:5.1": "Vaṭṭanāvaḷi saṅkāsā, ", "ja516:5.2": "piṭṭhi te ninnatunnatā; ", "ja516:5.3": "Kāḷapabbāva te aṅgā, ", "ja516:5.4": "nāññaṁ passāmi edisaṁ. ", "ja516:6.1": "Ugghaṭṭapādo tasito, ", "ja516:6.2": "kiso dhamanisanthato; ", "ja516:6.3": "Chāto ātattarūposi, ", "ja516:6.4": "kutosi kattha gacchasi. ", "ja516:7.1": "Duddasī appakārosi, ", "ja516:7.2": "dubbaṇṇo bhīmadassano; ", "ja516:7.3": "Janetti yāpi te mātā, ", "ja516:7.4": "na taṁ iccheyya passituṁ. ", "ja516:8.1": "Kiṁ kammamakaraṁ pubbe, ", "ja516:8.2": "Kaṁ avajjhaṁ aghātayi; ", "ja516:8.3": "Kibbisaṁ yaṁ karitvāna, ", "ja516:8.4": "Idaṁ dukkhaṁ upāgami”. ", "ja516:9.1": "“Taggha te ahamakkhissaṁ, ", "ja516:9.2": "yathāpi kusalo tathā; ", "ja516:9.3": "Saccavādiñhi lokasmiṁ, ", "ja516:9.4": "pasaṁsantīdha paṇḍitā. ", "ja516:10.1": "Eko caraṁ gogaveso, ", "ja516:10.2": "mūḷho accasariṁ vane; ", "ja516:10.3": "Araññe irīṇe vivane, ", "ja516:10.4": "nānākuñjarasevite. ", "ja516:11.1": "Vāḷamigānucarite, ", "ja516:11.2": "vippanaṭṭhosmi kānane; ", "ja516:11.3": "Acariṁ tattha sattāhaṁ, ", "ja516:11.4": "khuppipāsasamappito. ", "ja516:12.1": "Tattha tindukamaddakkhiṁ, ", "ja516:12.2": "visamaṭṭhaṁ bubhukkhito; ", "ja516:12.3": "Papātamabhilambantaṁ, ", "ja516:12.4": "sampannaphaladhārinaṁ. ", "ja516:13.1": "Vātassitāni bhakkhesiṁ, ", "ja516:13.2": "tāni rucciṁsu me bhusaṁ; ", "ja516:13.3": "Atitto rukkhamārūhiṁ, ", "ja516:13.4": "tattha hessāmi āsito. ", "ja516:14.1": "Ekaṁ me bhakkhitaṁ āsi, ", "ja516:14.2": "dutiyaṁ abhipatthitaṁ; ", "ja516:14.3": "Tato sā bhañjatha sākhā, ", "ja516:14.4": "chinnā pharasunā viya. ", "ja516:15.1": "Sohaṁ sahāva sākhāhi, ", "ja516:15.2": "uddhampādo avaṁsiro; ", "ja516:15.3": "Appatiṭṭhe anālambe, ", "ja516:15.4": "giriduggasmi pāpataṁ. ", "ja516:16.1": "Yasmā ca vāri gambhīraṁ, ", "ja516:16.2": "tasmā na samapajjisaṁ; ", "ja516:16.3": "Tattha sesiṁ nirānando, ", "ja516:16.4": "anūnā dasa rattiyo. ", "ja516:17.1": "Athettha kapi māgañchi, ", "ja516:17.2": "gonaṅgulo darīcaro; ", "ja516:17.3": "Sākhāhi sākhaṁ vicaranto, ", "ja516:17.4": "khādamāno dumapphalaṁ. ", "ja516:18.1": "So maṁ disvā kisaṁ paṇḍuṁ, ", "ja516:18.2": "kāruññamakaraṁ mayi; ", "ja516:18.3": "Ambho ko nāma so ettha, ", "ja516:18.4": "evaṁ dukkhena aṭṭito. ", "ja516:19.1": "Manusso amanusso vā, ", "ja516:19.2": "attānaṁ me pavedaya; ", "ja516:19.3": "Tassañjaliṁ paṇāmetvā, ", "ja516:19.4": "idaṁ vacanamabraviṁ. ", "ja516:20.1": "Manussohaṁ byasampatto, ", "ja516:20.2": "sā me natthi ito gati; ", "ja516:20.3": "Taṁ vo vadāmi bhaddaṁ vo, ", "ja516:20.4": "tvañca me saraṇaṁ bhava. ", "ja516:21.1": "Garuṁ silaṁ gahetvāna, ", "ja516:21.2": "vicarī pabbate kapi; ", "ja516:21.3": "Silāya yoggaṁ katvāna, ", "ja516:21.4": "nisabho etadabravi. ", "ja516:22.1": "Ehi me piṭṭhimāruyha, ", "ja516:22.2": "gīvaṁ gaṇhāhi bāhubhi; ", "ja516:22.3": "Ahaṁ taṁ uddharissāmi, ", "ja516:22.4": "giriduggata vegasā. ", "ja516:23.1": "Tassa taṁ vacanaṁ sutvā, ", "ja516:23.2": "vānarindassa sirīmato; ", "ja516:23.3": "Piṭṭhimāruyha dhīrassa, ", "ja516:23.4": "gīvaṁ bāhāhi aggahiṁ. ", "ja516:24.1": "So maṁ tato samuṭṭhāsi, ", "ja516:24.2": "tejassī balavā kapi; ", "ja516:24.3": "Vihaññamāno kicchena, ", "ja516:24.4": "giriduggata vegasā. ", "ja516:25.1": "Uddharitvāna maṁ santo, ", "ja516:25.2": "nisabho etadabravi; ", "ja516:25.3": "Iṅgha maṁ samma rakkhassu, ", "ja516:25.4": "pasupissaṁ muhuttakaṁ. ", "ja516:26.1": "Sīhā byagghā ca dīpī ca, ", "ja516:26.2": "acchakokataracchayo; ", "ja516:26.3": "Te maṁ pamattaṁ hiṁseyyuṁ, ", "ja516:26.4": "te tvaṁ disvā nivāraya. ", "ja516:27.1": "Evaṁ me parittātūna, ", "ja516:27.2": "pasupī so muhuttakaṁ; ", "ja516:27.3": "Tadāhaṁ pāpikaṁ diṭṭhiṁ, ", "ja516:27.4": "paṭilacchiṁ ayoniso. ", "ja516:28.1": "Bhakkho ayaṁ manussānaṁ, ", "ja516:28.2": "yathā caññe vane migā; ", "ja516:28.3": "Yaṁ nūnimaṁ vadhitvāna, ", "ja516:28.4": "chāto khādeyya vānaraṁ. ", "ja516:29.1": "Asito ca gamissāmi, ", "ja516:29.2": "maṁsamādāya sambalaṁ; ", "ja516:29.3": "Kantāraṁ nittharissāmi, ", "ja516:29.4": "pātheyyaṁ me bhavissati. ", "ja516:30.1": "Tato silaṁ gahetvāna, ", "ja516:30.2": "matthakaṁ sannitāḷayiṁ; ", "ja516:30.3": "Mama gattakilantassa, ", "ja516:30.4": "pahāro dubbalo ahu. ", "ja516:31.1": "So ca vegenudappatto, ", "ja516:31.2": "kapi ruhira makkhito; ", "ja516:31.3": "Assupuṇṇehi nettehi, ", "ja516:31.4": "rodanto maṁ udikkhati. ", "ja516:32.1": "‘Māyyomaṁ kari bhaddante, ", "ja516:32.2": "tvañca nāmedisaṁ kari; ", "ja516:32.3": "Tvañca kho nāma dīghāvu, ", "ja516:32.4": "aññe vāretumarahasi. ", "ja516:33.1": "Aho vata re purisa, ", "ja516:33.2": "tāvadukkarakāraka; ", "ja516:33.3": "Edisā visamā duggā, ", "ja516:33.4": "papātā uddhato mayā. ", "ja516:34.1": "Ānīto paralokāva, ", "ja516:34.2": "dubbheyyaṁ maṁ amaññatha; ", "ja516:34.3": "Taṁ tena pāpadhammena, ", "ja516:34.4": "pāpaṁ pāpena cintitaṁ. ", "ja516:35.1": "Mā heva tvaṁ adhammaṭṭha, ", "ja516:35.2": "vedanaṁ kaṭukaṁ phusi; ", "ja516:35.3": "Mā heva pāpakammaṁ taṁ, ", "ja516:35.4": "phalaṁ veḷuṁva taṁ vadhi. ", "ja516:36.1": "Tayime natthi vissāso, ", "ja516:36.2": "pāpadhamma asaññata; ", "ja516:36.3": "Ehi me piṭṭhito gaccha, ", "ja516:36.4": "dissamānova santike. ", "ja516:37.1": "Muttosi hatthā vāḷānaṁ, ", "ja516:37.2": "pattosi mānusiṁ padaṁ; ", "ja516:37.3": "Esa maggo adhammaṭṭha, ", "ja516:37.4": "tena gaccha yathāsukhaṁ’. ", "ja516:38.1": "Idaṁ vatvā giricaro, ", "ja516:38.2": "rahade pakkhalya matthakaṁ; ", "ja516:38.3": "Assūni sampamajjitvā, ", "ja516:38.4": "tato pabbatamāruhi. ", "ja516:39.1": "Sohaṁ tenābhisattosmi, ", "ja516:39.2": "pariḷāhena aṭṭito; ", "ja516:39.3": "Ḍayhamānena gattena, ", "ja516:39.4": "vāriṁ pātuṁ upāgamiṁ. ", "ja516:40.1": "Agginā viya santatto, ", "ja516:40.2": "rahado ruhiramakkhito; ", "ja516:40.3": "Pubbalohitasaṅkāso, ", "ja516:40.4": "sabbo me samapajjatha. ", "ja516:41.1": "Yāvanto udabindūni, ", "ja516:41.2": "kāyasmiṁ nipatiṁsu me; ", "ja516:41.3": "Tāvanto gaṇḍa jāyetha, ", "ja516:41.4": "addhabeluvasādisā. ", "ja516:42.1": "Pabhinnā pagghariṁsu me, ", "ja516:42.2": "kuṇapā pubbalohitā; ", "ja516:42.3": "Yena yeneva gacchāmi, ", "ja516:42.4": "gāmesu nigamesu ca. ", "ja516:43.1": "Daṇḍahatthā nivārenti, ", "ja516:43.2": "itthiyo purisā ca maṁ; ", "ja516:43.3": "Okkitā pūtigandhena, ", "ja516:43.4": "māssu orena āgamā. ", "ja516:44.1": "Etādisaṁ idaṁ dukkhaṁ, ", "ja516:44.2": "satta vassāni dāni me; ", "ja516:44.3": "Anubhomi sakaṁ kammaṁ, ", "ja516:44.4": "pubbe dukkaṭamattano. ", "ja516:45.1": "Taṁ vo vadāmi bhaddante, ", "ja516:45.2": "yāvantettha samāgatā; ", "ja516:45.3": "Māssu mittāna dubbhittho, ", "ja516:45.4": "mittadubbho hi pāpako. ", "ja516:46.1": "Kuṭṭhī kilāsī bhavati, ", "ja516:46.2": "yo mittānidha dubbhati; ", "ja516:46.3": "Kāyassa bhedā mittaddu, ", "ja516:46.4": "nirayaṁ sopapajjatī”ti. ", "ja516:47.1": "Mahākapijātakaṁ chaṭṭhaṁ. "}, "variant_text": {"ja516:0.1": "", "ja516:0.2": "", "ja516:0.3": "", "ja516:0.4": "", "ja516:1.1": "Bārāṇasyaṁ → bārāṇassaṁ (bj, pts-vp-pli1) ", "ja516:1.2": "", "ja516:1.3": "", "ja516:1.4": "migājinaṁ → migājira