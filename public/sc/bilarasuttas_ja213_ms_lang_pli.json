{"html_text": {"ja213:0.1": "<article id='ja213'><header><ul><li class='division'>{}</li>", "ja213:0.2": "<li>{}</li>", "ja213:0.3": "<li>{}</li></ul>", "ja213:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja213:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja213:1.2": "<span class='verse-line'>{}</span>", "ja213:1.3": "<span class='verse-line'>{}</span>", "ja213:1.4": "<span class='verse-line'>{}</span></p>", "ja213:2.1": "<p><span class='verse-line'>{}</span>", "ja213:2.2": "<span class='verse-line'>{}</span>", "ja213:2.3": "<span class='verse-line'>{}</span>", "ja213:2.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja213:3.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja213:0.1": "Jātaka ", "ja213:0.2": "Dukanipāta ", "ja213:0.3": "Bīraṇathambhavagga ", "ja213:0.4": "3. Bharujātaka ", "ja213:1.1": "“Isīnamantaraṁ katvā, ", "ja213:1.2": "bharurājāti me sutaṁ; ", "ja213:1.3": "Ucchinno saha raṭṭhehi, ", "ja213:1.4": "sarājā vibhavaṅgato. ", "ja213:2.1": "Tasmā hi chandāgamanaṁ, ", "ja213:2.2": "nappasaṁsanti paṇḍitā; ", "ja213:2.3": "Aduṭṭhacitto bhāseyya, ", "ja213:2.4": "giraṁ saccupasaṁhitan”ti. ", "ja213:3.1": "Bharujātakaṁ tatiyaṁ. "}, "variant_text": {"ja213:0.1": "", "ja213:0.2": "", "ja213:0.3": "", "ja213:0.4": "", "ja213:1.1": "", "ja213:1.2": "bharurājāti → kururājāti (mr) ", "ja213:1.3": "raṭṭhehi → raṭṭhena (bj, pts-vp-pli1) ", "ja213:1.4": "", "ja213:2.1": "", "ja213:2.2": "", "ja213:2.3": "", "ja213:2.4": "", "ja213:3.1": "Bharujātakaṁ → bharurājajātakaṁ (sya1ed, sya2ed); kurujātakaṁ (mr) "}, "reference_text": {"ja213:0.1": "", "ja213:0.2": "", "ja213:0.3": "", "ja213:0.4": "", "ja213:1.1": "ms22J_544, msdiv125, pts-vp-pli2.172, vri68.52", "ja213:1.2": "", "ja213:1.3": "", "ja213:1.4": "", "ja213:2.1": "dr27.79, ms22J_545, msdiv126", "ja213:2.2": "", "ja213:2.3": "", "ja213:2.4": "", "ja213:3.1": "ms22J_546"}, "keys_order": ["ja213:0.1", "ja213:0.2", "ja213:0.3", "ja213:0.4", "ja213:1.1", "j