{"html_text": {"ja81:0.1": "<article id='ja81'><header><ul><li class='division'>{}</li>", "ja81:0.2": "<li>{}</li>", "ja81:0.3": "<li>{}</li></ul>", "ja81:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja81:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja81:1.2": "<span class='verse-line'>{}</span>", "ja81:1.3": "<span class='verse-line'>{}</span>", "ja81:1.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja81:2.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja81:0.1": "Jātaka ", "ja81:0.2": "Ekakanipāta ", "ja81:0.3": "Apāyimhavagga ", "ja81:0.4": "1. Surāpānajātaka ", "ja81:1.1": "“Apāyimha anaccimha, ", "ja81:1.2": "agāyimha rudimha ca; ", "ja81:1.3": "Visaññikaraṇiṁ pitvā, ", "ja81:1.4": "diṭṭhā nāhumha vānarā”ti. ", "ja81:2.1": "Surāpānajātakaṁ paṭhamaṁ. "}, "variant_text": {"ja81:0.1": "", "ja81:0.2": "", "ja81:0.3": "", "ja81:0.4": "", "ja81:1.1": "", "ja81:1.2": "", "ja81:1.3": "Visaññikaraṇiṁ → visaññakaraṇiṁ (bj, pts-vp-pli1) | pitvā → pītvā (bj, sya1ed, sya2ed, pts-vp-pli1) ", "ja81:1.4": "", "ja81:2.1": ""}, "reference_text": {"ja81:0.1": "", "ja81:0.2": "", "ja81:0.3": "", "ja81:0.4": "", "ja81:1.1": "bj30.34, dr27.28, ms22J_180, msdiv81, ndp22.20, pts-vp-pli1.362, vri68.19", "ja81:1.2": "", "ja81:1.3": "", "ja81:1.4": "", "ja81:2.1": "ms22J_181"}, "keys_order": ["ja81:0.1", "ja81:0.2", "ja81:0.3", "ja81:0.4", "ja81:1.1", "ja81:1.2", "ja81:1.3", "ja81:1.4", "ja81:2.1"]}