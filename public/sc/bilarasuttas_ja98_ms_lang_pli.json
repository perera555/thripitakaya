{"html_text": {"ja98:0.1": "<article id='ja98'><header><ul><li class='division'>{}</li>", "ja98:0.2": "<li>{}</li>", "ja98:0.3": "<li>{}</li></ul>", "ja98:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja98:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja98:1.2": "<span class='verse-line'>{}</span>", "ja98:1.3": "<span class='verse-line'>{}</span>", "ja98:1.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja98:2.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja98:0.1": "Jātaka ", "ja98:0.2": "Ekakanipāta ", "ja98:0.3": "Littavagga ", "ja98:0.4": "8. Kūṭavāṇijajātaka ", "ja98:1.1": "“Sādhu kho paṇḍito nāma, ", "ja98:1.2": "na tveva atipaṇḍito; ", "ja98:1.3": "Atipaṇḍitena puttena, ", "ja98:1.4": "manamhi upakūḷitoti. ", "ja98:2.1": "Kūṭavāṇijajātakaṁ aṭṭhamaṁ. "}, "variant_text": {"ja98:0.1": "", "ja98:0.2": "", "ja98:0.3": "", "ja98:0.4": "", "ja98:1.1": "", "ja98:1.2": "", "ja98:1.3": "", "ja98:1.4": "upakūḷitoti → upakūlitoti (bj); upakuṭṭhitoti (sya1ed, sya2ed); upakuṭito (mr) ", "ja98:2.1": ""}, "reference_text": {"ja98:0.1": "", "ja98:0.2": "", "ja98:0.3": "", "ja98:0.4": "", "ja98:1.1": "ms22J_216, msdiv98, pts-vp-pli1.405, sya27.32", "ja98:1.2": "", "ja98:1.3": "", "ja98:1.4": "", "ja98:2.1": "ms22J_217"}, "keys_order": ["ja98:0.1", "ja98:0.2", "ja98:0.3", "ja98:0.4", "ja98:1.1", "ja98:1.2", "ja98:1.3", "ja98:1.4", "ja98:2.1"]}