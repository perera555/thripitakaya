{"html_text": {"ja178:0.1": "<article id='ja178'><header><ul><li class='division'>{}</li>", "ja178:0.2": "<li>{}</li>", "ja178:0.3": "<li>{}</li></ul>", "ja178:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja178:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja178:1.2": "<span class='verse-line'>{}</span>", "ja178:1.3": "<span class='verse-line'>{}</span>", "ja178:1.4": "<span class='verse-line'>{}</span>", "ja178:1.5": "<span class='verse-line'>{}</span>", "ja178:1.6": "<span class='verse-line'>{}</span></p>", "ja178:2.1": "<p><span class='verse-line'>{}</span>", "ja178:2.2": "<span class='verse-line'>{}</span>", "ja178:2.3": "<span class='verse-line'>{}</span>", "ja178:2.4": "<span class='verse-line'>{}</span>", "ja178:2.5": "<span class='verse-line'>{}</span>", "ja178:2.6": "<span class='verse-line'>{}</span></p></blockquote>", "ja178:3.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja178:0.1": "Jātaka ", "ja178:0.2": "Dukanipāta ", "ja178:0.3": "Kalyāṇavagga ", "ja178:0.4": "8. Kacchapajātaka ", "ja178:1.1": "“Janittaṁ me bhavittaṁ me, ", "ja178:1.2": "iti paṅke avassayiṁ; ", "ja178:1.3": "Taṁ maṁ paṅko ajjhabhavi, ", "ja178:1.4": "yathā dubbalakaṁ tathā; ", "ja178:1.5": "Taṁ taṁ vadāmi bhaggava, ", "ja178:1.6": "suṇohi vacanaṁ mama”. ", "ja178:2.1": "“Gāme vā yadi vā raññe, ", "ja178:2.2": "sukhaṁ yatrādhigacchati; ", "ja178:2.3": "Taṁ janittaṁ bhavittañca, ", "ja178:2.4": "purisassa pajānato; ", "ja178:2.5": "Yamhi jīve tamhi gacche, ", "ja178:2.6": "na niketahato siyā”ti. ", "ja178:3.1": "Kacchapajātakaṁ aṭṭhamaṁ. "}, "variant_text": {"ja178:0.1": "", "ja178:0.2": "", "ja178:0.3": "", "ja178:0.4": "", "ja178:1.1": "Janittaṁ me bhavittaṁ me → janitaṁ me bhavitaṁ me (sya1ed, sya2ed) ", "ja178:1.2": "", "ja178:1.3": "", "ja178:1.4": "", "ja178:1.5": "", "ja178:1.6": "", "ja178:2.1": "", "ja178:2.2": "", "ja178:2.3": "", "ja178:2.4": "", "ja178:2.5": "", "ja178:2.6": "", "ja178:3.1": ""}, "reference_text": {"ja178:0.1"