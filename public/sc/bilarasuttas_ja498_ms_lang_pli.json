"ja498:22.4": "", "ja498:23.1": "", "ja498:23.2": "", "ja498:23.3": "", "ja498:23.4": "Yathā ciraṁ → yamācaraṁ (bj, pts-vp-pli1, Ma-aka) ", "ja498:24.1": "", "ja498:24.2": "", "ja498:24.3": "Dhammiṁ → dhammaṁ (bj, pts-vp-pli1) ", "ja498:24.4": "Adhammakāro tava → adhammakāro ca te (bj, sya1ed, sya2ed, pts-vp-pli1) ", "ja498:25.1": "", "ja498:25.2": "", "ja498:25.3": "", "ja498:25.4": "", "ja498:26.1": "", "ja498:26.2": "", "ja498:26.3": "", "ja498:26.4": "saggamupehi → … mupeti (pts-vp-pli1, mr) ", "ja498:27.1": "", "ja498:27.2": "", "ja498:27.3": "", "ja498:27.4": "Bhāsesi → bhāsehi (sya1ed, sya2ed, pts-vp-pli1, mr) ", "ja498:28.1": "", "ja498:28.2": "", "ja498:28.3": "suvānehi → supānehi (bj, pts-vp-pli1) ", "ja498:28.4": "", "ja498:29.1": ""}, "reference_text": {"ja498:0.1": "", "ja498:0.2": "", "ja498:0.3": "", "ja498:0.4": "", "ja498:1.1": "ms22J_2877, msdiv24, pts-vp-pli4.394, sya27.414", "ja498:1.2": "", "ja498:1.3": "", "ja498:1.4": "", "ja498:2.1": "dr27.414, ms22J_2878, msdiv25, ndp22.308, vri68.237", "ja498:2.2": "", "ja498:2.3": "", "ja498:2.4": "", "ja498:3.1": "ms22J_2879, msdiv26", "ja498:3.2": "", "ja498:3.3": "", "ja498:3.4": "", "ja498:4.1": "ms22J_2880, msdiv27", "ja498:4.2": "", "ja498:4.3": "", "ja498:4.4": "", "ja498:5.1": "csp1ed22.313, csp2ed22.313, ms22J_2881, msdiv28, pts-vp-pli4.395", "ja498:5.2": "", "ja498:5.3": "", "ja498:5.4": "", "ja498:6.1": "ms22J_2882, msdiv29", "ja498:6.2": "", "ja498:6.3": "", "ja498:6.4": "", "ja498:7.1": "bj31.10, dr27.415, ms22J_2883, msdiv30, sya27.415", "ja498:7.2": "", "ja498:7.3": "", "ja498:7.4": "", "ja498:8.1": "ms22J_2884, msdiv31, ndp22.309", "ja498:8.2": "", "ja498:8.3": "", "ja498:8.4": "", "ja498:9.1": "ms22J_2885, msdiv32, pts-vp-pli4.396", "ja498:9.2": "", "ja498:9.3": "", "ja498:9.4": "", "ja498:10.1": "ms22J_2886, msdiv33", "ja498:10.2": "", "ja498:10.3": "", "ja498:10.4": "", "ja498:11.1": "ms22J_2887, msdiv34", "ja498:11.2": "", "ja498:11.3": "", "ja498:11.4": "", "ja498:12.1": "ms22J_2888, m