{"html_text": {"ja316:0.1": "<article id='ja316'><header><ul><li class='division'>{}</li>", "ja316:0.2": "<li>{}</li>", "ja316:0.3": "<li>{}</li></ul>", "ja316:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja316:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja316:1.2": "<span class='verse-line'>{}</span>", "ja316:1.3": "<span class='verse-line'>{}</span>", "ja316:1.4": "<span class='verse-line'>{}</span></p>", "ja316:2.1": "<p><span class='verse-line'>{}</span>", "ja316:2.2": "<span class='verse-line'>{}</span>", "ja316:2.3": "<span class='verse-line'>{}</span>", "ja316:2.4": "<span class='verse-line'>{}</span>", "ja316:2.5": "<span class='verse-line'>{}</span>", "ja316:2.6": "<span class='verse-line'>{}</span></p>", "ja316:3.1": "<p><span class='verse-line'>{}</span>", "ja316:3.2": "<span class='verse-line'>{}</span>", "ja316:3.3": "<span class='verse-line'>{}</span>", "ja316:3.4": "<span class='verse-line'>{}</span></p>", "ja316:4.1": "<p><span class='verse-line'>{}</span>", "ja316:4.2": "<span class='verse-line'>{}</span>", "ja316:4.3": "<span class='verse-line'>{}</span>", "ja316:4.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja316:5.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja316:0.1": "Jātaka ", "ja316:0.2": "Catukkanipāta ", "ja316:0.3": "Pucimandavagga ", "ja316:0.4": "6. Sasapaṇḍitajātaka ", "ja316:1.1": "“Satta me rohitā macchā, ", "ja316:1.2": "udakā thalamubbhatā; ", "ja316:1.3": "Idaṁ brāhmaṇa me atthi, ", "ja316:1.4": "etaṁ bhutvā vane vasa”. ", "ja316:2.1": "“Dussa me khettapālassa, ", "ja316:2.2": "rattibhattaṁ apābhataṁ; ", "ja316:2.3": "Maṁsasūlā ca dve godhā, ", "ja316:2.4": "ekañca dadhivārakaṁ; ", "ja316:2.5": "Idaṁ brāhmaṇa me atthi, ", "ja316:2.6": "etaṁ bhutvā vane vasa”. ", "ja316:3.1": "“Ambapakkaṁ dakaṁ sītaṁ, ", "ja316:3.2": "Sītacchāyā manoramā; ", "ja316:3.3": "Idaṁ brāhmaṇa me atthi, ", "ja316:3.4": "Etaṁ bhutvā vane vasa”. ", "ja316:4.1": "“Na sasassa tilā atthi, ", "ja316:4.2": "Na muggā napi taṇḍulā; ", "ja316:4.3": "Iminā agginā pakkaṁ, ", "ja316:4.4": "Mamaṁ bhutvā vane vasā”ti. ", "ja316:5.1": "Sasapaṇḍitajātakaṁ chaṭṭhaṁ. "}, "variant_text": {"ja316:0.1": "", "ja316:0.2": "", "ja316:0.3": "", "ja316:0.4": "", "ja316:1.1": "", "ja316:1.2": "", "ja316:1.3": "", "ja316:1.4": "", "ja316:2.1": "", "ja316:2.2": "", "ja316:2.3": "", "ja316:2.4": "", "ja316:2.5": "", "ja316:2.6": "", "ja316:3.1": "Ambapakkaṁ dakaṁ → ambapakkodakaṁ (bj, pts-vp-pli1) ", "ja316:3.2": "Sītacchāyā manoramā → sītacchāyaṁ manoramaṁ (bj, sya1ed, sya2ed, pts-vp-pli1) ", "ja316:3.3": "", "ja316:3.4": "", "ja316:4.1": "", "ja316:4.2": "", "ja316:4.3": "", "ja316:4.4": "Mamaṁ → maṁsaṁ (mr) ", "ja316:5.1": "Sasapaṇḍitajātakaṁ → sasajātakaṁ (bj, pts-vp-pli1) "}, "reference_text": {"ja316:0.1": "", "ja316:0.2": "", "ja316:0.3": "", "ja316:0.4": "", "ja316:1.1": "csp1ed22.101, csp2ed22.101, ms22J_960, msdiv61, pts-vp-pli3.53", "ja316:1.2": "", "ja316:1.3": "", "ja316:1.4": "", "ja316:2.1": "dr27.139, ms22J_961, msdiv62, pts-vp-pli3.54, sya27.139", "ja316:2.2": "", "ja316:2.3": "", "ja316:2.4": "", "ja316:2.5": "", "ja316:2.6": "", "ja316:3.1": "bj30.176, ms22J_962, msdiv63", "ja316:3.2": "", "ja316:3.3": "", "ja316:3.4": "", "ja316:4.1": "ms22J_963, msdiv64, pts-vp-pli3.55", "ja316:4.2": "", "ja316:4.3": "", "ja316:4.4": "", "ja316:5.1": "ms22J_964"}, "keys_order": ["ja316:0.1", "ja316:0.2", "ja316:0.3", "ja316:0.4", "ja316:1.1", "ja316:1.2", "ja316:1.3", "ja316:1.4", "ja316:2.1", "ja316:2.2", "ja316:2.3", "ja316:2.4", "ja316:2.5", "ja316:2.6", "ja316:3.1", "ja316:3.2", "ja316:3.3", "ja316:3.4", "ja316:4.1", "ja316:4.2", "ja316:4.3", "ja316:4.4", "ja316:5.1"]}