{"html_text": {"ja296:0.1": "<article id='ja296'><header><ul><li class='division'>{}</li>", "ja296:0.2": "<li>{}</li>", "ja296:0.3": "<li>{}</li></ul>", "ja296:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja296:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja296:1.2": "<span class='verse-line'>{}</span>", "ja296:1.3": "<span class='verse-line'>{}</span>", "ja296:1.4": "<span class='verse-line'>{}</span></p>", "ja296:2.1": "<p><span class='verse-line'>{}</span>", "ja296:2.2": "<span class='verse-line'>{}</span>", "ja296:2.3": "<span class='verse-line'>{}</span>", "ja296:2.4": "<span class='verse-line'>{}</span></p>", "ja296:3.1": "<p><span class='verse-line'>{}</span>", "ja296:3.2": "<span class='verse-line'>{}</span>", "ja296:3.3": "<span class='verse-line'>{}</span>", "ja296:3.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja296:4.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja296:0.1": "Jātaka ", "ja296:0.2": "Tikanipāta ", "ja296:0.3": "Kumbhavagga ", "ja296:0.4": "6. Samuddajātaka ", "ja296:1.1": "“Ko nāyaṁ loṇatoyasmiṁ, ", "ja296:1.2": "samantā paridhāvati; ", "ja296:1.3": "Macche makare ca vāreti, ", "ja296:1.4": "ūmīsu ca vihaññati”. ", "ja296:2.1": "“Anantapāyī sakuṇo, ", "ja296:2.2": "atittoti disāsuto; ", "ja296:2.3": "Samuddaṁ pātumicchāmi, ", "ja296:2.4": "sāgaraṁ saritaṁ patiṁ”. ", "ja296:3.1": "“So ayaṁ hāyati ceva, ", "ja296:3.2": "pūrate ca mahodadhi; ", "ja296:3.3": "Nāssa nāyati pītanto, ", "ja296:3.4": "apeyyo kira sāgaro”ti. ", "ja296:4.1": "Samuddajātakaṁ chaṭṭhaṁ. "}, "variant_text": {"ja296:0.1": "", "ja296:0.2": "", "ja296:0.3": "", "ja296:0.4": "", "ja296:1.1": "nāyaṁ → ko nvāyaṁ (sya1ed, sya2ed) ", "ja296:1.2": "", "ja296:1.3": "", "ja296:1.4": "", "ja296:2.1": "", "ja296:2.2": "", "ja296:2.3": "", "ja296:2.4": "", "ja296:3.1": "", "ja296:3.2": "", "ja296:3.3": "", "ja296:3.4": "", "ja296:4.1": ""}, "reference_text": {"ja296:0.1": "", "ja296:0.2": "", "ja296:0.3": "", "ja296:0.4"