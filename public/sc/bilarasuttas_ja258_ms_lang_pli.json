{"html_text": {"ja258:0.1": "<article id='ja258'><header><ul><li class='division'>{}</li>", "ja258:0.2": "<li>{}</li>", "ja258:0.3": "<li>{}</li></ul>", "ja258:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja258:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja258:1.2": "<span class='verse-line'>{}</span>", "ja258:1.3": "<span class='verse-line'>{}</span>", "ja258:1.4": "<span class='verse-line'>{}</span></p>", "ja258:2.1": "<p><span class='verse-line'>{}</span>", "ja258:2.2": "<span class='verse-line'>{}</span>", "ja258:2.3": "<span class='verse-line'>{}</span>", "ja258:2.4": "<span class='verse-line'>{}</span></p>", "ja258:3.1": "<p><span class='verse-line'>{}</span>", "ja258:3.2": "<span class='verse-line'>{}</span>", "ja258:3.3": "<span class='verse-line'>{}</span>", "ja258:3.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja258:4.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja258:0.1": "Jātaka ", "ja258:0.2": "Tikanipāta ", "ja258:0.3": "Saṅkappavagga ", "ja258:0.4": "8. Mandhātujātaka ", "ja258:1.1": "“Yāvatā candimasūriyā, ", "ja258:1.2": "Pariharanti disā bhanti virocanā; ", "ja258:1.3": "Sabbeva dāsā mandhātu, ", "ja258:1.4": "Ye pāṇā pathavissitā. ", "ja258:2.1": "Na kahāpaṇavassena, ", "ja258:2.2": "titti kāmesu vijjati; ", "ja258:2.3": "Appassādā dukhā kāmā, ", "ja258:2.4": "iti viññāya paṇḍito. ", "ja258:3.1": "Api dibbesu kāmesu, ", "ja258:3.2": "ratiṁ so nādhigacchati; ", "ja258:3.3": "Taṇhakkhayarato hoti, ", "ja258:3.4": "sammāsambuddhasāvako”ti. ", "ja258:4.1": "Mandhātujātakaṁ aṭṭhamaṁ. "}, "variant_text": {"ja258:0.1": "", "ja258:0.2": "", "ja258:0.3": "", "ja258:0.4": "", "ja258:1.1": "", "ja258:1.2": "virocanā → virocamānā (pts-vp-pli1, mr) ", "ja258:1.3": "", "ja258:1.4": "pathavissitā → paṭhavinissitā (bj, pts-vp-pli1); paṭhavissitā (sya1ed, sya2ed) ", "ja258:2.1": "", "ja258:2.2": "", "ja258:2.3": "", "ja258:2.4": "", "ja258:3.1": "", "ja258:3.2": "", "ja258:3.3": "", "ja258:3.4": ""