: "<span class='verse-line'>{}</span>", "ja524:36.3": "<span class='verse-line'>{}</span>", "ja524:36.4": "<span class='verse-line'>{}</span></p>", "ja524:37.1": "<p><span class='verse-line'>{}</span>", "ja524:37.2": "<span class='verse-line'>{}</span>", "ja524:37.3": "<span class='verse-line'>{}</span>", "ja524:37.4": "<span class='verse-line'>{}</span></p>", "ja524:38.1": "<p><span class='verse-line'>{}</span>", "ja524:38.2": "<span class='verse-line'>{}</span>", "ja524:38.3": "<span class='verse-line'>{}</span>", "ja524:38.4": "<span class='verse-line'>{}</span></p>", "ja524:39.1": "<p><span class='verse-line'>{}</span>", "ja524:39.2": "<span class='verse-line'>{}</span>", "ja524:39.3": "<span class='verse-line'>{}</span>", "ja524:39.4": "<span class='verse-line'>{}</span></p>", "ja524:40.1": "<p><span class='verse-line'>{}</span>", "ja524:40.2": "<span class='verse-line'>{}</span>", "ja524:40.3": "<span class='verse-line'>{}</span>", "ja524:40.4": "<span class='verse-line'>{}</span></p>", "ja524:41.1": "<p><span class='verse-line'>{}</span>", "ja524:41.2": "<span class='verse-line'>{}</span>", "ja524:41.3": "<span class='verse-line'>{}</span>", "ja524:41.4": "<span class='verse-line'>{}</span></p>", "ja524:42.1": "<p><span class='verse-line'>{}</span>", "ja524:42.2": "<span class='verse-line'>{}</span>", "ja524:42.3": "<span class='verse-line'>{}</span>", "ja524:42.4": "<span class='verse-line'>{}</span></p>", "ja524:43.1": "<p><span class='verse-line'>{}</span>", "ja524:43.2": "<span class='verse-line'>{}</span>", "ja524:43.3": "<span class='verse-line'>{}</span>", "ja524:43.4": "<span class='verse-line'>{}</span></p>", "ja524:44.1": "<p><span class='verse-line'>{}</span>", "ja524:44.2": "<span class='verse-line'>{}</span>", "ja524:44.3": "<span class='verse-line'>{}</span>", "ja524:44.4": "<span class='verse-line'>{}</span></p>", "ja524:45.1": "<p><span class='verse-line'>{}</span>", "ja524:45.2": "<span class='verse-line'>{}</span>", "ja524:45.3": "<span class='verse-line'>{}</span>", "ja524:45.4": "<span class='verse-line'>{}</span></p>", "ja524:46.1": "<p><span class='verse-line'>{}</span>", "ja524:46.2": "<span class='verse-line'>{}</span>", "ja524:46.3": "<span class='verse-line'>{}</span>", "ja524:46.4": "<span class='verse-line'>{}</span></p>", "ja524:47.1": "<p><span class='verse-line'>{}</span>", "ja524:47.2": "<span class='verse-line'>{}</span>", "ja524:47.3": "<span class='verse-line'>{}</span>", "ja524:47.4": "<span class='verse-line'>{}</span></p>", "ja524:48.1": "<p><span class='verse-line'>{}</span>", "ja524:48.2": "<span class='verse-line'>{}</span>", "ja524:48.3": "<span class='verse-line'>{}</span>", "ja524:48.4": "<span class='verse-line'>{}</span></p>", "ja524:49.1": "<p><span class='verse-line'>{}</span>", "ja524:49.2": "<span class='verse-line'>{}</span>", "ja524:49.3": "<span class='verse-line'>{}</span>", "ja524:49.4": "<span class='verse-line'>{}</span></p>", "ja524:50.1": "<p><span class='verse-line'>{}</span>", "ja524:50.2": "<span class='verse-line'>{}</span>", "ja524:50.3": "<span class='verse-line'>{}</span>", "ja524:50.4": "<span class='verse-line'>{}</span></p>", "ja524:51.1": "<p><span class='verse-line'>{}</span>", "ja524:51.2": "<span class='verse-line'>{}</span>", "ja524:51.3": "<span class='verse-line'>{}</span>", "ja524:51.4": "<span class='verse-line'>{}</span></p>", "ja524:52.1": "<p><span class='verse-line'>{}</span>", "ja524:52.2": "<span class='verse-line'>{}</span>", "ja524:52.3": "<span class='verse-line'>{}</span>", "ja524:52.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja524:53.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja524:0.1": "Jātaka ", "ja524:0.2": "Cattālīsanipāta ", "ja524:0.3": "Tesakuṇavagga ", "ja524:0.4": "4. Saṅkhapālajātaka ", "ja524:1.1": "“Ariyāvakāsosi pasannanetto, ", "ja524:1.2": "Maññe bhavaṁ pabbajito kulamhā; ", "ja524:1.3": "Kathaṁ nu vittāni pahāya bhoge, ", "ja524:1.4": "Pabbaji nikkhamma gharā sapañña”. ", "ja524:2.1": "“Sayaṁ vimānaṁ naradeva disvā, ", "ja524:2.2": "Mahānubhāvassa mahoragassa; ", "ja524:2.3": "Disvāna puññāna mahāvipākaṁ, ", "ja524:2.4": "Saddhāyahaṁ pabbajitomhi rāja”. ", "ja524:3.1": "“Na kāmakāmā na bhayā na dosā, ", "ja524:3.2": "Vācaṁ musā pabbajitā bhaṇanti; ", "ja524:3.3": "Akkhāhi me pucchito etamatthaṁ, ", "ja524:3.4": "Sutvāna me jāyihitippasādo”. ", "ja524:4.1": "“Vāṇijja raṭṭhādhipa gacchamāno, ", "ja524:4.2": "Pathe addasāsimhi bhojaputte; ", "ja524:4.3": "Pavaddhakāyaṁ uragaṁ mahantaṁ, ", "ja524:4.4": "Ādāya gacchante pamodamāne. ", "ja524:5.1": "Sohaṁ samāgamma janinda tehi, ", "ja524:5.2": "Pahaṭṭhalomo avacamhi bhīto; ", "ja524:5.3": "‘Kuhiṁ ayaṁ nīyati bhīmakāyo, ", "ja524:5.4": "Nāgena kiṁ kāhatha bhojaputtā’. ", "ja524:6.1": "‘Nāgo ayaṁ nīyati bhojanatthā, ", "ja524:6.2": "Pavaddhakāyo urago mahanto; ", "ja524:6.3": "Sāduñca thūlañca muduñca maṁsaṁ, ", "ja524:6.4": "Na tvaṁ rasaññāsi videhaputta. ", "ja524:7.1": "Ito mayaṁ gantvā sakaṁ niketaṁ, ", "ja524:7.2": "Ādāya satthāni vikopayitvā; ", "ja524:7.3": "Maṁsāni bhokkhāma pamodamānā, ", "ja524:7.4": "Mayañhi ve sattavo pannagānaṁ’. ", "ja524:8.1": "‘Sace ayaṁ nīyati bhojanatthā, ", "ja524:8.2": "Pavaddhakāyo urago mahanto; ", "ja524:8.3": "Dadāmi vo balibaddāni soḷasa, ", "ja524:8.4": "Nāgaṁ imaṁ muñcatha bandhanasmā’. ", "ja524:9.1": "‘Addhā hi no bhakkho ayaṁ manāpo, ", "ja524:9.2": "Bahū ca no uragā bhuttapubbā; ", "ja524:9.3": "Karoma te taṁ vacanaṁ aḷāra, ", "ja524:9.4": "Mittañca no hohi videhaputta’. ", "ja524:10.1": "Tadāssu te bandhanā mocayiṁsu, ", "ja524:10.2": "Yaṁ natthuto paṭimokkassa pāse; ", "ja524:10.3": "Mutto ca so bandhanā nāgarājā, ", "ja524:10.4": "Pakkāmi pācīnamukho muhuttaṁ. ", "ja524:11.1": "Gantvāna pācīnamukho muhuttaṁ, ", "ja524:11.2": "Puṇṇehi nettehi palokayī maṁ; ", "ja524:11.3": "Tadāssahaṁ piṭṭhito anvagacchiṁ, ", "ja524:11.4": "Dasaṅguliṁ añjaliṁ paggahetvā. ", "ja524:12.1": "‘Gaccheva kho tvaṁ taramānarūpo, ", "ja524:12.2": "Mā taṁ amittā punaraggahesuṁ; ", "ja524:12.3": "Dukkho hi luddehi punā samāgamo, ", "ja524:12.4": "Adassanaṁ bhojaputtāna gaccha’. ", "ja524:13.1": "Agamāsi so rahadaṁ vippasannaṁ, ", "ja524:13.2": "Nīlobhāsaṁ ramaṇīyaṁ sutitthaṁ; ", "ja524:13.3": "Samotataṁ jambuhi vetasāhi, ", "ja524:13.4": "Pāvekkhi nittiṇṇabhayo patīto. ", "ja524:14.1": "So taṁ pavissa na cirassa nāgo, ", "ja524:14.2": "Dibbena me pāturahuṁ janinda; ", "ja524:14.3": "Upaṭṭhahī maṁ pitaraṁva putto, ", "ja524:14.4": "Hadayaṅgamaṁ kaṇṇasukhaṁ bhaṇanto. ", "ja524:15.1": "‘Tvaṁ mesi mātā ca pitā aḷāra, ", "ja524:15.2": "Abbhantaro pāṇadado sahāyo; ", "ja524:15.3": "Sakañca iddhiṁ paṭilābhakosmi, ", "ja524:15.4": "Aḷāra passa me nivesanāni; ", "ja524:15.5": "Pahūtabhakkhaṁ bahuannapānaṁ, ", "ja524:15.6": "Masakkasāraṁ viya vāsavassa. ", "ja524:16.1": "Taṁ bhūmibhāgehi upetarūpaṁ, ", "ja524:16.2": "Asakkharā ceva mudū subhā ca; ", "ja524:16.3": "Nīcattiṇā apparajā ca bhūmi, ", "ja524:16.4": "Pāsādikā yattha jahanti sokaṁ. ", "ja524:17.1": "Anāvakulā veḷuriyūpanīlā, ", "ja524:17.2": "Catuddisaṁ ambavanaṁ surammaṁ; ", "ja524:17.3": "Pakkā ca pesī ca phalā suphullā, ", "ja524:17.4": "Niccotukā dhārayantī phalāni’. ", "ja524:18.1": "Tesaṁ vanānaṁ naradeva majjhe, ", "ja524:18.2": "Nivesanaṁ bhassarasannikāsaṁ; ", "ja524:18.3": "Rajataggaḷaṁ sovaṇṇamayaṁ uḷāraṁ, ", "ja524:18.4": "Obhāsatī vijjurivantalikkhe. ", "ja524:19.1": "Maṇīmayā soṇṇamayā uḷārā, ", "ja524:19.2": "Anekacittā satataṁ sunimmitā; ", "ja524:19.3": "Paripūrā kaññāhi alaṅkatābhi, ", "ja524:19.4": "Suvaṇṇakāyūradharāhi rāja. ", "ja524:20.1": "So saṅkhapālo taramānarūpo, ", "ja524:20.2": "Pāsādamāruyha anomavaṇṇo; ", "ja524:20.3": "Sahassathambhaṁ atulānubhāvaṁ, ", "ja524:20.4": "Yatthassa bhariyā mahesī ahosi. ", "ja524:21.1": "Ekā ca nārī taramānarūpā, ", "ja524:21.2": "Ādāya veḷuriyamayaṁ mahagghaṁ; ", "ja524:21.3": "Subhaṁ maṇiṁ jātimantūpapannaṁ, ", "ja524:21.4": "Acoditā āsanamabbhihāsi. ", "ja524:22.1": "Tato maṁ urago hatthe gahetvā, ", "ja524:22.2": "Nisīdayī pāmukhaāsanasmiṁ; ", "ja524:22.3": "‘Idamāsanaṁ atra bhavaṁ nisīdatu, ", "ja524:22.4": "Bhavañhi me aññataro garūnaṁ’. ", "ja524:23.1": "Aññā ca nārī taramānarūpā, ", "ja524:23.2": "Ādāya vāriṁ upasaṅkamitvā; ", "ja524:23.3": "Pādāni pakkhālayī me janinda, ", "ja524:23.4": "Bhariyāva bhattū patino piyassa. ", "ja524:24.1": "Aparā ca nārī taramānarūpā, ", "ja524:24.2": "Paggayha sovaṇṇamayāya pātiyā; ", "ja524:24.3": "Anekasūpaṁ vividhaṁ viyañjanaṁ, ", "ja524:24.4": "Upanāmayī bhatta manuññarūpaṁ. ", "ja524:25.1": "Turiyehi maṁ bhārata bhuttavantaṁ, ", "ja524:25.2": "Upaṭṭhahuṁ bhattu mano viditvā; ", "ja524:25.3": "Tatuttariṁ maṁ nipatī mahantaṁ, ", "ja524:25.4": "Dibbehi kāmehi anappakehi. ", "ja524:26.1": "‘Bhariyā mametā tisatā aḷāra, ", "ja524:26.2": "Sabbattamajjhā padumuttarābhā; ", "ja524:26.3": "Aḷāra etāssu te kāmakārā, ", "ja524:26.4": "Dadāmi te tā paricārayassu’. ", "ja524:27.1": "Saṁvaccharaṁ dibbarasānubhutvā, ", "ja524:27.2": "Tadāssuhaṁ uttarimajjhabhāsiṁ; ", "ja524:27.3": "‘Nāgassidaṁ kinti kathañca laddhaṁ, ", "ja524:27.4": "Kathajjhagamāsi vimānaseṭṭhaṁ. ", "ja524:28.1": "Adhiccaladdhaṁ pariṇāmajaṁ te, ", "ja524:28.2": "Sayaṅkataṁ udāhu devehi dinnaṁ; ", "ja524:28.3": "Pucchāmi taṁ nāgarājetamatthaṁ, ", "ja524:28.4": "Kathajjhagamāsi vimānaseṭṭhaṁ’. ", "ja524:29.1": "‘Nādhiccaladdhaṁ na pariṇāmajaṁ me, ", "ja524:29.2": "Na sayaṅkataṁ nāpi devehi dinnaṁ; ", "ja524:29.3": "Sakehi kammehi apāpakehi, ", "ja524:29.4": "Puññehi me laddhamidaṁ vimānaṁ’. ", "ja524:30.1": "‘Kiṁ te vataṁ kiṁ pana brahmacariyaṁ, ", "ja524:30.2": "Kissa suciṇṇassa ayaṁ vipāko; ", "ja524:30.3": "Akkhāhi me nāgarājetamatthaṁ, ", "ja524:30.4": "Kathaṁ nu te laddhamidaṁ vimānaṁ’. ", "ja524:31.1": "‘Rājā ahosiṁ magadhānamissaro, ", "ja524:31.2": "Duyyodhano nāma mahānubhāvo; ", "ja524:31.3": "So ittaraṁ jīvitaṁ saṁviditvā, ", "ja524:31.4": "Asassataṁ vipariṇāmadhammaṁ. ", "ja524:32.1": "Annañca pānañca pasannacitto, ", "ja524:32.2": "Sakkacca dānaṁ vipulaṁ adāsiṁ; ", "ja524:32.3": "Opānabhūtaṁ me gharaṁ tadāsi, ", "ja524:32.4": "Santappitā samaṇabrāhmaṇā ca. ", "ja524:33.1": "Mālañca gandhañca vilepanañca, ", "ja524:33.2": "Padīpiyaṁ yānamupassayañca; ", "ja524:33.3": "Acchādanaṁ seyyamathannapānaṁ, ", "ja524:33.4": "Sakkacca dānāni adamha tattha. ", "ja524:34.1": "Taṁ me vataṁ taṁ pana brahmacariyaṁ, ", "ja524:34.2": "Tassa suciṇṇassa ayaṁ vipāko; ", "ja524:34.3": "Teneva me laddhamidaṁ vimānaṁ, ", "ja524:34.4": "Pahūtabhakkhaṁ bahuannapānaṁ; ", "ja524:34.5": "Naccehi gītehi cupetarūpaṁ, ", "ja524:34.6": "Ciraṭṭhitikaṁ na ca sassatāyaṁ’. ", "ja524:35.1": "‘Appānubhāvā taṁ mahānubhāvaṁ, ", "ja524:35.2": "Tejassinaṁ hanti atejavanto; ", "ja524:35.3": "Kimeva dāṭhāvudha kiṁ paṭicca, ", "ja524:35.4": "Hatthattamāgacchi vanibbakānaṁ. ", "ja524:36.1": "Bhayaṁ nu te anvagataṁ mahantaṁ, ", "ja524:36.2": "Tejo nu te nānvagaṁ dantamūlaṁ; ", "ja524:36.3": "Kimeva dāṭhāvudha kiṁ paṭicca, ", "ja524:36.4": "Kilesamāpajji vanibbakānaṁ’. ", "ja524:37.1": "‘Na me bhayaṁ anvagataṁ mahantaṁ, ", "ja524:37.2": "Tejo na sakkā mama tehi hantuṁ; ", "ja524:37.3": "Satañca dhammāni sukittitāni, ", "ja524:37.4": "Samuddavelāva duraccayāni. ", "ja524:38.1": "Cātuddasiṁ pañcadasiṁ aḷāra, ", "ja524:38.2": "Uposathaṁ niccamupāvasāmi; ", "ja524:38.3": "Athāgamuṁ soḷasa bhojaputtā, ", "ja524:38.4": "Rajjuṁ gahetvāna daḷhañca pāsaṁ. ", "ja524:39.1": "Bhetvāna nāsaṁ atikassa rajjuṁ, ", "ja524:39.2": "Nayiṁsu maṁ samparigayha luddā; ", "ja524:39.3": "Etādisaṁ dukkhamahaṁ titikkhaṁ, ", "ja524:39.4": "Uposathaṁ appaṭikopayanto’. ", "ja524:40.1": "‘Ekāyane taṁ pathe addasaṁsu, ", "ja524:40.2": "Balena vaṇṇena cupetarūpaṁ; ", "ja524:40.3": "Siriyā paññāya ca bhāvitosi, ", "ja524:40.4": "Kiṁ patthayaṁ nāga tapo karosi’. ", "ja524:41.1": "‘Na puttahetū na dhanassa hetu, ", "ja524:41.2": "Na āyuno cāpi aḷāra hetu; ", "ja524:41.3": "Manussayoniṁ abhipatthayāno, ", "ja524:41.4": "Tasmā parakkamma tapo karomi’. ", "ja524:42.1": "‘Tvaṁ lohitakkho vihatantaraṁso, ", "ja524:42.2": "Alaṅkato kappitakesamassu; ", "ja524:42.3": "Surosito lohitacandanena, ", "ja524:42.4": "Gandhabbarājāva disā pabhāsasi. ", "ja524:43.1": "Deviddhipattosi mahānubhāvo, ", "ja524:43.2": "Sabbehi kāmehi samaṅgibhūto; ", "ja524:43.3": "Pucchāmi taṁ nāgarājetamatthaṁ, ", "ja524:43.4": "Seyyo ito kena manussaloko’. ", "ja524:44.1": "‘Aḷāra nāññatra manussalokā, ", "ja524:44.2": "Suddhī va saṁvijjati saṁyamo vā; ", "ja524:44.3": "Ahañca laddhāna manussayoniṁ, ", "ja524:44.4": "Kāhāmi jātimaraṇassa antaṁ’. ", "ja524:45.1": "‘Saṁvaccharo me vasato tavantike, ", "ja524:45.2": "Annena pānena upaṭṭhitosmi; ", "ja524:45.3": "Āmantayitvāna palemi nāga, ", "ja524:45.4": "Cirappavutthosmi ahaṁ janinda’. ", "ja524:46.1": "‘Puttā ca dārā anujīvino ca, ", "ja524:46.2": "Niccānusiṭṭhā upatiṭṭhathetaṁ; ", "ja524:46.3": "Kaccinnu taṁ nābhisapittha koci, ", "ja524:46.4": "Piyañhi me dassanaṁ tuyhaṁ aḷāra’. ", "ja524:47.1": "‘Yathāpi mātū ca pitū agāre, ", "ja524:47.2": "Putto piyo paṭivihito vaseyya; ", "ja524:47.3": "Tatopi mayhaṁ idhameva seyyo, ", "ja524:47.4": "Cittañhi te nāga mayī pasannaṁ’. ", "ja524:48.1": "‘Maṇī mamaṁ vijjati lohitaṅko, ", "ja524:48.2": "Dhanāharo maṇiratanaṁ uḷāraṁ; ", "ja524:48.3": "Ādāya tvaṁ gaccha sakaṁ niketaṁ, ", "ja524:48.4": "Laddhā dhanaṁ taṁ maṇimossajassu’. ", "ja524:49.1": "Diṭṭhā mayā mānusakāpi kāmā, ", "ja524:49.2": "Asassatā vipariṇāmadhammā; ", "ja524:49.3": "Ādīnavaṁ kāmaguṇesu disvā, ", "ja524:49.4": "Saddhāyahaṁ pabbajitomhi rāja. ", "ja524:50.1": "Dumapphalānīva patanti māṇavā, ", "ja524:50.2": "Daharā ca vuddhā ca sarīrabhedā; ", "ja524:50.3": "Etampi disvā pabbajitomhi rāja, ", "ja524:50.4": "Apaṇṇakaṁ sāmaññameva seyyo”. ", "ja524:51.1": "“Addhā have sevitabbā sapaññā, ", "ja524:51.2": "Bahussutā ye bahuṭhānacintino; ", "ja524:51.3": "Nāgañca sutvāna tavañcaḷāra, ", "ja524:51.4": "Kāhāmi puññāni anappakāni”. ", "ja524:52.1": "“Addhā have sevitabbā sapaññā, ", "ja524:52.2": "Bahussutā ye bahuṭhānacintino; ", "ja524:52.3": "Nāgañca sutvāna mamañca rāja, ", "ja524:52.4": "Karohi puññāni anappakānī”ti. ", "ja524:53.1": "Saṅkhapālajātakaṁ catutthaṁ. "}, "variant_text": {"ja524:0.1": "", "ja524:0.2": "", "ja524:0.3": "", "ja524:0.4": "", "ja524:1.1": "", "ja524:1.2": "", "ja524:1.3": "", "ja524:1.4": "sapañña → sapañño (sya1ed, sya2ed); sapaññā (pts-vp-pli1) ", "ja524:2.1": "", "ja524:2.2": "", "ja524:2.3": "", "ja524:2.4": "", "ja524:3.1": "", "ja524:3.2": "", "ja524:3.3": "", "ja524:3.4": "", "ja524:4.1": "Vāṇijja → vaṇijja (pts-vp-pli1) ", "ja524:4.2": "bhojaputte → milācaputte (bj, pts-vp-pli1) ", "ja524:4.3": "taṁ → te (pts-vp-pli1) ", "ja524:4.4": "", "ja524:5.1": "", "ja524:5.2": "", "ja524:5.3": "nīyati → niyyati (mr) ", "ja524:5.4": "", "ja524:6.1": "bhojanatthā → bhojanatthaṁ (bj, sya1ed, sya2ed, pts-vp-pli1) ", "ja524:6.2": "", "ja524:6.3": "", "ja524:6.4": "tvaṁ → taṁ (bj, pts-vp-pli1) ", "ja524:7.1": "niketaṁ → niketanaṁ (pts-vp-pli1) ", "ja524:7.2": "", "ja524:7.3": "bhokkhāma → bhakkhāma (sya1ed, sya2ed) ", "ja524:7.4": "", "ja524:8.1": "", "ja524:8.2": "", "ja524:8.3": "balibaddāni → balivaddāni (bj, pts-vp-pli1); balibaddhāni (sya1ed, sya2ed) ", "ja524:8.4": "", "ja524:9.1": "", "ja524:9.2": "Bahū ca no uragā bhuttapubbā → … oragā … (sya1ed, sya2ed); bahuṁ ca no urago bhuttapubbo (mr) ", "ja524:9.3": "aḷāra → āḷāra (mr) ", "ja524:9.4": "", "ja524:10.1": "", "ja524:10.2": "", "ja524:10.3": "", "ja524:10.4": "", "ja524:11.1": "", "ja524:11.2": "", "ja524:11.3": "", "ja524:11.4": "", "ja524:12.1": "", "ja524:12.2": "", "ja524:12.3": "", "ja524:12.4": "", "ja524:13.1": "", "ja524:13.2": "", "ja524:13.3": "Samotataṁ → samonataṁ (sya1ed, sya2ed, mr) ", "ja524:13.4": "", "ja524:14.1": "", "ja524:14.2": "", "ja524:14.3": "", "ja524:14.4": "", "ja524:15.1": "pitā → pitā ca (pts-vp-pli1) ", "ja524:15.2": "", "ja524:15.3": "paṭilābhakosmi → paṭilābhitosmi (bj, pts-vp-pli1) ", "ja524:15.4": "", "ja524:15.5": "", "ja524:15.6": "", "ja524:16.1": "", "ja524:16.2": "", "ja524:16.3": "Nīcattiṇā → nīcatiṇā (bj); n