{"html_text": {"ja524:0.1": "<article id='ja524'><header><ul><li class='division'>{}</li>", "ja524:0.2": "<li>{}</li>", "ja524:0.3": "<li>{}</li></ul>", "ja524:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja524:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja524:1.2": "<span class='verse-line'>{}</span>", "ja524:1.3": "<span class='verse-line'>{}</span>", "ja524:1.4": "<span class='verse-line'>{}</span></p>", "ja524:2.1": "<p><span class='verse-line'>{}</span>", "ja524:2.2": "<span class='verse-line'>{}</span>", "ja524:2.3": "<span class='verse-line'>{}</span>", "ja524:2.4": "<span class='verse-line'>{}</span></p>", "ja524:3.1": "<p><span class='verse-line'>{}</span>", "ja524:3.2": "<span class='verse-line'>{}</span>", "ja524:3.3": "<span class='verse-line'>{}</span>", "ja524:3.4": "<span class='verse-line'>{}</span></p>", "ja524:4.1": "<p><span class='verse-line'>{}</span>", "ja524:4.2": "<span class='verse-line'>{}</span>", "ja524:4.3": "<span class='verse-line'>{}</span>", "ja524:4.4": "<span class='verse-line'>{}</span></p>", "ja524:5.1": "<p><span class='verse-line'>{}</span>", "ja524:5.2": "<span class='verse-line'>{}</span>", "ja524:5.3": "<span class='verse-line'>{}</span>", "ja524:5.4": "<span class='verse-line'>{}</span></p>", "ja524:6.1": "<p><span class='verse-line'>{}</span>", "ja524:6.2": "<span class='verse-line'>{}</span>", "ja524:6.3": "<span class='verse-line'>{}</span>", "ja524:6.4": "<span class='verse-line'>{}</span></p>", "ja524:7.1": "<p><span class='verse-line'>{}</span>", "ja524:7.2": "<span class='verse-line'>{}</span>", "ja524:7.3": "<span class='verse-line'>{}</span>", "ja524:7.4": "<span class='verse-line'>{}</span></p>", "ja524:8.1": "<p><span class='verse-line'>{}</span>", "ja524:8.2": "<span class='verse-line'>{}</span>", "ja524:8.3": "<span class='verse-line'>{}</span>", "ja524:8.4": "<span class='verse-line'>{}</span></p>", "ja524:9.1": "<p><span class='verse-line'>{}</span>", "ja524:9.2": "<span cl