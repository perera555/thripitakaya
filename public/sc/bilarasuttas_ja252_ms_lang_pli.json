{"html_text": {"ja252:0.1": "<article id='ja252'><header><ul><li class='division'>{}</li>", "ja252:0.2": "<li>{}</li>", "ja252:0.3": "<li>{}</li></ul>", "ja252:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja252:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja252:1.2": "<span class='verse-line'>{}</span>", "ja252:1.3": "<span class='verse-line'>{}</span>", "ja252:1.4": "<span class='verse-line'>{}</span></p>", "ja252:2.1": "<p><span class='verse-line'>{}</span>", "ja252:2.2": "<span class='verse-line'>{}</span>", "ja252:2.3": "<span class='verse-line'>{}</span>", "ja252:2.4": "<span class='verse-line'>{}</span></p>", "ja252:3.1": "<p><span class='verse-line'>{}</span>", "ja252:3.2": "<span class='verse-line'>{}</span>", "ja252:3.3": "<span class='verse-line'>{}</span>", "ja252:3.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja252:4.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja252:0.1": "Jātaka ", "ja252:0.2": "Tikanipāta ", "ja252:0.3": "Saṅkappavagga ", "ja252:0.4": "2. Tilamuṭṭhijātaka ", "ja252:1.1": "“Ajjāpi me taṁ manasi, ", "ja252:1.2": "yaṁ maṁ tvaṁ tilamuṭṭhiyā; ", "ja252:1.3": "Bāhāya maṁ gahetvāna, ", "ja252:1.4": "laṭṭhiyā anutāḷayi. ", "ja252:2.1": "Nanu jīvite na ramasi, ", "ja252:2.2": "yenāsi brāhmaṇāgato; ", "ja252:2.3": "Yaṁ maṁ bāhā gahetvāna, ", "ja252:2.4": "tikkhattuṁ anutāḷayi”. ", "ja252:3.1": "“Ariyo anariyaṁ kubbantaṁ, ", "ja252:3.2": "Yo daṇḍena nisedhati; ", "ja252:3.3": "Sāsanaṁ taṁ na taṁ veraṁ, ", "ja252:3.4": "Iti naṁ paṇḍitā vidū”ti. ", "ja252:4.1": "Tilamuṭṭhijātakaṁ dutiyaṁ. "}, "variant_text": {"ja252:0.1": "", "ja252:0.2": "", "ja252:0.3": "", "ja252:0.4": "", "ja252:1.1": "manasi → sarasi (mr) ", "ja252:1.2": "", "ja252:1.3": "", "ja252:1.4": "", "ja252:2.1": "", "ja252:2.2": "", "ja252:2.3": "", "ja252:2.4": "", "ja252:3.1": "kubbantaṁ → kubbānaṁ (bj, pts-vp-pli1); kubbaṁ (sya1ed, sya2ed) ", "ja252:3.2": "", "ja252:3.3": "", "ja252:3.4": "", "ja252:4.1": ""}, "reference_text": {"ja252:0.1": "", "ja252:0.2": "", "ja252:0.3": "", "ja252:0.4": "", "ja252:1.1": "ms22J_674, msdiv4, pts-vp-pli2.280", "ja252:1.2": "", "ja252:1.3": "", "ja252:1.4": "", "ja252:2.1": "ms22J_675, msdiv5", "ja252:2.2": "", "ja252:2.3": "", "ja252:2.4": "", "ja252:3.1": "ms22J_676, msdiv6", "ja252:3.2": "", "ja252:3.3": "", "ja252:3.4": "", "ja252:4.1": "ms22J_677"}, "keys_order": ["ja252:0.1", "ja252:0.2", "ja252:0.3", "ja252:0.4", "ja252:1.1", "ja252:1.2", "ja252:1.3", "ja252:1.4", "ja252:2.1", "ja252:2.2", "ja252:2.3", "ja252:2.4", "ja252:3.1", "ja252:3.2", "ja252:3.3", "ja252:3.4", "ja252:4.1"]}