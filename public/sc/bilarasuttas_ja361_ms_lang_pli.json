{"html_text": {"ja361:0.1": "<article id='ja361'><header><ul><li class='division'>{}</li>", "ja361:0.2": "<li>{}</li>", "ja361:0.3": "<li>{}</li></ul>", "ja361:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja361:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja361:1.2": "<span class='verse-line'>{}</span>", "ja361:1.3": "<span class='verse-line'>{}</span>", "ja361:1.4": "<span class='verse-line'>{}</span></p>", "ja361:2.1": "<p><span class='verse-line'>{}</span>", "ja361:2.2": "<span class='verse-line'>{}</span>", "ja361:2.3": "<span class='verse-line'>{}</span>", "ja361:2.4": "<span class='verse-line'>{}</span></p>", "ja361:3.1": "<p><span class='verse-line'>{}</span>", "ja361:3.2": "<span class='verse-line'>{}</span>", "ja361:3.3": "<span class='verse-line'>{}</span>", "ja361:3.4": "<span class='verse-line'>{}</span></p>", "ja361:4.1": "<p><span class='verse-line'>{}</span>", "ja361:4.2": "<span class='verse-line'>{}</span>", "ja361:4.3": "<span class='verse-line'>{}</span>", "ja361:4.4": "<span class='verse-line'>{}</span></p>", "ja361:5.1": "<p><span class='verse-line'>{}</span>", "ja361:5.2": "<span class='verse-line'>{}</span>", "ja361:5.3": "<span class='verse-line'>{}</span>", "ja361:5.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja361:6.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja361:0.1": "Jātaka ", "ja361:0.2": "Pañcakanipāta ", "ja361:0.3": "Vaṇṇārohavagga ", "ja361:0.4": "1. Vaṇṇārohajātaka ", "ja361:1.1": "“Vaṇṇārohena jātiyā, ", "ja361:1.2": "balanikkamanena ca; ", "ja361:1.3": "Subāhu na mayā seyyo, ", "ja361:1.4": "sudāṭha iti bhāsasi”. ", "ja361:2.1": "“Vaṇṇārohena jātiyā, ", "ja361:2.2": "balanikkamanena ca; ", "ja361:2.3": "Sudāṭho na mayā seyyo, ", "ja361:2.4": "subāhu iti bhāsasi. ", "ja361:3.1": "Evañce maṁ viharantaṁ, ", "ja361:3.2": "subāhu samma dubbhasi; ", "ja361:3.3": "Na dānāhaṁ tayā saddhiṁ, ", "ja361:3.4": "saṁvāsamabhirocaye. ", "ja361:4.1": "Yo paresaṁ vacanāni, ", "ja361:4.2": "saddaheyya yathātathaṁ; ", "ja361:4.3": "Khippaṁ bhijjetha mittasmiṁ, ", "ja361:4.4": "verañca pasave bahuṁ. ", "ja361:5.1": "Na so mitto yo sadā appamatto, ", "ja361:5.2": "Bhedāsaṅkī randhamevānupassī; ", "ja361:5.3": "Yasmiñca setī urasīva putto, ", "ja361:5.4": "Sa ve mitto yo abhejjo parehī”ti. ", "ja361:6.1": "Vaṇṇārohajātakaṁ paṭhamaṁ. "}, "variant_text": {"ja361:0.1": "", "ja361:0.2": "", "ja361:0.3": "", "ja361:0.4": "", "ja361:1.1": "", "ja361:1.2": "", "ja361:1.3": "", "ja361:1.4": "", "ja361:2.1": "", "ja361:2.2": "", "ja361:2.3": "", "ja361:2.4": "", "ja361:3.1": "", "ja361:3.2": "", "ja361:3.3": "", "ja361:3.4": "", "ja361:4.1": "", "ja361:4.2": "saddaheyya → saddahetha (bj, sya1ed, sya2ed, pts-vp-pli1) ", "ja361:4.3": "", "ja361:4.4": "", "ja361:5.1": "", "ja361:5.2": "", "ja361:5.3": "", "ja361:5.4": "", "ja361:6.1": ""}, "reference_text": {"ja361:0.1": "", "ja361:0.2": "", "ja361:0.3": "", "ja361:0.4": "", "ja361:1.1": "bj30.218, dr27.174, ms22J_1217, msdiv60, pts-vp-pli3.192", "ja361:1.2": "", "ja361:1.3": "", "ja361:1.4": "", "ja361:2.1": "ms22J_1218, msdiv61", "ja361:2.2": "", "ja361:2.3": "", "ja361:2.4": "", "ja361:3.1": "ms22J_1219, msdiv62", "ja361:3.2": "", "ja361:3.3": "", "ja361:3.4": "", "ja361:4.1": "ms22J_1220, msdiv63, vri68.108", "ja361:4.2": "", "ja361:4.3": "", "ja361:4.4": "", "ja361:5.1": "csp1ed22.128, csp2ed22.128, ms22J_1221, msdiv64, ndp22.119, pts-vp-pli3.193", "ja361:5.2": "", "ja361:5.3": "", "ja361:5.4": "", "ja361:6.1": "ms22J_1222"}, "keys_order": ["ja361:0.1", "ja361:0.2", "ja361:0.3", "ja361:0.4", "ja361:1.1", "ja361:1.2", "ja361:1.3", "ja361:1.4", "ja361:2.1", "ja361:2.2", "ja361:2.3", "ja361:2.4", "ja361:3.1", "ja361:3.2", "ja361:3.3", "ja361:3.4", "ja361:4.1", "ja361:4.2", "ja361:4.3", "ja361:4.4", "ja361:5.1", "ja361:5.2", "ja361:5.3", "ja361:5.4", "ja361:6.1"]}