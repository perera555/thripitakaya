{"html_text": {"ja418:0.1": "<article id='ja418'><header><ul><li class='division'>{}</li>", "ja418:0.2": "<li>{}</li>", "ja418:0.3": "<li>{}</li></ul>", "ja418:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja418:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja418:1.2": "<span class='verse-line'>{}</span>", "ja418:1.3": "<span class='verse-line'>{}</span>", "ja418:1.4": "<span class='verse-line'>{}</span>", "ja418:1.5": "<span class='verse-line'>{}</span>", "ja418:1.6": "<span class='verse-line'>{}</span></p>", "ja418:2.1": "<p><span class='verse-line'>{}</span>", "ja418:2.2": "<span class='verse-line'>{}</span>", "ja418:2.3": "<span class='verse-line'>{}</span>", "ja418:2.4": "<span class='verse-line'>{}</span></p>", "ja418:3.1": "<p><span class='verse-line'>{}</span>", "ja418:3.2": "<span class='verse-line'>{}</span>", "ja418:3.3": "<span class='verse-line'>{}</span>", "ja418:3.4": "<span class='verse-line'>{}</span></p>", "ja418:4.1": "<p><span class='verse-line'>{}</span>", "ja418:4.2": "<span class='verse-line'>{}</span>", "ja418:4.3": "<span class='verse-line'>{}</span>", "ja418:4.4": "<span class='verse-line'>{}</span></p>", "ja418:5.1": "<p><span class='verse-line'>{}</span>", "ja418:5.2": "<span class='verse-line'>{}</span>", "ja418:5.3": "<span class='verse-line'>{}</span>", "ja418:5.4": "<span class='verse-line'>{}</span></p>", "ja418:6.1": "<p><span class='verse-line'>{}</span>", "ja418:6.2": "<span class='verse-line'>{}</span>", "ja418:6.3": "<span class='verse-line'>{}</span>", "ja418:6.4": "<span class='verse-line'>{}</span></p>", "ja418:7.1": "<p><span class='verse-line'>{}</span>", "ja418:7.2": "<span class='verse-line'>{}</span>", "ja418:7.3": "<span class='verse-line'>{}</span>", "ja418:7.4": "<span class='verse-line'>{}</span></p>", "ja418:8.1": "<p><span class='verse-line'>{}</span>", "ja418:8.2": "<span class='verse-line'>{}</span>", "ja418:8.3": "<span class='verse-line'>{}</span>", "ja418:8.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja418:9.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja418:0.1": "Jātaka ", "ja418:0.2": "Aṭṭhakanipāta ", "ja418:0.3": "Kaccānivagga ", "ja418:0.4": "2. Aṭṭhasaddajātaka ", "ja418:1.1": "“Idaṁ pure ninnamāhu, ", "ja418:1.2": "bahumacchaṁ mahodakaṁ; ", "ja418:1.3": "Āvāso bakarājassa, ", "ja418:1.4": "pettikaṁ bhavanaṁ mama; ", "ja418:1.5": "Tyajja bhekena yāpema, ", "ja418:1.6": "okaṁ na vijahāmase”. ", "ja418:2.1": "“Ko dutiyaṁ asīlissa, ", "ja418:2.2": "bandharassakkhi bhecchati; ", "ja418:2.3": "Ko me putte kulāvakaṁ, ", "ja418:2.4": "mañca sotthiṁ karissati”. ", "ja418:3.1": "“Sabbā parikkhayā pheggu, ", "ja418:3.2": "yāva tassā gatī ahu; ", "ja418:3.3": "Khīṇabhakkho mahārāja, ", "ja418:3.4": "sāre na ramatī ghuṇo”. ", "ja418:4.1": "“Sā nūnāhaṁ ito gantvā, ", "ja418:4.2": "rañño muttā nivesanā; ", "ja418:4.3": "Attānaṁ ramayissāmi, ", "ja418:4.4": "dumasākhaniketinī”. ", "ja418:5.1": "“So nūnāhaṁ ito gantvā, ", "ja418:5.2": "rañño mutto nivesanā; ", "ja418:5.3": "Aggodakāni pissāmi, ", "ja418:5.4": "yūthassa purato vajaṁ”. ", "ja418:6.1": "“Taṁ maṁ kāmehi sammattaṁ, ", "ja418:6.2": "rattaṁ kāmesu mucchitaṁ; ", "ja418:6.3": "Ānayī bharato luddo, ", "ja418:6.4": "bāhiko bhaddamatthu te”. ", "ja418:7.1": "“Andhakāratimisāyaṁ, ", "ja418:7.2": "tuṅge uparipabbate; ", "ja418:7.3": "Sā maṁ saṇhena mudunā, ", "ja418:7.4": "mā pādaṁ khali yasmani”. ", "ja418:8.1": "“Asaṁsayaṁ jātikhayantadassī, ", "ja418:8.2": "Na gabbhaseyyaṁ punarāvajissaṁ; ", "ja418:8.3": "Ayamantimā pacchimā gabbhaseyyā, ", "ja418:8.4": "Khīṇo me saṁsāro punabbhavāyā”ti. ", "ja418:9.1": "Aṭṭhasaddajātakaṁ dutiyaṁ. "}, "variant_text": {"ja418:0.1": "", "ja418:0.2": "", "ja418:0.3": "", "ja418:0.4": "", "ja418:1.1": "", "ja418:1.2": "", "ja418:1.3": "", "ja418:1.4": "", "ja418:1.5": "bhekena → bhiṅgena (sya2ed, mr) ", "ja418:1.6": "okaṁ na vijahāmase → okaṁ na vijjahāmase (sya1ed, sya2ed); okantaṁ na jahāmase (mr) ", "ja418:2.1": "", "ja418:2.2": "bhecchati → bhejjati (bj, sya1ed, sya2ed, pts-vp-pli1); bhindati (mr) ", "ja418:2.3": "", "ja418:2.4": "", "ja418:3.1": "", "ja418:3.2": "", "ja418:3.3": "", "ja418:3.4": "", "ja418:4.1": "", "ja418:4.2": "", "ja418:4.3": "", "ja418:4.4": "", "ja418:5.1": "", "ja418:5.2": "", "ja418:5.3": "", "ja418:5.4": "", "ja418:6.1": "", "ja418:6.2": "", "ja418:6.3": "bharato → vanato (mr) ", "ja418:6.4": "", "ja418:7.1": "", "ja418:7.2": "", "ja418:7.3": "", "ja418:7.4": "khali → khaṇi (bj, sya1ed, sya2ed, pts-vp-pli1) ", "ja418:8.1": "", "ja418:8.2": "", "ja418:8.3": "Ayamantimā pacchimā gabbhaseyyā → ayaṁ hi me antimā gabbhaseyyā (bj, pts-vp-pli1); ayamantimā pacchimagabbhaseyyā (sya1ed, sya2ed) ", "ja418:8.4": "", "ja418:9.1": ""}, "reference_text": {"ja418:0.1": "", "ja418:0.2": "", "ja418:0.3": "", "ja418:0.4": "", "ja418:1.1": "dr27.239, ms22J_1683, msdiv10, pts-vp-pli3.430, vri68.145", "ja418:1.2": "", "ja418:1.3": "", "ja418:1.4": "", "ja418:1.5": "", "ja418:1.6": "", "ja418:2.1": "ms22J_1684, msdiv11", "ja418:2.2": "", "ja418:2.3": "", "ja418:2.4": "", "ja418:3.1": "ms22J_1685, msdiv12, ndp22.169, pts-vp-pli3.431", "ja418:3.2": "", "ja418:3.3": "", "ja418:3.4": "", "ja418:4.1": "csp1ed22.177, csp2ed22.177, ms22J_1686, msdiv13, pts-vp-pli3.432", "ja418:4.2": "", "ja418:4.3": "", "ja418:4.4": "", "ja418:5.1": "ms22J_1687, msdiv14", "ja418:5.2": "", "ja418:5.3": "", "ja418:5.4": "", "ja418:6.1": "ms22J_1688, msdiv15", "ja418:6.2": "", "ja418:6.3": "", "ja418:6.4": "", "ja418:7.1": "ms22J_1689, msdiv16, pts-vp-pli3.433, sya27.241", "ja418:7.2": "", "ja418:7.3": "", "ja418:7.4": "", "ja418:8.1": "dr27.240, ms22J_1690, msdiv17, pts-vp-pli3.434", "ja418:8.2": "", "ja418:8.3": "", "ja418:8.4": "", "ja418:9.1": "ms22J_1691"}, "keys_order": ["ja418:0.1", "ja418:0.2", "ja418:0.3", "ja418:0.4", "ja418:1.1", "ja418:1.2", "ja418:1.3", "ja418:1.4", "ja418:1.5", "ja418:1.6", "ja418:2.1", "ja418:2.2", "ja418:2.3", "ja418:2.4", "ja418:3.1", "ja418:3.2", "ja418:3.3", "ja418:3.4", "ja4