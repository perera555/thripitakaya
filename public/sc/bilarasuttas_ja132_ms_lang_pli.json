{"html_text": {"ja132:0.1": "<article id='ja132'><header><ul><li class='division'>{}</li>", "ja132:0.2": "<li>{}</li>", "ja132:0.3": "<li>{}</li></ul>", "ja132:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja132:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja132:1.2": "<span class='verse-line'>{}</span>", "ja132:1.3": "<span class='verse-line'>{}</span>", "ja132:1.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja132:2.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja132:0.1": "Jātaka ", "ja132:0.2": "Ekakanipāta ", "ja132:0.3": "Asampadānavagga ", "ja132:0.4": "2. Bhīrukajātaka ", "ja132:1.1": "“Kusalūpadese dhitiyā daḷhāya ca, ", "ja132:1.2": "Anivattitattābhayabhīrutāya ca; ", "ja132:1.3": "Na rakkhasīnaṁ vasamāgamimhase, ", "ja132:1.4": "Sa sotthibhāvo mahatā bhayena me”ti. ", "ja132:2.1": "Bhīrukajātakaṁ dutiyaṁ. "}, "variant_text": {"ja132:0.1": "", "ja132:0.2": "", "ja132:0.3": "", "ja132:0.4": "", "ja132:1.1": "", "ja132:1.2": "Anivattitattābhayabhīrutāya → avatthitattābhayabhīrutāya (bj, sya1ed, sya2ed, pts-vp-pli1) ", "ja132:1.3": "", "ja132:1.4": "", "ja132:2.1": "Bhīrukajātakaṁ → pañcagarukajātakaṁ (bj); pañcabhīrukajātakaṁ (sya1ed, sya2ed); pañcagurujātakaṁ (pts-vp-pli1); abhayabhīruta (?) "}, "reference_text": {"ja132:0.1": "", "ja132:0.2": "", "ja132:0.3": "", "ja132:0.4": "", "ja132:1.1": "csp1ed22.31, csp2ed22.31, ms22J_293, msdiv132, pts-vp-pli1.470, sya27.43", "ja132:1.2": "", "ja132:1.3": "", "ja132:1.4": "", "ja132:2.1": "ms22J_294"}, "keys_order": ["ja132:0.1", "ja132:0.2", "ja132:0.3", "ja132:0.4", "ja132:1.1", "ja132:1.2", "ja132:1.3", "ja132:1.4", "ja132:2.1"]}