[{"acronym": "Ja 454", "alt_acronym": null, "volpages": "PTS 4.84, PTS 4.85, PTS 4.86, PTS 4.87", "alt_volpages": null, "uid": "ja454", "blurb": "“Black Kanha, rise”—This story the Master told in Jetavana about a son’s death. The circumstances are like those in the Mattha-Kundali Birth. Here again the Master asked the lay brother, “Are you in grief, layman?” He replied, “Yes, Sir.” “Layman,” said the Master, “long ago wise men listened to the bidding of the wise, and did not grieve for the death of a son.” And at his request, he told a story of the past.", "difficulty": null, "original_title": "Ghaṭapaṇḍitajātaka", "root_lang": "pli", "root_lang_name": "Pāli", "type": "leaf", "translated_title": "Ghata Jātaka", "translations": [{"lang": "pli", "lang_name": "Pāli", "is_root": true, "author": "Mahāsaṅgīti Tipiṭaka Buddhavasse 2500", "author_short": "ms", "author_uid": "ms", "publication_date": null, "id": "ja454_root-pli-ms", "segmented": true, "title": null, "volpage": null, "has_comment": false}, {"lang": "de", "lang_name": "Deutsch", "is_root": false, "author": "Dr. Julius Dutoit", "author_short": "Dutoit", "author_uid": "dutoit", "publication_date": "2007", "id": "de_ja454_dutoit", "segmented": false, "volpage": null, "has_comment": false}, {"author": "W.H.D. Rouse", "author_short": "Rouse", "author_uid": "rouse", "has_comment": false, "id": "en_ja454_rouse", "is_root": false, "lang": "en", "lang_name": "English", "publication_date": "1901", "segmented": false, "volpage": null, "title": "Ghata Jātaka"}, {"lang": "jpn", "lang_name": "日本語", "is_root": false, "author": "関西パーリ語実習会", "author_short": "関西パーリ語実習会", "author_uid": "kansai", "publication_date": "2023", "id": "jpn_ja454_kansai", "segmented": false, "volpage": null, "has_comment": false}, {"lang": "si", "lang_name": "සිංහල", "is_root": false, "author": "A.P. de Zoysa", "author_short": "Zoysa", "author_uid": "zoysa", "publication_date": null, "id": "si_ja454_zoysa", "segmented": false, "volpage": null, "has_com