{"html_text": {"ja176:0.1": "<article id='ja176'><header><ul><li class='division'>{}</li>", "ja176:0.2": "<li>{}</li>", "ja176:0.3": "<li>{}</li></ul>", "ja176:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja176:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja176:1.2": "<span class='verse-line'>{}</span>", "ja176:1.3": "<span class='verse-line'>{}</span>", "ja176:1.4": "<span class='verse-line'>{}</span></p>", "ja176:2.1": "<p><span class='verse-line'>{}</span>", "ja176:2.2": "<span class='verse-line'>{}</span>", "ja176:2.3": "<span class='verse-line'>{}</span>", "ja176:2.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja176:3.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja176:0.1": "Jātaka ", "ja176:0.2": "Dukanipāta ", "ja176:0.3": "Kalyāṇavagga ", "ja176:0.4": "6. Kaḷāyamuṭṭhijātaka ", "ja176:1.1": "“Bālo vatāyaṁ dumasākhagocaro, ", "ja176:1.2": "Paññā janinda nayimassa vijjati; ", "ja176:1.3": "Kaḷāyamuṭṭhiṁ avakiriya kevalaṁ, ", "ja176:1.4": "Ekaṁ kaḷāyaṁ patitaṁ gavesati”. ", "ja176:2.1": "“Evameva mayaṁ rāja, ", "ja176:2.2": "ye caññe atilobhino; ", "ja176:2.3": "Appena bahuṁ jiyyāma, ", "ja176:2.4": "kaḷāyeneva vānaro”ti. ", "ja176:3.1": "Kaḷāyamuṭṭhijātakaṁ chaṭṭhaṁ. "}, "reference_text": {"ja176:0.1": "", "ja176:0.2": "", "ja176:0.3": "", "ja176:0.4": "", "ja176:1.1": "csp1ed22.45, csp2ed22.45, ms22J_421, msdiv51, pts-vp-pli2.75", "ja176:1.2": "", "ja176:1.3": "", "ja176:1.4": "", "ja176:2.1": "ms22J_422, msdiv52", "ja176:2.2": "", "ja176:2.3": "", "ja176:2.4": "", "ja176:3.1": "ms22J_423"}, "keys_order": ["ja176:0.1", "ja176:0.2", "ja176:0.3", "ja176:0.4", "ja176:1.1", "ja176:1.2", "ja176:1.3", "ja176:1.4", "ja176:2.1", "ja176:2.2", "ja176:2.3", "ja176:2.4", "ja176:3.1"]}