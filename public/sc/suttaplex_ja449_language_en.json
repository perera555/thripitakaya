[{"acronym": "Ja 449", "alt_acronym": null, "volpages": "PTS 4.60, PTS 4.61, PTS 4.62", "alt_volpages": null, "uid": "ja449", "blurb": "“Why in the woodland”—This story the Master told while sojourning in Jetavana, about a landowner whose son had died. At Savatthi, we learn that death took a beloved son of a certain landowner who used to wait upon the Buddha. Afflicted with grief for his son, the man washed not and ate not, and neither went about his own business nor waited upon the Buddha, only cried, “O my beloved son, thou hast left me, and gone before!”", "difficulty": null, "original_title": "Maṭṭhakuṇḍalījātaka", "root_lang": "pli", "root_lang_name": "Pāli", "type": "leaf", "translated_title": "Matta-Kundali Jātaka", "translations": [{"lang": "pli", "lang_name": "Pāli", "is_root": true, "author": "Mahāsaṅgīti Tipiṭaka Buddhavasse 2500", "author_short": "ms", "author_uid": "ms", "publication_date": null, "id": "ja449_root-pli-ms", "segmented": true, "title": null, "volpage": null, "has_comment": false}, {"lang": "de", "lang_name": "Deutsch", "is_root": false, "author": "Dr. Julius Dutoit", "author_short": "Dutoit", "author_uid": "dutoit", "publication_date": "2007", "id": "de_ja449_dutoit", "segmented": false, "volpage": null, "has_comment": false}, {"author": "W.H.D. Rouse", "author_short": "Rouse", "author_uid": "rouse", "has_comment": false, "id": "en_ja449_rouse", "is_root": false, "lang": "en", "lang_name": "English", "publication_date": "1901", "segmented": false, "volpage": null, "title": "Matta-Kundali Jātaka"}, {"lang": "jpn", "lang_name": "日本語", "is_root": false, "author": "関西パーリ語実習会", "author_short": "関西パーリ語実習会", "author_uid": "kansai", "publication_date": "2023", "id": "jpn_ja449_kansai", "segmented": false, "volpage": null, "has_comment": false}, {"lang": "si", "lang_name": "සිංහල", "is_root": false, "author": "A.P. de Zoysa", "author_short": "Zoysa", "author_uid": "zoysa", "publication_date": null, "id": "si_ja449_zoysa", "segmented": false, "volp