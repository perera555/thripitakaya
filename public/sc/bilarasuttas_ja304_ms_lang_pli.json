{"html_text": {"ja304:0.1": "<article id='ja304'><header><ul><li class='division'>{}</li>", "ja304:0.2": "<li>{}</li>", "ja304:0.3": "<li>{}</li></ul>", "ja304:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja304:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja304:1.2": "<span class='verse-line'>{}</span>", "ja304:1.3": "<span class='verse-line'>{}</span>", "ja304:1.4": "<span class='verse-line'>{}</span></p>", "ja304:2.1": "<p><span class='verse-line'>{}</span>", "ja304:2.2": "<span class='verse-line'>{}</span>", "ja304:2.3": "<span class='verse-line'>{}</span>", "ja304:2.4": "<span class='verse-line'>{}</span></p>", "ja304:3.1": "<p><span class='verse-line'>{}</span>", "ja304:3.2": "<span class='verse-line'>{}</span>", "ja304:3.3": "<span class='verse-line'>{}</span>", "ja304:3.4": "<span class='verse-line'>{}</span></p>", "ja304:4.1": "<p><span class='verse-line'>{}</span>", "ja304:4.2": "<span class='verse-line'>{}</span>", "ja304:4.3": "<span class='verse-line'>{}</span>", "ja304:4.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja304:5.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja304:0.1": "Jātaka ", "ja304:0.2": "Catukkanipāta ", "ja304:0.3": "Kāliṅgavagga ", "ja304:0.4": "4. Daddarajātaka ", "ja304:1.1": "“Imāni maṁ daddara tāpayanti, ", "ja304:1.2": "Vācāduruttāni manussaloke; ", "ja304:1.3": "Maṇḍūkabhakkhā udakantasevī, ", "ja304:1.4": "Āsīvisaṁ maṁ avisā sapanti”. ", "ja304:2.1": "“Sakā raṭṭhā pabbājito, ", "ja304:2.2": "aññaṁ janapadaṁ gato; ", "ja304:2.3": "Mahantaṁ koṭṭhaṁ kayirātha, ", "ja304:2.4": "duruttānaṁ nidhetave. ", "ja304:3.1": "Yattha posaṁ na jānanti, ", "ja304:3.2": "jātiyā vinayena vā; ", "ja304:3.3": "Na tattha mānaṁ kayirātha, ", "ja304:3.4": "vasamaññātake jane. ", "ja304:4.1": "Videsavāsaṁ vasato, ", "ja304:4.2": "jātavedasamenapi; ", "ja304:4.3": "Khamitabbaṁ sapaññena, ", "ja304:4.4": "api dāsassa tajjitan”ti. ", "ja304:5.1": "Daddarajātakaṁ catutthaṁ. "}, "variant_text": {"ja304:0.1": "", "ja304:0.2": "", "ja304:0.3": "", "ja304:0.4": "", "ja304:1.1": "", "ja304:1.2": "", "ja304:1.3": "", "ja304:1.4": "", "ja304:2.1": "", "ja304:2.2": "", "ja304:2.3": "", "ja304:2.4": "duruttānaṁ → duruttāni (mr) ", "ja304:3.1": "", "ja304:3.2": "", "ja304:3.3": "", "ja304:3.4": "", "ja304:4.1": "", "ja304:4.2": "jātavedasamenapi → jātavedabhayenapi (mr) ", "ja304:4.3": "", "ja304:4.4": "", "ja304:5.1": ""}, "reference_text": {"ja304:0.1": "", "ja304:0.2": "", "ja304:0.3": "", "ja304:0.4": "", "ja304:1.1": "csp1ed22.95, csp2ed22.95, dr27.131, ms22J_898, msdiv13, ndp22.88, pts-vp-pli3.16, sya27.131", "ja304:1.2": "", "ja304:1.3": "", "ja304:1.4": "", "ja304:2.1": "bj30.166, ms22J_899, msdiv14, pts-vp-pli3.17", "ja304:2.2": "", "ja304:2.3": "", "ja304:2.4": "", "ja304:3.1": "ms22J_900, msdiv15", "ja304:3.2": "", "ja304:3.3": "", "ja304:3.4": "", "ja304:4.1": "ms22J_901, msdiv16", "ja304:4.2": "", "ja304:4.3": "", "ja304:4.4": "", "ja304:5.1": "ms22J_902"}, "keys_order": ["ja304:0.1", "ja304:0.2", "ja304:0.3", "ja304:0.4", "ja304:1.1", "ja304:1.2", "ja304:1.3", "ja304:1.4", "ja304:2.1", "ja304:2.2", "ja304:2.3", "ja304:2.4", "ja304:3.1", "ja304:3.2", "ja304:3.3", "ja304:3.4", "ja304:4.1", "ja304:4.2", "ja304:4.3", "ja304:4.4", "ja304:5.1"]}