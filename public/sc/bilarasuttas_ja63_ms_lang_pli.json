{"html_text": {"ja63:0.1": "<article id='ja63'><header><ul><li class='division'>{}</li>", "ja63:0.2": "<li>{}</li>", "ja63:0.3": "<li>{}</li></ul>", "ja63:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja63:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja63:1.2": "<span class='verse-line'>{}</span>", "ja63:1.3": "<span class='verse-line'>{}</span>", "ja63:1.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja63:2.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja63:0.1": "Jātaka ", "ja63:0.2": "Ekakanipāta ", "ja63:0.3": "Itthivagga ", "ja63:0.4": "3. Takkapaṇḍitajātaka ", "ja63:1.1": "“Kodhanā akataññū ca, ", "ja63:1.2": "pisuṇā mittabhedikā; ", "ja63:1.3": "Brahmacariyaṁ cara bhikkhu, ", "ja63:1.4": "so sukhaṁ na vihāhasīti. ", "ja63:2.1": "Takkapaṇḍitajātakaṁ tatiyaṁ. "}, "variant_text": {"ja63:0.1": "", "ja63:0.2": "", "ja63:0.3": "", "ja63:0.4": "", "ja63:1.1": "", "ja63:1.2": "pisuṇā mittabhedikā → pisuṇā ca vibhedikā (bj, sya1ed, sya2ed, pts-vp-pli1) ", "ja63:1.3": "", "ja63:1.4": "vihāhasīti → hohisīti (bj); vihāhisīti (sya1ed, sya2ed, pts-vp-pli1); vihāyasi (mr) ", "ja63:2.1": "Takkapaṇḍitajātakaṁ → takkajātakaṁ (bj, sya1ed, sya2ed, pts-vp-pli1) "}, "reference_text": {"ja63:0.1": "", "ja63:0.2": "", "ja63:0.3": "", "ja63:0.4": "", "ja63:1.1": "ms22J_139, msdiv63, pts-vp-pli1.298", "ja63:1.2": "", "ja63:1.3": "", "ja63:1.4": "", "ja63:2.1": "ms22J_140"}, "keys_order": ["ja63:0.1", "ja63:0.2", "ja63:0.3", "ja63:0.4", "ja63:1.1", "ja63:1.2", "ja63:1.3", "ja63:1.4", "ja63:2.1"]}