{"html_text": {"ja333:0.1": "<article id='ja333'><header><ul><li class='division'>{}</li>", "ja333:0.2": "<li>{}</li>", "ja333:0.3": "<li>{}</li></ul>", "ja333:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja333:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja333:1.2": "<span class='verse-line'>{}</span>", "ja333:1.3": "<span class='verse-line'>{}</span>", "ja333:1.4": "<span class='verse-line'>{}</span>", "ja333:1.5": "<span class='verse-line'>{}</span>", "ja333:1.6": "<span class='verse-line'>{}</span></p>", "ja333:2.1": "<p><span class='verse-line'>{}</span>", "ja333:2.2": "<span class='verse-line'>{}</span>", "ja333:2.3": "<span class='verse-line'>{}</span>", "ja333:2.4": "<span class='verse-line'>{}</span></p>", "ja333:3.1": "<p><span class='verse-line'>{}</span>", "ja333:3.2": "<span class='verse-line'>{}</span>", "ja333:3.3": "<span class='verse-line'>{}</span>", "ja333:3.4": "<span class='verse-line'>{}</span></p>", "ja333:4.1": "<p><span class='verse-line'>{}</span>", "ja333:4.2": "<span class='verse-line'>{}</span>", "ja333:4.3": "<span class='verse-line'>{}</span>", "ja333:4.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja333:5.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja333:0.1": "Jātaka ", "ja333:0.2": "Catukkanipāta ", "ja333:0.3": "Kokilavagga ", "ja333:0.4": "3. Pakkagodhajātaka ", "ja333:1.1": "“Tadeva me tvaṁ vidito, ", "ja333:1.2": "vanamajjhe rathesabha; ", "ja333:1.3": "Yassa te khaggabaddhassa, ", "ja333:1.4": "sannaddhassa tirīṭino; ", "ja333:1.5": "Assatthadumasākhāya, ", "ja333:1.6": "pakkā godhā palāyatha”. ", "ja333:2.1": "“Name namantassa bhaje bhajantaṁ, ", "ja333:2.2": "Kiccānukubbassa kareyya kiccaṁ; ", "ja333:2.3": "Nānatthakāmassa kareyya atthaṁ, ", "ja333:2.4": "Asambhajantampi na sambhajeyya. ", "ja333:3.1": "Caje cajantaṁ vanathaṁ na kayirā, ", "ja333:3.2": "Apetacittena na sambhajeyya; ", "ja333:3.3": "Dijo dumaṁ khīṇaphalanti ñatvā, ", "ja333:3.4": "Aññaṁ samekkheyya mahā hi loko”. ", "ja333:4.1": "“So te karissāmi yathānubhāvaṁ, ", "ja333:4.2": "Kataññutaṁ khattiye pekkhamāno; ", "ja333:4.3": "Sabbañca te issariyaṁ dadāmi, ", "ja333:4.4": "Yassicchasī tassa tuvaṁ dadāmī”ti. ", "ja333:5.1": "Pakkagodhajātakaṁ tatiyaṁ. "}, "variant_text": {"ja333:0.1": "", "ja333:0.2": "", "ja333:0.3": "", "ja333:0.4": "", "ja333:1.1": "", "ja333:1.2": "", "ja333:1.3": "", "ja333:1.4": "", "ja333:1.5": "", "ja333:1.6": "", "ja333:2.1": "", "ja333:2.2": "", "ja333:2.3": "", "ja333:2.4": "", "ja333:3.1": "", "ja333:3.2": "", "ja333:3.3": "khīṇaphalanti → phalaṁva (si, sya1ed, sya2ed, mr) ", "ja333:3.4": "", "ja333:4.1": "", "ja333:4.2": "khattiye → khattiyo (sya1ed, sya2ed, mr) ", "ja333:4.3": "", "ja333:4.4": "", "ja333:5.1": "Pakkagodhajātakaṁ → godhajātakaṁ (sya1ed, sya2ed, pts-vp-pli1) "}, "reference_text": {"ja333:0.1": "", "ja333:0.2": "", "ja333:0.3": "", "ja333:0.4": "", "ja333:1.1": "csp1ed22.110, csp2ed22.110, ms22J_1049, msdiv129, pts-vp-pli3.108", "ja333:1.2": "", "ja333:1.3": "", "ja333:1.4": "", "ja333:1.5": "", "ja333:1.6": "", "ja333:2.1": "ms22J_1050, msdiv130", "ja333:2.2": "", "ja333:2.3": "", "ja333:2.4": "", "ja333:3.1": "bj30.190, ms22J_1051, msdiv131, sya27.151", "ja333:3.2": "", "ja333:3.3": "", "ja333:3.4": "", "ja333:4.1": "dr27.151, ms22J_1052, msdiv132, ndp22.102, pts-vp-pli3.109", "ja333:4.2": "", "ja333:4.3": "", "ja333:4.4": "", "ja333:5.1": "ms22J_1053"}, "keys_order": ["ja333:0.1", "ja333:0.2", "ja333:0.3", "ja333:0.4", "ja333:1.1", "ja333:1.2", "ja333:1.3", "ja333:1.4", "ja333:1.5", "ja333:1.6", "ja333:2.1", "ja333:2.2", "ja333:2.3", "ja333:2.4", "ja333:3.1", "ja333:3.2", "ja333:3.3", "ja333:3.4", "ja333:4.1", "ja333:4.2", "ja333:4.3", "ja333:4.4", "ja333:5.1"]}