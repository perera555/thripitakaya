{"html_text": {"ja206:0.1": "<article id='ja206'><header><ul><li class='division'>{}</li>", "ja206:0.2": "<li>{}</li>", "ja206:0.3": "<li>{}</li></ul>", "ja206:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja206:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja206:1.2": "<span class='verse-line'>{}</span>", "ja206:1.3": "<span class='verse-line'>{}</span>", "ja206:1.4": "<span class='verse-line'>{}</span></p>", "ja206:2.1": "<p><span class='verse-line'>{}</span>", "ja206:2.2": "<span class='verse-line'>{}</span>", "ja206:2.3": "<span class='verse-line'>{}</span>", "ja206:2.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja206:3.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja206:0.1": "Jātaka ", "ja206:0.2": "Dukanipāta ", "ja206:0.3": "Nataṁdaḷhavagga ", "ja206:0.4": "6. Kuruṅgamigajātaka ", "ja206:1.1": "“Iṅgha vaṭṭamayaṁ pāsaṁ, ", "ja206:1.2": "chinda dantehi kacchapa; ", "ja206:1.3": "Ahaṁ tathā karissāmi, ", "ja206:1.4": "yathā nehiti luddako”. ", "ja206:2.1": "“Kacchapo pāvisī vāriṁ, ", "ja206:2.2": "kuruṅgo pāvisī vanaṁ; ", "ja206:2.3": "Satapatto dumaggamhā, ", "ja206:2.4": "dūre putte apānayī”ti. ", "ja206:3.1": "Kuruṅgamigajātakaṁ chaṭṭhaṁ. "}, "variant_text": {"ja206:0.1": "", "ja206:0.2": "", "ja206:0.3": "", "ja206:0.4": "", "ja206:1.1": "vaṭṭamayaṁ → vaddhamayaṁ (bj, sya1ed, sya2ed, pts-vp-pli1) ", "ja206:1.2": "", "ja206:1.3": "", "ja206:1.4": "", "ja206:2.1": "", "ja206:2.2": "", "ja206:2.3": "", "ja206:2.4": "", "ja206:3.1": ""}, "reference_text": {"ja206:0.1": "", "ja206:0.2": "", "ja206:0.3": "", "ja206:0.4": "", "ja206:1.1": "ms22J_521, msdiv111, pts-vp-pli2.153, vri68.50", "ja206:1.2": "", "ja206:1.3": "", "ja206:1.4": "", "ja206:2.1": "ms22J_522, msdiv112, pts-vp-pli2.155", "ja206:2.2": "", "ja206:2.3": "", "ja206:2.4": "", "ja206:3.1": "ms22J_523"}, "keys_order": ["ja206:0.1", "ja206:0.2", "ja206:0.3", "ja206:0.4", "ja206:1.1", "ja206:1.2", "ja206:1.3", "ja206:1.4", "ja206:2.1", "ja206: