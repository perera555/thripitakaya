{"html_text": {"ja172:0.1": "<article id='ja172'><header><ul><li class='division'>{}</li>", "ja172:0.2": "<li>{}</li>", "ja172:0.3": "<li>{}</li></ul>", "ja172:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja172:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja172:1.2": "<span class='verse-line'>{}</span>", "ja172:1.3": "<span class='verse-line'>{}</span>", "ja172:1.4": "<span class='verse-line'>{}</span></p>", "ja172:2.1": "<p><span class='verse-line'>{}</span>", "ja172:2.2": "<span class='verse-line'>{}</span>", "ja172:2.3": "<span class='verse-line'>{}</span>", "ja172:2.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja172:3.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja172:0.1": "Jātaka ", "ja172:0.2": "Dukanipāta ", "ja172:0.3": "Kalyāṇavagga ", "ja172:0.4": "2. Daddarajātaka ", "ja172:1.1": "“Ko nu saddena mahatā, ", "ja172:1.2": "abhinādeti daddaraṁ; ", "ja172:1.3": "Taṁ sīhā nappaṭinadanti, ", "ja172:1.4": "ko nāmeso migādhibhū”. ", "ja172:2.1": "“Adhamo migajātānaṁ, ", "ja172:2.2": "siṅgālo tāta vassati; ", "ja172:2.3": "Jātimassa jigucchantā, ", "ja172:2.4": "tuṇhī sīhā samacchare”ti. ", "ja172:3.1": "Daddarajātakaṁ dutiyaṁ. "}, "variant_text": {"ja172:0.1": "", "ja172:0.2": "", "ja172:0.3": "", "ja172:0.4": "", "ja172:1.1": "", "ja172:1.2": "", "ja172:1.3": "Taṁ sīhā nappaṭinadanti → kiṁ sīhā nappaṭinadanti (bj); kiṁ sīhā nappaṭinandanti (pts-vp-pli1); na sīhā paṭinadanti (mr) ", "ja172:1.4": "", "ja172:2.1": "", "ja172:2.2": "", "ja172:2.3": "", "ja172:2.4": "", "ja172:3.1": ""}, "reference_text": {"ja172:0.1": "", "ja172:0.2": "", "ja172:0.3": "", "ja172:0.4": "", "ja172:1.1": "ms22J_409, msdiv43, pts-vp-pli2.67", "ja172:1.2": "", "ja172:1.3": "", "ja172:1.4": "", "ja172:2.1": "ms22J_410, msdiv44", "ja172:2.2": "", "ja172:2.3": "", "ja172:2.4": "", "ja172:3.1": "ms22J_411"}, "keys_order": ["ja172:0.1", "ja172:0.2", "ja172:0.3", "ja172:0.4", "ja172:1.1", "ja172:1.2", "ja172:1.3", "ja172:1.4", "j