[{"acronym": "Ja 425", "alt_acronym": null, "volpages": "PTS 3.477, PTS 3.478", "alt_volpages": null, "uid": "ja425", "blurb": "“Make Ganges calm”—The Master told this tale while dwelling in Jetavana, concerning a backsliding Brother. The Master asked him, “Is the story true, Brother, that you are backsliding?” “Yes, lord.” “What is the cause?” “The power of desire.” “Brother, womankind are ungrateful, treacherous, untrustworthy: of old wise men could not satisfy a woman, even by giving her a thousand pieces a day: and one day when she did not get the thousand pieces she had them taken by the neck and cast out: so ungrateful are womankind: do not fall into the power of desire for such a cause,” and so he told an old tale.", "difficulty": null, "original_title": "Aṭṭhānajātaka", "root_lang": "pli", "root_lang_name": "Pāli", "type": "leaf", "translated_title": "Atthana Jātaka", "translations": [{"lang": "pli", "lang_name": "Pāli", "is_root": true, "author": "Mahāsaṅgīti Tipiṭaka Buddhavasse 2500", "author_short": "ms", "author_uid": "ms", "publication_date": null, "id": "ja425_root-pli-ms", "segmented": true, "title": null, "volpage": null, "has_comment": false}, {"lang": "de", "lang_name": "Deutsch", "is_root": false, "author": "Dr. Julius Dutoit", "author_short": "Dutoit", "author_uid": "dutoit", "publication_date": "2007", "id": "de_ja425_dutoit", "segmented": false, "volpage": null, "has_comment": false}, {"author": "H.T. Francis, R.A. Neil", "author_short": "Francis …", "author_uid": "francis-neil", "has_comment": false, "id": "en_ja425_francis-neil", "is_root": false, "lang": "en", "lang_name": "English", "publication_date": "1897", "segmented": false, "volpage": null, "title": "Atthana Jātaka"}, {"lang": "jpn", "lang_name": "日本語", "is_root": false, "author": "関西パーリ語実習会", "author_short": "関西パーリ語実習会", "author_uid": "kansai", "publication_date": "2023", "id": "jpn_ja425_kansai", "segmented": false, "volpage": null, "has_comment": false}, {"lang": "si", "lang_name"