[{"acronym": "Ja 225", "alt_acronym": null, "volpages": "PTS 2.207", "alt_volpages": null, "uid": "ja225", "blurb": "“There is a man”—This story the Master told at Jetavana, about the king of Kosala. A very useful subordinate intrigued in the harem. Even though he knew the culprit, the king pocketed the affront, because the fellow was useful, and told the Master of it. The Master said, “Other kings in days long gone by have done the same;” and at his request, told the following story.", "difficulty": null, "original_title": "Khantivaṇṇajātaka", "root_lang": "pli", "root_lang_name": "Pāli", "type": "leaf", "translated_title": "Khanti-Vannana Jātaka", "translations": [{"lang": "pli", "lang_name": "Pāli", "is_root": true, "author": "Mahāsaṅgīti Tipiṭaka Buddhavasse 2500", "author_short": "ms", "author_uid": "ms", "publication_date": null, "id": "ja225_root-pli-ms", "segmented": true, "title": null, "volpage": null, "has_comment": false}, {"lang": "de", "lang_name": "Deutsch", "is_root": false, "author": "Dr. Julius Dutoit", "author_short": "Dutoit", "author_uid": "dutoit", "publication_date": "2007", "id": "de_ja225_dutoit", "segmented": false, "volpage": null, "has_comment": false}, {"author": "W.H.D. Rouse", "author_short": "Rouse", "author_uid": "rouse", "has_comment": false, "id": "en_ja225_rouse", "is_root": false, "lang": "en", "lang_name": "English", "publication_date": "1895", "segmented": false, "volpage": null, "title": "Khanti-Vannana Jātaka"}, {"lang": "jpn", "lang_name": "日本語", "is_root": false, "author": "関西パーリ語実習会", "author_short": "関西パーリ語実習会", "author_uid": "kansai", "publication_date": "2023", "id": "jpn_ja225_kansai", "segmented": false, "volpage": null, "has_comment": false}, {"lang": "si", "lang_name": "සිංහල", "is_root": false, "author": "A.P. de Zoysa", "author_short": "Zoysa", "author_uid": "zoysa", "publication_date": null, "id": "si_ja225_zoysa", "segmented": false, "volpage": null, "has_comment": false}], "parallel_count": 0, "biblio": null, "