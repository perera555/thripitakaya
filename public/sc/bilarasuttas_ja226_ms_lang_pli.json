{"html_text": {"ja226:0.1": "<article id='ja226'><header><ul><li class='division'>{}</li>", "ja226:0.2": "<li>{}</li>", "ja226:0.3": "<li>{}</li></ul>", "ja226:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja226:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja226:1.2": "<span class='verse-line'>{}</span>", "ja226:1.3": "<span class='verse-line'>{}</span>", "ja226:1.4": "<span class='verse-line'>{}</span>", "ja226:1.5": "<span class='verse-line'>{}</span>", "ja226:1.6": "<span class='verse-line'>{}</span></p>", "ja226:2.1": "<p><span class='verse-line'>{}</span>", "ja226:2.2": "<span class='verse-line'>{}</span>", "ja226:2.3": "<span class='verse-line'>{}</span>", "ja226:2.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja226:3.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja226:0.1": "Jātaka ", "ja226:0.2": "Dukanipāta ", "ja226:0.3": "Kāsāvavagga ", "ja226:0.4": "6. Kosiyajātaka ", "ja226:1.1": "“Kāle nikkhamanā sādhu, ", "ja226:1.2": "nākāle sādhu nikkhamo; ", "ja226:1.3": "Akālena hi nikkhamma, ", "ja226:1.4": "ekakampi bahujjano; ", "ja226:1.5": "Na kiñci atthaṁ joteti, ", "ja226:1.6": "dhaṅkasenāva kosiyaṁ. ", "ja226:2.1": "Dhīro ca vidhividhānaññū, ", "ja226:2.2": "paresaṁ vivarānugū; ", "ja226:2.3": "Sabbāmitte vasīkatvā, ", "ja226:2.4": "kosiyova sukhī siyā”ti. ", "ja226:3.1": "Kosiyajātakaṁ chaṭṭhaṁ. "}, "reference_text": {"ja226:0.1": "", "ja226:0.2": "", "ja226:0.3": "", "ja226:0.4": "", "ja226:1.1": "dr27.85, ms22J_585, msdiv151, pts-vp-pli2.208", "ja226:1.2": "", "ja226:1.3": "", "ja226:1.4": "", "ja226:1.5": "", "ja226:1.6": "", "ja226:2.1": "ms22J_586, msdiv152, sya27.86", "ja226:2.2": "", "ja226:2.3": "", "ja226:2.4": "", "ja226:3.1": "ms22J_587"}, "keys_order": ["ja226:0.1", "ja226:0.2", "ja226:0.3", "ja226:0.4", "ja226:1.1", "ja226:1.2", "ja226:1.3", "ja226:1.4", "ja226:1.5", "ja226:1.6", "ja226:2.1", "ja226:2.2", "ja226:2.3", "ja226:2.4", "ja226:3.1"]}