{"html_text": {"ja373:0.1": "<article id='ja373'><header><ul><li class='division'>{}</li>", "ja373:0.2": "<li>{}</li>", "ja373:0.3": "<li>{}</li></ul>", "ja373:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja373:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja373:1.2": "<span class='verse-line'>{}</span>", "ja373:1.3": "<span class='verse-line'>{}</span>", "ja373:1.4": "<span class='verse-line'>{}</span></p>", "ja373:2.1": "<p><span class='verse-line'>{}</span>", "ja373:2.2": "<span class='verse-line'>{}</span>", "ja373:2.3": "<span class='verse-line'>{}</span>", "ja373:2.4": "<span class='verse-line'>{}</span></p>", "ja373:3.1": "<p><span class='verse-line'>{}</span>", "ja373:3.2": "<span class='verse-line'>{}</span>", "ja373:3.3": "<span class='verse-line'>{}</span>", "ja373:3.4": "<span class='verse-line'>{}</span></p>", "ja373:4.1": "<p><span class='verse-line'>{}</span>", "ja373:4.2": "<span class='verse-line'>{}</span>", "ja373:4.3": "<span class='verse-line'>{}</span>", "ja373:4.4": "<span class='verse-line'>{}</span></p>", "ja373:5.1": "<p><span class='verse-line'>{}</span>", "ja373:5.2": "<span class='verse-line'>{}</span>", "ja373:5.3": "<span class='verse-line'>{}</span>", "ja373:5.4": "<span class='verse-line'>{}</span>", "ja373:5.5": "<span class='verse-line'>{}</span>", "ja373:5.6": "<span class='verse-line'>{}</span></p></blockquote>", "ja373:6.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja373:0.1": "Jātaka ", "ja373:0.2": "Pañcakanipāta ", "ja373:0.3": "Aḍḍhavagga ", "ja373:0.4": "3. Mūsikajātaka ", "ja373:1.1": "“Kuhiṁ gatā kattha gatā, ", "ja373:1.2": "iti lālappatī jano; ", "ja373:1.3": "Ahameveko jānāmi, ", "ja373:1.4": "udapāne mūsikā hatā. ", "ja373:2.1": "Yañcetaṁ iti cīti ca, ", "ja373:2.2": "gadrabhova nivattasi; ", "ja373:2.3": "Udapāne mūsikaṁ hantvā, ", "ja373:2.4": "yavaṁ bhakkhetumicchasi. ", "ja373:3.1": "Daharo cāsi dummedha, ", "ja373:3.2": "paṭhamuppattiko susu; ", "ja373:3.3": "Dīghañcetaṁ samāsajja, ", "ja373:3.4": "na te dassāmi jīvitaṁ. ", "ja373:4.1": "Nāntalikkhabhavanena, ", "ja373:4.2": "nāṅgaputtapinena vā; ", "ja373:4.3": "Puttena hi patthayito, ", "ja373:4.4": "silokehi pamocito. ", "ja373:5.1": "Sabbaṁ sutamadhīyetha, ", "ja373:5.2": "hīnamukkaṭṭhamajjhimaṁ; ", "ja373:5.3": "Sabbassa atthaṁ jāneyya, ", "ja373:5.4": "na ca sabbaṁ payojaye; ", "ja373:5.5": "Hoti tādisako kālo, ", "ja373:5.6": "yattha atthāvahaṁ sutan”ti. ", "ja373:6.1": "Mūsikajātakaṁ tatiyaṁ. "}, "variant_text": {"ja373:0.1": "", "ja373:0.2": "", "ja373:0.3": "", "ja373:0.4": "", "ja373:1.1": "", "ja373:1.2": "", "ja373:1.3": "", "ja373:1.4": "", "ja373:2.1": "Yañcetaṁ → yathetaṁ (bj, pts-vp-pli1); yavetaṁ (mr); yametaṁ (katthaci) ", "ja373:2.2": "", "ja373:2.3": "", "ja373:2.4": "", "ja373:3.1": "", "ja373:3.2": "paṭhamuppattiko → paṭhamuppattito (si, pts-vp-pli1) ", "ja373:3.3": "Dīghañcetaṁ → dīghametaṁ (bj, pts-vp-pli1) | samāsajja → samāpajja (sya1ed, sya2ed, mr) ", "ja373:3.4": "", "ja373:4.1": "", "ja373:4.2": "nāṅgaputtapinena → nāṅgaputtasirena (bj, sya1ed, sya2ed); naṅgaputtasirena (pts-vp-pli1) ", "ja373:4.3": "", "ja373:4.4": "", "ja373:5.1": "", "ja373:5.2": "", "ja373:5.3": "", "ja373:5.4": "", "ja373:5.5": "", "ja373:5.6": "", "ja373:6.1": ""}, "reference_text": {"ja373:0.1": "", "ja373:0.2": "", "ja373:0.3": "", "ja373:0.4": "", "ja373:1.1": "ms22J_1292, msdiv123, pts-vp-pli3.217", "ja373:1.2": "", "ja373:1.3": "", "ja373:1.4": "", "ja373:2.1": "ms22J_1293, msdiv124", "ja373:2.2": "", "ja373:2.3": "", "ja373:2.4": "", "ja373:3.1": "ms22J_1294, msdiv125, pts-vp-pli3.218, sya27.184", "ja373:3.2": "", "ja373:3.3": "", "ja373:3.4": "", "ja373:4.1": "dr27.183, ms22J_1295, msdiv126", "ja373:4.2": "", "ja373:4.3": "", "ja373:4.4": "", "ja373:5.1": "ms22J_1296, msdiv127, vri68.114", "ja373:5.2": "", "ja373:5.3": "", "ja373:5.4": "", "ja373:5.5": "", "ja373:5.6": "", "ja373:6.1": "ms22J_1297"}, "keys_order": ["ja373:0.1", "ja373:0.2", "ja373:0.3", "ja373:0.4", 