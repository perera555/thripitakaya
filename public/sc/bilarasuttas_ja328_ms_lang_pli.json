{"html_text": {"ja328:0.1": "<article id='ja328'><header><ul><li class='division'>{}</li>", "ja328:0.2": "<li>{}</li>", "ja328:0.3": "<li>{}</li></ul>", "ja328:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja328:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja328:1.2": "<span class='verse-line'>{}</span>", "ja328:1.3": "<span class='verse-line'>{}</span>", "ja328:1.4": "<span class='verse-line'>{}</span></p>", "ja328:2.1": "<p><span class='verse-line'>{}</span>", "ja328:2.2": "<span class='verse-line'>{}</span>", "ja328:2.3": "<span class='verse-line'>{}</span>", "ja328:2.4": "<span class='verse-line'>{}</span></p>", "ja328:3.1": "<p><span class='verse-line'>{}</span>", "ja328:3.2": "<span class='verse-line'>{}</span>", "ja328:3.3": "<span class='verse-line'>{}</span>", "ja328:3.4": "<span class='verse-line'>{}</span></p>", "ja328:4.1": "<p><span class='verse-line'>{}</span>", "ja328:4.2": "<span class='verse-line'>{}</span>", "ja328:4.3": "<span class='verse-line'>{}</span>", "ja328:4.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja328:5.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja328:0.1": "Jātaka ", "ja328:0.2": "Catukkanipāta ", "ja328:0.3": "Kuṭidūsakavagga ", "ja328:0.4": "8. Ananusociyajātaka ", "ja328:1.1": "“Bahūnaṁ vijjatī bhotī, ", "ja328:1.2": "tehi me kiṁ bhavissati; ", "ja328:1.3": "Tasmā etaṁ na socāmi, ", "ja328:1.4": "piyaṁ sammillahāsiniṁ. ", "ja328:2.1": "Taṁ tañce anusoceyya, ", "ja328:2.2": "yaṁ yaṁ tassa na vijjati; ", "ja328:2.3": "Attānamanusoceyya, ", "ja328:2.4": "sadā maccuvasaṁ pataṁ. ", "ja328:3.1": "Na heva ṭhitaṁ nāsīnaṁ, ", "ja328:3.2": "Na sayānaṁ na paddhaguṁ; ", "ja328:3.3": "Yāva byāti nimisati, ", "ja328:3.4": "Tatrāpi rasatī vayo. ", "ja328:4.1": "Tatthattani vatappaddhe, ", "ja328:4.2": "vinābhāve asaṁsaye; ", "ja328:4.3": "Bhūtaṁ sesaṁ dayitabbaṁ, ", "ja328:4.4": "vītaṁ ananusociyan”ti. ", "ja328:5.1": "Ananusociyajātakaṁ aṭṭhamaṁ. "}, "variant_text": {"ja328:0.1": "", "ja328:0.2": "", "ja328:0.3": "", "ja328:0.4": "", "ja328:1.1": "", "ja328:1.2": "", "ja328:1.3": "", "ja328:1.4": "", "ja328:2.1": "", "ja328:2.2": "", "ja328:2.3": "", "ja328:2.4": "", "ja328:3.1": "", "ja328:3.2": "paddhaguṁ → patthaguṁ (sya1ed, sya2ed) ", "ja328:3.3": "Yāva byāti nimisati → yava pāti nimmisati (bj); yāvuppatti nimissati (sya1ed, sya2ed); yāva pāti nimisati (pts-vp-pli1) ", "ja328:3.4": "rasatī → saratī vayo (bj, sya1ed, sya2ed); saratibbayo (pts-vp-pli1) ", "ja328:4.1": "vatappaddhe → vatappanthe (sya1ed, sya2ed); vata bandhe (mr) ", "ja328:4.2": "", "ja328:4.3": "", "ja328:4.4": "vītaṁ ananusociyan”ti → cavitaṁ ananusociyanti (sya1ed, sya2ed); matantaṁ nānusociyaṁ (mr) ", "ja328:5.1": ""}, "reference_text": {"ja328:0.1": "", "ja328:0.2": "", "ja328:0.3": "", "ja328:0.4": "", "ja328:1.1": "ms22J_1022, msdiv109, pts-vp-pli3.95", "ja328:1.2": "", "ja328:1.3": "", "ja328:1.4": "", "ja328:2.1": "ms22J_1023, msdiv110, ndp22.99", "ja328:2.2": "", "ja328:2.3": "", "ja328:2.4": "", "ja328:3.1": "ms22J_1024, msdiv111, sya27.147", "ja328:3.2": "", "ja328:3.3": "", "ja328:3.4": "", "ja328:4.1": "dr27.147, ms22J_1025, msdiv112", "ja328:4.2": "", "ja328:4.3": "", "ja328:4.4": "", "ja328:5.1": "ms22J_1026"}, "keys_order": ["ja328:0.1", "ja328:0.2", "ja328:0.3", "ja328:0.4", "ja328:1.1", "ja328:1.2", "ja328:1.3", "ja328:1.4", "ja328:2.1", "ja328:2.2", "ja328:2.3", "ja328:2.4", "ja328:3.1", "ja328:3.2", "ja328:3.3", "ja328:3.4", "ja328:4.1", "ja328:4.2", "ja328:4.3", "ja328:4.4", "ja328:5.1"]}