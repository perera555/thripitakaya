{"html_text": {"ja410:0.1": "<article id='ja410'><header><ul><li class='division'>{}</li>", "ja410:0.2": "<li>{}</li>", "ja410:0.3": "<li>{}</li></ul>", "ja410:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja410:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja410:1.2": "<span class='verse-line'>{}</span>", "ja410:1.3": "<span class='verse-line'>{}</span>", "ja410:1.4": "<span class='verse-line'>{}</span></p>", "ja410:2.1": "<p><span class='verse-line'>{}</span>", "ja410:2.2": "<span class='verse-line'>{}</span>", "ja410:2.3": "<span class='verse-line'>{}</span>", "ja410:2.4": "<span class='verse-line'>{}</span></p>", "ja410:3.1": "<p><span class='verse-line'>{}</span>", "ja410:3.2": "<span class='verse-line'>{}</span>", "ja410:3.3": "<span class='verse-line'>{}</span>", "ja410:3.4": "<span class='verse-line'>{}</span></p>", "ja410:4.1": "<p><span class='verse-line'>{}</span>", "ja410:4.2": "<span class='verse-line'>{}</span>", "ja410:4.3": "<span class='verse-line'>{}</span>", "ja410:4.4": "<span class='verse-line'>{}</span></p>", "ja410:5.1": "<p><span class='verse-line'>{}</span>", "ja410:5.2": "<span class='verse-line'>{}</span>", "ja410:5.3": "<span class='verse-line'>{}</span>", "ja410:5.4": "<span class='verse-line'>{}</span></p>", "ja410:6.1": "<p><span class='verse-line'>{}</span>", "ja410:6.2": "<span class='verse-line'>{}</span>", "ja410:6.3": "<span class='verse-line'>{}</span>", "ja410:6.4": "<span class='verse-line'>{}</span></p>", "ja410:7.1": "<p><span class='verse-line'>{}</span>", "ja410:7.2": "<span class='verse-line'>{}</span>", "ja410:7.3": "<span class='verse-line'>{}</span>", "ja410:7.4": "<span class='verse-line'>{}</span></p>", "ja410:8.1": "<p><span class='verse-line'>{}</span>", "ja410:8.2": "<span class='verse-line'>{}</span>", "ja410:8.3": "<span class='verse-line'>{}</span>", "ja410:8.4": "<span class='verse-line'>{}</span></p>", "ja410:9.1": "<p><span class='verse-line'>{}</span>", "ja410:9.2": "<span class='verse-line'>{}</span>", "ja410:9.3": "<span class='verse-line'>{}</span>", "ja410:9.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja410:10.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja410:0.1": "Jātaka ", "ja410:0.2": "Sattakanipāta ", "ja410:0.3": "Gandhāravagga ", "ja410:0.4": "5. Somadattajātaka ", "ja410:1.1": "“Yo maṁ pure paccuḍḍeti, ", "ja410:1.2": "araññe dūramāyato; ", "ja410:1.3": "So na dissati mātaṅgo, ", "ja410:1.4": "somadatto kuhiṁ gato. ", "ja410:2.1": "Ayaṁ vā so mato seti, ", "ja410:2.2": "allasiṅgaṁva vacchito; ", "ja410:2.3": "Bhumyā nipatito seti, ", "ja410:2.4": "amarā vata kuñjaro”. ", "ja410:3.1": "“Anagāriyupetassa, ", "ja410:3.2": "vippamuttassa te sato; ", "ja410:3.3": "Samaṇassa na taṁ sādhu, ", "ja410:3.4": "yaṁ petamanusocasi”. ", "ja410:4.1": "“Saṁvāsena have sakka, ", "ja410:4.2": "manussassa migassa vā; ", "ja410:4.3": "Hadaye jāyate pemaṁ, ", "ja410:4.4": "taṁ na sakkā asocituṁ”. ", "ja410:5.1": "“Mataṁ marissaṁ rodanti, ", "ja410:5.2": "ye rudanti lapanti ca; ", "ja410:5.3": "Tasmā tvaṁ isi mā rodi, ", "ja410:5.4": "roditaṁ moghamāhu santo. ", "ja410:6.1": "Kanditena have brahme, ", "ja410:6.2": "mato peto samuṭṭhahe; ", "ja410:6.3": "Sabbe saṅgamma rodāma, ", "ja410:6.4": "aññamaññassa ñātake”. ", "ja410:7.1": "“Ādittaṁ vata maṁ santaṁ, ", "ja410:7.2": "ghatasittaṁva pāvakaṁ; ", "ja410:7.3": "Vārinā viya osiñcaṁ, ", "ja410:7.4": "sabbaṁ nibbāpaye daraṁ. ", "ja410:8.1": "Abbahī vata me sallaṁ, ", "ja410:8.2": "yamāsi hadayassitaṁ; ", "ja410:8.3": "Yo me sokaparetassa, ", "ja410:8.4": "puttasokaṁ apānudi. ", "ja410:9.1": "Sohaṁ abbūḷhasallosmi, ", "ja410:9.2": "vītasoko anāvilo; ", "ja410:9.3": "Na socāmi na rodāmi, ", "ja410:9.4": "tava sutvāna vāsavā”ti. ", "ja410:10.1": "Somadattajātakaṁ pañcamaṁ. "}, "variant_text": {"ja410:0.1": "", "ja410:0.2": "", "ja410:0.3": "", "ja410:0.4": "", "ja410:1.1": "paccuḍḍeti → paccudeti (bj, sya1ed, sya2ed, pts-vp-pli1); paccuṭṭheti (mr) ", "ja410:1.2": "", "ja410:1.3": "", "ja410:1.4": "", "ja410:2.1": "", "ja410:2.2": "allasiṅgaṁva vacchito → allapiṅkaṁva chijjito (bj, pts-vp-pli1); allapītaṁva vicchito (sya1ed); allapitaṁva vicchito (sya2ed) ", "ja410:2.3": "", "ja410:2.4": "", "ja410:3.1": "", "ja410:3.2": "", "ja410:3.3": "", "ja410:3.4": "", "ja410:4.1": "", "ja410:4.2": "", "ja410:4.3": "", "ja410:4.4": "", "ja410:5.1": "", "ja410:5.2": "", "ja410:5.3": "", "ja410:5.4": "", "ja410:6.1": "", "ja410:6.2": "", "ja410:6.3": "", "ja410:6.4": "", "ja410:7.1": "", "ja410:7.2": "", "ja410:7.3": "", "ja410:7.4": "", "ja410:8.1": "", "ja410:8.2": "", "ja410:8.3": "", "ja410:8.4": "", "ja410:9.1": "", "ja410:9.2": "", "ja410:9.3": "", "ja410:9.4": "", "ja410:10.1": ""}, "reference_text": {"ja410:0.1": "", "ja410:0.2": "", "ja410:0.3": "", "ja410:0.4": "", "ja410:1.1": "ms22J_1605, msdiv105, pts-vp-pli3.389", "ja410:1.2": "", "ja410:1.3": "", "ja410:1.4": "", "ja410:2.1": "ms22J_1606, msdiv106", "ja410:2.2": "", "ja410:2.3": "", "ja410:2.4": "", "ja410:3.1": "ms22J_1607, msdiv107, pts-vp-pli3.390", "ja410:3.2": "", "ja410:3.3": "", "ja410:3.4": "", "ja410:4.1": "dr27.228, ms22J_1608, msdiv108, ndp22.160, sya27.229", "ja410:4.2": "", "ja410:4.3": "", "ja410:4.4": "", "ja410:5.1": "ms22J_1609, msdiv109", "ja410:5.2": "", "ja410:5.3": "", "ja410:5.4": "", "ja410:6.1": "ms22J_1610, msdiv110, vri68.139", "ja410:6.2": "", "ja410:6.3": "", "ja410:6.4": "", "ja410:7.1": "ms22J_1611, msdiv111", "ja410:7.2": "", "ja410:7.3": "", "ja410:7.4": "", "ja410:8.1": "ms22J_1612, msdiv112", "ja410:8.2": "", "ja410:8.3": "", "ja410:8.4": "", "ja410:9.1": "ms22J_1613, msdiv113, pts-vp-pli3.391", "ja410:9.2": "", "ja410:9.3": "", "ja410:9.4": "", "ja410:10.1": "ms22J_1614"}, "keys_order": ["ja410:0.1", "ja410:0.2", "ja410:0.3", "ja410:0.4", "ja410:1.1", "ja410:1.2", "ja410:1.3", "ja410:1.4", "ja410:2.1", "ja410:2.2", "ja410:2.3", "ja410:2.4", "ja410:3.1", "ja410:3.2", "ja410:3.3", "ja410:3.4", "ja410:4.1", "ja410:4.2", "ja410:4.3", "ja410:4.4", "j