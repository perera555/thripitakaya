n>", "ja493:17.2": "<span class='verse-line'>{}</span>", "ja493:17.3": "<span class='verse-line'>{}</span>", "ja493:17.4": "<span class='verse-line'>{}</span></p>", "ja493:18.1": "<p><span class='verse-line'>{}</span>", "ja493:18.2": "<span class='verse-line'>{}</span>", "ja493:18.3": "<span class='verse-line'>{}</span>", "ja493:18.4": "<span class='verse-line'>{}</span></p>", "ja493:19.1": "<p><span class='verse-line'>{}</span>", "ja493:19.2": "<span class='verse-line'>{}</span>", "ja493:19.3": "<span class='verse-line'>{}</span>", "ja493:19.4": "<span class='verse-line'>{}</span></p>", "ja493:20.1": "<p><span class='verse-line'>{}</span>", "ja493:20.2": "<span class='verse-line'>{}</span>", "ja493:20.3": "<span class='verse-line'>{}</span>", "ja493:20.4": "<span class='verse-line'>{}</span></p>", "ja493:21.1": "<p><span class='verse-line'>{}</span>", "ja493:21.2": "<span class='verse-line'>{}</span>", "ja493:21.3": "<span class='verse-line'>{}</span>", "ja493:21.4": "<span class='verse-line'>{}</span></p>", "ja493:22.1": "<p><span class='verse-line'>{}</span>", "ja493:22.2": "<span class='verse-line'>{}</span>", "ja493:22.3": "<span class='verse-line'>{}</span>", "ja493:22.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja493:23.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja493:0.1": "Jātaka ", "ja493:0.2": "Pakiṇṇakanipāta ", "ja493:0.3": "Sālikedāravagga ", "ja493:0.4": "10. Mahāvāṇijajātaka ", "ja493:1.1": "Vāṇijā samitiṁ katvā, ", "ja493:1.2": "nānāraṭṭhato āgatā; ", "ja493:1.3": "Dhanāharā pakkamiṁsu, ", "ja493:1.4": "ekaṁ katvāna gāmaṇiṁ. ", "ja493:2.1": "Te taṁ kantāramāgamma, ", "ja493:2.2": "appabhakkhaṁ anodakaṁ; ", "ja493:2.3": "Mahānigrodhamaddakkhuṁ, ", "ja493:2.4": "sītacchāyaṁ manoramaṁ. ", "ja493:3.1": "Te ca tattha nisīditvā, ", "ja493:3.2": "tassa rukkhassa chāyayā; ", "ja493:3.3": "Vāṇijā samacintesuṁ, ", "ja493:3.4": "bālā mohena pārutā. ", "ja493:4.1": "Allāyate ayaṁ rukkho, ", "ja493:4.2": "api vārīva sandati; ", "ja493:4.3": "Iṅghassa purimaṁ sākhaṁ, ", "ja493:4.4": "mayaṁ chindāma vāṇijā. ", "ja493:5.1": "Sā ca chinnāva pagghari, ", "ja493:5.2": "acchaṁ vāriṁ anāvilaṁ; ", "ja493:5.3": "Te tattha nhatvā pivitvā, ", "ja493:5.4": "yāvaticchiṁsu vāṇijā. ", "ja493:6.1": "Dutiyaṁ samacintesuṁ, ", "ja493:6.2": "bālā mohena pārutā; ", "ja493:6.3": "Iṅghassa dakkhiṇaṁ sākhaṁ, ", "ja493:6.4": "mayaṁ chindāma vāṇijā. ", "ja493:7.1": "Sā ca chinnāva pagghari, ", "ja493:7.2": "sālimaṁsodanaṁ bahuṁ; ", "ja493:7.3": "Appodavaṇṇe kummāse, ", "ja493:7.4": "siṅgiṁ vidalasūpiyo. ", "ja493:8.1": "Te tattha bhutvā khāditvā, ", "ja493:8.2": "yāvaticchiṁsu vāṇijā; ", "ja493:8.3": "Tatiyaṁ samacintesuṁ, ", "ja493:8.4": "bālā mohena pārutā; ", "ja493:8.5": "Iṅghassa pacchimaṁ sākhaṁ, ", "ja493:8.6": "mayaṁ chindāma vāṇijā. ", "ja493:9.1": "Sā ca chinnāva pagghari, ", "ja493:9.2": "nāriyo samalaṅkatā; ", "ja493:9.3": "Vicitravatthābharaṇā, ", "ja493:9.4": "āmuttamaṇikuṇḍalā. ", "ja493:10.1": "Api su vāṇijā ekā, ", "ja493:10.2": "nāriyo paṇṇavīsati; ", "ja493:10.3": "Samantā parivāriṁsu, ", "ja493:10.4": "tassa rukkhassa chāyayā. ", "ja493:11.1": "Te tāhi paricāretvā, ", "ja493:11.2": "yāvaticchiṁsu vāṇijā; ", "ja493:11.3": "Catutthaṁ samacintesuṁ, ", "ja493:11.4": "bālā mohena pārutā; ", "ja493:11.5": "Iṅghassa uttaraṁ sākhaṁ, ", "ja493:11.6": "mayaṁ chindāma vāṇijā. ", "ja493:12.1": "Sā ca chinnāva pagghari, ", "ja493:12.2": "muttā veḷuriyā bahū; ", "ja493:12.3": "Rajataṁ jātarūpañca, ", "ja493:12.4": "kuttiyo paṭiyāni ca. ", "ja493:13.1": "Kāsikāni ca vatthāni, ", "ja493:13.2": "uddiyāni ca kambalā; ", "ja493:13.3": "Te tattha bhāre bandhitvā, ", "ja493:13.4": "yāvaticchiṁsu vāṇijā. ", "ja493:14.1": "Pañcamaṁ samacintesuṁ, ", "ja493:14.2": "bālā mohena pārutā; ", "ja493:14.3": "Iṅghassa mūlaṁ chindāma, ", "ja493:14.4": "api bhiyyo labhāmase. ", "ja493:15.1": "Athuṭṭhahi satthavāho, ", "ja493:15.2": "yācamāno katañjalī; ", "ja493:15.3": "Nigrodho kiṁ parajjhati, ", "ja493:15.4": "vāṇijā bhaddamatthu te. ", "ja493:16.1": "Vāridā purimā sākhā, ", "ja493:16.2": "annapānañca dakkhiṇā; ", "ja493:16.3": "Nāridā pacchimā sākhā, ", "ja493:16.4": "sabbakāme ca uttarā; ", "ja493:16.5": "Nigrodho kiṁ parajjhati, ", "ja493:16.6": "vāṇijā bhaddamatthu te. ", "ja493:17.1": "Yassa rukkhassa chāyāya, ", "ja493:17.2": "nisīdeyya sayeyya vā; ", "ja493:17.3": "Na tassa sākhaṁ bhañjeyya, ", "ja493:17.4": "mittadubbho hi pāpako. ", "ja493:18.1": "Te ca tassānādiyitvā, ", "ja493:18.2": "ekassa vacanaṁ bahū; ", "ja493:18.3": "Nisitāhi kuṭhārīhi, ", "ja493:18.4": "mūlato naṁ upakkamuṁ. ", "ja493:19.1": "Tato nāgā nikkhamiṁsu, ", "ja493:19.2": "sannaddhā paṇṇavīsati; ", "ja493:19.3": "Dhanuggahānaṁ tisatā, ", "ja493:19.4": "chasahassā ca vammino. ", "ja493:20.1": "“Ete hanatha bandhatha, ", "ja493:20.2": "Mā vo muñcittha jīvitaṁ; ", "ja493:20.3": "Ṭhapetvā satthavāhaṁva, ", "ja493:20.4": "Sabbe bhasmaṁ karotha ne”. ", "ja493:21.1": "“Tasmā hi paṇḍito poso, ", "ja493:21.2": "sampassaṁ atthamattano; ", "ja493:21.3": "Lobhassa na vasaṁ gacche, ", "ja493:21.4": "haneyyārisakaṁ manaṁ. ", "ja493:22.1": "Evamādīnavaṁ ñatvā, ", "ja493:22.2": "taṇhā dukkhassa sambhavaṁ; ", "ja493:22.3": "Vītataṇho anādāno, ", "ja493:22.4": "sato bhikkhu paribbaje”ti. ", "ja493:23.1": "Mahāvāṇijajātakaṁ dasamaṁ. "}, "variant_text": {"ja493:0.1": "", "ja493:0.2": "", "ja493:0.3": "", "ja493:0.4": "", "ja493:1.1": "", "ja493:1.2": "", "ja493:1.3": "", "ja493:1.4": "", "ja493:2.1": "", "ja493:2.2": "", "ja493:2.3": "", "ja493:2.4": "", "ja493:3.1": "", "ja493:3.2": "chāyayā → chādiyā (bj, sya1ed, sya2ed, pts-vp-pli1) ", "ja493:3.3": "", "ja493:3.4": "", "ja493:4.1": "Allāyate → addāyate (bj, pts-vp-pli1) ", "ja493:4.2": "vārīva → vāri ca (bj, pts-vp-pli1) ", "ja493:4.3": "", "ja493:4.4": "", "ja493:5.1": "", "ja493:5.2": "", "ja493:5.3": "", "ja493:5.4": "", "ja493:6.1": "", "ja493:6.2": "", "ja493:6.3": "", "ja493:6.4": "", "ja493:7.1": "", "ja493:7.2": "", "ja493:7.3": "", "ja493:7.4": "vidalasūpiyo → siṅgiṁ bi