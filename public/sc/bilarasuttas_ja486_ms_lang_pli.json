", "ja486:17.2": "", "ja486:17.3": "", "ja486:17.4": "sañātake → sañātakā (?) ", "ja486:18.1": "", "ja486:18.2": "mitte → mettiṁ (bj, pts-vp-pli1); mittaṁ (sya1ed, sya2ed) ", "ja486:18.3": "", "ja486:18.4": "", "ja486:19.1": ""}, "reference_text": {"ja486:0.1": "", "ja486:0.2": "", "ja486:0.3": "", "ja486:0.4": "", "ja486:1.1": "bj30.486, ms22J_2593, msdiv44, pts-vp-pli4.291", "ja486:1.2": "", "ja486:1.3": "", "ja486:1.4": "", "ja486:2.1": "dr27.371, ms22J_2594, msdiv45", "ja486:2.2": "", "ja486:2.3": "", "ja486:2.4": "", "ja486:3.1": "ms22J_2595, msdiv46, sya27.372", "ja486:3.2": "", "ja486:3.3": "", "ja486:3.4": "", "ja486:4.1": "ms22J_2596, msdiv47, ndp22.275, pts-vp-pli4.292", "ja486:4.2": "", "ja486:4.3": "", "ja486:4.4": "", "ja486:5.1": "csp1ed22.281, csp2ed22.281, ms22J_2597, msdiv48", "ja486:5.2": "", "ja486:5.3": "", "ja486:5.4": "", "ja486:6.1": "ms22J_2598, msdiv49, pts-vp-pli4.293", "ja486:6.2": "", "ja486:6.3": "", "ja486:6.4": "", "ja486:7.1": "dr27.372, ms22J_2599, msdiv50", "ja486:7.2": "", "ja486:7.3": "", "ja486:7.4": "", "ja486:8.1": "ms22J_2600, msdiv51", "ja486:8.2": "", "ja486:8.3": "", "ja486:8.4": "", "ja486:9.1": "bj30.488, ms22J_2601, msdiv52, pts-vp-pli4.294, sya27.373", "ja486:9.2": "", "ja486:9.3": "", "ja486:9.4": "", "ja486:10.1": "ms22J_2602, msdiv53, ndp22.276, vri68.216", "ja486:10.2": "", "ja486:10.3": "", "ja486:10.4": "", "ja486:11.1": "ms22J_2603, msdiv54, pts-vp-pli4.295", "ja486:11.2": "", "ja486:11.3": "", "ja486:11.4": "", "ja486:12.1": "csp1ed22.282, csp2ed22.282, dr27.373, ms22J_2604, msdiv55", "ja486:12.2": "", "ja486:12.3": "", "ja486:12.4": "", "ja486:13.1": "ms22J_2605, msdiv56, pts-vp-pli4.296", "ja486:13.2": "", "ja486:13.3": "", "ja486:13.4": "", "ja486:14.1": "ms22J_2606, msdiv57, sya27.374", "ja486:14.2": "", "ja486:14.3": "", "ja486:14.4": "", "ja486:15.1": "ms22J_2607, msdiv58", "ja486:15.2": "", "ja486:15.3": "", "ja486:15.4": "", "ja486:16.1": "ms22J_2608, msdiv59", "ja486:16.2": "", "ja486:16.3": "", "ja486: