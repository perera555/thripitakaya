{"html_text": {"kp5:0.1": "<article id='kp5'><header><ul><li class='division'>{}</li></ul>", "kp5:0.2": "<h1 class='sutta-title'>{}</h1></header>", "kp5:1.1": "<p>{}", "kp5:1.2": "{}", "kp5:1.3": "{}", "kp5:1.4": "{}</p>", "kp5:2.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "kp5:2.2": "<span class='verse-line'>{}</span>", "kp5:2.3": "<span class='verse-line'>{}</span>", "kp5:2.4": "<span class='verse-line'>{}</span></p>", "kp5:3.1": "<p><span class='verse-line'>{}</span>", "kp5:3.2": "<span class='verse-line'>{}</span>", "kp5:3.3": "<span class='verse-line'>{}</span>", "kp5:3.4": "<span class='verse-line'>{}</span></p>", "kp5:4.1": "<p><span class='verse-line'>{}</span>", "kp5:4.2": "<span class='verse-line'>{}</span>", "kp5:4.3": "<span class='verse-line'>{}</span>", "kp5:4.4": "<span class='verse-line'>{}</span></p>", "kp5:5.1": "<p><span class='verse-line'>{}</span>", "kp5:5.2": "<span class='verse-line'>{}</span>", "kp5:5.3": "<span class='verse-line'>{}</span>", "kp5:5.4": "<span class='verse-line'>{}</span></p>", "kp5:6.1": "<p><span class='verse-line'>{}</span>", "kp5:6.2": "<span class='verse-line'>{}</span>", "kp5:6.3": "<span class='verse-line'>{}</span>", "kp5:6.4": "<span class='verse-line'>{}</span></p>", "kp5:7.1": "<p><span class='verse-line'>{}</span>", "kp5:7.2": "<span class='verse-line'>{}</span>", "kp5:7.3": "<span class='verse-line'>{}</span>", "kp5:7.4": "<span class='verse-line'>{}</span></p>", "kp5:8.1": "<p><span class='verse-line'>{}</span>", "kp5:8.2": "<span class='verse-line'>{}</span>", "kp5:8.3": "<span class='verse-line'>{}</span>", "kp5:8.4": "<span class='verse-line'>{}</span></p>", "kp5:9.1": "<p><span class='verse-line'>{}</span>", "kp5:9.2": "<span class='verse-line'>{}</span>", "kp5:9.3": "<span class='verse-line'>{}</span>", "kp5:9.4": "<span class='verse-line'>{}</span></p>", "kp5:10.1": "<p><span class='verse-line'>{}</span>", "kp5:10.2": "<span class='verse-line'>{}</span>", "kp5:10.3": "<span class='verse-line'>{}</span>", "kp5:10.4": "<span class='verse-line'>{}</span></p>", "kp5:11.1": "<p><span class='verse-line'>{}</span>", "kp5:11.2": "<span class='verse-line'>{}</span>", "kp5:11.3": "<span class='verse-line'>{}</span>", "kp5:11.4": "<span class='verse-line'>{}</span></p>", "kp5:12.1": "<p><span class='verse-line'>{}</span>", "kp5:12.2": "<span class='verse-line'>{}</span>", "kp5:12.3": "<span class='verse-line'>{}</span>", "kp5:12.4": "<span class='verse-line'>{}</span></p>", "kp5:13.1": "<p><span class='verse-line'>{}</span>", "kp5:13.2": "<span class='verse-line'>{}</span>", "kp5:13.3": "<span class='verse-line'>{}</span>", "kp5:13.4": "<span class='verse-line'>{}</span></p></blockquote>", "kp5:14.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"kp5:0.1": "Khuddakapāṭha 5 ", "kp5:0.2": "Maṅgalasutta ", "kp5:1.1": "Evaṁ me sutaṁ—", "kp5:1.2": "ekaṁ samayaṁ bhagavā sāvatthiyaṁ viharati jetavane anāthapiṇḍikassa ārāme. ", "kp5:1.3": "Atha kho aññatarā devatā abhikkantāya rattiyā abhikkantavaṇṇā kevalakappaṁ jetavanaṁ obhāsetvā yena bhagavā tenupasaṅkami; upasaṅkamitvā bhagavantaṁ abhivādetvā ekamantaṁ aṭṭhāsi. ", "kp5:1.4": "Ekamantaṁ ṭhitā kho sā devatā bhagavantaṁ gāthāya ajjhabhāsi—", "kp5:2.1": "“Bahū devā manussā ca, ", "kp5:2.2": "maṅgalāni acintayuṁ; ", "kp5:2.3": "Ākaṅkhamānā sotthānaṁ, ", "kp5:2.4": "brūhi maṅgalamuttamaṁ”. ", "kp5:3.1": "“Asevanā ca bālānaṁ, ", "kp5:3.2": "paṇḍitānañca sevanā; ", "kp5:3.3": "Pūjā ca pūjaneyyānaṁ, ", "kp5:3.4": "etaṁ maṅgalamuttamaṁ. ", "kp5:4.1": "Patirūpadesavāso ca, ", "kp5:4.2": "pubbe ca katapuññatā; ", "kp5:4.3": "Attasammāpaṇidhi ca, ", "kp5:4.4": "etaṁ maṅgalamuttamaṁ. ", "kp5:5.1": "Bāhusaccañca sippañca, ", "kp5:5.2": "vinayo ca susikkhito; ", "kp5:5.3": "Subhāsitā ca yā vācā, ", "kp5:5.4": "etaṁ maṅgalamuttamaṁ. ", "kp5:6.1": "Mātāpituupaṭṭhānaṁ, ", "kp5:6.2": "puttadārassa saṅgaho; ", "kp5:6.3": "Anākulā ca kammantā, ", "kp5:6.4": "etaṁ maṅgalamuttamaṁ. ", "kp5:7.1": "Dānañca dhammacariyā ca, ", "kp5:7.2": "ñātakānañca saṅgaho; ", "kp5:7.3": "Anavajjāni kammāni, ", "kp5:7.4": "etaṁ maṅgalamuttamaṁ. ", "kp5:8.1": "Āratī viratī pāpā, ", "kp5:8.2": "majjapānā ca saṁyamo; ", "kp5:8.3": "Appamādo ca dhammesu, ", "kp5:8.4": "etaṁ maṅgalamuttamaṁ. ", "kp5:9.1": "Gāravo ca nivāto ca, ", "kp5:9.2": "santuṭṭhi ca kataññutā; ", "kp5:9.3": "Kālena dhammassavanaṁ, ", "kp5:9.4": "etaṁ maṅgalamuttamaṁ. ", "kp5:10.1": "Khantī ca sovacassatā, ", "kp5:10.2": "samaṇānañca dassanaṁ; ", "kp5:10.3": "Kālena dhammasākacchā, ", "kp5:10.4": "etaṁ maṅgalamuttamaṁ. ", "kp5:11.1": "Tapo ca brahmacariyañca, ", "kp5:11.2": "ariyasaccāna dassanaṁ; ", "kp5:11.3": "Nibbānasacchikiriyā ca, ", "kp5:11.4": "etaṁ maṅgalamuttamaṁ. ", "kp5:12.1": "Phuṭṭhassa lokadhammehi, ", "kp5:12.2": "cittaṁ yassa na kampati; ", "kp5:12.3": "Asokaṁ virajaṁ khemaṁ, ", "kp5:12.4": "etaṁ maṅgalamuttamaṁ. ", "kp5:13.1": "Etādisāni katvāna, ", "kp5:13.2": "Sabbattha maparājitā; ", "kp5:13.3": "Sabbattha sotthiṁ gacchanti, ", "kp5:13.4": "Taṁ tesaṁ maṅgalamuttaman”ti. ", "kp5:14.1": "Maṅgalasuttaṁ. "}, "reference_text": {"kp5:0.1": "", "kp5:0.2": "", "kp5:1.1": "bj24.6, cck25.3, ms18Kh_31, msdiv1, ndp20.5, vri47.4", "kp5:1.2": "", "kp5:1.3": "", "kp5:1.4": "", "kp5:2.1": "ms18Kh_32, msdiv2, pts-vp-pli3", "kp5:2.2": "", "kp5:2.3": "", "kp5:2.4": "", "kp5:3.1": "mc0.4, ms18Kh_33, msdiv3", "kp5:3.2": "", "kp5:3.3": "", "kp5:3.4": "", "kp5:4.1": "csp1ed18.4, csp2ed18.4, dr25.4, ms18Kh_34, msdiv4, sya25.4", "kp5:4.2": "", "kp5:4.3": "", "kp5:4.4": "", "kp5:5.1": "ms18Kh_35, msdiv5", "kp5:5.2": "", "kp5:5.3": "", "kp5:5.4": "", "kp5:6.1": "ms18Kh_36, msdiv6", "kp5:6.2": "", "kp5:6.3": "", "kp5:6.4": "", "kp5:7.1": "ms18Kh_37, msdiv7", "kp5:7.2": "", "kp5:7.3": "", "kp5:7.4": "", "kp5:8.1": "ms18Kh_38, msdiv8", "kp5:8.2": "", "kp5:8.3": "", "kp5:8.4": "", "kp5:9.1": "cck25.4, ms18Kh_39, msdiv9, vri47.5", "kp5:9.2": "", "kp5:9.3": "", "kp5:9.4": "", "kp5:10.1": "ms18Kh_40, msdiv10", "kp5:10.2": "", "kp5:10.3": "", "