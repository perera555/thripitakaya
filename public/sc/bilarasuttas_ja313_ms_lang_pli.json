{"html_text": {"ja313:0.1": "<article id='ja313'><header><ul><li class='division'>{}</li>", "ja313:0.2": "<li>{}</li>", "ja313:0.3": "<li>{}</li></ul>", "ja313:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja313:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja313:1.2": "<span class='verse-line'>{}</span>", "ja313:1.3": "<span class='verse-line'>{}</span>", "ja313:1.4": "<span class='verse-line'>{}</span></p>", "ja313:2.1": "<p><span class='verse-line'>{}</span>", "ja313:2.2": "<span class='verse-line'>{}</span>", "ja313:2.3": "<span class='verse-line'>{}</span>", "ja313:2.4": "<span class='verse-line'>{}</span></p>", "ja313:3.1": "<p><span class='verse-line'>{}</span>", "ja313:3.2": "<span class='verse-line'>{}</span>", "ja313:3.3": "<span class='verse-line'>{}</span>", "ja313:3.4": "<span class='verse-line'>{}</span></p>", "ja313:4.1": "<p><span class='verse-line'>{}</span>", "ja313:4.2": "<span class='verse-line'>{}</span>", "ja313:4.3": "<span class='verse-line'>{}</span>", "ja313:4.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja313:5.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja313:0.1": "Jātaka ", "ja313:0.2": "Catukkanipāta ", "ja313:0.3": "Pucimandavagga ", "ja313:0.4": "3. Khantīvādījātaka ", "ja313:1.1": "“Yo te hatthe ca pāde ca, ", "ja313:1.2": "kaṇṇanāsañca chedayi; ", "ja313:1.3": "Tassa kujjha mahāvīra, ", "ja313:1.4": "mā raṭṭhaṁ vinasā idaṁ”. ", "ja313:2.1": "“Yo me hatthe ca pāde ca, ", "ja313:2.2": "kaṇṇanāsañca chedayi; ", "ja313:2.3": "Ciraṁ jīvatu so rājā, ", "ja313:2.4": "na hi kujjhanti mādisā”. ", "ja313:3.1": "Ahū atītamaddhānaṁ, ", "ja313:3.2": "samaṇo khantidīpano; ", "ja313:3.3": "Taṁ khantiyāyeva ṭhitaṁ, ", "ja313:3.4": "kāsirājā achedayi. ", "ja313:4.1": "Tassa kammapharusassa, ", "ja313:4.2": "vipāko kaṭuko ahu; ", "ja313:4.3": "Yaṁ kāsirājā vedesi, ", "ja313:4.4": "nirayamhi samappitoti. ", "ja313:5.1": "Khantīvādījātakaṁ tatiyaṁ. "}, "variant_text": {"ja313:0.1": "", "ja313:0.2": "", "ja313:0.3": "", "ja313:0.4": "", "ja313:1.1": "", "ja313:1.2": "", "ja313:1.3": "", "ja313:1.4": "vinasā → vinassā (bj); vinassa (sya1ed, sya2ed, mr) ", "ja313:2.1": "", "ja313:2.2": "", "ja313:2.3": "", "ja313:2.4": "", "ja313:3.1": "Ahū atītamaddhānaṁ → ahu atītamaddhāne (sya1ed, sya2ed, pts-vp-pli1, mr) ", "ja313:3.2": "", "ja313:3.3": "", "ja313:3.4": "", "ja313:4.1": "kammapharusassa → kammassa pharusassa (bj, pts-vp-pli1) ", "ja313:4.2": "", "ja313:4.3": "", "ja313:4.4": "", "ja313:5.1": "Khantīvādījātakaṁ → khantivādijātakaṁ (bj, sya1ed, sya2ed, pts-vp-pli1) "}, "reference_text": {"ja313:0.1": "", "ja313:0.2": "", "ja313:0.3": "", "ja313:0.4": "", "ja313:1.1": "ms22J_945, msdiv49, pts-vp-pli3.42", "ja313:1.2": "", "ja313:1.3": "", "ja313:1.4": "", "ja313:2.1": "ms22J_946, msdiv50", "ja313:2.2": "", "ja313:2.3": "", "ja313:2.4": "", "ja313:3.1": "ms22J_947, msdiv51, pts-vp-pli3.43", "ja313:3.2": "", "ja313:3.3": "", "ja313:3.4": "", "ja313:4.1": "bj30.174, csp1ed22.100, csp2ed22.100, ms22J_948, msdiv52", "ja313:4.2": "", "ja313:4.3": "", "ja313:4.4": "", "ja313:5.1": "ms22J_949"}, "keys_order": ["ja313:0.1", "ja313:0.2", "ja313:0.3", "ja313:0.4", "ja313:1.1", "ja313:1.2", "ja313:1.3", "ja313:1.4", "ja313:2.1", "ja313:2.2", "ja313:2.3", "ja313:2.4", "ja313:3.1", "ja313:3.2", "ja313:3.3", "ja313:3.4", "ja313:4.1", "ja313:4.2", "ja313:4.3", "ja313:4.4", "ja313:5.1"]}