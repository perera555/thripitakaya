[{"acronym": "Ja 142", "alt_acronym": null, "volpages": "PTS 1.490", "alt_volpages": null, "uid": "ja142", "blurb": "“Thy tightening grip.”—This story was told by the Master while at the Bamboo-grove, about Devadatta’s going about to kill him. For, hearing the Brethren talking together as to this in the Hall of Truth, the Master said that, as Devadatta acted now, so he acted in times gone by, yet failed—to his own grievous hurt—of his wicked purpose. And so saying, he told this story of the past.", "difficulty": null, "original_title": "Siṅgālajātaka", "root_lang": "pli", "root_lang_name": "Pāli", "type": "leaf", "translated_title": "Sigala Jātaka", "translations": [{"lang": "pli", "lang_name": "Pāli", "is_root": true, "author": "Mahāsaṅgīti Tipiṭaka Buddhavasse 2500", "author_short": "ms", "author_uid": "ms", "publication_date": null, "id": "ja142_root-pli-ms", "segmented": true, "title": null, "volpage": null, "has_comment": false}, {"lang": "de", "lang_name": "Deutsch", "is_root": false, "author": "Dr. Julius Dutoit", "author_short": "Dutoit", "author_uid": "dutoit", "publication_date": "2007", "id": "de_ja142_dutoit", "segmented": false, "volpage": null, "has_comment": false}, {"author": "Robert Chalmers", "author_short": "Chalmers", "author_uid": "chalmers", "has_comment": false, "id": "en_ja142_chalmers", "is_root": false, "lang": "en", "lang_name": "English", "publication_date": "1895", "segmented": false, "volpage": null, "title": "Sigala Jātaka"}, {"lang": "jpn", "lang_name": "日本語", "is_root": false, "author": "関西パーリ語実習会", "author_short": "関西パーリ語実習会", "author_uid": "kansai", "publication_date": "2023", "id": "jpn_ja142_kansai", "segmented": false, "volpage": null, "has_comment": false}, {"lang": "si", "lang_name": "සිංහල", "is_root": false, "author": "A.P. de Zoysa", "author_short": "Zoysa", "author_uid": "zoysa", "publication_date": null, "id": "si_ja142_zoysa", "segmented": false, "volpage": null, "has_comment": false}], "parallel_count": 0, "biblio": nul