{"html_text": {"ja15:0.1": "<article id='ja15'><header><ul><li class='division'>{}</li>", "ja15:0.2": "<li>{}</li>", "ja15:0.3": "<li>{}</li></ul>", "ja15:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja15:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja15:1.2": "<span class='verse-line'>{}</span>", "ja15:1.3": "<span class='verse-line'>{}</span>", "ja15:1.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja15:2.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja15:0.1": "Jātaka ", "ja15:0.2": "Ekakanipāta ", "ja15:0.3": "Sīlavagga ", "ja15:0.4": "5. Kharādiyajātaka ", "ja15:1.1": "“Aṭṭhakkhuraṁ kharādiye, ", "ja15:1.2": "migaṁ vaṅkātivaṅkinaṁ; ", "ja15:1.3": "Sattahi kālātikkantaṁ, ", "ja15:1.4": "na naṁ ovaditussahe”ti. ", "ja15:2.1": "Kharādiyajātakaṁ pañcamaṁ. "}, "variant_text": {"ja15:0.1": "", "ja15:0.2": "", "ja15:0.3": "", "ja15:0.4": "", "ja15:1.1": "", "ja15:1.2": "", "ja15:1.3": "Sattahi kālātikkantaṁ → sattahi kalāha'tikkantaṁ (bj); sattakāleha'tikkantaṁ (sya1ed, sya2ed); sattahi kālāha'tikkantaṁ (pts-vp-pli1) ", "ja15:1.4": "", "ja15:2.1": ""}, "reference_text": {"ja15:0.1": "", "ja15:0.2": "", "ja15:0.3": "", "ja15:0.4": "", "ja15:1.1": "ms22J_32, msdiv15, pts-vp-pli1.160, sya27.6", "ja15:1.2": "", "ja15:1.3": "", "ja15:1.4": "", "ja15:2.1": "ms22J_33"}, "keys_order": ["ja15:0.1", "ja15:0.2", "ja15:0.3", "ja15:0.4", "ja15:1.1", "ja15:1.2", "ja15:1.3", "ja15:1.4", "ja15:2.1"]}