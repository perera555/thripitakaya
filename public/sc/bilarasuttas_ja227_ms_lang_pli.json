{"html_text": {"ja227:0.1": "<article id='ja227'><header><ul><li class='division'>{}</li>", "ja227:0.2": "<li>{}</li>", "ja227:0.3": "<li>{}</li></ul>", "ja227:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja227:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja227:1.2": "<span class='verse-line'>{}</span>", "ja227:1.3": "<span class='verse-line'>{}</span>", "ja227:1.4": "<span class='verse-line'>{}</span>", "ja227:1.5": "<span class='verse-line'>{}</span>", "ja227:1.6": "<span class='verse-line'>{}</span></p>", "ja227:2.1": "<p><span class='verse-line'>{}</span>", "ja227:2.2": "<span class='verse-line'>{}</span>", "ja227:2.3": "<span class='verse-line'>{}</span>", "ja227:2.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja227:3.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja227:0.1": "Jātaka ", "ja227:0.2": "Dukanipāta ", "ja227:0.3": "Kāsāvavagga ", "ja227:0.4": "7. Gūthapāṇajātaka ", "ja227:1.1": "“Sūro sūrena saṅgamma, ", "ja227:1.2": "vikkantena pahārinā; ", "ja227:1.3": "Ehi nāga nivattassu, ", "ja227:1.4": "kiṁ nu bhīto palāyasi; ", "ja227:1.5": "Passantu aṅgamagadhā, ", "ja227:1.6": "mama tuyhañca vikkamaṁ”. ", "ja227:2.1": "“Na taṁ pādā vadhissāmi, ", "ja227:2.2": "na dantehi na soṇḍiyā; ", "ja227:2.3": "Mīḷhena taṁ vadhissāmi, ", "ja227:2.4": "pūti haññatu pūtinā”ti. ", "ja227:3.1": "Gūthapāṇajātakaṁ sattamaṁ. "}, "variant_text": {"ja227:0.1": "", "ja227:0.2": "", "ja227:0.3": "", "ja227:0.4": "", "ja227:1.1": "", "ja227:1.2": "", "ja227:1.3": "", "ja227:1.4": "", "ja227:1.5": "", "ja227:1.6": "", "ja227:2.1": "", "ja227:2.2": "", "ja227:2.3": "", "ja227:2.4": "", "ja227:3.1": "Gūthapāṇajātakaṁ → gūthapāṇakajātakaṁ (bj, sya1ed, sya2ed) "}, "reference_text": {"ja227:0.1": "", "ja227:0.2": "", "ja227:0.3": "", "ja227:0.4": "", "ja227:1.1": "csp1ed22.62, csp2ed22.62, ms22J_588, msdiv153, pts-vp-pli2.211, vri68.56", "ja227:1.2": "", "ja227:1.3": "", "ja227:1.4": "", "ja227:1.5": "", "ja227:1.6": "", "ja