{"html_text": {"ja174:0.1": "<article id='ja174'><header><ul><li class='division'>{}</li>", "ja174:0.2": "<li>{}</li>", "ja174:0.3": "<li>{}</li></ul>", "ja174:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja174:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja174:1.2": "<span class='verse-line'>{}</span>", "ja174:1.3": "<span class='verse-line'>{}</span>", "ja174:1.4": "<span class='verse-line'>{}</span></p>", "ja174:2.1": "<p><span class='verse-line'>{}</span>", "ja174:2.2": "<span class='verse-line'>{}</span>", "ja174:2.3": "<span class='verse-line'>{}</span>", "ja174:2.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja174:3.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja174:0.1": "Jātaka ", "ja174:0.2": "Dukanipāta ", "ja174:0.3": "Kalyāṇavagga ", "ja174:0.4": "4. Dubbhiyamakkaṭajātaka ", "ja174:1.1": "“Adamha te vāri pahūtarūpaṁ, ", "ja174:1.2": "Ghammābhitattassa pipāsitassa; ", "ja174:1.3": "So dāni pitvāna kiriṅkarosi, ", "ja174:1.4": "Asaṅgamo pāpajanena seyyo”. ", "ja174:2.1": "“Ko te suto vā diṭṭho vā, ", "ja174:2.2": "sīlavā nāma makkaṭo; ", "ja174:2.3": "Idāni kho taṁ ohacchaṁ, ", "ja174:2.4": "esā asmāka dhammatā”ti. ", "ja174:3.1": "Dubbhiyamakkaṭajātakaṁ catutthaṁ. "}, "variant_text": {"ja174:0.1": "", "ja174:0.2": "", "ja174:0.3": "", "ja174:0.4": "", "ja174:1.1": "", "ja174:1.2": "", "ja174:1.3": "pitvāna → pītvāna (bj, pts-vp-pli1) | kiriṅkarosi → kikiṁ karosi (bj, sya1ed, sya2ed, pts-vp-pli1) ", "ja174:1.4": "", "ja174:2.1": "", "ja174:2.2": "", "ja174:2.3": "ohacchaṁ → ūhacca (bj, pts-vp-pli1); ohaccaṁ (sya1ed, sya2ed); uhajjaṁ (mr) ", "ja174:2.4": "", "ja174:3.1": "Dubbhiyamakkaṭajātakaṁ → dūbhiyamakkaṭajātakaṁ (pts-vp-pli1) "}, "reference_text": {"ja174:0.1": "", "ja174:0.2": "", "ja174:0.3": "", "ja174:0.4": "", "ja174:1.1": "ms22J_415, msdiv47, pts-vp-pli2.71", "ja174:1.2": "", "ja174:1.3": "", "ja174:1.4": "", "ja174:2.1": "ms22J_416, msdiv48, ndp22.42", "ja174:2.2": "", "ja174:2.3": "", "ja174:2.4": "", "ja174:3.1": "ms22J_417"}, "keys_order": ["ja174:0.1", "ja174:0.2", "ja174:0.3", "ja174:0.4", "ja174:1.1", "ja174:1.2", "ja174:1.3", "ja174:1.4", "ja174:2.1", "ja174:2.2", "ja174:2.3", "ja174:2.4", "ja174:3.1"]}