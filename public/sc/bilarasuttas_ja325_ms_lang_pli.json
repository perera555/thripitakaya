{"html_text": {"ja325:0.1": "<article id='ja325'><header><ul><li class='division'>{}</li>", "ja325:0.2": "<li>{}</li>", "ja325:0.3": "<li>{}</li></ul>", "ja325:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja325:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja325:1.2": "<span class='verse-line'>{}</span>", "ja325:1.3": "<span class='verse-line'>{}</span>", "ja325:1.4": "<span class='verse-line'>{}</span></p>", "ja325:2.1": "<p><span class='verse-line'>{}</span>", "ja325:2.2": "<span class='verse-line'>{}</span>", "ja325:2.3": "<span class='verse-line'>{}</span>", "ja325:2.4": "<span class='verse-line'>{}</span></p>", "ja325:3.1": "<p><span class='verse-line'>{}</span>", "ja325:3.2": "<span class='verse-line'>{}</span>", "ja325:3.3": "<span class='verse-line'>{}</span>", "ja325:3.4": "<span class='verse-line'>{}</span></p>", "ja325:4.1": "<p><span class='verse-line'>{}</span>", "ja325:4.2": "<span class='verse-line'>{}</span>", "ja325:4.3": "<span class='verse-line'>{}</span>", "ja325:4.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja325:5.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja325:0.1": "Jātaka ", "ja325:0.2": "Catukkanipāta ", "ja325:0.3": "Kuṭidūsakavagga ", "ja325:0.4": "5. Godharājajātaka ", "ja325:1.1": "“Samaṇaṁ taṁ maññamāno, ", "ja325:1.2": "upagacchimasaññataṁ; ", "ja325:1.3": "So maṁ daṇḍena pāhāsi, ", "ja325:1.4": "yathā assamaṇo tathā”. ", "ja325:2.1": "“Kiṁ te jaṭāhi dummedha, ", "ja325:2.2": "kiṁ te ajinasāṭiyā; ", "ja325:2.3": "Abbhantaraṁ te gahanaṁ, ", "ja325:2.4": "bāhiraṁ parimajjasi”. ", "ja325:3.1": "“Ehi godha nivattassu, ", "ja325:3.2": "bhuñja sālīnamodanaṁ; ", "ja325:3.3": "Telaṁ loṇañca me atthi, ", "ja325:3.4": "pahūtaṁ mayha pipphali. ", "ja325:4.1": "Esa bhiyyo pavekkhāmi, ", "ja325:4.2": "vammikaṁ sataporisaṁ; ", "ja325:4.3": "Telaṁ loṇañca kittesi, ", "ja325:4.4": "ahitaṁ mayha pipphalī”ti. ", "ja325:5.1": "Godharājajātakaṁ pañcamaṁ. "}, "variant_text": {"ja325:0.1": "", "ja325:0.2": "", "ja325:0.3": "", "ja325:0.4": "", "ja325:1.1": "", "ja325:1.2": "", "ja325:1.3": "", "ja325:1.4": "", "ja325:2.1": "", "ja325:2.2": "", "ja325:2.3": "", "ja325:2.4": "", "ja325:3.1": "", "ja325:3.2": "", "ja325:3.3": "", "ja325:3.4": "", "ja325:4.1": "", "ja325:4.2": "", "ja325:4.3": "kittesi → kintesi (sya1ed, sya2ed, pts-vp-pli1) ", "ja325:4.4": "", "ja325:5.1": "Godharājajātakaṁ → godhajātakaṁ (bj, sya1ed, sya2ed, pts-vp-pli1) "}, "reference_text": {"ja325:0.1": "", "ja325:0.2": "", "ja325:0.3": "", "ja325:0.4": "", "ja325:1.1": "dr27.145, ms22J_1007, msdiv97, pts-vp-pli3.85, sya27.145", "ja325:1.2": "", "ja325:1.3": "", "ja325:1.4": "", "ja325:2.1": "csp1ed22.106, csp2ed22.106, ms22J_1008, msdiv98", "ja325:2.2": "", "ja325:2.3": "", "ja325:2.4": "", "ja325:3.1": "ms22J_1009, msdiv99", "ja325:3.2": "", "ja325:3.3": "", "ja325:3.4": "", "ja325:4.1": "ms22J_1010, msdiv100, ndp22.98, pts-vp-pli3.86", "ja325:4.2": "", "ja325:4.3": "", "ja325:4.4": "", "ja325:5.1": "ms22J_1011"}, "keys_order": ["ja325:0.1", "ja325:0.2", "ja325:0.3", "ja325:0.4", "ja325:1.1", "ja325:1.2", "ja325:1.3", "ja325:1.4", "ja325:2.1", "ja325:2.2", "ja325:2.3", "ja325:2.4", "ja325:3.1", "ja325:3.2", "ja325:3.3", "ja325:3.4", "ja325:4.1", "ja325:4.2", "ja325:4.3", "ja325:4.4", "ja325:5.1"]}