{"html_text": {"ja412:0.1": "<article id='ja412'><header><ul><li class='division'>{}</li>", "ja412:0.2": "<li>{}</li>", "ja412:0.3": "<li>{}</li></ul>", "ja412:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja412:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja412:1.2": "<span class='verse-line'>{}</span>", "ja412:1.3": "<span class='verse-line'>{}</span>", "ja412:1.4": "<span class='verse-line'>{}</span></p>", "ja412:2.1": "<p><span class='verse-line'>{}</span>", "ja412:2.2": "<span class='verse-line'>{}</span>", "ja412:2.3": "<span class='verse-line'>{}</span>", "ja412:2.4": "<span class='verse-line'>{}</span></p>", "ja412:3.1": "<p><span class='verse-line'>{}</span>", "ja412:3.2": "<span class='verse-line'>{}</span>", "ja412:3.3": "<span class='verse-line'>{}</span>", "ja412:3.4": "<span class='verse-line'>{}</span>", "ja412:3.5": "<span class='verse-line'>{}</span>", "ja412:3.6": "<span class='verse-line'>{}</span></p>", "ja412:4.1": "<p><span class='verse-line'>{}</span>", "ja412:4.2": "<span class='verse-line'>{}</span>", "ja412:4.3": "<span class='verse-line'>{}</span>", "ja412:4.4": "<span class='verse-line'>{}</span></p>", "ja412:5.1": "<p><span class='verse-line'>{}</span>", "ja412:5.2": "<span class='verse-line'>{}</span>", "ja412:5.3": "<span class='verse-line'>{}</span>", "ja412:5.4": "<span class='verse-line'>{}</span></p>", "ja412:6.1": "<p><span class='verse-line'>{}</span>", "ja412:6.2": "<span class='verse-line'>{}</span>", "ja412:6.3": "<span class='verse-line'>{}</span>", "ja412:6.4": "<span class='verse-line'>{}</span></p>", "ja412:7.1": "<p><span class='verse-line'>{}</span>", "ja412:7.2": "<span class='verse-line'>{}</span>", "ja412:7.3": "<span class='verse-line'>{}</span>", "ja412:7.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja412:8.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja412:0.1": "Jātaka ", "ja412:0.2": "Sattakanipāta ", "ja412:0.3": "Gandhāravagga ", "ja412:0.4": "7. Koṭasimbalijātaka ", "ja412:1.1": "“Ahaṁ dasasataṁbyāmaṁ, ", "ja412:1.2": "uragamādāya āgato; ", "ja412:1.3": "Tañca mañca mahākāyaṁ, ", "ja412:1.4": "dhārayaṁ nappavedhasi. ", "ja412:2.1": "Athimaṁ khuddakaṁ pakkhiṁ, ", "ja412:2.2": "Appamaṁsataraṁ mayā; ", "ja412:2.3": "Dhārayaṁ byathasi bhītā, ", "ja412:2.4": "Kamatthaṁ koṭasimbali”. ", "ja412:3.1": "“Maṁsabhakkho tuvaṁ rāja, ", "ja412:3.2": "phalabhakkho ayaṁ dijo; ", "ja412:3.3": "Ayaṁ nigrodhabījāni, ", "ja412:3.4": "pilakkhudumbarāni ca; ", "ja412:3.5": "Assatthāni ca bhakkhitvā, ", "ja412:3.6": "khandhe me ohadissati. ", "ja412:4.1": "Te rukkhā saṁvirūhanti, ", "ja412:4.2": "mama passe nivātajā; ", "ja412:4.3": "Te maṁ pariyonandhissanti, ", "ja412:4.4": "arukkhaṁ maṁ karissare. ", "ja412:5.1": "Santi aññepi rukkhā se, ", "ja412:5.2": "mūlino khandhino dumā; ", "ja412:5.3": "Iminā sakuṇajātena, ", "ja412:5.4": "bījamāharitā hatā. ", "ja412:6.1": "Ajjhārūhābhivaḍḍhanti, ", "ja412:6.2": "brahantampi vanappatiṁ; ", "ja412:6.3": "Tasmā rāja pavedhāmi, ", "ja412:6.4": "sampassaṁnāgataṁ bhayaṁ”. ", "ja412:7.1": "“Saṅkeyya saṅkitabbāni, ", "ja412:7.2": "rakkheyyānāgataṁ bhayaṁ; ", "ja412:7.3": "Anāgatabhayā dhīro, ", "ja412:7.4": "ubho loke avekkhatī”ti. ", "ja412:8.1": "Koṭasimbalijātakaṁ sattamaṁ. "}, "variant_text": {"ja412:0.1": "", "ja412:0.2": "", "ja412:0.3": "", "ja412:0.4": "", "ja412:1.1": "", "ja412:1.2": "", "ja412:1.3": "", "ja412:1.4": "nappavedhasi → na pavedhayi (mr) ", "ja412:2.1": "", "ja412:2.2": "", "ja412:2.3": "byathasi → vyādhase (bj); vyadhase (pts-vp-pli1); byādhasi (mr) | bhītā → bhīto (bj, sya1ed, sya2ed, pts-vp-pli1) ", "ja412:2.4": "koṭasimbali → koṭisimbali (bj, pts-vp-pli1) ", "ja412:3.1": "", "ja412:3.2": "", "ja412:3.3": "", "ja412:3.4": "", "ja412:3.5": "", "ja412:3.6": "", "ja412:4.1": "", "ja412:4.2": "", "ja412:4.3": "", "ja412:4.4": "", "ja412:5.1": "", "ja412:5.2": "", "ja412:5.3": "", "ja412:5.4": "", "ja412:6.1": "Ajjhārūhābhivaḍḍhanti → ajjhārūḷhābhivaḍḍhanti (bj, pts-vp-pli1); ajjhārūhā hi vaḍḍhanti (sya1ed, sya2ed) ", "ja412:6.2": "", "ja412:6.3": "", "ja412:6.4": "", "ja412:7.1": "", "ja412:7.2": "", "ja412:7.3": "", "ja412:7.4": "", "ja412:8.1": ""}, "reference_text": {"ja412:0.1": "", "ja412:0.2": "", "ja412:0.3": "", "ja412:0.4": "", "ja412:1.1": "bj30.292, ms22J_1623, msdiv121, pts-vp-pli3.398", "ja412:1.2": "", "ja412:1.3": "", "ja412:1.4": "", "ja412:2.1": "ms22J_1624, msdiv122, vri68.140", "ja412:2.2": "", "ja412:2.3": "", "ja412:2.4": "", "ja412:3.1": "ms22J_1625, msdiv123, ndp22.162", "ja412:3.2": "", "ja412:3.3": "", "ja412:3.4": "", "ja412:3.5": "", "ja412:3.6": "", "ja412:4.1": "ms22J_1626, msdiv124", "ja412:4.2": "", "ja412:4.3": "", "ja412:4.4": "", "ja412:5.1": "ms22J_1627, msdiv125, pts-vp-pli3.399", "ja412:5.2": "", "ja412:5.3": "", "ja412:5.4": "", "ja412:6.1": "ms22J_1628, msdiv126", "ja412:6.2": "", "ja412:6.3": "", "ja412:6.4": "", "ja412:7.1": "dr27.231, ms22J_1629, msdiv127, sya27.232", "ja412:7.2": "", "ja412:7.3": "", "ja412:7.4": "", "ja412:8.1": "ms22J_1630"}, "keys_order": ["ja412:0.1", "ja412:0.2", "ja412:0.3", "ja412:0.4", "ja412:1.1", "ja412:1.2", "ja412:1.3", "ja412:1.4", "ja412:2.1", "ja412:2.2", "ja412:2.3", "ja412:2.4", "ja412:3.1", "ja412:3.2", "ja412:3.3", "ja412:3.4", "ja412:3.5", "ja412:3.6", "ja412:4.1", "ja412:4.2", "ja412:4.3", "ja412:4.4", "ja412:5.1", "ja412:5.2", "ja412:5.3", "ja412:5.4", "ja412:6.1", "ja412:6.2", "ja412:6.3", "ja412:6.4", "ja412:7.1", "ja412:7.2", "ja412:7.3", "ja412:7.4", "ja412:8.1"]}