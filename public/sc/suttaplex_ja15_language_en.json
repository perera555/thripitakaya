[{"acronym": "Ja 15", "alt_acronym": null, "volpages": "PTS 1.160", "alt_volpages": null, "uid": "ja15", "blurb": "“For when a deer.”—This story was told by the Master while at Jetavana about an unruly Brother. Tradition says that this Brother was unruly and would not heed admonition. Accordingly, the Master asked him, saying, “Is it true, as they say, that you are unruly and will not heed admonition?”", "difficulty": null, "original_title": "Kharādiyajātaka", "root_lang": "pli", "root_lang_name": "Pāli", "type": "leaf", "translated_title": "With Kharādiya ", "translations": [{"lang": "pli", "lang_name": "Pāli", "is_root": true, "author": "Mahāsaṅgīti Tipiṭaka Buddhavasse 2500", "author_short": "ms", "author_uid": "ms", "publication_date": null, "id": "ja15_root-pli-ms", "segmented": true, "title": null, "volpage": null, "has_comment": false}, {"lang": "de", "lang_name": "Deutsch", "is_root": false, "author": "Sabbamitta", "author_short": "sabbamitta", "author_uid": "sabbamitta", "publication_date": null, "id": "ja15_translation-de-sabbamitta", "segmented": true, "title": "Nimm den Esel an ", "volpage": null, "has_comment": true}, {"lang": "de", "lang_name": "Deutsch", "is_root": false, "author": "Dr. Julius Dutoit", "author_short": "Dutoit", "author_uid": "dutoit", "publication_date": "2007", "id": "de_ja15_dutoit", "segmented": false, "volpage": null, "has_comment": false}, {"lang": "en", "lang_name": "English", "is_root": false, "author": "Bhikkhu Sujato", "author_short": "sujato", "author_uid": "sujato", "publication_date": null, "id": "ja15_translation-en-sujato", "segmented": true, "title": "With Kharādiya ", "volpage": null, "has_comment": true}, {"author": "Robert Chalmers", "author_short": "Chalmers", "author_uid": "chalmers", "has_comment": false, "id": "en_ja15_chalmers", "is_root": false, "lang": "en", "lang_name": "English", "publication_date": "1895", "segmented": false, "volpage": null, "title": "Kharadiya Jātaka"}, {"lang": "it", "lang_name": "Italia