", "ja382:17.2": "<span class='verse-line'>{}</span>", "ja382:17.3": "<span class='verse-line'>{}</span>", "ja382:17.4": "<span class='verse-line'>{}</span>", "ja382:17.5": "<span class='verse-line'>{}</span>", "ja382:17.6": "<span class='verse-line'>{}</span></p>", "ja382:18.1": "<p><span class='verse-line'>{}</span>", "ja382:18.2": "<span class='verse-line'>{}</span>", "ja382:18.3": "<span class='verse-line'>{}</span>", "ja382:18.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja382:19.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja382:0.1": "Jātaka ", "ja382:0.2": "Chakkanipāta ", "ja382:0.3": "Avāriyavagga ", "ja382:0.4": "7. Sirikāḷakaṇṇijātaka ", "ja382:1.1": "“Kā nu kāḷena vaṇṇena, ", "ja382:1.2": "na cāpi piyadassanā; ", "ja382:1.3": "Kā vā tvaṁ kassa vā dhītā, ", "ja382:1.4": "kathaṁ jānemu taṁ mayaṁ”. ", "ja382:2.1": "“Mahārājassahaṁ dhītā, ", "ja382:2.2": "virūpakkhassa caṇḍiyā; ", "ja382:2.3": "Ahaṁ kāḷī alakkhikā, ", "ja382:2.4": "kāḷakaṇṇīti maṁ vidū; ", "ja382:2.5": "Okāsaṁ yācito dehi, ", "ja382:2.6": "vasemu tava santike”. ", "ja382:3.1": "“Kiṁsīle kiṁsamācāre, ", "ja382:3.2": "Purise nivisase tuvaṁ; ", "ja382:3.3": "Puṭṭhā me kāḷi akkhāhi, ", "ja382:3.4": "Kathaṁ jānemu taṁ mayaṁ”. ", "ja382:4.1": "“Makkhī paḷāsī sārambhī, ", "ja382:4.2": "issukī maccharī saṭho; ", "ja382:4.3": "So mayhaṁ puriso kanto, ", "ja382:4.4": "laddhaṁ yassa vinassati. ", "ja382:5.1": "Kodhano upanāhī ca, ", "ja382:5.2": "pisuṇo ca vibhedako; ", "ja382:5.3": "Kaṇḍakavāco pharuso, ", "ja382:5.4": "so me kantataro tato. ", "ja382:6.1": "Ajja suveti puriso, ", "ja382:6.2": "sadatthaṁ nāvabujjhati; ", "ja382:6.3": "Ovajjamāno kuppati, ", "ja382:6.4": "seyyaṁ so atimaññati. ", "ja382:7.1": "Davappaluddho puriso, ", "ja382:7.2": "sabbamittehi dhaṁsati; ", "ja382:7.3": "So mayhaṁ puriso kanto, ", "ja382:7.4": "tasmiṁ homi anāmayā”. ", "ja382:8.1": "“Apehi etto tvaṁ kāḷi, ", "ja382:8.2": "netaṁ amhesu vijjati; ", "ja382:8.3": "Aññaṁ janapadaṁ gaccha, ", "ja382:8.4": "nigame rājadhāniyo”. ", "ja382:9.1": "“Ahampi kho taṁ jānāmi, ", "ja382:9.2": "netaṁ tumhesu vijjati; ", "ja382:9.3": "Santi loke alakkhikā, ", "ja382:9.4": "saṅgharanti bahuṁ dhanaṁ; ", "ja382:9.5": "Ahaṁ devo ca me bhātā, ", "ja382:9.6": "ubho naṁ vidhamāmase”. ", "ja382:10.1": "“Kā nu dibbena vaṇṇena, ", "ja382:10.2": "pathabyā supatiṭṭhitā; ", "ja382:10.3": "Kā vā tvaṁ kassa vā dhītā, ", "ja382:10.4": "kathaṁ jānemu taṁ mayaṁ”. ", "ja382:11.1": "“Mahārājassahaṁ dhītā, ", "ja382:11.2": "dhataraṭṭhassa sirīmato; ", "ja382:11.3": "Ahaṁ sirī ca lakkhī ca, ", "ja382:11.4": "bhūripaññāti maṁ vidū; ", "ja382:11.5": "Okāsaṁ yācito dehi, ", "ja382:11.6": "vasemu tava santike”. ", "ja382:12.1": "“Kiṁsīle kiṁsamācāre, ", "ja382:12.2": "Purise nivisase tuvaṁ; ", "ja382:12.3": "Puṭṭhā me lakkhi akkhāhi, ", "ja382:12.4": "Kathaṁ jānemu taṁ mayaṁ”. ", "ja382:13.1": "“Yo cāpi sīte atha vāpi uṇhe, ", "ja382:13.2": "Vātātape ḍaṁsasarīsape ca; ", "ja382:13.3": "Khudhaṁ pipāsaṁ abhibhuyya sabbaṁ, ", "ja382:13.4": "Rattindivaṁ yo satataṁ niyutto. ", "ja382:14.1": "Kālāgatañca na hāpeti atthaṁ, ", "ja382:14.2": "So me manāpo nivise ca tamhi; ", "ja382:14.3": "Akkodhano mittavā cāgavā ca, ", "ja382:14.4": "Sīlūpapanno asaṭhojubhūto. ", "ja382:15.1": "Saṅgāhako sakhilo saṇhavāco, ", "ja382:15.2": "Mahattapattopi nivātavutti; ", "ja382:15.3": "Tasmiṁhaṁ pose vipulā bhavāmi, ", "ja382:15.4": "Ūmi samuddassa yathāpi vaṇṇaṁ. ", "ja382:16.1": "Yo cāpi mitte atha vā amitte, ", "ja382:16.2": "Seṭṭhe sarikkhe atha vāpi hīne; ", "ja382:16.3": "Atthaṁ carantaṁ atha vā anatthaṁ, ", "ja382:16.4": "Āvī raho saṅgahameva vatte. ", "ja382:17.1": "Vācaṁ na vajjā pharusaṁ kadāci, ", "ja382:17.2": "Matassa jīvassa ca tassa homi; ", "ja382:17.3": "Etesaṁ yo aññataraṁ labhitvā, ", "ja382:17.4": "Kantā sirī majjati appapañño; ", "ja382:17.5": "Taṁ dittarūpaṁ visamaṁ carantaṁ, ", "ja382:17.6": "Karīsaṭhānaṁva vivajjayāmi. ", "ja382:18.1": "Attanā kurute lakkhiṁ, ", "ja382:18.2": "alakkhiṁ kurutattanā; ", "ja382:18.3": "Na hi lakkhiṁ alakkhiṁ vā, ", "ja382:18.4": "añño aññassa kārako”ti. ", "ja382:19.1": "Sirikāḷakaṇṇijātakaṁ sattamaṁ. "}, "variant_text": {"ja382:0.1": "", "ja382:0.2": "", "ja382:0.3": "", "ja382:0.4": "", "ja382:1.1": "", "ja382:1.2": "na cāpi → na cāsi (bj) ", "ja382:1.3": "", "ja382:1.4": "", "ja382:2.1": "", "ja382:2.2": "", "ja382:2.3": "", "ja382:2.4": "", "ja382:2.5": "", "ja382:2.6": "", "ja382:3.1": "", "ja382:3.2": "", "ja382:3.3": "", "ja382:3.4": "Kathaṁ → yathā (bj, pts-vp-pli1) ", "ja382:4.1": "", "ja382:4.2": "", "ja382:4.3": "", "ja382:4.4": "", "ja382:5.1": "", "ja382:5.2": "", "ja382:5.3": "Kaṇḍakavāco → aṇḍakavāco (si, pts-vp-pli1); kaṇṭakavāco (sya1ed, sya2ed) ", "ja382:5.4": "", "ja382:6.1": "", "ja382:6.2": "", "ja382:6.3": "", "ja382:6.4": "", "ja382:7.1": "Davappaluddho → davappaladdho (pts-vp-pli1); devappaluddho (mr) ", "ja382:7.2": "", "ja382:7.3": "", "ja382:7.4": "", "ja382:8.1": "", "ja382:8.2": "", "ja382:8.3": "", "ja382:8.4": "", "ja382:9.1": "", "ja382:9.2": "", "ja382:9.3": "", "ja382:9.4": "", "ja382:9.5": "", "ja382:9.6": "", "ja382:10.1": "", "ja382:10.2": "", "ja382:10.3": "", "ja382:10.4": "", "ja382:11.1": "", "ja382:11.2": "dhataraṭṭhassa sirīmato → dhataraṭṭhasirīmato (sya1ed, sya2ed, mr) ", "ja382:11.3": "", "ja382:11.4": "", "ja382:11.5": "", "ja382:11.6": "", "ja382:12.1": "", "ja382:12.2": "", "ja382:12.3": "", "ja382:12.4": "Kathaṁ → yathā (bj, sya1ed, sya2ed, pts-vp-pli1) ", "ja382:13.1": "", "ja382:13.2": "", "ja382:13.3": "Khudhaṁ → khudaṁ (bj, pts-vp-pli1); khuddaṁ (sya1ed, mr); khudda (sya2ed) ", "ja382:13.4": "", "ja382:14.1": "", "ja382:14.2": "", "ja382:14.3": "", "ja382:14.4": "asaṭhojubhūto → asathojubhūto (sya1ed, sya2ed); asaṭho ujjubhūto (pts-vp-pli1) ", "ja382:15.1": "", "ja382:15.2": "", "ja382:15.3": "Tasmiṁhaṁ → tasmāhaṁ (bj, pts-vp-pli1); tasmiṁha (sya1ed, sya2ed) ", "ja382:15.4": "", "ja382:16.1": "", "ja382:16.2": "", "ja382:16.3": "", "ja382:16.4": "vatte → vatto (sya1ed, sya2ed, mr) ", "ja382:17.1": "", "ja382:17.2": "", "ja382:17.3": "", "ja382:17.4": "Kantā sirī → kantaṁ siriṁ (sya1ed, sya2ed); kantasiriṁ (katthaci) ", "ja382:17.5": "", "ja382:17.6": "Karīsaṭhānaṁva → karīsajātaṁ va (bj, sya1ed, sya2ed); karīsavācaṁ va (pts-vp-pli1) ", "ja382:18.1": "", "ja382:18.2": "", "ja382:18.3": "", "ja382:18.4": "", "ja382:19.1": "Sirikāḷakaṇṇijātakaṁ → sirikālakaṇṇijātakaṁ (bj, pts-vp-pli1) "}, "reference_text": {"ja382:0.1": "", "ja382:0.2": "", "ja382:0.3": "", "ja382:0.4": "", "ja382:1.1": "bj30.242, ms22J_1363, msdiv40, ndp22.133, pts-vp-pli3.259", "ja382:1.2": "", "ja382:1.3": "", "ja382:1.4": "", "ja382:2.1": "ms22J_1364, msdiv41", "ja382:2.2": "", "ja382:2.3": "", "ja382:2.4": "", "ja382:2.5": "", "ja382:2.6": "", "ja382:3.1": "csp1ed22.142, csp2ed22.142, ms22J_1365, msdiv42", "ja382:3.2": "", "ja382:3.3": "", "ja382:3.4": "", "ja382:4.1": "ms22J_1366, msdiv43", "ja382:4.2": "", "ja382:4.3": "", "ja382:4.4": "", "ja382:5.1": "ms22J_1367, msdiv44, pts-vp-pli3.260, vri68.120", "ja382:5.2": "", "ja382:5.3": "", "ja382:5.4": "", "ja382:6.1": "dr27.193, ms22J_1368, msdiv45, sya27.194", "ja382:6.2": "", "ja382:6.3": "", "ja382:6.4": "", "ja382:7.1": "ms22J_1369, msdiv46", "ja382:7.2": "", "ja382:7.3": "", "ja382:7.4": "", "ja382:8.1": "ms22J_1370, msdiv47, pts-vp-pli3.261", "ja382:8.2": "", "ja382:8.3": "", "ja382:8.4": "", "ja382:9.1": "ms22J_1371, msdiv48", "ja382:9.2": "", "ja382:9.3": "", "ja382:9.4": "", "ja382:9.5": "", "ja382:9.6": "", "ja382:10.1": "ms22J_1372, msdiv49", "ja382:10.2": "", "ja382:10.3": "", "ja382:10.4": "", "ja382:11.1": "bj30.244, ms22J_1373, msdiv50, ndp22.134, pts-vp-pli3.262", "ja382:11.2": "", "ja382:11.3": "", "ja382:11.4": "", "ja382:11.5": "", "ja382:11.6": "", "ja382:12.1": "ms22J_1374, msdiv51", "ja382:12.2": "", "ja382:12.3": "", "ja382:12.4": "", "ja382:13.1": "csp1ed22.143, csp2ed22.143, dr27.194, ms22J_1375, msdiv52", "ja382:13.2": "", "ja382:13.3": "", "ja382:13.4": "", "ja382:14.1": "ms22J_1376, ms