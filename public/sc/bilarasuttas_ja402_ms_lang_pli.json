{"html_text": {"ja402:0.1": "<article id='ja402'><header><ul><li class='division'>{}</li>", "ja402:0.2": "<li>{}</li>", "ja402:0.3": "<li>{}</li></ul>", "ja402:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja402:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja402:1.2": "<span class='verse-line'>{}</span>", "ja402:1.3": "<span class='verse-line'>{}</span>", "ja402:1.4": "<span class='verse-line'>{}</span></p>", "ja402:2.1": "<p><span class='verse-line'>{}</span>", "ja402:2.2": "<span class='verse-line'>{}</span>", "ja402:2.3": "<span class='verse-line'>{}</span>", "ja402:2.4": "<span class='verse-line'>{}</span></p>", "ja402:3.1": "<p><span class='verse-line'>{}</span>", "ja402:3.2": "<span class='verse-line'>{}</span>", "ja402:3.3": "<span class='verse-line'>{}</span>", "ja402:3.4": "<span class='verse-line'>{}</span></p>", "ja402:4.1": "<p><span class='verse-line'>{}</span>", "ja402:4.2": "<span class='verse-line'>{}</span>", "ja402:4.3": "<span class='verse-line'>{}</span>", "ja402:4.4": "<span class='verse-line'>{}</span></p>", "ja402:5.1": "<p><span class='verse-line'>{}</span>", "ja402:5.2": "<span class='verse-line'>{}</span>", "ja402:5.3": "<span class='verse-line'>{}</span>", "ja402:5.4": "<span class='verse-line'>{}</span></p>", "ja402:6.1": "<p><span class='verse-line'>{}</span>", "ja402:6.2": "<span class='verse-line'>{}</span>", "ja402:6.3": "<span class='verse-line'>{}</span>", "ja402:6.4": "<span class='verse-line'>{}</span></p>", "ja402:7.1": "<p><span class='verse-line'>{}</span>", "ja402:7.2": "<span class='verse-line'>{}</span>", "ja402:7.3": "<span class='verse-line'>{}</span>", "ja402:7.4": "<span class='verse-line'>{}</span></p>", "ja402:8.1": "<p><span class='verse-line'>{}</span>", "ja402:8.2": "<span class='verse-line'>{}</span>", "ja402:8.3": "<span class='verse-line'>{}</span>", "ja402:8.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja402:9.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja402:0.1": "Jātaka ", "ja402:0.2": "Sattakanipāta ", "ja402:0.3": "Kukkuvagga ", "ja402:0.4": "7. Sattubhastajātaka ", "ja402:1.1": "“Vibbhantacitto kupitindriyosi, ", "ja402:1.2": "Nettehi te vārigaṇā savanti; ", "ja402:1.3": "Kiṁ te naṭṭhaṁ kiṁ pana patthayāno, ", "ja402:1.4": "Idhāgamā brahme tadiṅgha brūhi”. ", "ja402:2.1": "“Miyyetha bhariyā vajato mamajja, ", "ja402:2.2": "Agacchato maraṇamāha yakkho; ", "ja402:2.3": "Etena dukkhena pavedhitosmi, ", "ja402:2.4": "Akkhāhi me senaka etamatthaṁ”. ", "ja402:3.1": "“Bahūni ṭhānāni vicintayitvā, ", "ja402:3.2": "Yamettha vakkhāmi tadeva saccaṁ; ", "ja402:3.3": "Maññāmi te brāhmaṇa sattubhastaṁ, ", "ja402:3.4": "Ajānato kaṇhasappo paviṭṭho. ", "ja402:4.1": "Ādāya daṇḍaṁ parisumbha bhastaṁ, ", "ja402:4.2": "Passeḷamūgaṁ uragaṁ dujivhaṁ; ", "ja402:4.3": "Chindajja kaṅkhaṁ vicikicchitāni, ", "ja402:4.4": "Bhujaṅgamaṁ passa pamuñca bhastaṁ”. ", "ja402:5.1": "Saṁviggarūpo parisāya majjhe, ", "ja402:5.2": "So brāhmaṇo sattubhastaṁ pamuñci; ", "ja402:5.3": "Atha nikkhami urago uggatejo, ", "ja402:5.4": "Āsīviso sappo phaṇaṁ karitvā. ", "ja402:6.1": "“Suladdhalābhā janakassa rañño, ", "ja402:6.2": "Yo passatī senakaṁ sādhupaññaṁ; ", "ja402:6.3": "Vivaṭṭachaddo nusi sabbadassī, ", "ja402:6.4": "Ñāṇaṁ nu te brāhmaṇa bhiṁsarūpaṁ”. ", "ja402:7.1": "“Imāni me sattasatāni atthi, ", "ja402:7.2": "Gaṇhāhi sabbāni dadāmi tuyhaṁ; ", "ja402:7.3": "Tayā hi me jīvitamajja laddhaṁ, ", "ja402:7.4": "Athopi bhariyāya makāsi sotthiṁ”. ", "ja402:8.1": "“Na paṇḍitā vetanamādiyanti, ", "ja402:8.2": "Citrāhi gāthāhi subhāsitāhi; ", "ja402:8.3": "Itopi te brahme dadantu vittaṁ, ", "ja402:8.4": "Ādāya tvaṁ gaccha sakaṁ niketan”ti. ", "ja402:9.1": "Sattubhastajātakaṁ sattamaṁ. "}, "variant_text": {"ja402:0.1": "", "ja402:0.2": "", "ja402:0.3": "", "ja402:0.4": "", "ja402:1.1": "", "ja402:1.2": "", "ja402:1.3": "", "ja402:1.4": "brahme tadiṅgha → brāhmaṇa iṅgha (bj, sya1ed, sya2ed) ", "ja402:2.1": "", "ja402:2.2": "", "ja402:2.3": "", "ja402:2.4": "", "ja402:3.1": "", "ja402:3.2": "", "ja402:3.3": "", "ja402:3.4": "", "ja402:4.1": "", "ja402:4.2": "dujivhaṁ → dvijivhaṁ (bj); dijivhaṁ (pts-vp-pli1) ", "ja402:4.3": "", "ja402:4.4": "", "ja402:5.1": "", "ja402:5.2": "", "ja402:5.3": "", "ja402:5.4": "", "ja402:6.1": "", "ja402:6.2": "", "ja402:6.3": "Vivaṭṭachaddo → vivattacchaddo (bj); vivaṭṭacchado (sya1ed, sya2ed); vivattacchaddā (pts-vp-pli1) ", "ja402:6.4": "", "ja402:7.1": "", "ja402:7.2": "", "ja402:7.3": "", "ja402:7.4": "", "ja402:8.1": "", "ja402:8.2": "", "ja402:8.3": "", "ja402:8.4": "", "ja402:9.1": "Sattubhastajātakaṁ → senakajātakaṁ (sya1ed, sya2ed) "}, "reference_text": {"ja402:0.1": "", "ja402:0.2": "", "ja402:0.3": "", "ja402:0.4": "", "ja402:1.1": "ms22J_1536, msdiv46, pts-vp-pli3.344", "ja402:1.2": "", "ja402:1.3": "", "ja402:1.4": "", "ja402:2.1": "bj30.274, ms22J_1537, msdiv47, ndp22.152, pts-vp-pli3.345", "ja402:2.2": "", "ja402:2.3": "", "ja402:2.4": "", "ja402:3.1": "ms22J_1538, msdiv48, pts-vp-pli3.346", "ja402:3.2": "", "ja402:3.3": "", "ja402:3.4": "", "ja402:4.1": "csp1ed22.161, csp2ed22.161, ms22J_1539, msdiv49, pts-vp-pli3.347", "ja402:4.2": "", "ja402:4.3": "", "ja402:4.4": "", "ja402:5.1": "dr27.218, ms22J_1540, msdiv50, pts-vp-pli3.348, sya27.219", "ja402:5.2": "", "ja402:5.3": "", "ja402:5.4": "", "ja402:6.1": "ms22J_1541, msdiv51, pts-vp-pli3.349", "ja402:6.2": "", "ja402:6.3": "", "ja402:6.4": "", "ja402:7.1": "ms22J_1542, msdiv52", "ja402:7.2": "", "ja402:7.3": "", "ja402:7.4": "", "ja402:8.1": "ms22J_1543, msdiv53, ndp22.153", "ja402:8.2": "", "ja402:8.3": "", "ja402:8.4": "", "ja402:9.1": "ms22J_1544"}, "keys_order": ["ja402:0.1", "ja402:0.2", "ja402:0.3", "ja402:0.4", "ja402:1.1", "ja402:1.2", "ja402:1.3", "ja402:1.4", "ja402:2.1", "ja402:2.2", "ja402:2.3", "ja402:2.4", "ja402:3.1", "ja402:3.2", "ja402:3.3", "ja402:3.4", "ja402:4.1", "ja402:4.2", "ja402:4.3", "ja402:4.4", "ja402:5.1", "ja402:5.2", "ja402:5.3", "ja402:5.4", "ja402:6.1", "ja402:6.2", "ja402:6.3", "ja4