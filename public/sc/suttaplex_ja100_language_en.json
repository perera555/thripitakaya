[{"acronym": "Ja 100", "alt_acronym": null, "volpages": "PTS 1.410", "alt_volpages": null, "uid": "ja100", "blurb": "“In guise of joy.”—This story was told by the Master while at Kundadhanavana near the city of Kundiya about Suppavasa, a lay-sister, who was daughter to King Koliya. For at that time, she, who had carried a child seven years in her womb, was in the seventh day of her throes, and her pains were grievous. ", "difficulty": null, "original_title": "Asātarūpajātaka", "root_lang": "pli", "root_lang_name": "Pāli", "type": "leaf", "translated_title": "Asatarupa Jātaka", "translations": [{"lang": "pli", "lang_name": "Pāli", "is_root": true, "author": "Mahāsaṅgīti Tipiṭaka Buddhavasse 2500", "author_short": "ms", "author_uid": "ms", "publication_date": null, "id": "ja100_root-pli-ms", "segmented": true, "title": null, "volpage": null, "has_comment": false}, {"lang": "de", "lang_name": "Deutsch", "is_root": false, "author": "Dr. Julius Dutoit", "author_short": "Dutoit", "author_uid": "dutoit", "publication_date": "2007", "id": "de_ja100_dutoit", "segmented": false, "volpage": null, "has_comment": false}, {"author": "Robert Chalmers", "author_short": "Chalmers", "author_uid": "chalmers", "has_comment": false, "id": "en_ja100_chalmers", "is_root": false, "lang": "en", "lang_name": "English", "publication_date": "1895", "segmented": false, "volpage": null, "title": "Asatarupa Jātaka"}, {"lang": "jpn", "lang_name": "日本語", "is_root": false, "author": "関西パーリ語実習会", "author_short": "関西パーリ語実習会", "author_uid": "kansai", "publication_date": "2023", "id": "jpn_ja100_kansai", "segmented": false, "volpage": null, "has_comment": false}, {"lang": "si", "lang_name": "සිංහල", "is_root": false, "author": "A.P. de Zoysa", "author_short": "Zoysa", "author_uid": "zoysa", "publication_date": null, "id": "si_ja100_zoysa", "segmented": false, "volpage": null, "has_comment": false}], "parallel_count": 6, "biblio": null, "priority_author_uid": "sujato", "verseNo": "", "previous": {"name":