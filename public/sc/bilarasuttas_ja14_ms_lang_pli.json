{"html_text": {"ja14:0.1": "<article id='ja14'><header><ul><li class='division'>{}</li>", "ja14:0.2": "<li>{}</li>", "ja14:0.3": "<li>{}</li></ul>", "ja14:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja14:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja14:1.2": "<span class='verse-line'>{}</span>", "ja14:1.3": "<span class='verse-line'>{}</span>", "ja14:1.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja14:2.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja14:0.1": "Jātaka ", "ja14:0.2": "Ekakanipāta ", "ja14:0.3": "Sīlavagga ", "ja14:0.4": "4. Vātamigajātaka ", "ja14:1.1": "“Na kiratthi rasehi pāpiyo, ", "ja14:1.2": "Āvāsehi va santhavehi vā; ", "ja14:1.3": "Vātamigaṁ gahananissitaṁ, ", "ja14:1.4": "Vasamānesi rasehi sañjayo”ti. ", "ja14:2.1": "Vātamigajātakaṁ catutthaṁ. "}, "variant_text": {"ja14:0.1": "", "ja14:0.2": "", "ja14:0.3": "va → vā (sabbattha) ", "ja14:0.4": "", "ja14:1.1": "", "ja14:1.2": "", "ja14:1.3": "gahananissitaṁ → gehanissitaṁ (bj, pts-vp-pli1) ", "ja14:1.4": "", "ja14:2.1": ""}, "reference_text": {"ja14:0.1": "", "ja14:0.2": "", "ja14:0.3": "", "ja14:0.4": "", "ja14:1.1": "dr27.6, ms22J_30, msdiv14, ndp22.6, pts-vp-pli1.158", "ja14:1.2": "", "ja14:1.3": "", "ja14:1.4": "", "ja14:2.1": "ms22J_31"}, "keys_order": ["ja14:0.1", "ja14:0.2", "ja14:0.3", "ja14:0.4", "ja14:1.1", "ja14:1.2", "ja14:1.3", "ja14:1.4", "ja14:2.1"]}