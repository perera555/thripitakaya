{"html_text": {"ja343:0.1": "<article id='ja343'><header><ul><li class='division'>{}</li>", "ja343:0.2": "<li>{}</li>", "ja343:0.3": "<li>{}</li></ul>", "ja343:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja343:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja343:1.2": "<span class='verse-line'>{}</span>", "ja343:1.3": "<span class='verse-line'>{}</span>", "ja343:1.4": "<span class='verse-line'>{}</span></p>", "ja343:2.1": "<p><span class='verse-line'>{}</span>", "ja343:2.2": "<span class='verse-line'>{}</span>", "ja343:2.3": "<span class='verse-line'>{}</span>", "ja343:2.4": "<span class='verse-line'>{}</span></p>", "ja343:3.1": "<p><span class='verse-line'>{}</span>", "ja343:3.2": "<span class='verse-line'>{}</span>", "ja343:3.3": "<span class='verse-line'>{}</span>", "ja343:3.4": "<span class='verse-line'>{}</span></p>", "ja343:4.1": "<p><span class='verse-line'>{}</span>", "ja343:4.2": "<span class='verse-line'>{}</span>", "ja343:4.3": "<span class='verse-line'>{}</span>", "ja343:4.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja343:5.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja343:0.1": "Jātaka ", "ja343:0.2": "Catukkanipāta ", "ja343:0.3": "Cūḷakuṇālavagga ", "ja343:0.4": "3. Kuntinījātaka ", "ja343:1.1": "“Avasimha tavāgāre, ", "ja343:1.2": "niccaṁ sakkatapūjitā; ", "ja343:1.3": "Tvameva dānimakari, ", "ja343:1.4": "handa rāja vajāmahaṁ”. ", "ja343:2.1": "“Yo ve kate paṭikate, ", "ja343:2.2": "kibbise paṭikibbise; ", "ja343:2.3": "Evaṁ taṁ sammatī veraṁ, ", "ja343:2.4": "vasa kuntini māgamā”. ", "ja343:3.1": "“Na katassa ca kattā ca, ", "ja343:3.2": "metti sandhīyate puna; ", "ja343:3.3": "Hadayaṁ nānujānāti, ", "ja343:3.4": "gacchaññeva rathesabha”. ", "ja343:4.1": "“Katassa ceva kattā ca, ", "ja343:4.2": "metti sandhīyate puna; ", "ja343:4.3": "Dhīrānaṁ no ca bālānaṁ, ", "ja343:4.4": "vasa kuntini māgamā”ti. ", "ja343:5.1": "Kuntinījātakaṁ tatiyaṁ. "}, "variant_text": {"ja343:0.1": "", "ja343:0.2": "", "ja343:0.3": "", "ja343:0.4": "", "ja343:1.1": "", "ja343:1.2": "", "ja343:1.3": "", "ja343:1.4": "", "ja343:2.1": "", "ja343:2.2": "", "ja343:2.3": "", "ja343:2.4": "", "ja343:3.1": "", "ja343:3.2": "metti → mitti (sya1ed, sya2ed); mettī (pts-vp-pli1); mittī (mr) ", "ja343:3.3": "", "ja343:3.4": "", "ja343:4.1": "", "ja343:4.2": "", "ja343:4.3": "", "ja343:4.4": "", "ja343:5.1": "Kuntinījātakaṁ → kuntanijātakaṁ (pts-vp-pli1) "}, "reference_text": {"ja343:0.1": "", "ja343:0.2": "", "ja343:0.3": "", "ja343:0.4": "", "ja343:1.1": "bj30.198, ms22J_1101, msdiv169, pts-vp-pli3.135", "ja343:1.2": "", "ja343:1.3": "", "ja343:1.4": "", "ja343:2.1": "ms22J_1102, msdiv170", "ja343:2.2": "", "ja343:2.3": "", "ja343:2.4": "", "ja343:3.1": "ms22J_1103, msdiv171, ndp22.107, pts-vp-pli3.136", "ja343:3.2": "", "ja343:3.3": "", "ja343:3.4": "", "ja343:4.1": "ms22J_1104, msdiv172", "ja343:4.2": "", "ja343:4.3": "", "ja343:4.4": "", "ja343:5.1": "ms22J_1105"}, "keys_order": ["ja343:0.1", "ja343:0.2", "ja343:0.3", "ja343:0.4", "ja343:1.1", "ja343:1.2", "ja343:1.3", "ja343:1.4", "ja343:2.1", "ja343:2.2", "ja343:2.3", "ja343:2.4", "ja343:3.1", "ja343:3.2", "ja343:3.3", "ja343:3.4", "ja343:4.1", "ja343:4.2", "ja343:4.3", "ja343:4.4", "ja343:5.1"]}