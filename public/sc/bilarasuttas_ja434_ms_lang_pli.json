{"html_text": {"ja434:0.1": "<article id='ja434'><header><ul><li class='division'>{}</li>", "ja434:0.2": "<li>{}</li>", "ja434:0.3": "<li>{}</li></ul>", "ja434:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja434:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja434:1.2": "<span class='verse-line'>{}</span>", "ja434:1.3": "<span class='verse-line'>{}</span>", "ja434:1.4": "<span class='verse-line'>{}</span></p>", "ja434:2.1": "<p><span class='verse-line'>{}</span>", "ja434:2.2": "<span class='verse-line'>{}</span>", "ja434:2.3": "<span class='verse-line'>{}</span>", "ja434:2.4": "<span class='verse-line'>{}</span>", "ja434:2.5": "<span class='verse-line'>{}</span></p>", "ja434:3.1": "<p><span class='verse-line'>{}</span>", "ja434:3.2": "<span class='verse-line'>{}</span>", "ja434:3.3": "<span class='verse-line'>{}</span>", "ja434:3.4": "<span class='verse-line'>{}</span></p>", "ja434:4.1": "<p><span class='verse-line'>{}</span>", "ja434:4.2": "<span class='verse-line'>{}</span>", "ja434:4.3": "<span class='verse-line'>{}</span>", "ja434:4.4": "<span class='verse-line'>{}</span></p>", "ja434:5.1": "<p><span class='verse-line'>{}</span>", "ja434:5.2": "<span class='verse-line'>{}</span>", "ja434:5.3": "<span class='verse-line'>{}</span>", "ja434:5.4": "<span class='verse-line'>{}</span></p>", "ja434:6.1": "<p><span class='verse-line'>{}</span>", "ja434:6.2": "<span class='verse-line'>{}</span>", "ja434:6.3": "<span class='verse-line'>{}</span>", "ja434:6.4": "<span class='verse-line'>{}</span>", "ja434:6.5": "<span class='verse-line'>{}</span>", "ja434:6.6": "<span class='verse-line'>{}</span></p>", "ja434:7.1": "<p><span class='verse-line'>{}</span>", "ja434:7.2": "<span class='verse-line'>{}</span>", "ja434:7.3": "<span class='verse-line'>{}</span>", "ja434:7.4": "<span class='verse-line'>{}</span></p>", "ja434:8.1": "<p><span class='verse-line'>{}</span>", "ja434:8.2": "<span class='verse-line'>{}</span>", "ja434:8.3": "<span class='verse-line'>{}</span>", "ja434:8.4": "<span class='verse-line'>{}</span></p>", "ja434:9.1": "<p><span class='verse-line'>{}</span>", "ja434:9.2": "<span class='verse-line'>{}</span>", "ja434:9.3": "<span class='verse-line'>{}</span>", "ja434:9.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja434:10.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja434:0.1": "Jātaka ", "ja434:0.2": "Navakanipāta ", "ja434:0.3": "Gijjhavagga ", "ja434:0.4": "8. Cakkavākajātaka ", "ja434:1.1": "“Kāsāyavatthe sakuṇe vadāmi, ", "ja434:1.2": "Duve duve nandamane carante; ", "ja434:1.3": "Kaṁ aṇḍajaṁ aṇḍajā mānusesu, ", "ja434:1.4": "Jātiṁ pasaṁsanti tadiṅgha brūtha”. ", "ja434:2.1": "“Amhe manussesu manussahiṁsa, ", "ja434:2.2": "Anubbate cakkavāke vadanti; ", "ja434:2.3": "Kalyāṇabhāvamhe dijesu sammatā, ", "ja434:2.4": "Abhirūpā vicarāma aṇṇave”. ", "ja434:2.5": "(…) ", "ja434:3.1": "“Kiṁ aṇṇave kāni phalāni bhuñje, ", "ja434:3.2": "Maṁsaṁ kuto khādatha cakkavākā; ", "ja434:3.3": "Kiṁ bhojanaṁ bhuñjatha vo anomā, ", "ja434:3.4": "Balañca vaṇṇo ca anapparūpā”. ", "ja434:4.1": "“Na aṇṇave santi phalāni dhaṅka, ", "ja434:4.2": "Maṁsaṁ kuto khādituṁ cakkavāke; ", "ja434:4.3": "Sevālabhakkhamha apāṇabhojanā, ", "ja434:4.4": "Na ghāsahetūpi karoma pāpaṁ”. ", "ja434:5.1": "“Na me idaṁ ruccati cakkavāka, ", "ja434:5.2": "Asmiṁ bhave bhojanasannikāso; ", "ja434:5.3": "Ahosi pubbe tato me aññathā, ", "ja434:5.4": "Icceva me vimati ettha jātā. ", "ja434:6.1": "Ahampi maṁsāni phalāni bhuñje, ", "ja434:6.2": "Annāni ca loṇiyateliyāni; ", "ja434:6.3": "Rasaṁ manussesu labhāmi bhottuṁ, ", "ja434:6.4": "Sūrova saṅgāmamukhaṁ vijetvā; ", "ja434:6.5": "Na ca me tādiso vaṇṇo, ", "ja434:6.6": "Cakkavāka yathā tava”. ", "ja434:7.1": "“Asuddhabhakkhosi khaṇānupātī, ", "ja434:7.2": "Kicchena te labbhati annapānaṁ; ", "ja434:7.3": "Na tussasī rukkhaphalehi dhaṅka, ", "ja434:7.4": "Maṁsāni vā yāni susānamajjhe. ", "ja434:8.1": "Yo sāhasena adhigamma bhoge, ", "ja434:8.2": "Paribhuñjati dhaṅka khaṇānupātī; ", "ja434:8.3": "Tato upakkosati naṁ sabhāvo, ", "ja434:8.4": "Upakkuṭṭho vaṇṇabalaṁ jahāti. ", "ja434:9.1": "Appampi ce nibbutiṁ bhuñjatī yadi, ", "ja434:9.2": "Asāhasena aparūpaghātī; ", "ja434:9.3": "Balañca vaṇṇo ca tadassa hoti, ", "ja434:9.4": "Na hi sabbo āhāramayena vaṇṇo”ti. ", "ja434:10.1": "Cakkavākajātakaṁ aṭṭhamaṁ. "}, "variant_text": {"ja434:0.1": "", "ja434:0.2": "", "ja434:0.3": "", "ja434:0.4": "", "ja434:1.1": "", "ja434:1.2": "nandamane → nandimane (bj, pts-vp-pli1) ", "ja434:1.3": "", "ja434:1.4": "", "ja434:2.1": "", "ja434:2.2": "Anubbate → anupubbake (bj, mr) ", "ja434:2.3": "Kalyāṇabhāvamhe → … bhāvamha (bj, pts-vp-pli1) ", "ja434:2.4": "Abhirūpā → abhītarūpā (bj, sya1ed, sya2ed, pts-vp-pli1) ", "ja434:2.5": "(…) → (na ghāsahetupi karoma pāpaṁ) (sya1ed, sya2ed, mr) ", "ja434:3.1": "", "ja434:3.2": "", "ja434:3.3": "anomā → abhiṇhaṁ (mr) ", "ja434:3.4": "anapparūpā → anapparūpo (bj, sya1ed, sya2ed, pts-vp-pli1) ", "ja434:4.1": "", "ja434:4.2": "", "ja434:4.3": "Sevālabhakkhamha → … bhakkhimha (mr) | apāṇabhojanā → avākabhojanā (bj, pts-vp-pli1) ", "ja434:4.4": "", "ja434:5.1": "", "ja434:5.2": "", "ja434:5.3": "", "ja434:5.4": "", "ja434:6.1": "", "ja434:6.2": "", "ja434:6.3": "", "ja434:6.4": "", "ja434:6.5": "", "ja434:6.6": "", "ja434:7.1": "", "ja434:7.2": "", "ja434:7.3": "", "ja434:7.4": "", "ja434:8.1": "", "ja434:8.2": "", "ja434:8.3": "", "ja434:8.4": "", "ja434:9.1": "", "ja434:9.2": "Asāhasena aparūpaghātī → asāhasenānupaghātino (mr) ", "ja434:9.3": "", "ja434:9.4": "", "ja434:10.1": ""}, "reference_text": {"ja434:0.1": "", "ja434:0.2": "", "ja434:0.3": "", "ja434:0.4": "", "ja434:1.1": "ms22J_1856, msdiv69, pts-vp-pli3.520", "ja434:1.2": "", "ja434:1.3": "", "ja434:1.4": "", "ja434:2.1": "bj30.338, ms22J_1857, msdiv70, pts-vp-pli3.521", "ja434:2.2": "", "ja434:2.3": "", "ja434:2.4": "", "ja434:2.5": "", "ja434:3.1": "dr27.262, ms22J_1858, msdiv71, sya27.263", "ja434:3.2": "", "ja434:3.3": "", "ja434:3.4": "", "ja43