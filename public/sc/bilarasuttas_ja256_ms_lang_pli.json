{"html_text": {"ja256:0.1": "<article id='ja256'><header><ul><li class='division'>{}</li>", "ja256:0.2": "<li>{}</li>", "ja256:0.3": "<li>{}</li></ul>", "ja256:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja256:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja256:1.2": "<span class='verse-line'>{}</span>", "ja256:1.3": "<span class='verse-line'>{}</span>", "ja256:1.4": "<span class='verse-line'>{}</span>", "ja256:1.5": "<span class='verse-line'>{}</span>", "ja256:1.6": "<span class='verse-line'>{}</span></p>", "ja256:2.1": "<p><span class='verse-line'>{}</span>", "ja256:2.2": "<span class='verse-line'>{}</span>", "ja256:2.3": "<span class='verse-line'>{}</span>", "ja256:2.4": "<span class='verse-line'>{}</span></p>", "ja256:3.1": "<p><span class='verse-line'>{}</span>", "ja256:3.2": "<span class='verse-line'>{}</span>", "ja256:3.3": "<span class='verse-line'>{}</span>", "ja256:3.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja256:4.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja256:0.1": "Jātaka ", "ja256:0.2": "Tikanipāta ", "ja256:0.3": "Saṅkappavagga ", "ja256:0.4": "6. Jarūdapānajātaka ", "ja256:1.1": "“Jarūdapānaṁ khaṇamānā, ", "ja256:1.2": "vāṇijā udakatthikā; ", "ja256:1.3": "Ajjhagamuṁ ayasaṁ lohaṁ, ", "ja256:1.4": "tipusīsañca vāṇijā; ", "ja256:1.5": "Rajataṁ jātarūpañca, ", "ja256:1.6": "muttā veḷuriyā bahū. ", "ja256:2.1": "Te ca tena asantuṭṭhā, ", "ja256:2.2": "bhiyyo bhiyyo akhāṇisuṁ; ", "ja256:2.3": "Te tatthāsīviso ghoro, ", "ja256:2.4": "tejassī tejasā hani. ", "ja256:3.1": "Tasmā khaṇe nātikhaṇe, ", "ja256:3.2": "Atikhātaṁ hi pāpakaṁ; ", "ja256:3.3": "Khātena ca dhanaṁ laddhaṁ, ", "ja256:3.4": "Atikhātena nāsitan”ti. ", "ja256:4.1": "Jarūdapānajātakaṁ chaṭṭhaṁ. "}, "variant_text": {"ja256:0.1": "", "ja256:0.2": "", "ja256:0.3": "", "ja256:0.4": "", "ja256:1.1": "", "ja256:1.2": "", "ja256:1.3": "Ajjhagamuṁ ayasaṁ lohaṁ → ajjhagaṁsu ayolohaṁ (bj, sya1ed, pts-vp-pli1); ajjhaggaṁsu ayolahaṁ (sya2ed) ", "ja256:1.4": "", "ja256:1.5": "", "ja256:1.6": "", "ja256:2.1": "", "ja256:2.2": "", "ja256:2.3": "tatthāsīviso → tatthāsiviso (bj); tatthapāsīviso (sya1ed, sya2ed); tattha āsīviso (mr) ", "ja256:2.4": "", "ja256:3.1": "", "ja256:3.2": "Atikhātaṁ → atikkhātam (sya1ed, sya2ed); atikhaṇaṁ (mr) ", "ja256:3.3": "Khātena ca → khaṇanena (sya1ed, sya2ed); khaṇena ca (mr) ", "ja256:3.4": "Atikhātena → atikhaṇena (mr) ", "ja256:4.1": "Jarūdapānajātakaṁ → jarudapānajātakaṁ (pts-vp-pli1) "}, "reference_text": {"ja256:0.1": "", "ja256:0.2": "", "ja256:0.3": "", "ja256:0.4": "", "ja256:1.1": "csp1ed22.73, csp2ed22.73, ms22J_690, msdiv16, ndp22.68, pts-vp-pli2.296", "ja256:1.2": "", "ja256:1.3": "", "ja256:1.4": "", "ja256:1.5": "", "ja256:1.6": "", "ja256:2.1": "ms22J_691, msdiv17", "ja256:2.2": "", "ja256:2.3": "", "ja256:2.4": "", "ja256:3.1": "bj30.128, dr27.101, ms22J_692, msdiv18, sya27.102, vri68.65", "ja256:3.2": "", "ja256:3.3": "", "ja256:3.4": "", "ja256:4.1": "ms22J_693"}, "keys_order": ["ja256:0.1", "ja256:0.2", "ja256:0.3", "ja256:0.4", "ja256:1.1", "ja256:1.2", "ja256:1.3", "ja256:1.4", "ja256:1.5", "ja256:1.6", "ja256:2.1", "ja256:2.2", "ja256:2.3", "ja256:2.4", "ja256:3.1", "ja256:3.2", "ja256:3.3", "ja256:3.4", "ja256:4.1"]}