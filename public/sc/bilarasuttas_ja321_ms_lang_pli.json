{"html_text": {"ja321:0.1": "<article id='ja321'><header><ul><li class='division'>{}</li>", "ja321:0.2": "<li>{}</li>", "ja321:0.3": "<li>{}</li></ul>", "ja321:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja321:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja321:1.2": "<span class='verse-line'>{}</span>", "ja321:1.3": "<span class='verse-line'>{}</span>", "ja321:1.4": "<span class='verse-line'>{}</span></p>", "ja321:2.1": "<p><span class='verse-line'>{}</span>", "ja321:2.2": "<span class='verse-line'>{}</span>", "ja321:2.3": "<span class='verse-line'>{}</span>", "ja321:2.4": "<span class='verse-line'>{}</span></p>", "ja321:3.1": "<p><span class='verse-line'>{}</span>", "ja321:3.2": "<span class='verse-line'>{}</span>", "ja321:3.3": "<span class='verse-line'>{}</span>", "ja321:3.4": "<span class='verse-line'>{}</span></p>", "ja321:4.1": "<p><span class='verse-line'>{}</span>", "ja321:4.2": "<span class='verse-line'>{}</span>", "ja321:4.3": "<span class='verse-line'>{}</span>", "ja321:4.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja321:5.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja321:0.1": "Jātaka ", "ja321:0.2": "Catukkanipāta ", "ja321:0.3": "Kuṭidūsakavagga ", "ja321:0.4": "1. Kuṭidūsakajātaka ", "ja321:1.1": "“Manussasseva te sīsaṁ, ", "ja321:1.2": "hatthapādā ca vānara; ", "ja321:1.3": "Atha kena nu vaṇṇena, ", "ja321:1.4": "agāraṁ te na vijjati”. ", "ja321:2.1": "“Manussasseva me sīsaṁ, ", "ja321:2.2": "hatthapādā ca siṅgila; ", "ja321:2.3": "Yāhu seṭṭhā manussesu, ", "ja321:2.4": "sā me paññā na vijjati”. ", "ja321:3.1": "“Anavaṭṭhitacittassa, ", "ja321:3.2": "lahucittassa dubbhino; ", "ja321:3.3": "Niccaṁ addhuvasīlassa, ", "ja321:3.4": "sukhabhāvo na vijjati. ", "ja321:4.1": "So karassu ānubhāvaṁ, ", "ja321:4.2": "vītivattassu sīliyaṁ; ", "ja321:4.3": "Sītavātaparittāṇaṁ, ", "ja321:4.4": "karassu kuṭavaṁ kapī”ti. ", "ja321:5.1": "Kuṭidūsakajātakaṁ paṭhamaṁ. "}, "variant_text": {"ja321:0.1": 