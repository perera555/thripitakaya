{"html_text": {"ja398:0.1": "<article id='ja398'><header><ul><li class='division'>{}</li>", "ja398:0.2": "<li>{}</li>", "ja398:0.3": "<li>{}</li></ul>", "ja398:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja398:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja398:1.2": "<span class='verse-line'>{}</span>", "ja398:1.3": "<span class='verse-line'>{}</span>", "ja398:1.4": "<span class='verse-line'>{}</span></p>", "ja398:2.1": "<p><span class='verse-line'>{}</span>", "ja398:2.2": "<span class='verse-line'>{}</span>", "ja398:2.3": "<span class='verse-line'>{}</span>", "ja398:2.4": "<span class='verse-line'>{}</span></p>", "ja398:3.1": "<p><span class='verse-line'>{}</span>", "ja398:3.2": "<span class='verse-line'>{}</span>", "ja398:3.3": "<span class='verse-line'>{}</span>", "ja398:3.4": "<span class='verse-line'>{}</span></p>", "ja398:4.1": "<p><span class='verse-line'>{}</span>", "ja398:4.2": "<span class='verse-line'>{}</span>", "ja398:4.3": "<span class='verse-line'>{}</span>", "ja398:4.4": "<span class='verse-line'>{}</span></p>", "ja398:5.1": "<p><span class='verse-line'>{}</span>", "ja398:5.2": "<span class='verse-line'>{}</span>", "ja398:5.3": "<span class='verse-line'>{}</span>", "ja398:5.4": "<span class='verse-line'>{}</span></p>", "ja398:6.1": "<p><span class='verse-line'>{}</span>", "ja398:6.2": "<span class='verse-line'>{}</span>", "ja398:6.3": "<span class='verse-line'>{}</span>", "ja398:6.4": "<span class='verse-line'>{}</span></p>", "ja398:7.1": "<p><span class='verse-line'>{}</span>", "ja398:7.2": "<span class='verse-line'>{}</span>", "ja398:7.3": "<span class='verse-line'>{}</span>", "ja398:7.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja398:8.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja398:0.1": "Jātaka ", "ja398:0.2": "Sattakanipāta ", "ja398:0.3": "Kukkuvagga ", "ja398:0.4": "3. Sutanujātaka ", "ja398:1.1": "“Rājā te bhattaṁ pāhesi, ", "ja398:1.2": "Suciṁ maṁsūpasecanaṁ; ", "ja398:1.3": "Maghadevasmiṁ adhivatthe, ", "ja398:1.4": "Ehi nikkhamma bhuñjasu”. ", "ja398:2.1": "“Ehi māṇava orena, ", "ja398:2.2": "bhikkhamādāya sūpitaṁ; ", "ja398:2.3": "Tvañca māṇava bhikkhā ca, ", "ja398:2.4": "ubho bhakkhā bhavissatha”. ", "ja398:3.1": "“Appakena tuvaṁ yakkha, ", "ja398:3.2": "thullamatthaṁ jahissasi; ", "ja398:3.3": "Bhikkhaṁ te nāharissanti, ", "ja398:3.4": "janā maraṇasaññino. ", "ja398:4.1": "Laddhāya yakkhā tava niccabhikkhaṁ, ", "ja398:4.2": "Suciṁ paṇītaṁ rasasā upetaṁ; ", "ja398:4.3": "Bhikkhañca te āhariyo naro idha, ", "ja398:4.4": "Sudullabho hehiti bhakkhite mayi”. ", "ja398:5.1": "“Mameva sutano attho, ", "ja398:5.2": "yathā bhāsasi māṇava; ", "ja398:5.3": "Mayā tvaṁ samanuññāto, ", "ja398:5.4": "sotthiṁ passāhi mātaraṁ. ", "ja398:6.1": "Khaggaṁ chattañca pātiñca, ", "ja398:6.2": "gacchamādāya māṇava; ", "ja398:6.3": "Sotthiṁ passatu te mātā, ", "ja398:6.4": "tvañca passāhi mātaraṁ”. ", "ja398:7.1": "“Evaṁ yakkha sukhī hohi, ", "ja398:7.2": "saha sabbehi ñātibhi; ", "ja398:7.3": "Dhanañca me adhigataṁ, ", "ja398:7.4": "rañño ca vacanaṁ katan”ti. ", "ja398:8.1": "Sutanujātakaṁ tatiyaṁ. "}, "variant_text": {"ja398:0.1": "", "ja398:0.2": "", "ja398:0.3": "", "ja398:0.4": "", "ja398:1.1": "", "ja398:1.2": "", "ja398:1.3": "Maghadevasmiṁ → makhādevasmiṁ (bj, pts-vp-pli1); māghadevasmiṁ (mr) ", "ja398:1.4": "", "ja398:2.1": "", "ja398:2.2": "", "ja398:2.3": "bhikkhā ca → bhakkhosi (sya1ed, sya2ed); bhakkhāva (mr) ", "ja398:2.4": "", "ja398:3.1": "", "ja398:3.2": "", "ja398:3.3": "", "ja398:3.4": "", "ja398:4.1": "Laddhāya yakkhā → laddhāyaṁ yakkha (bj, sya1ed, sya2ed, pts-vp-pli1) ", "ja398:4.2": "", "ja398:4.3": "", "ja398:4.4": "hehiti bhakkhite → hohiti khādite (bj, sya1ed, sya2ed, pts-vp-pli1) ", "ja398:5.1": "Mameva → mamesa (bj, pts-vp-pli1) ", "ja398:5.2": "", "ja398:5.3": "", "ja398:5.4": "", "ja398:6.1": "", "ja398:6.2": "gacchamādāya → gacchevādāya (bj, sya1ed, sya2ed, pts-vp-pli1) ", "ja398:6.3": "", "ja398:6.4": "", "ja398:7.1": "", "ja398:7.2": "", "ja398:7.3": "", "ja398:7.4": "", "ja398:8.1": "Sutanujātakaṁ → sutanajātakaṁ (sya1ed, sya2ed); sutanojātakaṁ (pts-vp-pli1) "}, "reference_text": {"ja398:0.1": "", "ja398:0.2": "", "ja398:0.3": "", "ja398:0.4": "", "ja398:1.1": "ms22J_1501, msdiv15, pts-vp-pli3.327", "ja398:1.2": "", "ja398:1.3": "", "ja398:1.4": "", "ja398:2.1": "dr27.213, ms22J_1502, msdiv16, pts-vp-pli3.328, sya27.214", "ja398:2.2": "", "ja398:2.3": "", "ja398:2.4": "", "ja398:3.1": "ms22J_1503, msdiv17", "ja398:3.2": "", "ja398:3.3": "", "ja398:3.4": "", "ja398:4.1": "bj30.268, ms22J_1504, msdiv18", "ja398:4.2": "", "ja398:4.3": "", "ja398:4.4": "", "ja398:5.1": "ms22J_1505, msdiv19, pts-vp-pli3.329", "ja398:5.2": "", "ja398:5.3": "", "ja398:5.4": "", "ja398:6.1": "ms22J_1506, msdiv20", "ja398:6.2": "", "ja398:6.3": "", "ja398:6.4": "", "ja398:7.1": "ms22J_1507, msdiv21, ndp22.149", "ja398:7.2": "", "ja398:7.3": "", "ja398:7.4": "", "ja398:8.1": "ms22J_1508"}, "keys_order": ["ja398:0.1", "ja398:0.2", "ja398:0.3", "ja398:0.4", "ja398:1.1", "ja398:1.2", "ja398:1.3", "ja398:1.4", "ja398:2.1", "ja398:2.2", "ja398:2.3", "ja398:2.4", "ja398:3.1", "ja398:3.2", "ja398:3.3", "ja398:3.4", "ja398:4.1", "ja398:4.2", "ja398:4.3", "ja398:4.4", "ja398:5.1", "ja398:5.2", "ja398:5.3", "ja398:5.4", "ja398:6.1", "ja398:6.2", "ja398:6.3", "ja398:6.4", "ja398:7.1", "ja398:7.2", "ja398:7.3", "ja398:7.4", "ja398:8.1"]}