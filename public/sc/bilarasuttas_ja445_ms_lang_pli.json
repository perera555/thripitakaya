{"html_text": {"ja445:0.1": "<article id='ja445'><header><ul><li class='division'>{}</li>", "ja445:0.2": "<li>{}</li>", "ja445:0.3": "<li>{}</li></ul>", "ja445:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja445:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja445:1.2": "<span class='verse-line'>{}</span>", "ja445:1.3": "<span class='verse-line'>{}</span>", "ja445:1.4": "<span class='verse-line'>{}</span></p>", "ja445:2.1": "<p><span class='verse-line'>{}</span>", "ja445:2.2": "<span class='verse-line'>{}</span>", "ja445:2.3": "<span class='verse-line'>{}</span>", "ja445:2.4": "<span class='verse-line'>{}</span></p>", "ja445:3.1": "<p><span class='verse-line'>{}</span>", "ja445:3.2": "<span class='verse-line'>{}</span>", "ja445:3.3": "<span class='verse-line'>{}</span>", "ja445:3.4": "<span class='verse-line'>{}</span></p>", "ja445:4.1": "<p><span class='verse-line'>{}</span>", "ja445:4.2": "<span class='verse-line'>{}</span>", "ja445:4.3": "<span class='verse-line'>{}</span>", "ja445:4.4": "<span class='verse-line'>{}</span></p>", "ja445:5.1": "<p><span class='verse-line'>{}</span>", "ja445:5.2": "<span class='verse-line'>{}</span>", "ja445:5.3": "<span class='verse-line'>{}</span>", "ja445:5.4": "<span class='verse-line'>{}</span>", "ja445:5.5": "<span class='verse-line'>{}</span>", "ja445:5.6": "<span class='verse-line'>{}</span></p>", "ja445:6.1": "<p><span class='verse-line'>{}</span>", "ja445:6.2": "<span class='verse-line'>{}</span>", "ja445:6.3": "<span class='verse-line'>{}</span>", "ja445:6.4": "<span class='verse-line'>{}</span></p>", "ja445:7.1": "<p><span class='verse-line'>{}</span>", "ja445:7.2": "<span class='verse-line'>{}</span>", "ja445:7.3": "<span class='verse-line'>{}</span>", "ja445:7.4": "<span class='verse-line'>{}</span></p>", "ja445:8.1": "<p><span class='verse-line'>{}</span>", "ja445:8.2": "<span class='verse-line'>{}</span>", "ja445:8.3": "<span class='verse-line'>{}</span>", "ja445:8.4": "<span class='verse-line'>{}</span></p>", "ja445:9.1": "<p><span class='verse-line'>{}</span>", "ja445:9.2": "<span class='verse-line'>{}</span>", "ja445:9.3": "<span class='verse-line'>{}</span>", "ja445:9.4": "<span class='verse-line'>{}</span></p>", "ja445:10.1": "<p><span class='verse-line'>{}</span>", "ja445:10.2": "<span class='verse-line'>{}</span>", "ja445:10.3": "<span class='verse-line'>{}</span>", "ja445:10.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja445:11.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja445:0.1": "Jātaka ", "ja445:0.2": "Dasakanipāta ", "ja445:0.3": "Catudvāravagga ", "ja445:0.4": "7. Nigrodhajātaka ", "ja445:1.1": "“Na vāhametaṁ jānāmi, ", "ja445:1.2": "ko vāyaṁ kassa vāti vā; ", "ja445:1.3": "Yathā sākho cari evaṁ, ", "ja445:1.4": "nigrodha kinti maññasi. ", "ja445:2.1": "Tato galavinītena, ", "ja445:2.2": "purisā nīhariṁsu maṁ; ", "ja445:2.3": "Datvā mukhapahārāni, ", "ja445:2.4": "sākhassa vacanaṅkarā. ", "ja445:3.1": "Etādisaṁ dummatinā, ", "ja445:3.2": "akataññuna dubbhinā; ", "ja445:3.3": "Kataṁ anariyaṁ sākhena, ", "ja445:3.4": "sakhinā te janādhipa”. ", "ja445:4.1": "“Na vāhametaṁ jānāmi, ", "ja445:4.2": "napi me koci saṁsati; ", "ja445:4.3": "Yaṁ me tvaṁ samma akkhāsi, ", "ja445:4.4": "sākhena kāraṇaṁ kataṁ. ", "ja445:5.1": "Sakhīnaṁ sājīvakaro, ", "ja445:5.2": "mama sākhassa cūbhayaṁ; ", "ja445:5.3": "Tvaṁ nosissariyaṁ dātā, ", "ja445:5.4": "manussesu mahantataṁ; ", "ja445:5.5": "Tayāmā labbhitā iddhī, ", "ja445:5.6": "ettha me natthi saṁsayo. ", "ja445:6.1": "Yathāpi bījamaggimhi, ", "ja445:6.2": "ḍayhati na virūhati; ", "ja445:6.3": "Evaṁ kataṁ asappurise, ", "ja445:6.4": "nassati na virūhati. ", "ja445:7.1": "Kataññumhi ca posamhi, ", "ja445:7.2": "Sīlavante ariyavuttine; ", "ja445:7.3": "Sukhette viya bījāni, ", "ja445:7.4": "Kataṁ tamhi na nassati”. ", "ja445:8.1": "“Imaṁ jammaṁ nekatikaṁ, ", "ja445:8.2": "asappurisacintakaṁ; ", "ja445:8.3": "Hanantu sākhaṁ sattīhi, ", "ja445:8.4": "nāssa icchāmi jīvitaṁ”. ", "ja445:9.1": "“Khamatassa mahārāja, ", "ja445:9.2": "Pāṇā na paṭiānayā; ", "ja445:9.3": "Khama deva asappurisassa, ", "ja445:9.4": "Nāssa icchāmahaṁ vadhaṁ”. ", "ja445:10.1": "“Nigrodhameva seveyya, ", "ja445:10.2": "na sākhamupasaṁvase; ", "ja445:10.3": "Nigrodhasmiṁ mataṁ seyyo, ", "ja445:10.4": "yañce sākhasmi jīvitan”ti. ", "ja445:11.1": "Nigrodhajātakaṁ sattamaṁ. "}, "variant_text": {"ja445:0.1": "", "ja445:0.2": "", "ja445:0.3": "", "ja445:0.4": "", "ja445:1.1": "Na vāhametaṁ → na cāhametaṁ (bj) ", "ja445:1.2": "kassa vāti vā → cāti vā (bj); cāri vā (sya1ed, sya2ed) ", "ja445:1.3": "cari → vadī (bj, pts-vp-pli1); vadi (sya1ed, sya2ed) ", "ja445:1.4": "", "ja445:2.1": "", "ja445:2.2": "", "ja445:2.3": "", "ja445:2.4": "", "ja445:3.1": "", "ja445:3.2": "", "ja445:3.3": "", "ja445:3.4": "", "ja445:4.1": "", "ja445:4.2": "", "ja445:4.3": "", "ja445:4.4": "kāraṇaṁ → kaḍḍhanaṁ (bj, sya1ed, sya2ed); katanaṁ (pts-vp-pli1) ", "ja445:5.1": "", "ja445:5.2": "", "ja445:5.3": "", "ja445:5.4": "", "ja445:5.5": "", "ja445:5.6": "", "ja445:6.1": "", "ja445:6.2": "", "ja445:6.3": "", "ja445:6.4": "", "ja445:7.1": "", "ja445:7.2": "", "ja445:7.3": "", "ja445:7.4": "", "ja445:8.1": "", "ja445:8.2": "", "ja445:8.3": "", "ja445:8.4": "", "ja445:9.1": "", "ja445:9.2": "na paṭiānayā → duppaṭiānayā (bj, sya1ed, sya2ed, pts-vp-pli1) ", "ja445:9.3": "", "ja445:9.4": "", "ja445:10.1": "", "ja445:10.2": "", "ja445:10.3": "", "ja445:10.4": "", "ja445:11.1": ""}, "reference_text": {"ja445:0.1": "", "ja445:0.2": "", "ja445:0.3": "", "ja445:0.4": "", "ja445:1.1": "bj30.364, ms22J_1986, msdiv72, pts-vp-pli4.41", "ja445:1.2": "", "ja445:1.3": "", "ja445:1.4": "", "ja445:2.1": "dr27.283, ms22J_1987, msdiv73", "ja445:2.2": "", "ja445:2.3": "", "ja445:2.4": "", "ja445:3.1": "ms22J_1988, msdiv74", "ja445:3.2": "", "ja445:3.3": "", "ja445:3.4": "", "ja445:4.1": "ms22J_1989, msdiv75, pts-vp-pli4.42", "ja445:4.2": "", "ja445:4.3": "", "ja445:4.4": "", "ja445:5.1": "ms22J_1990, msdiv76, sya27.285"