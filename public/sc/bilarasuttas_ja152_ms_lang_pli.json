{"html_text": {"ja152:0.1": "<article id='ja152'><header><ul><li class='division'>{}</li>", "ja152:0.2": "<li>{}</li>", "ja152:0.3": "<li>{}</li></ul>", "ja152:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja152:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja152:1.2": "<span class='verse-line'>{}</span>", "ja152:1.3": "<span class='verse-line'>{}</span>", "ja152:1.4": "<span class='verse-line'>{}</span></p>", "ja152:2.1": "<p><span class='verse-line'>{}</span>", "ja152:2.2": "<span class='verse-line'>{}</span>", "ja152:2.3": "<span class='verse-line'>{}</span>", "ja152:2.4": "<span class='verse-line'>{}</span>", "ja152:2.5": "<span class='verse-line'>{}</span>", "ja152:2.6": "<span class='verse-line'>{}</span></p></blockquote>", "ja152:3.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja152:0.1": "Jātaka ", "ja152:0.2": "Dukanipāta ", "ja152:0.3": "Daḷhavagga ", "ja152:0.4": "2. Siṅgālajātaka ", "ja152:1.1": "“Asamekkhitakammantaṁ, ", "ja152:1.2": "turitābhinipātinaṁ; ", "ja152:1.3": "Sāni kammāni tappenti, ", "ja152:1.4": "uṇhaṁvajjhohitaṁ mukhe”. ", "ja152:2.1": "“Sīho ca sīhanādena, ", "ja152:2.2": "daddaraṁ abhinādayi; ", "ja152:2.3": "Sutvā sīhassa nigghosaṁ, ", "ja152:2.4": "siṅgālo daddare vasaṁ; ", "ja152:2.5": "Bhīto santāsamāpādi, ", "ja152:2.6": "hadayañcassa apphalī”ti. ", "ja152:3.1": "Siṅgālajātakaṁ dutiyaṁ. "}, "variant_text": {"ja152:0.1": "", "ja152:0.2": "", "ja152:0.3": "", "ja152:0.4": "", "ja152:1.1": "", "ja152:1.2": "", "ja152:1.3": "", "ja152:1.4": "", "ja152:2.1": "", "ja152:2.2": "", "ja152:2.3": "", "ja152:2.4": "siṅgālo → sigālo (bj, sya1ed, sya2ed, pts-vp-pli1) ", "ja152:2.5": "", "ja152:2.6": "", "ja152:3.1": "Siṅgālajātakaṁ → sigālajātakaṁ (bj, sya1ed, sya2ed, pts-vp-pli1) "}, "reference_text": {"ja152:0.1": "", "ja152:0.2": "", "ja152:0.3": "", "ja152:0.4": "", "ja152:1.1": "ms22J_343, msdiv3, pts-vp-pli2.7", "ja152:1.2": "", "ja152:1.3": "", "ja152:1.4": "", "ja152:2.1": "ms22J_344, msdiv