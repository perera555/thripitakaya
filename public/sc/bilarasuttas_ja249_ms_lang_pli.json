{"html_text": {"ja249:0.1": "<article id='ja249'><header><ul><li class='division'>{}</li>", "ja249:0.2": "<li>{}</li>", "ja249:0.3": "<li>{}</li></ul>", "ja249:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja249:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja249:1.2": "<span class='verse-line'>{}</span>", "ja249:1.3": "<span class='verse-line'>{}</span>", "ja249:1.4": "<span class='verse-line'>{}</span></p>", "ja249:2.1": "<p><span class='verse-line'>{}</span>", "ja249:2.2": "<span class='verse-line'>{}</span>", "ja249:2.3": "<span class='verse-line'>{}</span>", "ja249:2.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja249:3.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja249:0.1": "Jātaka ", "ja249:0.2": "Dukanipāta ", "ja249:0.3": "Siṅgālavagga ", "ja249:0.4": "9. Sālakajātaka ", "ja249:1.1": "“Ekaputtako bhavissasi, ", "ja249:1.2": "Tvañca no hessasi issaro kule; ", "ja249:1.3": "Oroha dumasmā sālaka, ", "ja249:1.4": "Ehi dāni gharakaṁ vajemase”. ", "ja249:2.1": "“Nanu maṁ suhadayoti maññasi, ", "ja249:2.2": "Yañca maṁ hanasi veḷuyaṭṭhiyā; ", "ja249:2.3": "Pakkambavane ramāmase, ", "ja249:2.4": "Gaccha tvaṁ gharakaṁ yathāsukhan”ti. ", "ja249:3.1": "Sālakajātakaṁ navamaṁ. "}, "variant_text": {"ja249:0.1": "", "ja249:0.2": "", "ja249:0.3": "", "ja249:0.4": "", "ja249:1.1": "", "ja249:1.2": "", "ja249:1.3": "", "ja249:1.4": "", "ja249:2.1": "Nanu maṁ suhadayoti → nanu maṁ hadayeti (bj, pts-vp-pli1) ", "ja249:2.2": "", "ja249:2.3": "", "ja249:2.4": "", "ja249:3.1": ""}, "reference_text": {"ja249:0.1": "", "ja249:0.2": "", "ja249:0.3": "", "ja249:0.4": "", "ja249:1.1": "ms22J_659, msdiv198, pts-vp-pli2.267, pts-vp-pli2.268, vri68.62", "ja249:1.2": "", "ja249:1.3": "", "ja249:1.4": "", "ja249:2.1": "dr27.96, ms22J_660, msdiv199", "ja249:2.2": "", "ja249:2.3": "", "ja249:2.4": "", "ja249:3.1": "ms22J_661"}, "keys_order": ["ja249:0.1", "ja249:0.2", "ja249:0.3", "ja249:0.4", "ja249:1.1", "ja249:1.2", "ja249:1.3"