[{"acronym": "Ja 14", "alt_acronym": null, "volpages": "PTS 1.158", "alt_volpages": null, "uid": "ja14", "blurb": "“There’s nothing worse.” This story was told by the Master while at Jetavana, about the Elder Tissa, called Direct-alms the Less. Tradition says that, while the Master was dwelling at the Bamboo-grove near Rajagaha, the scion of a wealthy house, Prince Tissa by name, coming one day to the Bamboo-grove and there hearing a discourse from the Master, wished to join the Brotherhood, but, being refused because his parents would not give their consent, obtained their consent by following Rattha-pala’s example and refusing food for seven days, and finally took the vows with the Master.", "difficulty": null, "original_title": "Vātamigajātaka", "root_lang": "pli", "root_lang_name": "Pāli", "type": "leaf", "translated_title": "The Wind-antelope ", "translations": [{"lang": "pli", "lang_name": "Pāli", "is_root": true, "author": "Mahāsaṅgīti Tipiṭaka Buddhavasse 2500", "author_short": "ms", "author_uid": "ms", "publication_date": null, "id": "ja14_root-pli-ms", "segmented": true, "title": null, "volpage": null, "has_comment": false}, {"lang": "de", "lang_name": "Deutsch", "is_root": false, "author": "Sabbamitta", "author_short": "sabbamitta", "author_uid": "sabbamitta", "publication_date": null, "id": "ja14_translation-de-sabbamitta", "segmented": true, "title": "Der Windhirsch ", "volpage": null, "has_comment": true}, {"lang": "de", "lang_name": "Deutsch", "is_root": false, "author": "Dr. Julius Dutoit", "author_short": "Dutoit", "author_uid": "dutoit", "publication_date": "2007", "id": "de_ja14_dutoit", "segmented": false, "volpage": null, "has_comment": false}, {"lang": "en", "lang_name": "English", "is_root": false, "author": "Bhikkhu Sujato", "author_short": "sujato", "author_uid": "sujato", "publication_date": null, "id": "ja14_translation-en-sujato", "segmented": true, "title": "The Wind-antelope ", "volpage": null, "has_comment": true}, {"author": "Robert C