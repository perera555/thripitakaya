{"html_text": {"ja336:0.1": "<article id='ja336'><header><ul><li class='division'>{}</li>", "ja336:0.2": "<li>{}</li>", "ja336:0.3": "<li>{}</li></ul>", "ja336:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja336:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja336:1.2": "<span class='verse-line'>{}</span>", "ja336:1.3": "<span class='verse-line'>{}</span>", "ja336:1.4": "<span class='verse-line'>{}</span></p>", "ja336:2.1": "<p><span class='verse-line'>{}</span>", "ja336:2.2": "<span class='verse-line'>{}</span>", "ja336:2.3": "<span class='verse-line'>{}</span>", "ja336:2.4": "<span class='verse-line'>{}</span></p>", "ja336:3.1": "<p><span class='verse-line'>{}</span>", "ja336:3.2": "<span class='verse-line'>{}</span>", "ja336:3.3": "<span class='verse-line'>{}</span>", "ja336:3.4": "<span class='verse-line'>{}</span>", "ja336:3.5": "<span class='verse-line'>{}</span></p>", "ja336:4.1": "<p><span class='verse-line'>{}</span>", "ja336:4.2": "<span class='verse-line'>{}</span>", "ja336:4.3": "<span class='verse-line'>{}</span>", "ja336:4.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja336:5.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja336:0.1": "Jātaka ", "ja336:0.2": "Catukkanipāta ", "ja336:0.3": "Kokilavagga ", "ja336:0.4": "6. Brahāchattajātaka ", "ja336:1.1": "“Tiṇaṁ tiṇanti lapasi, ", "ja336:1.2": "ko nu te tiṇamāhari; ", "ja336:1.3": "Kiṁ nu te tiṇakiccatthi, ", "ja336:1.4": "tiṇameva pabhāsasi”. ", "ja336:2.1": "“Idhāgamā brahmacārī, ", "ja336:2.2": "brahā chatto bahussuto; ", "ja336:2.3": "So me sabbaṁ samādāya, ", "ja336:2.4": "tiṇaṁ nikkhippa gacchati”. ", "ja336:3.1": "“Evetaṁ hoti kattabbaṁ, ", "ja336:3.2": "appena bahumicchatā; ", "ja336:3.3": "Sabbaṁ sakassa ādānaṁ, ", "ja336:3.4": "anādānaṁ tiṇassa ca”. ", "ja336:3.5": "(…) ", "ja336:4.1": "“Sīlavanto na kubbanti, ", "ja336:4.2": "bālo sīlāni kubbati; ", "ja336:4.3": "Aniccasīlaṁ dussīlyaṁ, ", "ja336:4.4": "kiṁ paṇḍiccaṁ karissatī”ti. ", "ja336:5.1": "Brahāchattajātakaṁ chaṭṭhaṁ. "}, "variant_text": {"ja336:0.1": "", "ja336:0.2": "", "ja336:0.3": "", "ja336:0.4": "", "ja336:1.1": "", "ja336:1.2": "", "ja336:1.3": "", "ja336:1.4": "me → so ve (mr) ", "ja336:2.1": "", "ja336:2.2": "", "ja336:2.3": "", "ja336:2.4": "", "ja336:3.1": "", "ja336:3.2": "", "ja336:3.3": "", "ja336:3.4": "", "ja336:3.5": "(…) → (cāṭīsu pakkhipitvāna tattha kā paridevanā) (bj, mr); (tiṇassa cāṭīsu gato, tattha kā paridevanā) (sya1ed, sya2ed) ", "ja336:4.1": "", "ja336:4.2": "", "ja336:4.3": "dussīlyaṁ → dussīlaṁ (si, pts-vp-pli1) ", "ja336:4.4": "", "ja336:5.1": ""}, "reference_text": {"ja336:0.1": "", "ja336:0.2": "", "ja336:0.3": "", "ja336:0.4": "", "ja336:1.1": "bj30.192, ms22J_1064, msdiv141, pts-vp-pli3.117, sya27.153", "ja336:1.2": "", "ja336:1.3": "", "ja336:1.4": "", "ja336:2.1": "ms22J_1065, msdiv142", "ja336:2.2": "", "ja336:2.3": "", "ja336:2.4": "", "ja336:3.1": "dr27.153, ms22J_1066, msdiv143, pts-vp-pli3.118", "ja336:3.2": "", "ja336:3.3": "", "ja336:3.4": "", "ja336:3.5": "", "ja336:4.1": "csp1ed22.112, csp2ed22.112, ms22J_1067, msdiv144, vri68.96", "ja336:4.2": "", "ja336:4.3": "", "ja336:4.4": "", "ja336:5.1": "ms22J_1068"}, "keys_order": ["ja336:0.1", "ja336:0.2", "ja336:0.3", "ja336:0.4", "ja336:1.1", "ja336:1.2", "ja336:1.3", "ja336:1.4", "ja336:2.1", "ja336:2.2", "ja336:2.3", "ja336:2.4", "ja336:3.1", "ja336:3.2", "ja336:3.3", "ja336:3.4", "ja336:3.5", "ja336:4.1", "ja336:4.2", "ja336:4.3", "ja336:4.4", "ja336:5.1"]}