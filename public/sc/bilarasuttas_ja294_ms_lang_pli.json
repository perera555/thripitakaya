{"html_text": {"ja294:0.1": "<article id='ja294'><header><ul><li class='division'>{}</li>", "ja294:0.2": "<li>{}</li>", "ja294:0.3": "<li>{}</li></ul>", "ja294:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja294:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja294:1.2": "<span class='verse-line'>{}</span>", "ja294:1.3": "<span class='verse-line'>{}</span>", "ja294:1.4": "<span class='verse-line'>{}</span></p>", "ja294:2.1": "<p><span class='verse-line'>{}</span>", "ja294:2.2": "<span class='verse-line'>{}</span>", "ja294:2.3": "<span class='verse-line'>{}</span>", "ja294:2.4": "<span class='verse-line'>{}</span></p>", "ja294:3.1": "<p><span class='verse-line'>{}</span>", "ja294:3.2": "<span class='verse-line'>{}</span>", "ja294:3.3": "<span class='verse-line'>{}</span>", "ja294:3.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja294:4.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja294:0.1": "Jātaka ", "ja294:0.2": "Tikanipāta ", "ja294:0.3": "Kumbhavagga ", "ja294:0.4": "4. Jambukhādakajātaka ", "ja294:1.1": "“Koyaṁ bindussaro vaggu, ", "ja294:1.2": "saravantānamuttamo; ", "ja294:1.3": "Accuto jambusākhāya, ", "ja294:1.4": "moracchāpova kūjati”. ", "ja294:2.1": "“Kulaputtova jānāti, ", "ja294:2.2": "kulaputtaṁ pasaṁsituṁ; ", "ja294:2.3": "Byagghacchāpasarīvaṇṇa, ", "ja294:2.4": "bhuñja samma dadāmi te”. ", "ja294:3.1": "“Cirassaṁ vata passāmi, ", "ja294:3.2": "musāvādī samāgate; ", "ja294:3.3": "Vantādaṁ kuṇapādañca, ", "ja294:3.4": "aññamaññaṁ pasaṁsake”ti. ", "ja294:4.1": "Jambukhādakajātakaṁ catutthaṁ. "}, "variant_text": {"ja294:0.1": "", "ja294:0.2": "", "ja294:0.3": "", "ja294:0.4": "", "ja294:1.1": "", "ja294:1.2": "saravantānamuttamo → pavadantānamuttamo (bj, pts-vp-pli1) ", "ja294:1.3": "", "ja294:1.4": "", "ja294:2.1": "Kulaputtova jānāti → kulaputto pajānāti (sya1ed, sya2ed, mr) ", "ja294:2.2": "kulaputtaṁ → kulaputte (bj, pts-vp-pli1) ", "ja294:2.3": "", "ja294:2.4": "", "ja294:3.1": "", "ja294:3.2": "", "ja294:3.3": "", "ja294:3.4": "", "ja294:4.1": ""}, "reference_text": {"ja294:0.1": "", "ja294:0.2": "", "ja294:0.3": "", "ja294:0.4": "", "ja294:1.1": "bj30.156, ms22J_850, msdiv130, pts-vp-pli2.439", "ja294:1.2": "", "ja294:1.3": "", "ja294:1.4": "", "ja294:2.1": "ms22J_851, msdiv131", "ja294:2.2": "", "ja294:2.3": "", "ja294:2.4": "", "ja294:3.1": "dr27.124, ms22J_852, msdiv132, ndp22.83", "ja294:3.2": "", "ja294:3.3": "", "ja294:3.4": "", "ja294:4.1": "ms22J_853"}, "keys_order": ["ja294:0.1", "ja294:0.2", "ja294:0.3", "ja294:0.4", "ja294:1.1", "ja294:1.2", "ja294:1.3", "ja294:1.4", "ja294:2.1", "ja294:2.2", "ja294:2.3", "ja294:2.4", "ja294:3.1", "ja294:3.2", "ja294:3.3", "ja294:3.4", "ja294:4.1"]}