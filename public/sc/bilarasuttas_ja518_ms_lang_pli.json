 "ja518:27.3": "<span class='verse-line'>{}</span>", "ja518:27.4": "<span class='verse-line'>{}</span></p>", "ja518:28.1": "<p><span class='verse-line'>{}</span>", "ja518:28.2": "<span class='verse-line'>{}</span>", "ja518:28.3": "<span class='verse-line'>{}</span>", "ja518:28.4": "<span class='verse-line'>{}</span></p>", "ja518:29.1": "<p><span class='verse-line'>{}</span>", "ja518:29.2": "<span class='verse-line'>{}</span>", "ja518:29.3": "<span class='verse-line'>{}</span>", "ja518:29.4": "<span class='verse-line'>{}</span></p>", "ja518:30.1": "<p><span class='verse-line'>{}</span>", "ja518:30.2": "<span class='verse-line'>{}</span>", "ja518:30.3": "<span class='verse-line'>{}</span>", "ja518:30.4": "<span class='verse-line'>{}</span></p>", "ja518:31.1": "<p><span class='verse-line'>{}</span>", "ja518:31.2": "<span class='verse-line'>{}</span>", "ja518:31.3": "<span class='verse-line'>{}</span>", "ja518:31.4": "<span class='verse-line'>{}</span></p>", "ja518:32.1": "<p><span class='verse-line'>{}</span>", "ja518:32.2": "<span class='verse-line'>{}</span>", "ja518:32.3": "<span class='verse-line'>{}</span>", "ja518:32.4": "<span class='verse-line'>{}</span></p>", "ja518:33.1": "<p><span class='verse-line'>{}</span>", "ja518:33.2": "<span class='verse-line'>{}</span>", "ja518:33.3": "<span class='verse-line'>{}</span>", "ja518:33.4": "<span class='verse-line'>{}</span></p>", "ja518:34.1": "<p><span class='verse-line'>{}</span>", "ja518:34.2": "<span class='verse-line'>{}</span>", "ja518:34.3": "<span class='verse-line'>{}</span>", "ja518:34.4": "<span class='verse-line'>{}</span></p>", "ja518:35.1": "<p><span class='verse-line'>{}</span>", "ja518:35.2": "<span class='verse-line'>{}</span>", "ja518:35.3": "<span class='verse-line'>{}</span>", "ja518:35.4": "<span class='verse-line'>{}</span></p>", "ja518:36.1": "<p><span class='verse-line'>{}</span>", "ja518:36.2": "<span class='verse-line'>{}</span>", "ja518:36.3": "<span class='verse-line'>{}</span>", "ja518:36.4": "<span class='verse-line'>{}</span></p>", "ja518:37.1": "<p><span class='verse-line'>{}</span>", "ja518:37.2": "<span class='verse-line'>{}</span>", "ja518:37.3": "<span class='verse-line'>{}</span>", "ja518:37.4": "<span class='verse-line'>{}</span></p>", "ja518:38.1": "<p><span class='verse-line'>{}</span>", "ja518:38.2": "<span class='verse-line'>{}</span>", "ja518:38.3": "<span class='verse-line'>{}</span>", "ja518:38.4": "<span class='verse-line'>{}</span></p>", "ja518:39.1": "<p><span class='verse-line'>{}</span>", "ja518:39.2": "<span class='verse-line'>{}</span>", "ja518:39.3": "<span class='verse-line'>{}</span>", "ja518:39.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja518:40.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja518:0.1": "Jātaka ", "ja518:0.2": "Tiṁsanipāta ", "ja518:0.3": "Kiṁchandavagga ", "ja518:0.4": "8. Paṇḍaranāgarājajātaka ", "ja518:1.1": "“Vikiṇṇavācaṁ aniguyha mantaṁ, ", "ja518:1.2": "Asaññataṁ aparicakkhitāraṁ; ", "ja518:1.3": "Bhayaṁ tamanveti sayaṁ abodhaṁ, ", "ja518:1.4": "Nāgaṁ yathā paṇḍarakaṁ supaṇṇo. ", "ja518:2.1": "Yo guyhamantaṁ parirakkhaṇeyyaṁ, ", "ja518:2.2": "Mohā naro saṁsati hāsamāno; ", "ja518:2.3": "Taṁ bhinnamantaṁ bhayamanveti khippaṁ, ", "ja518:2.4": "Nāgaṁ yathā paṇḍarakaṁ supaṇṇo. ", "ja518:3.1": "Nānumitto garuṁ atthaṁ, ", "ja518:3.2": "guyhaṁ veditumarahati; ", "ja518:3.3": "Sumitto ca asambuddhaṁ, ", "ja518:3.4": "sambuddhaṁ vā anatthavā. ", "ja518:4.1": "Vissāsamāpajjimahaṁ acelaṁ, ", "ja518:4.2": "Samaṇo ayaṁ sammato bhāvitatto; ", "ja518:4.3": "Tassāhamakkhiṁ vivariṁ guyhamatthaṁ, ", "ja518:4.4": "Atītamattho kapaṇaṁ rudāmi. ", "ja518:5.1": "Tassāhaṁ paramaṁ brahme guyhaṁ, ", "ja518:5.2": "Vācañhi maṁ nāsakkhiṁ saṁyametuṁ; ", "ja518:5.3": "Tappakkhato hi bhayamāgataṁ mamaṁ, ", "ja518:5.4": "Atītamattho kapaṇaṁ rudāmi. ", "ja518:6.1": "Yo ve naro suhadaṁ maññamāno, ", "ja518:6.2": "Guyhamatthaṁ saṁsati dukkulīne; ", "ja518:6.3": "Dosā bhayā athavā rāgarattā, ", "ja518:6.4": "Pallatthito bālo asaṁsayaṁ so. ", "ja518:7.1": "Tirokkhavāco asataṁ paviṭṭho, ", "ja518:7.2": "Yo saṅgatīsu mudīreti vākyaṁ; ", "ja518:7.3": "Āsīviso dummukhotyāhu taṁ naraṁ, ", "ja518:7.4": "Ārā ārā saṁyame tādisamhā. ", "ja518:8.1": "Annaṁ pānaṁ kāsikacandanañca, ", "ja518:8.2": "Manāpitthiyo mālamucchādanañca; ", "ja518:8.3": "Ohāya gacchāmase sabbakāme, ", "ja518:8.4": "Supaṇṇa pāṇūpagatāva tyamhā”. ", "ja518:9.1": "“Ko nīdha tiṇṇaṁ garahaṁ upeti, ", "ja518:9.2": "Asmiṁdhaloke pāṇabhū nāgarāja; ", "ja518:9.3": "Samaṇo supaṇṇo athavā tvameva, ", "ja518:9.4": "Kiṁ kāraṇā paṇḍarakaggahīto”. ", "ja518:10.1": "“Samaṇoti me sammatatto ahosi, ", "ja518:10.2": "Piyo ca me manasā bhāvitatto; ", "ja518:10.3": "Tassāhamakkhiṁ vivariṁ guyhamatthaṁ, ", "ja518:10.4": "Atītamattho kapaṇaṁ rudāmi”. ", "ja518:11.1": "“Na catthi satto amaro pathabyā, ", "ja518:11.2": "Paññāvidhā natthi na ninditabbā; ", "ja518:11.3": "Saccena dhammena dhitiyā damena, ", "ja518:11.4": "Alabbhamabyāharatī naro idha. ", "ja518:12.1": "Mātāpitā paramā bandhavānaṁ, ", "ja518:12.2": "Nāssa tatiyo anukampakatthi; ", "ja518:12.3": "Tesampi guyhaṁ paramaṁ na saṁse, ", "ja518:12.4": "Mantassa bhedaṁ parisaṅkamāno. ", "ja518:13.1": "Mātāpitā bhaginī bhātaro ca, ", "ja518:13.2": "Sahāyā vā yassa honti sapakkhā; ", "ja518:13.3": "Tesampi guyhaṁ paramaṁ na saṁse, ", "ja518:13.4": "Mantassa bhedaṁ parisaṅkamāno. ", "ja518:14.1": "Bhariyā ce purisaṁ vajjā, ", "ja518:14.2": "Komārī piyabhāṇinī; ", "ja518:14.3": "Puttarūpayasūpetā, ", "ja518:14.4": "Ñātisaṅghapurakkhatā; ", "ja518:14.5": "Tassāpi guyhaṁ paramaṁ na saṁse, ", "ja518:14.6": "Mantassa bhedaṁ parisaṅkamāno. ", "ja518:15.1": "Na guyhamatthaṁ vivareyya, ", "ja518:15.2": "Rakkheyya naṁ yathā nidhiṁ; ", "ja518:15.3": "Na hi pātukato sādhu, ", "ja518:15.4": "Guyho attho pajānatā. ", "ja518:16.1": "Thiyā guyhaṁ na saṁseyya, ", "ja518:16.2": "amittassa ca paṇḍito; ", "ja518:16.3": "Yo cāmisena saṁhīro, ", "ja518:16.4": "hadayattheno ca yo naro. ", "ja518:17.1": "Guyhamatthaṁ asambuddhaṁ, ", "ja518:17.2": "sambodhayati yo naro; ", "ja518:17.3": "Mantabhedabhayā tassa, ", "ja518:17.4": "dāsabhūto titikkhati. ", "ja518:18.1": "Yāvanto purisassatthaṁ, ", "ja518:18.2": "guyhaṁ jānanti mantinaṁ; ", "ja518:18.3": "Tāvanto tassa ubbegā, ", "ja518:18.4": "tasmā guyhaṁ na vissaje. ", "ja518:19.1": "Vivicca bhāseyya divā rahassaṁ, ", "ja518:19.2": "Rattiṁ giraṁ nātivelaṁ pamuñce; ", "ja518:19.3": "Upassutikā hi suṇanti mantaṁ, ", "ja518:19.4": "Tasmā manto khippamupeti bhedaṁ. ", "ja518:20.1": "Yathāpi assa nagaraṁ mahantaṁ, ", "ja518:20.2": "Advārakaṁ āyasaṁ bhaddasālaṁ; ", "ja518:20.3": "Samantakhātāparikhāupetaṁ, ", "ja518:20.4": "Evampi me te idha guyhamantā. ", "ja518:21.1": "Ye guyhamantā avikiṇṇavācā, ", "ja518:21.2": "Daḷhā sadatthesu narā dujivha; ", "ja518:21.3": "Ārā amittā byavajanti tehi, ", "ja518:21.4": "Āsīvisā vā riva sattusaṅghā”. ", "ja518:22.1": "“Hitvā gharaṁ pabbajito acelo, ", "ja518:22.2": "Naggo muṇḍo carati ghāsahetu; ", "ja518:22.3": "Tamhi nu kho vivariṁ guyhamatthaṁ, ", "ja518:22.4": "Atthā ca dhammā ca apaggatamhā. ", "ja518:23.1": "Kathaṅkaro hoti supaṇṇarāja, ", "ja518:23.2": "Kiṁsīlo kena vatena vattaṁ; ", "ja518:23.3": "Samaṇo caraṁ hitvā mamāyitāni, ", "ja518:23.4": "Kathaṅkaro saggamupeti ṭhānaṁ”. ", "ja518:24.1": "“Hiriyā titikkhāya damenupeto, ", "ja518:24.2": "Akkodhano pesuṇiyaṁ pahāya; ", "ja518:24.3": "Samaṇo caraṁ hitvā mamāyitāni, ", "ja518:24.4": "Evaṅkaro saggamupeti ṭhānaṁ”. ", "ja518:25.1": "“Mātāva puttaṁ taruṇaṁ tanujjaṁ, ", "ja518:25.2": "Samphassatā sabbagattaṁ phareti; ", "ja518:25.3": "Evampi me tvaṁ pāturahu dijinda, ", "ja518:25.4": "Mātāva puttaṁ anukampamāno”. ", "ja518:26.1": "“Handajja tvaṁ muñca vadhā dujivha, ", "ja518:26.2": "Tayo hi puttā na hi añño atthi; ", "ja518:26.3": "Antevāsī dinnako atrajo ca, ", "ja518:26.4": "Rajjassu puttaññataro me ahosi”. ", "ja518:27.1": "Icceva vākyaṁ visajjī supaṇṇo, ", "ja518:27.2": "Bhumyaṁ patiṭṭhāya dijo dujivhaṁ; ", "ja518:27.3": "“Muttajja tvaṁ sabbabhayātivatto, ", "ja518:27.4": "Thalūdake hohi mayābhigutto. ", "ja518:28.1": "Ātaṅkinaṁ yathā kusalo bhisakko, ", "ja518:28.2": "Pipāsitānaṁ rahadova sīto; ", "ja518:28.3": "Vesmaṁ yathā himasītaṭṭitānaṁ, ", "ja518:28.4": "Evampi te saraṇamahaṁ bhavāmi”. ", "ja518:29.1": "“Sandhiṁ katvā amittena, ", "ja518:29.2": "aṇḍajena jalābuja; ", "ja518:29.3": "Vivariya dāṭhaṁ sesi, ", "ja518:29.4": "kuto taṁ bhayamāgataṁ”. ", "ja518:30.1": "“Saṅketheva amittasmiṁ, ", "ja518:30.2": "mittasmimpi na vissase; ", "ja518:30.3": "Abhayā bhayamuppannaṁ, ", "ja518:30.4": "api mūlāni kantati. ", "ja518:31.1": "Kathaṁ nu vissase tyamhi, ", "ja518:31.2": "yenāsi kalaho kato; ", "ja518:31.3": "Niccayattena ṭhātabbaṁ, ", "ja518:31.4": "so disabbhi na rajjati. ", "ja518:32.1": "Vissāsaye na ca taṁ vissayeyya, ", "ja518:32.2": "Asaṅkito saṅkito ca bhaveyya; ", "ja518:32.3": "Tathā tathā viññū parakkameyya, ", "ja518:32.4": "Yathā yathā bhāvaṁ paro na jaññā”. ", "ja518:33.1": "Te devavaṇṇā sukhumālarūpā, ", "ja518:33.2": "Ubho samā sujayā puññakhandhā; ", "ja518:33.3": "Upāgamuṁ karampiyaṁ acelaṁ, ", "ja518:33.4": "Missībhūtā assavāhāva nāgā. ", "ja518:34.1": "Tato have paṇḍarako acelaṁ, ", "ja518:34.2": "Sayamevupāgamma idaṁ avoca; ", "ja518:34.3": "“Muttajjahaṁ sabbabhayātivatto, ", "ja518:34.4": "Na hi nūna tuyhaṁ manaso piyamhā”. ", "ja518:35.1": "“Piyo hi me āsi supaṇṇarājā, ", "ja518:35.2": "Asaṁsayaṁ paṇḍarakena saccaṁ; ", "ja518:35.3": "So rāgarattova akāsimetaṁ, ", "ja518:35.4": "Pāpakammaṁ sampajāno na mohā”. ", "ja518:36.1": "“Na me piyaṁ appiyaṁ vāpi hoti, ", "ja518:36.2": "Sampassato lokamimaṁ parañca; ", "ja518:36.3": "Susaññatānañhi viyañjanena, ", "ja518:36.4": "Asaññato lokamimaṁ carāsi. ", "ja518:37.1": "Ariyāvakāsosi anariyovāsi, ", "ja518:37.2": "Asaññato saññatasannikāso; ", "ja518:37.3": "Kaṇhābhijātikosi anariyarūpo, ", "ja518:37.4": "Pāpaṁ bahuṁ duccaritaṁ acāri. ", "ja518:38.1": "Aduṭṭhassa tuvaṁ dubbhi, ", "ja518:38.2": "dubbhī ca pisuṇo casi; ", "ja518:38.3": "Etena saccavajjena, ", "ja518:38.4": "muddhā te phalatu sattadhā”. ", "ja518:39.1": "“Tasmā hi mittānaṁ na dubbhitabbaṁ, ", "ja518:39.2": "Mittadubbhā pāpiyo natthi añño; ", "ja518:39.3": "Āsittasatto nihato pathabyā, ", "ja518:39.4": "Indassa vākyena hi saṁvaro hato”ti. ", "ja518:40.1": "Paṇḍaranāgarājajātakaṁ aṭṭhamaṁ. "}, "variant_text": {"ja518:0.1": "", "ja518:0.2": "", "ja518:0.3": "", "ja518:0.4": "", "ja518:1.1": "aniguyha → anigūḷha (pts-vp-pli1) | taṁ → naṁ (bj, sya1ed, sya2ed, pts-vp-pli1) ", "ja518:1.2": "aparicakkhitāraṁ → aparirakkhitāraṁ (mr) ", "ja518:1.3": "", "ja518:1.4": "supaṇṇo → suvaṇṇo (mr) ", "ja518:2.1": "", "ja518:2.2": "hāsamāno → bhāsamāno (pts-vp-pli1) ", "ja518:2.3": "hi → ha (pts-vp-pli1) ", "ja518:2.4": "", "ja518:3.1": "", "ja518:3.2": "", "ja518:3.3": "", "ja518:3.4": "", "ja518:4.1": "acelaṁ → acelo (bj, pts-vp-pli1) ", "ja518:4.2": "", "ja518:4.3": "vivariṁ → vivaraṁ (bj) | guyhamatthaṁ → guyhatthaṁ (mr) ", "ja518:4.4": "kapaṇaṁ → kapaṇo (pts-vp-pli1) ", "ja518:5.1": "paramaṁ → purimaṁ (bj) ", "ja518:5.2": "nāsakkhiṁ → nāsakkhi (pts-vp-pli1) ", "ja518:5.3": "", "ja518:5.4": "", "ja518:6.1": "", "ja518:6.2": "", "ja518:6.3": "rāgarattā → rāgaratto (bj, sya1ed, sya2ed, pts-vp-pli1) ", "ja518:6.4": "Pallatthito → pallitthito (sya1ed, sya2ed); pallittho (pts-vp-pli1); pallattito (mr) ", "ja518:7.1": "", "ja518:7.2": "", "ja518:7.3": "", "ja518:7.4": "ārā → ārā arā (pts-vp-pli1) ", "ja518:8.1": "kāsikacandanañca → kāsikaṁ cadanañ ca (pts-vp-pli1) ", "ja518:8.2": "", "ja518:8.3": "", "ja518:8.4": "", "ja518:9.1": "", "ja518:9.2": "", "ja518:9.3": "", "ja518:9.4": "", "ja518:10.1": "", "ja518:10.2": "", "ja518:10.3": "", "ja518:10.4": "", "ja518:11.1": "", "ja518:11.2": "", "ja518:11.3": "dhitiyā → dhiyā (bj, pts-vp-pli1) ", "ja518:11.4": "", "ja518:12.1": "", "ja518:12.2": "", "ja518:12.3": "", "ja518:12.4": "assa → ayo (sya1ed, sya2ed); aya (mr) ", "ja518:13.1": "", "ja518:13.2": "", "ja518:13.3": "", "ja518:13.4": "", 