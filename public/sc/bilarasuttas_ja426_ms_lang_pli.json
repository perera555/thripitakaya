{"html_text": {"ja426:0.1": "<article id='ja426'><header><ul><li class='division'>{}</li>", "ja426:0.2": "<li>{}</li>", "ja426:0.3": "<li>{}</li></ul>", "ja426:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja426:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja426:1.2": "<span class='verse-line'>{}</span>", "ja426:1.3": "<span class='verse-line'>{}</span>", "ja426:1.4": "<span class='verse-line'>{}</span></p>", "ja426:2.1": "<p><span class='verse-line'>{}</span>", "ja426:2.2": "<span class='verse-line'>{}</span>", "ja426:2.3": "<span class='verse-line'>{}</span>", "ja426:2.4": "<span class='verse-line'>{}</span></p>", "ja426:3.1": "<p><span class='verse-line'>{}</span>", "ja426:3.2": "<span class='verse-line'>{}</span>", "ja426:3.3": "<span class='verse-line'>{}</span>", "ja426:3.4": "<span class='verse-line'>{}</span></p>", "ja426:4.1": "<p><span class='verse-line'>{}</span>", "ja426:4.2": "<span class='verse-line'>{}</span>", "ja426:4.3": "<span class='verse-line'>{}</span>", "ja426:4.4": "<span class='verse-line'>{}</span></p>", "ja426:5.1": "<p><span class='verse-line'>{}</span>", "ja426:5.2": "<span class='verse-line'>{}</span>", "ja426:5.3": "<span class='verse-line'>{}</span>", "ja426:5.4": "<span class='verse-line'>{}</span></p>", "ja426:6.1": "<p><span class='verse-line'>{}</span>", "ja426:6.2": "<span class='verse-line'>{}</span>", "ja426:6.3": "<span class='verse-line'>{}</span>", "ja426:6.4": "<span class='verse-line'>{}</span></p>", "ja426:7.1": "<p><span class='verse-line'>{}</span>", "ja426:7.2": "<span class='verse-line'>{}</span>", "ja426:7.3": "<span class='verse-line'>{}</span>", "ja426:7.4": "<span class='verse-line'>{}</span></p>", "ja426:8.1": "<p><span class='verse-line'>{}</span>", "ja426:8.2": "<span class='verse-line'>{}</span>", "ja426:8.3": "<span class='verse-line'>{}</span>", "ja426:8.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja426:9.1": "<p class='endsutta'>{}</p>", "ja426:10.1": "<p class='endsection'>{}</p>", "ja426:11.1": "<p class='uddana-intro'>{}</p>", "ja426:12.1": "<blockquote class='uddanagatha'><p><span class='verse-line'>{}</span>", "ja426:12.2": "<span class='verse-line'>{}</span>", "ja426:12.3": "<span class='verse-line'>{}</span>", "ja426:12.4": "<span class='verse-line'>{}</span></p></blockquote></article>"}, "root_text": {"ja426:0.1": "Jātaka ", "ja426:0.2": "Aṭṭhakanipāta ", "ja426:0.3": "Kaccānivagga ", "ja426:0.4": "10. Dīpijātaka ", "ja426:1.1": "“Khamanīyaṁ yāpanīyaṁ, ", "ja426:1.2": "kacci mātula te sukhaṁ; ", "ja426:1.3": "Sukhaṁ te ammā avaca, ", "ja426:1.4": "sukhakāmāva te mayaṁ”. ", "ja426:2.1": "“Naṅguṭṭhaṁ me avakkamma, ", "ja426:2.2": "Heṭhayitvāna eḷike; ", "ja426:2.3": "Sājja mātulavādena, ", "ja426:2.4": "Muñcitabbā nu maññasi”. ", "ja426:3.1": "“Puratthāmukho nisinnosi, ", "ja426:3.2": "Ahaṁ te mukhamāgatā; ", "ja426:3.3": "Pacchato tuyhaṁ naṅguṭṭhaṁ, ", "ja426:3.4": "Kathaṁ khvāhaṁ avakkamiṁ”. ", "ja426:4.1": "“Yāvatā caturo dīpā, ", "ja426:4.2": "sasamuddā sapabbatā; ", "ja426:4.3": "Tāvatā mayhaṁ naṅguṭṭhaṁ, ", "ja426:4.4": "kathaṁ kho tvaṁ vivajjayi”. ", "ja426:5.1": "“Pubbeva metamakkhiṁsu, ", "ja426:5.2": "mātā pitā ca bhātaro; ", "ja426:5.3": "Dīghaṁ duṭṭhassa naṅguṭṭhaṁ, ", "ja426:5.4": "sāmhi vehāyasāgatā”. ", "ja426:6.1": "“Tañca disvāna āyantiṁ, ", "ja426:6.2": "antalikkhasmi eḷike; ", "ja426:6.3": "Migasaṅgho palāyittha, ", "ja426:6.4": "bhakkho me nāsito tayā”. ", "ja426:7.1": "“Iccevaṁ vilapantiyā, ", "ja426:7.2": "eḷakiyā ruhagghaso; ", "ja426:7.3": "Galakaṁ anvāvamaddi, ", "ja426:7.4": "natthi duṭṭhe subhāsitaṁ. ", "ja426:8.1": "Neva duṭṭhe nayo atthi, ", "ja426:8.2": "Na dhammo na subhāsitaṁ; ", "ja426:8.3": "Nikkamaṁ duṭṭhe yuñjetha, ", "ja426:8.4": "So ca sabbhiṁ na rañjatī”ti. ", "ja426:9.1": "Dīpijātakaṁ dasamaṁ. ", "ja426:10.1": "Aṭṭhakanipātaṁ niṭṭhitaṁ. ", "ja426:11.1": "Tassuddānaṁ ", "ja426:12.1": "Parisuddhā manāvilā vatthadharā, ", "ja426:12.2": "Bakarājassa kāyuraṁ daṇḍavaro; ", "ja426:12.3": "Atha aṅgāra cetiya devilinā, ", "ja426:12.4": "Atha āditta gaṅgā daseḷakināti. "}, "variant_text": {"ja426:0.1": "", "ja426:0.2": "", "ja426:0.3": "", "ja426:0.4": "", "ja426:1.1": "", "ja426:1.2": "", "ja426:1.3": "", "ja426:1.4": "sukhakāmāva → sukhakāmā hi (bj, sya1ed, sya2ed, pts-vp-pli1) ", "ja426:2.1": "avakkamma → apakkamma (sya1ed, sya2ed, mr) ", "ja426:2.2": "Heṭhayitvāna → pothayitvāna (mr) | eḷike → eḷaki (sya1ed, sya2ed); eḷiki (pts-vp-pli1) ", "ja426:2.3": "", "ja426:2.4": "", "ja426:3.1": "", "ja426:3.2": "", "ja426:3.3": "", "ja426:3.4": "avakkamiṁ → apakkamiṁ (mr) ", "ja426:4.1": "", "ja426:4.2": "", "ja426:4.3": "", "ja426:4.4": "", "ja426:5.1": "metamakkhiṁsu → metaṁ akkhaṁsu (bj, pts-vp-pli1); metaṁ akkhiṁsu (sya1ed, sya2ed) ", "ja426:5.2": "", "ja426:5.3": "", "ja426:5.4": "", "ja426:6.1": "", "ja426:6.2": "", "ja426:6.3": "", "ja426:6.4": "", "ja426:7.1": "", "ja426:7.2": "", "ja426:7.3": "", "ja426:7.4": "", "ja426:8.1": "", "ja426:8.2": "", "ja426:8.3": "", "ja426:8.4": "", "ja426:9.1": "", "ja426:10.1": "", "ja426:11.1": "", "ja426:12.1": "", "ja426:12.2": "", "ja426:12.3": "", "ja426:12.4": ""}, "reference_text": {"ja426:0.1": "", "ja426:0.2": "", "ja426:0.3": "", "ja426:0.4": "", "ja426:1.1": "ms22J_1769, msdiv88, pts-vp-pli3.480", "ja426:1.2": "", "ja426:1.3": "", "ja426:1.4": "", "ja426:2.1": "ms22J_1770, msdiv89", "ja426:2.2": "", "ja426:2.3": "", "ja426:2.4": "", "ja426:3.1": "ms22J_1771, msdiv90", "ja426:3.2": "", "ja426:3.3": "", "ja426:3.4": "", "ja426:4.1": "dr27.251, ms22J_1772, msdiv91, pts-vp-pli3.481, sya27.252", "ja426:4.2": "", "ja426:4.3": "", "ja426:4.4": "", "ja426:5.1": "bj30.322, ms22J_1773, msdiv92, ndp22.178", "ja426:5.2": "", "ja426:5.3": "", "ja426:5.4": "", "ja426:6.1": "ms22J_1774, msdiv93", "ja426:6.2": "", "ja426:6.3": "", "ja426:6.4": "", "ja426:7.1": "ms22J_1775, msdiv94", "ja426:7.2": "", "ja426:7.3": "", "ja426:7.4": "", "ja426:8.1": "csp1ed22.186, csp2ed22.186, ms22J_1776, msdiv95, vri68.152", "ja426