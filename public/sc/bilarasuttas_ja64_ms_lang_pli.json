{"html_text": {"ja64:0.1": "<article id='ja64'><header><ul><li class='division'>{}</li>", "ja64:0.2": "<li>{}</li>", "ja64:0.3": "<li>{}</li></ul>", "ja64:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja64:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja64:1.2": "<span class='verse-line'>{}</span>", "ja64:1.3": "<span class='verse-line'>{}</span>", "ja64:1.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja64:2.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja64:0.1": "Jātaka ", "ja64:0.2": "Ekakanipāta ", "ja64:0.3": "Itthivagga ", "ja64:0.4": "4. Durājānajātaka ", "ja64:1.1": "Mā su nandi icchati maṁ, ", "ja64:1.2": "mā su soci na micchati; ", "ja64:1.3": "Thīnaṁ bhāvo durājāno, ", "ja64:1.4": "macchassevodake gatan”ti. ", "ja64:2.1": "Durājānajātakaṁ catutthaṁ. "}, "variant_text": {"ja64:0.1": "", "ja64:0.2": "", "ja64:0.3": "", "ja64:0.4": "", "ja64:1.1": "", "ja64:1.2": "na micchati → na icchati (bj, sya1ed, sya2ed, pts-vp-pli1) ", "ja64:1.3": "", "ja64:1.4": "", "ja64:2.1": ""}, "reference_text": {"ja64:0.1": "", "ja64:0.2": "", "ja64:0.3": "", "ja64:0.4": "", "ja64:1.1": "dr27.22, ms22J_141, msdiv64, pts-vp-pli1.300, sya27.21", "ja64:1.2": "", "ja64:1.3": "", "ja64:1.4": "", "ja64:2.1": "ms22J_142"}, "keys_order": ["ja64:0.1", "ja64:0.2", "ja64:0.3", "ja64:0.4", "ja64:1.1", "ja64:1.2", "ja64:1.3", "ja64:1.4", "ja64:2.1"]}