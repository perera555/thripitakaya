{"html_text": {"ja354:0.1": "<article id='ja354'><header><ul><li class='division'>{}</li>", "ja354:0.2": "<li>{}</li>", "ja354:0.3": "<li>{}</li></ul>", "ja354:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja354:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja354:1.2": "<span class='verse-line'>{}</span>", "ja354:1.3": "<span class='verse-line'>{}</span>", "ja354:1.4": "<span class='verse-line'>{}</span></p>", "ja354:2.1": "<p><span class='verse-line'>{}</span>", "ja354:2.2": "<span class='verse-line'>{}</span>", "ja354:2.3": "<span class='verse-line'>{}</span>", "ja354:2.4": "<span class='verse-line'>{}</span></p>", "ja354:3.1": "<p><span class='verse-line'>{}</span>", "ja354:3.2": "<span class='verse-line'>{}</span>", "ja354:3.3": "<span class='verse-line'>{}</span>", "ja354:3.4": "<span class='verse-line'>{}</span></p>", "ja354:4.1": "<p><span class='verse-line'>{}</span>", "ja354:4.2": "<span class='verse-line'>{}</span>", "ja354:4.3": "<span class='verse-line'>{}</span>", "ja354:4.4": "<span class='verse-line'>{}</span></p>", "ja354:5.1": "<p><span class='verse-line'>{}</span>", "ja354:5.2": "<span class='verse-line'>{}</span>", "ja354:5.3": "<span class='verse-line'>{}</span>", "ja354:5.4": "<span class='verse-line'>{}</span></p>", "ja354:6.1": "<p><span class='verse-line'>{}</span>", "ja354:6.2": "<span class='verse-line'>{}</span>", "ja354:6.3": "<span class='verse-line'>{}</span>", "ja354:6.4": "<span class='verse-line'>{}</span></p>", "ja354:7.1": "<p><span class='verse-line'>{}</span>", "ja354:7.2": "<span class='verse-line'>{}</span>", "ja354:7.3": "<span class='verse-line'>{}</span>", "ja354:7.4": "<span class='verse-line'>{}</span></p>", "ja354:8.1": "<p><span class='verse-line'>{}</span>", "ja354:8.2": "<span class='verse-line'>{}</span>", "ja354:8.3": "<span class='verse-line'>{}</span>", "ja354:8.4": "<span class='verse-line'>{}</span></p>", "ja354:9.1": "<p><span class='verse-line'>{}</span>", "ja354:9.2": "<span class='verse-line'>{}</span>", "ja354:9.3": "<span class='verse-line'>{}</span>", "ja354:9.4": "<span class='verse-line'>{}</span></p>", "ja354:10.1": "<p><span class='verse-line'>{}</span>", "ja354:10.2": "<span class='verse-line'>{}</span>", "ja354:10.3": "<span class='verse-line'>{}</span>", "ja354:10.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja354:11.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja354:0.1": "Jātaka ", "ja354:0.2": "Pañcakanipāta ", "ja354:0.3": "Maṇikuṇḍalavagga ", "ja354:0.4": "4. Uragajātaka ", "ja354:1.1": "“Uragova tacaṁ jiṇṇaṁ, ", "ja354:1.2": "hitvā gacchati saṁ tanuṁ; ", "ja354:1.3": "Evaṁ sarīre nibbhoge, ", "ja354:1.4": "pete kālaṅkate sati. ", "ja354:2.1": "Ḍayhamāno na jānāti, ", "ja354:2.2": "ñātīnaṁ paridevitaṁ; ", "ja354:2.3": "Tasmā etaṁ na socāmi, ", "ja354:2.4": "gato so tassa yā gati”. ", "ja354:3.1": "“Anavhito tato āgā, ", "ja354:3.2": "ananuññāto ito gato; ", "ja354:3.3": "Yathāgato tathā gato, ", "ja354:3.4": "tattha kā paridevanā. ", "ja354:4.1": "Ḍayhamāno na jānāti, ", "ja354:4.2": "ñātīnaṁ paridevitaṁ; ", "ja354:4.3": "Tasmā etaṁ na socāmi, ", "ja354:4.4": "gato so tassa yā gati”. ", "ja354:5.1": "“Sace rode kisā assaṁ, ", "ja354:5.2": "tassā me kiṁ phalaṁ siyā; ", "ja354:5.3": "Ñātimittasuhajjānaṁ, ", "ja354:5.4": "bhiyyo no aratī siyā. ", "ja354:6.1": "Ḍayhamāno na jānāti, ", "ja354:6.2": "ñātīnaṁ paridevitaṁ; ", "ja354:6.3": "Tasmā etaṁ na socāmi, ", "ja354:6.4": "gato so tassa yā gati”. ", "ja354:7.1": "“Yathāpi dārako candaṁ, ", "ja354:7.2": "gacchantamanurodati; ", "ja354:7.3": "Evaṁsampadamevetaṁ, ", "ja354:7.4": "yo petamanusocati. ", "ja354:8.1": "Ḍayhamāno na jānāti, ", "ja354:8.2": "ñātīnaṁ paridevitaṁ; ", "ja354:8.3": "Tasmā etaṁ na socāmi, ", "ja354:8.4": "gato so tassa yā gati”. ", "ja354:9.1": "“Yathāpi udakakumbho, ", "ja354:9.2": "bhinno appaṭisandhiyo; ", "ja354:9.3": "Evaṁsampadamevetaṁ, ", "ja354:9.4": "yo petamanusocati. ", "ja354:10.1": "Ḍayhamāno na jānāti, ", "ja354:10.2": "ñātīnaṁ paridevitaṁ; ", "ja354:10.3": "Tasmā etaṁ na socāmi, ", "ja354:10.4": "gato so tassa yā gatī”ti. ", "ja354:11.1": "Uragajātakaṁ catutthaṁ. "}, "variant_text": {"ja354:0.1": "", "ja354:0.2": "", "ja354:0.3": "", "ja354:0.4": "", "ja354:1.1": "", "ja354:1.2": "", "ja354:1.3": "", "ja354:1.4": "", "ja354:2.1": "", "ja354:2.2": "", "ja354:2.3": "", "ja354:2.4": "", "ja354:3.1": "Anavhito → anabhito (bj); anabbhito (sya1ed, sya2ed); anavhāto (pts-vp-pli1) | āgā → āga (bj) ", "ja354:3.2": "ananuññāto → nānuññāto (sya1ed, sya2ed, mr) ", "ja354:3.3": "", "ja354:3.4": "", "ja354:4.1": "", "ja354:4.2": "", "ja354:4.3": "", "ja354:4.4": "", "ja354:5.1": "kisā → kīsā (sya1ed, sya2ed); kisī (pts-vp-pli1) ", "ja354:5.2": "", "ja354:5.3": "", "ja354:5.4": "", "ja354:6.1": "", "ja354:6.2": "", "ja354:6.3": "", "ja354:6.4": "", "ja354:7.1": "", "ja354:7.2": "", "ja354:7.3": "", "ja354:7.4": "", "ja354:8.1": "", "ja354:8.2": "", "ja354:8.3": "", "ja354:8.4": "", "ja354:9.1": "", "ja354:9.2": "", "ja354:9.3": "", "ja354:9.4": "", "ja354:10.1": "", "ja354:10.2": "", "ja354:10.3": "", "ja354:10.4": "", "ja354:11.1": ""}, "reference_text": {"ja354:0.1": "", "ja354:0.2": "", "ja354:0.3": "", "ja354:0.4": "", "ja354:1.1": "bj30.210, ms22J_1167, msdiv19, pts-vp-pli3.164", "ja354:1.2": "", "ja354:1.3": "", "ja354:1.4": "", "ja354:2.1": "ms22J_1168, msdiv20", "ja354:2.2": "", "ja354:2.3": "", "ja354:2.4": "", "ja354:3.1": "ms22J_1169, msdiv21, pts-vp-pli3.165, vri68.104", "ja354:3.2": "", "ja354:3.3": "", "ja354:3.4": "", "ja354:4.1": "ms22J_1170, msdiv22, pts-vp-pli3.166", "ja354:4.2": "", "ja354:4.3": "", "ja354:4.4": "", "ja354:5.1": "ms22J_1171, msdiv23, ndp22.114, sya27.168", "ja354:5.2": "", "ja354:5.3": "", "ja354:5.4": "", "ja354:6.1": "csp1ed22.123, csp2ed22.123, ms22J_1172, msdiv24", "ja354:6.2": "", "ja354:6.3": "", "ja354:6.4": "", "ja354:7.1": "ms22J_1173, msdiv25", "ja354:7.2": "", "ja354:7.3": "", "ja354:7.4": "", "ja354:8.1": "dr27.168, ms22J_1174, msdiv26", "j