{"html_text": {"ja355:0.1": "<article id='ja355'><header><ul><li class='division'>{}</li>", "ja355:0.2": "<li>{}</li>", "ja355:0.3": "<li>{}</li></ul>", "ja355:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja355:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja355:1.2": "<span class='verse-line'>{}</span>", "ja355:1.3": "<span class='verse-line'>{}</span>", "ja355:1.4": "<span class='verse-line'>{}</span></p>", "ja355:2.1": "<p><span class='verse-line'>{}</span>", "ja355:2.2": "<span class='verse-line'>{}</span>", "ja355:2.3": "<span class='verse-line'>{}</span>", "ja355:2.4": "<span class='verse-line'>{}</span></p>", "ja355:3.1": "<p><span class='verse-line'>{}</span>", "ja355:3.2": "<span class='verse-line'>{}</span>", "ja355:3.3": "<span class='verse-line'>{}</span>", "ja355:3.4": "<span class='verse-line'>{}</span></p>", "ja355:4.1": "<p><span class='verse-line'>{}</span>", "ja355:4.2": "<span class='verse-line'>{}</span>", "ja355:4.3": "<span class='verse-line'>{}</span>", "ja355:4.4": "<span class='verse-line'>{}</span></p>", "ja355:5.1": "<p><span class='verse-line'>{}</span>", "ja355:5.2": "<span class='verse-line'>{}</span>", "ja355:5.3": "<span class='verse-line'>{}</span>", "ja355:5.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja355:6.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja355:0.1": "Jātaka ", "ja355:0.2": "Pañcakanipāta ", "ja355:0.3": "Maṇikuṇḍalavagga ", "ja355:0.4": "5. Ghaṭajātaka ", "ja355:1.1": "“Aññe socanti rodanti, ", "ja355:1.2": "aññe assumukhā janā; ", "ja355:1.3": "Pasannamukhavaṇṇosi, ", "ja355:1.4": "kasmā ghaṭa na socasi”. ", "ja355:2.1": "“Nābbhatītaharo soko, ", "ja355:2.2": "nānāgatasukhāvaho; ", "ja355:2.3": "Tasmā dhaṅka na socāmi, ", "ja355:2.4": "natthi soke dutīyatā. ", "ja355:3.1": "Socaṁ paṇḍu kiso hoti, ", "ja355:3.2": "bhattañcassa na ruccati; ", "ja355:3.3": "Amittā sumanā honti, ", "ja355:3.4": "sallaviddhassa ruppato. ", "ja355:4.1": "Gāme vā yadi vāraññe, ", "ja355:4.2": "ninne vā yadi vā thale; ", "ja355:4.3": "Ṭhitaṁ maṁ nāgamissati, ", "ja355:4.4": "evaṁ diṭṭhapado ahaṁ. ", "ja355:5.1": "Yassattā nālamekova, ", "ja355:5.2": "sabbakāmarasāharo; ", "ja355:5.3": "Sabbāpi pathavī tassa, ", "ja355:5.4": "na sukhaṁ āvahissatī”ti. ", "ja355:6.1": "Ghaṭajātakaṁ pañcamaṁ. "}, "variant_text": {"ja355:0.1": "", "ja355:0.2": "", "ja355:0.3": "", "ja355:0.4": "", "ja355:1.1": "", "ja355:1.2": "", "ja355:1.3": "", "ja355:1.4": "ghaṭa → ghata (bj, pts-vp-pli1) ", "ja355:2.1": "", "ja355:2.2": "", "ja355:2.3": "dhaṅka → vaṅka (si, pts-vp-pli1) ", "ja355:2.4": "natthi soke dutīyatā → soko dutīyatā (bj); soke dutiyyatā (pts-vp-pli1); soko dutīyakā (mr) ", "ja355:3.1": "", "ja355:3.2": "", "ja355:3.3": "", "ja355:3.4": "", "ja355:4.1": "", "ja355:4.2": "", "ja355:4.3": "", "ja355:4.4": "", "ja355:5.1": "", "ja355:5.2": "", "ja355:5.3": "", "ja355:5.4": "", "ja355:6.1": "Ghaṭajātakaṁ → ghatajātakaṁ (bj, pts-vp-pli1); dhaṅkajātakaṁ (sya1ed, sya2ed) "}, "reference_text": {"ja355:0.1": "", "ja355:0.2": "", "ja355:0.3": "", "ja355:0.4": "", "ja355:1.1": "ms22J_1178, msdiv29, pts-vp-pli3.169", "ja355:1.2": "", "ja355:1.3": "", "ja355:1.4": "", "ja355:2.1": "bj30.212, ms22J_1179, msdiv30", "ja355:2.2": "", "ja355:2.3": "", "ja355:2.4": "", "ja355:3.1": "ms22J_1180, msdiv31", "ja355:3.2": "", "ja355:3.3": "", "ja355:3.4": "", "ja355:4.1": "ms22J_1181, msdiv32, sya27.169", "ja355:4.2": "", "ja355:4.3": "", "ja355:4.4": "", "ja355:5.1": "ms22J_1182, msdiv33", "ja355:5.2": "", "ja355:5.3": "", "ja355:5.4": "", "ja355:6.1": "ms22J_1183"}, "keys_order": ["ja355:0.1", "ja355:0.2", "ja355:0.3", "ja355:0.4", "ja355:1.1", "ja355:1.2", "ja355:1.3", "ja355:1.4", "ja355:2.1", "ja355:2.2", "ja355:2.3", "ja355:2.4", "ja355:3.1", "ja355:3.2", "ja355:3.3", "ja355:3.4", "ja355:4.1", "ja355:4.2", "ja355:4.3", "ja355:4.4", "ja355:5.1", "ja355:5.2", "ja355:5.3", "ja355:5.4", "ja355:6.1"]}