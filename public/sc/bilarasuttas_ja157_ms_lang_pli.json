{"html_text": {"ja157:0.1": "<article id='ja157'><header><ul><li class='division'>{}</li>", "ja157:0.2": "<li>{}</li>", "ja157:0.3": "<li>{}</li></ul>", "ja157:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja157:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja157:1.2": "<span class='verse-line'>{}</span>", "ja157:1.3": "<span class='verse-line'>{}</span>", "ja157:1.4": "<span class='verse-line'>{}</span></p>", "ja157:2.1": "<p><span class='verse-line'>{}</span>", "ja157:2.2": "<span class='verse-line'>{}</span>", "ja157:2.3": "<span class='verse-line'>{}</span>", "ja157:2.4": "<span class='verse-line'>{}</span>", "ja157:2.5": "<span class='verse-line'>{}</span>", "ja157:2.6": "<span class='verse-line'>{}</span></p></blockquote>", "ja157:3.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja157:0.1": "Jātaka ", "ja157:0.2": "Dukanipāta ", "ja157:0.3": "Daḷhavagga ", "ja157:0.4": "7. Guṇajātaka ", "ja157:1.1": "“Yena kāmaṁ paṇāmeti, ", "ja157:1.2": "dhammo balavataṁ migī; ", "ja157:1.3": "Unnadantī vijānāhi, ", "ja157:1.4": "jātaṁ saraṇato bhayaṁ”. ", "ja157:2.1": "“Api cepi dubbalo mitto, ", "ja157:2.2": "mittadhammesu tiṭṭhati; ", "ja157:2.3": "So ñātako ca bandhu ca, ", "ja157:2.4": "so mitto so ca me sakhā; ", "ja157:2.5": "Dāṭhini mātimaññittho, ", "ja157:2.6": "siṅgālo mama pāṇado”ti. ", "ja157:3.1": "Guṇajātakaṁ sattamaṁ. "}, "variant_text": {"ja157:0.1": "", "ja157:0.2": "", "ja157:0.3": "", "ja157:0.4": "", "ja157:1.1": "", "ja157:1.2": "", "ja157:1.3": "", "ja157:1.4": "", "ja157:2.1": "", "ja157:2.2": "", "ja157:2.3": "", "ja157:2.4": "", "ja157:2.5": "mātimaññittho → … maññivho (sya1ed, sya2ed); … maññavho (mr) ", "ja157:2.6": "", "ja157:3.1": ""}, "reference_text": {"ja157:0.1": "", "ja157:0.2": "", "ja157:0.3": "", "ja157:0.4": "", "ja157:1.1": "csp1ed22.38, csp2ed22.38, ms22J_358, msdiv13, ndp22.36, pts-vp-pli2.28", "ja157:1.2": "", "ja157:1.3": "", "ja157:1.4": "", "ja157:2.1": "ms22J_359, msdiv14, pts-vp-pli2