{"html_text": {"ja383:0.1": "<article id='ja383'><header><ul><li class='division'>{}</li>", "ja383:0.2": "<li>{}</li>", "ja383:0.3": "<li>{}</li></ul>", "ja383:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja383:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja383:1.2": "<span class='verse-line'>{}</span>", "ja383:1.3": "<span class='verse-line'>{}</span>", "ja383:1.4": "<span class='verse-line'>{}</span></p>", "ja383:2.1": "<p><span class='verse-line'>{}</span>", "ja383:2.2": "<span class='verse-line'>{}</span>", "ja383:2.3": "<span class='verse-line'>{}</span>", "ja383:2.4": "<span class='verse-line'>{}</span></p>", "ja383:3.1": "<p><span class='verse-line'>{}</span>", "ja383:3.2": "<span class='verse-line'>{}</span>", "ja383:3.3": "<span class='verse-line'>{}</span>", "ja383:3.4": "<span class='verse-line'>{}</span></p>", "ja383:4.1": "<p><span class='verse-line'>{}</span>", "ja383:4.2": "<span class='verse-line'>{}</span>", "ja383:4.3": "<span class='verse-line'>{}</span>", "ja383:4.4": "<span class='verse-line'>{}</span></p>", "ja383:5.1": "<p><span class='verse-line'>{}</span>", "ja383:5.2": "<span class='verse-line'>{}</span>", "ja383:5.3": "<span class='verse-line'>{}</span>", "ja383:5.4": "<span class='verse-line'>{}</span></p>", "ja383:6.1": "<p><span class='verse-line'>{}</span>", "ja383:6.2": "<span class='verse-line'>{}</span>", "ja383:6.3": "<span class='verse-line'>{}</span>", "ja383:6.4": "<span class='verse-line'>{}</span></p>", "ja383:7.1": "<p><span class='verse-line'>{}</span>", "ja383:7.2": "<span class='verse-line'>{}</span>", "ja383:7.3": "<span class='verse-line'>{}</span>", "ja383:7.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja383:8.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja383:0.1": "Jātaka ", "ja383:0.2": "Chakkanipāta ", "ja383:0.3": "Avāriyavagga ", "ja383:0.4": "8. Kukkuṭajātaka ", "ja383:1.1": "“Sucittapattachadana, ", "ja383:1.2": "tambacūḷa vihaṅgama; ", "ja383:1.3": "Oroha dumasākhāya, ", "ja383:1.4": "mudhā bhariyā bhavāmi te”. ", "ja383:2.1": "“Catuppadī tvaṁ kalyāṇi, ", "ja383:2.2": "dvipadāhaṁ manorame; ", "ja383:2.3": "Migī pakkhī asaññuttā, ", "ja383:2.4": "aññaṁ pariyesa sāmikaṁ”. ", "ja383:3.1": "“Komārikā te hessāmi, ", "ja383:3.2": "Mañjukā piyabhāṇinī; ", "ja383:3.3": "Vinda maṁ ariyena vedena, ", "ja383:3.4": "Sāvaya maṁ yadicchasi”. ", "ja383:4.1": "“Kuṇapādini lohitape, ", "ja383:4.2": "cori kukkuṭapothini; ", "ja383:4.3": "Na tvaṁ ariyena vedena, ", "ja383:4.4": "mamaṁ bhattāramicchasi”. ", "ja383:5.1": "“Evampi caturā nārī, ", "ja383:5.2": "disvāna sadhanaṁ naraṁ; ", "ja383:5.3": "Nenti saṇhāhi vācāhi, ", "ja383:5.4": "biḷārī viya kukkuṭaṁ. ", "ja383:6.1": "Yo ca uppatitaṁ atthaṁ, ", "ja383:6.2": "na khippamanubujjhati; ", "ja383:6.3": "Amittavasamanveti, ", "ja383:6.4": "pacchā ca anutappati. ", "ja383:7.1": "Yo ca uppatitaṁ atthaṁ, ", "ja383:7.2": "khippameva nibodhati; ", "ja383:7.3": "Muccate sattusambādhā, ", "ja383:7.4": "kukkuṭova biḷāriyā”ti. ", "ja383:8.1": "Kukkuṭajātakaṁ aṭṭhamaṁ. "}, "variant_text": {"ja383:0.1": "", "ja383:0.2": "", "ja383:0.3": "", "ja383:0.4": "", "ja383:1.1": "", "ja383:1.2": "", "ja383:1.3": "", "ja383:1.4": "", "ja383:2.1": "", "ja383:2.2": "", "ja383:2.3": "", "ja383:2.4": "", "ja383:3.1": "", "ja383:3.2": "", "ja383:3.3": "", "ja383:3.4": "", "ja383:4.1": "", "ja383:4.2": "", "ja383:4.3": "", "ja383:4.4": "", "ja383:5.1": "caturā → cāturā (sya1ed, sya2ed, mr) ", "ja383:5.2": "sadhanaṁ → pavaraṁ (bj, sya1ed, sya2ed, pts-vp-pli1) ", "ja383:5.3": "", "ja383:5.4": "", "ja383:6.1": "", "ja383:6.2": "", "ja383:6.3": "", "ja383:6.4": "", "ja383:7.1": "", "ja383:7.2": "", "ja383:7.3": "", "ja383:7.4": "", "ja383:8.1": ""}, "reference_text": {"ja383:0.1": "", "ja383:0.2": "", "ja383:0.3": "", "ja383:0.4": "", "ja383:1.1": "bj30.246, csp1ed22.144, csp2ed22.144, ms22J_1382, msdiv58, pts-vp-pli3.265", "ja383:1.2": "", "ja383:1.3": "", "ja383:1.4": "", "ja383:2.1": "ms22J_1383, msdiv59"