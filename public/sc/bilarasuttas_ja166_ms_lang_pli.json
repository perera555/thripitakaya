{"html_text": {"ja166:0.1": "<article id='ja166'><header><ul><li class='division'>{}</li>", "ja166:0.2": "<li>{}</li>", "ja166:0.3": "<li>{}</li></ul>", "ja166:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja166:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja166:1.2": "<span class='verse-line'>{}</span>", "ja166:1.3": "<span class='verse-line'>{}</span>", "ja166:1.4": "<span class='verse-line'>{}</span></p>", "ja166:2.1": "<p><span class='verse-line'>{}</span>", "ja166:2.2": "<span class='verse-line'>{}</span>", "ja166:2.3": "<span class='verse-line'>{}</span>", "ja166:2.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja166:3.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja166:0.1": "Jātaka ", "ja166:0.2": "Dukanipāta ", "ja166:0.3": "Santhavavagga ", "ja166:0.4": "6. Upasāḷakajātaka ", "ja166:1.1": "“Upasāḷakanāmāni, ", "ja166:1.2": "sahassāni catuddasa; ", "ja166:1.3": "Asmiṁ padese daḍḍhāni, ", "ja166:1.4": "natthi loke anāmataṁ. ", "ja166:2.1": "Yamhi saccañca dhammo ca, ", "ja166:2.2": "ahiṁsā saṁyamo damo; ", "ja166:2.3": "Etaṁ ariyā sevanti, ", "ja166:2.4": "etaṁ loke anāmatan”ti. ", "ja166:3.1": "Upasāḷakajātakaṁ chaṭṭhaṁ. "}, "variant_text": {"ja166:0.1": "", "ja166:0.2": "", "ja166:0.3": "", "ja166:0.4": "", "ja166:1.1": "Upasāḷakanāmāni → upasāḷhakanāmānaṁ (bj, sya1ed, sya2ed, pts-vp-pli1) ", "ja166:1.2": "", "ja166:1.3": "", "ja166:1.4": "", "ja166:2.1": "", "ja166:2.2": "", "ja166:2.3": "Etaṁ ariyā → etadariyā (bj, sya1ed, sya2ed, pts-vp-pli1) ", "ja166:2.4": "", "ja166:3.1": "Upasāḷakajātakaṁ → upasāḷhajātakaṁ (bj, pts-vp-pli1); upasāḷhakajātakaṁ (sya1ed, sya2ed) "}, "reference_text": {"ja166:0.1": "", "ja166:0.2": "", "ja166:0.3": "", "ja166:0.4": "", "ja166:1.1": "ms22J_389, msdiv31, pts-vp-pli2.56", "ja166:1.2": "", "ja166:1.3": "", "ja166:1.4": "", "ja166:2.1": "ms22J_390, msdiv32, sya27.58", "ja166:2.2": "", "ja166:2.3": "", "ja166:2.4": "", "ja166:3.1": "ms22J_391"}, "keys_order": ["ja16