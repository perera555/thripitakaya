{"html_text": {"ja310:0.1": "<article id='ja310'><header><ul><li class='division'>{}</li>", "ja310:0.2": "<li>{}</li>", "ja310:0.3": "<li>{}</li></ul>", "ja310:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja310:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja310:1.2": "<span class='verse-line'>{}</span>", "ja310:1.3": "<span class='verse-line'>{}</span>", "ja310:1.4": "<span class='verse-line'>{}</span></p>", "ja310:2.1": "<p><span class='verse-line'>{}</span>", "ja310:2.2": "<span class='verse-line'>{}</span>", "ja310:2.3": "<span class='verse-line'>{}</span>", "ja310:2.4": "<span class='verse-line'>{}</span></p>", "ja310:3.1": "<p><span class='verse-line'>{}</span>", "ja310:3.2": "<span class='verse-line'>{}</span>", "ja310:3.3": "<span class='verse-line'>{}</span>", "ja310:3.4": "<span class='verse-line'>{}</span></p>", "ja310:4.1": "<p><span class='verse-line'>{}</span>", "ja310:4.2": "<span class='verse-line'>{}</span>", "ja310:4.3": "<span class='verse-line'>{}</span>", "ja310:4.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja310:5.1": "<p class='endsutta'>{}</p>", "ja310:5.2": "<p class='endvagga'>{}</p>", "ja310:6.1": "<p class='uddana-intro'>{}</p>", "ja310:7.1": "<blockquote class='uddanagatha'><p><span class='verse-line'>{}</span>", "ja310:7.2": "<span class='verse-line'>{}</span>", "ja310:7.3": "<span class='verse-line'>{}</span>", "ja310:7.4": "<span class='verse-line'>{}</span></p></blockquote></article>"}, "root_text": {"ja310:0.1": "Jātaka ", "ja310:0.2": "Catukkanipāta ", "ja310:0.3": "Kāliṅgavagga ", "ja310:0.4": "10. Seyyajātaka ", "ja310:1.1": "“Sasamuddapariyāyaṁ, ", "ja310:1.2": "mahiṁ sāgarakuṇḍalaṁ; ", "ja310:1.3": "Na icche saha nindāya, ", "ja310:1.4": "evaṁ seyya vijānahi. ", "ja310:2.1": "Dhiratthu taṁ yasalābhaṁ, ", "ja310:2.2": "dhanalābhañca brāhmaṇa; ", "ja310:2.3": "Yā vutti vinipātena, ", "ja310:2.4": "adhammacaraṇena vā. ", "ja310:3.1": "Api ce pattamādāya, ", "ja310:3.2": "anagāro paribbaje; ", "ja310:3.3": "Sāyeva jīvikā seyyo, ", "ja310:3.4": "yā cādhammena esanā. ", "ja310:4.1": "Api ce pattamādāya, ", "ja310:4.2": "anagāro paribbaje; ", "ja310:4.3": "Aññaṁ ahiṁsayaṁ loke, ", "ja310:4.4": "api rajjena taṁ varan”ti. ", "ja310:5.1": "Seyyajātakaṁ dasamaṁ. ", "ja310:5.2": "Kāliṅgavaggo paṭhamo. ", "ja310:6.1": "Tassuddānaṁ ", "ja310:7.1": "Vivarañca adeyya samiddhavaraṁ, ", "ja310:7.2": "Atha daddara pāpamahātiraho; ", "ja310:7.3": "Atha koli palāsavarañca kara, ", "ja310:7.4": "Carimaṁ sasamuddavarena dasāti. "}, "variant_text": {"ja310:0.1": "", "ja310:0.2": "", "ja310:0.3": "", "ja310:0.4": "", "ja310:1.1": "", "ja310:1.2": "", "ja310:1.3": "", "ja310:1.4": "seyya → sayha (bj, sya1ed, sya2ed, pts-vp-pli1); seyha (mi5.5.5:1 [Buddhaaviheṭhakapañha]) ", "ja310:2.1": "", "ja310:2.2": "", "ja310:2.3": "", "ja310:2.4": "", "ja310:3.1": "", "ja310:3.2": "", "ja310:3.3": "", "ja310:3.4": "", "ja310:4.1": "", "ja310:4.2": "", "ja310:4.3": "", "ja310:4.4": "", "ja310:5.1": "Seyyajātakaṁ → sayhajātakaṁ (bj, sya1ed, sya2ed, pts-vp-pli1) ", "ja310:5.2": "Kāliṅgavaggo → vivaravaggo (bj, pts-vp-pli1) ", "ja310:6.1": "", "ja310:7.1": "", "ja310:7.2": "", "ja310:7.3": "", "ja310:7.4": ""}, "reference_text": {"ja310:0.1": "", "ja310:0.2": "", "ja310:0.3": "", "ja310:0.4": "", "ja310:1.1": "ms22J_928, msdiv37, pts-vp-pli3.32, sya27.135", "ja310:1.2": "", "ja310:1.3": "", "ja310:1.4": "", "ja310:2.1": "ms22J_929, msdiv38, ndp22.91", "ja310:2.2": "", "ja310:2.3": "", "ja310:2.4": "", "ja310:3.1": "ms22J_930, msdiv39", "ja310:3.2": "", "ja310:3.3": "", "ja310:3.4": "", "ja310:4.1": "ms22J_931, msdiv40, vri68.85", "ja310:4.2": "", "ja310:4.3": "", "ja310:4.4": "", "ja310:5.1": "ms22J_932", "ja310:5.2": "", "ja310:6.1": "ms22J_933", "ja310:7.1": "ms22J_934", "ja310:7.2": "", "ja310:7.3": "", "ja310:7.4": ""}, "keys_order": ["ja310:0.1", "ja310:0.2", "ja310:0.3", "ja310:0.4", "ja310:1.1", "ja310:1.2", "ja310:1.3", "ja310:1.4", "ja310:2.1", "ja310:2.2", "ja310:2.3", 