{"html_text": {"ja284:0.1": "<article id='ja284'><header><ul><li class='division'>{}</li>", "ja284:0.2": "<li>{}</li>", "ja284:0.3": "<li>{}</li></ul>", "ja284:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja284:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja284:1.2": "<span class='verse-line'>{}</span>", "ja284:1.3": "<span class='verse-line'>{}</span>", "ja284:1.4": "<span class='verse-line'>{}</span></p>", "ja284:2.1": "<p><span class='verse-line'>{}</span>", "ja284:2.2": "<span class='verse-line'>{}</span>", "ja284:2.3": "<span class='verse-line'>{}</span>", "ja284:2.4": "<span class='verse-line'>{}</span></p>", "ja284:3.1": "<p><span class='verse-line'>{}</span>", "ja284:3.2": "<span class='verse-line'>{}</span>", "ja284:3.3": "<span class='verse-line'>{}</span>", "ja284:3.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja284:4.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja284:0.1": "Jātaka ", "ja284:0.2": "Tikanipāta ", "ja284:0.3": "Abbhantaravagga ", "ja284:0.4": "4. Sirijātaka ", "ja284:1.1": "“Yaṁ ussukā saṅgharanti, ", "ja284:1.2": "alakkhikā bahuṁ dhanaṁ; ", "ja284:1.3": "Sippavanto asippā ca, ", "ja284:1.4": "lakkhivā tāni bhuñjati. ", "ja284:2.1": "Sabbattha katapuññassa, ", "ja284:2.2": "aticcaññeva pāṇino; ", "ja284:2.3": "Uppajjanti bahū bhogā, ", "ja284:2.4": "appanāyatanesupi. ", "ja284:3.1": "Kukkuṭo maṇayo daṇḍo, ", "ja284:3.2": "thiyo ca puññalakkhaṇā; ", "ja284:3.3": "Uppajjanti apāpassa, ", "ja284:3.4": "katapuññassa jantuno”ti. ", "ja284:4.1": "Sirijātakaṁ catutthaṁ. "}, "variant_text": {"ja284:0.1": "", "ja284:0.2": "", "ja284:0.3": "", "ja284:0.4": "", "ja284:1.1": "", "ja284:1.2": "", "ja284:1.3": "", "ja284:1.4": "", "ja284:2.1": "", "ja284:2.2": "", "ja284:2.3": "", "ja284:2.4": "", "ja284:3.1": "Kukkuṭo → kukkuṭa (bj, pts-vp-pli1); kukkuṭā (bj -nissya, saddanīti) ", "ja284:3.2": "", "ja284:3.3": "", "ja284:3.4": "", "ja284:4.1": ""}, "reference_text": {"ja284:0.1": "", "ja28