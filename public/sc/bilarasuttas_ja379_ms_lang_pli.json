{"html_text": {"ja379:0.1": "<article id='ja379'><header><ul><li class='division'>{}</li>", "ja379:0.2": "<li>{}</li>", "ja379:0.3": "<li>{}</li></ul>", "ja379:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja379:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja379:1.2": "<span class='verse-line'>{}</span>", "ja379:1.3": "<span class='verse-line'>{}</span>", "ja379:1.4": "<span class='verse-line'>{}</span></p>", "ja379:2.1": "<p><span class='verse-line'>{}</span>", "ja379:2.2": "<span class='verse-line'>{}</span>", "ja379:2.3": "<span class='verse-line'>{}</span>", "ja379:2.4": "<span class='verse-line'>{}</span></p>", "ja379:3.1": "<p><span class='verse-line'>{}</span>", "ja379:3.2": "<span class='verse-line'>{}</span>", "ja379:3.3": "<span class='verse-line'>{}</span>", "ja379:3.4": "<span class='verse-line'>{}</span></p>", "ja379:4.1": "<p><span class='verse-line'>{}</span>", "ja379:4.2": "<span class='verse-line'>{}</span>", "ja379:4.3": "<span class='verse-line'>{}</span>", "ja379:4.4": "<span class='verse-line'>{}</span></p>", "ja379:5.1": "<p><span class='verse-line'>{}</span>", "ja379:5.2": "<span class='verse-line'>{}</span>", "ja379:5.3": "<span class='verse-line'>{}</span>", "ja379:5.4": "<span class='verse-line'>{}</span></p>", "ja379:6.1": "<p><span class='verse-line'>{}</span>", "ja379:6.2": "<span class='verse-line'>{}</span>", "ja379:6.3": "<span class='verse-line'>{}</span>", "ja379:6.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja379:7.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja379:0.1": "Jātaka ", "ja379:0.2": "Chakkanipāta ", "ja379:0.3": "Avāriyavagga ", "ja379:0.4": "4. Nerujātaka ", "ja379:1.1": "“Kākolā kākasaṅghā ca, ", "ja379:1.2": "mayañca patataṁ varā; ", "ja379:1.3": "Sabbeva sadisā homa, ", "ja379:1.4": "imaṁ āgamma pabbataṁ. ", "ja379:2.1": "Idha sīhā ca byagghā ca, ", "ja379:2.2": "siṅgālā ca migādhamā; ", "ja379:2.3": "Sabbeva sadisā honti, ", "ja379:2.4": "ayaṁ ko nāma pabbato”. ", "ja379:3.1": "“Imaṁ nerūti jānanti, ", "ja379:3.2": "manussā pabbatuttamaṁ; ", "ja379:3.3": "Idha vaṇṇena sampannā, ", "ja379:3.4": "vasanti sabbapāṇino”. ", "ja379:4.1": "“Amānanā yattha siyā, ", "ja379:4.2": "santānaṁ vā vimānanā; ", "ja379:4.3": "Hīnasammānanā vāpi, ", "ja379:4.4": "na tattha vasatiṁ vase. ", "ja379:5.1": "Yatthālaso ca dakkho ca, ", "ja379:5.2": "sūro bhīru ca pūjiyā; ", "ja379:5.3": "Na tattha santo vasanti, ", "ja379:5.4": "avisesakare nare. ", "ja379:6.1": "Nāyaṁ neru vibhajati, ", "ja379:6.2": "hīnaukkaṭṭhamajjhime; ", "ja379:6.3": "Avisesakaro neru, ", "ja379:6.4": "handa neruṁ jahāmase”ti. ", "ja379:7.1": "Nerujātakaṁ catutthaṁ. "}, "variant_text": {"ja379:0.1": "", "ja379:0.2": "", "ja379:0.3": "", "ja379:0.4": "", "ja379:1.1": "", "ja379:1.2": "varā → vara (mr) ", "ja379:1.3": "", "ja379:1.4": "", "ja379:2.1": "", "ja379:2.2": "", "ja379:2.3": "", "ja379:2.4": "", "ja379:3.1": "nerūti → nerunti (bj, sya1ed, sya2ed) ", "ja379:3.2": "", "ja379:3.3": "", "ja379:3.4": "", "ja379:4.1": "", "ja379:4.2": "", "ja379:4.3": "", "ja379:4.4": "vasatiṁ vase → vasatī vase (sya1ed, sya2ed); vasa divase (pts-vp-pli1) ", "ja379:5.1": "", "ja379:5.2": "", "ja379:5.3": "", "ja379:5.4": "nare → nage (bj, sya1ed, sya2ed, pts-vp-pli1) ", "ja379:6.1": "", "ja379:6.2": "", "ja379:6.3": "", "ja379:6.4": "", "ja379:7.1": ""}, "reference_text": {"ja379:0.1": "", "ja379:0.2": "", "ja379:0.3": "", "ja379:0.4": "", "ja379:1.1": "ms22J_1340, msdiv20, pts-vp-pli3.247", "ja379:1.2": "", "ja379:1.3": "", "ja379:1.4": "", "ja379:2.1": "ms22J_1341, msdiv21, ndp22.131, sya27.191, vri68.118", "ja379:2.2": "", "ja379:2.3": "", "ja379:2.4": "", "ja379:3.1": "csp1ed22.140, csp2ed22.140, ms22J_1342, msdiv22", "ja379:3.2": "", "ja379:3.3": "", "ja379:3.4": "", "ja379:4.1": "dr27.190, ms22J_1343, msdiv23", "ja379:4.2": "", "ja379:4.3": "", "ja379:4.4": "", "ja379:5.1": "ms22J_1344, msdiv24", "ja379:5.2": "", "ja379:5.3": "", "ja379:5.4": "", "ja379:6.1": "ms22J_1345,