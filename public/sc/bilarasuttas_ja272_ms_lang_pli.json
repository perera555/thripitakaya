{"html_text": {"ja272:0.1": "<article id='ja272'><header><ul><li class='division'>{}</li>", "ja272:0.2": "<li>{}</li>", "ja272:0.3": "<li>{}</li></ul>", "ja272:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja272:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja272:1.2": "<span class='verse-line'>{}</span>", "ja272:1.3": "<span class='verse-line'>{}</span>", "ja272:1.4": "<span class='verse-line'>{}</span></p>", "ja272:2.1": "<p><span class='verse-line'>{}</span>", "ja272:2.2": "<span class='verse-line'>{}</span>", "ja272:2.3": "<span class='verse-line'>{}</span>", "ja272:2.4": "<span class='verse-line'>{}</span></p>", "ja272:3.1": "<p><span class='verse-line'>{}</span>", "ja272:3.2": "<span class='verse-line'>{}</span>", "ja272:3.3": "<span class='verse-line'>{}</span>", "ja272:3.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja272:4.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja272:0.1": "Jātaka ", "ja272:0.2": "Tikanipāta ", "ja272:0.3": "Udapānavagga ", "ja272:0.4": "2. Byagghajātaka ", "ja272:1.1": "“Yena mittena saṁsaggā, ", "ja272:1.2": "yogakkhemo vihiyyati; ", "ja272:1.3": "Pubbevajjhābhavaṁ tassa, ", "ja272:1.4": "rukkhe akkhīva paṇḍito. ", "ja272:2.1": "Yena mittena saṁsaggā, ", "ja272:2.2": "yogakkhemo pavaḍḍhati; ", "ja272:2.3": "Kareyyattasamaṁ vuttiṁ, ", "ja272:2.4": "sabbakiccesu paṇḍito”. ", "ja272:3.1": "“Etha byagghā nivattavho, ", "ja272:3.2": "Paccupetha mahāvanaṁ; ", "ja272:3.3": "Mā vanaṁ chindi nibyagghaṁ, ", "ja272:3.4": "Byagghā māhesu nibbanā”ti. ", "ja272:4.1": "Byagghajātakaṁ dutiyaṁ. "}, "variant_text": {"ja272:0.1": "", "ja272:0.2": "", "ja272:0.3": "", "ja272:0.4": "", "ja272:1.1": "", "ja272:1.2": "", "ja272:1.3": "", "ja272:1.4": "", "ja272:2.1": "", "ja272:2.2": "", "ja272:2.3": "", "ja272:2.4": "", "ja272:3.1": "", "ja272:3.2": "Paccupetha → paccametha (bj, pts-vp-pli1) ", "ja272:3.3": "Mā → mā no (sya1ed, sya2ed) ", "ja272:3.4": "", "ja272:4.1": ""}, "reference_text": {"