{"html_text": {"ja58:0.1": "<article id='ja58'><header><ul><li class='division'>{}</li>", "ja58:0.2": "<li>{}</li>", "ja58:0.3": "<li>{}</li></ul>", "ja58:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja58:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja58:1.2": "<span class='verse-line'>{}</span>", "ja58:1.3": "<span class='verse-line'>{}</span>", "ja58:1.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja58:2.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja58:0.1": "Jātaka ", "ja58:0.2": "Ekakanipāta ", "ja58:0.3": "Āsīsavagga ", "ja58:0.4": "8. Tayodhammajātaka ", "ja58:1.1": "“Yassa ete tayo dhammā, ", "ja58:1.2": "vānarinda yathā tava; ", "ja58:1.3": "Dakkhiyaṁ sūriyaṁ paññā, ", "ja58:1.4": "diṭṭhaṁ so ativattatī”ti. ", "ja58:2.1": "Tayodhammajātakaṁ aṭṭhamaṁ. "}, "variant_text": {"ja58:0.1": "", "ja58:0.2": "", "ja58:0.3": "", "ja58:0.4": "", "ja58:1.1": "Yassa ete → yassete (sya1ed, sya2ed, pts-vp-pli1, mr) ", "ja58:1.2": "", "ja58:1.3": "", "ja58:1.4": "", "ja58:2.1": ""}, "reference_text": {"ja58:0.1": "", "ja58:0.2": "", "ja58:0.3": "", "ja58:0.4": "", "ja58:1.1": "dr27.20, ms22J_127, msdiv58, pts-vp-pli1.282, sya27.19, vri68.14", "ja58:1.2": "", "ja58:1.3": "", "ja58:1.4": "", "ja58:2.1": "ms22J_128"}, "keys_order": ["ja58:0.1", "ja58:0.2", "ja58:0.3", "ja58:0.4", "ja58:1.1", "ja58:1.2", "ja58:1.3", "ja58:1.4", "ja58:2.1"]}