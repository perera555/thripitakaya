{"html_text": {"ja334:0.1": "<article id='ja334'><header><ul><li class='division'>{}</li>", "ja334:0.2": "<li>{}</li>", "ja334:0.3": "<li>{}</li></ul>", "ja334:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja334:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja334:1.2": "<span class='verse-line'>{}</span>", "ja334:1.3": "<span class='verse-line'>{}</span>", "ja334:1.4": "<span class='verse-line'>{}</span></p>", "ja334:2.1": "<p><span class='verse-line'>{}</span>", "ja334:2.2": "<span class='verse-line'>{}</span>", "ja334:2.3": "<span class='verse-line'>{}</span>", "ja334:2.4": "<span class='verse-line'>{}</span>", "ja334:2.5": "<span class='verse-line'>{}</span>", "ja334:2.6": "<span class='verse-line'>{}</span></p>", "ja334:3.1": "<p><span class='verse-line'>{}</span>", "ja334:3.2": "<span class='verse-line'>{}</span>", "ja334:3.3": "<span class='verse-line'>{}</span>", "ja334:3.4": "<span class='verse-line'>{}</span></p>", "ja334:4.1": "<p><span class='verse-line'>{}</span>", "ja334:4.2": "<span class='verse-line'>{}</span>", "ja334:4.3": "<span class='verse-line'>{}</span>", "ja334:4.4": "<span class='verse-line'>{}</span>", "ja334:4.5": "<span class='verse-line'>{}</span>", "ja334:4.6": "<span class='verse-line'>{}</span></p></blockquote>", "ja334:5.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja334:0.1": "Jātaka ", "ja334:0.2": "Catukkanipāta ", "ja334:0.3": "Kokilavagga ", "ja334:0.4": "4. Rājovādajātaka ", "ja334:1.1": "“Gavañce taramānānaṁ, ", "ja334:1.2": "jimhaṁ gacchati puṅgavo; ", "ja334:1.3": "Sabbā tā jimhaṁ gacchanti, ", "ja334:1.4": "nette jimhaṁ gate sati. ", "ja334:2.1": "Evameva manussesu, ", "ja334:2.2": "yo hoti seṭṭhasammato; ", "ja334:2.3": "So ce adhammaṁ carati, ", "ja334:2.4": "pageva itarā pajā; ", "ja334:2.5": "Sabbaṁ raṭṭhaṁ dukhaṁ seti, ", "ja334:2.6": "rājā ce hoti adhammiko. ", "ja334:3.1": "Gavañce taramānānaṁ, ", "ja334:3.2": "ujuṁ gacchati puṅgavo; ", "ja334:3.3": "Sabbā gāvī ujuṁ yanti, ", "ja334:3.4": "nette ujuṁ gate sati. ", "ja334:4.1": "Evameva manussesu, ", "ja334:4.2": "yo hoti seṭṭhasammato; ", "ja334:4.3": "So sace dhammaṁ carati, ", "ja334:4.4": "pageva itarā pajā; ", "ja334:4.5": "Sabbaṁ raṭṭhaṁ sukhaṁ seti, ", "ja334:4.6": "rājā ce hoti dhammiko”ti. ", "ja334:5.1": "Rājovādajātakaṁ catutthaṁ. "}, "variant_text": {"ja334:0.1": "", "ja334:0.2": "", "ja334:0.3": "", "ja334:0.4": "", "ja334:1.1": "Gavañce → gunnañce (an4.70:1 [70. Adhammikasutta]; ne6:4 [Sāsanapaṭṭhāna], ne6:56 [Sāsanapaṭṭhāna]) ", "ja334:1.2": "", "ja334:1.3": "Sabbā tā jimhaṁ gacchanti → sabbā gāvī jimhaṁ yanti (sya1ed, sya2ed) ", "ja334:1.4": "", "ja334:2.1": "", "ja334:2.2": "", "ja334:2.3": "", "ja334:2.4": "", "ja334:2.5": "", "ja334:2.6": "", "ja334:3.1": "", "ja334:3.2": "", "ja334:3.3": "Sabbā gāvī ujuṁ yanti → sabbā tā ujuṁ gacchanti (bj, pts-vp-pli1 an4.70:1 [70. Adhammikasutta]) ", "ja334:3.4": "", "ja334:4.1": "", "ja334:4.2": "", "ja334:4.3": "", "ja334:4.4": "", "ja334:4.5": "", "ja334:4.6": "", "ja334:5.1": ""}, "reference_text": {"ja334:0.1": "", "ja334:0.2": "", "ja334:0.3": "", "ja334:0.4": "", "ja334:1.1": "ms22J_1054, msdiv133, pts-vp-pli3.111", "ja334:1.2": "", "ja334:1.3": "", "ja334:1.4": "", "ja334:2.1": "ms22J_1055, msdiv134, vri68.95", "ja334:2.2": "", "ja334:2.3": "", "ja334:2.4": "", "ja334:2.5": "", "ja334:2.6": "", "ja334:3.1": "ms22J_1056, msdiv135", "ja334:3.2": "", "ja334:3.3": "", "ja334:3.4": "", "ja334:4.1": "csp1ed22.111, csp2ed22.111, ms22J_1057, msdiv136, sya27.152", "ja334:4.2": "", "ja334:4.3": "", "ja334:4.4": "", "ja334:4.5": "", "ja334:4.6": "", "ja334:5.1": "ms22J_1058"}, "keys_order": ["ja334:0.1", "ja334:0.2", "ja334:0.3", "ja334:0.4", "ja334:1.1", "ja334:1.2", "ja334:1.3", "ja334:1.4", "ja334:2.1", "ja334:2.2", "ja334:2.3", "ja334:2.4", "ja334:2.5", "ja334:2.6", "ja334:3.1", "ja334:3.2", "ja334:3.3", "ja334:3.4", "ja334:4.1", "ja334:4.2", "ja334:4.3", "ja334:4.4", "ja334:4.5", "ja334:4.6", "ja334:5.1"]}