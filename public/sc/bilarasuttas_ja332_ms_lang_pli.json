{"html_text": {"ja332:0.1": "<article id='ja332'><header><ul><li class='division'>{}</li>", "ja332:0.2": "<li>{}</li>", "ja332:0.3": "<li>{}</li></ul>", "ja332:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja332:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja332:1.2": "<span class='verse-line'>{}</span>", "ja332:1.3": "<span class='verse-line'>{}</span>", "ja332:1.4": "<span class='verse-line'>{}</span></p>", "ja332:2.1": "<p><span class='verse-line'>{}</span>", "ja332:2.2": "<span class='verse-line'>{}</span>", "ja332:2.3": "<span class='verse-line'>{}</span>", "ja332:2.4": "<span class='verse-line'>{}</span></p>", "ja332:3.1": "<p><span class='verse-line'>{}</span>", "ja332:3.2": "<span class='verse-line'>{}</span>", "ja332:3.3": "<span class='verse-line'>{}</span>", "ja332:3.4": "<span class='verse-line'>{}</span></p>", "ja332:4.1": "<p><span class='verse-line'>{}</span>", "ja332:4.2": "<span class='verse-line'>{}</span>", "ja332:4.3": "<span class='verse-line'>{}</span>", "ja332:4.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja332:5.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja332:0.1": "Jātaka ", "ja332:0.2": "Catukkanipāta ", "ja332:0.3": "Kokilavagga ", "ja332:0.4": "2. Rathalaṭṭhijātaka ", "ja332:1.1": "“Api hantvā hato brūti, ", "ja332:1.2": "jetvā jitoti bhāsati; ", "ja332:1.3": "Pubbamakkhāyino rāja, ", "ja332:1.4": "aññadatthu na saddahe. ", "ja332:2.1": "Tasmā paṇḍitajātiyo, ", "ja332:2.2": "suṇeyya itarassapi; ", "ja332:2.3": "Ubhinnaṁ vacanaṁ sutvā, ", "ja332:2.4": "yathā dhammo tathā kare. ", "ja332:3.1": "Alaso gihī kāmabhogī na sādhu, ", "ja332:3.2": "Asaññato pabbajito na sādhu; ", "ja332:3.3": "Rājā na sādhu anisammakārī, ", "ja332:3.4": "Yo paṇḍito kodhano taṁ na sādhu. ", "ja332:4.1": "Nisamma khattiyo kayirā, ", "ja332:4.2": "nānisamma disampati; ", "ja332:4.3": "Nisammakārino rāja, ", "ja332:4.4": "yaso kitti ca vaḍḍhatī”ti. ", "ja332:5.1": "Rathalaṭṭhijātakaṁ dutiyaṁ. "}, "variant_text": {"ja332:0.1": "", "ja332:0.2": "", "ja332:0.3": "", "ja332:0.4": "", "ja332:1.1": "", "ja332:1.2": "", "ja332:1.3": "Pubbamakkhāyino → pubbevakkhāyino (pts-vp-pli1); pubbavakkhāyino (mr) | rāja → rañño (si, sya1ed, sya2ed) ", "ja332:1.4": "aññadatthu → ekadatthu (bj, pts-vp-pli1); etadatthuṁ (sya1ed, sya2ed) ", "ja332:2.1": "", "ja332:2.2": "", "ja332:2.3": "", "ja332:2.4": "", "ja332:3.1": "", "ja332:3.2": "", "ja332:3.3": "", "ja332:3.4": "", "ja332:4.1": "", "ja332:4.2": "", "ja332:4.3": "", "ja332:4.4": "", "ja332:5.1": ""}, "reference_text": {"ja332:0.1": "", "ja332:0.2": "", "ja332:0.3": "", "ja332:0.4": "", "ja332:1.1": "ms22J_1044, msdiv125, ndp22.101, pts-vp-pli3.105, sya27.150", "ja332:1.2": "", "ja332:1.3": "", "ja332:1.4": "", "ja332:2.1": "ms22J_1045, msdiv126", "ja332:2.2": "", "ja332:2.3": "", "ja332:2.4": "", "ja332:3.1": "dr27.150, ms22J_1046, msdiv127", "ja332:3.2": "", "ja332:3.3": "", "ja332:3.4": "", "ja332:4.1": "ms22J_1047, msdiv128, pts-vp-pli3.106", "ja332:4.2": "", "ja332:4.3": "", "ja332:4.4": "", "ja332:5.1": "ms22J_1048"}, "keys_order": ["ja332:0.1", "ja332:0.2", "ja332:0.3", "ja332:0.4", "ja332:1.1", "ja332:1.2", "ja332:1.3", "ja332:1.4", "ja332:2.1", "ja332:2.2", "ja332:2.3", "ja332:2.4", "ja332:3.1", "ja332:3.2", "ja332:3.3", "ja332:3.4", "ja332:4.1", "ja332:4.2", "ja332:4.3", "ja332:4.4", "ja332:5.1"]}