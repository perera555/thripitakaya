[{"acronym": "Ja 381", "alt_acronym": null, "volpages": "PTS 3.255, PTS 3.256", "alt_volpages": null, "uid": "ja381", "blurb": "“Your ways, my son”—The Master told this tale in Jetavana, of an unruly Brother. The Master asked the Brother, “Are you really unruly?” He said, “Yes, lord”: and the Master saying, “You are not unruly for the first time; formerly too through unruliness you did not the bidding of the wise and met your death by the Verambha winds,” told an old-world tale.", "difficulty": null, "original_title": "Migālopajātaka", "root_lang": "pli", "root_lang_name": "Pāli", "type": "leaf", "translated_title": "Migalopa Jātaka", "translations": [{"lang": "pli", "lang_name": "Pāli", "is_root": true, "author": "Mahāsaṅgīti Tipiṭaka Buddhavasse 2500", "author_short": "ms", "author_uid": "ms", "publication_date": null, "id": "ja381_root-pli-ms", "segmented": true, "title": null, "volpage": null, "has_comment": false}, {"lang": "de", "lang_name": "Deutsch", "is_root": false, "author": "Dr. Julius Dutoit", "author_short": "Dutoit", "author_uid": "dutoit", "publication_date": "2007", "id": "de_ja381_dutoit", "segmented": false, "volpage": null, "has_comment": false}, {"author": "H.T. Francis, R.A. Neil", "author_short": "Francis …", "author_uid": "francis-neil", "has_comment": false, "id": "en_ja381_francis-neil", "is_root": false, "lang": "en", "lang_name": "English", "publication_date": "1897", "segmented": false, "volpage": null, "title": "Migalopa Jātaka"}, {"lang": "jpn", "lang_name": "日本語", "is_root": false, "author": "関西パーリ語実習会", "author_short": "関西パーリ語実習会", "author_uid": "kansai", "publication_date": "2023", "id": "jpn_ja381_kansai", "segmented": false, "volpage": null, "has_comment": false}, {"lang": "si", "lang_name": "සිංහල", "is_root": false, "author": "A.P. de Zoysa", "author_short": "Zoysa", "author_uid": "zoysa", "publication_date": null, "id": "si_ja381_zoysa", "segmented": false, "volpage": null, "has_comment": false}], "parallel_count": 0, "biblio":