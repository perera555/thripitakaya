{"html_text": {"ja161:0.1": "<article id='ja161'><header><ul><li class='division'>{}</li>", "ja161:0.2": "<li>{}</li>", "ja161:0.3": "<li>{}</li></ul>", "ja161:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja161:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja161:1.2": "<span class='verse-line'>{}</span>", "ja161:1.3": "<span class='verse-line'>{}</span>", "ja161:1.4": "<span class='verse-line'>{}</span></p>", "ja161:2.1": "<p><span class='verse-line'>{}</span>", "ja161:2.2": "<span class='verse-line'>{}</span>", "ja161:2.3": "<span class='verse-line'>{}</span>", "ja161:2.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja161:3.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja161:0.1": "Jātaka ", "ja161:0.2": "Dukanipāta ", "ja161:0.3": "Santhavavagga ", "ja161:0.4": "1. Indasamānagottajātaka ", "ja161:1.1": "“Na santhavaṁ kāpurisena kayirā, ", "ja161:1.2": "Ariyo anariyena pajānamatthaṁ; ", "ja161:1.3": "Cirānuvutthopi karoti pāpaṁ, ", "ja161:1.4": "Gajo yathā indasamānagottaṁ. ", "ja161:2.1": "Yaṁ tveva jaññā sadiso mamanti, ", "ja161:2.2": "Sīlena paññāya sutena cāpi; ", "ja161:2.3": "Teneva mettiṁ kayirātha saddhiṁ, ", "ja161:2.4": "Sukho have sappurisena saṅgamo”ti. ", "ja161:3.1": "Indasamānagottajātakaṁ paṭhamaṁ. "}, "variant_text": {"ja161:0.1": "", "ja161:0.2": "", "ja161:0.3": "", "ja161:0.4": "", "ja161:1.1": "santhavaṁ → sandhavaṁ (mr) ", "ja161:1.2": "", "ja161:1.3": "", "ja161:1.4": "", "ja161:2.1": "", "ja161:2.2": "", "ja161:2.3": "", "ja161:2.4": "", "ja161:3.1": ""}, "reference_text": {"ja161:0.1": "", "ja161:0.2": "", "ja161:0.3": "", "ja161:0.4": "", "ja161:1.1": "bj30.70, csp1ed22.40, csp2ed22.40, dr27.55, ms22J_374, msdiv21, pts-vp-pli2.42", "ja161:1.2": "", "ja161:1.3": "", "ja161:1.4": "", "ja161:2.1": "ms22J_375, msdiv22, ndp22.38", "ja161:2.2": "", "ja161:2.3": "", "ja161:2.4": "", "ja161:3.1": "ms22J_376"}, "keys_order": ["ja161:0.1", "ja161:0.2", "ja161:0.3", "ja161:0.4", "ja161:1.1