{"html_text": {"ja399:0.1": "<article id='ja399'><header><ul><li class='division'>{}</li>", "ja399:0.2": "<li>{}</li>", "ja399:0.3": "<li>{}</li></ul>", "ja399:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja399:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja399:1.2": "<span class='verse-line'>{}</span>", "ja399:1.3": "<span class='verse-line'>{}</span>", "ja399:1.4": "<span class='verse-line'>{}</span></p>", "ja399:2.1": "<p><span class='verse-line'>{}</span>", "ja399:2.2": "<span class='verse-line'>{}</span>", "ja399:2.3": "<span class='verse-line'>{}</span>", "ja399:2.4": "<span class='verse-line'>{}</span></p>", "ja399:3.1": "<p><span class='verse-line'>{}</span>", "ja399:3.2": "<span class='verse-line'>{}</span>", "ja399:3.3": "<span class='verse-line'>{}</span>", "ja399:3.4": "<span class='verse-line'>{}</span></p>", "ja399:4.1": "<p><span class='verse-line'>{}</span>", "ja399:4.2": "<span class='verse-line'>{}</span>", "ja399:4.3": "<span class='verse-line'>{}</span>", "ja399:4.4": "<span class='verse-line'>{}</span></p>", "ja399:5.1": "<p><span class='verse-line'>{}</span>", "ja399:5.2": "<span class='verse-line'>{}</span>", "ja399:5.3": "<span class='verse-line'>{}</span>", "ja399:5.4": "<span class='verse-line'>{}</span></p>", "ja399:6.1": "<p><span class='verse-line'>{}</span>", "ja399:6.2": "<span class='verse-line'>{}</span>", "ja399:6.3": "<span class='verse-line'>{}</span>", "ja399:6.4": "<span class='verse-line'>{}</span></p>", "ja399:7.1": "<p><span class='verse-line'>{}</span>", "ja399:7.2": "<span class='verse-line'>{}</span>", "ja399:7.3": "<span class='verse-line'>{}</span>", "ja399:7.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja399:8.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja399:0.1": "Jātaka ", "ja399:0.2": "Sattakanipāta ", "ja399:0.3": "Kukkuvagga ", "ja399:0.4": "4. Mātuposakagijjhajātaka ", "ja399:1.1": "“Te kathaṁ nu karissanti, ", "ja399:1.2": "vuddhā giridarīsayā; ", "ja399:1.3": "Ahaṁ baddhosmi pāsena, ", "ja399:1.4": "nilīyassa vasaṁ gato”. ", "ja399:2.1": "“Kiṁ gijjha paridevasi, ", "ja399:2.2": "kā nu te paridevanā; ", "ja399:2.3": "Na me suto vā diṭṭho vā, ", "ja399:2.4": "bhāsanto mānusiṁ dijo”. ", "ja399:3.1": "“Bharāmi mātāpitaro, ", "ja399:3.2": "vuddhe giridarīsaye; ", "ja399:3.3": "Te kathaṁ nu karissanti, ", "ja399:3.4": "ahaṁ vasaṁ gato tava”. ", "ja399:4.1": "“Yannu gijjho yojanasataṁ, ", "ja399:4.2": "kuṇapāni avekkhati; ", "ja399:4.3": "Kasmā jālañca pāsañca, ", "ja399:4.4": "āsajjāpi na bujjhasi”. ", "ja399:5.1": "“Yadā parābhavo hoti, ", "ja399:5.2": "poso jīvitasaṅkhaye; ", "ja399:5.3": "Atha jālañca pāsañca, ", "ja399:5.4": "āsajjāpi na bujjhati”. ", "ja399:6.1": "“Bharassu mātāpitaro, ", "ja399:6.2": "vuddhe giridarīsaye; ", "ja399:6.3": "Mayā tvaṁ samanuññāto, ", "ja399:6.4": "sotthiṁ passāhi ñātake”. ", "ja399:7.1": "“Evaṁ luddaka nandassu, ", "ja399:7.2": "saha sabbehi ñātibhi; ", "ja399:7.3": "Bharissaṁ mātāpitaro, ", "ja399:7.4": "vuddhe giridarīsaye”ti. ", "ja399:8.1": "Mātuposakagijjhajātakaṁ catutthaṁ. "}, "variant_text": {"ja399:0.1": "", "ja399:0.2": "", "ja399:0.3": "", "ja399:0.4": "", "ja399:1.1": "", "ja399:1.2": "", "ja399:1.3": "", "ja399:1.4": "", "ja399:2.1": "", "ja399:2.2": "", "ja399:2.3": "", "ja399:2.4": "", "ja399:3.1": "", "ja399:3.2": "", "ja399:3.3": "", "ja399:3.4": "", "ja399:4.1": "", "ja399:4.2": "", "ja399:4.3": "", "ja399:4.4": "", "ja399:5.1": "", "ja399:5.2": "", "ja399:5.3": "", "ja399:5.4": "", "ja399:6.1": "", "ja399:6.2": "", "ja399:6.3": "", "ja399:6.4": "", "ja399:7.1": "", "ja399:7.2": "", "ja399:7.3": "", "ja399:7.4": "", "ja399:8.1": "Mātuposakagijjhajātakaṁ → gijjhajātakaṁ (bj, pts-vp-pli1) "}, "reference_text": {"ja399:0.1": "", "ja399:0.2": "", "ja399:0.3": "", "ja399:0.4": "", "ja399:1.1": "csp1ed22.158, csp2ed22.158, ms22J_1509, msdiv22, pts-vp-pli3.330, vri68.131", "ja399:1.2": "", "ja399:1.3": "", "ja399:1.4": "", "ja399:2.1": "dr27.214, ms22J_1510, msdiv23