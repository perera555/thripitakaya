{"html_text": {"ja112:0.1": "<article id='ja112'><header><ul><li class='division'>{}</li>", "ja112:0.2": "<li>{}</li>", "ja112:0.3": "<li>{}</li></ul>", "ja112:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja112:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja112:1.2": "<span class='verse-line'>{}</span>", "ja112:1.3": "<span class='verse-line'>{}</span>", "ja112:1.4": "<span class='verse-line'>{}</span>", "ja112:1.5": "<span class='verse-line'>{}</span>", "ja112:1.6": "<span class='verse-line'>{}</span></p></blockquote>", "ja112:2.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja112:0.1": "Jātaka ", "ja112:0.2": "Ekakanipāta ", "ja112:0.3": "Haṁcivagga ", "ja112:0.4": "2. Amarādevīpañhajātaka ", "ja112:1.1": "“Yena sattubilaṅgā ca, ", "ja112:1.2": "Diguṇapalāso ca pupphito; ", "ja112:1.3": "Yena dadāmi tena vadāmi, ", "ja112:1.4": "Yena na dadāmi na tena vadāmi; ", "ja112:1.5": "Esa maggo yavamajjhakassa, ", "ja112:1.6": "Etaṁ channapathaṁ vijānāhī”ti. ", "ja112:2.1": "Amarādevīpañhajātakaṁ dutiyaṁ. "}, "variant_text": {"ja112:0.1": "", "ja112:0.2": "", "ja112:0.3": "", "ja112:0.4": "", "ja112:1.1": "", "ja112:1.2": "", "ja112:1.3": "Yena dadāmi → yena nādāmi (bj); yenā'dāmi (sya1ed, sya2ed) ", "ja112:1.4": "Yena na dadāmi → yena nā'dāmi (bj, sya1ed, sya2ed) ", "ja112:1.5": "", "ja112:1.6": "", "ja112:2.1": "Amarādevīpañhajātakaṁ → amarādevipañho (bj); amarādevīpaṇho (sya1ed, sya2ed, pts-vp-pli1) "}, "reference_text": {"ja112:0.1": "", "ja112:0.2": "", "ja112:0.3": "", "ja112:0.4": "", "ja112:1.1": "ms22J_249, msdiv112, sya27.37", "ja112:1.2": "", "ja112:1.3": "", "ja112:1.4": "", "ja112:1.5": "", "ja112:1.6": "", "ja112:2.1": "ms22J_250"}, "keys_order": ["ja112:0.1", "ja112:0.2", "ja112:0.3", "ja112:0.4", "ja112:1.1", "ja112:1.2", "ja112:1.3", "ja112:1.4", "ja112:1.5", "ja112:1.6", "ja112:2.1"]}