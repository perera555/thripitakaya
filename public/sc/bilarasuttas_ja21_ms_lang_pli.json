{"html_text": {"ja21:0.1": "<article id='ja21'><header><ul><li class='division'>{}</li>", "ja21:0.2": "<li>{}</li>", "ja21:0.3": "<li>{}</li></ul>", "ja21:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja21:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja21:1.2": "<span class='verse-line'>{}</span>", "ja21:1.3": "<span class='verse-line'>{}</span>", "ja21:1.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja21:2.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja21:0.1": "Jātaka ", "ja21:0.2": "Ekakanipāta ", "ja21:0.3": "Kuruṅgavagga ", "ja21:0.4": "1. Kuruṅgamigajātaka ", "ja21:1.1": "“Ñātametaṁ kuruṅgassa, ", "ja21:1.2": "yaṁ tvaṁ sepaṇṇi siyyasi; ", "ja21:1.3": "Aññaṁ sepaṇṇi gacchāmi, ", "ja21:1.4": "na me te ruccate phalan”ti. ", "ja21:2.1": "Kuruṅgamigajātakaṁ paṭhamaṁ. "}, "variant_text": {"ja21:0.1": "", "ja21:0.2": "", "ja21:0.3": "", "ja21:0.4": "", "ja21:1.1": "", "ja21:1.2": "siyyasi → seyyasi (bj, sya1ed, sya2ed, pts-vp-pli1) ", "ja21:1.3": "", "ja21:1.4": "", "ja21:2.1": ""}, "reference_text": {"ja21:0.1": "", "ja21:0.2": "", "ja21:0.3": "", "ja21:0.4": "", "ja21:1.1": "bj30.10, dr27.9, ms22J_46, msdiv21, pts-vp-pli1.174, sya27.8, vri68.6", "ja21:1.2": "", "ja21:1.3": "", "ja21:1.4": "", "ja21:2.1": "ms22J_47"}, "keys_order": ["ja21:0.1", "ja21:0.2", "ja21:0.3", "ja21:0.4", "ja21:1.1", "ja21:1.2", "ja21:1.3", "ja21:1.4", "ja21:2.1"]}