{"html_text": {"ja362:0.1": "<article id='ja362'><header><ul><li class='division'>{}</li>", "ja362:0.2": "<li>{}</li>", "ja362:0.3": "<li>{}</li></ul>", "ja362:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja362:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja362:1.2": "<span class='verse-line'>{}</span>", "ja362:1.3": "<span class='verse-line'>{}</span>", "ja362:1.4": "<span class='verse-line'>{}</span></p>", "ja362:2.1": "<p><span class='verse-line'>{}</span>", "ja362:2.2": "<span class='verse-line'>{}</span>", "ja362:2.3": "<span class='verse-line'>{}</span>", "ja362:2.4": "<span class='verse-line'>{}</span></p>", "ja362:3.1": "<p><span class='verse-line'>{}</span>", "ja362:3.2": "<span class='verse-line'>{}</span>", "ja362:3.3": "<span class='verse-line'>{}</span>", "ja362:3.4": "<span class='verse-line'>{}</span></p>", "ja362:4.1": "<p><span class='verse-line'>{}</span>", "ja362:4.2": "<span class='verse-line'>{}</span>", "ja362:4.3": "<span class='verse-line'>{}</span>", "ja362:4.4": "<span class='verse-line'>{}</span></p>", "ja362:5.1": "<p><span class='verse-line'>{}</span>", "ja362:5.2": "<span class='verse-line'>{}</span>", "ja362:5.3": "<span class='verse-line'>{}</span>", "ja362:5.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja362:6.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja362:0.1": "Jātaka ", "ja362:0.2": "Pañcakanipāta ", "ja362:0.3": "Vaṇṇārohavagga ", "ja362:0.4": "2. Sīlavīmaṁsajātaka ", "ja362:1.1": "“Sīlaṁ seyyo sutaṁ seyyo, ", "ja362:1.2": "iti me saṁsayo ahu; ", "ja362:1.3": "Sīlameva sutā seyyo, ", "ja362:1.4": "iti me natthi saṁsayo. ", "ja362:2.1": "Moghā jāti ca vaṇṇo ca, ", "ja362:2.2": "sīlameva kiruttamaṁ; ", "ja362:2.3": "Sīlena anupetassa, ", "ja362:2.4": "sutenattho na vijjati. ", "ja362:3.1": "Khattiyo ca adhammaṭṭho, ", "ja362:3.2": "vesso cādhammanissito; ", "ja362:3.3": "Te pariccajjubho loke, ", "ja362:3.4": "upapajjanti duggatiṁ. ", "ja362:4.1": "Khattiyā brāhmaṇā vessā, ", "ja362:4.2": "suddā caṇḍālapukkusā; ", "ja362:4.3": "Idha dhammaṁ caritvāna, ", "ja362:4.4": "bhavanti tidive samā. ", "ja362:5.1": "Na vedā samparāyāya, ", "ja362:5.2": "Na jāti nāpi bandhavā; ", "ja362:5.3": "Sakañca sīlaṁ saṁsuddhaṁ, ", "ja362:5.4": "Samparāyāya sukhāya cā”ti. ", "ja362:6.1": "Sīlavīmaṁsajātakaṁ dutiyaṁ. "}, "variant_text": {"ja362:0.1": "", "ja362:0.2": "", "ja362:0.3": "", "ja362:0.4": "", "ja362:1.1": "", "ja362:1.2": "", "ja362:1.3": "", "ja362:1.4": "", "ja362:2.1": "", "ja362:2.2": "", "ja362:2.3": "", "ja362:2.4": "", "ja362:3.1": "", "ja362:3.2": "", "ja362:3.3": "", "ja362:3.4": "", "ja362:4.1": "", "ja362:4.2": "", "ja362:4.3": "", "ja362:4.4": "", "ja362:5.1": "", "ja362:5.2": "nāpi → nopi (bj, pts-vp-pli1); napi (sya1ed, sya2ed) ", "ja362:5.3": "", "ja362:5.4": "sukhāya cā”ti → sukhāvahanti (bj, sya1ed, sya2ed) ", "ja362:6.1": ""}, "reference_text": {"ja362:0.1": "", "ja362:0.2": "", "ja362:0.3": "", "ja362:0.4": "", "ja362:1.1": "ms22J_1223, msdiv65, pts-vp-pli3.194, sya27.175", "ja362:1.2": "", "ja362:1.3": "", "ja362:1.4": "", "ja362:2.1": "dr27.175, ms22J_1224, msdiv66", "ja362:2.2": "", "ja362:2.3": "", "ja362:2.4": "", "ja362:3.1": "ms22J_1225, msdiv67", "ja362:3.2": "", "ja362:3.3": "", "ja362:3.4": "", "ja362:4.1": "ms22J_1226, msdiv68", "ja362:4.2": "", "ja362:4.3": "", "ja362:4.4": "", "ja362:5.1": "ms22J_1227, msdiv69, pts-vp-pli3.195", "ja362:5.2": "", "ja362:5.3": "", "ja362:5.4": "", "ja362:6.1": "ms22J_1228"}, "keys_order": ["ja362:0.1", "ja362:0.2", "ja362:0.3", "ja362:0.4", "ja362:1.1", "ja362:1.2", "ja362:1.3", "ja362:1.4", "ja362:2.1", "ja362:2.2", "ja362:2.3", "ja362:2.4", "ja362:3.1", "ja362:3.2", "ja362:3.3", "ja362:3.4", "ja362:4.1", "ja362:4.2", "ja362:4.3", "ja362:4.4", "ja362:5.1", "ja362:5.2", "ja362:5.3", "ja362:5.4", "ja362:6.1"]}