[{"acronym": "Ja 83", "alt_acronym": null, "volpages": "PTS 1.365", "alt_volpages": null, "uid": "ja83", "blurb": "“A friend is he.”—This story was told by the Master while at Jetavana, about a friend of Anatha-pindika’s. Tradition says that the two had made mud-pies together, and had gone to the same school; but, as years went by, the friend, whose name was ‘Curse,’ sank into great distress and could not make a living anyhow. So he came to the rich man, who was kind to him, and paid him to look after all his property; and the poor friend was employed under Anatha-pindika and did all his business for him. After he had gone up to the rich man’s It was a common thing to hear in the house—“Stand up, Curse,” or “Sit down, Curse,” or “Have your dinner, Curse.” ", "difficulty": null, "original_title": "Kāḷakaṇṇijātaka", "root_lang": "pli", "root_lang_name": "Pāli", "type": "leaf", "translated_title": "Kalakanni Jātaka", "translations": [{"lang": "pli", "lang_name": "Pāli", "is_root": true, "author": "Mahāsaṅgīti Tipiṭaka Buddhavasse 2500", "author_short": "ms", "author_uid": "ms", "publication_date": null, "id": "ja83_root-pli-ms", "segmented": true, "title": null, "volpage": null, "has_comment": false}, {"lang": "de", "lang_name": "Deutsch", "is_root": false, "author": "Dr. Julius Dutoit", "author_short": "Dutoit", "author_uid": "dutoit", "publication_date": "2007", "id": "de_ja83_dutoit", "segmented": false, "volpage": null, "has_comment": false}, {"author": "Robert Chalmers", "author_short": "Chalmers", "author_uid": "chalmers", "has_comment": false, "id": "en_ja83_chalmers", "is_root": false, "lang": "en", "lang_name": "English", "publication_date": "1895", "segmented": false, "volpage": null, "title": "Kalakanni Jātaka"}, {"lang": "jpn", "lang_name": "日本語", "is_root": false, "author": "関西パーリ語実習会", "author_short": "関西パーリ語実習会", "author_uid": "kansai", "publication_date": "2023", "id": "jpn_ja83_kansai", "segmented": false, "volpage": null, "has_comment": false}, {"lang