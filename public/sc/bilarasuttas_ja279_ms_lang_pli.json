{"html_text": {"ja279:0.1": "<article id='ja279'><header><ul><li class='division'>{}</li>", "ja279:0.2": "<li>{}</li>", "ja279:0.3": "<li>{}</li></ul>", "ja279:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja279:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja279:1.2": "<span class='verse-line'>{}</span>", "ja279:1.3": "<span class='verse-line'>{}</span>", "ja279:1.4": "<span class='verse-line'>{}</span>", "ja279:1.5": "<span class='verse-line'>{}</span>", "ja279:1.6": "<span class='verse-line'>{}</span></p>", "ja279:2.1": "<p><span class='verse-line'>{}</span>", "ja279:2.2": "<span class='verse-line'>{}</span>", "ja279:2.3": "<span class='verse-line'>{}</span>", "ja279:2.4": "<span class='verse-line'>{}</span></p>", "ja279:3.1": "<p><span class='verse-line'>{}</span>", "ja279:3.2": "<span class='verse-line'>{}</span>", "ja279:3.3": "<span class='verse-line'>{}</span>", "ja279:3.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja279:4.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja279:0.1": "Jātaka ", "ja279:0.2": "Tikanipāta ", "ja279:0.3": "Udapānavagga ", "ja279:0.4": "9. Satapattajātaka ", "ja279:1.1": "“Yathā māṇavako panthe, ", "ja279:1.2": "siṅgāliṁ vanagocariṁ; ", "ja279:1.3": "Atthakāmaṁ pavedentiṁ, ", "ja279:1.4": "anatthakāmāti maññati; ", "ja279:1.5": "Anatthakāmaṁ satapattaṁ, ", "ja279:1.6": "atthakāmoti maññati. ", "ja279:2.1": "Evameva idhekacco, ", "ja279:2.2": "puggalo hoti tādiso; ", "ja279:2.3": "Hitehi vacanaṁ vutto, ", "ja279:2.4": "paṭigaṇhāti vāmato. ", "ja279:3.1": "Ye ca kho naṁ pasaṁsanti, ", "ja279:3.2": "bhayā ukkaṁsayanti vā; ", "ja279:3.3": "Tañhi so maññate mittaṁ, ", "ja279:3.4": "satapattaṁva māṇavo”ti. ", "ja279:4.1": "Satapattajātakaṁ navamaṁ. "}, "variant_text": {"ja279:0.1": "", "ja279:0.2": "", "ja279:0.3": "", "ja279:0.4": "", "ja279:1.1": "", "ja279:1.2": "", "ja279:1.3": "pavedentiṁ → pavedenti (sya1ed, sya2ed); pavadantiṁ (pts-vp-pli1) ", "ja279:1.4": "", "ja279:1.5": "", "ja279:1.6": "", "ja279:2.1": "", "ja279:2.2": "", "ja279:2.3": "", "ja279:2.4": "vā → ca (bj, pts-vp-pli1) ", "ja279:3.1": "", "ja279:3.2": "", "ja279:3.3": "", "ja279:3.4": "", "ja279:4.1": ""}, "reference_text": {"ja279:0.1": "", "ja279:0.2": "", "ja279:0.3": "", "ja279:0.4": "", "ja279:1.1": "bj30.144, csp1ed22.83, csp2ed22.83, ms22J_786, msdiv85, pts-vp-pli2.389", "ja279:1.2": "", "ja279:1.3": "", "ja279:1.4": "", "ja279:1.5": "", "ja279:1.6": "", "ja279:2.1": "ms22J_787, msdiv86, ndp22.77", "ja279:2.2": "", "ja279:2.3": "", "ja279:2.4": "", "ja279:3.1": "ms22J_788, msdiv87, pts-vp-pli2.390, sya27.115, vri68.73", "ja279:3.2": "", "ja279:3.3": "", "ja279:3.4": "", "ja279:4.1": "ms22J_789"}, "keys_order": ["ja279:0.1", "ja279:0.2", "ja279:0.3", "ja279:0.4", "ja279:1.1", "ja279:1.2", "ja279:1.3", "ja279:1.4", "ja279:1.5", "ja279:1.6", "ja279:2.1", "ja279:2.2", "ja279:2.3", "ja279:2.4", "ja279:3.1", "ja279:3.2", "ja279:3.3", "ja279:3.4", "ja279:4.1"]}