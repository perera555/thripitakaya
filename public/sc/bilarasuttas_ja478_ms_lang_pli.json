{"html_text": {"ja478:0.1": "<article id='ja478'><header><ul><li class='division'>{}</li>", "ja478:0.2": "<li>{}</li>", "ja478:0.3": "<li>{}</li></ul>", "ja478:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja478:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja478:1.2": "<span class='verse-line'>{}</span>", "ja478:1.3": "<span class='verse-line'>{}</span>", "ja478:1.4": "<span class='verse-line'>{}</span></p>", "ja478:2.1": "<p><span class='verse-line'>{}</span>", "ja478:2.2": "<span class='verse-line'>{}</span>", "ja478:2.3": "<span class='verse-line'>{}</span>", "ja478:2.4": "<span class='verse-line'>{}</span></p>", "ja478:3.1": "<p><span class='verse-line'>{}</span>", "ja478:3.2": "<span class='verse-line'>{}</span>", "ja478:3.3": "<span class='verse-line'>{}</span>", "ja478:3.4": "<span class='verse-line'>{}</span></p>", "ja478:4.1": "<p><span class='verse-line'>{}</span>", "ja478:4.2": "<span class='verse-line'>{}</span>", "ja478:4.3": "<span class='verse-line'>{}</span>", "ja478:4.4": "<span class='verse-line'>{}</span></p>", "ja478:5.1": "<p><span class='verse-line'>{}</span>", "ja478:5.2": "<span class='verse-line'>{}</span>", "ja478:5.3": "<span class='verse-line'>{}</span>", "ja478:5.4": "<span class='verse-line'>{}</span></p>", "ja478:6.1": "<p><span class='verse-line'>{}</span>", "ja478:6.2": "<span class='verse-line'>{}</span>", "ja478:6.3": "<span class='verse-line'>{}</span>", "ja478:6.4": "<span class='verse-line'>{}</span></p>", "ja478:7.1": "<p><span class='verse-line'>{}</span>", "ja478:7.2": "<span class='verse-line'>{}</span>", "ja478:7.3": "<span class='verse-line'>{}</span>", "ja478:7.4": "<span class='verse-line'>{}</span></p>", "ja478:8.1": "<p><span class='verse-line'>{}</span>", "ja478:8.2": "<span class='verse-line'>{}</span>", "ja478:8.3": "<span class='verse-line'>{}</span>", "ja478:8.4": "<span class='verse-line'>{}</span></p>", "ja478:9.1": "<p><span class='verse-line'>{}</span>", "ja478:9.2": "<span class='verse-line'>{}</span>", "ja478:9.3": "<span class='verse-line'>{}</span>", "ja478:9.4": "<span class='verse-line'>{}</span></p>", "ja478:10.1": "<p><span class='verse-line'>{}</span>", "ja478:10.2": "<span class='verse-line'>{}</span>", "ja478:10.3": "<span class='verse-line'>{}</span>", "ja478:10.4": "<span class='verse-line'>{}</span>", "ja478:10.5": "<span class='verse-line'>{}</span>", "ja478:10.6": "<span class='verse-line'>{}</span></p>", "ja478:11.1": "<p><span class='verse-line'>{}</span>", "ja478:11.2": "<span class='verse-line'>{}</span>", "ja478:11.3": "<span class='verse-line'>{}</span>", "ja478:11.4": "<span class='verse-line'>{}</span></p>", "ja478:12.1": "<p><span class='verse-line'>{}</span>", "ja478:12.2": "<span class='verse-line'>{}</span>", "ja478:12.3": "<span class='verse-line'>{}</span>", "ja478:12.4": "<span class='verse-line'>{}</span></p>", "ja478:13.1": "<p><span class='verse-line'>{}</span>", "ja478:13.2": "<span class='verse-line'>{}</span>", "ja478:13.3": "<span class='verse-line'>{}</span>", "ja478:13.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja478:14.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja478:0.1": "Jātaka ", "ja478:0.2": "Terasakanipāta ", "ja478:0.3": "Ambavagga ", "ja478:0.4": "5. Dūtajātaka ", "ja478:1.1": "“Dūte te brahme pāhesiṁ, ", "ja478:1.2": "Gaṅgātīrasmi jhāyato; ", "ja478:1.3": "Tesaṁ puṭṭho na byākāsi, ", "ja478:1.4": "Dukkhaṁ guyhamataṁ nu te”. ", "ja478:2.1": "“Sace te dukkhamuppajje, ", "ja478:2.2": "kāsīnaṁ raṭṭhavaḍḍhana; ", "ja478:2.3": "Mā kho naṁ tassa akkhāhi, ", "ja478:2.4": "yo taṁ dukkhā na mocaye. ", "ja478:3.1": "Yo tassa dukkhajātassa, ", "ja478:3.2": "ekaṅgamapi bhāgaso; ", "ja478:3.3": "Vippamoceyya dhammena, ", "ja478:3.4": "kāmaṁ tassa pavedaya. ", "ja478:4.1": "Suvijānaṁ siṅgālānaṁ, ", "ja478:4.2": "sakuṇānañca vassitaṁ; ", "ja478:4.3": "Manussavassitaṁ rāja, ", "ja478:4.4": "dubbijānataraṁ tato. ", "ja478:5.1": "Api ce maññatī poso, ", "ja478:5.2": "ñāti mitto sakhāti vā; ", "ja478:5.3": "Yo pubbe sumano hutvā, ", "ja478:5.4": "pacchā sampajjate diso. ", "ja478:6.1": "Yo attano dukkhamanānupuṭṭho, ", "ja478:6.2": "Pavedaye jantu akālarūpe; ", "ja478:6.3": "Ānandino tassa bhavantimittā, ", "ja478:6.4": "Hitesino tassa dukhī bhavanti. ", "ja478:7.1": "Kālañca ñatvāna tathāvidhassa, ", "ja478:7.2": "Medhāvīnaṁ ekamanaṁ viditvā; ", "ja478:7.3": "Akkheyya tibbāni parassa dhīro, ", "ja478:7.4": "Saṇhaṁ giraṁ atthavatiṁ pamuñce. ", "ja478:8.1": "Sace ca jaññā avisayhamattano, ", "ja478:8.2": "Na te hi mayhaṁ sukhāgamāya; ", "ja478:8.3": "Ekova tibbāni saheyya dhīro, ", "ja478:8.4": "Saccaṁ hirottappamapekkhamāno. ", "ja478:9.1": "Ahaṁ raṭṭhe vicaranto, ", "ja478:9.2": "nigame rājadhāniyo; ", "ja478:9.3": "Bhikkhamāno mahārāja, ", "ja478:9.4": "ācariyassa dhanatthiko. ", "ja478:10.1": "Gahapatī rājapurise, ", "ja478:10.2": "mahāsāle ca brāhmaṇe; ", "ja478:10.3": "Alatthaṁ satta nikkhāni, ", "ja478:10.4": "suvaṇṇassa janādhipa; ", "ja478:10.5": "Te me naṭṭhā mahārāja, ", "ja478:10.6": "tasmā socāmahaṁ bhusaṁ. ", "ja478:11.1": "Purisā te mahārāja, ", "ja478:11.2": "manasānuvicintitā; ", "ja478:11.3": "Nālaṁ dukkhā pamocetuṁ, ", "ja478:11.4": "tasmā tesaṁ na byāhariṁ. ", "ja478:12.1": "Tvañca kho me mahārāja, ", "ja478:12.2": "manasānuvicintito; ", "ja478:12.3": "Alaṁ dukkhā pamocetuṁ, ", "ja478:12.4": "tasmā tuyhaṁ pavedayiṁ”. ", "ja478:13.1": "“Tassādāsi pasannatto, ", "ja478:13.2": "kāsīnaṁ raṭṭhavaḍḍhano; ", "ja478:13.3": "Jātarūpamaye nikkhe, ", "ja478:13.4": "suvaṇṇassa catuddasā”ti. ", "ja478:14.1": "Dūtajātakaṁ pañcamaṁ. "}, "variant_text": {"ja478:0.1": "", "ja478:0.2": "", "ja478:0.3": "", "ja478:0.4": "", "ja478:1.1": "brahme → dūte brāhmaṇa (mr) ", "ja478:1.2": "", "ja478:1.3": "", "ja478:1.4": "guyhamataṁ → guyhaṁ mataṁ (bj); tuyhaṁ mataṁ (sya1ed, sya2ed, mr) ", "ja478:2.1": "", "ja478:2.2": "", "ja478:2.3": "tassa → yo ca tathā (pts-vp-pli1) ", "ja478:2.4": "", "ja478:3.1": "", "ja478:3.2": "ekaṅgamapi bhāgaso → ekantaṁ api bhāsato (bj, pts-vp-pli1) ", "ja478:3.3": "", "ja478:3.4": "pavedaya → pavedaye (bj) ", "ja478:4.1": "", "ja478:4.2": "", "ja478:4.3": "", "ja478:4.4": "", "ja478:5.1": "", "ja478:5.2": "", "ja478:5.3": "", "ja478:5.4": "", "ja478:6.1": "", "ja478:6.2": "", "ja478:6.3": "bhavantimittā → bhavanta'mittā (bj, pts-vp-pli1) ", "ja478:6.4": "", "ja478:7.1": "", "ja478:7.2": "", "ja478:7.3": "tibbāni → tippāni (bj, sya1ed, sya2ed, pts-vp-pli1) ", "ja478:7.4": "", "ja478:8.1": "", "ja478:8.2": "Na te hi mayhaṁ → nāyaṁ nīti mayha (bj, pts-vp-pli1) ", "ja478:8.3": "", "ja478:8.4": "", "ja478:9.1": "", "ja478:9.2": "", "ja478:9.3": "", "ja478:9.4": "", "ja478:10.1": "", "ja478:10.2": "", "ja478:10.3": "", "ja478:10.4": "", "ja478:10.5": "", "ja478:10.6": "", "ja478:11.1": "", "ja478:11.2": "", "ja478:11.3": "", "ja478:11.4": "", "ja478:12.1": "", "ja478:12.2": "", "ja478:12.3": "", "ja478:12.4": "", "ja478:13.1": "", "ja478:13.2": "", "ja478:13.3": "", "ja478:13.4": "", "ja478:14.1": ""}, "reference_text": {"ja478:0.1": "", "ja478:0.2": "", "ja478:0.3": "", "ja478:0.4": "", "ja478:1.1": "ms22J_2441, msdiv54, pts-vp-pli4.225, sya27.350", "ja478:1.2": "", "ja478:1.3": "", "ja478:1.4": "", "ja478:2.1": "bj30.454, ms22J_2442, msdiv55", "ja478:2.2": "", "ja478:2.3": "", "ja478:2.4": "", "ja478:3.1": "ms22J_2443, msdiv56", "ja478:3.2": "", "ja478:3.3": "", "ja478:3.4": "", "ja478:4.1": "ms22J_2444, msdiv57", "ja478:4.2": "", "ja478:4.3": "", "ja478:4.4": "", "ja478:5.1": "ms22J_2445, msdiv58, pts-vp-pli4.226", "ja478:5.2": "", "ja478:5.3": "", "ja478:5.4": "", "ja478:6.1": "ms22J_2446, msdiv59", "ja478:6.2": "", "ja478:6.3": "", "ja478:6.4": "", "ja478:7.1": "dr27.350, ms22J_2447, msdiv60, ndp22.256", "ja478:7.2": "", "ja478:7.3": "", "ja478:7.4": "", "ja478:8.1": "csp1ed22.264, csp2ed22.264, ms22J_2448, msdiv61, sya27.351", "ja478:8.2": "", "ja478:8.3": "", "ja478:8.4": "", "ja478:9.1": "ms22J_2449, msdiv62, pts-vp-pli4.227, vri68.204", "ja478:9.2": "", "ja478:9.3": "", 