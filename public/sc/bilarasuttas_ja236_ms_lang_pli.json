{"html_text": {"ja236:0.1": "<article id='ja236'><header><ul><li class='division'>{}</li>", "ja236:0.2": "<li>{}</li>", "ja236:0.3": "<li>{}</li></ul>", "ja236:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja236:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja236:1.2": "<span class='verse-line'>{}</span>", "ja236:1.3": "<span class='verse-line'>{}</span>", "ja236:1.4": "<span class='verse-line'>{}</span></p>", "ja236:2.1": "<p><span class='verse-line'>{}</span>", "ja236:2.2": "<span class='verse-line'>{}</span>", "ja236:2.3": "<span class='verse-line'>{}</span>", "ja236:2.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja236:3.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja236:0.1": "Jātaka ", "ja236:0.2": "Dukanipāta ", "ja236:0.3": "Upāhanavagga ", "ja236:0.4": "6. Bakajātaka ", "ja236:1.1": "“Bhaddako vatayaṁ pakkhī, ", "ja236:1.2": "dijo kumudasannibho; ", "ja236:1.3": "Vūpasantehi pakkhehi, ", "ja236:1.4": "mandamandova jhāyati”. ", "ja236:2.1": "“Nāssa sīlaṁ vijānātha, ", "ja236:2.2": "anaññāya pasaṁsatha; ", "ja236:2.3": "Amhe dijo na pāleti, ", "ja236:2.4": "tena pakkhī na phandatī”ti. ", "ja236:3.1": "Bakajātakaṁ chaṭṭhaṁ. "}, "reference_text": {"ja236:0.1": "", "ja236:0.2": "", "ja236:0.3": "", "ja236:0.4": "", "ja236:1.1": "ms22J_617, msdiv171, ndp22.61, pts-vp-pli2.234, sya27.91", "ja236:1.2": "", "ja236:1.3": "", "ja236:1.4": "", "ja236:2.1": "ms22J_618, msdiv172", "ja236:2.2": "", "ja236:2.3": "", "ja236:2.4": "", "ja236:3.1": "ms22J_619"}, "keys_order": ["ja236:0.1", "ja236:0.2", "ja236:0.3", "ja236:0.4", "ja236:1.1", "ja236:1.2", "ja236:1.3", "ja236:1.4", "ja236:2.1", "ja236:2.2", "ja236:2.3", "ja236:2.4", "ja236:3.1"]}