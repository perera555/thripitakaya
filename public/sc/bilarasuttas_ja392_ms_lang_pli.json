{"html_text": {"ja392:0.1": "<article id='ja392'><header><ul><li class='division'>{}</li>", "ja392:0.2": "<li>{}</li>", "ja392:0.3": "<li>{}</li></ul>", "ja392:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja392:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja392:1.2": "<span class='verse-line'>{}</span>", "ja392:1.3": "<span class='verse-line'>{}</span>", "ja392:1.4": "<span class='verse-line'>{}</span></p>", "ja392:2.1": "<p><span class='verse-line'>{}</span>", "ja392:2.2": "<span class='verse-line'>{}</span>", "ja392:2.3": "<span class='verse-line'>{}</span>", "ja392:2.4": "<span class='verse-line'>{}</span></p>", "ja392:3.1": "<p><span class='verse-line'>{}</span>", "ja392:3.2": "<span class='verse-line'>{}</span>", "ja392:3.3": "<span class='verse-line'>{}</span>", "ja392:3.4": "<span class='verse-line'>{}</span></p>", "ja392:4.1": "<p><span class='verse-line'>{}</span>", "ja392:4.2": "<span class='verse-line'>{}</span>", "ja392:4.3": "<span class='verse-line'>{}</span>", "ja392:4.4": "<span class='verse-line'>{}</span></p>", "ja392:5.1": "<p><span class='verse-line'>{}</span>", "ja392:5.2": "<span class='verse-line'>{}</span>", "ja392:5.3": "<span class='verse-line'>{}</span>", "ja392:5.4": "<span class='verse-line'>{}</span></p>", "ja392:6.1": "<p><span class='verse-line'>{}</span>", "ja392:6.2": "<span class='verse-line'>{}</span>", "ja392:6.3": "<span class='verse-line'>{}</span>", "ja392:6.4": "<span class='verse-line'>{}</span></p>", "ja392:7.1": "<p><span class='verse-line'>{}</span>", "ja392:7.2": "<span class='verse-line'>{}</span>", "ja392:7.3": "<span class='verse-line'>{}</span>", "ja392:7.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja392:8.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja392:0.1": "Jātaka ", "ja392:0.2": "Chakkanipāta ", "ja392:0.3": "Kharaputtavagga ", "ja392:0.4": "7. Siṅghapupphajātaka ", "ja392:1.1": "“Yametaṁ vārijaṁ pupphaṁ, ", "ja392:1.2": "Adinnaṁ upasiṅghasi; ", "ja392:1.3": "Ekaṅgametaṁ theyyānaṁ, ", "ja392:1.4": "Gandhathenosi mārisa”. ", "ja392:2.1": "“Na harāmi na bhañjāmi, ", "ja392:2.2": "ārā siṅghāmi vārijaṁ; ", "ja392:2.3": "Atha kena nu vaṇṇena, ", "ja392:2.4": "gandhathenoti vuccati. ", "ja392:3.1": "Yoyaṁ bhisāni khaṇati, ", "ja392:3.2": "puṇḍarīkāni bhañjati; ", "ja392:3.3": "Evaṁ ākiṇṇakammanto, ", "ja392:3.4": "kasmā eso na vuccati”. ", "ja392:4.1": "“Ākiṇṇaluddo puriso, ", "ja392:4.2": "dhāticelaṁva makkhito; ", "ja392:4.3": "Tasmiṁ me vacanaṁ natthi, ", "ja392:4.4": "tañcārahāmi vattave. ", "ja392:5.1": "Anaṅgaṇassa posassa, ", "ja392:5.2": "niccaṁ sucigavesino; ", "ja392:5.3": "Vālaggamattaṁ pāpassa, ", "ja392:5.4": "abbhāmattaṁva khāyati”. ", "ja392:6.1": "“Addhā maṁ yakkha jānāsi, ", "ja392:6.2": "atho maṁ anukampasi; ", "ja392:6.3": "Punapi yakkha vajjāsi, ", "ja392:6.4": "yadā passasi edisaṁ”. ", "ja392:7.1": "“Neva taṁ upajīvāmi, ", "ja392:7.2": "napi te bhatakāmhase; ", "ja392:7.3": "Tvameva bhikkhu jāneyya, ", "ja392:7.4": "yena gaccheyya suggatin”ti. ", "ja392:8.1": "Siṅghapupphajātakaṁ sattamaṁ. "}, "variant_text": {"ja392:0.1": "", "ja392:0.2": "", "ja392:0.3": "", "ja392:0.4": "", "ja392:1.1": "Yametaṁ → yamekaṁ (pts-vp-pli1) ", "ja392:1.2": "", "ja392:1.3": "", "ja392:1.4": "", "ja392:2.1": "", "ja392:2.2": "", "ja392:2.3": "", "ja392:2.4": "", "ja392:3.1": "", "ja392:3.2": "", "ja392:3.3": "", "ja392:3.4": "", "ja392:4.1": "", "ja392:4.2": "", "ja392:4.3": "", "ja392:4.4": "", "ja392:5.1": "", "ja392:5.2": "", "ja392:5.3": "", "ja392:5.4": "", "ja392:6.1": "", "ja392:6.2": "", "ja392:6.3": "", "ja392:6.4": "", "ja392:7.1": "", "ja392:7.2": "bhatakāmhase → bhatakamhase (bj, pts-vp-pli1); bhatikamhase (sya1ed, sya2ed) ", "ja392:7.3": "", "ja392:7.4": "", "ja392:8.1": "Siṅghapupphajātakaṁ → bhisapupphajātakaṁ (bj, pts-vp-pli1); upasiṅghapupphajātakaṁ (sya1ed, sya2ed) "}, "reference_text": {"ja392:0.1": "", "ja392:0.2": "", "ja392:0.3": "", "ja392:0.4": "", "ja392:1.1": "csp1ed22.152, csp2ed22.152