{"html_text": {"ja267:0.1": "<article id='ja267'><header><ul><li class='division'>{}</li>", "ja267:0.2": "<li>{}</li>", "ja267:0.3": "<li>{}</li></ul>", "ja267:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja267:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja267:1.2": "<span class='verse-line'>{}</span>", "ja267:1.3": "<span class='verse-line'>{}</span>", "ja267:1.4": "<span class='verse-line'>{}</span></p>", "ja267:2.1": "<p><span class='verse-line'>{}</span>", "ja267:2.2": "<span class='verse-line'>{}</span>", "ja267:2.3": "<span class='verse-line'>{}</span>", "ja267:2.4": "<span class='verse-line'>{}</span></p>", "ja267:3.1": "<p><span class='verse-line'>{}</span>", "ja267:3.2": "<span class='verse-line'>{}</span>", "ja267:3.3": "<span class='verse-line'>{}</span>", "ja267:3.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja267:4.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja267:0.1": "Jātaka ", "ja267:0.2": "Tikanipāta ", "ja267:0.3": "Padumavagga ", "ja267:0.4": "7. Kakkaṭakajātaka ", "ja267:1.1": "“Siṅgīmigo āyatacakkhunetto, ", "ja267:1.2": "Aṭṭhittaco vārisayo alomo; ", "ja267:1.3": "Tenābhibhūto kapaṇaṁ rudāmi, ", "ja267:1.4": "Mā heva maṁ pāṇasamaṁ jaheyya”. ", "ja267:2.1": "“Ayya na taṁ jahissāmi, ", "ja267:2.2": "kuñjaraṁ saṭṭhihāyanaṁ; ", "ja267:2.3": "Pathabyā cāturantāya, ", "ja267:2.4": "suppiyo hosi me tuvaṁ”. ", "ja267:3.1": "“Ye kuḷīrā samuddasmiṁ, ", "ja267:3.2": "gaṅgāya yamunāya ca; ", "ja267:3.3": "Tesaṁ tvaṁ vārijo seṭṭho, ", "ja267:3.4": "muñca rodantiyā patin”ti. ", "ja267:4.1": "Kakkaṭakajātakaṁ sattamaṁ. "}, "variant_text": {"ja267:0.1": "", "ja267:0.2": "", "ja267:0.3": "", "ja267:0.4": "", "ja267:1.1": "", "ja267:1.2": "", "ja267:1.3": "", "ja267:1.4": "jaheyya → jaheyyāti (pts-vp-pli1); jahā'yye (?) ", "ja267:2.1": "", "ja267:2.2": "kuñjaraṁ saṭṭhihāyanaṁ → kuñjara saṭṭhihāyana (bj, pts-vp-pli1) ", "ja267:2.3": "", "ja267:2.4": "", "ja267:3.1": "", "ja267:3.2": "yamunāya → nammadāya (bj, pts-vp-pli1) ", "ja267:3.3": "", "ja267:3.4": "", "ja267:4.1": "Kakkaṭakajātakaṁ → suvaṇṇakakkaṭakajātakaṁ (sya1ed, sya2ed); kakkaṭajātakaṁ (pts-vp-pli1); kuḷīrajātakaṁ (mr) "}, "reference_text": {"ja267:0.1": "", "ja267:0.2": "", "ja267:0.3": "", "ja267:0.4": "", "ja267:1.1": "csp1ed22.78, csp2ed22.78, ms22J_736, msdiv49, pts-vp-pli2.343", "ja267:1.2": "", "ja267:1.3": "", "ja267:1.4": "", "ja267:2.1": "ms22J_737, msdiv50", "ja267:2.2": "", "ja267:2.3": "", "ja267:2.4": "", "ja267:3.1": "ms22J_738, msdiv51, pts-vp-pli2.344", "ja267:3.2": "", "ja267:3.3": "", "ja267:3.4": "", "ja267:4.1": "ms22J_739"}, "keys_order": ["ja267:0.1", "ja267:0.2", "ja267:0.3", "ja267:0.4", "ja267:1.1", "ja267:1.2", "ja267:1.3", "ja267:1.4", "ja267:2.1", "ja267:2.2", "ja267:2.3", "ja267:2.4", "ja267:3.1", "ja267:3.2", "ja267:3.3", "ja267:3.4", "ja267:4.1"]}