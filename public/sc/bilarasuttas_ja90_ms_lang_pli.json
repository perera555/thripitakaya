{"html_text": {"ja90:0.1": "<article id='ja90'><header><ul><li class='division'>{}</li>", "ja90:0.2": "<li>{}</li>", "ja90:0.3": "<li>{}</li></ul>", "ja90:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja90:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja90:1.2": "<span class='verse-line'>{}</span>", "ja90:1.3": "<span class='verse-line'>{}</span>", "ja90:1.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja90:2.1": "<p class='endsutta'>{}</p>", "ja90:2.2": "<p class='endvagga'>{}</p>", "ja90:3.1": "<p class='uddana-intro'>{}</p>", "ja90:4.1": "<blockquote class='uddanagatha'><p><span class='verse-line'>{}</span>", "ja90:4.2": "<span class='verse-line'>{}</span>", "ja90:4.3": "<span class='verse-line'>{}</span>", "ja90:4.4": "<span class='verse-line'>{}</span></p></blockquote></article>"}, "root_text": {"ja90:0.1": "Jātaka ", "ja90:0.2": "Ekakanipāta ", "ja90:0.3": "Apāyimhavagga ", "ja90:0.4": "10. Akataññujātaka ", "ja90:1.1": "“Yo pubbe katakalyāṇo, ", "ja90:1.2": "katattho nāvabujjhati; ", "ja90:1.3": "Pacchā kicce samuppanne, ", "ja90:1.4": "kattāraṁ nādhigacchatī”ti. ", "ja90:2.1": "Akataññujātakaṁ dasamaṁ. ", "ja90:2.2": "Apāyimhavaggo navamo. ", "ja90:3.1": "Tassuddānaṁ ", "ja90:4.1": "Apāyimha ca dūbhaka sattapadaṁ, ", "ja90:4.2": "Chaḷadvara ca āyatinā ca puna; ", "ja90:4.3": "Ahisīlava maṅgali pāpikassā, ", "ja90:4.4": "Sataṁnikkha katatthavarena dasāti. "}, "variant_text": {"ja90:0.1": "", "ja90:0.2": "", "ja90:0.3": "", "ja90:0.4": "", "ja90:1.1": "", "ja90:1.2": "", "ja90:1.3": "", "ja90:1.4": "", "ja90:2.1": "Akataññujātakaṁ → akataññūjātakaṁ (sya1ed, sya2ed, pts-vp-pli1) ", "ja90:2.2": "", "ja90:3.1": "", "ja90:4.1": "", "ja90:4.2": "", "ja90:4.3": "", "ja90:4.4": ""}, "reference_text": {"ja90:0.1": "", "ja90:0.2": "", "ja90:0.3": "", "ja90:0.4": "", "ja90:1.1": "ms22J_198, msdiv90, pts-vp-pli1.378", "ja90:1.2": "", "ja90:1.3": "", "ja90:1.4": "", "ja90:2.1": "ms22J_199", "ja90:2.2": "", "ja90:3.1": "ms22J_2