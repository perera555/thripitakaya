{"html_text": {"ja239:0.1": "<article id='ja239'><header><ul><li class='division'>{}</li>", "ja239:0.2": "<li>{}</li>", "ja239:0.3": "<li>{}</li></ul>", "ja239:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja239:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja239:1.2": "<span class='verse-line'>{}</span>", "ja239:1.3": "<span class='verse-line'>{}</span>", "ja239:1.4": "<span class='verse-line'>{}</span></p>", "ja239:2.1": "<p><span class='verse-line'>{}</span>", "ja239:2.2": "<span class='verse-line'>{}</span>", "ja239:2.3": "<span class='verse-line'>{}</span>", "ja239:2.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja239:3.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja239:0.1": "Jātaka ", "ja239:0.2": "Dukanipāta ", "ja239:0.3": "Upāhanavagga ", "ja239:0.4": "9. Haritamaṇḍūkajātaka ", "ja239:1.1": "“Āsīvisampi maṁ santaṁ, ", "ja239:1.2": "Paviṭṭhaṁ kumināmukhaṁ; ", "ja239:1.3": "Ruccate haritāmātā, ", "ja239:1.4": "Yaṁ maṁ khādanti macchakā”. ", "ja239:2.1": "“Vilumpateva puriso, ", "ja239:2.2": "yāvassa upakappati; ", "ja239:2.3": "Yadā caññe vilumpanti, ", "ja239:2.4": "so vilutto vilumpatī”ti. ", "ja239:3.1": "Haritamaṇḍūkajātakaṁ navamaṁ. "}, "variant_text": {"ja239:0.1": "", "ja239:0.2": "", "ja239:0.3": "", "ja239:0.4": "", "ja239:1.1": "Āsīvisampi maṁ → āsīvisaṁ mamaṁ (bj, pts-vp-pli1) ", "ja239:1.2": "", "ja239:1.3": "", "ja239:1.4": "", "ja239:2.1": "", "ja239:2.2": "", "ja239:2.3": "", "ja239:2.4": "vilumpatī”ti → viluppatīti (bj) ", "ja239:3.1": "Haritamaṇḍūkajātakaṁ → haritamātujātaṁ (bj); haritamātajātakaṁ (sya1ed, sya2ed, pts-vp-pli1) "}, "reference_text": {"ja239:0.1": "", "ja239:0.2": "", "ja239:0.3": "", "ja239:0.4": "", "ja239:1.1": "ms22J_626, msdiv177, pts-vp-pli2.238", "ja239:1.2": "", "ja239:1.3": "", "ja239:1.4": "", "ja239:2.1": "ms22J_627, msdiv178, pts-vp-pli2.239", "ja239:2.2": "", "ja239:2.3": "", "ja239:2.4": "", "ja239:3.1": "ms22J_628"}, "keys_order": ["ja239:0.1", "ja239