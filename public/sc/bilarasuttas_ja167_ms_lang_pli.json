{"html_text": {"ja167:0.1": "<article id='ja167'><header><ul><li class='division'>{}</li>", "ja167:0.2": "<li>{}</li>", "ja167:0.3": "<li>{}</li></ul>", "ja167:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja167:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja167:1.2": "<span class='verse-line'>{}</span>", "ja167:1.3": "<span class='verse-line'>{}</span>", "ja167:1.4": "<span class='verse-line'>{}</span></p>", "ja167:2.1": "<p><span class='verse-line'>{}</span>", "ja167:2.2": "<span class='verse-line'>{}</span>", "ja167:2.3": "<span class='verse-line'>{}</span>", "ja167:2.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja167:3.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja167:0.1": "Jātaka ", "ja167:0.2": "Dukanipāta ", "ja167:0.3": "Santhavavagga ", "ja167:0.4": "7. Samiddhijātaka ", "ja167:1.1": "“Abhutvā bhikkhasi bhikkhu, ", "ja167:1.2": "Na hi bhutvāna bhikkhasi; ", "ja167:1.3": "Bhutvāna bhikkhu bhikkhassu, ", "ja167:1.4": "Mā taṁ kālo upaccagā. ", "ja167:2.1": "Kālaṁ vohaṁ na jānāmi, ", "ja167:2.2": "channo kālo na dissati; ", "ja167:2.3": "Tasmā abhutvā bhikkhāmi, ", "ja167:2.4": "mā maṁ kālo upaccagā”ti. ", "ja167:3.1": "Samiddhijātakaṁ sattamaṁ. "}, "reference_text": {"ja167:0.1": "", "ja167:0.2": "", "ja167:0.3": "", "ja167:0.4": "", "ja167:1.1": "csp1ed22.42, csp2ed22.42, ms22J_392, msdiv33, pts-vp-pli2.57", "ja167:1.2": "", "ja167:1.3": "", "ja167:1.4": "", "ja167:2.1": "ms22J_393, msdiv34, pts-vp-pli2.58, vri68.39", "ja167:2.2": "", "ja167:2.3": "", "ja167:2.4": "", "ja167:3.1": "ms22J_394"}, "keys_order": ["ja167:0.1", "ja167:0.2", "ja167:0.3", "ja167:0.4", "ja167:1.1", "ja167:1.2", "ja167:1.3", "ja167:1.4", "ja167:2.1", "ja167:2.2", "ja167:2.3", "ja167:2.4", "ja167:3.1"]}