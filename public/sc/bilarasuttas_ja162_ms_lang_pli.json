{"html_text": {"ja162:0.1": "<article id='ja162'><header><ul><li class='division'>{}</li>", "ja162:0.2": "<li>{}</li>", "ja162:0.3": "<li>{}</li></ul>", "ja162:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja162:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja162:1.2": "<span class='verse-line'>{}</span>", "ja162:1.3": "<span class='verse-line'>{}</span>", "ja162:1.4": "<span class='verse-line'>{}</span></p>", "ja162:2.1": "<p><span class='verse-line'>{}</span>", "ja162:2.2": "<span class='verse-line'>{}</span>", "ja162:2.3": "<span class='verse-line'>{}</span>", "ja162:2.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja162:3.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja162:0.1": "Jātaka ", "ja162:0.2": "Dukanipāta ", "ja162:0.3": "Santhavavagga ", "ja162:0.4": "2. Santhavajātaka ", "ja162:1.1": "“Na santhavasmā paramatthi pāpiyo, ", "ja162:1.2": "Yo santhavo kāpurisena hoti; ", "ja162:1.3": "Santappito sappinā pāyasena, ", "ja162:1.4": "Kicchākataṁ paṇṇakuṭiṁ adayhi. ", "ja162:2.1": "Na santhavasmā paramatthi seyyo, ", "ja162:2.2": "Yo santhavo sappurisena hoti; ", "ja162:2.3": "Sīhassa byagghassa ca dīpino ca, ", "ja162:2.4": "Sāmā mukhaṁ lehati santhavenā”ti. ", "ja162:3.1": "Santhavajātakaṁ dutiyaṁ. "}, "variant_text": {"ja162:0.1": "", "ja162:0.2": "", "ja162:0.3": "", "ja162:0.4": "", "ja162:1.1": "", "ja162:1.2": "santhavo → sandhavo (mr) ", "ja162:1.3": "pāyasena → pāyāsena (sya1ed, sya2ed, mr) ", "ja162:1.4": "adayhi → adaḍḍhahi (bj, sya1ed, sya2ed); adaṭṭhahi (pts-vp-pli1); adaddahi (?) ", "ja162:2.1": "", "ja162:2.2": "", "ja162:2.3": "", "ja162:2.4": "", "ja162:3.1": ""}, "reference_text": {"ja162:0.1": "", "ja162:0.2": "", "ja162:0.3": "", "ja162:0.4": "", "ja162:1.1": "ms22J_377, msdiv23, pts-vp-pli2.44, sya27.56", "ja162:1.2": "", "ja162:1.3": "", "ja162:1.4": "", "ja162:2.1": "ms22J_378, msdiv24, pts-vp-pli2.45", "ja162:2.2": "", "ja162:2.3": "", "ja162:2.4": "", "ja162:3.1": "ms22J_379"}