{"html_text": {"ja219:0.1": "<article id='ja219'><header><ul><li class='division'>{}</li>", "ja219:0.2": "<li>{}</li>", "ja219:0.3": "<li>{}</li></ul>", "ja219:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja219:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja219:1.2": "<span class='verse-line'>{}</span>", "ja219:1.3": "<span class='verse-line'>{}</span>", "ja219:1.4": "<span class='verse-line'>{}</span></p>", "ja219:2.1": "<p><span class='verse-line'>{}</span>", "ja219:2.2": "<span class='verse-line'>{}</span>", "ja219:2.3": "<span class='verse-line'>{}</span>", "ja219:2.4": "<span class='verse-line'>{}</span>", "ja219:2.5": "<span class='verse-line'>{}</span>", "ja219:2.6": "<span class='verse-line'>{}</span></p></blockquote>", "ja219:3.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja219:0.1": "Jātaka ", "ja219:0.2": "Dukanipāta ", "ja219:0.3": "Bīraṇathambhavagga ", "ja219:0.4": "9. Garahitajātaka ", "ja219:1.1": "“Hiraññaṁ me suvaṇṇaṁ me, ", "ja219:1.2": "esā rattiṁ divā kathā; ", "ja219:1.3": "Dummedhānaṁ manussānaṁ, ", "ja219:1.4": "ariyadhammaṁ apassataṁ. ", "ja219:2.1": "Dve dve gahapatayo gehe, ", "ja219:2.2": "eko tattha amassuko; ", "ja219:2.3": "Lambatthano veṇikato, ", "ja219:2.4": "atho aṅkitakaṇṇako; ", "ja219:2.5": "Kīto dhanena bahunā, ", "ja219:2.6": "so taṁ vitudate janan”ti. ", "ja219:3.1": "Garahitajātakaṁ navamaṁ. "}, "reference_text": {"ja219:0.1": "", "ja219:0.2": "", "ja219:0.3": "", "ja219:0.4": "", "ja219:1.1": "ms22J_562, msdiv137, pts-vp-pli2.185", "ja219:1.2": "", "ja219:1.3": "", "ja219:1.4": "", "ja219:2.1": "ms22J_563, msdiv138", "ja219:2.2": "", "ja219:2.3": "", "ja219:2.4": "", "ja219:2.5": "", "ja219:2.6": "", "ja219:3.1": "ms22J_564"}, "keys_order": ["ja219:0.1", "ja219:0.2", "ja219:0.3", "ja219:0.4", "ja219:1.1", "ja219:1.2", "ja219:1.3", "ja219:1.4", "ja219:2.1", "ja219:2.2", "ja219:2.3", "ja219:2.4", "ja219:2.5", "ja219:2.6", "ja219:3.1"]}