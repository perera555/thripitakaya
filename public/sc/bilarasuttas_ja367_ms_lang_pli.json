{"html_text": {"ja367:0.1": "<article id='ja367'><header><ul><li class='division'>{}</li>", "ja367:0.2": "<li>{}</li>", "ja367:0.3": "<li>{}</li></ul>", "ja367:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja367:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja367:1.2": "<span class='verse-line'>{}</span>", "ja367:1.3": "<span class='verse-line'>{}</span>", "ja367:1.4": "<span class='verse-line'>{}</span></p>", "ja367:2.1": "<p><span class='verse-line'>{}</span>", "ja367:2.2": "<span class='verse-line'>{}</span>", "ja367:2.3": "<span class='verse-line'>{}</span>", "ja367:2.4": "<span class='verse-line'>{}</span></p>", "ja367:3.1": "<p><span class='verse-line'>{}</span>", "ja367:3.2": "<span class='verse-line'>{}</span>", "ja367:3.3": "<span class='verse-line'>{}</span>", "ja367:3.4": "<span class='verse-line'>{}</span></p>", "ja367:4.1": "<p><span class='verse-line'>{}</span>", "ja367:4.2": "<span class='verse-line'>{}</span>", "ja367:4.3": "<span class='verse-line'>{}</span>", "ja367:4.4": "<span class='verse-line'>{}</span></p>", "ja367:5.1": "<p><span class='verse-line'>{}</span>", "ja367:5.2": "<span class='verse-line'>{}</span>", "ja367:5.3": "<span class='verse-line'>{}</span>", "ja367:5.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja367:6.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja367:0.1": "Jātaka ", "ja367:0.2": "Pañcakanipāta ", "ja367:0.3": "Vaṇṇārohavagga ", "ja367:0.4": "7. Sāḷiyajātaka ", "ja367:1.1": "“Yvāyaṁ sāḷiyachāpoti, ", "ja367:1.2": "kaṇhasappaṁ agāhayi; ", "ja367:1.3": "Tena sappenayaṁ daṭṭho, ", "ja367:1.4": "hato pāpānusāsako. ", "ja367:2.1": "Ahantāra mahantāraṁ, ", "ja367:2.2": "yo naro hantumicchati; ", "ja367:2.3": "Evaṁ so nihato seti, ", "ja367:2.4": "yathāyaṁ puriso hato. ", "ja367:3.1": "Ahantāra maghātentaṁ, ", "ja367:3.2": "yo naro hantumicchati; ", "ja367:3.3": "Evaṁ so nihato seti, ", "ja367:3.4": "yathāyaṁ puriso hato. ", "ja367:4.1": "Yathā paṁsumuṭṭhiṁ puriso, ", "ja367:4.2": "paṭivātaṁ paṭikkhipe; ", "ja367:4.3": "Tameva so rajo hanti, ", "ja367:4.4": "tathāyaṁ puriso hato. ", "ja367:5.1": "Yo appaduṭṭhassa narassa dussati, ", "ja367:5.2": "Suddhassa posassa anaṅgaṇassa; ", "ja367:5.3": "Tameva bālaṁ pacceti pāpaṁ, ", "ja367:5.4": "Sukhumo rajo paṭivātaṁva khitto”ti. ", "ja367:6.1": "Sāḷiyajātakaṁ sattamaṁ. "}, "variant_text": {"ja367:0.1": "", "ja367:0.2": "", "ja367:0.3": "", "ja367:0.4": "", "ja367:1.1": "sāḷiyachāpoti → sāliya … (sya1ed, sya2ed, pts-vp-pli1); sāḷika … (?) ", "ja367:1.2": "", "ja367:1.3": "", "ja367:1.4": "", "ja367:2.1": "Ahantāra → ahananta (bj, pts-vp-pli1); ahantara (sya1ed, sya2ed); aharanta (?) ", "ja367:2.2": "", "ja367:2.3": "", "ja367:2.4": "", "ja367:3.1": "Ahantāra → ahananta (bj, sya1ed, sya2ed, pts-vp-pli1); aharanta (?) ", "ja367:3.2": "", "ja367:3.3": "", "ja367:3.4": "", "ja367:4.1": "", "ja367:4.2": "", "ja367:4.3": "", "ja367:4.4": "", "ja367:5.1": "", "ja367:5.2": "", "ja367:5.3": "", "ja367:5.4": "", "ja367:6.1": "Sāḷiyajātakaṁ → sāliyajātakaṁ (sya1ed, sya2ed, mr) "}, "reference_text": {"ja367:0.1": "", "ja367:0.2": "", "ja367:0.3": "", "ja367:0.4": "", "ja367:1.1": "bj30.224, dr27.178, ms22J_1253, msdiv90, pts-vp-pli3.203", "ja367:1.2": "", "ja367:1.3": "", "ja367:1.4": "", "ja367:2.1": "ms22J_1254, msdiv91", "ja367:2.2": "", "ja367:2.3": "", "ja367:2.4": "", "ja367:3.1": "csp1ed22.131, csp2ed22.131, ms22J_1255, msdiv92, ndp22.122", "ja367:3.2": "", "ja367:3.3": "", "ja367:3.4": "", "ja367:4.1": "ms22J_1256, msdiv93, sya27.179", "ja367:4.2": "", "ja367:4.3": "", "ja367:4.4": "", "ja367:5.1": "ms22J_1257, msdiv94", "ja367:5.2": "", "ja367:5.3": "", "ja367:5.4": "", "ja367:6.1": "ms22J_1258"}, "keys_order": ["ja367:0.1", "ja367:0.2", "ja367:0.3", "ja367:0.4", "ja367:1.1", "ja367:1.2", "ja367:1.3", "ja367:1.4", "ja367:2.1", "ja367:2.2", "ja367:2.3", "ja367:2.4", "ja367:3.1", "ja367:3.2", "ja367:3.3", "ja367:3.4", "ja367:4.1", "ja367:4.2", "ja367:4.3", "ja367:4.4", "ja367:5.1", "ja367: