{"html_text": {"ja427:0.1": "<article id='ja427'><header><ul><li class='division'>{}</li>", "ja427:0.2": "<li>{}</li>", "ja427:0.3": "<li>{}</li></ul>", "ja427:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja427:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja427:1.2": "<span class='verse-line'>{}</span>", "ja427:1.3": "<span class='verse-line'>{}</span>", "ja427:1.4": "<span class='verse-line'>{}</span>", "ja427:1.5": "<span class='verse-line'>{}</span>", "ja427:1.6": "<span class='verse-line'>{}</span></p>", "ja427:2.1": "<p><span class='verse-line'>{}</span>", "ja427:2.2": "<span class='verse-line'>{}</span>", "ja427:2.3": "<span class='verse-line'>{}</span>", "ja427:2.4": "<span class='verse-line'>{}</span></p>", "ja427:3.1": "<p><span class='verse-line'>{}</span>", "ja427:3.2": "<span class='verse-line'>{}</span>", "ja427:3.3": "<span class='verse-line'>{}</span>", "ja427:3.4": "<span class='verse-line'>{}</span>", "ja427:3.5": "<span class='verse-line'>{}</span>", "ja427:3.6": "<span class='verse-line'>{}</span></p>", "ja427:4.1": "<p><span class='verse-line'>{}</span>", "ja427:4.2": "<span class='verse-line'>{}</span>", "ja427:4.3": "<span class='verse-line'>{}</span>", "ja427:4.4": "<span class='verse-line'>{}</span></p>", "ja427:5.1": "<p><span class='verse-line'>{}</span>", "ja427:5.2": "<span class='verse-line'>{}</span>", "ja427:5.3": "<span class='verse-line'>{}</span>", "ja427:5.4": "<span class='verse-line'>{}</span></p>", "ja427:6.1": "<p><span class='verse-line'>{}</span>", "ja427:6.2": "<span class='verse-line'>{}</span>", "ja427:6.3": "<span class='verse-line'>{}</span>", "ja427:6.4": "<span class='verse-line'>{}</span></p>", "ja427:7.1": "<p><span class='verse-line'>{}</span>", "ja427:7.2": "<span class='verse-line'>{}</span>", "ja427:7.3": "<span class='verse-line'>{}</span>", "ja427:7.4": "<span class='verse-line'>{}</span></p>", "ja427:8.1": "<p><span class='verse-line'>{}</span>", "ja427:8.2": "<span class='verse-line'>{}</span>", "ja427:8.3": "<span class='verse-line'>{}</span>", "ja427:8.4": "<span class='verse-line'>{}</span></p>", "ja427:9.1": "<p><span class='verse-line'>{}</span>", "ja427:9.2": "<span class='verse-line'>{}</span>", "ja427:9.3": "<span class='verse-line'>{}</span>", "ja427:9.4": "<span class='verse-line'>{}</span>", "ja427:9.5": "<span class='verse-line'>{}</span>", "ja427:9.6": "<span class='verse-line'>{}</span></p></blockquote>", "ja427:10.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja427:0.1": "Jātaka ", "ja427:0.2": "Navakanipāta ", "ja427:0.3": "Gijjhavagga ", "ja427:0.4": "1. Gijjhajātaka ", "ja427:1.1": "“Parisaṅkupatho nāma, ", "ja427:1.2": "gijjhapantho sanantano; ", "ja427:1.3": "Tatrāsi mātāpitaro, ", "ja427:1.4": "gijjho posesi jiṇṇake; ", "ja427:1.5": "Tesaṁ ajagaramedaṁ, ", "ja427:1.6": "accahāsi bahuttaso. ", "ja427:2.1": "Pitā ca puttaṁ avaca, ", "ja427:2.2": "Jānaṁ uccaṁ papātinaṁ; ", "ja427:2.3": "Supattaṁ thāmasampannaṁ, ", "ja427:2.4": "Tejassiṁ dūragāminaṁ. ", "ja427:3.1": "Pariplavantaṁ pathaviṁ, ", "ja427:3.2": "yadā tāta vijānahi; ", "ja427:3.3": "Sāgarena parikkhittaṁ, ", "ja427:3.4": "cakkaṁva parimaṇḍalaṁ; ", "ja427:3.5": "Tato tāta nivattassu, ", "ja427:3.6": "māssu etto paraṁ gami. ", "ja427:4.1": "Udapattosi vegena, ", "ja427:4.2": "balī pakkhī dijuttamo; ", "ja427:4.3": "Olokayanto vakkaṅgo, ", "ja427:4.4": "pabbatāni vanāni ca. ", "ja427:5.1": "Addassa pathaviṁ gijjho, ", "ja427:5.2": "yathāsāsi pitussutaṁ; ", "ja427:5.3": "Sāgarena parikkhittaṁ, ", "ja427:5.4": "cakkaṁva parimaṇḍalaṁ. ", "ja427:6.1": "Tañca so samatikkamma, ", "ja427:6.2": "paramevaccavattatha; ", "ja427:6.3": "Tañca vātasikhā tikkhā, ", "ja427:6.4": "accahāsi baliṁ dijaṁ. ", "ja427:7.1": "Nāsakkhātigato poso, ", "ja427:7.2": "punadeva nivattituṁ; ", "ja427:7.3": "Dijo byasanamāpādi, ", "ja427:7.4": "verambhānaṁ vasaṁ gato. ", "ja427:8.1": "Tassa puttā ca dārā ca, ", "ja427:8.2": "ye caññe anujīvino; ", "ja427:8.3": "Sabbe byasanamāpāduṁ, ", "ja427:8.4": "anovādakare dije. ", "ja427:9.1": "Evampi idha vuḍḍhānaṁ, ", "ja427:9.2": "yo vākyaṁ nāvabujjhati; ", "ja427:9.3": "Atisīmacaro ditto, ", "ja427:9.4": "gijjhovātītasāsano; ", "ja427:9.5": "Sa ve byasanaṁ pappoti, ", "ja427:9.6": "akatvā vuḍḍhasāsanan”ti. ", "ja427:10.1": "Gijjhajātakaṁ paṭhamaṁ. "}, "variant_text": {"ja427:0.1": "", "ja427:0.2": "", "ja427:0.3": "", "ja427:0.4": "", "ja427:1.1": "", "ja427:1.2": "", "ja427:1.3": "", "ja427:1.4": "", "ja427:1.5": "", "ja427:1.6": "bahuttaso → bahūtaso (bj, pts-vp-pli1); pahuttato (si); bahutaso (sya1ed, sya2ed); bahudhaso (mr) ", "ja427:2.1": "", "ja427:2.2": "", "ja427:2.3": "thāmasampannaṁ → pakkhasampannaṁ (bj, sya1ed, sya2ed, pts-vp-pli1) ", "ja427:2.4": "", "ja427:3.1": "", "ja427:3.2": "", "ja427:3.3": "", "ja427:3.4": "", "ja427:3.5": "", "ja427:3.6": "", "ja427:4.1": "Udapattosi → uddhaṁ pattosi (bj) ", "ja427:4.2": "", "ja427:4.3": "", "ja427:4.4": "", "ja427:5.1": "", "ja427:5.2": "yathāsāsi → yathāssāsi (sya1ed, sya2ed aṭṭhakathāyaṁ pāṭhantaraṁ); yathāsāsī (pts-vp-pli1) ", "ja427:5.3": "", "ja427:5.4": "", "ja427:6.1": "", "ja427:6.2": "paramevaccavattatha → parameva pavattatha (bj, sya1ed, sya2ed) ", "ja427:6.3": "", "ja427:6.4": "", "ja427:7.1": "", "ja427:7.2": "", "ja427:7.3": "", "ja427:7.4": "verambhānaṁ → verambānaṁ (bj, pts-vp-pli1); verabbhānaṁ (sya1ed, sya2ed) ", "ja427:8.1": "", "ja427:8.2": "", "ja427:8.3": "", "ja427:8.4": "", "ja427:9.1": "", "ja427:9.2": "", "ja427:9.3": "", "ja427:9.4": "", "ja427:9.5": "", "ja427:9.6": "", "ja427:10.1": ""}, "reference_text": {"ja427:0.1": "", "ja427:0.2": "", "ja427:0.3": "", "ja427:0.4": "", "ja427:1.1": "bj30.324, csp1ed22.187, csp2ed22.187, dr27.252, ms22J_1781, msdiv1, ndp22.179, pts-vp-pli3.484, sya27.253, vri68.153", "ja427:1.2": "", "ja427:1.3": "", "ja427:1.4": "", "ja427:1.5": "", "ja427:1.6": "", "ja427:2.1": "ms22J_1782, msdiv2", "ja427:2.2": "", "ja427:2.3": "", "ja427:2.4": "", "ja427:3.1": "ms22J_1783, msdiv3", "ja427: