{"html_text": {"ja357:0.1": "<article id='ja357'><header><ul><li class='division'>{}</li>", "ja357:0.2": "<li>{}</li>", "ja357:0.3": "<li>{}</li></ul>", "ja357:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja357:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja357:1.2": "<span class='verse-line'>{}</span>", "ja357:1.3": "<span class='verse-line'>{}</span>", "ja357:1.4": "<span class='verse-line'>{}</span></p>", "ja357:2.1": "<p><span class='verse-line'>{}</span>", "ja357:2.2": "<span class='verse-line'>{}</span>", "ja357:2.3": "<span class='verse-line'>{}</span>", "ja357:2.4": "<span class='verse-line'>{}</span></p>", "ja357:3.1": "<p><span class='verse-line'>{}</span>", "ja357:3.2": "<span class='verse-line'>{}</span>", "ja357:3.3": "<span class='verse-line'>{}</span>", "ja357:3.4": "<span class='verse-line'>{}</span></p>", "ja357:4.1": "<p><span class='verse-line'>{}</span>", "ja357:4.2": "<span class='verse-line'>{}</span>", "ja357:4.3": "<span class='verse-line'>{}</span>", "ja357:4.4": "<span class='verse-line'>{}</span></p>", "ja357:5.1": "<p><span class='verse-line'>{}</span>", "ja357:5.2": "<span class='verse-line'>{}</span>", "ja357:5.3": "<span class='verse-line'>{}</span>", "ja357:5.4": "<span class='verse-line'>{}</span>", "ja357:5.5": "<span class='verse-line'>{}</span>", "ja357:5.6": "<span class='verse-line'>{}</span></p></blockquote>", "ja357:6.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja357:0.1": "Jātaka ", "ja357:0.2": "Pañcakanipāta ", "ja357:0.3": "Maṇikuṇḍalavagga ", "ja357:0.4": "7. Laṭukikajātaka ", "ja357:1.1": "“Vandāmi taṁ kuñjara saṭṭhihāyanaṁ, ", "ja357:1.2": "Āraññakaṁ yūthapatiṁ yasassiṁ; ", "ja357:1.3": "Pakkhehi taṁ pañjalikaṁ karomi, ", "ja357:1.4": "Mā me vadhī puttake dubbalāya”. ", "ja357:2.1": "“Vandāmi taṁ kuñjara ekacāriṁ, ", "ja357:2.2": "Āraññakaṁ pabbatasānugocaraṁ; ", "ja357:2.3": "Pakkhehi taṁ pañjalikaṁ karomi, ", "ja357:2.4": "Mā me vadhī puttake dubbalāya”. ", "ja357:3.1": "“Vadhissāmi te laṭukike puttakāni, ", "ja357:3.2": "Kiṁ me tuvaṁ kāhasi dubbalāsi; ", "ja357:3.3": "Sataṁ sahassānipi tādisīnaṁ, ", "ja357:3.4": "Vāmena pādena papothayeyyaṁ”. ", "ja357:4.1": "“Na heva sabbattha balena kiccaṁ, ", "ja357:4.2": "Balañhi bālassa vadhāya hoti; ", "ja357:4.3": "Karissāmi te nāgarājā anatthaṁ, ", "ja357:4.4": "Yo me vadhī puttake dubbalāya”. ", "ja357:5.1": "“Kākañca passa laṭukikaṁ, ", "ja357:5.2": "Maṇḍūkaṁ nīlamakkhikaṁ; ", "ja357:5.3": "Ete nāgaṁ aghātesuṁ, ", "ja357:5.4": "Passa verassa verinaṁ; ", "ja357:5.5": "Tasmā hi veraṁ na kayirātha, ", "ja357:5.6": "Appiyenapi kenacī”ti. ", "ja357:6.1": "Laṭukikajātakaṁ sattamaṁ. "}, "variant_text": {"ja357:0.1": "", "ja357:0.2": "", "ja357:0.3": "", "ja357:0.4": "", "ja357:1.1": "", "ja357:1.2": "", "ja357:1.3": "", "ja357:1.4": "", "ja357:2.1": "", "ja357:2.2": "", "ja357:2.3": "", "ja357:2.4": "", "ja357:3.1": "Vadhissāmi → vamissāmi (csp1ed) ", "ja357:3.2": "", "ja357:3.3": "", "ja357:3.4": "", "ja357:4.1": "", "ja357:4.2": "", "ja357:4.3": "", "ja357:4.4": "", "ja357:5.1": "", "ja357:5.2": "", "ja357:5.3": "", "ja357:5.4": "", "ja357:5.5": "", "ja357:5.6": "", "ja357:6.1": ""}, "reference_text": {"ja357:0.1": "", "ja357:0.2": "", "ja357:0.3": "", "ja357:0.4": "", "ja357:1.1": "bj30.214, ms22J_1190, msdiv39, ndp22.116, pts-vp-pli3.174", "ja357:1.2": "", "ja357:1.3": "", "ja357:1.4": "", "ja357:2.1": "csp1ed22.125, csp2ed22.125, ms22J_1191, msdiv40, pts-vp-pli3.175, sya27.171", "ja357:2.2": "", "ja357:2.3": "", "ja357:2.4": "", "ja357:3.1": "ms22J_1192, msdiv41", "ja357:3.2": "", "ja357:3.3": "", "ja357:3.4": "", "ja357:4.1": "ms22J_1193, msdiv42, pts-vp-pli3.176", "ja357:4.2": "", "ja357:4.3": "", "ja357:4.4": "", "ja357:5.1": "dr27.171, ms22J_1194, msdiv43, pts-vp-pli3.177", "ja357:5.2": "", "ja357:5.3": "", "ja357:5.4": "", "ja357:5.5": "", "ja357:5.6": "", "ja357:6.1": "ms22J_1195"}, "keys_order": ["ja357:0.1", "ja357:0.2", "ja357:0.3", "ja357:0.4", "ja357:1.1", "ja357:1.2", "ja357