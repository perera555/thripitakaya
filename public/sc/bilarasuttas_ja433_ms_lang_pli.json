{"html_text": {"ja433:0.1": "<article id='ja433'><header><ul><li class='division'>{}</li>", "ja433:0.2": "<li>{}</li>", "ja433:0.3": "<li>{}</li></ul>", "ja433:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja433:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja433:1.2": "<span class='verse-line'>{}</span>", "ja433:1.3": "<span class='verse-line'>{}</span>", "ja433:1.4": "<span class='verse-line'>{}</span></p>", "ja433:2.1": "<p><span class='verse-line'>{}</span>", "ja433:2.2": "<span class='verse-line'>{}</span>", "ja433:2.3": "<span class='verse-line'>{}</span>", "ja433:2.4": "<span class='verse-line'>{}</span></p>", "ja433:3.1": "<p><span class='verse-line'>{}</span>", "ja433:3.2": "<span class='verse-line'>{}</span>", "ja433:3.3": "<span class='verse-line'>{}</span>", "ja433:3.4": "<span class='verse-line'>{}</span></p>", "ja433:4.1": "<p><span class='verse-line'>{}</span>", "ja433:4.2": "<span class='verse-line'>{}</span>", "ja433:4.3": "<span class='verse-line'>{}</span>", "ja433:4.4": "<span class='verse-line'>{}</span></p>", "ja433:5.1": "<p><span class='verse-line'>{}</span>", "ja433:5.2": "<span class='verse-line'>{}</span>", "ja433:5.3": "<span class='verse-line'>{}</span>", "ja433:5.4": "<span class='verse-line'>{}</span></p>", "ja433:6.1": "<p><span class='verse-line'>{}</span>", "ja433:6.2": "<span class='verse-line'>{}</span>", "ja433:6.3": "<span class='verse-line'>{}</span>", "ja433:6.4": "<span class='verse-line'>{}</span></p>", "ja433:7.1": "<p><span class='verse-line'>{}</span>", "ja433:7.2": "<span class='verse-line'>{}</span>", "ja433:7.3": "<span class='verse-line'>{}</span>", "ja433:7.4": "<span class='verse-line'>{}</span></p>", "ja433:8.1": "<p><span class='verse-line'>{}</span>", "ja433:8.2": "<span class='verse-line'>{}</span>", "ja433:8.3": "<span class='verse-line'>{}</span>", "ja433:8.4": "<span class='verse-line'>{}</span></p>", "ja433:9.1": "<p><span class='verse-line'>{}</span>", "ja433:9.2": "<span class='verse-line'>{}</span>", "ja433:9.3": "<span class='verse-line'>{}</span>", "ja433:9.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja433:10.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja433:0.1": "Jātaka ", "ja433:0.2": "Navakanipāta ", "ja433:0.3": "Gijjhavagga ", "ja433:0.4": "7. Lomasakassapajātaka ", "ja433:1.1": "“Assa indasamo rāja, ", "ja433:1.2": "accantaṁ ajarāmaro; ", "ja433:1.3": "Sace tvaṁ yaññaṁ yājeyya, ", "ja433:1.4": "isiṁ lomasakassapaṁ”. ", "ja433:2.1": "“Sasamuddapariyāyaṁ, ", "ja433:2.2": "mahiṁ sāgarakuṇḍalaṁ; ", "ja433:2.3": "Na icche saha nindāya, ", "ja433:2.4": "evaṁ seyya vijānahi. ", "ja433:3.1": "Dhiratthu taṁ yasalābhaṁ, ", "ja433:3.2": "dhanalābhañca brāhmaṇa; ", "ja433:3.3": "Yā vutti vinipātena, ", "ja433:3.4": "adhammacaraṇena vā. ", "ja433:4.1": "Api ce pattamādāya, ", "ja433:4.2": "anagāro paribbaje; ", "ja433:4.3": "Sāyeva jīvikā seyyo, ", "ja433:4.4": "yā cādhammena esanā. ", "ja433:5.1": "Api ce pattamādāya, ", "ja433:5.2": "anagāro paribbaje; ", "ja433:5.3": "Aññaṁ ahiṁsayaṁ loke, ", "ja433:5.4": "api rajjena taṁ varaṁ”. ", "ja433:6.1": "“Balaṁ cando balaṁ suriyo, ", "ja433:6.2": "balaṁ samaṇabrāhmaṇā; ", "ja433:6.3": "Balaṁ velā samuddassa, ", "ja433:6.4": "balātibalamitthiyo. ", "ja433:7.1": "Yathā uggatapaṁ santaṁ, ", "ja433:7.2": "isiṁ lomasakassapaṁ; ", "ja433:7.3": "Pitu atthā candavatī, ", "ja433:7.4": "vājapeyyaṁ ayājayi”. ", "ja433:8.1": "“Taṁ lobhapakataṁ kammaṁ, ", "ja433:8.2": "Kaṭukaṁ kāmahetukaṁ; ", "ja433:8.3": "Tassa mūlaṁ gavesissaṁ, ", "ja433:8.4": "Checchaṁ rāgaṁ sabandhanaṁ. ", "ja433:9.1": "Dhiratthu kāme subahūpi loke, ", "ja433:9.2": "Tapova seyyo kāmaguṇehi rāja; ", "ja433:9.3": "Tapo karissāmi pahāya kāme, ", "ja433:9.4": "Taveva raṭṭhaṁ candavatī ca hotū”ti. ", "ja433:10.1": "Lomasakassapajātakaṁ sattamaṁ. "}, "variant_text": {"ja433:0.1": "", "ja433:0.2": "", "ja433:0.3": "", "ja433:0.4": "", "ja433:1.1": "", "ja433:1.2": "", "ja433:1.3": "", "ja433:1.4": "", "ja433:2.1": "", "ja433:2.2": "", "ja433:2.3": "", "ja433:2.4": "seyya → sayha (bj, pts-vp-pli1); seyha (sya1ed, sya2ed mi5.5.5:1 [Buddhaaviheṭhakapañha]) ", "ja433:3.1": "", "ja433:3.2": "", "ja433:3.3": "", "ja433:3.4": "", "ja433:4.1": "", "ja433:4.2": "", "ja433:4.3": "", "ja433:4.4": "", "ja433:5.1": "", "ja433:5.2": "", "ja433:5.3": "", "ja433:5.4": "", "ja433:6.1": "", "ja433:6.2": "", "ja433:6.3": "", "ja433:6.4": "", "ja433:7.1": "", "ja433:7.2": "", "ja433:7.3": "", "ja433:7.4": "vājapeyyaṁ → vācapeyyaṁ (pts-vp-pli1, mr) ", "ja433:8.1": "", "ja433:8.2": "", "ja433:8.3": "", "ja433:8.4": "", "ja433:9.1": "", "ja433:9.2": "", "ja433:9.3": "", "ja433:9.4": "", "ja433:10.1": ""}, "reference_text": {"ja433:0.1": "", "ja433:0.2": "", "ja433:0.3": "", "ja433:0.4": "", "ja433:1.1": "bj30.336, ms22J_1846, msdiv60, pts-vp-pli3.515, vri68.158", "ja433:1.2": "", "ja433:1.3": "", "ja433:1.4": "", "ja433:2.1": "ms22J_1847, msdiv61, pts-vp-pli3.516", "ja433:2.2": "", "ja433:2.3": "", "ja433:2.4": "", "ja433:3.1": "ms22J_1848, msdiv62", "ja433:3.2": "", "ja433:3.3": "", "ja433:3.4": "", "ja433:4.1": "ms22J_1849, msdiv63", "ja433:4.2": "", "ja433:4.3": "", "ja433:4.4": "", "ja433:5.1": "ms22J_1850, msdiv64, ndp22.186", "ja433:5.2": "", "ja433:5.3": "", "ja433:5.4": "", "ja433:6.1": "ms22J_1851, msdiv65, pts-vp-pli3.518", "ja433:6.2": "", "ja433:6.3": "", "ja433:6.4": "", "ja433:7.1": "ms22J_1852, msdiv66", "ja433:7.2": "", "ja433:7.3": "", "ja433:7.4": "", "ja433:8.1": "dr27.261, ms22J_1853, msdiv67, pts-vp-pli3.519, sya27.262", "ja433:8.2": "", "ja433:8.3": "", "ja433:8.4": "", "ja433:9.1": "csp1ed22.194, csp2ed22.194, ms22J_1854, msdiv68", "ja433:9.2": "", "ja433:9.3": "", "ja433:9.4": "", "ja433:10.1": "ms22J_1855"}, "keys_order": ["ja433:0.1", "ja433:0.2", "ja433:0.3", "ja433:0.4", "ja433:1.1", "ja433:1.2", "ja433:1.3", "ja433:1.4", "ja433:2.1", "ja433:2.2", "ja433:2.3", "ja433:2.4", "ja433:3.1", "ja433:3.2", "ja433:3.3", "ja433:3.4", "ja433:4.1", "ja433:4.2", "ja433:4.3", "ja