{"html_text": {"ja341:0.1": "<article id='ja341'><header><ul><li class='division'>{}</li>", "ja341:0.2": "<li>{}</li>", "ja341:0.3": "<li>{}</li></ul>", "ja341:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja341:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja341:1.2": "<span class='verse-line'>{}</span>", "ja341:1.3": "<span class='verse-line'>{}</span>", "ja341:1.4": "<span class='verse-line'>{}</span></p>", "ja341:2.1": "<p><span class='verse-line'>{}</span>", "ja341:2.2": "<span class='verse-line'>{}</span>", "ja341:2.3": "<span class='verse-line'>{}</span>", "ja341:2.4": "<span class='verse-line'>{}</span></p>", "ja341:3.1": "<p><span class='verse-line'>{}</span>", "ja341:3.2": "<span class='verse-line'>{}</span>", "ja341:3.3": "<span class='verse-line'>{}</span>", "ja341:3.4": "<span class='verse-line'>{}</span></p>", "ja341:4.1": "<p><span class='verse-line'>{}</span>", "ja341:4.2": "<span class='verse-line'>{}</span>", "ja341:4.3": "<span class='verse-line'>{}</span>", "ja341:4.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja341:5.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja341:0.1": "Jātaka ", "ja341:0.2": "Catukkanipāta ", "ja341:0.3": "Cūḷakuṇālavagga ", "ja341:0.4": "1. Kaṇḍarījātaka ", "ja341:1.1": "Narānamārāmakarāsu nārisu, ", "ja341:1.2": "Anekacittāsu aniggahāsu ca; ", "ja341:1.3": "Sabbattha nāpītikarāpi ce siyā, ", "ja341:1.4": "Na vissase titthasamā hi nāriyo. ", "ja341:2.1": "“Yaṁ ve disvā kaṇḍarīkinnarānaṁ, ", "ja341:2.2": "Sabbitthiyo na ramanti agāre; ", "ja341:2.3": "Taṁ tādisaṁ maccaṁ cajitvā bhariyā, ", "ja341:2.4": "Aññaṁ disvā purisaṁ pīṭhasappiṁ”. ", "ja341:3.1": "“Bakassa ca bāvarikassa rañño, ", "ja341:3.2": "Accantakāmānugatassa bhariyā; ", "ja341:3.3": "Avācarī paṭṭhavasānugassa, ", "ja341:3.4": "Kaṁ vāpi itthī nāticare tadaññaṁ”. ", "ja341:4.1": "“Piṅgiyānī sabbalokissarassa, ", "ja341:4.2": "Rañño piyā brahmadattassa bhariyā; ", "ja341:4.3": "Avācarī paṭṭhavasānugassa, ", "ja341:4.4": "Taṁ vāpi sā nājjhagā kāmakāminī”ti. ", "ja341:5.1": "Kaṇḍarījātakaṁ paṭhamaṁ. "}, "variant_text": {"ja341:0.1": "", "ja341:0.2": "", "ja341:0.3": "", "ja341:0.4": "", "ja341:1.1": "", "ja341:1.2": "", "ja341:1.3": "Sabbattha nāpītikarāpi → sabba'ttanāpītikarāpi (bj, sya1ed, sya2ed) | siyā → siyuṁ (sya1ed, sya2ed) ", "ja341:1.4": "", "ja341:2.1": "Yaṁ ve → yañca (sya1ed, sya2ed, mr) | kaṇḍarīkinnarānaṁ → kaṇḍari kinnarānaṁ (bj); kinnarakinnarīnaṁ (sya1ed, sya2ed); kinnarīkinnarānaṁ (mr) ", "ja341:2.2": "", "ja341:2.3": "", "ja341:2.4": "", "ja341:3.1": "bāvarikassa → pāvārikassa (bj) ", "ja341:3.2": "", "ja341:3.3": "Avācarī → accācarī (sya1ed, sya2ed); anācari (mr) | paṭṭhavasānugassa → baddhavasānugassa (bj, sya1ed, sya2ed); pattavasānugatassa (mr) ", "ja341:3.4": "", "ja341:4.1": "", "ja341:4.2": "", "ja341:4.3": "", "ja341:4.4": "", "ja341:5.1": "Kaṇḍarījātakaṁ → kinnarījātakaṁ (bj, mr); kuṇḍalikajātakaṁ (sya1ed, sya2ed); kaṇḍarijātakaṁ (pts-vp-pli1) "}, "reference_text": {"ja341:0.1": "", "ja341:0.2": "", "ja341:0.3": "", "ja341:0.4": "", "ja341:1.1": "bj30.196, dr27.157, ms22J_1091, msdiv161, pts-vp-pli3.132", "ja341:1.2": "", "ja341:1.3": "", "ja341:1.4": "", "ja341:2.1": "ms22J_1092, msdiv162, sya27.157, vri68.98", "ja341:2.2": "", "ja341:2.3": "", "ja341:2.4": "", "ja341:3.1": "ms22J_1093, msdiv163, ndp22.106", "ja341:3.2": "", "ja341:3.3": "", "ja341:3.4": "", "ja341:4.1": "ms22J_1094, msdiv164", "ja341:4.2": "", "ja341:4.3": "", "ja341:4.4": "", "ja341:5.1": "ms22J_1095"}, "keys_order": ["ja341:0.1", "ja341:0.2", "ja341:0.3", "ja341:0.4", "ja341:1.1", "ja341:1.2", "ja341:1.3", "ja341:1.4", "ja341:2.1", "ja341:2.2", "ja341:2.3", "ja341:2.4", "ja341:3.1", "ja341:3.2", "ja341:3.3", "ja341:3.4", "ja341:4.1", "ja341:4.2", "ja341:4.3", "ja341:4.4", "ja341:5.1"]}