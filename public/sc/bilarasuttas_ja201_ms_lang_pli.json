{"html_text": {"ja201:0.1": "<article id='ja201'><header><ul><li class='division'>{}</li>", "ja201:0.2": "<li>{}</li>", "ja201:0.3": "<li>{}</li></ul>", "ja201:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja201:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja201:1.2": "<span class='verse-line'>{}</span>", "ja201:1.3": "<span class='verse-line'>{}</span>", "ja201:1.4": "<span class='verse-line'>{}</span></p>", "ja201:2.1": "<p><span class='verse-line'>{}</span>", "ja201:2.2": "<span class='verse-line'>{}</span>", "ja201:2.3": "<span class='verse-line'>{}</span>", "ja201:2.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja201:3.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja201:0.1": "Jātaka ", "ja201:0.2": "Dukanipāta ", "ja201:0.3": "Nataṁdaḷhavagga ", "ja201:0.4": "1. Bandhanāgārajātaka ", "ja201:1.1": "“Na taṁ daḷhaṁ bandhanamāhu dhīrā, ", "ja201:1.2": "Yadāyasaṁ dārujapabbajañca; ", "ja201:1.3": "Sārattarattā maṇikuṇḍalesu, ", "ja201:1.4": "Puttesu dāresu ca yā apekkhā. ", "ja201:2.1": "Etaṁ daḷhaṁ bandhanamāhu dhīrā, ", "ja201:2.2": "Ohārinaṁ sīthilaṁ duppamuñcaṁ; ", "ja201:2.3": "Etampi chetvāna vajanti dhīrā, ", "ja201:2.4": "Anapekkhino kāmasukhaṁ pahāyā”ti. ", "ja201:3.1": "Bandhanāgārajātakaṁ paṭhamaṁ. "}, "variant_text": {"ja201:0.1": "", "ja201:0.2": "", "ja201:0.3": "", "ja201:0.4": "", "ja201:1.1": "", "ja201:1.2": "dārujapabbajañca → dārujaṁ babbajañca (bj); dārujaṁ pabbajañca (pts-vp-pli1) ", "ja201:1.3": "", "ja201:1.4": "", "ja201:2.1": "", "ja201:2.2": "", "ja201:2.3": "", "ja201:2.4": "", "ja201:3.1": ""}, "reference_text": {"ja201:0.1": "", "ja201:0.2": "", "ja201:0.3": "", "ja201:0.4": "", "ja201:1.1": "bj30.94, dr27.73, ms22J_502, msdiv101, pts-vp-pli2.140, sya27.74", "ja201:1.2": "", "ja201:1.3": "", "ja201:1.4": "", "ja201:2.1": "ms22J_503, msdiv102", "ja201:2.2": "", "ja201:2.3": "", "ja201:2.4": "", "ja201:3.1": "ms22J_504"}, "keys_order": ["ja201:0.1", "ja201:0.2", "ja201:0.3", "