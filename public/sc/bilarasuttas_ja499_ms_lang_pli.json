pan></p>", "ja499:18.1": "<p><span class='verse-line'>{}</span>", "ja499:18.2": "<span class='verse-line'>{}</span>", "ja499:18.3": "<span class='verse-line'>{}</span>", "ja499:18.4": "<span class='verse-line'>{}</span></p>", "ja499:19.1": "<p><span class='verse-line'>{}</span>", "ja499:19.2": "<span class='verse-line'>{}</span>", "ja499:19.3": "<span class='verse-line'>{}</span>", "ja499:19.4": "<span class='verse-line'>{}</span></p>", "ja499:20.1": "<p><span class='verse-line'>{}</span>", "ja499:20.2": "<span class='verse-line'>{}</span>", "ja499:20.3": "<span class='verse-line'>{}</span>", "ja499:20.4": "<span class='verse-line'>{}</span></p>", "ja499:21.1": "<p><span class='verse-line'>{}</span>", "ja499:21.2": "<span class='verse-line'>{}</span>", "ja499:21.3": "<span class='verse-line'>{}</span>", "ja499:21.4": "<span class='verse-line'>{}</span></p>", "ja499:22.1": "<p><span class='verse-line'>{}</span>", "ja499:22.2": "<span class='verse-line'>{}</span>", "ja499:22.3": "<span class='verse-line'>{}</span>", "ja499:22.4": "<span class='verse-line'>{}</span></p>", "ja499:23.1": "<p><span class='verse-line'>{}</span>", "ja499:23.2": "<span class='verse-line'>{}</span>", "ja499:23.3": "<span class='verse-line'>{}</span>", "ja499:23.4": "<span class='verse-line'>{}</span>", "ja499:23.5": "<span class='verse-line'>{}</span>", "ja499:23.6": "<span class='verse-line'>{}</span></p>", "ja499:24.1": "<p><span class='verse-line'>{}</span>", "ja499:24.2": "<span class='verse-line'>{}</span>", "ja499:24.3": "<span class='verse-line'>{}</span>", "ja499:24.4": "<span class='verse-line'>{}</span></p>", "ja499:25.1": "<p><span class='verse-line'>{}</span>", "ja499:25.2": "<span class='verse-line'>{}</span>", "ja499:25.3": "<span class='verse-line'>{}</span>", "ja499:25.4": "<span class='verse-line'>{}</span></p>", "ja499:26.1": "<p><span class='verse-line'>{}</span>", "ja499:26.2": "<span class='verse-line'>{}</span>", "ja499:26.3": "<span class='verse-line'>{}</span>", "ja499:26.4": "<span class='verse-line'>{}</span></p>", "ja499:27.1": "<p><span class='verse-line'>{}</span>", "ja499:27.2": "<span class='verse-line'>{}</span>", "ja499:27.3": "<span class='verse-line'>{}</span>", "ja499:27.4": "<span class='verse-line'>{}</span></p>", "ja499:28.1": "<p><span class='verse-line'>{}</span>", "ja499:28.2": "<span class='verse-line'>{}</span>", "ja499:28.3": "<span class='verse-line'>{}</span>", "ja499:28.4": "<span class='verse-line'>{}</span></p>", "ja499:29.1": "<p><span class='verse-line'>{}</span>", "ja499:29.2": "<span class='verse-line'>{}</span>", "ja499:29.3": "<span class='verse-line'>{}</span>", "ja499:29.4": "<span class='verse-line'>{}</span></p>", "ja499:30.1": "<p><span class='verse-line'>{}</span>", "ja499:30.2": "<span class='verse-line'>{}</span>", "ja499:30.3": "<span class='verse-line'>{}</span>", "ja499:30.4": "<span class='verse-line'>{}</span></p>", "ja499:31.1": "<p><span class='verse-line'>{}</span>", "ja499:31.2": "<span class='verse-line'>{}</span>", "ja499:31.3": "<span class='verse-line'>{}</span>", "ja499:31.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja499:32.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja499:0.1": "Jātaka ", "ja499:0.2": "Vīsatinipāta ", "ja499:0.3": "Mātaṅgavagga ", "ja499:0.4": "3. Sivijātaka ", "ja499:1.1": "“Dūre apassaṁ therova, ", "ja499:1.2": "cakkhuṁ yācitumāgato; ", "ja499:1.3": "Ekanettā bhavissāma, ", "ja499:1.4": "cakkhuṁ me dehi yācito”. ", "ja499:2.1": "“Kenānusiṭṭho idha māgatosi, ", "ja499:2.2": "Vanibbaka cakkhupathāni yācituṁ; ", "ja499:2.3": "Suduccajaṁ yācasi uttamaṅgaṁ, ", "ja499:2.4": "Yamāhu nettaṁ purisena duccajaṁ”. ", "ja499:3.1": "“Yamāhu devesu sujampatīti, ", "ja499:3.2": "Maghavāti naṁ āhu manussaloke; ", "ja499:3.3": "Tenānusiṭṭho idha māgatosmi, ", "ja499:3.4": "Vanibbako cakkhupathāni yācituṁ. ", "ja499:4.1": "Vanibbato mayha vaniṁ anuttaraṁ, ", "ja499:4.2": "Dadāhi te cakkhupathāni yācito; ", "ja499:4.3": "Dadāhi me cakkhupathaṁ anuttaraṁ, ", "ja499:4.4": "Yamāhu nettaṁ purisena duccajaṁ”. ", "ja499:5.1": "“Yena atthena āgacchi, ", "ja499:5.2": "yamatthamabhipatthayaṁ; ", "ja499:5.3": "Te te ijjhantu saṅkappā, ", "ja499:5.4": "labha cakkhūni brāhmaṇa. ", "ja499:6.1": "Ekaṁ te yācamānassa, ", "ja499:6.2": "Ubhayāni dadāmahaṁ; ", "ja499:6.3": "Sa cakkhumā gaccha janassa pekkhato, ", "ja499:6.4": "Yadicchase tvaṁ tadate samijjhatu”. ", "ja499:7.1": "“Mā no deva adā cakkhuṁ, ", "ja499:7.2": "mā no sabbe parākari; ", "ja499:7.3": "Dhanaṁ dehi mahārāja, ", "ja499:7.4": "muttā veḷuriyā bahū. ", "ja499:8.1": "Yutte deva rathe dehi, ", "ja499:8.2": "ājānīye calaṅkate; ", "ja499:8.3": "Nāge dehi mahārāja, ", "ja499:8.4": "hemakappanavāsase. ", "ja499:9.1": "Yathā taṁ sivayo sabbe, ", "ja499:9.2": "sayoggā sarathā sadā; ", "ja499:9.3": "Samantā parikireyyuṁ, ", "ja499:9.4": "evaṁ dehi rathesabha”. ", "ja499:10.1": "“Yo ve dassanti vatvāna, ", "ja499:10.2": "adāne kurute mano; ", "ja499:10.3": "Bhūmyaṁ so patitaṁ pāsaṁ, ", "ja499:10.4": "gīvāyaṁ paṭimuñcati. ", "ja499:11.1": "Yo ve dassanti vatvāna, ", "ja499:11.2": "adāne kurute mano; ", "ja499:11.3": "Pāpā pāpataro hoti, ", "ja499:11.4": "sampatto yamasādhanaṁ. ", "ja499:12.1": "Yañhi yāce tañhi dade, ", "ja499:12.2": "yaṁ na yāce na taṁ dade; ", "ja499:12.3": "Svāhaṁ tameva dassāmi, ", "ja499:12.4": "yaṁ maṁ yācati brāhmaṇo”. ", "ja499:13.1": "“Āyuṁ nu vaṇṇaṁ nu sukhaṁ balaṁ nu, ", "ja499:13.2": "Kiṁ patthayāno nu janinda desi; ", "ja499:13.3": "Kathañhi rājā sivinaṁ anuttaro, ", "ja499:13.4": "Cakkhūni dajjā paralokahetu”. ", "ja499:14.1": "“Na vāhametaṁ yasasā dadāmi, ", "ja499:14.2": "Na puttamicche na dhanaṁ na raṭṭhaṁ; ", "ja499:14.3": "Satañca dhammo carito purāṇo, ", "ja499:14.4": "Icceva dāne ramate mano mama”. ", "ja499:14.5": "(…) ", "ja499:15.1": "“Sakhā ca mitto ca mamāsi sīvika, ", "ja499:15.2": "Susikkhito sādhu karohi me vaco; ", "ja499:15.3": "Uddharitvā cakkhūni mamaṁ jigīsato, ", "ja499:15.4": "Hatthesu ṭhapehi vanibbakassa”. ", "ja499:16.1": "Codito sivirājena, ", "ja499:16.2": "sīviko vacanaṅkaro; ", "ja499:16.3": "Rañño cakkhūnuddharitvā, ", "ja499:16.4": "brāhmaṇassūpanāmayi; ", "ja499:16.5": "Sacakkhu brāhmaṇo āsi, ", "ja499:16.6": "andho rājā upāvisi. ", "ja499:17.1": "Tato so katipāhassa, ", "ja499:17.2": "uparūḷhesu cakkhusu; ", "ja499:17.3": "Sūtaṁ āmantayī rājā, ", "ja499:17.4": "sivīnaṁ raṭṭhavaḍḍhano. ", "ja499:18.1": "“Yojehi sārathi yānaṁ, ", "ja499:18.2": "yuttañca paṭivedaya; ", "ja499:18.3": "Uyyānabhūmiṁ gacchāma, ", "ja499:18.4": "pokkharañño vanāni ca”. ", "ja499:19.1": "So ca pokkharaṇītīre, ", "ja499:19.2": "pallaṅkena upāvisi; ", "ja499:19.3": "Tassa sakko pāturahu, ", "ja499:19.4": "devarājā sujampati. ", "ja499:20.1": "“Sakkohamasmi devindo, ", "ja499:20.2": "āgatosmi tavantike; ", "ja499:20.3": "Varaṁ varassu rājīsi, ", "ja499:20.4": "yaṁ kiñci manasicchasi”. ", "ja499:21.1": "“Pahūtaṁ me dhanaṁ sakka, ", "ja499:21.2": "balaṁ koso canappako; ", "ja499:21.3": "Andhassa me sato dāni, ", "ja499:21.4": "maraṇaññeva ruccati”. ", "ja499:22.1": "“Yāni saccāni dvipadinda, ", "ja499:22.2": "tāni bhāsassu khattiya; ", "ja499:22.3": "Saccaṁ te bhaṇamānassa, ", "ja499:22.4": "puna cakkhu bhavissati”. ", "ja499:23.1": "“Ye maṁ yācitumāyanti, ", "ja499:23.2": "nānāgottā vanibbakā; ", "ja499:23.3": "Yopi maṁ yācate tattha, ", "ja499:23.4": "sopi me manaso piyo; ", "ja499:23.5": "Etena saccavajjena, ", "ja499:23.6": "cakkhu me upapajjatha. ", "ja499:24.1": "Yaṁ maṁ so yācituṁ āgā, ", "ja499:24.2": "dehi cakkhunti brāhmaṇo; ", "ja499:24.3": "Tassa cakkhūni pādāsiṁ, ", "ja499:24.4": "brāhmaṇassa vanibbato. ", "ja499:25.1": "Bhiyyo maṁ āvisī pīti, ", "ja499:25.2": "somanassañcanappakaṁ; ", "ja499:25.3": "Etena saccavajjena, ", "ja499:25.4": "dutiyaṁ me upapajjatha”. ", "ja499:26.1": "“Dhammena bhāsitā gāthā, ", "ja499:26.2": "sivīnaṁ raṭṭhavaḍḍhana; ", "ja499:26.3": "Etāni tava nettāni, ", "ja499:26.4": "dibbāni paṭidissare. ", "ja499:27.1": "Tirokuṭṭaṁ tiroselaṁ, ", "ja499:27.2": "samatiggayha pabbataṁ; ", "ja499:27.3": "Samantā yojanasataṁ, ", "ja499:27.4": "dassanaṁ anubhontu te”. ", "ja499:28.1": "“Ko nīdha vittaṁ na dadeyya yācito, ", "ja499:28.2": "Api visiṭṭhaṁ supiyampi attano; ", "ja499:28.3": "Tadiṅgha sabbe sivayo samāgatā, ", "ja499:28.4": "Dibbāni nettāni mamajja passatha. ", "ja499:29.1": "Tirokuṭṭaṁ tiroselaṁ, ", "ja499:29.2": "samatiggayha pabbataṁ; ", "ja499:29.3": "Samantā yojanasataṁ, ", "ja499:29.4": "dassanaṁ anubhonti me. ", "ja499:30.1": "Na cāgamattā paramatthi kiñci, ", "ja499:30.2": "Maccānaṁ idha jīvite; ", "ja499:30.3": "Datvāna mānusaṁ cakkhuṁ, ", "ja499:30.4": "Laddhaṁ me cakkhuṁ amānusaṁ. ", "ja499:31.1": "Etampi disvā sivayo, ", "ja499:31.2": "Detha dānāni bhuñjatha; ", "ja499:31.3": "Datvā ca bhutvā ca yathānubhāvaṁ, ", "ja499:31.4": "Aninditā saggamupetha ṭhānan”ti. ", "ja499:32.1": "Sivijātakaṁ tatiyaṁ. "}, "variant_text": {"ja499:0.1": "", "ja499:0.2": "", "ja499:0.3": "", "ja499:0.4": "", "ja499:1.1": "", "ja499:1.2": "", "ja499:1.3": "", "ja499:1.4": "", "ja499:2.1": "", "ja499:2.2": "Vanibbaka → vaṇibbaka (bj) ", "ja499:2.3": "", "ja499:2.4": "", "ja499:3.1": "", "ja499:3.2": "", "ja499:3.3": "", "ja499:3.4": "", "ja499:4.1": "Vanibbato → vaṇibbato (bj); vanibbako (sya1ed, sya2ed, pts-vp-pli1) | vaniṁ → vaṇiṁ (bj, sya1ed, sya2ed, pts-vp-pli1); vanaṁ (mr) ", "ja499:4.2": "", "ja499:4.3": "", "ja499:4.4": "", "ja499:5.1": "āgacchi → āgañchi (bj, sya1ed, sya2ed, pts-vp-pli1) ", "ja499:5.2": "", "ja499:5.3": "", "ja499:5.4": "", "ja499:6.1": "", "ja499:6.2": "", "ja499:6.3": "", "ja499:6.4": "", "ja499:7.1": "", "ja499:7.2": "parākari → parakkari (sya1ed, sya2ed, Ma-aka); parikkari (mr) ", "ja499:7.3": "", "ja499:7.4": "", "ja499:8.1": "", "ja499:8.2": "", "ja499:8.3": "", "ja499:8.4": "", "ja499:9.1": "sivayo → sīviyo (sya1ed, sya2ed) ", "ja499:9.2": "", "ja499:9.3": "parikireyyuṁ → parikareyyuṁ (sya1ed, sya2ed, pts-vp-pli1) ", "ja499:9.4": "", "ja499:10.1": "", "ja499:10.2": "", "ja499:10.3": "Bhūmyaṁ → bhūmyā (bj, pts-vp-pli1) ", "ja499:10.4": "", "ja499:11.1": "", "ja499:11.2": "", "ja499:11.3": "", "ja499:11.4": "", "ja499:12.1": "", "ja499:12.2": "", "ja499:12.3": "", "ja499:12.4": "", "ja499:13.1": "", "ja499:13.2": "", "ja499:13.3": "", "ja499:13.4": "", "ja499:14.1": "", "ja499:14.2": "", "ja499:14.3": "", "ja499:14.4": "mama → mamaṁ (bj, pts-vp-pli1) ", "ja499:14.5": "(…) → (na me dessā ubho cakkhū, ", "ja499:15.1": "sīvika → sīvaka (bj, pts-vp-pli1) ", "ja499:15.2": "", "ja499:15.3": "Uddharitvā → uddhatva (bj); laddha tvaṁ (pts-vp-pli1) ", "ja499:15.4": "ṭhapehi → āvesi (bj) ", "ja499:16.1": "", "ja499:16.2": "", "ja499:16.3": "cakkhūnuddharitvā → cakkhūni uddhatvā (bj, pts-vp-pli1); cakkhūni uddharitvā (sya1ed, sya2ed) ", "ja499:16.4": "", "ja499:16.5": "", "ja499:16.6": "", "ja499:17.1": "", "ja499:17.2": "", "ja499:17.3": "", "ja499:17.4": "", "ja499:18.1": "", "ja499:18.2": "", "ja499:18.3": "", "ja499:18.4": "", "ja499:19.1": "pokkharaṇītīre → pokkharaṇiyā tīre (bj, pts-vp-pli1) ", "ja499:19.2": "", "ja499:19.3": "", "ja499:19.4": "", "ja499:20.1": "", "ja499:20.2": "", "ja499:20.3": "", "ja499:20.4": "", "ja499:21.1": "", "ja499:21.2": "", "ja499:21.3": "", "ja499:21.4": "", "ja499:22.1": "", "ja499:22.2": "", "ja499:22.3": "", "ja499:22.4": "", "ja499:23.1": "", "ja499:23.2": "", "ja499:23.3": "", "ja499:23.4": "", "ja499:23.5": "", "ja499:23.6": "", "ja499:24.1": "", "ja499:24.2": "", "ja499:24.3": "", "ja499:24.4": "vanibbato → vaṇibbino (bj); vanibbino (pts-vp-pli1) ", "ja499:25.1": "", "ja499:25.2": "", "ja499:25.3": "", "ja499:25.4": "", "ja499:26.1": "", "ja499:26.2": "", "ja499:26.3": "", "ja499:26.4": "", "ja499:27.1": "", "ja499:27.2": "", "ja499:27.3": "", "ja499:27.4": "", "ja499:28.1": "", "ja499:28.2": "", "ja499:28.3": "", "ja499:28.4": "", "ja499:29.1": "", "ja499:29.2": "", "ja499:29.3": "", "ja499:29.4": "", "ja499:30.1": "", "ja499:30.2": "", "ja499:30.3": "Datvāna mānusaṁ → datvā mānusakaṁ (bj) ", "ja499:30.4": "", "ja499:31.1": "", "j