{"html_text": {"ja169:0.1": "<article id='ja169'><header><ul><li class='division'>{}</li>", "ja169:0.2": "<li>{}</li>", "ja169:0.3": "<li>{}</li></ul>", "ja169:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja169:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja169:1.2": "<span class='verse-line'>{}</span>", "ja169:1.3": "<span class='verse-line'>{}</span>", "ja169:1.4": "<span class='verse-line'>{}</span></p>", "ja169:2.1": "<p><span class='verse-line'>{}</span>", "ja169:2.2": "<span class='verse-line'>{}</span>", "ja169:2.3": "<span class='verse-line'>{}</span>", "ja169:2.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja169:3.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja169:0.1": "Jātaka ", "ja169:0.2": "Dukanipāta ", "ja169:0.3": "Santhavavagga ", "ja169:0.4": "9. Arakajātaka ", "ja169:1.1": "“Yo ve mettena cittena, ", "ja169:1.2": "sabbalokānukampati; ", "ja169:1.3": "Uddhaṁ adho ca tiriyaṁ, ", "ja169:1.4": "appamāṇena sabbaso. ", "ja169:2.1": "Appamāṇaṁ hitaṁ cittaṁ, ", "ja169:2.2": "paripuṇṇaṁ subhāvitaṁ; ", "ja169:2.3": "Yaṁ pamāṇakataṁ kammaṁ, ", "ja169:2.4": "na taṁ tatrāvasissatī”ti. ", "ja169:3.1": "Arakajātakaṁ navamaṁ. "}, "variant_text": {"ja169:0.1": "", "ja169:0.2": "", "ja169:0.3": "", "ja169:0.4": "", "ja169:1.1": "", "ja169:1.2": "", "ja169:1.3": "tiriyaṁ → tiriyañca (bj, sya1ed, sya2ed, pts-vp-pli1) ", "ja169:1.4": "", "ja169:2.1": "", "ja169:2.2": "", "ja169:2.3": "", "ja169:2.4": "", "ja169:3.1": ""}, "reference_text": {"ja169:0.1": "", "ja169:0.2": "", "ja169:0.3": "", "ja169:0.4": "", "ja169:1.1": "ms22J_398, msdiv37, pts-vp-pli2.61, sya27.59", "ja169:1.2": "", "ja169:1.3": "", "ja169:1.4": "", "ja169:2.1": "ms22J_399, msdiv38", "ja169:2.2": "", "ja169:2.3": "", "ja169:2.4": "", "ja169:3.1": "ms22J_400"}, "keys_order": ["ja169:0.1", "ja169:0.2", "ja169:0.3", "ja169:0.4", "ja169:1.1", "ja169:1.2", "ja169:1.3", "ja169:1.4", "ja169:2.1", "ja169:2.2", "ja169:2.3", "ja169:2.4", "ja169:3.