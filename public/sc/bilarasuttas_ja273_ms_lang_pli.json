{"html_text": {"ja273:0.1": "<article id='ja273'><header><ul><li class='division'>{}</li>", "ja273:0.2": "<li>{}</li>", "ja273:0.3": "<li>{}</li></ul>", "ja273:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja273:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja273:1.2": "<span class='verse-line'>{}</span>", "ja273:1.3": "<span class='verse-line'>{}</span>", "ja273:1.4": "<span class='verse-line'>{}</span></p>", "ja273:2.1": "<p><span class='verse-line'>{}</span>", "ja273:2.2": "<span class='verse-line'>{}</span>", "ja273:2.3": "<span class='verse-line'>{}</span>", "ja273:2.4": "<span class='verse-line'>{}</span></p>", "ja273:3.1": "<p><span class='verse-line'>{}</span>", "ja273:3.2": "<span class='verse-line'>{}</span>", "ja273:3.3": "<span class='verse-line'>{}</span>", "ja273:3.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja273:4.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja273:0.1": "Jātaka ", "ja273:0.2": "Tikanipāta ", "ja273:0.3": "Udapānavagga ", "ja273:0.4": "3. Kacchapajātaka ", "ja273:1.1": "“Ko nu uddhitabhattova, ", "ja273:1.2": "pūrahatthova brāhmaṇo; ", "ja273:1.3": "Kahaṁ nu bhikkhaṁ acari, ", "ja273:1.4": "kaṁ saddhaṁ upasaṅkami”. ", "ja273:2.1": "“Ahaṁ kapismi dummedho, ", "ja273:2.2": "anāmāsāni āmasiṁ; ", "ja273:2.3": "Tvaṁ maṁ mocaya bhaddaṁ te, ", "ja273:2.4": "mutto gaccheyya pabbataṁ”. ", "ja273:3.1": "“Kacchapā kassapā honti, ", "ja273:3.2": "Koṇḍaññā honti makkaṭā; ", "ja273:3.3": "Muñca kassapa koṇḍaññaṁ, ", "ja273:3.4": "Kataṁ methunakaṁ tayā”ti. ", "ja273:4.1": "Kacchapajātakaṁ tatiyaṁ. "}, "variant_text": {"ja273:0.1": "", "ja273:0.2": "", "ja273:0.3": "", "ja273:0.4": "", "ja273:1.1": "uddhitabhattova → udditabhattova (bj); vaḍḍhitabhattova (sya1ed, sya2ed) ", "ja273:1.2": "", "ja273:1.3": "", "ja273:1.4": "", "ja273:2.1": "", "ja273:2.2": "", "ja273:2.3": "", "ja273:2.4": "", "ja273:3.1": "", "ja273:3.2": "", "ja273:3.3": "", "ja273:3.4": "Kataṁ → kathaṁ (mr) ", "ja273:4.1