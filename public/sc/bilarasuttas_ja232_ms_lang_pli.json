{"html_text": {"ja232:0.1": "<article id='ja232'><header><ul><li class='division'>{}</li>", "ja232:0.2": "<li>{}</li>", "ja232:0.3": "<li>{}</li></ul>", "ja232:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja232:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja232:1.2": "<span class='verse-line'>{}</span>", "ja232:1.3": "<span class='verse-line'>{}</span>", "ja232:1.4": "<span class='verse-line'>{}</span></p>", "ja232:2.1": "<p><span class='verse-line'>{}</span>", "ja232:2.2": "<span class='verse-line'>{}</span>", "ja232:2.3": "<span class='verse-line'>{}</span>", "ja232:2.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja232:3.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja232:0.1": "Jātaka ", "ja232:0.2": "Dukanipāta ", "ja232:0.3": "Upāhanavagga ", "ja232:0.4": "2. Vīṇāguṇajātaka ", "ja232:1.1": "“Ekacintito yamattho, ", "ja232:1.2": "bālo apariṇāyako; ", "ja232:1.3": "Na hi khujjena vāmena, ", "ja232:1.4": "bhoti saṅgantumarahasi”. ", "ja232:2.1": "“Purisūsabhaṁ maññamānā, ", "ja232:2.2": "ahaṁ khujjamakāmayiṁ; ", "ja232:2.3": "Soyaṁ saṅkuṭito seti, ", "ja232:2.4": "chinnatanti yathā viṇā”ti. ", "ja232:3.1": "Vīṇāguṇajātakaṁ dutiyaṁ. "}, "variant_text": {"ja232:0.1": "", "ja232:0.2": "", "ja232:0.3": "", "ja232:0.4": "", "ja232:1.1": "", "ja232:1.2": "", "ja232:1.3": "", "ja232:1.4": "", "ja232:2.1": "", "ja232:2.2": "", "ja232:2.3": "", "ja232:2.4": "yathā viṇā”ti → thuṇāti (bj) ", "ja232:3.1": "Vīṇāguṇajātakaṁ → vīṇāthūṇajātakaṁ (sya1ed, sya2ed, pts-vp-pli1) "}, "reference_text": {"ja232:0.1": "", "ja232:0.2": "", "ja232:0.3": "", "ja232:0.4": "", "ja232:1.1": "ms22J_605, msdiv163, pts-vp-pli2.226", "ja232:1.2": "", "ja232:1.3": "", "ja232:1.4": "", "ja232:2.1": "ms22J_606, msdiv164, ndp22.60", "ja232:2.2": "", "ja232:2.3": "", "ja232:2.4": "", "ja232:3.1": "ms22J_607"}, "keys_order": ["ja232:0.1", "ja232:0.2", "ja232:0.3", "ja232:0.4", "ja232:1.1", "ja232:1.2", "ja232:1.3", "ja232:1.4", "ja232:2.1", "