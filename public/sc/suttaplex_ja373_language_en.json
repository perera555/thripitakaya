[{"acronym": "Ja 373", "alt_acronym": null, "volpages": "PTS 3.217, PTS 3.218", "alt_volpages": null, "uid": "ja373", "blurb": "“People cry “Where is she gone”—This story the Master, whilst residing in the Bamboo Grove, told about Ajatasattu. The incident that led to the story has been already fully told in the Thusa Birth. Here too the Master observed the king at the same moment playing with his boy and also listening to the Law. And knowing as he did that danger to the king will arise through his son, he said, “Sire, kings of old suspected what was open to suspicion, and kept their heirs in confinement, saying, “Let them bear rule, after our bodies have been burned on the funeral pyre.” And with this he told a story of the past.", "difficulty": null, "original_title": "Mūsikajātaka", "root_lang": "pli", "root_lang_name": "Pāli", "type": "leaf", "translated_title": "Musika Jātaka", "translations": [{"lang": "pli", "lang_name": "Pāli", "is_root": true, "author": "Mahāsaṅgīti Tipiṭaka Buddhavasse 2500", "author_short": "ms", "author_uid": "ms", "publication_date": null, "id": "ja373_root-pli-ms", "segmented": true, "title": null, "volpage": null, "has_comment": false}, {"lang": "de", "lang_name": "Deutsch", "is_root": false, "author": "Dr. Julius Dutoit", "author_short": "Dutoit", "author_uid": "dutoit", "publication_date": "2007", "id": "de_ja373_dutoit", "segmented": false, "volpage": null, "has_comment": false}, {"author": "H.T. Francis, R.A. Neil", "author_short": "Francis …", "author_uid": "francis-neil", "has_comment": false, "id": "en_ja373_francis-neil", "is_root": false, "lang": "en", "lang_name": "English", "publication_date": "1897", "segmented": false, "volpage": null, "title": "Musika Jātaka"}, {"lang": "jpn", "lang_name": "日本語", "is_root": false, "author": "関西パーリ語実習会", "author_short": "関西パーリ語実習会", "author_uid": "kansai", "publication_date": "2023", "id": "jpn_ja373_kansai", "segmented": false, "volpage": null, "has_comment": false}, {"lang": "si", "lang