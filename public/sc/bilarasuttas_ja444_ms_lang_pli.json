span>", "ja444:6.5": "<span class='verse-line'>{}</span>", "ja444:6.6": "<span class='verse-line'>{}</span></p>", "ja444:7.1": "<p><span class='verse-line'>{}</span>", "ja444:7.2": "<span class='verse-line'>{}</span>", "ja444:7.3": "<span class='verse-line'>{}</span>", "ja444:7.4": "<span class='verse-line'>{}</span>", "ja444:7.5": "<span class='verse-line'>{}</span>", "ja444:7.6": "<span class='verse-line'>{}</span></p>", "ja444:8.1": "<p><span class='verse-line'>{}</span>", "ja444:8.2": "<span class='verse-line'>{}</span>", "ja444:8.3": "<span class='verse-line'>{}</span>", "ja444:8.4": "<span class='verse-line'>{}</span>", "ja444:8.5": "<span class='verse-line'>{}</span>", "ja444:8.6": "<span class='verse-line'>{}</span></p>", "ja444:9.1": "<p><span class='verse-line'>{}</span>", "ja444:9.2": "<span class='verse-line'>{}</span>", "ja444:9.3": "<span class='verse-line'>{}</span>", "ja444:9.4": "<span class='verse-line'>{}</span>", "ja444:9.5": "<span class='verse-line'>{}</span>", "ja444:9.6": "<span class='verse-line'>{}</span></p>", "ja444:10.1": "<p><span class='verse-line'>{}</span>", "ja444:10.2": "<span class='verse-line'>{}</span>", "ja444:10.3": "<span class='verse-line'>{}</span>", "ja444:10.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja444:11.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja444:0.1": "Jātaka ", "ja444:0.2": "Dasakanipāta ", "ja444:0.3": "Catudvāravagga ", "ja444:0.4": "6. Kaṇhadīpāyanajātaka ", "ja444:1.1": "“Sattāhamevāhaṁ pasannacitto, ", "ja444:1.2": "Puññatthiko ācariṁ brahmacariyaṁ; ", "ja444:1.3": "Athāparaṁ yaṁ caritaṁ mamedaṁ, ", "ja444:1.4": "Vassāni paññāsa samādhikāni; ", "ja444:1.5": "Akāmakovāpi ahaṁ carāmi, ", "ja444:1.6": "Etena saccena suvatthi hotu; ", "ja444:1.7": "Hataṁ visaṁ jīvatu yaññadatto”. ", "ja444:2.1": "“Yasmā dānaṁ nābhinandiṁ kadāci, ", "ja444:2.2": "Disvānahaṁ atithiṁ vāsakāle; ", "ja444:2.3": "Na cāpi me appiyataṁ aveduṁ, ", "ja444:2.4": "Bahussutā samaṇabrāhmaṇā ca”. ", "ja444:2.5": "Akāmakovāpi ahaṁ dadāmi, ", "ja444:2.6": "Etena saccena suvatthi hotu; ", "ja444:2.7": "Hataṁ visaṁ jīvatu yaññadatto. ", "ja444:3.1": "“Āsīviso tāta pahūtatejo, ", "ja444:3.2": "Yo taṁ adaṁsī sacarā udicca; ", "ja444:3.3": "Tasmiñca me appiyatāya ajja, ", "ja444:3.4": "Pitari ca te natthi koci viseso; ", "ja444:3.5": "Etena saccena suvatthi hotu, ", "ja444:3.6": "Hataṁ visaṁ jīvatu yaññadatto”. ", "ja444:4.1": "“Santā dantāyeva paribbajanti, ", "ja444:4.2": "Aññatra kaṇhā natthākāmarūpā; ", "ja444:4.3": "Dīpāyana kissa jigucchamāno, ", "ja444:4.4": "Akāmako carasi brahmacariyaṁ”. ", "ja444:5.1": "“Saddhāya nikkhamma punaṁ nivatto, ", "ja444:5.2": "So eḷamūgova bālo vatāyaṁ; ", "ja444:5.3": "Etassa vādassa jigucchamāno, ", "ja444:5.4": "Akāmako carāmi brahmacariyaṁ; ", "ja444:5.5": "Viññuppasatthañca satañca ṭhānaṁ, ", "ja444:5.6": "Evampahaṁ puññakaro bhavāmi”. ", "ja444:6.1": "“Samaṇe tuvaṁ brāhmaṇe addhike ca, ", "ja444:6.2": "Santappayāsi annapānena bhikkhaṁ; ", "ja444:6.3": "Opānabhūtaṁva gharaṁ tava yidaṁ, ", "ja444:6.4": "Annena pānena upetarūpaṁ; ", "ja444:6.5": "Atha kissa vādassa jigucchamāno, ", "ja444:6.6": "Akāmako dānamimaṁ dadāsi”. ", "ja444:7.1": "“Pitaro ca me āsuṁ pitāmahā ca, ", "ja444:7.2": "Saddhā ahuṁ dānapatī vadaññū; ", "ja444:7.3": "Taṁ kullavattaṁ anuvattamāno, ", "ja444:7.4": "Māhaṁ kule antimagandhano ahuṁ; ", "ja444:7.5": "Etassa vādassa jigucchamāno, ", "ja444:7.6": "Akāmako dānamimaṁ dadāmi”. ", "ja444:8.1": "“Dahariṁ kumāriṁ asamatthapaññaṁ, ", "ja444:8.2": "Yaṁ tānayiṁ ñātikulā sugatte; ", "ja444:8.3": "Na cāpi me appiyataṁ avedi, ", "ja444:8.4": "Aññatra kāmā paricārayantā; ", "ja444:8.5": "Atha kena vaṇṇena mayā te bhoti, ", "ja444:8.6": "Saṁvāsadhammo ahu evarūpo”. ", "ja444:9.1": "“Ārā dūre nayidha kadāci atthi, ", "ja444:9.2": "Paramparā nāma kule imasmiṁ; ", "ja444:9.3": "Taṁ kullavattaṁ anuvattamānā, ", "ja444:9.4": "Māhaṁ kule antimagandhinī ahuṁ; ", "ja444:9.5": "Etassa vādassa jigucchamānā, ", "ja444:9.6": "Akāmikā paddhacarāmhi tuyhaṁ”. ", "ja444:10.1": "“Maṇḍabya bhāsiṁ yamabhāsaneyyaṁ, ", "ja444:10.2": "Taṁ khamyataṁ puttakahetu majja; ", "ja444:10.3": "Puttapemā na idha paratthi kiñci, ", "ja444:10.4": "So no ayaṁ jīvati yaññadatto”ti. ", "ja444:11.1": "Kaṇhadīpāyanajātakaṁ chaṭṭhaṁ. "}, "variant_text": {"ja444:0.1": "", "ja444:0.2": "", "ja444:0.3": "", "ja444:0.4": "", "ja444:1.1": "", "ja444:1.2": "ācariṁ → acariṁ (bj, pts-vp-pli1); ācari (sya1ed, sya2ed) ", "ja444:1.3": "mamedaṁ → mamayidaṁ (sya1ed, sya2ed); mamāyidaṁ (pts-vp-pli1) ", "ja444:1.4": "", "ja444:1.5": "Akāmakovāpi → vāhi (pts-vp-pli1, mr) ", "ja444:1.6": "", "ja444:1.7": "", "ja444:2.1": "", "ja444:2.2": "", "ja444:2.3": "", "ja444:2.4": "", "ja444:2.5": "", "ja444:2.6": "", "ja444:2.7": "", "ja444:3.1": "", "ja444:3.2": "adaṁsī → adaṁsi (bj); aḍaṁsī (sya1ed, sya2ed); aḍatthi (pts-vp-pli1) | sacarā → bilarā (bj); biḷārā (sya1ed, sya2ed); patarā (pts-vp-pli1) ", "ja444:3.3": "", "ja444:3.4": "", "ja444:3.5": "", "ja444:3.6": "", "ja444:4.1": "dantāyeva → ye ca (sya1ed, sya2ed, mr) ", "ja444:4.2": "natthākāmarūpā → anakāmarūpā (bj, sya1ed, sya2ed, pts-vp-pli1) ", "ja444:4.3": "", "ja444:4.4": "", "ja444:5.1": "", "ja444:5.2": "eḷamūgova bālo → eḷamūgo capalo (sya1ed, sya2ed, mr); elamūgo va bālo (pts-vp-pli1) ", "ja444:5.3": "", "ja444:5.4": "", "ja444:5.5": "Viññuppasatthañca satañca ṭhānaṁ → viññūpasatthañca satañca ṭhānaṁ (sya1ed, sya2ed, pts-vp-pli1); viññūpasatthaṁ vasitaṁ ca ṭhānaṁ (mr) ", "ja444:5.6": "", "ja444:6.1": "", "ja444:6.2": "", "ja444:6.3": "", "ja444:6.4": "", "ja444:6.5": "", "ja444:6.6": "", "ja444:7.1": "", "ja444:7.2": "", "ja444:7.3": "", "ja444:7.4": "antimagandhano → gandhino (bj, sya1ed, sya2ed, pts-vp-pli1, mr) ", "ja444:7.5": "", "ja444:7.6": "", "ja444:8.1": "", "ja444:8.2": "", "ja444:8.3": "", "ja444:8.4": "paricārayantā → paricārayantī (bj, pts-vp-pli1) ", "ja444:8.5": "", "ja444:8.6": "", "ja444:9.1": "", "ja444:9.2": "", "ja444:9.3": "", "ja444:9.4": "", "ja444:9.5": "", "ja444:9.6": "paddhacarāmhi → baddhacarāsmi (bj); paṭṭhacarāmi (sya1ed, sya2ed); baddhacarāmi (pts-vp-pli1); paṭṭhacarāmhi (mr) ", "ja444:10.1": "bhāsiṁ yamabhāsaneyyaṁ → bhāsissaṁ abhāsaneyyaṁ (bj, sya1ed, sya2ed, pts-vp-pli1); bhāsissa'mabhāsaneyyaṁ (?) ", "ja444:10.2": "", "ja444:10.3": "", "ja444:10.4": "", "ja444:11.1": "Kaṇhadīpāyanajātakaṁ → maṇḍabyajātakaṁ (sya1ed, sya2ed, mr) "}, "reference_text": {"ja444:0.1": "", "ja444:0.2": "", "ja444:0.3": "", "ja444:0.4": "", "ja444:1.1": "dr27.280, ms22J_1975, msdiv62, ndp22.201, pts-vp-pli4.31", "ja444:1.2": "", "ja444:1.3": "", "ja444:1.4": "", "ja444:1.5": "", "ja444:1.6": "", "ja444:1.7": "", "ja444:2.1": "csp1ed22.209, csp2ed22.209, ms22J_1976, msdiv63, pts-vp-pli4.32, sya27.282", "ja444:2.2": "", "ja444:2.3": "", "ja444:2.4": "", "ja444:2.5": "", "ja444:2.6": "", "ja444:2.7": "", "ja444:3.1": "ms22J_1977, msdiv64", "ja444:3.2": "", "ja444:3.3": "", "ja444:3.4": "", "ja444:3.5": "", "ja444:3.6": "", "ja444:4.1": "dr27.281, ms22J_1978, msdiv65, pts-vp-pli4.33", "ja444:4.2": "", "ja444:4.3": "", "ja444:4.4": "", "ja444:5.1": "bj30.362, ms22J_1979, msdiv66, ndp22.202", "ja444:5.2": "", "ja444:5.3": "", "ja444:5.4": "", "ja444:5.5": "", "ja444:5.6": "", "ja444:6.1": "csp1ed22.210, csp2ed22.210, ms22J_1980, msdiv67, pts-vp-pli4.34, sya27.283", "ja444:6.2": "", "ja444:6.3": "", "ja444:6.4": "", "ja444:6.5": "", "ja444:6.6": "", "ja444:7.1": "ms22J_1981, msdiv68", "ja444:7.2": "", "ja444:7.3": "", "ja444:7.4": "", "ja444:7.5": "", "ja444:7.6": "", "ja444:8.1": "dr27.282, ms22J_1982, msdiv69, pts-vp-pli4.35", "ja444:8.2": "", "ja444:8.3": "", "ja444:8.4": "", "ja444:8.5": "", "ja444:8.6": "", "ja444:9.1": "ms22J_1983, msdiv70, ndp22.203, sya27.284, vri68.169", "ja444:9.2": "", "ja444:9.3": "", "ja444:9.4": "", "ja444:9.5": "", "ja444:9.6": "", "ja444:10.1": "csp1ed22.211, csp2ed22.211, ms22J_1984, msdiv71, pts-vp-pli4.36", "ja444:10.2": "", "ja444:10.3": "", "ja444:10.4": "", "ja444:11.1": "ms22J_1985"}, "keys_order": ["j