{"html_text": {"ja200:0.1": "<article id='ja200'><header><ul><li class='division'>{}</li>", "ja200:0.2": "<li>{}</li>", "ja200:0.3": "<li>{}</li></ul>", "ja200:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja200:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja200:1.2": "<span class='verse-line'>{}</span>", "ja200:1.3": "<span class='verse-line'>{}</span>", "ja200:1.4": "<span class='verse-line'>{}</span></p>", "ja200:2.1": "<p><span class='verse-line'>{}</span>", "ja200:2.2": "<span class='verse-line'>{}</span>", "ja200:2.3": "<span class='verse-line'>{}</span>", "ja200:2.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja200:3.1": "<p class='endsutta'>{}</p>", "ja200:3.2": "<p class='endvagga'>{}</p>", "ja200:4.1": "<p class='uddana-intro'>{}</p>", "ja200:5.1": "<blockquote class='uddanagatha'><p><span class='verse-line'>{}</span>", "ja200:5.2": "<span class='verse-line'>{}</span>", "ja200:5.3": "<span class='verse-line'>{}</span>", "ja200:5.4": "<span class='verse-line'>{}</span></p></blockquote></article>"}, "root_text": {"ja200:0.1": "Jātaka ", "ja200:0.2": "Dukanipāta ", "ja200:0.3": "Ruhakavagga ", "ja200:0.4": "10. Sādhusīlajātaka ", "ja200:1.1": "“Sarīradabyaṁ vuḍḍhabyaṁ, ", "ja200:1.2": "sojaccaṁ sādhusīliyaṁ; ", "ja200:1.3": "Brāhmaṇaṁ teva pucchāma, ", "ja200:1.4": "kaṁ nu tesaṁ vanimhase”. ", "ja200:2.1": "“Attho atthi sarīrasmiṁ, ", "ja200:2.2": "vuḍḍhabyassa namo kare; ", "ja200:2.3": "Attho atthi sujātasmiṁ, ", "ja200:2.4": "sīlaṁ asmāka ruccatī”ti. ", "ja200:3.1": "Sādhusīlajātakaṁ dasamaṁ. ", "ja200:3.2": "Ruhakavaggo pañcamo. ", "ja200:4.1": "Tassuddānaṁ ", "ja200:5.1": "Apiruhaka rūpavatī musalo, ", "ja200:5.2": "Pavasanti sapañcamapokkharaṇī; ", "ja200:5.3": "Atha muttimavāṇija umhayate, ", "ja200:5.4": "Ciraāgata koṭṭha sarīra dasāti. "}, "variant_text": {"ja200:0.1": "", "ja200:0.2": "", "ja200:0.3": "", "ja200:0.4": "", "ja200:1.1": "vuḍḍhabyaṁ → vaddhavyaṁ (bj, pts-vp-pli1) ", "ja200:1.2": "", "ja200:1.3": "", "ja200:1.4": "kaṁ nu → kinnu (sya1ed, sya2ed) | vanimhase → vaṇimhase (bj, pts-vp-pli1) ", "ja200:2.1": "", "ja200:2.2": "", "ja200:2.3": "", "ja200:2.4": "", "ja200:3.1": "", "ja200:3.2": "", "ja200:4.1": "", "ja200:5.1": "", "ja200:5.2": "", "ja200:5.3": "", "ja200:5.4": ""}, "reference_text": {"ja200:0.1": "", "ja200:0.2": "", "ja200:0.3": "", "ja200:0.4": "", "ja200:1.1": "ms22J_497, msdiv99, pts-vp-pli2.137, sya27.73", "ja200:1.2": "", "ja200:1.3": "", "ja200:1.4": "", "ja200:2.1": "ms22J_498, msdiv100, pts-vp-pli2.138, vri68.48", "ja200:2.2": "", "ja200:2.3": "", "ja200:2.4": "", "ja200:3.1": "ms22J_499", "ja200:3.2": "", "ja200:4.1": "ms22J_500", "ja200:5.1": "csp1ed22.53, csp2ed22.53, ms22J_501", "ja200:5.2": "", "ja200:5.3": "", "ja200:5.4": ""}, "keys_order": ["ja200:0.1", "ja200:0.2", "ja200:0.3", "ja200:0.4", "ja200:1.1", "ja200:1.2", "ja200:1.3", "ja200:1.4", "ja200:2.1", "ja200:2.2", "ja200:2.3", "ja200:2.4", "ja200:3.1", "ja200:3.2", "ja200:4.1", "ja200:5.1", "ja200:5.2", "ja200:5.3", "ja200:5.4"]}