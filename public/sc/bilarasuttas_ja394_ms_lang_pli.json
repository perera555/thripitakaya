{"html_text": {"ja394:0.1": "<article id='ja394'><header><ul><li class='division'>{}</li>", "ja394:0.2": "<li>{}</li>", "ja394:0.3": "<li>{}</li></ul>", "ja394:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja394:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja394:1.2": "<span class='verse-line'>{}</span>", "ja394:1.3": "<span class='verse-line'>{}</span>", "ja394:1.4": "<span class='verse-line'>{}</span></p>", "ja394:2.1": "<p><span class='verse-line'>{}</span>", "ja394:2.2": "<span class='verse-line'>{}</span>", "ja394:2.3": "<span class='verse-line'>{}</span>", "ja394:2.4": "<span class='verse-line'>{}</span></p>", "ja394:3.1": "<p><span class='verse-line'>{}</span>", "ja394:3.2": "<span class='verse-line'>{}</span>", "ja394:3.3": "<span class='verse-line'>{}</span>", "ja394:3.4": "<span class='verse-line'>{}</span></p>", "ja394:4.1": "<p><span class='verse-line'>{}</span>", "ja394:4.2": "<span class='verse-line'>{}</span>", "ja394:4.3": "<span class='verse-line'>{}</span>", "ja394:4.4": "<span class='verse-line'>{}</span></p>", "ja394:5.1": "<p><span class='verse-line'>{}</span>", "ja394:5.2": "<span class='verse-line'>{}</span>", "ja394:5.3": "<span class='verse-line'>{}</span>", "ja394:5.4": "<span class='verse-line'>{}</span></p>", "ja394:6.1": "<p><span class='verse-line'>{}</span>", "ja394:6.2": "<span class='verse-line'>{}</span>", "ja394:6.3": "<span class='verse-line'>{}</span>", "ja394:6.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja394:7.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja394:0.1": "Jātaka ", "ja394:0.2": "Chakkanipāta ", "ja394:0.3": "Kharaputtavagga ", "ja394:0.4": "9. Vaṭṭakajātaka ", "ja394:1.1": "“Paṇītaṁ bhuñjase bhattaṁ, ", "ja394:1.2": "sappitelañca mātula; ", "ja394:1.3": "Atha kena nu vaṇṇena, ", "ja394:1.4": "kiso tvamasi vāyasa”. ", "ja394:2.1": "“Amittamajjhe vasato, ", "ja394:2.2": "tesu āmisamesato; ", "ja394:2.3": "Niccaṁ ubbiggahadayassa, ", "ja394:2.4": "kuto kākassa daḷhiyaṁ. ", "ja394:3.1": "Niccaṁ ubbegino kākā, ", "ja394:3.2": "dhaṅkā pāpena kammunā; ", "ja394:3.3": "Laddho piṇḍo na pīṇeti, ", "ja394:3.4": "kiso tenasmi vaṭṭaka. ", "ja394:4.1": "Lūkhāni tiṇabījāni, ", "ja394:4.2": "appasnehāni bhuñjasi; ", "ja394:4.3": "Atha kena nu vaṇṇena, ", "ja394:4.4": "thūlo tvamasi vaṭṭaka”. ", "ja394:5.1": "“Appicchā appacintāya, ", "ja394:5.2": "adūragamanena ca; ", "ja394:5.3": "Laddhāladdhena yāpento, ", "ja394:5.4": "thūlo tenasmi vāyasa. ", "ja394:6.1": "Appicchassa hi posassa, ", "ja394:6.2": "appacintasukhassa ca; ", "ja394:6.3": "Susaṅgahitamānassa, ", "ja394:6.4": "vuttī susamudānayā”ti. ", "ja394:7.1": "Vaṭṭakajātakaṁ navamaṁ. "}, "variant_text": {"ja394:0.1": "", "ja394:0.2": "", "ja394:0.3": "", "ja394:0.4": "", "ja394:1.1": "", "ja394:1.2": "", "ja394:1.3": "", "ja394:1.4": "", "ja394:2.1": "", "ja394:2.2": "", "ja394:2.3": "", "ja394:2.4": "", "ja394:3.1": "ubbegino → ubbedhino (bj); ubbiggino (sya1ed, sya2ed, mr) ", "ja394:3.2": "", "ja394:3.3": "", "ja394:3.4": "", "ja394:4.1": "", "ja394:4.2": "", "ja394:4.3": "", "ja394:4.4": "", "ja394:5.1": "", "ja394:5.2": "", "ja394:5.3": "", "ja394:5.4": "", "ja394:6.1": "", "ja394:6.2": "appacintasukhassa → appacintisukhassa (bj, sya1ed, sya2ed, pts-vp-pli1) ", "ja394:6.3": "Susaṅgahitamānassa → susaṅgahitapamānassa (bj); susaṅgahitappamāṇassa (sya1ed, sya2ed); susaṅgahitapamāṇassa (pts-vp-pli1) ", "ja394:6.4": "", "ja394:7.1": ""}, "reference_text": {"ja394:0.1": "", "ja394:0.2": "", "ja394:0.3": "", "ja394:0.4": "", "ja394:1.1": "ms22J_1466, msdiv129, pts-vp-pli3.313", "ja394:1.2": "", "ja394:1.3": "", "ja394:1.4": "", "ja394:2.1": "dr27.208, ms22J_1467, msdiv130", "ja394:2.2": "", "ja394:2.3": "", "ja394:2.4": "", "ja394:3.1": "ms22J_1468, msdiv131, sya27.209", "ja394:3.2": "", "ja394:3.3": "", "ja394:3.4": "", "ja394:4.1": "ms22J_1469, msdiv132", "ja394:4.2": "", "ja394:4.3": "", "ja394:4.4": "", "ja394:5.1": "ms22J_1470, msdiv133", "ja394:5.2": "", "ja394:5.3": "",