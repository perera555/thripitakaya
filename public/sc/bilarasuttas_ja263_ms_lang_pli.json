{"html_text": {"ja263:0.1": "<article id='ja263'><header><ul><li class='division'>{}</li>", "ja263:0.2": "<li>{}</li>", "ja263:0.3": "<li>{}</li></ul>", "ja263:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja263:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja263:1.2": "<span class='verse-line'>{}</span>", "ja263:1.3": "<span class='verse-line'>{}</span>", "ja263:1.4": "<span class='verse-line'>{}</span></p>", "ja263:2.1": "<p><span class='verse-line'>{}</span>", "ja263:2.2": "<span class='verse-line'>{}</span>", "ja263:2.3": "<span class='verse-line'>{}</span>", "ja263:2.4": "<span class='verse-line'>{}</span></p>", "ja263:3.1": "<p><span class='verse-line'>{}</span>", "ja263:3.2": "<span class='verse-line'>{}</span>", "ja263:3.3": "<span class='verse-line'>{}</span>", "ja263:3.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja263:4.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja263:0.1": "Jātaka ", "ja263:0.2": "Tikanipāta ", "ja263:0.3": "Padumavagga ", "ja263:0.4": "3. Cūḷapalobhanajātaka ", "ja263:1.1": "“Abhijjamāne vārismiṁ, ", "ja263:1.2": "sayaṁ āgamma iddhiyā; ", "ja263:1.3": "Missībhāvitthiyā gantvā, ", "ja263:1.4": "saṁsīdasi mahaṇṇave. ", "ja263:2.1": "Āvaṭṭanī mahāmāyā, ", "ja263:2.2": "brahmacariyavikopanā; ", "ja263:2.3": "Sīdanti naṁ viditvāna, ", "ja263:2.4": "ārakā parivajjaye. ", "ja263:3.1": "Yaṁ etā upasevanti, ", "ja263:3.2": "chandasā vā dhanena vā; ", "ja263:3.3": "Jātavedova saṁ ṭhānaṁ, ", "ja263:3.4": "khippaṁ anudahanti nan”ti. ", "ja263:4.1": "Cūḷapalobhanajātakaṁ tatiyaṁ. "}, "variant_text": {"ja263:0.1": "", "ja263:0.2": "", "ja263:0.3": "", "ja263:0.4": "", "ja263:1.1": "", "ja263:1.2": "sayaṁ → ayaṁ (mr) ", "ja263:1.3": "", "ja263:1.4": "saṁsīdasi → saṁsīdati (mr) ", "ja263:2.1": "", "ja263:2.2": "", "ja263:2.3": "", "ja263:2.4": "", "ja263:3.1": "", "ja263:3.2": "", "ja263:3.3": "", "ja263:3.4": "", "ja263:4.1": "Cūḷapalobhanajātakaṁ → cullapalobhanajātakaṁ (bj, sya1ed, sya