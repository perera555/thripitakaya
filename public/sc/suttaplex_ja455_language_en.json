[{"acronym": "Ja 455", "alt_acronym": null, "volpages": "PTS 4.92, PTS 4.93, PTS 4.94", "alt_volpages": null, "uid": "ja455", "blurb": "“Though far away”—This story the Master told, while dwelling in Jetavana, about an Elder who had his mother to support. The circumstances of the event are like those of the Sama Birth. On this occasion also the Master said, addressing the Brethren, “Be not wroth, Brethren, with this man; wise men there have been of old, who even when born from the womb of animals, being parted asunder from their mothers, refused for seven days to take food, pining away; and even when they were offered food fit for a king, did but reply, Without my mother I will not eat; yet took food again when they saw the mother.” So saying, he told a story of the past.", "difficulty": null, "original_title": "Mātuposakajātaka", "root_lang": "pli", "root_lang_name": "Pāli", "type": "leaf", "translated_title": "Mati-Posaka Jātaka", "translations": [{"lang": "pli", "lang_name": "Pāli", "is_root": true, "author": "Mahāsaṅgīti Tipiṭaka Buddhavasse 2500", "author_short": "ms", "author_uid": "ms", "publication_date": null, "id": "ja455_root-pli-ms", "segmented": true, "title": null, "volpage": null, "has_comment": false}, {"lang": "de", "lang_name": "Deutsch", "is_root": false, "author": "Dr. Julius Dutoit", "author_short": "Dutoit", "author_uid": "dutoit", "publication_date": "2007", "id": "de_ja455_dutoit", "segmented": false, "volpage": null, "has_comment": false}, {"author": "W.H.D. Rouse", "author_short": "Rouse", "author_uid": "rouse", "has_comment": false, "id": "en_ja455_rouse", "is_root": false, "lang": "en", "lang_name": "English", "publication_date": "1901", "segmented": false, "volpage": null, "title": "Mati-Posaka Jātaka"}, {"lang": "jpn", "lang_name": "日本語", "is_root": false, "author": "関西パーリ語実習会", "author_short": "関西パーリ語実習会", "author_uid": "kansai", "publication_date": "2023", "id": "jpn_ja455_kansai", "segmented": false, "volpage": null, "has_comment": f