{"html_text": {"ja393:0.1": "<article id='ja393'><header><ul><li class='division'>{}</li>", "ja393:0.2": "<li>{}</li>", "ja393:0.3": "<li>{}</li></ul>", "ja393:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja393:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja393:1.2": "<span class='verse-line'>{}</span>", "ja393:1.3": "<span class='verse-line'>{}</span>", "ja393:1.4": "<span class='verse-line'>{}</span></p>", "ja393:2.1": "<p><span class='verse-line'>{}</span>", "ja393:2.2": "<span class='verse-line'>{}</span>", "ja393:2.3": "<span class='verse-line'>{}</span>", "ja393:2.4": "<span class='verse-line'>{}</span></p>", "ja393:3.1": "<p><span class='verse-line'>{}</span>", "ja393:3.2": "<span class='verse-line'>{}</span>", "ja393:3.3": "<span class='verse-line'>{}</span>", "ja393:3.4": "<span class='verse-line'>{}</span></p>", "ja393:4.1": "<p><span class='verse-line'>{}</span>", "ja393:4.2": "<span class='verse-line'>{}</span>", "ja393:4.3": "<span class='verse-line'>{}</span>", "ja393:4.4": "<span class='verse-line'>{}</span>", "ja393:4.5": "<span class='verse-line'>{}</span></p>", "ja393:5.1": "<p><span class='verse-line'>{}</span>", "ja393:5.2": "<span class='verse-line'>{}</span>", "ja393:5.3": "<span class='verse-line'>{}</span>", "ja393:5.4": "<span class='verse-line'>{}</span></p>", "ja393:6.1": "<p><span class='verse-line'>{}</span>", "ja393:6.2": "<span class='verse-line'>{}</span>", "ja393:6.3": "<span class='verse-line'>{}</span>", "ja393:6.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja393:7.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja393:0.1": "Jātaka ", "ja393:0.2": "Chakkanipāta ", "ja393:0.3": "Kharaputtavagga ", "ja393:0.4": "8. Vighāsādajātaka ", "ja393:1.1": "“Susukhaṁ vata jīvanti, ", "ja393:1.2": "ye janā vighāsādino; ", "ja393:1.3": "Diṭṭheva dhamme pāsaṁsā, ", "ja393:1.4": "samparāye ca suggatī”. ", "ja393:2.1": "“Sukassa bhāsamānassa, ", "ja393:2.2": "na nisāmetha paṇḍitā; ", "ja393:2.3": "Idaṁ suṇātha sodariyā, ", "ja393:2.4": "amhevāyaṁ pasaṁsati”. ", "ja393:3.1": "“Nāhaṁ tumhe pasaṁsāmi, ", "ja393:3.2": "kuṇapādā suṇātha me; ", "ja393:3.3": "Ucchiṭṭhabhojino tumhe, ", "ja393:3.4": "na tumhe vighāsādino”. ", "ja393:4.1": "“Sattavassā pabbajitā, ", "ja393:4.2": "mejjhāraññe sikhaṇḍino; ", "ja393:4.3": "Vighāseneva yāpentā, ", "ja393:4.4": "mayañce bhoto gārayhā; ", "ja393:4.5": "Ke nu bhoto pasaṁsiyā”. ", "ja393:5.1": "“Tumhe sīhānaṁ byagghānaṁ, ", "ja393:5.2": "vāḷānañcāvasiṭṭhakaṁ; ", "ja393:5.3": "Ucchiṭṭheneva yāpentā, ", "ja393:5.4": "maññivho vighāsādino. ", "ja393:6.1": "Ye brāhmaṇassa samaṇassa, ", "ja393:6.2": "aññassa vā vanibbino; ", "ja393:6.3": "Datvāva sesaṁ bhuñjanti, ", "ja393:6.4": "te janā vighāsādino”ti. ", "ja393:7.1": "Vighāsādajātakaṁ aṭṭhamaṁ. "}, "variant_text": {"ja393:0.1": "", "ja393:0.2": "", "ja393:0.3": "", "ja393:0.4": "", "ja393:1.1": "", "ja393:1.2": "", "ja393:1.3": "", "ja393:1.4": "", "ja393:2.1": "Sukassa → suvassa (pts-vp-pli1) ", "ja393:2.2": "", "ja393:2.3": "", "ja393:2.4": "", "ja393:3.1": "", "ja393:3.2": "", "ja393:3.3": "Ucchiṭṭhabhojino → … bhojanā (mr) ", "ja393:3.4": "", "ja393:4.1": "", "ja393:4.2": "mejjhāraññe → majjharaññe (sya1ed, sya2ed); majjheraññe (mr) ", "ja393:4.3": "", "ja393:4.4": "", "ja393:4.5": "", "ja393:5.1": "", "ja393:5.2": "", "ja393:5.3": "", "ja393:5.4": "", "ja393:6.1": "", "ja393:6.2": "aññassa vā → aññassa ca (bj, sya1ed, sya2ed); aññasseva (pts-vp-pli1) | vanibbino → vaṇibbino (bj, sya1ed, sya2ed) ", "ja393:6.3": "Datvāva → datvāna (bj, pts-vp-pli1, mr) ", "ja393:6.4": "", "ja393:7.1": "Vighāsādajātakaṁ → vighāsajātakaṁ (bj, pts-vp-pli1) "}, "reference_text": {"ja393:0.1": "", "ja393:0.2": "", "ja393:0.3": "", "ja393:0.4": "", "ja393:1.1": "bj30.260, dr27.207, ms22J_1459, msdiv123, pts-vp-pli3.311, sya27.208, vri68.127", "ja393:1.2": "", "ja393:1.3": "", "ja393:1.4": "", "ja393:2.1": "ms22J_1460, msdiv124", "ja393:2.2": "", "ja393:2.3": "", "ja393:2.4": "", "ja393:3