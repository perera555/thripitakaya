{"html_text": {"ja179:0.1": "<article id='ja179'><header><ul><li class='division'>{}</li>", "ja179:0.2": "<li>{}</li>", "ja179:0.3": "<li>{}</li></ul>", "ja179:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja179:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja179:1.2": "<span class='verse-line'>{}</span>", "ja179:1.3": "<span class='verse-line'>{}</span>", "ja179:1.4": "<span class='verse-line'>{}</span></p>", "ja179:2.1": "<p><span class='verse-line'>{}</span>", "ja179:2.2": "<span class='verse-line'>{}</span>", "ja179:2.3": "<span class='verse-line'>{}</span>", "ja179:2.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja179:3.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja179:0.1": "Jātaka ", "ja179:0.2": "Dukanipāta ", "ja179:0.3": "Kalyāṇavagga ", "ja179:0.4": "9. Satadhammajātaka ", "ja179:1.1": "“Tañca appañca ucchiṭṭhaṁ, ", "ja179:1.2": "tañca kicchena no adā; ", "ja179:1.3": "Sohaṁ brāhmaṇajātiko, ", "ja179:1.4": "yaṁ bhuttaṁ tampi uggataṁ”. ", "ja179:2.1": "“Evaṁ dhammaṁ niraṅkatvā, ", "ja179:2.2": "Yo adhammena jīvati; ", "ja179:2.3": "Satadhammova lābhena, ", "ja179:2.4": "Laddhenapi na nandatī”ti. ", "ja179:3.1": "Satadhammajātakaṁ navamaṁ. "}, "variant_text": {"ja179:0.1": "", "ja179:0.2": "", "ja179:0.3": "", "ja179:0.4": "", "ja179:1.1": "", "ja179:1.2": "", "ja179:1.3": "", "ja179:1.4": "", "ja179:2.1": "niraṅkatvā → nirākatvā (?) ", "ja179:2.2": "", "ja179:2.3": "", "ja179:2.4": "", "ja179:3.1": ""}, "reference_text": {"ja179:0.1": "", "ja179:0.2": "", "ja179:0.3": "", "ja179:0.4": "", "ja179:1.1": "ms22J_430, msdiv57, pts-vp-pli2.84, vri68.42", "ja179:1.2": "", "ja179:1.3": "", "ja179:1.4": "", "ja179:2.1": "csp1ed22.46, csp2ed22.46, ms22J_431, msdiv58", "ja179:2.2": "", "ja179:2.3": "", "ja179:2.4": "", "ja179:3.1": "ms22J_432"}, "keys_order": ["ja179:0.1", "ja179:0.2", "ja179:0.3", "ja179:0.4", "ja179:1.1", "ja179:1.2", "ja179:1.3", "ja179:1.4", "ja179:2.1", "ja179:2.2", "ja179:2.3", "ja1