{"html_text": {"ja425:0.1": "<article id='ja425'><header><ul><li class='division'>{}</li>", "ja425:0.2": "<li>{}</li>", "ja425:0.3": "<li>{}</li></ul>", "ja425:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja425:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja425:1.2": "<span class='verse-line'>{}</span>", "ja425:1.3": "<span class='verse-line'>{}</span>", "ja425:1.4": "<span class='verse-line'>{}</span></p>", "ja425:2.1": "<p><span class='verse-line'>{}</span>", "ja425:2.2": "<span class='verse-line'>{}</span>", "ja425:2.3": "<span class='verse-line'>{}</span>", "ja425:2.4": "<span class='verse-line'>{}</span></p>", "ja425:3.1": "<p><span class='verse-line'>{}</span>", "ja425:3.2": "<span class='verse-line'>{}</span>", "ja425:3.3": "<span class='verse-line'>{}</span>", "ja425:3.4": "<span class='verse-line'>{}</span></p>", "ja425:4.1": "<p><span class='verse-line'>{}</span>", "ja425:4.2": "<span class='verse-line'>{}</span>", "ja425:4.3": "<span class='verse-line'>{}</span>", "ja425:4.4": "<span class='verse-line'>{}</span></p>", "ja425:5.1": "<p><span class='verse-line'>{}</span>", "ja425:5.2": "<span class='verse-line'>{}</span>", "ja425:5.3": "<span class='verse-line'>{}</span>", "ja425:5.4": "<span class='verse-line'>{}</span></p>", "ja425:6.1": "<p><span class='verse-line'>{}</span>", "ja425:6.2": "<span class='verse-line'>{}</span>", "ja425:6.3": "<span class='verse-line'>{}</span>", "ja425:6.4": "<span class='verse-line'>{}</span></p>", "ja425:7.1": "<p><span class='verse-line'>{}</span>", "ja425:7.2": "<span class='verse-line'>{}</span>", "ja425:7.3": "<span class='verse-line'>{}</span>", "ja425:7.4": "<span class='verse-line'>{}</span></p>", "ja425:8.1": "<p><span class='verse-line'>{}</span>", "ja425:8.2": "<span class='verse-line'>{}</span>", "ja425:8.3": "<span class='verse-line'>{}</span>", "ja425:8.4": "<span class='verse-line'>{}</span></p>", "ja425:9.1": "<p><span class='verse-line'>{}</span>", "ja425:9.2": "<span class='verse-line'>{}</span>", "ja425:9.3": "<span class='verse-line'>{}</span>", "ja425:9.4": "<span class='verse-line'>{}</span></p>", "ja425:10.1": "<p><span class='verse-line'>{}</span>", "ja425:10.2": "<span class='verse-line'>{}</span>", "ja425:10.3": "<span class='verse-line'>{}</span>", "ja425:10.4": "<span class='verse-line'>{}</span></p>", "ja425:11.1": "<p><span class='verse-line'>{}</span>", "ja425:11.2": "<span class='verse-line'>{}</span>", "ja425:11.3": "<span class='verse-line'>{}</span>", "ja425:11.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja425:12.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja425:0.1": "Jātaka ", "ja425:0.2": "Aṭṭhakanipāta ", "ja425:0.3": "Kaccānivagga ", "ja425:0.4": "9. Aṭṭhānajātaka ", "ja425:1.1": "“Gaṅgā kumudinī santā, ", "ja425:1.2": "saṅkhavaṇṇā ca kokilā; ", "ja425:1.3": "Jambu tālaphalaṁ dajjā, ", "ja425:1.4": "atha nūna tadā siyā. ", "ja425:2.1": "Yadā kacchapalomānaṁ, ", "ja425:2.2": "pāvāro tividho siyā; ", "ja425:2.3": "Hemantikaṁ pāvuraṇaṁ, ", "ja425:2.4": "atha nūna tadā siyā. ", "ja425:3.1": "Yadā makasapādānaṁ, ", "ja425:3.2": "aṭṭālo sukato siyā; ", "ja425:3.3": "Daḷho ca avikampī ca, ", "ja425:3.4": "atha nūna tadā siyā. ", "ja425:4.1": "Yadā sasavisāṇānaṁ, ", "ja425:4.2": "nisseṇī sukatā siyā; ", "ja425:4.3": "Saggassārohaṇatthāya, ", "ja425:4.4": "atha nūna tadā siyā. ", "ja425:5.1": "Yadā nisseṇimāruyha, ", "ja425:5.2": "candaṁ khādeyyu mūsikā; ", "ja425:5.3": "Rāhuñca paripāteyyuṁ, ", "ja425:5.4": "atha nūna tadā siyā. ", "ja425:6.1": "Yadā surāghaṭaṁ pitvā, ", "ja425:6.2": "makkhikā gaṇacāriṇī; ", "ja425:6.3": "Aṅgāre vāsaṁ kappeyyuṁ, ", "ja425:6.4": "atha nūna tadā siyā. ", "ja425:7.1": "Yadā bimboṭṭhasampanno, ", "ja425:7.2": "gadrabho sumukho siyā; ", "ja425:7.3": "Kusalo naccagītassa, ", "ja425:7.4": "atha nūna tadā siyā. ", "ja425:8.1": "Yadā kākā ulūkā ca, ", "ja425:8.2": "mantayeyyuṁ rahogatā; ", "ja425:8.3": "Aññamaññaṁ pihayeyyuṁ, ", "ja425:8.4": "atha nūna tadā siyā. ", "ja425:9.1": "Yadā muḷāla pattānaṁ, ", "ja425:9.2": "chattaṁ thirataraṁ siyā; ", "ja425:9.3": "Vassassa paṭighātāya, ", "ja425:9.4": "atha nūna tadā siyā. ", "ja425:10.1": "Yadā kulako sakuṇo, ", "ja425:10.2": "pabbataṁ gandhamādanaṁ; ", "ja425:10.3": "Tuṇḍenādāya gaccheyya, ", "ja425:10.4": "atha nūna tadā siyā. ", "ja425:11.1": "Yadā sāmuddikaṁ nāvaṁ, ", "ja425:11.2": "sayantaṁ savaṭākaraṁ; ", "ja425:11.3": "Ceṭo ādāya gaccheyya, ", "ja425:11.4": "atha nūna tadā siyā”ti. ", "ja425:12.1": "Aṭṭhānajātakaṁ navamaṁ. "}, "variant_text": {"ja425:0.1": "", "ja425:0.2": "", "ja425:0.3": "", "ja425:0.4": "", "ja425:1.1": "", "ja425:1.2": "", "ja425:1.3": "", "ja425:1.4": "", "ja425:2.1": "", "ja425:2.2": "", "ja425:2.3": "pāvuraṇaṁ → pāpuraṇaṁ (bj, sya1ed, sya2ed, pts-vp-pli1) ", "ja425:2.4": "", "ja425:3.1": "makasapādānaṁ → … dāṭhānaṁ (bj, pts-vp-pli1) ", "ja425:3.2": "", "ja425:3.3": "avikampī ca → appakampi ca (bj); appakampī ca (pts-vp-pli1) ", "ja425:3.4": "", "ja425:4.1": "", "ja425:4.2": "", "ja425:4.3": "", "ja425:4.4": "", "ja425:5.1": "", "ja425:5.2": "", "ja425:5.3": "paripāteyyuṁ → paribāheyyuṁ (sya1ed, sya2ed) ", "ja425:5.4": "", "ja425:6.1": "", "ja425:6.2": "", "ja425:6.3": "", "ja425:6.4": "", "ja425:7.1": "", "ja425:7.2": "", "ja425:7.3": "", "ja425:7.4": "", "ja425:8.1": "", "ja425:8.2": "", "ja425:8.3": "", "ja425:8.4": "", "ja425:9.1": "muḷāla → pulasa (bj, pts-vp-pli1); mulāsa (sya1ed, sya2ed) ", "ja425:9.2": "", "ja425:9.3": "", "ja425:9.4": "", "ja425:10.1": "kulako → kuluṅko (bj, pts-vp-pli1); kuluko (sya1ed, sya2ed) ", "ja425:10.2": "", "ja425:10.3": "", "ja425:10.4": "", "ja425:11.1": "", "ja425:11.2": "savaṭākaraṁ → sapaṭākāraṁ (mr) ", "ja425:11.3": "", "ja425:11.4": "", "ja425:12.1": ""}, "reference_text": {"ja425:0.1": "", "ja425:0.2": "", "ja425:0.3": "", "ja425:0.4": "", "ja425:1.1": "ms22J_1757, msdiv77, pts-vp-pli3.477", "ja425:1.2": "", "ja425:1.3": "", "ja425:1.4": "", "ja425:2.1": "ms22J_1758, msdiv78", "ja425:2.2": "", "ja425:2.3