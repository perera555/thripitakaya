{"html_text": {"ja365:0.1": "<article id='ja365'><header><ul><li class='division'>{}</li>", "ja365:0.2": "<li>{}</li>", "ja365:0.3": "<li>{}</li></ul>", "ja365:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja365:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja365:1.2": "<span class='verse-line'>{}</span>", "ja365:1.3": "<span class='verse-line'>{}</span>", "ja365:1.4": "<span class='verse-line'>{}</span></p>", "ja365:2.1": "<p><span class='verse-line'>{}</span>", "ja365:2.2": "<span class='verse-line'>{}</span>", "ja365:2.3": "<span class='verse-line'>{}</span>", "ja365:2.4": "<span class='verse-line'>{}</span></p>", "ja365:3.1": "<p><span class='verse-line'>{}</span>", "ja365:3.2": "<span class='verse-line'>{}</span>", "ja365:3.3": "<span class='verse-line'>{}</span>", "ja365:3.4": "<span class='verse-line'>{}</span></p>", "ja365:4.1": "<p><span class='verse-line'>{}</span>", "ja365:4.2": "<span class='verse-line'>{}</span>", "ja365:4.3": "<span class='verse-line'>{}</span>", "ja365:4.4": "<span class='verse-line'>{}</span></p>", "ja365:5.1": "<p><span class='verse-line'>{}</span>", "ja365:5.2": "<span class='verse-line'>{}</span>", "ja365:5.3": "<span class='verse-line'>{}</span>", "ja365:5.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja365:6.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja365:0.1": "Jātaka ", "ja365:0.2": "Pañcakanipāta ", "ja365:0.3": "Vaṇṇārohavagga ", "ja365:0.4": "5. Ahituṇḍikajātaka ", "ja365:1.1": "“Dhuttomhi samma sumukha, ", "ja365:1.2": "jūte akkhaparājito; ", "ja365:1.3": "Harehi ambapakkāni, ", "ja365:1.4": "vīriyaṁ te bhakkhayāmase”. ", "ja365:2.1": "“Alikaṁ vata maṁ samma, ", "ja365:2.2": "abhūtena pasaṁsasi; ", "ja365:2.3": "Ko te suto vā diṭṭho vā, ", "ja365:2.4": "sumukho nāma makkaṭo. ", "ja365:3.1": "Ajjāpi me taṁ manasi, ", "ja365:3.2": "yaṁ maṁ tvaṁ ahituṇḍika; ", "ja365:3.3": "Dhaññāpaṇaṁ pavisitvā, ", "ja365:3.4": "matto chātaṁ hanāsi maṁ. ", "ja365:4.1": "Tāhaṁ saraṁ dukkhaseyyaṁ, ", "ja365:4.2": "api rajjampi kāraye; ", "ja365:4.3": "Nevāhaṁ yācito dajjaṁ, ", "ja365:4.4": "tathā hi bhayatajjito. ", "ja365:5.1": "Yañca jaññā kule jātaṁ, ", "ja365:5.2": "Gabbhe tittaṁ amacchariṁ; ", "ja365:5.3": "Tena sakhiñca mittañca, ", "ja365:5.4": "Dhīro sandhātumarahatī”ti. ", "ja365:6.1": "Ahituṇḍikajātakaṁ pañcamaṁ. "}, "variant_text": {"ja365:0.1": "", "ja365:0.2": "", "ja365:0.3": "", "ja365:0.4": "", "ja365:1.1": "", "ja365:1.2": "", "ja365:1.3": "Harehi → sevehi (si, pts-vp-pli1) ", "ja365:1.4": "", "ja365:2.1": "", "ja365:2.2": "", "ja365:2.3": "", "ja365:2.4": "", "ja365:3.1": "taṁ manasi → me tvaṁ manasi (bj); te maṁ sarasi (mr) ", "ja365:3.2": "", "ja365:3.3": "", "ja365:3.4": "matto → mutto (mr) ", "ja365:4.1": "", "ja365:4.2": "", "ja365:4.3": "", "ja365:4.4": "", "ja365:5.1": "", "ja365:5.2": "", "ja365:5.3": "", "ja365:5.4": "", "ja365:6.1": "Ahituṇḍikajātakaṁ → ahiguṇḍikajātakaṁ (pts-vp-pli1) "}, "reference_text": {"ja365:0.1": "", "ja365:0.2": "", "ja365:0.3": "", "ja365:0.4": "", "ja365:1.1": "bj30.222, ms22J_1241, msdiv80, pts-vp-pli3.198", "ja365:1.2": "", "ja365:1.3": "", "ja365:1.4": "", "ja365:2.1": "ms22J_1242, msdiv81", "ja365:2.2": "", "ja365:2.3": "", "ja365:2.4": "", "ja365:3.1": "csp1ed22.130, csp2ed22.130, dr27.177, ms22J_1243, msdiv82, ndp22.121, pts-vp-pli3.199", "ja365:3.2": "", "ja365:3.3": "", "ja365:3.4": "", "ja365:4.1": "ms22J_1244, msdiv83", "ja365:4.2": "", "ja365:4.3": "", "ja365:4.4": "", "ja365:5.1": "ms22J_1245, msdiv84", "ja365:5.2": "", "ja365:5.3": "", "ja365:5.4": "", "ja365:6.1": "ms22J_1246"}, "keys_order": ["ja365:0.1", "ja365:0.2", "ja365:0.3", "ja365:0.4", "ja365:1.1", "ja365:1.2", "ja365:1.3", "ja365:1.4", "ja365:2.1", "ja365:2.2", "ja365:2.3", "ja365:2.4", "ja365:3.1", "ja365:3.2", "ja365:3.3", "ja365:3.4", "ja365:4.1", "ja365:4.2", "ja365:4.3", "ja365:4.4", "ja365:5.1", "ja365:5.2", "ja365:5.3", "ja365:5.4", "ja365:6.1"]}