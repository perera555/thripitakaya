{"html_text": {"ja111:0.1": "<article id='ja111'><header><ul><li class='division'>{}</li>", "ja111:0.2": "<li>{}</li>", "ja111:0.3": "<li>{}</li></ul>", "ja111:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja111:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja111:1.2": "<span class='verse-line'>{}</span>", "ja111:1.3": "<span class='verse-line'>{}</span>", "ja111:1.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja111:2.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja111:0.1": "Jātaka ", "ja111:0.2": "Ekakanipāta ", "ja111:0.3": "Haṁcivagga ", "ja111:0.4": "1. Gadrabhapañhajātaka ", "ja111:1.1": "“Haṁci tuvaṁ evamaññasi seyyo, ", "ja111:1.2": "Puttena pitāti rājaseṭṭha; ", "ja111:1.3": "Handassatarassa te ayaṁ, ", "ja111:1.4": "Assatarassa hi gadrabho pitā”ti. ", "ja111:2.1": "Gadrabhapañhajātakaṁ paṭhamaṁ. "}, "variant_text": {"ja111:0.1": "", "ja111:0.2": "", "ja111:0.3": "Haṁci → haṁsi (bj, sya1ed, sya2ed); hañci (?) | tuvaṁ → tvaṁ (bj) ", "ja111:0.4": "", "ja111:1.1": "", "ja111:1.2": "", "ja111:1.3": "", "ja111:1.4": "", "ja111:2.1": "Gadrabhapañhajātakaṁ → gadrabhapañho (sya1ed, sya2ed, pts-vp-pli1) "}, "reference_text": {"ja111:0.1": "", "ja111:0.2": "", "ja111:0.3": "", "ja111:0.4": "", "ja111:1.1": "bj30.46, dr27.37, ms22J_247, msdiv111, ndp22.26", "ja111:1.2": "", "ja111:1.3": "", "ja111:1.4": "", "ja111:2.1": "ms22J_248"}, "keys_order": ["ja111:0.1", "ja111:0.2", "ja111:0.3", "ja111:0.4", "ja111:1.1", "ja111:1.2", "ja111:1.3", "ja111:1.4", "ja111:2.1"]}