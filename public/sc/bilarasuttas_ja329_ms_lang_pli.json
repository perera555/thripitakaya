{"html_text": {"ja329:0.1": "<article id='ja329'><header><ul><li class='division'>{}</li>", "ja329:0.2": "<li>{}</li>", "ja329:0.3": "<li>{}</li></ul>", "ja329:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja329:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja329:1.2": "<span class='verse-line'>{}</span>", "ja329:1.3": "<span class='verse-line'>{}</span>", "ja329:1.4": "<span class='verse-line'>{}</span></p>", "ja329:2.1": "<p><span class='verse-line'>{}</span>", "ja329:2.2": "<span class='verse-line'>{}</span>", "ja329:2.3": "<span class='verse-line'>{}</span>", "ja329:2.4": "<span class='verse-line'>{}</span></p>", "ja329:3.1": "<p><span class='verse-line'>{}</span>", "ja329:3.2": "<span class='verse-line'>{}</span>", "ja329:3.3": "<span class='verse-line'>{}</span>", "ja329:3.4": "<span class='verse-line'>{}</span></p>", "ja329:4.1": "<p><span class='verse-line'>{}</span>", "ja329:4.2": "<span class='verse-line'>{}</span>", "ja329:4.3": "<span class='verse-line'>{}</span>", "ja329:4.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja329:5.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja329:0.1": "Jātaka ", "ja329:0.2": "Catukkanipāta ", "ja329:0.3": "Kuṭidūsakavagga ", "ja329:0.4": "9. Kāḷabāhujātaka ", "ja329:1.1": "“Yaṁ annapānassa pure labhāma, ", "ja329:1.2": "Taṁ dāni sākhamigameva gacchati; ", "ja329:1.3": "Gacchāma dāni vanameva rādha, ", "ja329:1.4": "Asakkatā casma dhanañjayāya”. ", "ja329:2.1": "“Lābho alābho yaso ayaso ca, ", "ja329:2.2": "Nindā pasaṁsā ca sukhañca dukkhaṁ; ", "ja329:2.3": "Ete aniccā manujesu dhammā, ", "ja329:2.4": "Mā soci kiṁ socasi poṭṭhapāda”. ", "ja329:3.1": "“Addhā tuvaṁ paṇḍitakosi rādha, ", "ja329:3.2": "Jānāsi atthāni anāgatāni; ", "ja329:3.3": "Kathaṁ nu sākhāmigaṁ dakkhisāma, ", "ja329:3.4": "Niddhāvitaṁ rājakulatova jammaṁ”. ", "ja329:4.1": "“Cāleti kaṇṇaṁ bhakuṭiṁ karoti, ", "ja329:4.2": "Muhuṁ muhuṁ bhāyayate kumāre; ", "ja329:4.3": "Sayameva taṁ kāhati kāḷabāhu, ", "ja329:4.4": "Yenārakā ṭhassati annapānā”ti. ", "ja329:5.1": "Kāḷabāhujātakaṁ navamaṁ. "}, "variant_text": {"ja329:0.1": "", "ja329:0.2": "", "ja329:0.3": "", "ja329:0.4": "", "ja329:1.1": "", "ja329:1.2": "", "ja329:1.3": "", "ja329:1.4": "dhanañjayāya → dhanañcayāya (mr) ", "ja329:2.1": "", "ja329:2.2": "", "ja329:2.3": "", "ja329:2.4": "", "ja329:3.1": "", "ja329:3.2": "", "ja329:3.3": "dakkhisāma → dakkhāma (sya1ed, sya2ed); dakkhiyāma (mr) ", "ja329:3.4": "Niddhāvitaṁ → niddhāpitaṁ (bj, sya1ed, sya2ed); nibbāpitaṁ (pts-vp-pli1); nicchadaṁ (mr) ", "ja329:4.1": "", "ja329:4.2": "bhāyayate → bhāyate (sya1ed, sya2ed); bhāyāpate (mr) ", "ja329:4.3": "", "ja329:4.4": "", "ja329:5.1": "Kāḷabāhujātakaṁ → kālabāhujātakaṁ (pts-vp-pli1) "}, "reference_text": {"ja329:0.1": "", "ja329:0.2": "", "ja329:0.3": "", "ja329:0.4": "", "ja329:1.1": "bj30.186, ms22J_1027, msdiv113, pts-vp-pli3.98", "ja329:1.2": "", "ja329:1.3": "", "ja329:1.4": "", "ja329:2.1": "ms22J_1028, msdiv114", "ja329:2.2": "", "ja329:2.3": "", "ja329:2.4": "", "ja329:3.1": "csp1ed22.108, csp2ed22.108, ms22J_1029, msdiv115, pts-vp-pli3.99, sya27.148", "ja329:3.2": "", "ja329:3.3": "", "ja329:3.4": "", "ja329:4.1": "dr27.148, ms22J_1030, msdiv116, vri68.93", "ja329:4.2": "", "ja329:4.3": "", "ja329:4.4": "", "ja329:5.1": "ms22J_1031"}, "keys_order": ["ja329:0.1", "ja329:0.2", "ja329:0.3", "ja329:0.4", "ja329:1.1", "ja329:1.2", "ja329:1.3", "ja329:1.4", "ja329:2.1", "ja329:2.2", "ja329:2.3", "ja329:2.4", "ja329:3.1", "ja329:3.2", "ja329:3.3", "ja329:3.4", "ja329:4.1", "ja329:4.2", "ja329:4.3", "ja329:4.4", "ja329:5.1"]}