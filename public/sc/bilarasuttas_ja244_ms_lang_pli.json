{"html_text": {"ja244:0.1": "<article id='ja244'><header><ul><li class='division'>{}</li>", "ja244:0.2": "<li>{}</li>", "ja244:0.3": "<li>{}</li></ul>", "ja244:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja244:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja244:1.2": "<span class='verse-line'>{}</span>", "ja244:1.3": "<span class='verse-line'>{}</span>", "ja244:1.4": "<span class='verse-line'>{}</span></p>", "ja244:2.1": "<p><span class='verse-line'>{}</span>", "ja244:2.2": "<span class='verse-line'>{}</span>", "ja244:2.3": "<span class='verse-line'>{}</span>", "ja244:2.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja244:3.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja244:0.1": "Jātaka ", "ja244:0.2": "Dukanipāta ", "ja244:0.3": "Siṅgālavagga ", "ja244:0.4": "4. Vigaticchajātaka ", "ja244:1.1": "“Yaṁ passati na taṁ icchati, ", "ja244:1.2": "Yañca na passati taṁ kiricchati; ", "ja244:1.3": "Maññāmi ciraṁ carissati, ", "ja244:1.4": "Na hi taṁ lacchati yaṁ sa icchati. ", "ja244:2.1": "Yaṁ labhati na tena tussati, ", "ja244:2.2": "Yañca pattheti laddhaṁ hīḷeti; ", "ja244:2.3": "Icchā hi anantagocarā, ", "ja244:2.4": "Vigaticchāna namo karomase”ti. ", "ja244:3.1": "Vigaticchajātakaṁ catutthaṁ. "}, "variant_text": {"ja244:0.1": "", "ja244:0.2": "", "ja244:0.3": "", "ja244:0.4": "", "ja244:1.1": "", "ja244:1.2": "", "ja244:1.3": "", "ja244:1.4": "", "ja244:2.1": "", "ja244:2.2": "", "ja244:2.3": "", "ja244:2.4": "Vigaticchāna → vīticchānaṁ (bj, pts-vp-pli1); vigaticchānaṁ (sya1ed, sya2ed) ", "ja244:3.1": "Vigaticchajātakaṁ → vīticchajātakaṁ (bj, pts-vp-pli1) "}, "reference_text": {"ja244:0.1": "", "ja244:0.2": "", "ja244:0.3": "", "ja244:0.4": "", "ja244:1.1": "dr27.94, ms22J_644, msdiv188, pts-vp-pli2.258", "ja244:1.2": "", "ja244:1.3": "", "ja244:1.4": "", "ja244:2.1": "bj30.120, ms22J_645, msdiv189", "ja244:2.2": "", "ja244:2.3": "", "ja244:2.4": "", "ja244:3.1": "ms22J_646"}, "keys_order": ["ja244:0.1", "