[{"acronym": "Ja 424", "alt_acronym": null, "volpages": "PTS 3.471, PTS 3.472, PTS 3.473", "alt_volpages": null, "uid": "ja424", "blurb": "“Whate’er a man can save”—The Master told this tale while dwelling in Jetavana, concerning an incomparable gift. The incomparable gift must be described in full from the commentary on the Mahagovindasutta. On the day after that on which it had been given, they were talking of it in the Hall of Truth, “Sirs, the Kosala king after examination found the proper field of merit, and gave the great gift to the assembly with Buddha at its head.” The Master came and was told what the subject of their talk was as they sat together: he said, “Brethren, it is not strange that the king after examination has undertaken great gifts to the supreme field of merit: wise men of old also after examination gave such gifts,” and so he told a tale of old.", "difficulty": null, "original_title": "Ādittajātaka", "root_lang": "pli", "root_lang_name": "Pāli", "type": "leaf", "translated_title": "Aditta Jātaka", "translations": [{"lang": "pli", "lang_name": "Pāli", "is_root": true, "author": "Mahāsaṅgīti Tipiṭaka Buddhavasse 2500", "author_short": "ms", "author_uid": "ms", "publication_date": null, "id": "ja424_root-pli-ms", "segmented": true, "title": null, "volpage": null, "has_comment": false}, {"lang": "de", "lang_name": "Deutsch", "is_root": false, "author": "Dr. Julius Dutoit", "author_short": "Dutoit", "author_uid": "dutoit", "publication_date": "2007", "id": "de_ja424_dutoit", "segmented": false, "volpage": null, "has_comment": false}, {"author": "H.T. Francis, R.A. Neil", "author_short": "Francis …", "author_uid": "francis-neil", "has_comment": false, "id": "en_ja424_francis-neil", "is_root": false, "lang": "en", "lang_name": "English", "publication_date": "1897", "segmented": false, "volpage": null, "title": "Aditta Jātaka"}, {"lang": "jpn", "lang_name": "日本語", "is_root": false, "author": "関西パーリ語実習会", "author_short": "関西パーリ語実習会", "author_uid": "ka