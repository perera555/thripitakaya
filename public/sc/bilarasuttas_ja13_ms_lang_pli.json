{"html_text": {"ja13:0.1": "<article id='ja13'><header><ul><li class='division'>{}</li>", "ja13:0.2": "<li>{}</li>", "ja13:0.3": "<li>{}</li></ul>", "ja13:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja13:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja13:1.2": "<span class='verse-line'>{}</span>", "ja13:1.3": "<span class='verse-line'>{}</span>", "ja13:1.4": "<span class='verse-line'>{}</span>", "ja13:1.5": "<span class='verse-line'>{}</span>", "ja13:1.6": "<span class='verse-line'>{}</span></p></blockquote>", "ja13:2.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja13:0.1": "Jātaka ", "ja13:0.2": "Ekakanipāta ", "ja13:0.3": "Sīlavagga ", "ja13:0.4": "3. Kaṇḍijātaka ", "ja13:1.1": "“Dhiratthu kaṇḍinaṁ sallaṁ, ", "ja13:1.2": "purisaṁ gāḷhavedhinaṁ; ", "ja13:1.3": "Dhiratthu taṁ janapadaṁ, ", "ja13:1.4": "yatthitthī pariṇāyikā; ", "ja13:1.5": "Te cāpi dhikkitā sattā, ", "ja13:1.6": "ye itthīnaṁ vasaṅgatā”ti. ", "ja13:2.1": "Kaṇḍijātakaṁ tatiyaṁ. "}, "variant_text": {"ja13:0.1": "", "ja13:0.2": "", "ja13:0.3": "", "ja13:0.4": "", "ja13:1.1": "", "ja13:1.2": "", "ja13:1.3": "", "ja13:1.4": "", "ja13:1.5": "dhikkitā → dhikkatā (?) ", "ja13:1.6": "", "ja13:2.1": "Kaṇḍijātakaṁ → kaṇḍinajātakaṁ (bj, sya1ed, sya2ed, pts-vp-pli1) "}, "reference_text": {"ja13:0.1": "", "ja13:0.2": "", "ja13:0.3": "", "ja13:0.4": "", "ja13:1.1": "ms22J_28, msdiv13, pts-vp-pli1.155", "ja13:1.2": "", "ja13:1.3": "", "ja13:1.4": "", "ja13:1.5": "", "ja13:1.6": "", "ja13:2.1": "ms22J_29"}, "keys_order": ["ja13:0.1", "ja13:0.2", "ja13:0.3", "ja13:0.4", "ja13:1.1", "ja13:1.2", "ja13:1.3", "ja13:1.4", "ja13:1.5", "ja13:1.6", "ja13:2.1"]}