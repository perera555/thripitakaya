mment": true}, {"lang": "en", "lang_name": "English", "is_root": false, "author": "Bhikkhu Sujato", "author_short": "sujato", "author_uid": "sujato", "publication_date": null, "id": "ja12_translation-en-sujato", "segmented": true, "title": "The Banyan Deer ", "volpage": null, "has_comment": true}, {"lang": "pli", "lang_name": "Pāli", "is_root": true, "author": "Mahāsaṅgīti Tipiṭaka Buddhavasse 2500", "author_short": "ms", "author_uid": "ms", "publication_date": null, "id": "ja12_root-pli-ms", "segmented": true, "title": null, "volpage": null, "has_comment": false}, {"lang": "de", "lang_name": "Deutsch", "is_root": false, "author": "Dr. Julius Dutoit", "author_short": "Dutoit", "author_uid": "dutoit", "publication_date": "2007", "id": "de_ja12_dutoit", "segmented": false, "volpage": null, "has_comment": false}, {"author": "Robert Chalmers", "author_short": "Chalmers", "author_uid": "chalmers", "has_comment": false, "id": "en_ja12_chalmers", "is_root": false, "lang": "en", "lang_name": "English", "publication_date": "1895", "segmented": false, "volpage": null, "title": "Nigrodhamiga Jātaka"}, {"lang": "jpn", "lang_name": "日本語", "is_root": false, "author": "関西パーリ語実習会", "author_short": "関西パーリ語実習会", "author_uid": "kansai", "publication_date": "2023", "id": "jpn_ja12_kansai", "segmented": false, "volpage": null, "has_comment": false}, {"lang": "si", "lang_name": "සිංහල", "is_root": false, "author": "A.P. de Zoysa", "author_short": "Zoysa", "author_uid": "zoysa", "publication_date": null, "id": "si_ja12_zoysa", "segmented": false, "volpage": null, "has_comment": false}], "parallel_count": 3, "biblio": null, "priority_author_uid": "sujato", "verseNo": ",,,,csp1ed22.4, csp2ed22.4, ms22J_26, msdiv12, pts-vp-pli1.152, sya27.5, vri68.4,,,,ms22J_27", "previous": {"name": null, "uid": null}, "next": {"name": null, "uid": null}}, "bilara_root_text": {"uid": "ja12", "author": "Mahāsaṅgīti Tipiṭaka Buddhavasse 2500", "author_short": "ms", "author_uid": "ms", "lang": "pli", "title": 