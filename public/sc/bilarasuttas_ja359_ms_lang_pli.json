{"html_text": {"ja359:0.1": "<article id='ja359'><header><ul><li class='division'>{}</li>", "ja359:0.2": "<li>{}</li>", "ja359:0.3": "<li>{}</li></ul>", "ja359:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja359:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja359:1.2": "<span class='verse-line'>{}</span>", "ja359:1.3": "<span class='verse-line'>{}</span>", "ja359:1.4": "<span class='verse-line'>{}</span></p>", "ja359:2.1": "<p><span class='verse-line'>{}</span>", "ja359:2.2": "<span class='verse-line'>{}</span>", "ja359:2.3": "<span class='verse-line'>{}</span>", "ja359:2.4": "<span class='verse-line'>{}</span></p>", "ja359:3.1": "<p><span class='verse-line'>{}</span>", "ja359:3.2": "<span class='verse-line'>{}</span>", "ja359:3.3": "<span class='verse-line'>{}</span>", "ja359:3.4": "<span class='verse-line'>{}</span></p>", "ja359:4.1": "<p><span class='verse-line'>{}</span>", "ja359:4.2": "<span class='verse-line'>{}</span>", "ja359:4.3": "<span class='verse-line'>{}</span>", "ja359:4.4": "<span class='verse-line'>{}</span></p>", "ja359:5.1": "<p><span class='verse-line'>{}</span>", "ja359:5.2": "<span class='verse-line'>{}</span>", "ja359:5.3": "<span class='verse-line'>{}</span>", "ja359:5.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja359:6.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja359:0.1": "Jātaka ", "ja359:0.2": "Pañcakanipāta ", "ja359:0.3": "Maṇikuṇḍalavagga ", "ja359:0.4": "9. Suvaṇṇamigajātaka ", "ja359:1.1": "“Vikkama re haripāda, ", "ja359:1.2": "vikkama re mahāmiga; ", "ja359:1.3": "Chinda vārattikaṁ pāsaṁ, ", "ja359:1.4": "nāhaṁ ekā vane rame”. ", "ja359:2.1": "“Vikkamāmi na pāremi, ", "ja359:2.2": "bhūmiṁ sumbhāmi vegasā; ", "ja359:2.3": "Daḷho vārattiko pāso, ", "ja359:2.4": "pādaṁ me parikantati”. ", "ja359:3.1": "“Attharassu palāsāni, ", "ja359:3.2": "asiṁ nibbāha luddaka; ", "ja359:3.3": "Paṭhamaṁ maṁ vadhitvāna, ", "ja359:3.4": "hana pacchā mahāmigaṁ”. ", "ja359:4.1": "“Na me sutaṁ vā diṭṭhaṁ vā, ", "ja359:4.2": "Bhāsantiṁ mānusiṁ migiṁ; ", "ja359:4.3": "Tvañca bhadde sukhī hohi, ", "ja359:4.4": "Eso cāpi mahāmigo”. ", "ja359:5.1": "“Evaṁ luddaka nandassu, ", "ja359:5.2": "saha sabbehi ñātibhi; ", "ja359:5.3": "Yathāhamajja nandāmi, ", "ja359:5.4": "muttaṁ disvā mahāmigan”ti. ", "ja359:6.1": "Suvaṇṇamigajātakaṁ navamaṁ. "}, "variant_text": {"ja359:0.1": "", "ja359:0.2": "", "ja359:0.3": "", "ja359:0.4": "", "ja359:1.1": "haripāda → mahāmiga (bj, sya1ed, sya2ed, pts-vp-pli1) ", "ja359:1.2": "mahāmiga → harīpada (bj, sya1ed, sya2ed); haripada (pts-vp-pli1) ", "ja359:1.3": "", "ja359:1.4": "", "ja359:2.1": "", "ja359:2.2": "", "ja359:2.3": "", "ja359:2.4": "", "ja359:3.1": "", "ja359:3.2": "", "ja359:3.3": "", "ja359:3.4": "", "ja359:4.1": "", "ja359:4.2": "Bhāsantiṁ mānusiṁ migiṁ → bhāsantī mānusiṁ migī (ṭīkā) ", "ja359:4.3": "", "ja359:4.4": "", "ja359:5.1": "", "ja359:5.2": "", "ja359:5.3": "", "ja359:5.4": "", "ja359:6.1": ""}, "reference_text": {"ja359:0.1": "", "ja359:0.2": "", "ja359:0.3": "", "ja359:0.4": "", "ja359:1.1": "bj30.216, dr27.172, ms22J_1203, msdiv50, pts-vp-pli3.184", "ja359:1.2": "", "ja359:1.3": "", "ja359:1.4": "", "ja359:2.1": "ms22J_1204, msdiv51, pts-vp-pli3.185", "ja359:2.2": "", "ja359:2.3": "", "ja359:2.4": "", "ja359:3.1": "ms22J_1205, msdiv52", "ja359:3.2": "", "ja359:3.3": "", "ja359:3.4": "", "ja359:4.1": "ms22J_1206, msdiv53, pts-vp-pli3.186", "ja359:4.2": "", "ja359:4.3": "", "ja359:4.4": "", "ja359:5.1": "ms22J_1207, msdiv54, sya27.173", "ja359:5.2": "", "ja359:5.3": "", "ja359:5.4": "", "ja359:6.1": "ms22J_1208"}, "keys_order": ["ja359:0.1", "ja359:0.2", "ja359:0.3", "ja359:0.4", "ja359:1.1", "ja359:1.2", "ja359:1.3", "ja359:1.4", "ja359:2.1", "ja359:2.2", "ja359:2.3", "ja359:2.4", "ja359:3.1", "ja359:3.2", "ja359:3.3", "ja359:3.4", "ja359:4.1", "ja359:4.2", "ja359:4.3", "ja359:4.4", "ja359:5.1", "ja359:5.2", "ja359:5.3", "ja359:5.4", "ja359:6.1"]}