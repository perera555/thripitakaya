{"html_text": {"ja210:0.1": "<article id='ja210'><header><ul><li class='division'>{}</li>", "ja210:0.2": "<li>{}</li>", "ja210:0.3": "<li>{}</li></ul>", "ja210:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja210:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja210:1.2": "<span class='verse-line'>{}</span>", "ja210:1.3": "<span class='verse-line'>{}</span>", "ja210:1.4": "<span class='verse-line'>{}</span></p>", "ja210:2.1": "<p><span class='verse-line'>{}</span>", "ja210:2.2": "<span class='verse-line'>{}</span>", "ja210:2.3": "<span class='verse-line'>{}</span>", "ja210:2.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja210:3.1": "<p class='endsutta'>{}</p>", "ja210:3.2": "<p class='endvagga'>{}</p>", "ja210:4.1": "<p class='uddana-intro'>{}</p>", "ja210:5.1": "<blockquote class='uddanagatha'><p><span class='verse-line'>{}</span>", "ja210:5.2": "<span class='verse-line'>{}</span>", "ja210:5.3": "<span class='verse-line'>{}</span>", "ja210:5.4": "<span class='verse-line'>{}</span></p></blockquote></article>"}, "root_text": {"ja210:0.1": "Jātaka ", "ja210:0.2": "Dukanipāta ", "ja210:0.3": "Nataṁdaḷhavagga ", "ja210:0.4": "10. Kandagalakajātaka ", "ja210:1.1": "“Ambho ko nāma yaṁ rukkho, ", "ja210:1.2": "sinnapatto sakaṇṭako; ", "ja210:1.3": "Yattha ekappahārena, ", "ja210:1.4": "uttamaṅgaṁ vibhijjitaṁ”. ", "ja210:2.1": "“Acāri vatāyaṁ vitudaṁ vanāni, ", "ja210:2.2": "Kaṭṭhaṅgarukkhesu asārakesu; ", "ja210:2.3": "Athāsadā khadiraṁ jātasāraṁ, ", "ja210:2.4": "Yatthabbhidā garuḷo uttamaṅgan”ti. ", "ja210:3.1": "Kandagalakajātakaṁ dasamaṁ. ", "ja210:3.2": "Nataṁdaḷhavaggo chaṭṭho. ", "ja210:4.1": "Tassuddānaṁ ", "ja210:5.1": "Daḷhabandhana haṁsavaro ca puna, ", "ja210:5.2": "Virūpakkha saviṭṭhaka macchavaro; ", "ja210:5.3": "Sakuruṅga saassaka ambavaro, ", "ja210:5.4": "Puna kukkuṭako garuḷena dasāti. "}, "variant_text": {"ja210:0.1": "", "ja210:0.2": "", "ja210:0.3": "", "ja210:0.4": "", "ja210:1.1": "", "ja210:1.2": "sinnapatto → sīnapatto (bj); sītappatto (pts-vp-pli1) ", "ja210:1.3": "", "ja210:1.4": "vibhijjitaṁ → vighāṭitaṁ (bj); visāṭitaṁ (sya1ed, sya2ed); visāṭitanti (pts-vp-pli1) ", "ja210:2.1": "", "ja210:2.2": "", "ja210:2.3": "jātasāraṁ → jātisāraṁ (mr) ", "ja210:2.4": "", "ja210:3.1": "Kandagalakajātakaṁ → kandagaḷakajātakaṁ (bj); kandalakajātakaṁ (mr) ", "ja210:3.2": "", "ja210:4.1": "", "ja210:5.1": "", "ja210:5.2": "", "ja210:5.3": "", "ja210:5.4": ""}, "reference_text": {"ja210:0.1": "", "ja210:0.2": "", "ja210:0.3": "", "ja210:0.4": "", "ja210:1.1": "dr27.77, ms22J_533, msdiv119, pts-vp-pli2.163, vri68.51", "ja210:1.2": "", "ja210:1.3": "", "ja210:1.4": "", "ja210:2.1": "ms22J_534, msdiv120, sya27.78", "ja210:2.2": "", "ja210:2.3": "", "ja210:2.4": "", "ja210:3.1": "ms22J_535", "ja210:3.2": "", "ja210:4.1": "ms22J_536", "ja210:5.1": "ms22J_537", "ja210:5.2": "", "ja210:5.3": "", "ja210:5.4": ""}, "keys_order": ["ja210:0.1", "ja210:0.2", "ja210:0.3", "ja210:0.4", "ja210:1.1", "ja210:1.2", "ja210:1.3", "ja210:1.4", "ja210:2.1", "ja210:2.2", "ja210:2.3", "ja210:2.4", "ja210:3.1", "ja210:3.2", "ja210:4.1", "ja210:5.1", "ja210:5.2", "ja210:5.3", "ja210:5.4"]}