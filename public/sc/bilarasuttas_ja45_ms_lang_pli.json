{"html_text": {"ja45:0.1": "<article id='ja45'><header><ul><li class='division'>{}</li>", "ja45:0.2": "<li>{}</li>", "ja45:0.3": "<li>{}</li></ul>", "ja45:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja45:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja45:1.2": "<span class='verse-line'>{}</span>", "ja45:1.3": "<span class='verse-line'>{}</span>", "ja45:1.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja45:2.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja45:0.1": "Jātaka ", "ja45:0.2": "Ekakanipāta ", "ja45:0.3": "Atthakāmavagga ", "ja45:0.4": "5. Rohiṇijātaka ", "ja45:1.1": "“Seyyo amitto medhāvī, ", "ja45:1.2": "Yañce bālānukampako; ", "ja45:1.3": "Passa rohiṇikaṁ jammiṁ, ", "ja45:1.4": "Mātaraṁ hantvāna socatī”ti. ", "ja45:2.1": "Rohiṇijātakaṁ pañcamaṁ. "}, "variant_text": {"ja45:0.1": "", "ja45:0.2": "", "ja45:0.3": "", "ja45:0.4": "", "ja45:1.1": "", "ja45:1.2": "", "ja45:1.3": "", "ja45:1.4": "", "ja45:2.1": "Rohiṇijātakaṁ → rohiṇījātakaṁ (sya1ed, sya2ed, pts-vp-pli1) "}, "reference_text": {"ja45:0.1": "", "ja45:0.2": "", "ja45:0.3": "", "ja45:0.4": "", "ja45:1.1": "ms22J_98, msdiv45, pts-vp-pli1.249", "ja45:1.2": "", "ja45:1.3": "", "ja45:1.4": "", "ja45:2.1": "ms22J_99"}, "keys_order": ["ja45:0.1", "ja45:0.2", "ja45:0.3", "ja45:0.4", "ja45:1.1", "ja45:1.2", "ja45:1.3", "ja45:1.4", "ja45:2.1"]}