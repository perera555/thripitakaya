{"html_text": {"ja287:0.1": "<article id='ja287'><header><ul><li class='division'>{}</li>", "ja287:0.2": "<li>{}</li>", "ja287:0.3": "<li>{}</li></ul>", "ja287:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja287:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja287:1.2": "<span class='verse-line'>{}</span>", "ja287:1.3": "<span class='verse-line'>{}</span>", "ja287:1.4": "<span class='verse-line'>{}</span></p>", "ja287:2.1": "<p><span class='verse-line'>{}</span>", "ja287:2.2": "<span class='verse-line'>{}</span>", "ja287:2.3": "<span class='verse-line'>{}</span>", "ja287:2.4": "<span class='verse-line'>{}</span></p>", "ja287:3.1": "<p><span class='verse-line'>{}</span>", "ja287:3.2": "<span class='verse-line'>{}</span>", "ja287:3.3": "<span class='verse-line'>{}</span>", "ja287:3.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja287:4.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja287:0.1": "Jātaka ", "ja287:0.2": "Tikanipāta ", "ja287:0.3": "Abbhantaravagga ", "ja287:0.4": "7. Lābhagarahajātaka ", "ja287:1.1": "“Nānummatto nāpisuṇo, ", "ja287:1.2": "nānaṭo nākutūhalo; ", "ja287:1.3": "Mūḷhesu labhate lābhaṁ, ", "ja287:1.4": "esā te anusāsanī”. ", "ja287:2.1": "“Dhiratthu taṁ yasalābhaṁ, ", "ja287:2.2": "dhanalābhañca brāhmaṇa; ", "ja287:2.3": "Yā vutti vinipātena, ", "ja287:2.4": "adhammacaraṇena vā. ", "ja287:3.1": "Api ce pattamādāya, ", "ja287:3.2": "anagāro paribbaje; ", "ja287:3.3": "Esāva jīvikā seyyo, ", "ja287:3.4": "yā cādhammena esanā”ti. ", "ja287:4.1": "Lābhagarahajātakaṁ sattamaṁ. "}, "variant_text": {"ja287:0.1": "", "ja287:0.2": "", "ja287:0.3": "", "ja287:0.4": "", "ja287:1.1": "", "ja287:1.2": "", "ja287:1.3": "", "ja287:1.4": "", "ja287:2.1": "", "ja287:2.2": "", "ja287:2.3": "", "ja287:2.4": "adhammacaraṇena → adhammacariyāya (bj, sya1ed, sya2ed) ", "ja287:3.1": "", "ja287:3.2": "", "ja287:3.3": "seyyo → seyyā (pts-vp-pli1) ", "ja287:3.4": "", "ja287:4.1": "Lābhagarahajātakaṁ → lābhagarahikajātakaṁ (sya1ed, sya2ed) "}, "reference_text": {"ja287:0.1": "", "ja287:0.2": "", "ja287:0.3": "", "ja287:0.4": "", "ja287:1.1": "ms22J_820, msdiv109, ndp22.80, pts-vp-pli2.421", "ja287:1.2": "", "ja287:1.3": "", "ja287:1.4": "", "ja287:2.1": "ms22J_821, msdiv110, pts-vp-pli2.422", "ja287:2.2": "", "ja287:2.3": "", "ja287:2.4": "", "ja287:3.1": "ms22J_822, msdiv111", "ja287:3.2": "", "ja287:3.3": "", "ja287:3.4": "", "ja287:4.1": "ms22J_823"}, "keys_order": ["ja287:0.1", "ja287:0.2", "ja287:0.3", "ja287:0.4", "ja287:1.1", "ja287:1.2", "ja287:1.3", "ja287:1.4", "ja287:2.1", "ja287:2.2", "ja287:2.3", "ja287:2.4", "ja287:3.1", "ja287:3.2", "ja287:3.3", "ja287:3.4", "ja287:4.1"]}