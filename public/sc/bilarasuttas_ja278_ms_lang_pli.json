{"html_text": {"ja278:0.1": "<article id='ja278'><header><ul><li class='division'>{}</li>", "ja278:0.2": "<li>{}</li>", "ja278:0.3": "<li>{}</li></ul>", "ja278:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja278:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja278:1.2": "<span class='verse-line'>{}</span>", "ja278:1.3": "<span class='verse-line'>{}</span>", "ja278:1.4": "<span class='verse-line'>{}</span></p>", "ja278:2.1": "<p><span class='verse-line'>{}</span>", "ja278:2.2": "<span class='verse-line'>{}</span>", "ja278:2.3": "<span class='verse-line'>{}</span>", "ja278:2.4": "<span class='verse-line'>{}</span></p>", "ja278:3.1": "<p><span class='verse-line'>{}</span>", "ja278:3.2": "<span class='verse-line'>{}</span>", "ja278:3.3": "<span class='verse-line'>{}</span>", "ja278:3.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja278:4.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja278:0.1": "Jātaka ", "ja278:0.2": "Tikanipāta ", "ja278:0.3": "Udapānavagga ", "ja278:0.4": "8. Mahiṁsarājajātaka ", "ja278:1.1": "“Kimatthamabhisandhāya, ", "ja278:1.2": "lahucittassa dubbhino; ", "ja278:1.3": "Sabbakāmadadasseva, ", "ja278:1.4": "imaṁ dukkhaṁ titikkhasi. ", "ja278:2.1": "Siṅgena nihanāhetaṁ, ", "ja278:2.2": "padasā ca adhiṭṭhaha; ", "ja278:2.3": "Bhiyyo bālā pakujjheyyuṁ, ", "ja278:2.4": "no cassa paṭisedhako”. ", "ja278:3.1": "“Mamevāyaṁ maññamāno, ", "ja278:3.2": "aññepevaṁ karissati; ", "ja278:3.3": "Te naṁ tattha vadhissanti, ", "ja278:3.4": "sā me mutti bhavissatī”ti. ", "ja278:4.1": "Mahiṁsarājajātakaṁ aṭṭhamaṁ. "}, "variant_text": {"ja278:0.1": "", "ja278:0.2": "", "ja278:0.3": "", "ja278:0.4": "", "ja278:1.1": "Kimatthamabhisandhāya → kamattha … (bj, pts-vp-pli1) ", "ja278:1.2": "dubbhino → dūbhino (bj, pts-vp-pli1) ", "ja278:1.3": "Sabbakāmadadasseva → … duhasseva (bj, sya1ed, sya2ed, pts-vp-pli1); … rahasseva (mr) ", "ja278:1.4": "", "ja278:2.1": "", "ja278:2.2": "", "ja278:2.3": "Bhiyyo → bhīyo (bj) ", "ja278:2.4": "", "ja278:3.1": "", "ja278:3.2": "aññepevaṁ → aññampevaṁ (bj); aññaṁpevaṁ (sya1ed, sya2ed); aññam peva (pts-vp-pli1) ", "ja278:3.3": "", "ja278:3.4": "", "ja278:4.1": "Mahiṁsarājajātakaṁ → mahisajātakaṁ (bj, sya1ed, sya2ed, pts-vp-pli1) "}, "reference_text": {"ja278:0.1": "", "ja278:0.2": "", "ja278:0.3": "", "ja278:0.4": "", "ja278:1.1": "ms22J_782, msdiv82, pts-vp-pli2.386", "ja278:1.2": "", "ja278:1.3": "", "ja278:1.4": "", "ja278:2.1": "dr27.114, ms22J_783, msdiv83", "ja278:2.2": "", "ja278:2.3": "", "ja278:2.4": "", "ja278:3.1": "ms22J_784, msdiv84", "ja278:3.2": "", "ja278:3.3": "", "ja278:3.4": "", "ja278:4.1": "ms22J_785"}, "keys_order": ["ja278:0.1", "ja278:0.2", "ja278:0.3", "ja278:0.4", "ja278:1.1", "ja278:1.2", "ja278:1.3", "ja278:1.4", "ja278:2.1", "ja278:2.2", "ja278:2.3", "ja278:2.4", "ja278:3.1", "ja278:3.2", "ja278:3.3", "ja278:3.4", "ja278:4.1"]}