{"html_text": {"ja338:0.1": "<article id='ja338'><header><ul><li class='division'>{}</li>", "ja338:0.2": "<li>{}</li>", "ja338:0.3": "<li>{}</li></ul>", "ja338:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja338:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja338:1.2": "<span class='verse-line'>{}</span>", "ja338:1.3": "<span class='verse-line'>{}</span>", "ja338:1.4": "<span class='verse-line'>{}</span></p>", "ja338:2.1": "<p><span class='verse-line'>{}</span>", "ja338:2.2": "<span class='verse-line'>{}</span>", "ja338:2.3": "<span class='verse-line'>{}</span>", "ja338:2.4": "<span class='verse-line'>{}</span></p>", "ja338:3.1": "<p><span class='verse-line'>{}</span>", "ja338:3.2": "<span class='verse-line'>{}</span>", "ja338:3.3": "<span class='verse-line'>{}</span>", "ja338:3.4": "<span class='verse-line'>{}</span></p>", "ja338:4.1": "<p><span class='verse-line'>{}</span>", "ja338:4.2": "<span class='verse-line'>{}</span>", "ja338:4.3": "<span class='verse-line'>{}</span>", "ja338:4.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja338:5.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja338:0.1": "Jātaka ", "ja338:0.2": "Catukkanipāta ", "ja338:0.3": "Kokilavagga ", "ja338:0.4": "8. Thusajātaka ", "ja338:1.1": "“Viditaṁ thusaṁ undurānaṁ, ", "ja338:1.2": "Viditaṁ pana taṇḍulaṁ; ", "ja338:1.3": "Thusaṁ thusaṁ vivajjetvā, ", "ja338:1.4": "Taṇḍulaṁ pana khādare. ", "ja338:2.1": "Yā mantanā araññasmiṁ, ", "ja338:2.2": "yā ca gāme nikaṇṇikā; ", "ja338:2.3": "Yañcetaṁ iti cīti ca, ", "ja338:2.4": "etampi viditaṁ mayā. ", "ja338:3.1": "Dhammena kira jātassa, ", "ja338:3.2": "pitā puttassa makkaṭo; ", "ja338:3.3": "Daharasseva santassa, ", "ja338:3.4": "dantehi phalamacchidā. ", "ja338:4.1": "Yametaṁ parisappasi, ", "ja338:4.2": "ajakāṇova sāsape; ", "ja338:4.3": "Yopāyaṁ heṭṭhato seti, ", "ja338:4.4": "etampi viditaṁ mayā”ti. ", "ja338:5.1": "Thusajātakaṁ aṭṭhamaṁ. "}, "variant_text": {"ja338:0.1": "", "ja338:0.2": "", "ja338:0.3": "", "ja338:0.4": "", "ja338:1.1": "undurānaṁ → undūrānaṁ (mr) ", "ja338:1.2": "", "ja338:1.3": "Thusaṁ thusaṁ → thusaṁ thūlaṁ (bj) ", "ja338:1.4": "", "ja338:2.1": "", "ja338:2.2": "", "ja338:2.3": "", "ja338:2.4": "", "ja338:3.1": "", "ja338:3.2": "", "ja338:3.3": "", "ja338:3.4": "", "ja338:4.1": "parisappasi → parisabbesi (mr) ", "ja338:4.2": "", "ja338:4.3": "seti → sesi (bj) ", "ja338:4.4": "", "ja338:5.1": ""}, "reference_text": {"ja338:0.1": "", "ja338:0.2": "", "ja338:0.3": "", "ja338:0.4": "", "ja338:1.1": "dr27.154, ms22J_1074, msdiv149, ndp22.104, pts-vp-pli3.123", "ja338:1.2": "", "ja338:1.3": "", "ja338:1.4": "", "ja338:2.1": "ms22J_1075, msdiv150, pts-vp-pli3.124", "ja338:2.2": "", "ja338:2.3": "", "ja338:2.4": "", "ja338:3.1": "ms22J_1076, msdiv151", "ja338:3.2": "", "ja338:3.3": "", "ja338:3.4": "", "ja338:4.1": "ms22J_1077, msdiv152, pts-vp-pli3.125", "ja338:4.2": "", "ja338:4.3": "", "ja338:4.4": "", "ja338:5.1": "ms22J_1078"}, "keys_order": ["ja338:0.1", "ja338:0.2", "ja338:0.3", "ja338:0.4", "ja338:1.1", "ja338:1.2", "ja338:1.3", "ja338:1.4", "ja338:2.1", "ja338:2.2", "ja338:2.3", "ja338:2.4", "ja338:3.1", "ja338:3.2", "ja338:3.3", "ja338:3.4", "ja338:4.1", "ja338:4.2", "ja338:4.3", "ja338:4.4", "ja338:5.1"]}