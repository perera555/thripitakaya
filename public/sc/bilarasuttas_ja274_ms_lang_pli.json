{"html_text": {"ja274:0.1": "<article id='ja274'><header><ul><li class='division'>{}</li>", "ja274:0.2": "<li>{}</li>", "ja274:0.3": "<li>{}</li></ul>", "ja274:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja274:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja274:1.2": "<span class='verse-line'>{}</span>", "ja274:1.3": "<span class='verse-line'>{}</span>", "ja274:1.4": "<span class='verse-line'>{}</span></p>", "ja274:2.1": "<p><span class='verse-line'>{}</span>", "ja274:2.2": "<span class='verse-line'>{}</span>", "ja274:2.3": "<span class='verse-line'>{}</span>", "ja274:2.4": "<span class='verse-line'>{}</span></p>", "ja274:3.1": "<p><span class='verse-line'>{}</span>", "ja274:3.2": "<span class='verse-line'>{}</span>", "ja274:3.3": "<span class='verse-line'>{}</span>", "ja274:3.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja274:4.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja274:0.1": "Jātaka ", "ja274:0.2": "Tikanipāta ", "ja274:0.3": "Udapānavagga ", "ja274:0.4": "4. Lolajātaka ", "ja274:1.1": "“Kāyaṁ balākā sikhinī, ", "ja274:1.2": "corī laṅghipitāmahā; ", "ja274:1.3": "Oraṁ balāke āgaccha, ", "ja274:1.4": "caṇḍo me vāyaso sakhā”. ", "ja274:2.1": "“Nāhaṁ balākā sikhinī, ", "ja274:2.2": "ahaṁ lolosmi vāyaso; ", "ja274:2.3": "Akatvā vacanaṁ tuyhaṁ, ", "ja274:2.4": "passa lūnosmi āgato”. ", "ja274:3.1": "“Punapāpajjasī samma, ", "ja274:3.2": "sīlañhi tava tādisaṁ; ", "ja274:3.3": "Na hi mānusakā bhogā, ", "ja274:3.4": "subhuñjā honti pakkhinā”ti. ", "ja274:4.1": "Lolajātakaṁ catutthaṁ. "}, "reference_text": {"ja274:0.1": "", "ja274:0.2": "", "ja274:0.3": "", "ja274:0.4": "", "ja274:1.1": "bj30.140, ms22J_766, msdiv70, pts-vp-pli2.363, sya27.112", "ja274:1.2": "", "ja274:1.3": "", "ja274:1.4": "", "ja274:2.1": "ms22J_767, msdiv71, ndp22.75, pts-vp-pli2.364", "ja274:2.2": "", "ja274:2.3": "", "ja274:2.4": "", "ja274:3.1": "csp1ed22.81, csp2ed22.81, ms22J_768, msdiv72", "ja274:3.2": "", "ja274:3.3": "", "