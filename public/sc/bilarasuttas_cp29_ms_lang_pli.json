{"html_text": {"cp29:0.1": "<article id='cp29'><header><ul><li class='division'>{}</li>", "cp29:0.2": "<li>{}</li>", "cp29:0.3": "<li>{}</li></ul>", "cp29:0.4": "<h1 class='sutta-title'>{}</h1></header>", "cp29:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "cp29:1.2": "<span class='verse-line'>{}</span>", "cp29:1.3": "<span class='verse-line'>{}</span>", "cp29:1.4": "<span class='verse-line'>{}</span></p>", "cp29:2.1": "<p><span class='verse-line'>{}</span>", "cp29:2.2": "<span class='verse-line'>{}</span>", "cp29:2.3": "<span class='verse-line'>{}</span>", "cp29:2.4": "<span class='verse-line'>{}</span></p>", "cp29:3.1": "<p><span class='verse-line'>{}</span>", "cp29:3.2": "<span class='verse-line'>{}</span>", "cp29:3.3": "<span class='verse-line'>{}</span>", "cp29:3.4": "<span class='verse-line'>{}</span></p>", "cp29:4.1": "<p><span class='verse-line'>{}</span>", "cp29:4.2": "<span class='verse-line'>{}</span>", "cp29:4.3": "<span class='verse-line'>{}</span>", "cp29:4.4": "<span class='verse-line'>{}</span></p>", "cp29:5.1": "<p><span class='verse-line'>{}</span>", "cp29:5.2": "<span class='verse-line'>{}</span>", "cp29:5.3": "<span class='verse-line'>{}</span>", "cp29:5.4": "<span class='verse-line'>{}</span></p>", "cp29:6.1": "<p><span class='verse-line'>{}</span>", "cp29:6.2": "<span class='verse-line'>{}</span>", "cp29:6.3": "<span class='verse-line'>{}</span>", "cp29:6.4": "<span class='verse-line'>{}</span></p>", "cp29:7.1": "<p><span class='verse-line'>{}</span>", "cp29:7.2": "<span class='verse-line'>{}</span>", "cp29:7.3": "<span class='verse-line'>{}</span>", "cp29:7.4": "<span class='verse-line'>{}</span></p>", "cp29:8.1": "<p><span class='verse-line'>{}</span>", "cp29:8.2": "<span class='verse-line'>{}</span>", "cp29:8.3": "<span class='verse-line'>{}</span>", "cp29:8.4": "<span class='verse-line'>{}</span></p>", "cp29:9.1": "<p><span class='verse-line'>{}</span>", "cp29:9.2": "<span class='verse-line'>{}</span>", "cp29:9.3": "<span class='verse-line'>{}</span>", "cp29:9.4": "<span class='verse-line'>{}</span></p>", "cp29:10.1": "<p><span class='verse-line'>{}</span>", "cp29:10.2": "<span class='verse-line'>{}</span>", "cp29:10.3": "<span class='verse-line'>{}</span>", "cp29:10.4": "<span class='verse-line'>{}</span></p>", "cp29:11.1": "<p><span class='verse-line'>{}</span>", "cp29:11.2": "<span class='verse-line'>{}</span>", "cp29:11.3": "<span class='verse-line'>{}</span>", "cp29:11.4": "<span class='verse-line'>{}</span>", "cp29:11.5": "<span class='verse-line'>{}</span>", "cp29:11.6": "<span class='verse-line'>{}</span></p></blockquote>", "cp29:12.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"cp29:0.1": "Cariyāpiṭaka ", "cp29:0.2": "Yudhañjayavagga ", "cp29:0.3": "Saccapāramī 3 ", "cp29:0.4": "Vaṭṭapotakacariya ", "cp29:1.1": "“Punāparaṁ yadā homi, ", "cp29:1.2": "magadhe vaṭṭapotako; ", "cp29:1.3": "Ajātapakkho taruṇo, ", "cp29:1.4": "maṁsapesi kulāvake. ", "cp29:2.1": "Mukhatuṇḍakenāharitvā, ", "cp29:2.2": "mātā posayatī mamaṁ; ", "cp29:2.3": "Tassā phassena jīvāmi, ", "cp29:2.4": "natthi me kāyikaṁ balaṁ. ", "cp29:3.1": "Saṁvacchare gimhasamaye, ", "cp29:3.2": "davaḍāho padippati; ", "cp29:3.3": "Upagacchati amhākaṁ, ", "cp29:3.4": "pāvako kaṇhavattanī. ", "cp29:4.1": "Dhamadhamāiti evaṁ, ", "cp29:4.2": "saddāyanto mahāsikhī; ", "cp29:4.3": "Anupubbena jhāpento, ", "cp29:4.4": "aggi mamamupāgami. ", "cp29:5.1": "Aggivegabhayātītā, ", "cp29:5.2": "tasitā mātāpitā mama; ", "cp29:5.3": "Kulāvake maṁ chaḍḍetvā, ", "cp29:5.4": "attānaṁ parimocayuṁ. ", "cp29:6.1": "Pāde pakkhe pajahāmi, ", "cp29:6.2": "natthi me kāyikaṁ balaṁ; ", "cp29:6.3": "Sohaṁ agatiko tattha, ", "cp29:6.4": "evaṁ cintesahaṁ tadā. ", "cp29:7.1": "‘Yesāhaṁ upadhāveyyaṁ, ", "cp29:7.2": "bhīto tasitavedhito; ", "cp29:7.3": "Te maṁ ohāya pakkantā, ", "cp29:7.4": "kathaṁ me ajja kātave. ", "cp29:8.1": "Atthi loke sīlaguṇo, ", "cp29:8.2": "saccaṁ soceyyanuddayā; ", "cp29:8.3": "Tena saccena kāhāmi, ", "cp29:8.4": "saccakiriyamuttamaṁ. ", "cp29:9.1": "Āvejjetvā dhammabalaṁ, ", "cp29:9.2": "saritvā pubbake jine; ", "cp29:9.3": "Saccabalamavassāya, ", "cp29:9.4": "saccakiriyamakāsahaṁ. ", "cp29:10.1": "Santi pakkhā apatanā, ", "cp29:10.2": "santi pādā avañcanā; ", "cp29:10.3": "Mātāpitā ca nikkhantā, ", "cp29:10.4": "jātaveda paṭikkama’. ", "cp29:11.1": "Sahasacce kate mayhaṁ, ", "cp29:11.2": "Mahāpajjalito sikhī; ", "cp29:11.3": "Vajjesi soḷasakarīsāni, ", "cp29:11.4": "Udakaṁ patvā yathā sikhī; ", "cp29:11.5": "Saccena me samo natthi, ", "cp29:11.6": "Esā me saccapāramī”ti. ", "cp29:12.1": "Vaṭṭapotakacariyaṁ navamaṁ. "}, "variant_text": {"cp29:0.1": "", "cp29:0.2": "", "cp29:0.3": "", "cp29:0.4": "", "cp29:1.1": "", "cp29:1.2": "", "cp29:1.3": "", "cp29:1.4": "", "cp29:2.1": "Mukhatuṇḍakenāharitvā → mukhatuṇḍenāharitvā (bj); mukhatuṇḍakena āharitvā (sya1ed, sya2ed) ", "cp29:2.2": "", "cp29:2.3": "", "cp29:2.4": "", "cp29:3.1": "", "cp29:3.2": "davaḍāho → davadāho (sya1ed, sya2ed); vanadāho (mr) ", "cp29:3.3": "", "cp29:3.4": "", "cp29:4.1": "", "cp29:4.2": "", "cp29:4.3": "", "cp29:4.4": "", "cp29:5.1": "", "cp29:5.2": "", "cp29:5.3": "", "cp29:5.4": "", "cp29:6.1": "", "cp29:6.2": "", "cp29:6.3": "", "cp29:6.4": "", "cp29:7.1": "", "cp29:7.2": "", "cp29:7.3": "", "cp29:7.4": "", "cp29:8.1": "", "cp29:8.2": "", "cp29:8.3": "", "cp29:8.4": "", "cp29:9.1": "", "cp29:9.2": "", "cp29:9.3": "", "cp29:9.4": "", "cp29:10.1": "", "cp29:10.2": "", "cp29:10.3": "", "cp29:10.4": "", "cp29:11.1": "", "cp29:11.2": "", "cp29:11.3": "", "cp29:11.4": "", "cp29:11.5": "", "cp29:11.6": "", "cp29:12.1": "Vaṭṭapotakacariyaṁ → vaṭṭakapotakacariyaṁ (sya1ed, sya2ed) "}, "reference_text": {"cp29:0.1": "", "cp29:0.2": "", "cp29:0.3": "", "cp29:0.4": "", "cp29:1.1": "ms21Cp_348, msdiv72, pts-vp-pli1ed98, pts-vp-pli2ed31, sya33.588, vri58.401", "cp29:1.2": "", "cp29:1.3": "", "cp29:1.4": "", "cp29:2.1": "ms21Cp_349, msdiv73", "cp29:2.2": "", "cp29:2.3": "", "cp29:2.4": "", "cp29:3.1": "bj38.31