{"html_text": {"ja182:0.1": "<article id='ja182'><header><ul><li class='division'>{}</li>", "ja182:0.2": "<li>{}</li>", "ja182:0.3": "<li>{}</li></ul>", "ja182:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja182:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja182:1.2": "<span class='verse-line'>{}</span>", "ja182:1.3": "<span class='verse-line'>{}</span>", "ja182:1.4": "<span class='verse-line'>{}</span></p>", "ja182:2.1": "<p><span class='verse-line'>{}</span>", "ja182:2.2": "<span class='verse-line'>{}</span>", "ja182:2.3": "<span class='verse-line'>{}</span>", "ja182:2.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja182:3.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja182:0.1": "Jātaka ", "ja182:0.2": "Dukanipāta ", "ja182:0.3": "Asadisavagga ", "ja182:0.4": "2. Saṅgāmāvacarajātaka ", "ja182:1.1": "“Saṅgāmāvacaro sūro, ", "ja182:1.2": "balavā iti vissuto; ", "ja182:1.3": "Kiṁ nu toraṇamāsajja, ", "ja182:1.4": "paṭikkamasi kuñjara. ", "ja182:2.1": "Omadda khippaṁ palighaṁ, ", "ja182:2.2": "esikāni ca abbaha; ", "ja182:2.3": "Toraṇāni ca madditvā, ", "ja182:2.4": "khippaṁ pavisa kuñjarā”ti. ", "ja182:3.1": "Saṅgāmāvacarajātakaṁ dutiyaṁ. "}, "variant_text": {"ja182:0.1": "", "ja182:0.2": "", "ja182:0.3": "", "ja182:0.4": "", "ja182:1.1": "", "ja182:1.2": "", "ja182:1.3": "", "ja182:1.4": "", "ja182:2.1": "", "ja182:2.2": "abbaha → ubbaha (sya1ed, sya2ed); abbhuha (mr) ", "ja182:2.3": "", "ja182:2.4": "", "ja182:3.1": ""}, "reference_text": {"ja182:0.1": "", "ja182:0.2": "", "ja182:0.3": "", "ja182:0.4": "", "ja182:1.1": "csp1ed22.47, csp2ed22.47, ms22J_441, msdiv63, ndp22.44, pts-vp-pli2.95, sya27.65, vri68.43", "ja182:1.2": "", "ja182:1.3": "", "ja182:1.4": "", "ja182:2.1": "ms22J_442, msdiv64", "ja182:2.2": "", "ja182:2.3": "", "ja182:2.4": "", "ja182:3.1": "ms22J_443"}, "keys_order": ["ja182:0.1", "ja182:0.2", "ja182:0.3", "ja182:0.4", "ja182:1.1", "ja182:1.2", "ja182:1.3", "ja182:1.4", "ja182:2.1", "j