{"html_text": {"ja243:0.1": "<article id='ja243'><header><ul><li class='division'>{}</li>", "ja243:0.2": "<li>{}</li>", "ja243:0.3": "<li>{}</li></ul>", "ja243:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja243:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja243:1.2": "<span class='verse-line'>{}</span>", "ja243:1.3": "<span class='verse-line'>{}</span>", "ja243:1.4": "<span class='verse-line'>{}</span></p>", "ja243:2.1": "<p><span class='verse-line'>{}</span>", "ja243:2.2": "<span class='verse-line'>{}</span>", "ja243:2.3": "<span class='verse-line'>{}</span>", "ja243:2.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja243:3.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja243:0.1": "Jātaka ", "ja243:0.2": "Dukanipāta ", "ja243:0.3": "Siṅgālavagga ", "ja243:0.4": "3. Guttilajātaka ", "ja243:1.1": "“Sattatantiṁ sumadhuraṁ, ", "ja243:1.2": "rāmaṇeyyaṁ avācayiṁ; ", "ja243:1.3": "So maṁ raṅgamhi avheti, ", "ja243:1.4": "saraṇaṁ me hohi kosiya”. ", "ja243:2.1": "“Ahaṁ taṁ saraṇaṁ samma, ", "ja243:2.2": "Ahamācariyapūjako; ", "ja243:2.3": "Na taṁ jayissati sisso, ", "ja243:2.4": "Sissamācariya jessasī”ti. ", "ja243:3.1": "Guttilajātakaṁ tatiyaṁ. "}, "variant_text": {"ja243:0.1": "", "ja243:0.2": "", "ja243:0.3": "", "ja243:0.4": "", "ja243:1.1": "", "ja243:1.2": "", "ja243:1.3": "", "ja243:1.4": "", "ja243:2.1": "Ahaṁ taṁ saraṇaṁ samma → ahaṁ te saraṇaṁ homi (vv33:2 [Guttilavimānavatthu/ Vatthuttamadāyikāvimānavatthu]) ", "ja243:2.2": "", "ja243:2.3": "", "ja243:2.4": "", "ja243:3.1": ""}, "reference_text": {"ja243:0.1": "", "ja243:0.2": "", "ja243:0.3": "", "ja243:0.4": "", "ja243:1.1": "ms22J_641, msdiv186, pts-vp-pli2.252", "ja243:1.2": "", "ja243:1.3": "", "ja243:1.4": "", "ja243:2.1": "ms22J_642, msdiv187", "ja243:2.2": "", "ja243:2.3": "", "ja243:2.4": "", "ja243:3.1": "ms22J_643"}, "keys_order": ["ja243:0.1", "ja243:0.2", "ja243:0.3", "ja243:0.4", "ja243:1.1", "ja243:1.2", "ja243:1.3", "ja243:1.4", "ja243: