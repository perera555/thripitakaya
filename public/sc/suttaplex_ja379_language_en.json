[{"acronym": "Ja 379", "alt_acronym": null, "volpages": "PTS 3.247, PTS 3.248", "alt_volpages": null, "uid": "ja379", "blurb": "“Ravens and crows”—The Master told this tale in Jetavana concerning a certain Brother. The story is that he got the forms of meditation from the Master and then went to a frontier village. There the people, pleased with his deportment, fed him, built him a hut in the wood, and exacting a promise, made him live there, and gave him great honour. But they forsook him for the teachers of the permanence of matter, afterwards forsaking those for the sect who deny immortality, and those again for the sect of naked ascetics: for teachers of all these sects came among them in turn. ", "difficulty": null, "original_title": "Nerujātaka", "root_lang": "pli", "root_lang_name": "Pāli", "type": "leaf", "translated_title": "Neru Jātaka", "translations": [{"lang": "pli", "lang_name": "Pāli", "is_root": true, "author": "Mahāsaṅgīti Tipiṭaka Buddhavasse 2500", "author_short": "ms", "author_uid": "ms", "publication_date": null, "id": "ja379_root-pli-ms", "segmented": true, "title": null, "volpage": null, "has_comment": false}, {"lang": "de", "lang_name": "Deutsch", "is_root": false, "author": "Dr. Julius Dutoit", "author_short": "Dutoit", "author_uid": "dutoit", "publication_date": "2007", "id": "de_ja379_dutoit", "segmented": false, "volpage": null, "has_comment": false}, {"author": "H.T. Francis, R.A. Neil", "author_short": "Francis …", "author_uid": "francis-neil", "has_comment": false, "id": "en_ja379_francis-neil", "is_root": false, "lang": "en", "lang_name": "English", "publication_date": "1897", "segmented": false, "volpage": null, "title": "Neru Jātaka"}, {"lang": "jpn", "lang_name": "日本語", "is_root": false, "author": "関西パーリ語実習会", "author_short": "関西パーリ語実習会", "author_uid": "kansai", "publication_date": "2023", "id": "jpn_ja379_kansai", "segmented": false, "volpage": null, "has_comment": false}, {"lang": "si", "lang_name": "සිංහල", "is_root": false, "au