{"html_text": {"ja307:0.1": "<article id='ja307'><header><ul><li class='division'>{}</li>", "ja307:0.2": "<li>{}</li>", "ja307:0.3": "<li>{}</li></ul>", "ja307:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja307:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja307:1.2": "<span class='verse-line'>{}</span>", "ja307:1.3": "<span class='verse-line'>{}</span>", "ja307:1.4": "<span class='verse-line'>{}</span></p>", "ja307:2.1": "<p><span class='verse-line'>{}</span>", "ja307:2.2": "<span class='verse-line'>{}</span>", "ja307:2.3": "<span class='verse-line'>{}</span>", "ja307:2.4": "<span class='verse-line'>{}</span></p>", "ja307:3.1": "<p><span class='verse-line'>{}</span>", "ja307:3.2": "<span class='verse-line'>{}</span>", "ja307:3.3": "<span class='verse-line'>{}</span>", "ja307:3.4": "<span class='verse-line'>{}</span></p>", "ja307:4.1": "<p><span class='verse-line'>{}</span>", "ja307:4.2": "<span class='verse-line'>{}</span>", "ja307:4.3": "<span class='verse-line'>{}</span>", "ja307:4.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja307:5.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja307:0.1": "Jātaka ", "ja307:0.2": "Catukkanipāta ", "ja307:0.3": "Kāliṅgavagga ", "ja307:0.4": "7. Palāsajātaka ", "ja307:1.1": "“Acetanaṁ brāhmaṇa assuṇantaṁ, ", "ja307:1.2": "Jāno ajānantamimaṁ palāsaṁ; ", "ja307:1.3": "Āraddhaviriyo dhuvaṁ appamatto, ", "ja307:1.4": "Sukhaseyyaṁ pucchasi kissa hetu”. ", "ja307:2.1": "“Dūre suto ceva brahā ca rukkho, ", "ja307:2.2": "Dese ṭhito bhūtanivāsarūpo; ", "ja307:2.3": "Tasmā namassāmi imaṁ palāsaṁ, ", "ja307:2.4": "Ye cettha bhūtā te dhanassa hetu”. ", "ja307:3.1": "“So te karissāmi yathānubhāvaṁ, ", "ja307:3.2": "Kataññutaṁ brāhmaṇa pekkhamāno; ", "ja307:3.3": "Kathañhi āgamma sataṁ sakāse, ", "ja307:3.4": "Moghāni te assu pariphanditāni. ", "ja307:4.1": "Yo tindukarukkhassa paro pilakkho, ", "ja307:4.2": "Parivārito pubbayañño uḷāro; ", "ja307:4.3": "Tassesa mūlasmiṁ nidhi nikhāto, ", "ja307:4.4": "Adāyādo gaccha taṁ uddharāhī”ti. ", "ja307:5.1": "Palāsajātakaṁ sattamaṁ. "}, "variant_text": {"ja307:0.1": "", "ja307:0.2": "", "ja307:0.3": "", "ja307:0.4": "", "ja307:1.1": "", "ja307:1.2": "", "ja307:1.3": "", "ja307:1.4": "", "ja307:2.1": "", "ja307:2.2": "", "ja307:2.3": "", "ja307:2.4": "te → te ca (bj, pts-vp-pli1) ", "ja307:3.1": "", "ja307:3.2": "", "ja307:3.3": "", "ja307:3.4": "", "ja307:4.1": "paro → puro (mr) | pilakkho → pilakkhu (bj, pts-vp-pli1); milakkhu (mr) ", "ja307:4.2": "", "ja307:4.3": "", "ja307:4.4": "", "ja307:5.1": ""}, "reference_text": {"ja307:0.1": "", "ja307:0.2": "", "ja307:0.3": "", "ja307:0.4": "", "ja307:1.1": "ms22J_913, msdiv25, pts-vp-pli3.24, sya27.133", "ja307:1.2": "", "ja307:1.3": "", "ja307:1.4": "", "ja307:2.1": "dr27.133, ms22J_914, msdiv26", "ja307:2.2": "", "ja307:2.3": "", "ja307:2.4": "", "ja307:3.1": "ms22J_915, msdiv27", "ja307:3.2": "", "ja307:3.3": "", "ja307:3.4": "", "ja307:4.1": "csp1ed22.97, csp2ed22.97, ms22J_916, msdiv28", "ja307:4.2": "", "ja307:4.3": "", "ja307:4.4": "", "ja307:5.1": "ms22J_917"}, "keys_order": ["ja307:0.1", "ja307:0.2", "ja307:0.3", "ja307:0.4", "ja307:1.1", "ja307:1.2", "ja307:1.3", "ja307:1.4", "ja307:2.1", "ja307:2.2", "ja307:2.3", "ja307:2.4", "ja307:3.1", "ja307:3.2", "ja307:3.3", "ja307:3.4", "ja307:4.1", "ja307:4.2", "ja307:4.3", "ja307:4.4", "ja307:5.1"]}