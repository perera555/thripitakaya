[{"acronym": "Ja 484", "alt_acronym": null, "volpages": "PTS 4.278, PTS 4.279, PTS 4.280, PTS 4.281, PTS 4.282", "alt_volpages": null, "uid": "ja484", "blurb": "“The crop of rice”—This was a story the Master told while dwelling at Jetavana, about a Brother who supported his mother. The occasion will be explained in the Sama Birth. Then the Master sent for this Brother, and asked him, “Is what I hear true, Brother, that you support lay folks?” “It is true, Sir.” “Who are they?” “My mother and father, Sir.” Said the Master, “Well done, Brother! Wise men of old, even when embodied as the lower animals, having been born as parrots even, when their parents grew old laid them in a nest and fed them with food which they brought in their own beaks.” So saying, he told a story of the past.", "difficulty": null, "original_title": "Sālikedārajātaka", "root_lang": "pli", "root_lang_name": "Pāli", "type": "leaf", "translated_title": "Salikedara Jātaka", "translations": [{"lang": "pli", "lang_name": "Pāli", "is_root": true, "author": "Mahāsaṅgīti Tipiṭaka Buddhavasse 2500", "author_short": "ms", "author_uid": "ms", "publication_date": null, "id": "ja484_root-pli-ms", "segmented": true, "title": null, "volpage": null, "has_comment": false}, {"lang": "de", "lang_name": "Deutsch", "is_root": false, "author": "Dr. Julius Dutoit", "author_short": "Dutoit", "author_uid": "dutoit", "publication_date": "2007", "id": "de_ja484_dutoit", "segmented": false, "volpage": null, "has_comment": false}, {"author": "W.H.D. Rouse", "author_short": "Rouse", "author_uid": "rouse", "has_comment": false, "id": "en_ja484_rouse", "is_root": false, "lang": "en", "lang_name": "English", "publication_date": "1905", "segmented": false, "volpage": null, "title": "Salikedara Jātaka"}, {"lang": "jpn", "lang_name": "日本語", "is_root": false, "author": "関西パーリ語実習会", "author_short": "関西パーリ語実習会", "author_uid": "kansai", "publication_date": "2023", "id": "jpn_ja484_kansai", "segmented": false, "volpage": null, "has_comm