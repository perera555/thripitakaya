{"html_text": {"ja370:0.1": "<article id='ja370'><header><ul><li class='division'>{}</li>", "ja370:0.2": "<li>{}</li>", "ja370:0.3": "<li>{}</li></ul>", "ja370:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja370:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja370:1.2": "<span class='verse-line'>{}</span>", "ja370:1.3": "<span class='verse-line'>{}</span>", "ja370:1.4": "<span class='verse-line'>{}</span></p>", "ja370:2.1": "<p><span class='verse-line'>{}</span>", "ja370:2.2": "<span class='verse-line'>{}</span>", "ja370:2.3": "<span class='verse-line'>{}</span>", "ja370:2.4": "<span class='verse-line'>{}</span></p>", "ja370:3.1": "<p><span class='verse-line'>{}</span>", "ja370:3.2": "<span class='verse-line'>{}</span>", "ja370:3.3": "<span class='verse-line'>{}</span>", "ja370:3.4": "<span class='verse-line'>{}</span></p>", "ja370:4.1": "<p><span class='verse-line'>{}</span>", "ja370:4.2": "<span class='verse-line'>{}</span>", "ja370:4.3": "<span class='verse-line'>{}</span>", "ja370:4.4": "<span class='verse-line'>{}</span></p>", "ja370:5.1": "<p><span class='verse-line'>{}</span>", "ja370:5.2": "<span class='verse-line'>{}</span>", "ja370:5.3": "<span class='verse-line'>{}</span>", "ja370:5.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja370:6.1": "<p class='endsutta'>{}</p>", "ja370:6.2": "<p class='endvagga'>{}</p></article>"}, "root_text": {"ja370:0.1": "Jātaka ", "ja370:0.2": "Pañcakanipāta ", "ja370:0.3": "Vaṇṇārohavagga ", "ja370:0.4": "10. Palāsajātaka ", "ja370:1.1": "“Haṁso palāsamavaca, ", "ja370:1.2": "nigrodho samma jāyati; ", "ja370:1.3": "Aṅkasmiṁ te nisinnova, ", "ja370:1.4": "so te mammāni checchati”. ", "ja370:2.1": "“Vaḍḍhatāmeva nigrodho, ", "ja370:2.2": "patiṭṭhassa bhavāmahaṁ; ", "ja370:2.3": "Yathā pitā ca mātā ca, ", "ja370:2.4": "evaṁ me so bhavissati”. ", "ja370:3.1": "“Yaṁ tvaṁ aṅkasmiṁ vaḍḍhesi, ", "ja370:3.2": "khīrarukkhaṁ bhayānakaṁ; ", "ja370:3.3": "Āmanta kho taṁ gacchāma, ", "ja370:3.4": "vuḍḍhi massa na ruccati”. ", "ja370:4.1": "“Idāni kho maṁ bhāyeti, ", "ja370:4.2": "mahānerunidassanaṁ; ", "ja370:4.3": "Haṁsassa anabhiññāya, ", "ja370:4.4": "mahā me bhayamāgataṁ”. ", "ja370:5.1": "“Na tassa vuḍḍhi kusalappasatthā, ", "ja370:5.2": "Yo vaḍḍhamāno ghasate patiṭṭhaṁ; ", "ja370:5.3": "Tassūparodhaṁ parisaṅkamāno, ", "ja370:5.4": "Patārayī mūlavadhāya dhīro”ti. ", "ja370:6.1": "Palāsajātakaṁ dasamaṁ. ", "ja370:6.2": "Vaṇṇārohavaggo dutiyo. "}, "variant_text": {"ja370:0.1": "", "ja370:0.2": "", "ja370:0.3": "", "ja370:0.4": "", "ja370:1.1": "", "ja370:1.2": "", "ja370:1.3": "Aṅkasmiṁ → aṅgasmiṁ (mr) ", "ja370:1.4": "checchati → chejjati (sya1ed, sya2ed); chijjati (mr) ", "ja370:2.1": "Vaḍḍhatāmeva → vaddhitameva (mr) ", "ja370:2.2": "", "ja370:2.3": "Yathā pitā ca mātā ca → pitā vā mātā vā (pts-vp-pli1); mātā vā pitā vā (mr) ", "ja370:2.4": "", "ja370:3.1": "", "ja370:3.2": "", "ja370:3.3": "", "ja370:3.4": "", "ja370:4.1": "", "ja370:4.2": "", "ja370:4.3": "", "ja370:4.4": "", "ja370:5.1": "", "ja370:5.2": "", "ja370:5.3": "", "ja370:5.4": "", "ja370:6.1": "", "ja370:6.2": "dutiyo → imassuddānaṁ tatiyavaggapariyosāne "}, "reference_text": {"ja370:0.1": "", "ja370:0.2": "", "ja370:0.3": "", "ja370:0.4": "", "ja370:1.1": "ms22J_1271, msdiv105, pts-vp-pli3.209", "ja370:1.2": "", "ja370:1.3": "", "ja370:1.4": "", "ja370:2.1": "ms22J_1272, msdiv106", "ja370:2.2": "", "ja370:2.3": "", "ja370:2.4": "", "ja370:3.1": "ms22J_1273, msdiv107, vri68.112", "ja370:3.2": "", "ja370:3.3": "", "ja370:3.4": "", "ja370:4.1": "csp1ed22.133, csp2ed22.133, ms22J_1274, msdiv108, ndp22.124, pts-vp-pli3.210", "ja370:4.2": "", "ja370:4.3": "", "ja370:4.4": "", "ja370:5.1": "ms22J_1275, msdiv109", "ja370:5.2": "", "ja370:5.3": "", "ja370:5.4": "", "ja370:6.1": "ms22J_1276", "ja370:6.2": ""}, "keys_order": ["ja370:0.1", "ja370:0.2", "ja370:0.3", "ja370:0.4", "ja370:1.1", "ja370:1.2", "ja370:1.3", "ja370:1.4", "ja370:2.1", "ja370:2.2", "ja370:2.3", "ja370:2.4", "ja370:3.1", "ja