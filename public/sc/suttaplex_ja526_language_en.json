[{"acronym": "Ja 526", "alt_acronym": null, "volpages": "PTS 5.194, PTS 5.195, PTS 5.196, PTS 5.197, PTS 5.198, PTS 5.199, PTS 5.200, PTS 5.201, PTS 5.202, PTS 5.203, PTS 5.204, PTS 5.205, PTS 5.207, PTS 5.208", "alt_volpages": null, "uid": "ja526", "blurb": "“Lo! the land”—This story the Master told while residing at Jetavana concerning the temptation of a Brother by the wife of his unregenerate days. And in telling the story he asked the Brother by whom he had been led astray. “By a former wife,” said he. “Verily, Brother,” the Master said, “she worketh mischief for you. Of old it was owing to her that you fell away from mystic meditation and were mightily destroyed.” And so saying he told a story of the past.", "difficulty": null, "original_title": "Niḷinikājātaka", "root_lang": "pli", "root_lang_name": "Pāli", "type": "leaf", "translated_title": "Nalinika Jātaka", "translations": [{"lang": "pli", "lang_name": "Pāli", "is_root": true, "author": "Mahāsaṅgīti Tipiṭaka Buddhavasse 2500", "author_short": "ms", "author_uid": "ms", "publication_date": null, "id": "ja526_root-pli-ms", "segmented": true, "title": null, "volpage": null, "has_comment": false}, {"lang": "de", "lang_name": "Deutsch", "is_root": false, "author": "Dr. Julius Dutoit", "author_short": "Dutoit", "author_uid": "dutoit", "publication_date": "2007", "id": "de_ja526_dutoit", "segmented": false, "volpage": null, "has_comment": false}, {"author": "H.T. Francis", "author_short": "Francis", "author_uid": "francis", "has_comment": false, "id": "en_ja526_francis", "is_root": false, "lang": "en", "lang_name": "English", "publication_date": "1905", "segmented": false, "volpage": null, "title": "Nalinika Jātaka"}, {"lang": "jpn", "lang_name": "日本語", "is_root": false, "author": "関西パーリ語実習会", "author_short": "関西パーリ語実習会", "author_uid": "kansai", "publication_date": "2023", "id": "jpn_ja526_kansai", "segmented": false, "volpage": null, "has_comment": false}, {"lang": "si", "lang_name": "සිංහල", "is_root": false, "