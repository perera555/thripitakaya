{"html_text": {"ja32:0.1": "<article id='ja32'><header><ul><li class='division'>{}</li>", "ja32:0.2": "<li>{}</li>", "ja32:0.3": "<li>{}</li></ul>", "ja32:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja32:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja32:1.2": "<span class='verse-line'>{}</span>", "ja32:1.3": "<span class='verse-line'>{}</span>", "ja32:1.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja32:2.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja32:0.1": "Jātaka ", "ja32:0.2": "Ekakanipāta ", "ja32:0.3": "Kulāvakavagga ", "ja32:0.4": "2. Naccajātaka ", "ja32:1.1": "“Rudaṁ manuññaṁ rucirā ca piṭṭhi, ", "ja32:1.2": "Veḷuriyavaṇṇūpanibhā ca gīvā; ", "ja32:1.3": "Byāmamattāni ca pekhuṇāni, ", "ja32:1.4": "Naccena te dhītaraṁ no dadāmī”ti. ", "ja32:2.1": "Naccajātakaṁ dutiyaṁ. "}, "variant_text": {"ja32:0.1": "", "ja32:0.2": "", "ja32:0.3": "", "ja32:0.4": "", "ja32:1.1": "", "ja32:1.2": "Veḷuriyavaṇṇūpanibhā → vaṇṇūpaṭibhā (sya1ed, sya2ed); vaṇṇasannibhā (mr) ", "ja32:1.3": "", "ja32:1.4": "", "ja32:2.1": ""}, "reference_text": {"ja32:0.1": "", "ja32:0.2": "", "ja32:0.3": "", "ja32:0.4": "", "ja32:1.1": "ms22J_70, msdiv32, ndp22.10, pts-vp-pli1.207", "ja32:1.2": "", "ja32:1.3": "", "ja32:1.4": "", "ja32:2.1": "ms22J_71"}, "keys_order": ["ja32:0.1", "ja32:0.2", "ja32:0.3", "ja32:0.4", "ja32:1.1", "ja32:1.2", "ja32:1.3", "ja32:1.4", "ja32:2.1"]}