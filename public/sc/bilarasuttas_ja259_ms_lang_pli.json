{"html_text": {"ja259:0.1": "<article id='ja259'><header><ul><li class='division'>{}</li>", "ja259:0.2": "<li>{}</li>", "ja259:0.3": "<li>{}</li></ul>", "ja259:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja259:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja259:1.2": "<span class='verse-line'>{}</span>", "ja259:1.3": "<span class='verse-line'>{}</span>", "ja259:1.4": "<span class='verse-line'>{}</span></p>", "ja259:2.1": "<p><span class='verse-line'>{}</span>", "ja259:2.2": "<span class='verse-line'>{}</span>", "ja259:2.3": "<span class='verse-line'>{}</span>", "ja259:2.4": "<span class='verse-line'>{}</span></p>", "ja259:3.1": "<p><span class='verse-line'>{}</span>", "ja259:3.2": "<span class='verse-line'>{}</span>", "ja259:3.3": "<span class='verse-line'>{}</span>", "ja259:3.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja259:4.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja259:0.1": "Jātaka ", "ja259:0.2": "Tikanipāta ", "ja259:0.3": "Saṅkappavagga ", "ja259:0.4": "9. Tirīṭavacchajātaka ", "ja259:1.1": "“Nayimassa vijjāmayamatthi kiñci, ", "ja259:1.2": "Na bandhavo no pana te sahāyo; ", "ja259:1.3": "Atha kena vaṇṇena tirīṭavaccho, ", "ja259:1.4": "Tedaṇḍiko bhuñjati aggapiṇḍaṁ”. ", "ja259:2.1": "“Āpāsu me yuddhaparājitassa, ", "ja259:2.2": "Ekassa katvā vivanasmi ghore; ", "ja259:2.3": "Pasārayī kicchagatassa pāṇiṁ, ", "ja259:2.4": "Tenūdatāriṁ dukhasampareto. ", "ja259:3.1": "Etassa kiccena idhānupatto, ", "ja259:3.2": "Vesāyino visayā jīvaloke; ", "ja259:3.3": "Lābhāraho tāta tirīṭavaccho, ", "ja259:3.4": "Dethassa bhogaṁ yajathañca yaññan”ti. ", "ja259:4.1": "Tirīṭavacchajātakaṁ navamaṁ. "}, "variant_text": {"ja259:0.1": "", "ja259:0.2": "", "ja259:0.3": "", "ja259:0.4": "", "ja259:1.1": "", "ja259:1.2": "", "ja259:1.3": "tirīṭavaccho → tirīṭivaccho (sya1ed, sya2ed, mr) ", "ja259:1.4": "", "ja259:2.1": "Āpāsu → āvāsu (mr) ", "ja259:2.2": "", "ja259:2.3": "", "ja259:2.4": "", "ja259:3.1": "", "ja259:3.2": "", "ja259:3.3": "", "ja259:3.4": "yajathañca → yajatañca (bj, pts-vp-pli1); yajitañca (sya1ed, sya2ed) ", "ja259:4.1": "Tirīṭavacchajātakaṁ → tiritivacchajātakaṁ (sya1ed, sya2ed) "}, "reference_text": {"ja259:0.1": "", "ja259:0.2": "", "ja259:0.3": "", "ja259:0.4": "", "ja259:1.1": "dr27.102, ms22J_702, msdiv25, ndp22.69, pts-vp-pli2.316", "ja259:1.2": "", "ja259:1.3": "", "ja259:1.4": "", "ja259:2.1": "bj30.130, ms22J_703, msdiv26, pts-vp-pli2.317", "ja259:2.2": "", "ja259:2.3": "", "ja259:2.4": "", "ja259:3.1": "ms22J_704, msdiv27, vri68.66", "ja259:3.2": "", "ja259:3.3": "", "ja259:3.4": "", "ja259:4.1": "ms22J_705"}, "keys_order": ["ja259:0.1", "ja259:0.2", "ja259:0.3", "ja259:0.4", "ja259:1.1", "ja259:1.2", "ja259:1.3", "ja259:1.4", "ja259:2.1", "ja259:2.2", "ja259:2.3", "ja259:2.4", "ja259:3.1", "ja259:3.2", "ja259:3.3", "ja259:3.4", "ja259:4.1"]}