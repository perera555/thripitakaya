{"html_text": {"kp9:0.1": "<article id='kp9'><header><ul><li class='division'>{}</li></ul>", "kp9:0.2": "<h1 class='sutta-title'>{}</h1></header>", "kp9:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "kp9:1.2": "<span class='verse-line'>{}</span>", "kp9:1.3": "<span class='verse-line'>{}</span>", "kp9:1.4": "<span class='verse-line'>{}</span></p>", "kp9:2.1": "<p><span class='verse-line'>{}</span>", "kp9:2.2": "<span class='verse-line'>{}</span>", "kp9:2.3": "<span class='verse-line'>{}</span>", "kp9:2.4": "<span class='verse-line'>{}</span></p>", "kp9:3.1": "<p><span class='verse-line'>{}</span>", "kp9:3.2": "<span class='verse-line'>{}</span>", "kp9:3.3": "<span class='verse-line'>{}</span>", "kp9:3.4": "<span class='verse-line'>{}</span></p>", "kp9:4.1": "<p><span class='verse-line'>{}</span>", "kp9:4.2": "<span class='verse-line'>{}</span>", "kp9:4.3": "<span class='verse-line'>{}</span>", "kp9:4.4": "<span class='verse-line'>{}</span></p>", "kp9:5.1": "<p><span class='verse-line'>{}</span>", "kp9:5.2": "<span class='verse-line'>{}</span>", "kp9:5.3": "<span class='verse-line'>{}</span>", "kp9:5.4": "<span class='verse-line'>{}</span></p>", "kp9:6.1": "<p><span class='verse-line'>{}</span>", "kp9:6.2": "<span class='verse-line'>{}</span>", "kp9:6.3": "<span class='verse-line'>{}</span>", "kp9:6.4": "<span class='verse-line'>{}</span></p>", "kp9:7.1": "<p><span class='verse-line'>{}</span>", "kp9:7.2": "<span class='verse-line'>{}</span>", "kp9:7.3": "<span class='verse-line'>{}</span>", "kp9:7.4": "<span class='verse-line'>{}</span></p>", "kp9:8.1": "<p><span class='verse-line'>{}</span>", "kp9:8.2": "<span class='verse-line'>{}</span>", "kp9:8.3": "<span class='verse-line'>{}</span>", "kp9:8.4": "<span class='verse-line'>{}</span></p>", "kp9:9.1": "<p><span class='verse-line'>{}</span>", "kp9:9.2": "<span class='verse-line'>{}</span>", "kp9:9.3": "<span class='verse-line'>{}</span>", "kp9:9.4": "<span class='verse-line'>{}</span></p>", "kp9:10.1": "<p><span class='verse-line'>{}</span>", "kp9:10.2": "<span class='verse-line'>{}</span>", "kp9:10.3": "<span class='verse-line'>{}</span>", "kp9:10.4": "<span class='verse-line'>{}</span></p></blockquote>", "kp9:11.1": "<p class='endsutta'>{}</p>", "kp9:12.1": "<p class='endbook'>{}</p></article>"}, "root_text": {"kp9:0.1": "Khuddakapāṭha 9 ", "kp9:0.2": "Mettasutta ", "kp9:1.1": "Karaṇīyamatthakusalena, ", "kp9:1.2": "Yanta santaṁ padaṁ abhisamecca; ", "kp9:1.3": "Sakko ujū ca suhujū ca, ", "kp9:1.4": "Sūvaco cassa mudu anatimānī. ", "kp9:2.1": "Santussako ca subharo ca, ", "kp9:2.2": "Appakicco ca sallahukavutti; ", "kp9:2.3": "Santindriyo ca nipako ca, ", "kp9:2.4": "Appagabbho kulesvananugiddho. ", "kp9:3.1": "Na ca khuddamācare kiñci, ", "kp9:3.2": "Yena viññū pare upavadeyyuṁ; ", "kp9:3.3": "Sukhino va khemino hontu, ", "kp9:3.4": "Sabbasattā bhavantu sukhitattā. ", "kp9:4.1": "Ye keci pāṇabhūtatthi, ", "kp9:4.2": "Tasā vā thāvarā vanavasesā; ", "kp9:4.3": "Dīghā vā ye va mahantā, ", "kp9:4.4": "Majjhimā rassakā aṇukathūlā. ", "kp9:5.1": "Diṭṭhā vā ye va adiṭṭhā, ", "kp9:5.2": "Ye va dūre vasanti avidūre; ", "kp9:5.3": "Bhūtā va sambhavesī va, ", "kp9:5.4": "Sabbasattā bhavantu sukhitattā. ", "kp9:6.1": "Na paro paraṁ nikubbetha, ", "kp9:6.2": "Nātimaññetha katthaci na kañci; ", "kp9:6.3": "Byārosanā paṭighasañña, ", "kp9:6.4": "Nāññamaññassa dukkhamiccheyya. ", "kp9:7.1": "Mātā yathā niyaṁ puttam ", "kp9:7.2": "Āyusā ekaputtamanurakkhe; ", "kp9:7.3": "Evampi sabbabhūtesu, ", "kp9:7.4": "Mānasaṁ bhāvaye aparimāṇaṁ. ", "kp9:8.1": "Mettañca sabbalokasmi, ", "kp9:8.2": "Mānasaṁ bhāvaye aparimāṇaṁ; ", "kp9:8.3": "Uddhaṁ adho ca tiriyañca, ", "kp9:8.4": "Asambādhaṁ averamasapattaṁ. ", "kp9:9.1": "Tiṭṭhaṁ caraṁ nisinno va, ", "kp9:9.2": "Sayāno yāvatāssa vitamiddho; ", "kp9:9.3": "Etaṁ satiṁ adhiṭṭheyya, ", "kp9:9.4": "Brahmametaṁ vihāramidhamāhu. ", "kp9:10.1": "Diṭṭhiñca anupaggamma, ", "kp9:10.2": "Sīlavā dassanena sampanno; ", "kp9:10.3": "Kāmesu vinaya gedhaṁ, ", "kp9:10.4": "Na hi jātuggabbhaseyya punaretīti. ", "kp9:11.1": "Mettasuttaṁ. ", "kp9:12.1": "Khuddakapāṭhapāḷi niṭṭhitā. "}, "reference_text": {"kp9:0.1": "", "kp9:0.2": "", "kp9:1.1": "cck25.12, ms18Kh_95, msdiv1, pts-vp-pli8", "kp9:1.2": "", "kp9:1.3": "", "kp9:1.4": "", "kp9:2.1": "csp1ed18.11, csp2ed18.11, ms18Kh_96, msdiv2, ndp20.12", "kp9:2.2": "", "kp9:2.3": "", "kp9:2.4": "", "kp9:3.1": "mc0.14, ms18Kh_97, msdiv3", "kp9:3.2": "", "kp9:3.3": "", "kp9:3.4": "", "kp9:4.1": "ms18Kh_98, msdiv4", "kp9:4.2": "", "kp9:4.3": "", "kp9:4.4": "", "kp9:5.1": "dr25.14, ms18Kh_99, msdiv5", "kp9:5.2": "", "kp9:5.3": "", "kp9:5.4": "", "kp9:6.1": "bj24.22, ms18Kh_100, msdiv6", "kp9:6.2": "", "kp9:6.3": "", "kp9:6.4": "", "kp9:7.1": "ms18Kh_101, msdiv7, vri47.12", "kp9:7.2": "", "kp9:7.3": "", "kp9:7.4": "", "kp9:8.1": "ms18Kh_102, msdiv8, sya25.14", "kp9:8.2": "", "kp9:8.3": "", "kp9:8.4": "", "kp9:9.1": "ms18Kh_103, msdiv9", "kp9:9.2": "", "kp9:9.3": "", "kp9:9.4": "", "kp9:10.1": "ms18Kh_104, msdiv10, pts-vp-pli9", "kp9:10.2": "", "kp9:10.3": "", "kp9:10.4": "", "kp9:11.1": "ms18Kh_105", "kp9:12.1": "ms18Kh_106"}, "keys_order": ["kp9:0.1", "kp9:0.2", "kp9:1.1", "kp9:1.2", "kp9:1.3", "kp9:1.4", "kp9:2.1", "kp9:2.2", "kp9:2.3", "kp9:2.4", "kp9:3.1", "kp9:3.2", "kp9:3.3", "kp9:3.4", "kp9:4.1", "kp9:4.2", "kp9:4.3", "kp9:4.4", "kp9:5.1", "kp9:5.2", "kp9:5.3", "kp9:5.4", "kp9:6.1", "kp9:6.2", "kp9:6.3", "kp9:6.4", "kp9:7.1", "kp9:7.2", "kp9:7.3", "kp9:7.4", "kp9:8.1", "kp9:8.2", "kp9:8.3", "kp9:8.4", "kp9:9.1", "kp9:9.2", "kp9:9.3", "kp9:9.4", "kp9:10.1", "kp9:10.2", "kp9:10.3", "kp9:10.4", "kp9:11.1", "kp9:12.1"]}