{"html_text": {"ja3:0.1": "<article id='ja3'><header><ul><li class='division'>{}</li>", "ja3:0.2": "<li>{}</li>", "ja3:0.3": "<li>{}</li></ul>", "ja3:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja3:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja3:1.2": "<span class='verse-line'>{}</span>", "ja3:1.3": "<span class='verse-line'>{}</span>", "ja3:1.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja3:2.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja3:0.1": "Jātaka ", "ja3:0.2": "Ekakanipāta ", "ja3:0.3": "Apaṇṇakavagga ", "ja3:0.4": "3. Serivavāṇijajātaka ", "ja3:1.1": "“Idha ce naṁ virādhesi, ", "ja3:1.2": "saddhammassa niyāmataṁ; ", "ja3:1.3": "Ciraṁ tvaṁ anutappesi, ", "ja3:1.4": "serivāyaṁva vāṇijo”ti. ", "ja3:2.1": "Serivavāṇijajātakaṁ tatiyaṁ. "}, "variant_text": {"ja3:0.1": "", "ja3:0.2": "", "ja3:0.3": "", "ja3:0.4": "", "ja3:1.1": "Idha ce naṁ → idha ce hi naṁ (bj, pts-vp-pli1) ", "ja3:1.2": "niyāmataṁ → niyāmakaṁ (sya1ed, sya2ed, mr) ", "ja3:1.3": "anutappesi → anutapessasi (bj, pts-vp-pli1); anutappissasi (?) ", "ja3:1.4": "", "ja3:2.1": "Serivavāṇijajātakaṁ → serivāvāṇijajātakaṁ (bj); serivāṇijajātakaṁ (pts-vp-pli1) "}, "reference_text": {"ja3:0.1": "", "ja3:0.2": "", "ja3:0.3": "", "ja3:0.4": "", "ja3:1.1": "csp1ed22.2, csp2ed22.2, dr27.2, ms22J_6, msdiv3, pts-vp-pli1.113, sya27.2", "ja3:1.2": "", "ja3:1.3": "", "ja3:1.4": "", "ja3:2.1": "ms22J_7"}, "keys_order": ["ja3:0.1", "ja3:0.2", "ja3:0.3", "ja3:0.4", "ja3:1.1", "ja3:1.2", "ja3:1.3", "ja3:1.4", "ja3:2.1"]}