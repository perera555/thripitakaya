[{"acronym": "Ja 150", "alt_acronym": null, "volpages": "PTS 1.511", "alt_volpages": null, "uid": "ja150", "blurb": "“Befriend a villain.”—This story was told by the Master when at the Bamboo-grove, about King Ajatasattu’s adherence to false teachers. For he believed in that rancorous foe of the Buddhas, the base and wicked Devadatta, and in his infatuation, wishing to do honour to Devadatta, expended a vast sum in erecting a monastery at Gayasisa. And following Devadatta’s wicked counsels, he slew the good and virtuous old King his father, who had entered on the Paths, thereby destroying his own chance of winning like goodness and virtue, and bringing great woe upon himself.", "difficulty": null, "original_title": "Sañjīvajātaka", "root_lang": "pli", "root_lang_name": "Pāli", "type": "leaf", "translated_title": "Sanjiva Jātaka", "translations": [{"lang": "pli", "lang_name": "Pāli", "is_root": true, "author": "Mahāsaṅgīti Tipiṭaka Buddhavasse 2500", "author_short": "ms", "author_uid": "ms", "publication_date": null, "id": "ja150_root-pli-ms", "segmented": true, "title": null, "volpage": null, "has_comment": false}, {"lang": "de", "lang_name": "Deutsch", "is_root": false, "author": "Dr. Julius Dutoit", "author_short": "Dutoit", "author_uid": "dutoit", "publication_date": "2007", "id": "de_ja150_dutoit", "segmented": false, "volpage": null, "has_comment": false}, {"author": "Robert Chalmers", "author_short": "Chalmers", "author_uid": "chalmers", "has_comment": false, "id": "en_ja150_chalmers", "is_root": false, "lang": "en", "lang_name": "English", "publication_date": "1895", "segmented": false, "volpage": null, "title": "Sanjiva Jātaka"}, {"lang": "jpn", "lang_name": "日本語", "is_root": false, "author": "関西パーリ語実習会", "author_short": "関西パーリ語実習会", "author_uid": "kansai", "publication_date": "2023", "id": "jpn_ja150_kansai", "segmented": false, "volpage": null, "has_comment": false}, {"lang": "si", "lang_name": "සිංහල", "is_root": false, "author": "A.P. de Zoysa", "author_