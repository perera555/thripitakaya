{"html_text": {"ja222:0.1": "<article id='ja222'><header><ul><li class='division'>{}</li>", "ja222:0.2": "<li>{}</li>", "ja222:0.3": "<li>{}</li></ul>", "ja222:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja222:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja222:1.2": "<span class='verse-line'>{}</span>", "ja222:1.3": "<span class='verse-line'>{}</span>", "ja222:1.4": "<span class='verse-line'>{}</span></p>", "ja222:2.1": "<p><span class='verse-line'>{}</span>", "ja222:2.2": "<span class='verse-line'>{}</span>", "ja222:2.3": "<span class='verse-line'>{}</span>", "ja222:2.4": "<span class='verse-line'>{}</span>", "ja222:2.5": "<span class='verse-line'>{}</span>", "ja222:2.6": "<span class='verse-line'>{}</span></p></blockquote>", "ja222:3.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja222:0.1": "Jātaka ", "ja222:0.2": "Dukanipāta ", "ja222:0.3": "Kāsāvavagga ", "ja222:0.4": "2. Cūḷanandiyajātaka ", "ja222:1.1": "“Idaṁ tadācariyavaco, ", "ja222:1.2": "pārāsariyo yadabravi; ", "ja222:1.3": "Māsu tvaṁ akari pāpaṁ, ", "ja222:1.4": "yaṁ tvaṁ pacchā kataṁ tape. ", "ja222:2.1": "Yāni karoti puriso, ", "ja222:2.2": "tāni attani passati; ", "ja222:2.3": "Kalyāṇakārī kalyāṇaṁ, ", "ja222:2.4": "pāpakārī ca pāpakaṁ; ", "ja222:2.5": "Yādisaṁ vapate bījaṁ, ", "ja222:2.6": "tādisaṁ harate phalan”ti. ", "ja222:3.1": "Cūḷanandiyajātakaṁ dutiyaṁ. "}, "variant_text": {"ja222:0.1": "", "ja222:0.2": "", "ja222:0.3": "", "ja222:0.4": "", "ja222:1.1": "", "ja222:1.2": "pārāsariyo yadabravi → pārāsariyo yadābravi (sya1ed, sya2ed); porāṇācariyobravi (mr) ", "ja222:1.3": "akari → akarā (bj, pts-vp-pli1) ", "ja222:1.4": "", "ja222:2.1": "", "ja222:2.2": "", "ja222:2.3": "", "ja222:2.4": "", "ja222:2.5": "", "ja222:2.6": "", "ja222:3.1": "Cūḷanandiyajātakaṁ → cullanandiyajātakaṁ (sya1ed, sya2ed, pts-vp-pli1) "}, "reference_text": {"ja222:0.1": "", "ja222:0.2": "", "ja222:0.3": "", "ja222:0.4": "", "ja222:1.1": "ms22J_573, msdiv143, pts-vp-pli2.20