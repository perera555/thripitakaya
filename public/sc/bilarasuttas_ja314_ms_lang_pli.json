{"html_text": {"ja314:0.1": "<article id='ja314'><header><ul><li class='division'>{}</li>", "ja314:0.2": "<li>{}</li>", "ja314:0.3": "<li>{}</li></ul>", "ja314:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja314:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja314:1.2": "<span class='verse-line'>{}</span>", "ja314:1.3": "<span class='verse-line'>{}</span>", "ja314:1.4": "<span class='verse-line'>{}</span></p>", "ja314:2.1": "<p><span class='verse-line'>{}</span>", "ja314:2.2": "<span class='verse-line'>{}</span>", "ja314:2.3": "<span class='verse-line'>{}</span>", "ja314:2.4": "<span class='verse-line'>{}</span></p>", "ja314:3.1": "<p><span class='verse-line'>{}</span>", "ja314:3.2": "<span class='verse-line'>{}</span>", "ja314:3.3": "<span class='verse-line'>{}</span>", "ja314:3.4": "<span class='verse-line'>{}</span></p>", "ja314:4.1": "<p><span class='verse-line'>{}</span>", "ja314:4.2": "<span class='verse-line'>{}</span>", "ja314:4.3": "<span class='verse-line'>{}</span>", "ja314:4.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja314:5.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja314:0.1": "Jātaka ", "ja314:0.2": "Catukkanipāta ", "ja314:0.3": "Pucimandavagga ", "ja314:0.4": "4. Lohakumbhijātaka ", "ja314:1.1": "“Dujjīvitamajīvimha, ", "ja314:1.2": "ye sante na dadamhase; ", "ja314:1.3": "Vijjamānesu bhogesu, ", "ja314:1.4": "dīpaṁ nākamha attano”. ", "ja314:2.1": "“Saṭṭhi vassasahassāni, ", "ja314:2.2": "paripuṇṇāni sabbaso; ", "ja314:2.3": "Niraye paccamānānaṁ, ", "ja314:2.4": "kadā anto bhavissati”. ", "ja314:3.1": "“Natthi anto kuto anto, ", "ja314:3.2": "na anto paṭidissati; ", "ja314:3.3": "Tadā hi pakataṁ pāpaṁ, ", "ja314:3.4": "mama tuyhañca mārisā”. ", "ja314:4.1": "“Sohaṁ nūna ito gantvā, ", "ja314:4.2": "yoniṁ laddhāna mānusiṁ; ", "ja314:4.3": "Vadaññū sīlasampanno, ", "ja314:4.4": "kāhāmi kusalaṁ bahun”ti. ", "ja314:5.1": "Lohakumbhijātakaṁ catutthaṁ. "}, "variant_text": {"ja314:0.1": "", "ja314:0.2": "", "ja314:0.3": "", "ja314:0.4": "", "ja314:1.1": "", "ja314:1.2": "sante → yesanno (sya1ed, sya2ed); yesaṁ no (mr) ", "ja314:1.3": "", "ja314:1.4": "", "ja314:2.1": "Saṭṭhi → saṭṭhiṁ (sya1ed, sya2ed) ", "ja314:2.2": "", "ja314:2.3": "", "ja314:2.4": "", "ja314:3.1": "", "ja314:3.2": "", "ja314:3.3": "", "ja314:3.4": "mārisā → mārisa (si, sya1ed, sya2ed, pts-vp-pli1) ", "ja314:4.1": "", "ja314:4.2": "", "ja314:4.3": "", "ja314:4.4": "", "ja314:5.1": ""}, "reference_text": {"ja314:0.1": "", "ja314:0.2": "", "ja314:0.3": "", "ja314:0.4": "", "ja314:1.1": "ms22J_950, msdiv53, pts-vp-pli3.47", "ja314:1.2": "", "ja314:1.3": "", "ja314:1.4": "", "ja314:2.1": "ms22J_951, msdiv54", "ja314:2.2": "", "ja314:2.3": "", "ja314:2.4": "", "ja314:3.1": "dr27.138, ms22J_952, msdiv55, sya27.138", "ja314:3.2": "", "ja314:3.3": "", "ja314:3.4": "", "ja314:4.1": "ms22J_953, msdiv56", "ja314:4.2": "", "ja314:4.3": "", "ja314:4.4": "", "ja314:5.1": "ms22J_954"}, "keys_order": ["ja314:0.1", "ja314:0.2", "ja314:0.3", "ja314:0.4", "ja314:1.1", "ja314:1.2", "ja314:1.3", "ja314:1.4", "ja314:2.1", "ja314:2.2", "ja314:2.3", "ja314:2.4", "ja314:3.1", "ja314:3.2", "ja314:3.3", "ja314:3.4", "ja314:4.1", "ja314:4.2", "ja314:4.3", "ja314:4.4", "ja314:5.1"]}