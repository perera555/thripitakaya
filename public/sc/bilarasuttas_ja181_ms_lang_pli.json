{"html_text": {"ja181:0.1": "<article id='ja181'><header><ul><li class='division'>{}</li>", "ja181:0.2": "<li>{}</li>", "ja181:0.3": "<li>{}</li></ul>", "ja181:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja181:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja181:1.2": "<span class='verse-line'>{}</span>", "ja181:1.3": "<span class='verse-line'>{}</span>", "ja181:1.4": "<span class='verse-line'>{}</span></p>", "ja181:2.1": "<p><span class='verse-line'>{}</span>", "ja181:2.2": "<span class='verse-line'>{}</span>", "ja181:2.3": "<span class='verse-line'>{}</span>", "ja181:2.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja181:3.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja181:0.1": "Jātaka ", "ja181:0.2": "Dukanipāta ", "ja181:0.3": "Asadisavagga ", "ja181:0.4": "1. Asadisajātaka ", "ja181:1.1": "Dhanuggaho asadiso, ", "ja181:1.2": "rājaputto mahabbalo; ", "ja181:1.3": "Dūrepātī akkhaṇavedhī, ", "ja181:1.4": "mahākāyappadālano. ", "ja181:2.1": "Sabbāmitte raṇaṁ katvā, ", "ja181:2.2": "na ca kañci viheṭhayi; ", "ja181:2.3": "Bhātaraṁ sotthiṁ katvāna, ", "ja181:2.4": "saṁyamaṁ ajjhupāgamīti. ", "ja181:3.1": "Asadisajātakaṁ paṭhamaṁ. "}, "reference_text": {"ja181:0.1": "", "ja181:0.2": "", "ja181:0.3": "", "ja181:0.4": "", "ja181:1.1": "bj30.82, dr27.64, ms22J_438, msdiv61, pts-vp-pli2.91", "ja181:1.2": "", "ja181:1.3": "", "ja181:1.4": "", "ja181:2.1": "ms22J_439, msdiv62", "ja181:2.2": "", "ja181:2.3": "", "ja181:2.4": "", "ja181:3.1": "ms22J_440"}, "keys_order": ["ja181:0.1", "ja181:0.2", "ja181:0.3", "ja181:0.4", "ja181:1.1", "ja181:1.2", "ja181:1.3", "ja181:1.4", "ja181:2.1", "ja181:2.2", "ja181:2.3", "ja181:2.4", "ja181:3.1"]}