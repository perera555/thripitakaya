_root": false, "author": "Bhikkhu Sujato", "author_short": "sujato", "author_uid": "sujato", "publication_date": null, "id": "ja64_translation-en-sujato", "segmented": true, "title": "The Inscrutability of Women ", "volpage": null, "has_comment": true}, {"lang": "pli", "lang_name": "Pāli", "is_root": true, "author": "Mahāsaṅgīti Tipiṭaka Buddhavasse 2500", "author_short": "ms", "author_uid": "ms", "publication_date": null, "id": "ja64_root-pli-ms", "segmented": true, "title": null, "volpage": null, "has_comment": false}, {"lang": "de", "lang_name": "Deutsch", "is_root": false, "author": "Dr. Julius Dutoit", "author_short": "Dutoit", "author_uid": "dutoit", "publication_date": "2007", "id": "de_ja64_dutoit", "segmented": false, "volpage": null, "has_comment": false}, {"author": "Robert Chalmers", "author_short": "Chalmers", "author_uid": "chalmers", "has_comment": false, "id": "en_ja64_chalmers", "is_root": false, "lang": "en", "lang_name": "English", "publication_date": "1895", "segmented": false, "volpage": null, "title": "Durajana Jātaka"}, {"lang": "jpn", "lang_name": "日本語", "is_root": false, "author": "関西パーリ語実習会", "author_short": "関西パーリ語実習会", "author_uid": "kansai", "publication_date": "2023", "id": "jpn_ja64_kansai", "segmented": false, "volpage": null, "has_comment": false}, {"lang": "si", "lang_name": "සිංහල", "is_root": false, "author": "A.P. de Zoysa", "author_short": "Zoysa", "author_uid": "zoysa", "publication_date": null, "id": "si_ja64_zoysa", "segmented": false, "volpage": null, "has_comment": false}], "parallel_count": 0, "biblio": null, "priority_author_uid": "sujato", "verseNo": ",,,,dr27.22, ms22J_141, msdiv64, pts-vp-pli1.300, sya27.21,,,,ms22J_142", "previous": {"name": null, "uid": null}, "next": {"name": null, "uid": null}}, "bilara_root_text": {"uid": "ja64", "author": "Mahāsaṅgīti Tipiṭaka Buddhavasse 2500", "author_short": "ms", "author_uid": "ms", "lang": "pli", "title": "Durājānajātaka", "previous": {"author_uid": "ms", "lang": "pli", "nam