{"html_text": {"snp1.7:0.1": "<article id='snp1.7'><header><ul><li class='division'>{}</li></ul>", "snp1.7:0.2": "<h1 class='sutta-title'>{}</h1></header>", "snp1.7:1.1": "<p><span class='evam'>{}</span>", "snp1.7:1.2": "{}", "snp1.7:1.3": "{}", "snp1.7:1.4": "{}", "snp1.7:1.5": "{}</p>", "snp1.7:2.1": "<p>{}", "snp1.7:2.2": "{}", "snp1.7:2.3": "{}", "snp1.7:2.4": "{}", "snp1.7:2.5": "{}</p>", "snp1.7:3.1": "<p>{}", "snp1.7:3.2": "{}", "snp1.7:3.3": "{}", "snp1.7:3.4": "{}", "snp1.7:3.5": "{}", "snp1.7:3.6": "{}", "snp1.7:3.7": "{}</p>", "snp1.7:4.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "snp1.7:4.2": "<span class='verse-line'>{}</span>", "snp1.7:4.3": "<span class='verse-line'>{}</span>", "snp1.7:4.4": "<span class='verse-line'>{}</span></p>", "snp1.7:5.1": "<p><span class='verse-line'>{}</span>", "snp1.7:5.2": "<span class='verse-line'>{}</span>", "snp1.7:5.3": "<span class='verse-line'>{}</span>", "snp1.7:5.4": "<span class='verse-line'>{}</span></p>", "snp1.7:6.1": "<p><span class='verse-line'>{}</span>", "snp1.7:6.2": "<span class='verse-line'>{}</span>", "snp1.7:6.3": "<span class='verse-line'>{}</span>", "snp1.7:6.4": "<span class='verse-line'>{}</span></p>", "snp1.7:7.1": "<p><span class='verse-line'>{}</span>", "snp1.7:7.2": "<span class='verse-line'>{}</span>", "snp1.7:7.3": "<span class='verse-line'>{}</span>", "snp1.7:7.4": "<span class='verse-line'>{}</span></p>", "snp1.7:8.1": "<p><span class='verse-line'>{}</span>", "snp1.7:8.2": "<span class='verse-line'>{}</span>", "snp1.7:8.3": "<span class='verse-line'>{}</span>", "snp1.7:8.4": "<span class='verse-line'>{}</span></p>", "snp1.7:9.1": "<p><span class='verse-line'>{}</span>", "snp1.7:9.2": "<span class='verse-line'>{}</span>", "snp1.7:9.3": "<span class='verse-line'>{}</span>", "snp1.7:9.4": "<span class='verse-line'>{}</span></p>", "snp1.7:10.1": "<p><span class='verse-line'>{}</span>", "snp1.7:10.2": "<span class='verse-line'>{}</span>", "snp1.7:10.3": "<span class='ve