{"html_text": {"ja160:0.1": "<article id='ja160'><header><ul><li class='division'>{}</li>", "ja160:0.2": "<li>{}</li>", "ja160:0.3": "<li>{}</li></ul>", "ja160:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja160:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja160:1.2": "<span class='verse-line'>{}</span>", "ja160:1.3": "<span class='verse-line'>{}</span>", "ja160:1.4": "<span class='verse-line'>{}</span></p>", "ja160:2.1": "<p><span class='verse-line'>{}</span>", "ja160:2.2": "<span class='verse-line'>{}</span>", "ja160:2.3": "<span class='verse-line'>{}</span>", "ja160:2.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja160:3.1": "<p class='endsutta'>{}</p>", "ja160:3.2": "<p class='endvagga'>{}</p>", "ja160:4.1": "<p class='uddana-intro'>{}</p>", "ja160:5.1": "<blockquote class='uddanagatha'><p><span class='verse-line'>{}</span>", "ja160:5.2": "<span class='verse-line'>{}</span>", "ja160:5.3": "<span class='verse-line'>{}</span>", "ja160:5.4": "<span class='verse-line'>{}</span></p></blockquote></article>"}, "root_text": {"ja160:0.1": "Jātaka ", "ja160:0.2": "Dukanipāta ", "ja160:0.3": "Daḷhavagga ", "ja160:0.4": "10. Vinīlajātaka ", "ja160:1.1": "“Evameva nūna rājānaṁ, ", "ja160:1.2": "vedehaṁ mithilaggahaṁ; ", "ja160:1.3": "Assā vahanti ājaññā, ", "ja160:1.4": "yathā haṁsā vinīlakaṁ”. ", "ja160:2.1": "“Vinīla duggaṁ bhajasi, ", "ja160:2.2": "abhūmiṁ tāta sevasi; ", "ja160:2.3": "Gāmantakāni sevassu, ", "ja160:2.4": "etaṁ mātālayaṁ tavāti. ", "ja160:3.1": "Vinīlajātakaṁ dasamaṁ. ", "ja160:3.2": "Daḷhavaggo paṭhamo. ", "ja160:4.1": "Tassuddānaṁ ", "ja160:5.1": "Varaballika daddara sūkarako, ", "ja160:5.2": "Uraguttama pañcamabhaggavaro; ", "ja160:5.3": "Mahatīcamu yāva siṅgālavaro, ", "ja160:5.4": "Suhanuttama mora vinīlaṁ dasā”ti. "}, "variant_text": {"ja160:0.1": "", "ja160:0.2": "", "ja160:0.3": "", "ja160:0.4": "", "ja160:1.1": "nūna → nu (mr) ", "ja160:1.2": "", "ja160:1.3": "", "ja160:1.4": "", "ja160:2.1": "", "ja160:2.2": "", "ja160:2.3": "Gāmantakāni → gāmantikāni (bj); gāmantarāni (mr) ", "ja160:2.4": "tavāti → tuvanti (sya1ed, sya2ed); tavanti (pts-vp-pli1) ", "ja160:3.1": "Vinīlajātakaṁ → vinīlakajātakaṁ (bj, sya1ed, sya2ed, pts-vp-pli1) ", "ja160:3.2": "", "ja160:4.1": "", "ja160:5.1": "", "ja160:5.2": "", "ja160:5.3": "", "ja160:5.4": ""}, "reference_text": {"ja160:0.1": "", "ja160:0.2": "", "ja160:0.3": "", "ja160:0.4": "", "ja160:1.1": "bj30.68, ms22J_369, msdiv19, pts-vp-pli2.40", "ja160:1.2": "", "ja160:1.3": "", "ja160:1.4": "", "ja160:2.1": "ms22J_370, msdiv20, vri68.37", "ja160:2.2": "", "ja160:2.3": "", "ja160:2.4": "", "ja160:3.1": "ms22J_371", "ja160:3.2": "", "ja160:4.1": "ms22J_372", "ja160:5.1": "ms22J_373, sya27.55", "ja160:5.2": "", "ja160:5.3": "", "ja160:5.4": ""}, "keys_order": ["ja160:0.1", "ja160:0.2", "ja160:0.3", "ja160:0.4", "ja160:1.1", "ja160:1.2", "ja160:1.3", "ja160:1.4", "ja160:2.1", "ja160:2.2", "ja160:2.3", "ja160:2.4", "ja160:3.1", "ja160:3.2", "ja160:4.1", "ja160:5.1", "ja160:5.2", "ja160:5.3", "ja160:5.4"]}