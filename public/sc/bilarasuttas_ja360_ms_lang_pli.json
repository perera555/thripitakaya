{"html_text": {"ja360:0.1": "<article id='ja360'><header><ul><li class='division'>{}</li>", "ja360:0.2": "<li>{}</li>", "ja360:0.3": "<li>{}</li></ul>", "ja360:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja360:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja360:1.2": "<span class='verse-line'>{}</span>", "ja360:1.3": "<span class='verse-line'>{}</span>", "ja360:1.4": "<span class='verse-line'>{}</span></p>", "ja360:2.1": "<p><span class='verse-line'>{}</span>", "ja360:2.2": "<span class='verse-line'>{}</span>", "ja360:2.3": "<span class='verse-line'>{}</span>", "ja360:2.4": "<span class='verse-line'>{}</span></p>", "ja360:3.1": "<p><span class='verse-line'>{}</span>", "ja360:3.2": "<span class='verse-line'>{}</span>", "ja360:3.3": "<span class='verse-line'>{}</span>", "ja360:3.4": "<span class='verse-line'>{}</span></p>", "ja360:4.1": "<p><span class='verse-line'>{}</span>", "ja360:4.2": "<span class='verse-line'>{}</span>", "ja360:4.3": "<span class='verse-line'>{}</span>", "ja360:4.4": "<span class='verse-line'>{}</span></p>", "ja360:5.1": "<p><span class='verse-line'>{}</span>", "ja360:5.2": "<span class='verse-line'>{}</span>", "ja360:5.3": "<span class='verse-line'>{}</span>", "ja360:5.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja360:6.1": "<p class='endsutta'>{}</p>", "ja360:6.2": "<p class='endvagga'>{}</p>", "ja360:7.1": "<p class='uddana-intro'>{}</p>", "ja360:8.1": "<blockquote class='uddanagatha'><p><span class='verse-line'>{}</span>", "ja360:8.2": "<span class='verse-line'>{}</span>", "ja360:8.3": "<span class='verse-line'>{}</span>", "ja360:8.4": "<span class='verse-line'>{}</span></p></blockquote></article>"}, "root_text": {"ja360:0.1": "Jātaka ", "ja360:0.2": "Pañcakanipāta ", "ja360:0.3": "Maṇikuṇḍalavagga ", "ja360:0.4": "10. Suyonandījātaka ", "ja360:1.1": "“Vāti gandho timirānaṁ, ", "ja360:1.2": "kusamuddo ca ghosavā; ", "ja360:1.3": "Dūre ito suyonandī, ", "ja360:1.4": "tamba kāmā tudanti maṁ”. ", "ja360:2.1": "“Kathaṁ samuddamatari, ", "ja360:2.2": "Kathaṁ addakkhi sedumaṁ; ", "ja360:2.3": "Kathaṁ tassā ca tuyhañca, ", "ja360:2.4": "Ahu saggasamāgamo”. ", "ja360:3.1": "“Kurukacchā payātānaṁ, ", "ja360:3.2": "vāṇijānaṁ dhanesinaṁ; ", "ja360:3.3": "Makarehi abhidā nāvā, ", "ja360:3.4": "phalakenāhamaplaviṁ. ", "ja360:4.1": "Sā maṁ saṇhena mudunā, ", "ja360:4.2": "niccaṁ candanagandhinī; ", "ja360:4.3": "Aṅgena uddharī bhaddā, ", "ja360:4.4": "mātā puttaṁva orasaṁ. ", "ja360:5.1": "Sā maṁ annena pānena, ", "ja360:5.2": "vatthena sayanena ca; ", "ja360:5.3": "Attanāpi ca mandakkhī, ", "ja360:5.4": "evaṁ tamba vijānahī”ti. ", "ja360:6.1": "Suyonandījātakaṁ dasamaṁ. ", "ja360:6.2": "Maṇikuṇḍalavaggo paṭhamo. ", "ja360:7.1": "Tassuddānaṁ ", "ja360:8.1": "Atha jinavaro haritaṁ tiṇako, ", "ja360:8.2": "Atha bhinnaplavo uragova ghaṭo; ", "ja360:8.3": "Dariyā puna kuñjara bhūnahatā, ", "ja360:8.4": "Migamuttamasaggavarena dasāti. "}, "variant_text": {"ja360:0.1": "", "ja360:0.2": "ca → va (sya1ed, sya2ed, pts-vp-pli1) ", "ja360:0.3": "", "ja360:0.4": "", "ja360:1.1": "", "ja360:1.2": "", "ja360:1.3": "suyonandī → ito hi susandhī (bj, sya1ed, sya2ed); itopi sussondī (pts-vp-pli1) ", "ja360:1.4": "", "ja360:2.1": "", "ja360:2.2": "sedumaṁ → serumaṁ (bj, sya1ed, sya2ed, pts-vp-pli1) ", "ja360:2.3": "", "ja360:2.4": "saggasamāgamo → aggasamāgamo (sya1ed, sya2ed) ", "ja360:3.1": "Kurukacchā → bharukacchā (bj, sya1ed, sya2ed); bharukaccha (pts-vp-pli1) ", "ja360:3.2": "", "ja360:3.3": "Makarehi abhidā → makarehambhidā (bj); maṅkarehi bhidā (sya1ed, sya2ed); makarehi bhinnā (pts-vp-pli1) ", "ja360:3.4": "", "ja360:4.1": "", "ja360:4.2": "", "ja360:4.3": "Aṅgena → aṅkena (bj, pts-vp-pli1, mr) ", "ja360:4.4": "", "ja360:5.1": "", "ja360:5.2": "", "ja360:5.3": "", "ja360:5.4": "", "ja360:6.1": "Suyonandījātakaṁ → susandhijātakaṁ (bj); susandhījātakaṁ (sya1ed, sya2ed); sussondijātakaṁ (pts-vp-pli1) ", "ja360:6.2": "", "ja360:7.1": "", "ja360:8.1": "", "ja360:8.2": "", "ja360:8.3": "", "ja360:8.4": ""}, "reference_text": {"ja360:0.1": "", "ja360:0.2": "", "ja360:0.3": "", "ja360:0.4": "", "ja360:1.1": "ms22J_1209, msdiv55, pts-vp-pli3.189, vri68.107", "ja360:1.2": "", "ja360:1.3": "", "ja360:1.4": "", "ja360:2.1": "ms22J_1210, msdiv56, ndp22.118", "ja360:2.2": "", "ja360:2.3": "", "ja360:2.4": "", "ja360:3.1": "dr27.173, ms22J_1211, msdiv57, pts-vp-pli3.190", "ja360:3.2": "", "ja360:3.3": "", "ja360:3.4": "", "ja360:4.1": "csp1ed22.127, csp2ed22.127, ms22J_1212, msdiv58", "ja360:4.2": "", "ja360:4.3": "", "ja360:4.4": "", "ja360:5.1": "ms22J_1213, msdiv59", "ja360:5.2": "", "ja360:5.3": "", "ja360:5.4": "", "ja360:6.1": "ms22J_1214", "ja360:6.2": "", "ja360:7.1": "ms22J_1215", "ja360:8.1": "ms22J_1216, sya27.174", "ja360:8.2": "", "ja360:8.3": "", "ja360:8.4": ""}, "keys_order": ["ja360:0.1", "ja360:0.2", "ja360:0.3", "ja360:0.4", "ja360:1.1", "ja360:1.2", "ja360:1.3", "ja360:1.4", "ja360:2.1", "ja360:2.2", "ja360:2.3", "ja360:2.4", "ja360:3.1", "ja360:3.2", "ja360:3.3", "ja360:3.4", "ja360:4.1", "ja360:4.2", "ja360:4.3", "ja360:4.4", "ja360:5.1", "ja360:5.2", "ja360:5.3", "ja360:5.4", "ja360:6.1", "ja360:6.2", "ja360:7.1", "ja360:8.1", "ja360:8.2", "ja360:8.3", "ja360:8.4"]}