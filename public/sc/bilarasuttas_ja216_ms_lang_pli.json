{"html_text": {"ja216:0.1": "<article id='ja216'><header><ul><li class='division'>{}</li>", "ja216:0.2": "<li>{}</li>", "ja216:0.3": "<li>{}</li></ul>", "ja216:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja216:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja216:1.2": "<span class='verse-line'>{}</span>", "ja216:1.3": "<span class='verse-line'>{}</span>", "ja216:1.4": "<span class='verse-line'>{}</span></p>", "ja216:2.1": "<p><span class='verse-line'>{}</span>", "ja216:2.2": "<span class='verse-line'>{}</span>", "ja216:2.3": "<span class='verse-line'>{}</span>", "ja216:2.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja216:3.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja216:0.1": "Jātaka ", "ja216:0.2": "Dukanipāta ", "ja216:0.3": "Bīraṇathambhavagga ", "ja216:0.4": "6. Macchajātaka ", "ja216:1.1": "“Na māyamaggi tapati, ", "ja216:1.2": "na sūlo sādhutacchito; ", "ja216:1.3": "Yañca maṁ maññate macchī, ", "ja216:1.4": "aññaṁ so ratiyā gato. ", "ja216:2.1": "So maṁ dahati rāgaggi, ", "ja216:2.2": "cittaṁ cūpatapeti maṁ; ", "ja216:2.3": "Jālino muñcathāyirā maṁ, ", "ja216:2.4": "na kāme haññate kvacī”ti. ", "ja216:3.1": "Macchajātakaṁ chaṭṭhaṁ. "}, "reference_text": {"ja216:0.1": "", "ja216:0.2": "", "ja216:0.3": "", "ja216:0.4": "", "ja216:1.1": "dr27.80, ms22J_553, msdiv131, pts-vp-pli2.178", "ja216:1.2": "", "ja216:1.3": "", "ja216:1.4": "", "ja216:2.1": "ms22J_554, msdiv132, sya27.81", "ja216:2.2": "", "ja216:2.3": "", "ja216:2.4": "", "ja216:3.1": "ms22J_555"}, "keys_order": ["ja216:0.1", "ja216:0.2", "ja216:0.3", "ja216:0.4", "ja216:1.1", "ja216:1.2", "ja216:1.3", "ja216:1.4", "ja216:2.1", "ja216:2.2", "ja216:2.3", "ja216:2.4", "ja216:3.1"]}