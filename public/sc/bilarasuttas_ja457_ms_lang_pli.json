{"html_text": {"ja457:0.1": "<article id='ja457'><header><ul><li class='division'>{}</li>", "ja457:0.2": "<li>{}</li>", "ja457:0.3": "<li>{}</li></ul>", "ja457:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja457:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja457:1.2": "<span class='verse-line'>{}</span>", "ja457:1.3": "<span class='verse-line'>{}</span>", "ja457:1.4": "<span class='verse-line'>{}</span></p>", "ja457:2.1": "<p><span class='verse-line'>{}</span>", "ja457:2.2": "<span class='verse-line'>{}</span>", "ja457:2.3": "<span class='verse-line'>{}</span>", "ja457:2.4": "<span class='verse-line'>{}</span></p>", "ja457:3.1": "<p><span class='verse-line'>{}</span>", "ja457:3.2": "<span class='verse-line'>{}</span>", "ja457:3.3": "<span class='verse-line'>{}</span>", "ja457:3.4": "<span class='verse-line'>{}</span></p>", "ja457:4.1": "<p><span class='verse-line'>{}</span>", "ja457:4.2": "<span class='verse-line'>{}</span>", "ja457:4.3": "<span class='verse-line'>{}</span>", "ja457:4.4": "<span class='verse-line'>{}</span></p>", "ja457:5.1": "<p><span class='verse-line'>{}</span>", "ja457:5.2": "<span class='verse-line'>{}</span>", "ja457:5.3": "<span class='verse-line'>{}</span>", "ja457:5.4": "<span class='verse-line'>{}</span></p>", "ja457:6.1": "<p><span class='verse-line'>{}</span>", "ja457:6.2": "<span class='verse-line'>{}</span>", "ja457:6.3": "<span class='verse-line'>{}</span>", "ja457:6.4": "<span class='verse-line'>{}</span></p>", "ja457:7.1": "<p><span class='verse-line'>{}</span>", "ja457:7.2": "<span class='verse-line'>{}</span>", "ja457:7.3": "<span class='verse-line'>{}</span>", "ja457:7.4": "<span class='verse-line'>{}</span></p>", "ja457:8.1": "<p><span class='verse-line'>{}</span>", "ja457:8.2": "<span class='verse-line'>{}</span>", "ja457:8.3": "<span class='verse-line'>{}</span>", "ja457:8.4": "<span class='verse-line'>{}</span></p>", "ja457:9.1": "<p><span class='verse-line'>{}</span>", "ja457:9.2": "<span class='verse-line'>{}</span>", "ja457:9.3": "<span class='verse-line'>{}</span>", "ja457:9.4": "<span class='verse-line'>{}</span></p>", "ja457:10.1": "<p><span class='verse-line'>{}</span>", "ja457:10.2": "<span class='verse-line'>{}</span>", "ja457:10.3": "<span class='verse-line'>{}</span>", "ja457:10.4": "<span class='verse-line'>{}</span>", "ja457:10.5": "<span class='verse-line'>{}</span></p>", "ja457:11.1": "<p><span class='verse-line'>{}</span>", "ja457:11.2": "<span class='verse-line'>{}</span>", "ja457:11.3": "<span class='verse-line'>{}</span>", "ja457:11.4": "<span class='verse-line'>{}</span>", "ja457:11.5": "<span class='verse-line'>{}</span></p></blockquote>", "ja457:12.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja457:0.1": "Jātaka ", "ja457:0.2": "Ekādasakanipāta ", "ja457:0.3": "Mātuposakavagga ", "ja457:0.4": "3. Dhammadevaputtajātaka ", "ja457:1.1": "“Yasokaro puññakarohamasmi, ", "ja457:1.2": "Sadātthuto samaṇabrāhmaṇānaṁ; ", "ja457:1.3": "Maggāraho devamanussapūjito, ", "ja457:1.4": "Dhammo ahaṁ dehi adhamma maggaṁ”. ", "ja457:2.1": "“Adhammayānaṁ daḷhamāruhitvā, ", "ja457:2.2": "Asantasanto balavāhamasmi; ", "ja457:2.3": "Sa kissa hetumhi tavajja dajjaṁ, ", "ja457:2.4": "Maggaṁ ahaṁ dhamma adinnapubbaṁ”. ", "ja457:3.1": "“Dhammo have pāturahosi pubbe, ", "ja457:3.2": "Pacchā adhammo udapādi loke; ", "ja457:3.3": "Jeṭṭho ca seṭṭho ca sanantano ca, ", "ja457:3.4": "Uyyāhi jeṭṭhassa kaniṭṭha maggā”. ", "ja457:4.1": "“Na yācanāya napi pātirūpā, ", "ja457:4.2": "Na arahatā tehaṁ dadeyyaṁ maggaṁ; ", "ja457:4.3": "Yuddhañca no hotu ubhinnamajja, ", "ja457:4.4": "Yuddhamhi yo jessati tassa maggo”. ", "ja457:5.1": "“Sabbā disā anuvisaṭohamasmi, ", "ja457:5.2": "Mahabbalo amitayaso atulyo; ", "ja457:5.3": "Guṇehi sabbehi upetarūpo, ", "ja457:5.4": "Dhammo adhamma tvaṁ kathaṁ vijessasi. ", "ja457:6.1": "Lohena ve haññati jātarūpaṁ, ", "ja457:6.2": "Na jātarūpena hananti lohaṁ; ", "ja457:6.3": "Sace adhammo hañchati dhammamajja, ", "ja457:6.4": "Ayo suvaṇṇaṁ viya dassaneyyaṁ. ", "ja457:7.1": "Sace tuvaṁ yuddhabalo adhamma, ", "ja457:7.2": "Na tuyha vuḍḍhā ca garū ca atthi; ", "ja457:7.3": "Maggañca te dammi piyāppiyena, ", "ja457:7.4": "Vācāduruttānipi te khamāmi”. ", "ja457:8.1": "“Idañca sutvā vacanaṁ adhammo, ", "ja457:8.2": "Avaṁsiro patito uddhapādo; ", "ja457:8.3": "‘Yuddhatthiko ce na labhāmi yuddhaṁ’, ", "ja457:8.4": "Ettāvatā hoti hato adhammo. ", "ja457:9.1": "Khantībalo yuddhabalaṁ vijetvā, ", "ja457:9.2": "Hantvā adhammaṁ nihanitva bhūmyā; ", "ja457:9.3": "Pāyāsi vitto abhiruyha sandanaṁ, ", "ja457:9.4": "Maggeneva atibalo saccanikkamo. ", "ja457:10.1": "Mātā pitā samaṇabrāhmaṇā ca, ", "ja457:10.2": "Asammānitā yassa sake agāre; ", "ja457:10.3": "Idheva nikkhippa sarīradehaṁ, ", "ja457:10.4": "Kāyassa bhedā nirayaṁ vajanti te; ", "ja457:10.5": "Yathā adhammo patito avaṁsiro. ", "ja457:11.1": "Mātā pitā samaṇabrāhmaṇā ca, ", "ja457:11.2": "Susammānitā yassa sake agāre; ", "ja457:11.3": "Idheva nikkhippa sarīradehaṁ, ", "ja457:11.4": "Kāyassa bhedā sugatiṁ vajanti te; ", "ja457:11.5": "Yathāpi dhammo abhiruyha sandanan”ti. ", "ja457:12.1": "Dhammadevaputtajātakaṁ tatiyaṁ. "}, "variant_text": {"ja457:0.1": "", "ja457:0.2": "", "ja457:0.3": "", "ja457:0.4": "", "ja457:1.1": "", "ja457:1.2": "", "ja457:1.3": "", "ja457:1.4": "", "ja457:2.1": "", "ja457:2.2": "", "ja457:2.3": "", "ja457:2.4": "", "ja457:3.1": "", "ja457:3.2": "", "ja457:3.3": "", "ja457:3.4": "", "ja457:4.1": "", "ja457:4.2": "Na arahatā → na arahati (bj, pts-vp-pli1); na arahattā (sya1ed, sya2ed); arahati (mr) ", "ja457:4.3": "", "ja457:4.4": "", "ja457:5.1": "", "ja457:5.2": "", "ja457:5.3": "", "ja457:5.4": "", "ja457:6.1": "", "ja457:6.2": "", "ja457:6.3": "hañchati → haññati (bj, sya1ed, sya2ed); haññiti (katthaci) ", "ja457:6.4": "", "ja457:7.1": "yuddhabalo adhamma → yuddhabalo'si'dhamma (si); yuddhabalo'sa'dhamma (pts-vp-pli1) ", "ja457:7.2": "vuḍḍhā → vaddhā (bj, pts-vp-pli1) ", "ja457:7.3": "", "ja457:7.4": "", "ja457:8.1": "", "ja457:8.2": "", "ja457:8.3": "", "ja457:8.4": "", "ja457:9.1": "", "ja457:9.2": "nihanitva → vihanitvā (mr) ", "ja457:9.3": "vitto → citto (sya1ed, sya2ed) ", "ja457:9.4": "", "ja457:10.1": "", "ja457:10.2": "", "ja457:10.3": "", "ja457:10.4": "vajanti te → vajanti (bj, pts-vp-pli1) ", "ja457:10.5": "", "ja457:11.1": "", "ja457:11.2": "", "ja457:11.3": "", "ja457:11.4": "", "ja457:11.5": "", "ja457:12.1": "Dhammadevaputtajātakaṁ → dhammajātakaṁ (bj, pts-vp-pli1) "}, "reference_text": {"ja457:0.1": "", "ja457:0.2": "", "ja457:0.3": "", "ja457:0.4": "", "ja457:1.1": "ms22J_2134, msdiv26, pts-vp-pli4.101", "ja457:1.2": "", "ja457:1.3": "", "ja457:1.4": "", "ja457:2.1": "ms22J_2135, msdiv27", "ja457:2.2": "", "ja457:2.3": "", "ja457:2.4": "", "ja457:3.1": "dr27.306, ms22J_2136, msdiv28, ndp22.222, sya27.308", "ja457:3.2": "", "ja457:3.3": "", "ja457:3.4": "", "ja457:4.1": "bj30.394, ms22J_2137, msdiv29, pts-vp-pli4.102", "ja457:4.2": "", "ja457:4.3": "", "ja457:4.4": "", "ja457:5.1": "csp1ed22.230, csp2ed22.230, ms22J_2138, msdiv30", "ja457:5.2": "", "ja457:5.3": "", "ja457:5.4": "", "ja457:6.1": "ms22J_2139, msdiv31", "ja457:6.2": "", "ja457:6.3": "", "ja457:6.4": "", "ja457:7.1": "ms22J_2140, msdiv32", "ja457:7.2": "", "ja457:7.3": "", "ja457:7.4": "", "ja457:8.1": "dr27.307, ms22J_2141, msdiv33, pts-vp-pli4.103, sya27.309", "ja457:8.2": "", "ja457:8.3": "", "ja457:8.4": "", "ja457:9.1": "ms22J_2142, msdiv34, ndp22.223", "ja457:9.2": "", "ja457:9.3": "", "ja457:9.4": "", "ja457:10.1": "ms22J_2143, msdiv35", "ja457:10.2": "", "ja457:10.3": "", "ja457:10.4": "", "ja457:10.5": "", "ja457:11.1": "csp1ed22.231, csp2ed22.231, ms22J_2144, msdiv36", "ja457:11.2": "", "ja457:11.3": "", "ja457:11.4": "", "ja457:11.5": "", "ja457:12.1": "ms22J_2145"}, "keys_order": ["ja457:0.1", "ja457:0.2", "ja457:0.3", "ja457:0.4", "ja457:1.1", "ja457:1.2", "ja457:1.3", "ja457:1.4", "ja457:2.1", "ja457:2.2", "ja457:2.3", "ja457:2.4", "ja457:3.1", "ja457:3.2", "ja457:3.3", "ja457:3.4"