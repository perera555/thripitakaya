{"html_text": {"ja353:0.1": "<article id='ja353'><header><ul><li class='division'>{}</li>", "ja353:0.2": "<li>{}</li>", "ja353:0.3": "<li>{}</li></ul>", "ja353:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja353:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja353:1.2": "<span class='verse-line'>{}</span>", "ja353:1.3": "<span class='verse-line'>{}</span>", "ja353:1.4": "<span class='verse-line'>{}</span></p>", "ja353:2.1": "<p><span class='verse-line'>{}</span>", "ja353:2.2": "<span class='verse-line'>{}</span>", "ja353:2.3": "<span class='verse-line'>{}</span>", "ja353:2.4": "<span class='verse-line'>{}</span>", "ja353:2.5": "<span class='verse-line'>{}</span>", "ja353:2.6": "<span class='verse-line'>{}</span></p>", "ja353:3.1": "<p><span class='verse-line'>{}</span>", "ja353:3.2": "<span class='verse-line'>{}</span>", "ja353:3.3": "<span class='verse-line'>{}</span>", "ja353:3.4": "<span class='verse-line'>{}</span></p>", "ja353:4.1": "<p><span class='verse-line'>{}</span>", "ja353:4.2": "<span class='verse-line'>{}</span>", "ja353:4.3": "<span class='verse-line'>{}</span>", "ja353:4.4": "<span class='verse-line'>{}</span></p>", "ja353:5.1": "<p><span class='verse-line'>{}</span>", "ja353:5.2": "<span class='verse-line'>{}</span>", "ja353:5.3": "<span class='verse-line'>{}</span>", "ja353:5.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja353:6.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja353:0.1": "Jātaka ", "ja353:0.2": "Pañcakanipāta ", "ja353:0.3": "Maṇikuṇḍalavagga ", "ja353:0.4": "3. Venasākhajātaka ", "ja353:1.1": "“Nayidaṁ niccaṁ bhavitabbaṁ brahmadatta, ", "ja353:1.2": "Khemaṁ subhikkhaṁ sukhatā ca kāye; ", "ja353:1.3": "Atthaccaye mā ahu sampamūḷho, ", "ja353:1.4": "Bhinnaplavo sāgarasseva majjhe. ", "ja353:2.1": "Yāni karoti puriso, ", "ja353:2.2": "tāni attani passati; ", "ja353:2.3": "Kalyāṇakārī kalyāṇaṁ, ", "ja353:2.4": "pāpakārī ca pāpakaṁ; ", "ja353:2.5": "Yādisaṁ vapate bījaṁ, ", "ja353:2.6": "tādisaṁ harate phalaṁ”. ", "ja353:3.1": "“Idaṁ tadācariyavaco, ", "ja353:3.2": "pārāsariyo yadabravi; ", "ja353:3.3": "Mā su tvaṁ akari pāpaṁ, ", "ja353:3.4": "yaṁ tvaṁ pacchā kataṁ tape. ", "ja353:4.1": "Ayameva so piṅgiya venasākho, ", "ja353:4.2": "Yamhi ghātayiṁ khattiyānaṁ sahassaṁ; ", "ja353:4.3": "Alaṅkate candanasārānulitte, ", "ja353:4.4": "Tameva dukkhaṁ paccāgataṁ mamaṁ. ", "ja353:5.1": "Sāmā ca kho candanalittagattā, ", "ja353:5.2": "Laṭṭhīva sobhañjanakassa uggatā; ", "ja353:5.3": "Adisvā kālaṁ karissāmi ubbariṁ, ", "ja353:5.4": "Taṁ me ito dukkhataraṁ bhavissatī”ti. ", "ja353:6.1": "Venasākhajātakaṁ tatiyaṁ. "}, "variant_text": {"ja353:0.1": "", "ja353:0.2": "ca → sāmāpi (bj, sya1ed, sya2ed) | candanalittagattā → … gattī (bj, sya1ed, sya2ed, pts-vp-pli1, mr) ", "ja353:0.3": "", "ja353:0.4": "", "ja353:1.1": "", "ja353:1.2": "su → māssu (bj, sya1ed, sya2ed, pts-vp-pli1) ", "ja353:1.3": "", "ja353:1.4": "", "ja353:2.1": "", "ja353:2.2": "", "ja353:2.3": "", "ja353:2.4": "", "ja353:2.5": "", "ja353:2.6": "", "ja353:3.1": "", "ja353:3.2": "", "ja353:3.3": "", "ja353:3.4": "", "ja353:4.1": "piṅgiya → so piṅgiyo (sya1ed, sya2ed); sopi bhiyyo (mr) | venasākho → dhonasākho (bj, pts-vp-pli1) ", "ja353:4.2": "", "ja353:4.3": "", "ja353:4.4": "", "ja353:5.1": "", "ja353:5.2": "", "ja353:5.3": "Adisvā → adisvāva (bj) ", "ja353:5.4": "", "ja353:6.1": "Venasākhajātakaṁ → dhonasākhajātakaṁ (si, pts-vp-pli1) "}, "reference_text": {"ja353:0.1": "", "ja353:0.2": "", "ja353:0.3": "", "ja353:0.4": "", "ja353:1.1": "ms22J_1161, msdiv14, pts-vp-pli3.158", "ja353:1.2": "", "ja353:1.3": "", "ja353:1.4": "", "ja353:2.1": "csp1ed22.122, csp2ed22.122, ms22J_1162, msdiv15, ndp22.113", "ja353:2.2": "", "ja353:2.3": "", "ja353:2.4": "", "ja353:2.5": "", "ja353:2.6": "", "ja353:3.1": "ms22J_1163, msdiv16, pts-vp-pli3.160", "ja353:3.2": "", "ja353:3.3": "", "ja353:3.4": "", "ja353:4.1": "ms22J_1164, msdiv17, sya27.167", "ja353:4.2": "", "ja353:4.3": "", "ja353:4.4": "", "ja