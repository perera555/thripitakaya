[{"acronym": "Ja 370", "alt_acronym": null, "volpages": "PTS 3.209, PTS 3.210", "alt_volpages": null, "uid": "ja370", "blurb": "“The goose said to the Judas tree”—This was a story told by the Master, whilst residing at Jetavana, concerning the rebuke of sin. The incident that led to the story will be set forth in the Panna Birth. But on this occasion the Master addressing the Brethren said, “Brothers, sin ought to be regarded with suspicion. Though it be as small as a banyan shoot, it may prove fatal. Sages of old too suspected whatever was open to suspicion.” And with this he related a story of the past.", "difficulty": null, "original_title": "Palāsajātaka", "root_lang": "pli", "root_lang_name": "Pāli", "type": "leaf", "translated_title": "Palasa Jātaka", "translations": [{"lang": "pli", "lang_name": "Pāli", "is_root": true, "author": "Mahāsaṅgīti Tipiṭaka Buddhavasse 2500", "author_short": "ms", "author_uid": "ms", "publication_date": null, "id": "ja370_root-pli-ms", "segmented": true, "title": null, "volpage": null, "has_comment": false}, {"lang": "de", "lang_name": "Deutsch", "is_root": false, "author": "Dr. Julius Dutoit", "author_short": "Dutoit", "author_uid": "dutoit", "publication_date": "2007", "id": "de_ja370_dutoit", "segmented": false, "volpage": null, "has_comment": false}, {"author": "H.T. Francis, R.A. Neil", "author_short": "Francis …", "author_uid": "francis-neil", "has_comment": false, "id": "en_ja370_francis-neil", "is_root": false, "lang": "en", "lang_name": "English", "publication_date": "1897", "segmented": false, "volpage": null, "title": "Palasa Jātaka"}, {"lang": "jpn", "lang_name": "日本語", "is_root": false, "author": "関西パーリ語実習会", "author_short": "関西パーリ語実習会", "author_uid": "kansai", "publication_date": "2023", "id": "jpn_ja370_kansai", "segmented": false, "volpage": null, "has_comment": false}, {"lang": "si", "lang_name": "සිංහල", "is_root": false, "author": "A.P. de Zoysa", "author_short": "Zoysa", "author_uid": "zoysa", "publication_date"