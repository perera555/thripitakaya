[{"acronym": "Ja 76", "alt_acronym": null, "volpages": "PTS 1.334", "alt_volpages": null, "uid": "ja76", "blurb": "“The village breeds no fear in me.”—This story was told by the Master while at Jetavana, about a lay-brother who lived at Savatthi. Tradition says that this man, who had entered the Paths and was an earnest believer, was once journeying along on some business or other in the company of a leader of a caravan; in the jungle the carts were unyoked and a laager was constructed; and the good man began to pace up and down at the foot of a certain tree hard by the leader.", "difficulty": null, "original_title": "Asaṁkiyajātaka", "root_lang": "pli", "root_lang_name": "Pāli", "type": "leaf", "translated_title": "Fearlessness ", "translations": [{"lang": "pli", "lang_name": "Pāli", "is_root": true, "author": "Mahāsaṅgīti Tipiṭaka Buddhavasse 2500", "author_short": "ms", "author_uid": "ms", "publication_date": null, "id": "ja76_root-pli-ms", "segmented": true, "title": null, "volpage": null, "has_comment": false}, {"lang": "de", "lang_name": "Deutsch", "is_root": false, "author": "Sabbamitta", "author_short": "sabbamitta", "author_uid": "sabbamitta", "publication_date": null, "id": "ja76_translation-de-sabbamitta", "segmented": true, "title": "Ohne Argwohn ", "volpage": null, "has_comment": true}, {"lang": "de", "lang_name": "Deutsch", "is_root": false, "author": "Dr. Julius Dutoit", "author_short": "Dutoit", "author_uid": "dutoit", "publication_date": "2007", "id": "de_ja76_dutoit", "segmented": false, "volpage": null, "has_comment": false}, {"lang": "en", "lang_name": "English", "is_root": false, "author": "Bhikkhu Sujato", "author_short": "sujato", "author_uid": "sujato", "publication_date": null, "id": "ja76_translation-en-sujato", "segmented": true, "title": "Fearlessness ", "volpage": null, "has_comment": true}, {"author": "Robert Chalmers", "author_short": "Chalmers", "author_uid": "chalmers", "has_comment": false, "id": "en_ja76_chalmers", "is_root": false