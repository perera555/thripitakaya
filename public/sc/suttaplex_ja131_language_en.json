[{"acronym": "Ja 131", "alt_acronym": null, "volpages": "PTS 1.467, PTS 1.468", "alt_volpages": null, "uid": "ja131", "blurb": "“If a friend.”—This story was told by the Master while at the Bamboo-grove, about Devadatta. For at that time the Brethren were discussing in the Hall of Truth the ingratitude of Devadatta and his inability to recognise the Master’s goodness, when the Master himself entered and on enquiry was told the subject of their talk. “Brethren,” said he, “this is not the first time that Devadatta has been ungrateful; he was just as ungrateful in bygone days.” So saying, he told this story of the past.", "difficulty": null, "original_title": "Asampadānajātaka", "root_lang": "pli", "root_lang_name": "Pāli", "type": "leaf", "translated_title": "Asampadana Jātaka", "translations": [{"lang": "pli", "lang_name": "Pāli", "is_root": true, "author": "Mahāsaṅgīti Tipiṭaka Buddhavasse 2500", "author_short": "ms", "author_uid": "ms", "publication_date": null, "id": "ja131_root-pli-ms", "segmented": true, "title": null, "volpage": null, "has_comment": false}, {"lang": "de", "lang_name": "Deutsch", "is_root": false, "author": "Dr. Julius Dutoit", "author_short": "Dutoit", "author_uid": "dutoit", "publication_date": "2007", "id": "de_ja131_dutoit", "segmented": false, "volpage": null, "has_comment": false}, {"author": "Robert Chalmers", "author_short": "Chalmers", "author_uid": "chalmers", "has_comment": false, "id": "en_ja131_chalmers", "is_root": false, "lang": "en", "lang_name": "English", "publication_date": "1895", "segmented": false, "volpage": null, "title": "Asampadana Jātaka"}, {"lang": "jpn", "lang_name": "日本語", "is_root": false, "author": "関西パーリ語実習会", "author_short": "関西パーリ語実習会", "author_uid": "kansai", "publication_date": "2023", "id": "jpn_ja131_kansai", "segmented": false, "volpage": null, "has_comment": false}, {"lang": "si", "lang_name": "සිංහල", "is_root": false, "author": "A.P. de Zoysa", "author_short": "Zoysa", "author_uid": "zoysa", "publicatio