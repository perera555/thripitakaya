{"html_text": {"ja203:0.1": "<article id='ja203'><header><ul><li class='division'>{}</li>", "ja203:0.2": "<li>{}</li>", "ja203:0.3": "<li>{}</li></ul>", "ja203:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja203:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja203:1.2": "<span class='verse-line'>{}</span>", "ja203:1.3": "<span class='verse-line'>{}</span>", "ja203:1.4": "<span class='verse-line'>{}</span></p>", "ja203:2.1": "<p><span class='verse-line'>{}</span>", "ja203:2.2": "<span class='verse-line'>{}</span>", "ja203:2.3": "<span class='verse-line'>{}</span>", "ja203:2.4": "<span class='verse-line'>{}</span></p>", "ja203:3.1": "<p><span class='verse-line'>{}</span>", "ja203:3.2": "<span class='verse-line'>{}</span>", "ja203:3.3": "<span class='verse-line'>{}</span>", "ja203:3.4": "<span class='verse-line'>{}</span></p>", "ja203:4.1": "<p><span class='verse-line'>{}</span>", "ja203:4.2": "<span class='verse-line'>{}</span>", "ja203:4.3": "<span class='verse-line'>{}</span>", "ja203:4.4": "<span class='verse-line'>{}</span></p>", "ja203:5.1": "<p><span class='verse-line'>{}</span>", "ja203:5.2": "<span class='verse-line'>{}</span>", "ja203:5.3": "<span class='verse-line'>{}</span>", "ja203:5.4": "<span class='verse-line'>{}</span>", "ja203:5.5": "<span class='verse-line'>{}</span>", "ja203:5.6": "<span class='verse-line'>{}</span></p>", "ja203:6.1": "<p><span class='verse-line'>{}</span>", "ja203:6.2": "<span class='verse-line'>{}</span>", "ja203:6.3": "<span class='verse-line'>{}</span>", "ja203:6.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja203:7.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja203:0.1": "Jātaka ", "ja203:0.2": "Dukanipāta ", "ja203:0.3": "Nataṁdaḷhavagga ", "ja203:0.4": "3. Khaṇḍajātaka ", "ja203:1.1": "“Virūpakkhehi me mettaṁ, ", "ja203:1.2": "Mettaṁ erāpathehi me; ", "ja203:1.3": "Chabyāputtehi me mettaṁ, ", "ja203:1.4": "Mettaṁ kaṇhāgotamakehi ca. ", "ja203:2.1": "Apādakehi me mettaṁ, ", "ja203:2.2": "mettaṁ dvipādakehi me; ", "ja203:2.3": "Catuppadehi me mettaṁ, ", "ja203:2.4": "mettaṁ bahuppadehi me. ", "ja203:3.1": "Mā maṁ apādako hiṁsi, ", "ja203:3.2": "mā maṁ hiṁsi dvipādako; ", "ja203:3.3": "Mā maṁ catuppado hiṁsi, ", "ja203:3.4": "mā maṁ hiṁsi bahuppado. ", "ja203:4.1": "Sabbe sattā sabbe pāṇā, ", "ja203:4.2": "sabbe bhūtā ca kevalā; ", "ja203:4.3": "Sabbe bhadrāni passantu, ", "ja203:4.4": "mā kañci pāpamāgamā. ", "ja203:5.1": "Appamāṇo buddho, ", "ja203:5.2": "Appamāṇo dhammo; ", "ja203:5.3": "Appamāṇo saṅgho, ", "ja203:5.4": "Pamāṇavantāni sarīsapāni; ", "ja203:5.5": "Ahivicchikasatapadī, ", "ja203:5.6": "Uṇṇanābhi sarabū mūsikā. ", "ja203:6.1": "Katā me rakkhā katā me parittā, ", "ja203:6.2": "Paṭikkamantu bhūtāni; ", "ja203:6.3": "Sohaṁ namo bhagavato, ", "ja203:6.4": "Namo sattannaṁ sammāsambuddhānan”ti. ", "ja203:7.1": "Khaṇḍajātakaṁ tatiyaṁ. "}, "variant_text": {"ja203:0.1": "", "ja203:0.2": "", "ja203:0.3": "", "ja203:0.4": "", "ja203:1.1": "", "ja203:1.2": "", "ja203:1.3": "", "ja203:1.4": "", "ja203:2.1": "", "ja203:2.2": "", "ja203:2.3": "", "ja203:2.4": "", "ja203:3.1": "", "ja203:3.2": "", "ja203:3.3": "", "ja203:3.4": "", "ja203:4.1": "", "ja203:4.2": "", "ja203:4.3": "", "ja203:4.4": "kañci → kiñci (sya1ed, sya2ed, mr) ", "ja203:5.1": "", "ja203:5.2": "", "ja203:5.3": "", "ja203:5.4": "sarīsapāni → siriṁsapāni (bj, sya1ed, sya2ed, pts-vp-pli1) ", "ja203:5.5": "", "ja203:5.6": "Uṇṇanābhi → uṇṇānābhi (bj, pts-vp-pli1); uṇṇānābhī (sya1ed, sya2ed) ", "ja203:6.1": "", "ja203:6.2": "", "ja203:6.3": "", "ja203:6.4": "", "ja203:7.1": "Khaṇḍajātakaṁ → khandhavattajātakaṁ (bj, pts-vp-pli1); khandhaparittajātakaṁ (sya1ed, sya2ed) "}, "reference_text": {"ja203:0.1": "", "ja203:0.2": "", "ja203:0.3": "", "ja203:0.4": "", "ja203:1.1": "dr27.74, ms22J_508, msdiv105, pts-vp-pli2.145", "ja203:1.2": "", "ja203:1.3": "", "ja203:1.4": "", "ja203:2.1": "csp1ed22.54, csp2ed22.54, ms22J_509, pts-vp-pli2.146, vri68.49", "ja203:2.2": "", "ja20