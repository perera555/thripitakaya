{"html_text": {"ja2:0.1": "<article id='ja2'><header><ul><li class='division'>{}</li>", "ja2:0.2": "<li>{}</li>", "ja2:0.3": "<li>{}</li></ul>", "ja2:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja2:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja2:1.2": "<span class='verse-line'>{}</span>", "ja2:1.3": "<span class='verse-line'>{}</span>", "ja2:1.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja2:2.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja2:0.1": "Jātaka ", "ja2:0.2": "Ekakanipāta ", "ja2:0.3": "Apaṇṇakavagga ", "ja2:0.4": "2. Vaṇṇupathajātaka ", "ja2:1.1": "“Akilāsuno vaṇṇupathe khaṇantā, ", "ja2:1.2": "Udaṅgaṇe tattha papaṁ avinduṁ; ", "ja2:1.3": "Evaṁ munī viriyabalūpapanno, ", "ja2:1.4": "Akilāsu vinde hadayassa santin”ti. ", "ja2:2.1": "Vaṇṇupathajātakaṁ dutiyaṁ. "}, "variant_text": {"ja2:0.1": "", "ja2:0.2": "", "ja2:0.3": "", "ja2:0.4": "", "ja2:1.1": "vaṇṇupathe → vaṇṇapathe (mr) ", "ja2:1.2": "", "ja2:1.3": "Evaṁ munī viriyabalūpapanno → muni vīriya … (sya1ed, sya2ed, mr); muni viriya … (pts-vp-pli1) ", "ja2:1.4": "", "ja2:2.1": ""}, "reference_text": {"ja2:0.1": "", "ja2:0.2": "", "ja2:0.3": "", "ja2:0.4": "", "ja2:1.1": "ms22J_4, msdiv2, pts-vp-pli1.109, vri68.2", "ja2:1.2": "", "ja2:1.3": "", "ja2:1.4": "", "ja2:2.1": "ms22J_5"}, "keys_order": ["ja2:0.1", "ja2:0.2", "ja2:0.3", "ja2:0.4", "ja2:1.1", "ja2:1.2", "ja2:1.3", "ja2:1.4", "ja2:2.1"]}