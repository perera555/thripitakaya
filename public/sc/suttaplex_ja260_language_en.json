[{"acronym": "Ja 260", "alt_acronym": null, "volpages": "PTS 2.320", "alt_volpages": null, "uid": "ja260", "blurb": "“O king, the Belly’s messenger”—This story the Master told while staying at Jetavana, about a Brother who was addicted to covetousness. The circumstances will be given at large under the Kaka Birth, in Book the Ninth. Here again the Master told the Brother, “You were greedy before, Brother, as you are now; and in olden days for your greed you had your head cleft with a sword.” Then he told an old-world story.", "difficulty": null, "original_title": "Dūtajātaka", "root_lang": "pli", "root_lang_name": "Pāli", "type": "leaf", "translated_title": "Duta Jātaka", "translations": [{"lang": "pli", "lang_name": "Pāli", "is_root": true, "author": "Mahāsaṅgīti Tipiṭaka Buddhavasse 2500", "author_short": "ms", "author_uid": "ms", "publication_date": null, "id": "ja260_root-pli-ms", "segmented": true, "title": null, "volpage": null, "has_comment": false}, {"lang": "de", "lang_name": "Deutsch", "is_root": false, "author": "Dr. Julius Dutoit", "author_short": "Dutoit", "author_uid": "dutoit", "publication_date": "2007", "id": "de_ja260_dutoit", "segmented": false, "volpage": null, "has_comment": false}, {"author": "W.H.D. Rouse", "author_short": "Rouse", "author_uid": "rouse", "has_comment": false, "id": "en_ja260_rouse", "is_root": false, "lang": "en", "lang_name": "English", "publication_date": "1895", "segmented": false, "volpage": null, "title": "Duta Jātaka"}, {"lang": "jpn", "lang_name": "日本語", "is_root": false, "author": "関西パーリ語実習会", "author_short": "関西パーリ語実習会", "author_uid": "kansai", "publication_date": "2023", "id": "jpn_ja260_kansai", "segmented": false, "volpage": null, "has_comment": false}, {"lang": "si", "lang_name": "සිංහල", "is_root": false, "author": "A.P. de Zoysa", "author_short": "Zoysa", "author_uid": "zoysa", "publication_date": null, "id": "si_ja260_zoysa", "segmented": false, "volpage": null, "has_comment": false}], "parallel_count": 0, "bib