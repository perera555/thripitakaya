{"html_text": {"ja180:0.1": "<article id='ja180'><header><ul><li class='division'>{}</li>", "ja180:0.2": "<li>{}</li>", "ja180:0.3": "<li>{}</li></ul>", "ja180:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja180:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja180:1.2": "<span class='verse-line'>{}</span>", "ja180:1.3": "<span class='verse-line'>{}</span>", "ja180:1.4": "<span class='verse-line'>{}</span></p>", "ja180:2.1": "<p><span class='verse-line'>{}</span>", "ja180:2.2": "<span class='verse-line'>{}</span>", "ja180:2.3": "<span class='verse-line'>{}</span>", "ja180:2.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja180:3.1": "<p class='endsutta'>{}</p>", "ja180:3.2": "<p class='endvagga'>{}</p>", "ja180:4.1": "<p class='uddana-intro'>{}</p>", "ja180:5.1": "<blockquote class='uddanagatha'><p><span class='verse-line'>{}</span>", "ja180:5.2": "<span class='verse-line'>{}</span>", "ja180:5.3": "<span class='verse-line'>{}</span>", "ja180:5.4": "<span class='verse-line'>{}</span></p></blockquote></article>"}, "root_text": {"ja180:0.1": "Jātaka ", "ja180:0.2": "Dukanipāta ", "ja180:0.3": "Kalyāṇavagga ", "ja180:0.4": "10. Duddadajātaka ", "ja180:1.1": "“Duddadaṁ dadamānānaṁ, ", "ja180:1.2": "dukkaraṁ kamma kubbataṁ; ", "ja180:1.3": "Asanto nānukubbanti, ", "ja180:1.4": "sataṁ dhammo durannayo”. ", "ja180:2.1": "“Tasmā satañca asataṁ, ", "ja180:2.2": "nānā hoti ito gati; ", "ja180:2.3": "Asanto nirayaṁ yanti, ", "ja180:2.4": "santo saggaparāyaṇāti. ", "ja180:3.1": "Duddadajātakaṁ dasamaṁ. ", "ja180:3.2": "Kalyāṇavaggo tatiyo. ", "ja180:4.1": "Tassuddānaṁ ", "ja180:5.1": "Susamaññamigādhibhū māṇavako, ", "ja180:5.2": "Vāripahūtarūpādiccupaṭṭhānā; ", "ja180:5.3": "Sakaḷāyasatindukapaṅka puna, ", "ja180:5.4": "Satadhamma sududdadakena dasā”ti. "}, "variant_text": {"ja180:0.1": "", "ja180:0.2": "", "ja180:0.3": "", "ja180:0.4": "", "ja180:1.1": "", "ja180:1.2": "", "ja180:1.3": "", "ja180:1.4": "", "ja180:2.1": "", "ja180:2.2"