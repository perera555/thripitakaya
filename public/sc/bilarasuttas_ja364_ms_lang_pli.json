{"html_text": {"ja364:0.1": "<article id='ja364'><header><ul><li class='division'>{}</li>", "ja364:0.2": "<li>{}</li>", "ja364:0.3": "<li>{}</li></ul>", "ja364:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja364:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja364:1.2": "<span class='verse-line'>{}</span>", "ja364:1.3": "<span class='verse-line'>{}</span>", "ja364:1.4": "<span class='verse-line'>{}</span></p>", "ja364:2.1": "<p><span class='verse-line'>{}</span>", "ja364:2.2": "<span class='verse-line'>{}</span>", "ja364:2.3": "<span class='verse-line'>{}</span>", "ja364:2.4": "<span class='verse-line'>{}</span></p>", "ja364:3.1": "<p><span class='verse-line'>{}</span>", "ja364:3.2": "<span class='verse-line'>{}</span>", "ja364:3.3": "<span class='verse-line'>{}</span>", "ja364:3.4": "<span class='verse-line'>{}</span></p>", "ja364:4.1": "<p><span class='verse-line'>{}</span>", "ja364:4.2": "<span class='verse-line'>{}</span>", "ja364:4.3": "<span class='verse-line'>{}</span>", "ja364:4.4": "<span class='verse-line'>{}</span></p>", "ja364:5.1": "<p><span class='verse-line'>{}</span>", "ja364:5.2": "<span class='verse-line'>{}</span>", "ja364:5.3": "<span class='verse-line'>{}</span>", "ja364:5.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja364:6.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja364:0.1": "Jātaka ", "ja364:0.2": "Pañcakanipāta ", "ja364:0.3": "Vaṇṇārohavagga ", "ja364:0.4": "4. Khajjopanakajātaka ", "ja364:1.1": "“Ko nu santamhi pajjote, ", "ja364:1.2": "aggipariyesanaṁ caraṁ; ", "ja364:1.3": "Addakkhi ratti khajjotaṁ, ", "ja364:1.4": "jātavedaṁ amaññatha. ", "ja364:2.1": "Svassa gomayacuṇṇāni, ", "ja364:2.2": "abhimatthaṁ tiṇāni ca; ", "ja364:2.3": "Viparītāya saññāya, ", "ja364:2.4": "nāsakkhi pajjaletave. ", "ja364:3.1": "Evampi anupāyena, ", "ja364:3.2": "atthaṁ na labhate migo; ", "ja364:3.3": "Visāṇato gavaṁ dohaṁ, ", "ja364:3.4": "yattha khīraṁ na vindati. ", "ja364:4.1": "Vividhehi upāyehi, ", "ja364:4.2": "atthaṁ papponti māṇavā; ", "ja364:4.3": "Niggahena amittānaṁ, ", "ja364:4.4": "mittānaṁ paggahena ca. ", "ja364:5.1": "Senāmokkhapalābhena, ", "ja364:5.2": "vallabhānaṁ nayena ca; ", "ja364:5.3": "Jagatiṁ jagatipālā, ", "ja364:5.4": "āvasanti vasundharan”ti. ", "ja364:6.1": "Khajjopanakajātakaṁ catutthaṁ. "}, "variant_text": {"ja364:0.1": "", "ja364:0.2": "", "ja364:0.3": "", "ja364:0.4": "", "ja364:1.1": "", "ja364:1.2": "", "ja364:1.3": "ratti → rattiṁ (bj, sya1ed, sya2ed) ", "ja364:1.4": "", "ja364:2.1": "", "ja364:2.2": "", "ja364:2.3": "", "ja364:2.4": "", "ja364:3.1": "", "ja364:3.2": "migo → mago (bj); mūgo (sya1ed, sya2ed) ", "ja364:3.3": "", "ja364:3.4": "", "ja364:4.1": "", "ja364:4.2": "", "ja364:4.3": "", "ja364:4.4": "", "ja364:5.1": "Senāmokkhapalābhena → seṇimokkho palābhena (bj); senīmokkhūpalābhena (sya1ed, sya2ed) ", "ja364:5.2": "", "ja364:5.3": "", "ja364:5.4": "", "ja364:6.1": "Khajjopanakajātakaṁ → khajjopaṇakapañho (bj) "}, "reference_text": {"ja364:0.1": "", "ja364:0.2": "", "ja364:0.3": "", "ja364:0.4": "", "ja364:1.1": "ms22J_1235, msdiv75, pts-vp-pli3.197", "ja364:1.2": "", "ja364:1.3": "", "ja364:1.4": "", "ja364:2.1": "ms22J_1236, msdiv76", "ja364:2.2": "", "ja364:2.3": "", "ja364:2.4": "", "ja364:3.1": "ms22J_1237, msdiv77", "ja364:3.2": "", "ja364:3.3": "", "ja364:3.4": "", "ja364:4.1": "ms22J_1238, msdiv78", "ja364:4.2": "", "ja364:4.3": "", "ja364:4.4": "", "ja364:5.1": "ms22J_1239, msdiv79, sya27.177", "ja364:5.2": "", "ja364:5.3": "", "ja364:5.4": "", "ja364:6.1": "ms22J_1240"}, "keys_order": ["ja364:0.1", "ja364:0.2", "ja364:0.3", "ja364:0.4", "ja364:1.1", "ja364:1.2", "ja364:1.3", "ja364:1.4", "ja364:2.1", "ja364:2.2", "ja364:2.3", "ja364:2.4", "ja364:3.1", "ja364:3.2", "ja364:3.3", "ja364:3.4", "ja364:4.1", "ja364:4.2", "ja364:4.3", "ja364:4.4", "ja364:5.1", "ja364:5.2", "ja364:5.3", "ja364:5.4", "ja364:6.1"]}