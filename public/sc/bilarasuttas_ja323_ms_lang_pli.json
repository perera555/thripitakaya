{"html_text": {"ja323:0.1": "<article id='ja323'><header><ul><li class='division'>{}</li>", "ja323:0.2": "<li>{}</li>", "ja323:0.3": "<li>{}</li></ul>", "ja323:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja323:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja323:1.2": "<span class='verse-line'>{}</span>", "ja323:1.3": "<span class='verse-line'>{}</span>", "ja323:1.4": "<span class='verse-line'>{}</span></p>", "ja323:2.1": "<p><span class='verse-line'>{}</span>", "ja323:2.2": "<span class='verse-line'>{}</span>", "ja323:2.3": "<span class='verse-line'>{}</span>", "ja323:2.4": "<span class='verse-line'>{}</span></p>", "ja323:3.1": "<p><span class='verse-line'>{}</span>", "ja323:3.2": "<span class='verse-line'>{}</span>", "ja323:3.3": "<span class='verse-line'>{}</span>", "ja323:3.4": "<span class='verse-line'>{}</span></p>", "ja323:4.1": "<p><span class='verse-line'>{}</span>", "ja323:4.2": "<span class='verse-line'>{}</span>", "ja323:4.3": "<span class='verse-line'>{}</span>", "ja323:4.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja323:5.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja323:0.1": "Jātaka ", "ja323:0.2": "Catukkanipāta ", "ja323:0.3": "Kuṭidūsakavagga ", "ja323:0.4": "3. Brahmadattajātaka ", "ja323:1.1": "“Dvayaṁ yācanako rāja, ", "ja323:1.2": "brahmadatta nigacchati; ", "ja323:1.3": "Alābhaṁ dhanalābhaṁ vā, ", "ja323:1.4": "evaṁ dhammā hi yācanā. ", "ja323:2.1": "Yācanaṁ rodanaṁ āhu, ", "ja323:2.2": "pañcālānaṁ rathesabha; ", "ja323:2.3": "Yo yācanaṁ paccakkhāti, ", "ja323:2.4": "tamāhu paṭirodanaṁ. ", "ja323:3.1": "Mā maddasaṁsu rodantaṁ, ", "ja323:3.2": "pañcālā susamāgatā; ", "ja323:3.3": "Tuvaṁ vā paṭirodantaṁ, ", "ja323:3.4": "tasmā icchāmahaṁ raho”. ", "ja323:4.1": "“Dadāmi te brāhmaṇa rohiṇīnaṁ, ", "ja323:4.2": "Gavaṁ sahassaṁ saha puṅgavena; ", "ja323:4.3": "Ariyo hi ariyassa kathaṁ na dajjā, ", "ja323:4.4": "Sutvāna gāthā tava dhammayuttā”ti. ", "ja323:5.1": "Brahmadattajātakaṁ tatiyaṁ. "}, "variant_text": {"ja323:0.1": "", "ja323:0.2": "", "ja323:0.3": "", "ja323:0.4": "", "ja323:1.1": "", "ja323:1.2": "", "ja323:1.3": "", "ja323:1.4": "", "ja323:2.1": "", "ja323:2.2": "", "ja323:2.3": "", "ja323:2.4": "", "ja323:3.1": "", "ja323:3.2": "", "ja323:3.3": "", "ja323:3.4": "", "ja323:4.1": "", "ja323:4.2": "", "ja323:4.3": "dajjā → dajje (bj); dajjaṁ (?) ", "ja323:4.4": "", "ja323:5.1": ""}, "reference_text": {"ja323:0.1": "", "ja323:0.2": "", "ja323:0.3": "", "ja323:0.4": "", "ja323:1.1": "ms22J_997, msdiv89, pts-vp-pli3.80", "ja323:1.2": "", "ja323:1.3": "", "ja323:1.4": "", "ja323:2.1": "ms22J_998, msdiv90", "ja323:2.2": "", "ja323:2.3": "", "ja323:2.4": "", "ja323:3.1": "ms22J_999, msdiv91", "ja323:3.2": "", "ja323:3.3": "", "ja323:3.4": "", "ja323:4.1": "bj30.182, csp1ed22.105, csp2ed22.105, ms22J_1000, msdiv92, pts-vp-pli3.81", "ja323:4.2": "", "ja323:4.3": "", "ja323:4.4": "", "ja323:5.1": "ms22J_1001"}, "keys_order": ["ja323:0.1", "ja323:0.2", "ja323:0.3", "ja323:0.4", "ja323:1.1", "ja323:1.2", "ja323:1.3", "ja323:1.4", "ja323:2.1", "ja323:2.2", "ja323:2.3", "ja323:2.4", "ja323:3.1", "ja323:3.2", "ja323:3.3", "ja323:3.4", "ja323:4.1", "ja323:4.2", "ja323:4.3", "ja323:4.4", "ja323:5.1"]}