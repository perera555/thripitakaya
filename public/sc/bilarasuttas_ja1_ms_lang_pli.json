{"html_text": {"ja1:0.1": "<article id='ja1'><header><ul><li class='division'>{}</li>", "ja1:0.2": "<li>{}</li>", "ja1:0.3": "<li>{}</li></ul>", "ja1:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja1:1.1": "<p class='namo'>{}</p>", "ja1:2.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja1:2.2": "<span class='verse-line'>{}</span>", "ja1:2.3": "<span class='verse-line'>{}</span>", "ja1:2.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja1:3.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja1:0.1": "Jātaka ", "ja1:0.2": "Ekakanipāta ", "ja1:0.3": "Apaṇṇakavagga ", "ja1:0.4": "1. Apaṇṇakajātaka ", "ja1:1.1": "Namo tassa Bhagavato Arahato Sammāsambuddhassa. ", "ja1:2.1": "“Apaṇṇakaṁ ṭhānameke, ", "ja1:2.2": "Dutiyaṁ āhu takkikā; ", "ja1:2.3": "Etadaññāya medhāvī, ", "ja1:2.4": "Taṁ gaṇhe yadapaṇṇakan”ti. ", "ja1:3.1": "Apaṇṇakajātakaṁ paṭhamaṁ. "}, "variant_text": {"ja1:0.1": "", "ja1:0.2": "", "ja1:0.3": "", "ja1:0.4": "", "ja1:1.1": "", "ja1:2.1": "", "ja1:2.2": "", "ja1:2.3": "", "ja1:2.4": "Taṁ gaṇhe yadapaṇṇakan”ti → taṁ gaṇheyya apaṇṇakaṁ (mr) ", "ja1:3.1": ""}, "reference_text": {"ja1:0.1": "", "ja1:0.2": "", "ja1:0.3": "", "ja1:0.4": "", "ja1:1.1": "ms22J_1", "ja1:2.1": "bj30.2, csp1ed22.1, csp2ed22.1, dr27.1, ms22J_2, msdiv1, ndp22.3, pts-vp-pli1.104, sya27.1, vri68.1", "ja1:2.2": "", "ja1:2.3": "", "ja1:2.4": "", "ja1:3.1": "ms22J_3"}, "keys_order": ["ja1:0.1", "ja1:0.2", "ja1:0.3", "ja1:0.4", "ja1:1.1", "ja1:2.1", "ja1:2.2", "ja1:2.3", "ja1:2.4", "ja1:3.1"]}