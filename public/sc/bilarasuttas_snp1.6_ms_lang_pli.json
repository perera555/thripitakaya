: "<p><span class='verse-line'>{}</span>", "snp1.6:19.2": "<span class='verse-line'>{}</span>", "snp1.6:19.3": "<span class='verse-line'>{}</span>", "snp1.6:19.4": "<span class='verse-line'>{}</span></p>", "snp1.6:20.1": "<p><span class='verse-line'>{}</span>", "snp1.6:20.2": "<span class='verse-line'>{}</span>", "snp1.6:20.3": "<span class='verse-line'>{}</span>", "snp1.6:20.4": "<span class='verse-line'>{}</span></p>", "snp1.6:21.1": "<p><span class='verse-line'>{}</span>", "snp1.6:21.2": "<span class='verse-line'>{}</span>", "snp1.6:21.3": "<span class='verse-line'>{}</span>", "snp1.6:21.4": "<span class='verse-line'>{}</span></p>", "snp1.6:22.1": "<p><span class='verse-line'>{}</span>", "snp1.6:22.2": "<span class='verse-line'>{}</span>", "snp1.6:22.3": "<span class='verse-line'>{}</span>", "snp1.6:22.4": "<span class='verse-line'>{}</span></p>", "snp1.6:23.1": "<p><span class='verse-line'>{}</span>", "snp1.6:23.2": "<span class='verse-line'>{}</span>", "snp1.6:23.3": "<span class='verse-line'>{}</span>", "snp1.6:23.4": "<span class='verse-line'>{}</span></p>", "snp1.6:24.1": "<p><span class='verse-line'>{}</span>", "snp1.6:24.2": "<span class='verse-line'>{}</span>", "snp1.6:24.3": "<span class='verse-line'>{}</span>", "snp1.6:24.4": "<span class='verse-line'>{}</span></p>", "snp1.6:25.1": "<p><span class='verse-line'>{}</span>", "snp1.6:25.2": "<span class='verse-line'>{}</span>", "snp1.6:25.3": "<span class='verse-line'>{}</span>", "snp1.6:25.4": "<span class='verse-line'>{}</span></p>", "snp1.6:26.1": "<p><span class='verse-line'>{}</span>", "snp1.6:26.2": "<span class='verse-line'>{}</span>", "snp1.6:26.3": "<span class='verse-line'>{}</span>", "snp1.6:26.4": "<span class='verse-line'>{}</span></p></blockquote>", "snp1.6:26.5": "<p class='endsutta'>{}</p></article>"}, "root_text": {"snp1.6:0.1": "Sutta Nipāta 1.6 ", "snp1.6:0.2": "Parābhavasutta ", "snp1.6:1.1": "Evaṁ me sutaṁ—", "snp1.6:1.2": "ekaṁ samayaṁ bhagavā sāvatthiyaṁ viharati jetavane anāthapiṇḍikassa ārāme. ", "snp1.6:1.3": "Atha kho aññatarā devatā abhikkantāya rattiyā abhikkantavaṇṇā kevalakappaṁ jetavanaṁ obhāsetvā yena bhagavā tenupasaṅkami; upasaṅkamitvā bhagavantaṁ abhivādetvā ekamantaṁ aṭṭhāsi. ", "snp1.6:1.4": "Ekamantaṁ ṭhitā kho sā devatā bhagavantaṁ gāthāya ajjhabhāsi: ", "snp1.6:2.1": "“Parābhavantaṁ purisaṁ, ", "snp1.6:2.2": "mayaṁ pucchāma gotama; ", "snp1.6:2.3": "Bhavantaṁ puṭṭhumāgamma, ", "snp1.6:2.4": "kiṁ parābhavato mukhaṁ”. ", "snp1.6:3.1": "“Suvijāno bhavaṁ hoti, ", "snp1.6:3.2": "suvijāno parābhavo; ", "snp1.6:3.3": "Dhammakāmo bhavaṁ hoti, ", "snp1.6:3.4": "dhammadessī parābhavo”. ", "snp1.6:4.1": "“Iti hetaṁ vijānāma, ", "snp1.6:4.2": "paṭhamo so parābhavo; ", "snp1.6:4.3": "Dutiyaṁ bhagavā brūhi, ", "snp1.6:4.4": "kiṁ parābhavato mukhaṁ”. ", "snp1.6:5.1": "“Asantassa piyā honti, ", "snp1.6:5.2": "sante na kurute piyaṁ; ", "snp1.6:5.3": "Asataṁ dhammaṁ roceti, ", "snp1.6:5.4": "taṁ parābhavato mukhaṁ”. ", "snp1.6:6.1": "“Iti hetaṁ vijānāma, ", "snp1.6:6.2": "dutiyo so parābhavo; ", "snp1.6:6.3": "Tatiyaṁ bhagavā brūhi, ", "snp1.6:6.4": "kiṁ parābhavato mukhaṁ”. ", "snp1.6:7.1": "“Niddāsīlī sabhāsīlī, ", "snp1.6:7.2": "anuṭṭhātā ca yo naro; ", "snp1.6:7.3": "Alaso kodhapaññāṇo, ", "snp1.6:7.4": "taṁ parābhavato mukhaṁ”. ", "snp1.6:8.1": "“Iti hetaṁ vijānāma, ", "snp1.6:8.2": "tatiyo so parābhavo; ", "snp1.6:8.3": "Catutthaṁ bhagavā brūhi, ", "snp1.6:8.4": "kiṁ parābhavato mukhaṁ”. ", "snp1.6:9.1": "“Yo mātaraṁ pitaraṁ vā, ", "snp1.6:9.2": "jiṇṇakaṁ gatayobbanaṁ; ", "snp1.6:9.3": "Pahu santo na bharati, ", "snp1.6:9.4": "taṁ parābhavato mukhaṁ”. ", "snp1.6:10.1": "“Iti hetaṁ vijānāma, ", "snp1.6:10.2": "catuttho so parābhavo; ", "snp1.6:10.3": "Pañcamaṁ bhagavā brūhi, ", "snp1.6:10.4": "kiṁ parābhavato mukhaṁ”. ", "snp1.6:11.1": "“Yo brāhmaṇaṁ samaṇaṁ vā, ", "snp1.6:11.2": "Aññaṁ vāpi vanibbakaṁ; ", "snp1.6:11.3": "Musāvādena vañceti, ", "snp1.6:11.4": "Taṁ parābhavato mukhaṁ”. ", "snp1.6:12.1": "“Iti hetaṁ vijānāma, ", "snp1.6:12.2": "Pañcamo so parābhavo; ", "snp1.6:12.3": "Chaṭṭhamaṁ bhagavā brūhi, ", "snp1.6:12.4": "Kiṁ parābhavato mukhaṁ”. ", "snp1.6:13.1": "“Pahūtavitto puriso, ", "snp1.6:13.2": "Sahirañño sabhojano; ", "snp1.6:13.3": "Eko bhuñjati sādūni, ", "snp1.6:13.4": "Taṁ parābhavato mukhaṁ”. ", "snp1.6:14.1": "“Iti hetaṁ vijānāma, ", "snp1.6:14.2": "Chaṭṭhamo so parābhavo; ", "snp1.6:14.3": "Sattamaṁ bhagavā brūhi, ", "snp1.6:14.4": "Kiṁ parābhavato mukhaṁ”. ", "snp1.6:15.1": "“Jātitthaddho dhanatthaddho, ", "snp1.6:15.2": "Gottatthaddho ca yo naro; ", "snp1.6:15.3": "Saññātiṁ atimaññeti, ", "snp1.6:15.4": "Taṁ parābhavato mukhaṁ”. ", "snp1.6:16.1": "“Iti hetaṁ vijānāma, ", "snp1.6:16.2": "Sattamo so parābhavo; ", "snp1.6:16.3": "Aṭṭhamaṁ bhagavā brūhi, ", "snp1.6:16.4": "Kiṁ parābhavato mukhaṁ”. ", "snp1.6:17.1": "“Itthidhutto surādhutto, ", "snp1.6:17.2": "Akkhadhutto ca yo naro; ", "snp1.6:17.3": "Laddhaṁ laddhaṁ vināseti, ", "snp1.6:17.4": "Taṁ parābhavato mukhaṁ”. ", "snp1.6:18.1": "“Iti hetaṁ vijānāma, ", "snp1.6:18.2": "Aṭṭhamo so parābhavo; ", "snp1.6:18.3": "Navamaṁ bhagavā brūhi, ", "snp1.6:18.4": "Kiṁ parābhavato mukhaṁ”. ", "snp1.6:19.1": "“Sehi dārehi asantuṭṭho, ", "snp1.6:19.2": "Vesiyāsu padussati; ", "snp1.6:19.3": "Dussati paradāresu, ", "snp1.6:19.4": "Taṁ parābhavato mukhaṁ”. ", "snp1.6:20.1": "“Iti hetaṁ vijānāma, ", "snp1.6:20.2": "Navamo so parābhavo; ", "snp1.6:20.3": "Dasamaṁ bhagavā brūhi, ", "snp1.6:20.4": "Kiṁ parābhavato mukhaṁ”. ", "snp1.6:21.1": "“Atītayobbano poso, ", "snp1.6:21.2": "Āneti timbarutthaniṁ; ", "snp1.6:21.3": "Tassā issā na supati, ", "snp1.6:21.4": "Taṁ parābhavato mukhaṁ”. ", "snp1.6:22.1": "“Iti hetaṁ vijānāma, ", "snp1.6:22.2": "Dasamo so parābhavo; ", "snp1.6:22.3": "Ekādasamaṁ bhagavā brūhi, ", "snp1.6:22.4": "Kiṁ parābhavato mukhaṁ”. ", "snp1.6:23.1": "“Itthiṁ soṇḍiṁ vikiraṇiṁ, ", "snp1.6:23.2": "Purisaṁ vāpi tādisaṁ; ", "snp1.6:23.3": "Issariyasmiṁ ṭhapeti, ", "snp1.6:23.4": "Taṁ parābhavato mukhaṁ”. ", "snp1.6:24.1": "“Iti hetaṁ vijānāma, ", "snp1.6:24.2": "Ekādasamo so parābhavo; ", "snp1.6:24.3": "Dvādasamaṁ bhagavā brūhi, ", "snp1.6:24.4": "Kiṁ parābhavato mukhaṁ”. ", "snp1.6:25.1": "“Appabhogo mahātaṇho, ", "snp1.6:25.2": "Khattiye jāyate kule; ", "snp1.6:25.3": "So ca rajjaṁ patthayati, ", "snp1.6:25.4": "Taṁ parābhavato mukhaṁ. ", "snp1.6:26.1": "Ete parābhave loke, ", "snp1.6:26.2": "Paṇḍito samavekkhiya; ", "snp1.6:26.3": "Ariyo dassanasampanno, ", "snp1.6:26.4": "Sa lokaṁ bhajate sivan”ti. ", "snp1.6:26.5": "Parābhavasuttaṁ chaṭṭhaṁ. "}, "variant_text": {"snp1.6:0.1": "", "snp1.6:0.2": "", "snp1.6:1.1": "", "snp1.6:1.2": "", "snp1.6:1.3": "", "snp1.6:1.4": "", "snp1.6:2.1": "", "snp1.6:2.2": "gotama → gotamaṁ (bj, sya-all, pts-vp-pli1) ", "snp1.6:2.3": "Bhavantaṁ → bhagavantaṁ (sya2ed, pts-vp-pli1, csp1ed) ", "snp1.6:2.4": "", "snp1.6:3.1": "", "snp1.6:3.2": "suvijāno → duvijāno (sya-all, mr) ", "snp1.6:3.3": "", "snp1.6:3.4": "", "snp1.6:4.1": "", "snp1.6:4.2": "", "snp1.6:4.3": "", "snp1.6:4.4": "", "snp1.6:5.1": "", "snp1.6:5.2": "", "snp1.6:5.3": "", "snp1.6:5.4": "", "snp1.6:6.1": "", "snp1.6:6.2": "", "snp1.6:6.3": "", "snp1.6:6.4": "", "snp1.6:7.1": "", "snp1.6:7.2": "", "snp1.6:7.3": "", "snp1.6:7.4": "", "snp1.6:8.1": "", "snp1.6:8.2": "", "snp1.6:8.3": "", "snp1.6:8.4": "", "snp1.6:9.1": "mātaraṁ → yo mātaraṁ vā (bj, sya-all, km, pts-vp-pli1) ", "snp1.6:9.2": "", "snp1.6:9.3": "", "snp1.6:9.4": "", "snp1.6:10.1": "", "snp1.6:10.2": "", "snp1.6:10.3": "", "snp1.6:10.4": "", "snp1.6:11.1": "brāhmaṇaṁ → yo brāhmaṇaṁ vā (bj, sya-all, km, pts-vp-pli1) ", "snp1.6:11.2": "", "snp1.6:11.3": "", "snp1.6:11.4": "", "snp1.6:12.1": "", "snp1.6:12.2": "", "snp1.6:12.3": "", "snp1.6:12.4": "", "snp1.6:13.1": "", "snp1.6:13.2": "", "snp1.6:13.3": "", "snp1.6:13.4": "", "snp1.6:14.1": "", "snp1.6:14.2": "", "snp1.6:14.3": "", "snp1.6:14.4": "", "snp1.6:15.1": "", "snp1.6:15.2": "", "snp1.6:15.3": "", "snp1.6:15.4": "", "snp1.6:16.1": "", "snp1.6:16.2": "", "snp1.6:16.3": "", "snp1.6:1