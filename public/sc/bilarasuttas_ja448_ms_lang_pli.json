{"html_text": {"ja448:0.1": "<article id='ja448'><header><ul><li class='division'>{}</li>", "ja448:0.2": "<li>{}</li>", "ja448:0.3": "<li>{}</li></ul>", "ja448:0.4": "<h1 class='sutta-title'>{}</h1></header>", "ja448:1.1": "<blockquote class='gatha'><p><span class='verse-line'>{}</span>", "ja448:1.2": "<span class='verse-line'>{}</span>", "ja448:1.3": "<span class='verse-line'>{}</span>", "ja448:1.4": "<span class='verse-line'>{}</span></p>", "ja448:2.1": "<p><span class='verse-line'>{}</span>", "ja448:2.2": "<span class='verse-line'>{}</span>", "ja448:2.3": "<span class='verse-line'>{}</span>", "ja448:2.4": "<span class='verse-line'>{}</span></p>", "ja448:3.1": "<p><span class='verse-line'>{}</span>", "ja448:3.2": "<span class='verse-line'>{}</span>", "ja448:3.3": "<span class='verse-line'>{}</span>", "ja448:3.4": "<span class='verse-line'>{}</span></p>", "ja448:4.1": "<p><span class='verse-line'>{}</span>", "ja448:4.2": "<span class='verse-line'>{}</span>", "ja448:4.3": "<span class='verse-line'>{}</span>", "ja448:4.4": "<span class='verse-line'>{}</span></p>", "ja448:5.1": "<p><span class='verse-line'>{}</span>", "ja448:5.2": "<span class='verse-line'>{}</span>", "ja448:5.3": "<span class='verse-line'>{}</span>", "ja448:5.4": "<span class='verse-line'>{}</span></p>", "ja448:6.1": "<p><span class='verse-line'>{}</span>", "ja448:6.2": "<span class='verse-line'>{}</span>", "ja448:6.3": "<span class='verse-line'>{}</span>", "ja448:6.4": "<span class='verse-line'>{}</span></p>", "ja448:7.1": "<p><span class='verse-line'>{}</span>", "ja448:7.2": "<span class='verse-line'>{}</span>", "ja448:7.3": "<span class='verse-line'>{}</span>", "ja448:7.4": "<span class='verse-line'>{}</span></p>", "ja448:8.1": "<p><span class='verse-line'>{}</span>", "ja448:8.2": "<span class='verse-line'>{}</span>", "ja448:8.3": "<span class='verse-line'>{}</span>", "ja448:8.4": "<span class='verse-line'>{}</span></p>", "ja448:9.1": "<p><span class='verse-line'>{}</span>", "ja448:9.2": "<span class='verse-line'>{}</span>", "ja448:9.3": "<span class='verse-line'>{}</span>", "ja448:9.4": "<span class='verse-line'>{}</span></p>", "ja448:10.1": "<p><span class='verse-line'>{}</span>", "ja448:10.2": "<span class='verse-line'>{}</span>", "ja448:10.3": "<span class='verse-line'>{}</span>", "ja448:10.4": "<span class='verse-line'>{}</span></p>", "ja448:11.1": "<p><span class='verse-line'>{}</span>", "ja448:11.2": "<span class='verse-line'>{}</span>", "ja448:11.3": "<span class='verse-line'>{}</span>", "ja448:11.4": "<span class='verse-line'>{}</span></p></blockquote>", "ja448:12.1": "<p class='endsutta'>{}</p></article>"}, "root_text": {"ja448:0.1": "Jātaka ", "ja448:0.2": "Dasakanipāta ", "ja448:0.3": "Catudvāravagga ", "ja448:0.4": "10. Kukkuṭajātaka ", "ja448:1.1": "“Nāsmase katapāpamhi, ", "ja448:1.2": "nāsmase alikavādine; ", "ja448:1.3": "Nāsmase attatthapaññamhi, ", "ja448:1.4": "atisantepi nāsmase. ", "ja448:2.1": "Bhavanti heke purisā, ", "ja448:2.2": "gopipāsikajātikā; ", "ja448:2.3": "Ghasanti maññe mittāni, ", "ja448:2.4": "vācāya na ca kammunā. ", "ja448:3.1": "Sukkhañjalipaggahitā, ", "ja448:3.2": "vācāya paliguṇṭhitā; ", "ja448:3.3": "Manussapheggū nāsīde, ", "ja448:3.4": "yasmiṁ natthi kataññutā. ", "ja448:4.1": "Na hi aññaññacittānaṁ, ", "ja448:4.2": "itthīnaṁ purisāna vā; ", "ja448:4.3": "Nānāvikatvā saṁsaggaṁ, ", "ja448:4.4": "tādisampi ca nāsmase. ", "ja448:5.1": "Anariyakammamokkantaṁ, ", "ja448:5.2": "athetaṁ sabbaghātinaṁ; ", "ja448:5.3": "Nisitaṁva paṭicchannaṁ, ", "ja448:5.4": "tādisampi ca nāsmase. ", "ja448:6.1": "Mittarūpenidhekacce, ", "ja448:6.2": "sākhalyena acetasā; ", "ja448:6.3": "Vividhehi upāyanti, ", "ja448:6.4": "tādisampi ca nāsmase. ", "ja448:7.1": "Āmisaṁ vā dhanaṁ vāpi, ", "ja448:7.2": "yattha passati tādiso; ", "ja448:7.3": "Dubbhiṁ karoti dummedho, ", "ja448:7.4": "tañca hantvāna gacchati”. ", "ja448:8.1": "“Mittarūpena bahavo, ", "ja448:8.2": "channā sevanti sattavo; ", "ja448:8.3": "Jahe kāpurise hete, ", "ja448:8.4": "kukkuṭo viya senakaṁ. ", "ja448:9.1": "Yo ca uppatitaṁ atthaṁ, ", "ja448:9.2": "na khippamanubujjhati; ", "ja448:9.3": "Amittavasamanveti, ", "ja448:9.4": "pacchā ca anutappati. ", "ja448:10.1": "Yo ca uppatitaṁ atthaṁ, ", "ja448:10.2": "khippameva nibodhati; ", "ja448:10.3": "Muccate sattusambādhā, ", "ja448:10.4": "kukkuṭo viya senakā. ", "ja448:11.1": "Taṁ tādisaṁ kūṭamivoḍḍitaṁ vane, ", "ja448:11.2": "Adhammikaṁ niccavidhaṁsakārinaṁ; ", "ja448:11.3": "Ārā vivajjeyya naro vicakkhaṇo, ", "ja448:11.4": "Senaṁ yathā kukkuṭo vaṁsakānane”ti. ", "ja448:12.1": "Kukkuṭajātakaṁ dasamaṁ. "}, "variant_text": {"ja448:0.1": "", "ja448:0.2": "", "ja448:0.3": "", "ja448:0.4": "", "ja448:1.1": "", "ja448:1.2": "", "ja448:1.3": "", "ja448:1.4": "", "ja448:2.1": "", "ja448:2.2": "gopipāsikajātikā → gopipāsakajātikā (bj, pts-vp-pli1) ", "ja448:2.3": "", "ja448:2.4": "ca → yodha (ja419:8 [Sulasājātaka] sulasājātake) ", "ja448:3.1": "", "ja448:3.2": "", "ja448:3.3": "", "ja448:3.4": "", "ja448:4.1": "", "ja448:4.2": "", "ja448:4.3": "Nānāvikatvā → nānāva katvā (bj, pts-vp-pli1) ", "ja448:4.4": "tādisampi ca nāsmase → tādisampi na vissase (sya1ed, sya2ed) ", "ja448:5.1": "", "ja448:5.2": "athetaṁ → atthetaṁ (bj, sya1ed, sya2ed, pts-vp-pli1) ", "ja448:5.3": "", "ja448:5.4": "", "ja448:6.1": "", "ja448:6.2": "", "ja448:6.3": "", "ja448:6.4": "", "ja448:7.1": "", "ja448:7.2": "", "ja448:7.3": "", "ja448:7.4": "hantvāna → jhatvāna (bj, pts-vp-pli1) ", "ja448:8.1": "", "ja448:8.2": "", "ja448:8.3": "", "ja448:8.4": "", "ja448:9.1": "", "ja448:9.2": "", "ja448:9.3": "", "ja448:9.4": "", "ja448:10.1": "", "ja448:10.2": "", "ja448:10.3": "", "ja448:10.4": "", "ja448:11.1": "", "ja448:11.2": "", "ja448:11.3": "", "ja448:11.4": "", "ja448:12.1": ""}, "reference_text": {"ja448:0.1": "", "ja448:0.2": "", "ja448:0.3": "", "ja448:0.4": "", "ja448:1.1": "bj30.372, csp1ed22.216, csp2ed22.216, ms22J_2021, msdiv104, ndp22.208, pts-vp-pli4.56", "ja448:1.2": "", "ja448:1.3": "", "ja448:1.4": "", "ja448: